{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Factory observe measures (B09)",
  "description": "docs/FACTORY_OBSERVE.md: lost decisions, escaped defects, human rework, maintainability, elapsed time and tokens, kept separate by comparable work class. A caller-supplied measures document, validated by lib/factory_measures.py before aggregation.",
  "type": "object",
  "required": ["contract", "work_classes"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "agent-factory-observe-measures/v1"},
    "work_classes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/metrics"}
    }
  },
  "$defs": {
    "metrics": {
      "type": "object",
      "required": [
        "lost_decisions", "escaped_defects", "human_rework",
        "maintainability", "elapsed_seconds", "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "lost_decisions": {"type": "number"},
        "escaped_defects": {"type": "number"},
        "human_rework": {"type": "number"},
        "maintainability": {"type": "number"},
        "elapsed_seconds": {"type": "number"},
        "tokens": {"type": "number"}
      }
    }
  }
}
