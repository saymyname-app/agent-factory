    "frozen_harness_paths": [
      "tests/fixtures/delivery-fixture-city/tests/harness.py"
    ],
    "test_command": "python3 tests/fixtures/delivery-fixture-city/tests/harness.py {test} {report}",
    "seams": [
      {
        "name": "cockpit-http",
        "mode": "black_box",
        "test_paths": [
          "tests/cockpit-criteria/http/"
        ]
      },
      {
        "name": "factory-commands",
        "mode": "import_rule",
        "test_paths": [
          "tests/cockpit-criteria/commands/"
        ]
      }
    ],
    "import_rule": {
      "product_import": "(?<![\\w/.-])bin/[a-z]|^\\s*(?:from|import)\\s+(?:cockpit|convoy_state|factory_[a-z_]+|delivery_role_identity|overlap_conflict_log|provider_failover|reversibility)\\b",
      "entry_point_import": "(?<![\\w/.-])bin/(?:project-launch|project-planning-profile|prototype-conformance|acceptance-session|owner-answer|outcome-promote)(?![\\w-])"
    },
    "regression_command": "python3 tests/cockpit-criteria/regression.py",
    "k": 3,
