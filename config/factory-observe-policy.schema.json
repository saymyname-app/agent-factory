{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Factory observe policy (B09)",
  "description": "docs/FACTORY_OBSERVE.md: which role is the smallest one qualified to wake for each observed area, and which named evidence conditions gate an exemption/automatic handoff. Versioned and human-edited -- live state (last-observed snapshot, current exemption activation) lives separately in .gc/runtime/factory-observe-state.json.",
  "type": "object",
  "required": ["contract", "roles", "exemptions"],
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "agent-factory-observe-policy/v1"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/role"}
    },
    "exemptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exemption"}
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["name", "areas", "rank", "model", "effort"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "areas": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "rank": {
          "type": "number",
          "description": "Smaller ranks first -- select_smallest_qualified_role picks the minimum rank among roles whose areas cover the fact."
        },
        "model": {"type": ["string", "null"]},
        "effort": {"enum": [null, "none", "low", "medium"]}
      }
    },
    "exemption": {
      "type": "object",
      "required": ["name", "requires"],
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
