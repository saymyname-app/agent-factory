#!/bin/bash
#
# The runner's side of Factory CI on the host (docs/OPERATIONS.md, "Factory
# CI on the host's own runner", af-r1ymfm). Runs as the unprivileged user
# `factory-ci` in factory-ci-runner.service, installed by
# config/ci-runner/root-install in /usr/local/lib/factory-ci-runner.
#
# One job at a time, each in a container of its own that is thrown away:
#   1. wait for a one-job runner configuration on the hand-off pipe (the
#      operator's `bin/ci-runner broker` writes it; this user holds no token
#      of GitHub and cannot ask for one);
#   2. start a rootless container with nothing of the host mounted and no
#      way to the host's 127.0.0.1, give it the configuration on its standard
#      input, let GitHub's runner serve one job in it;
#   3. remove the container, start again.
# The share of the PC it may take is on the service, not here.

set -u

LIB=${FACTORY_CI_RUNNER_LIB:-/usr/local/lib/factory-ci-runner}
RUN_DIR=${FACTORY_CI_RUNNER_RUN_DIR:-/run/factory-ci-runner}
IMAGE=${FACTORY_CI_RUNNER_IMAGE:-localhost/factory-ci-runner}
PODMAN=${FACTORY_CI_RUNNER_PODMAN:-podman}
# A runner too old is refused by GitHub, and the image carries the system's
# security fixes: rebuild it after this many days.
IMAGE_MAX_AGE_DAYS=${FACTORY_CI_RUNNER_IMAGE_MAX_AGE_DAYS:-7}
# A build makes new calls of wsl.exe from Windows hang about 30 s, once or
# twice (docs/OPERATIONS.md, af-uw246a): an image that is only old is built
# again between these hours of the host's clock, start included, end not
# (Benjamin, 2026-10-09: 05:00-07:00) -- or at any hour once it is this old,
# for a PC that is off at night.
BUILD_HOURS=${FACTORY_CI_RUNNER_BUILD_HOURS:-5-7}
IMAGE_HARD_MAX_AGE_DAYS=${FACTORY_CI_RUNNER_IMAGE_HARD_MAX_AGE_DAYS:-14}
# A build that failed is not tried again before this long while an image exists.
BUILD_RETRY_SECONDS=${FACTORY_CI_RUNNER_BUILD_RETRY_SECONDS:-3600}
# While a container runs: look every WATCH_PAUSE seconds for stop-now, and
# every DUE_CHECK_TICKS looks whether the image is due.
WATCH_PAUSE=${FACTORY_CI_RUNNER_WATCH_PAUSE:-2}
DUE_CHECK_TICKS=${FACTORY_CI_RUNNER_DUE_CHECK_TICKS:-30}
# A job that never ends would hold the only runner for ever. Counted from the
# moment the runner is seen serving a job, not from the container's start: a
# runner can wait hours for a job, and the wait took its job's time (af-rqovxb,
# 2026-10-09: started 09:59, job at 11:41, killed at 11:59).
JOB_MAX_SECONDS=${FACTORY_CI_RUNNER_JOB_MAX_SECONDS:-7200}
# The process GitHub's runner starts for a job and for nothing else: a runner
# that only waits has none. Tests only: another name, as a test can itself run
# in a job.
WORKER=${FACTORY_CI_RUNNER_WORKER:-Runner.Worker}
# Tests only: stop after this many turns of the loop.
MAX_TURNS=${FACTORY_CI_RUNNER_MAX_TURNS:-0}
PAUSE=${FACTORY_CI_RUNNER_LOOP_PAUSE:-5}
EMPTY_PAUSE=${FACTORY_CI_RUNNER_EMPTY_PAUSE:-15}
NAME=factory-ci-job

log() { printf 'runner-loop: %s\n' "$*"; }

in_build_hours() {
  # Tests only: FACTORY_CI_RUNNER_HOUR stands for the hour of the clock.
  local hour=${FACTORY_CI_RUNNER_HOUR:-$(date +%-H)}
  [ "$hour" -ge "${BUILD_HOURS%-*}" ] && [ "$hour" -lt "${BUILD_HOURS#*-}" ]
}

# True when nothing asks for a build now: the image exists, its recipe did not
# change, and it is young -- or old, but not yet too old, outside the hours.
image_is_fresh() {
  local created age
  created=$("$PODMAN" image inspect "$IMAGE" --format '{{.Created.Unix}}' 2>/dev/null) || return 1
  age=$(( $(date +%s) - created ))
  [ "$age" -lt $(( IMAGE_HARD_MAX_AGE_DAYS * 86400 )) ] || return 1
  if [ "$age" -ge $(( IMAGE_MAX_AGE_DAYS * 86400 )) ] && in_build_hours; then return 1; fi
  # A changed recipe (config/ci-runner/root-install leaves an unchanged one
  # its date) is a new image.
  local recipe
  for recipe in "$LIB/Containerfile" "$LIB/entrypoint.sh"; do
    [ ! -e "$recipe" ] || [ "$(stat -c %Y "$recipe")" -le "$created" ] || return 1
  done
}

build_tried_at=0
# A failed build is not a reason to try every minute: the old image serves.
build_was_just_tried() {
  [ $(( $(date +%s) - build_tried_at )) -lt "$BUILD_RETRY_SECONDS" ] && "$PODMAN" image exists "$IMAGE"
}

build_image() {
  local latest
  build_tried_at=$(date +%s)
  latest=$(curl -fsS --max-time 20 https://api.github.com/repos/actions/runner/releases/latest \
    | jq -r '.tag_name // empty' | sed 's/^v//') || latest=
  if [ -z "$latest" ]; then
    log "could not read the latest version of GitHub's runner: image not rebuilt"
    return 1
  fi
  log "building the image with GitHub's runner $latest"
  "$PODMAN" build --pull=newer --no-cache -q --build-arg RUNNER_VERSION="$latest" -t "$IMAGE" "$LIB" || return 1
  "$PODMAN" image prune -f >/dev/null 2>&1 || true
}

turns=0
while :; do
  if [ "$MAX_TURNS" -gt 0 ]; then
    [ "$turns" -lt "$MAX_TURNS" ] || exit 0
    turns=$((turns + 1))
  fi

  # `bin/ci-runner pause --now`: nothing runs until `resume` removes the file.
  if [ -e "$RUN_DIR/stop-now" ]; then sleep "$PAUSE"; continue; fi

  if ! image_is_fresh && ! build_was_just_tried && ! build_image && ! "$PODMAN" image exists "$IMAGE"; then
    log "no image and none could be built: next try in a minute"
    sleep 60; continue
  fi

  if [ ! -p "$RUN_DIR/handoff" ]; then sleep "$PAUSE"; continue; fi
  # Blocks here, idle, until the broker hands a configuration over.
  jit=
  IFS= read -r jit < "$RUN_DIR/handoff" || true
  if [ -z "$jit" ]; then
    log "the broker handed nothing over (GitHub did not answer it?): next try in a moment"
    sleep "$EMPTY_PAUSE"; continue
  fi
  if [ -e "$RUN_DIR/stop-now" ]; then continue; fi

  "$PODMAN" rm -f "$NAME" >/dev/null 2>&1 || true
  log "job container starting"
  # --cgroups=disabled: the container stays in this service's control group,
  #   so the service's limits (cores, memory) hold for the job.
  # allow_host_loopback=false: 10.0.2.2 does not lead to the host's
  #   127.0.0.1 (Beads' Dolt server, the supervisor, the Cockpit).
  # No -v: nothing of the host is in the container.
  printf '%s\n' "$jit" | "$PODMAN" run --rm -i --name "$NAME" \
    --cgroups=disabled --network slirp4netns:allow_host_loopback=false \
    "$IMAGE" &
  pid=$!
  jit=
  ticks=0
  job_started=
  while kill -0 "$pid" 2>/dev/null; do
    if [ -e "$RUN_DIR/stop-now" ]; then
      log "stop-now: killing the job container"
      "$PODMAN" kill "$NAME" >/dev/null 2>&1 || true
    fi
    # A runner can wait for a job for days: without this the image would be
    # built only when a job happens to end inside the hours. A runner that
    # only waits (no $WORKER in its container) is stopped; one that
    # serves a job is left alone and the next look decides.
    ticks=$((ticks + 1))
    if [ $((ticks % DUE_CHECK_TICKS)) -eq 0 ]; then
      # Only on the container's own word: a look that fails stops nothing.
      # By the process's name (-x), never by command lines (-f): the shell
      # that runs the look has the name in its own, and every runner read as
      # busy from its first minute (af-7i1q2r, 2026-10-09: a job killed after
      # 9 minutes, 2 h after its container started).
      state=$("$PODMAN" exec "$NAME" sh -c 'pgrep -x "$1" >/dev/null && echo busy || echo idle' sh "$WORKER" 2>/dev/null)
      if [ "$state" = busy ]; then
        [ -n "$job_started" ] || job_started=$(date +%s)
        if [ $(( $(date +%s) - job_started )) -ge "$JOB_MAX_SECONDS" ]; then
          log "the job ran for more than $JOB_MAX_SECONDS s: killing its container"
          "$PODMAN" kill "$NAME" >/dev/null 2>&1 || true
        fi
      elif [ "$state" = idle ] && ! image_is_fresh && ! build_was_just_tried; then
        log "the image is due and the runner only waits: stopping it to build"
        "$PODMAN" kill "$NAME" >/dev/null 2>&1 || true
      fi
    fi
    sleep "$WATCH_PAUSE"
  done
  wait "$pid"; log "job container ended (exit $?)"
done
