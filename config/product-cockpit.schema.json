{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Factory product cockpit configuration",
  "type": "object",
  "required": ["schema_version", "slug", "name", "strategy", "decisions", "project_inventory", "design_governance", "po_workspace", "queue_command", "capabilities", "relations", "business_objectives", "product_reference", "view_inventory", "delivery_workflow"],
  "properties": {
    "schema_version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "strategy": {"type": "string", "minLength": 1},
    "decisions": {"type": "string", "minLength": 1},
    "project_inventory": {"type": "string", "minLength": 1},
    "design_governance": {"type": "string", "minLength": 1},
    "operator_name": {"type": "string", "minLength": 1},
    "po_model": {"type": "string", "minLength": 1},
    "po_sandbox": {"enum": ["read-only", "workspace-write"]},
    "preview_command": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "north_star": {"type": "string"},
    "inventory_watch": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "po_workspace": {"type": "string", "minLength": 1},
    "po_add_dirs": {"type": "array", "items": {"type": "string"}},
    "queue_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "area", "roadmap"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"},
          "area": {"type": "string"}, "roadmap": {"type": "integer", "minimum": 1}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2}
    },
    "business_objectives": {"type": "array", "items": {"type": "object", "required": ["id", "title", "detail", "roadmap"]}},
    "view_inventory": {"type": "array", "items": {"type": "object", "required": ["area", "status", "views"]}},
    "product_reference": {"type": "array", "items": {"type": "object", "required": ["id", "title", "detail", "status", "status_label", "source"]}},
    "delivery_workflow": {"type": "array", "items": {"type": "object", "required": ["id", "title", "detail"]}}
  },
  "additionalProperties": true
}
