{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Factory product cockpit configuration",
  "type": "object",
  "required": [
    "schema_version", "slug", "name", "strategy", "decisions", "release_contract",
    "project_inventory", "design_governance", "po_workspace", "status_command", "queue_command",
    "queue_mutation_command", "capabilities", "relations", "journeys",
    "business_objectives", "product_reference", "view_inventory", "delivery_workflow"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "strategy": {"$ref": "#/$defs/repositoryPath"},
    "decisions": {"$ref": "#/$defs/repositoryPath"},
    "release_contract": {"$ref": "#/$defs/repositoryPath"},
    "project_inventory": {"$ref": "#/$defs/repositoryPath"},
    "design_governance": {"$ref": "#/$defs/repositoryPath"},
    "inventory_watch": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "po_workspace": {"type": "string", "minLength": 1},
    "po_add_dirs": {"type": "array", "items": {"type": "string"}},
    "status_command": {"$ref": "#/$defs/command"},
    "queue_command": {"$ref": "#/$defs/command"},
    "queue_mutation_command": {"$ref": "#/$defs/command"},
    "decision_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_ref", "decision_ref"],
        "properties": {
          "work_ref": {"$ref": "#/$defs/workRef"},
          "decision_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "area", "roadmap", "source_refs", "decision_refs"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "roadmap": {"type": "integer", "minimum": 1},
          "source_refs": {"$ref": "#/$defs/idList"},
          "decision_refs": {"$ref": "#/$defs/textList"}
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"$ref": "#/$defs/id"}, {"$ref": "#/$defs/id"}],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "detail", "roadmap", "capability_refs", "source_refs", "decision_refs"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "roadmap": {"type": "integer", "minimum": 1},
          "capability_refs": {"$ref": "#/$defs/idList"},
          "source_refs": {"$ref": "#/$defs/idList"},
          "decision_refs": {"$ref": "#/$defs/textList"}
        },
        "additionalProperties": false
      }
    },
    "business_objectives": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "title", "detail", "roadmap"]}
    },
    "view_inventory": {
      "type": "array",
      "items": {"type": "object", "required": ["area", "status", "views"]}
    },
    "product_reference": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "status", "status_label", "sources"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "status": {"enum": ["validated", "review", "live"]},
          "status_label": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sections"],
              "properties": {
                "path": {"$ref": "#/$defs/repositoryPath"},
                "sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "delivery_workflow": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "title", "detail"]}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "workRef": {"type": "string", "pattern": "^[a-z][a-z0-9]*-[a-z0-9]+(?:\\.[a-z0-9]+)*$"},
    "idList": {"type": "array", "items": {"$ref": "#/$defs/id"}},
    "textList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
