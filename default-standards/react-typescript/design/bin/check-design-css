#!/usr/bin/env python3
"""Reject design literals in CSS outside the theme file."""
from pathlib import Path
import re
import sys

pattern = re.compile(r"#[0-9a-fA-F]{3,8}\b|\b(?:rgb|rgba|hsl|hsla|oklch)\s*\(|(?<![\w.-])\d+(?:\.\d+)?(?:px|rem|em|vh|vw|vmin|vmax|%|ms|s)\b", re.I)
errors = []
for path in Path("src").rglob("*.css"):
    if path == Path("src/theme/tokens.css"):
        continue
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        declarations = re.findall(r"\b(?:color|background(?:-color)?|border(?:-\w+)?|fill|stroke)\s*:\s*([^;}]+)", line, re.I)
        named_color = any(re.sub(r"\bvar\(--[\w-]+\)", "", value, flags=re.I).strip().lower()
                          not in {"", "inherit", "transparent", "currentcolor", "none", "unset", "initial",
                                  "solid", "dashed", "dotted", "double"}
                          for value in declarations)
        if pattern.search(line) or named_color:
            errors.append(f"{path}:{number}: valeur de design en dur hors du thème")
for error in errors:
    print(error, file=sys.stderr)
raise SystemExit(bool(errors))
