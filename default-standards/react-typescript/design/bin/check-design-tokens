#!/usr/bin/env python3
"""Reject unreadable light or dark theme role pairs."""
from pathlib import Path
import re
import sys

css = Path("src/theme/tokens.css")
if not css.is_file():
    print("design: thème absent", file=sys.stderr)
    raise SystemExit(1)
source = css.read_text(encoding="utf-8")
root_match = re.search(r":root\s*\{([^}]*)\}", source, re.S)
reduced_match = re.search(r"@media\s*\(prefers-reduced-motion:\s*reduce\)\s*\{\s*:root\s*\{([^}]*)\}", source, re.S)
durations = set(re.findall(r"(--duration-[\w-]+)\s*:", root_match.group(1))) if root_match else set()
reduced = set(re.findall(r"(--duration-[\w-]+)\s*:\s*0(?:ms|s)\s*;", reduced_match.group(1))) if reduced_match else set()
if not durations or durations != reduced:
    print("design: réduction des animations absente pour chaque durée", file=sys.stderr)
    raise SystemExit(1)

def roles(selector):
    match = re.search(selector + r"\s*\{([^}]*)\}", source, re.S)
    if not match:
        raise ValueError("mode de thème absent")
    return dict(re.findall(r"(--color-[\w-]+)\s*:\s*(#[0-9a-fA-F]{6})\s*;", match.group(1)))

def luminance(color):
    values = [int(color[index:index+2], 16) / 255 for index in (1, 3, 5)]
    channels = [value / 12.92 if value <= 0.04045 else ((value + 0.055) / 1.055) ** 2.4 for value in values]
    return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2]

def ratio(first, second):
    light, dark = sorted((luminance(first), luminance(second)), reverse=True)
    return (light + 0.05) / (dark + 0.05)

try:
    light = roles(r":root")
    dark = roles(r'\[data-theme="dark"\]')
    required = {"background", "text", "surface", "accent", "on-accent", "border", "focus"}
    for mode, tokens in (("clair", light), ("sombre", dark)):
        if {key.removeprefix("--color-") for key in tokens} != required:
            raise ValueError(f"mode {mode}: rôles du thème absents ou inconnus")
        for foreground, background, minimum in (("text", "background", 4.5), ("text", "surface", 4.5),
                                                 ("on-accent", "accent", 4.5),
                                                 ("focus", "background", 3.0), ("focus", "surface", 3.0),
                                                 ("border", "background", 3.0), ("border", "surface", 3.0),
                                                 ("accent", "background", 3.0), ("accent", "surface", 3.0)):
            first, second = tokens["--color-" + foreground], tokens["--color-" + background]
            score = ratio(first, second)
            if score < minimum:
                raise ValueError(f"mode {mode}: contraste {foreground}/{background} {score:.2f} < {minimum}")
except (KeyError, ValueError) as exc:
    print(f"design: {exc}", file=sys.stderr)
    raise SystemExit(1)
print("design: contrastes clair et sombre conformes")
