{
  "name": "react-typescript-standards-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "architecture": "dependency-cruiser src --config .dependency-cruiser.cjs",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run architecture && npm run test:coverage"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
