#!/usr/bin/env python3
"""Self-contained probe adapter used by project-isolation-oracle.

Attempts to read one secret file per named rig under a fixed sandbox path.
It has no knowledge of which rigs the sandbox is supposed to expose; its
result reports only what the filesystem it actually sees allows. The oracle
copies this file into an ephemeral workspace and invokes it exactly as the
public adapter contract requires.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path


def probe(workspace: Path, rigs: list[str]) -> dict[str, dict[str, object]]:
    results: dict[str, dict[str, object]] = {}
    for rig in rigs:
        secret = workspace / "rigs" / rig / "secret.txt"
        try:
            content = secret.read_bytes()
        except OSError:
            results[rig] = {"readable": False, "digest": None}
            continue
        results[rig] = {
            "readable": True,
            "digest": "sha256:" + hashlib.sha256(content).hexdigest(),
        }
    return results


def main() -> int:
    parser = argparse.ArgumentParser(prog="probe")
    parser.add_argument("--workspace", type=Path, required=True)
    subparsers = parser.add_subparsers(dest="command", required=True)
    read = subparsers.add_parser("read")
    read.add_argument("rigs", nargs="+")
    args = parser.parse_args()

    result = probe(args.workspace, args.rigs)
    print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
