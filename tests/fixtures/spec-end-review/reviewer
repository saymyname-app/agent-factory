#!/usr/bin/env python3
"""Stand-in for the dispatch door and the reviewer session it starts, for
tests/spec-end-review-test.py and the pass tests: no agent runs in CI, only
what goes in and out of the command (Spec af-wf4w5r, Testing Decisions).

Called as bin/dispatch-door is (`<bead> --rig R --formula F --role ROLE`), it
logs its arguments to SPEC_END_REVIEW_FAKE_LOG, then does what a reviewer
session does with the routed bead: read the convoy it names, ask
`spec-end-review brief` (kept, call by call, in SPEC_END_REVIEW_FAKE_BRIEFS),
and hand an end review to `spec-end-review record` from a read-only role
session of its own (`delivery-reviewer-fixture-<call number>`).

What each call does is read from the JSON list in SPEC_END_REVIEW_FAKE_PLAN,
one entry per call, the last one repeated:

    "favorable"                     no finding, the two axes, every file of the diff
    {"findings": [...],             those findings, as a reviewer writes them;
     "axes": [...],                 the axes it says it ran (default: both);
     "skip": N}                     the last N files of the diff left out of its coverage
    "silent"                        the session starts and never answers
    "unclaimed"                     the route waits for the reviewer seat and no session starts
    "closed"                        the session closes its bead without an output
    "door-refuses"                  the door refuses the dispatch
    "door-defers"                   the door defers the dispatch (exit 75)
"""
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
TOOL = str(ROOT / "bin" / "spec-end-review")
GC = os.environ["GC_BIN"]

log = Path(os.environ["SPEC_END_REVIEW_FAKE_LOG"])
calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(sys.argv[1:]) + "\n")
plan = json.loads(Path(os.environ["SPEC_END_REVIEW_FAKE_PLAN"]).read_text(encoding="utf-8"))
step = plan[min(len(calls), len(plan) - 1)]

if step == "door-refuses":
    print("dispatch-door: dispatch refused: no passing adoption trial for role 'reviewer'", file=sys.stderr)
    raise SystemExit(2)
if step == "door-defers":
    print("dispatch-door: deferred -- guest MemAvailable is 1.0 GiB, below the 1.5 GiB floor", file=sys.stderr)
    raise SystemExit(75)
bead_id = sys.argv[1]
# The workflow the door starts: its review step carries gc.claimed_at once a
# reviewer session claims it.
claimed_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
# The route the door starts is written only to the fake tracker; in an
# isolated city, which runs the real tracker, no route is written and the
# launch stays unclaimed and never times out (af-nalv4e).
tracker = os.environ.get("CONVOY_STATE_FAKE_TRACKER")
if tracker:
    with Path(tracker).open("r+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        state = json.load(handle)
        input_id, root_id, step_id = (f"{bead_id}-input", f"{bead_id}-root", f"{bead_id}-step")
        state["beads"][input_id] = {"title": f"input convoy for {bead_id}", "status": "open",
                                     "issue_type": "convoy", "tracks": [bead_id]}
        state["beads"][root_id] = {"title": "mol-end-review", "status": "in_progress",
                                    "metadata": {"gc.formula_name": "mol-end-review", "gc.input_convoy_id": input_id}}
        metadata = {"gc.root_bead_id": root_id, "gc.step_id": "mol-end-review.review"}
        review_step = {"title": "review", "status": "open", "metadata": metadata}
        if step != "unclaimed":
            metadata["gc.claimed_at"] = claimed_at
            review_step.update(status="in_progress", assignee="delivery-reviewer-fixture")
        state["beads"][step_id] = review_step
        handle.seek(0)
        handle.truncate()
        json.dump(state, handle, indent=2, sort_keys=True)
if step in ("unclaimed", "silent"):
    raise SystemExit(0)
if step == "closed":
    subprocess.run([GC, "bd", "close", bead_id, "--reason", "aucune sortie"], capture_output=True, check=True)
    raise SystemExit(0)

bead = json.loads(subprocess.run([GC, "bd", "show", bead_id, "--json"], capture_output=True, text=True, check=True).stdout)[0]
convoy = re.search(r"^convoy: (\S+)$", bead["description"], re.MULTILINE).group(1)
number = len(calls) + 1
session = {**os.environ, "DELIVERY_ROLE_READ_ONLY": "1", "GC_SESSION_NAME": f"delivery-reviewer-fixture-{number}"}
repo = os.environ["SPEC_END_REVIEW_FAKE_REPO"]
asked = subprocess.run([TOOL, "brief", convoy, "--repo", repo], env=session, capture_output=True, text=True, check=True)
briefs = os.environ.get("SPEC_END_REVIEW_FAKE_BRIEFS")
if briefs:
    Path(briefs).mkdir(parents=True, exist_ok=True)
    (Path(briefs) / f"brief-{number}.json").write_text(asked.stdout, encoding="utf-8")
brief = json.loads(asked.stdout)
given = step if isinstance(step, dict) else {}
files = [entry["path"] for entry in brief["diff"]["files"]]
handed = {
    "commit": brief["commit"], "findings": given.get("findings", []),
    "coverage": {"axes": given.get("axes", brief["axes"]), "files": files[:len(files) - given.get("skip", 0)]},
}
with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as handle:
    json.dump(handed, handle, ensure_ascii=False)
proc = subprocess.run([TOOL, "record", convoy, "--file", handle.name, "--repo", repo],
                      env=session, capture_output=True, text=True)
os.unlink(handle.name)
sys.stderr.write(proc.stdout + proc.stderr)
subprocess.run([GC, "bd", "close", bead_id, "--reason", "revue de fin enregistrée"], capture_output=True)
raise SystemExit(0)
