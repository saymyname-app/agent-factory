#!/usr/bin/env bash

set -Eeuo pipefail

state=${CAMPAIGN_STATE_FILE:?}
log=${CAMPAIGN_CALL_LOG:?}
printf '%q ' "$@" >>"$log"
printf '\n' >>"$log"

if [[ ${1:-} == bd && ${2:-} == show && ${4:-} == --json ]]; then
  case ${3:-} in
    af-1vr4)
      [[ ${CAMPAIGN_COORDINATION_FAIL:-0} != 1 ]] || { printf 'coordination store unavailable\n' >&2; exit 42; }
      jq -c '[.]' "$state"
      ;;
    af-cm1l) printf '[{"id":"af-cm1l","status":"closed","metadata":{"gc.queue_state":"materialized","gc.queue_goal":"none","gc.materialized_bead":"af-hho5"}}]\n' ;;
    af-hho5) printf '[{"id":"af-hho5","status":"in_progress","metadata":{}}]\n' ;;
    *)
      node_dir=${CAMPAIGN_NODE_DIR:-}
      node_file=
      [[ -z $node_dir ]] || node_file="$node_dir/${3}.json"
      if [[ -n $node_file && -f $node_file ]]; then
        jq -c '[.]' "$node_file"
      elif [[ -n $node_dir ]]; then
        printf '[{"id":"%s","status":"open","metadata":{}}]\n' "$3"
      else
        exit 64
      fi
      ;;
  esac
  exit 0
fi

if [[ ${1:-} == rig && ${2:-} == list && ${3:-} == --json ]]; then
  if [[ -n ${CAMPAIGN_RIGS_FILE:-} && -f ${CAMPAIGN_RIGS_FILE} ]]; then
    cat "$CAMPAIGN_RIGS_FILE"
  else
    printf '{"rigs":[{"name":"agent-factory","prefix":"af"}]}\n'
  fi
  exit 0
fi

if [[ ${1:-} == bd && ${2:-} == list ]]; then
  if [[ -n ${CAMPAIGN_RIG_BEADS_FILE:-} && -f ${CAMPAIGN_RIG_BEADS_FILE} ]]; then
    cat "$CAMPAIGN_RIG_BEADS_FILE"
  else
    printf '[]\n'
  fi
  exit 0
fi

if [[ ${1:-} == bd && ${2:-} == update && ${3:-} == af-1vr4 ]]; then
  [[ ${CAMPAIGN_COORDINATION_FAIL:-0} != 1 ]] || { printf 'coordination store unavailable\n' >&2; exit 42; }
  [[ -z ${CAMPAIGN_UPDATE_DELAY:-} ]] || sleep "$CAMPAIGN_UPDATE_DELAY"
  shift 3
  tmp="${state}.tmp"
  cp "$state" "$tmp"
  while [[ $# -gt 0 ]]; do
    [[ $1 == --set-metadata && $# -ge 2 ]] || exit 64
    pair=$2
    key=${pair%%=*}
    value=${pair#*=}
    jq --arg key "$key" --arg value "$value" '.metadata[$key] = $value' "$tmp" >"${tmp}.next"
    mv "${tmp}.next" "$tmp"
    shift 2
  done
  mv "$tmp" "$state"
  printf '{}\n'
  exit 0
fi

if [[ ${1:-} == bd && ${2:-} == update ]]; then
  node_dir=${CAMPAIGN_NODE_DIR:?}
  node_id=$3
  node_file="$node_dir/${node_id}.json"
  [[ -f $node_file ]] || printf '{"id":"%s","status":"open","metadata":{}}' "$node_id" >"$node_file"
  shift 3
  tmp="${node_file}.tmp"
  cp "$node_file" "$tmp"
  while [[ $# -gt 0 ]]; do
    [[ $1 == --set-metadata && $# -ge 2 ]] || exit 64
    pair=$2
    key=${pair%%=*}
    value=${pair#*=}
    jq --arg key "$key" --arg value "$value" '.metadata[$key] = $value' "$tmp" >"${tmp}.next"
    mv "${tmp}.next" "$tmp"
    shift 2
  done
  mv "$tmp" "$node_file"
  printf '{}\n'
  exit 0
fi

if [[ ${1:-} == bd && ${2:-} == ready && ${3:-} == --json ]]; then
  [[ ${CAMPAIGN_READY_FAIL:-0} != 1 ]] || { printf 'ready query failed\n' >&2; exit 42; }
  # af-ck3xg: mirror the real bd ready's default --limit 100 (0 = unlimited)
  # so a fixture list of >100 rows can exercise the truncation defense.
  limit=100
  shift 3
  while [[ $# -gt 0 ]]; do
    if [[ $1 == --limit && $# -ge 2 ]]; then
      limit=$2
      shift 2
    else
      shift
    fi
  done
  if [[ -n ${CAMPAIGN_READY_FILE:-} && -f ${CAMPAIGN_READY_FILE} ]]; then
    if [[ $limit -eq 0 ]]; then
      cat "$CAMPAIGN_READY_FILE"
    else
      jq -c ".[0:$limit]" "$CAMPAIGN_READY_FILE"
    fi
  else
    printf '[]\n'
  fi
  exit 0
fi

if [[ ${1:-} == bd && ${2:-} == create ]]; then
  printf '{"id":"af-repair"}\n'
  exit 0
fi

if [[ ${1:-} == mail && ${2:-} == send ]]; then
  [[ ${CAMPAIGN_MAIL_FAIL:-0} != 1 ]] || { printf 'mail unavailable\n' >&2; exit 42; }
  [[ ${3:-} == mayor ]] || { printf 'unknown mail recipient\n' >&2; exit 64; }
  sender=
  shift 3
  while [[ $# -gt 0 ]]; do
    if [[ $1 == --from && $# -ge 2 ]]; then
      sender=$2
      break
    fi
    shift
  done
  [[ $sender == mayor ]] || { printf 'unknown configured sender\n' >&2; exit 64; }
  printf '{"ok":true,"id":"af-mail"}\n'
  exit 0
fi

printf 'unsupported gc fixture command\n' >&2
exit 64
