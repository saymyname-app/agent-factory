#!/usr/bin/env python3
"""Stateful fake `bd` for planning-map tests (W03, af-fan2sg).

Backs a tiny bead store in the JSON file named by PLANNING_MAP_BD_STATE, so
a test can create a map and children, close some of them, and then assert
what `bd children`/`bd show` report next -- the real behavior planning-map's
check/close/update commands depend on. Only the subset of `bd` used by
planning-map is implemented; anything else fails loudly.
"""
import json
import os
import sys
from pathlib import Path

STATE_PATH = Path(os.environ["PLANNING_MAP_BD_STATE"])

BOOLEAN_FLAGS = {"--no-inherit-labels", "--silent", "--json"}
VALUE_FLAGS = {
    "--parent", "--type", "--title", "--labels", "--metadata", "--body-file",
    "--reason", "--status", "--label", "--if-assignee", "--append-notes",
}
REPEATABLE_VALUE_FLAGS = {"--set-metadata"}


def load_state():
    if STATE_PATH.exists():
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    return {"beads": {}, "next_id": 1}


def save_state(state):
    STATE_PATH.write_text(json.dumps(state, indent=2, sort_keys=True), encoding="utf-8")


def parse_flags(args):
    flags = {}
    repeated = {}
    positionals = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in BOOLEAN_FLAGS:
            flags[arg] = True
            i += 1
        elif arg in REPEATABLE_VALUE_FLAGS:
            repeated.setdefault(arg, []).append(args[i + 1])
            i += 2
        elif arg in VALUE_FLAGS:
            flags[arg] = args[i + 1]
            i += 2
        else:
            positionals.append(arg)
            i += 1
    return flags, repeated, positionals


def read_body(body_file):
    if body_file is None:
        return ""
    if body_file == "-":
        return sys.stdin.read()
    return Path(body_file).read_text(encoding="utf-8")


def public_view(bead):
    return {
        "id": bead["id"],
        "title": bead["title"],
        "description": bead["description"],
        "status": bead["status"],
        "labels": bead["labels"],
        "metadata": bead["metadata"],
        "parent": bead["parent"],
        "assignee": bead.get("assignee", ""),
    }


def fail(message):
    sys.stderr.write(f"fake bd: {message}\n")
    raise SystemExit(1)


def cmd_create(flags):
    state = load_state()
    n = state["next_id"]
    state["next_id"] = n + 1
    parent = flags.get("--parent")
    new_id = f"{parent}.{n}" if parent else f"fk-{n}"
    labels = flags.get("--labels", "")
    labels_list = [label for label in labels.split(",") if label]
    metadata = json.loads(flags["--metadata"]) if "--metadata" in flags else {}
    bead = {
        "id": new_id,
        "title": flags.get("--title", ""),
        "description": read_body(flags.get("--body-file")),
        "status": "open",
        "labels": labels_list,
        "metadata": metadata,
        "parent": parent,
    }
    state["beads"][new_id] = bead
    save_state(state)
    if flags.get("--silent"):
        print(new_id)
    else:
        print(json.dumps(public_view(bead)))


def cmd_show(flags, positionals):
    state = load_state()
    if not positionals:
        fail("show requires an issue id")
    issue_id = positionals[0]
    bead = state["beads"].get(issue_id)
    if bead is None:
        fail(f"issue not found: {issue_id}")
    print(json.dumps([public_view(bead)]))


def cmd_children(flags, positionals):
    state = load_state()
    if not positionals:
        fail("children requires a parent id")
    parent_id = positionals[0]
    children = [
        public_view(bead)
        for bead in state["beads"].values()
        if bead["parent"] == parent_id
    ]
    print(json.dumps(children))
    # Test seam: "<id>=<assignee>" hands that bead to another actor right
    # after this listing, as a sibling session's Take over would.
    moved = os.environ.get("FAKE_BD_ASSIGNEE_AFTER_CHILDREN")
    if moved:
        issue_id, _, assignee = moved.partition("=")
        state["beads"][issue_id]["assignee"] = assignee
        save_state(state)


def cmd_update(flags, repeated, positionals):
    state = load_state()
    if not positionals:
        fail("update requires an issue id")
    issue_id = positionals[0]
    bead = state["beads"].get(issue_id)
    if bead is None:
        fail(f"issue not found: {issue_id}")
    # As bd does: a precondition that no longer holds writes nothing, exit 13.
    if "--if-assignee" in flags and flags["--if-assignee"] != bead.get("assignee", ""):
        sys.stderr.write(f"fake bd: {issue_id}: precondition failed\n")
        raise SystemExit(13)
    if "--body-file" in flags:
        bead["description"] = read_body(flags["--body-file"])
    if "--status" in flags:
        bead["status"] = flags["--status"]
    if "--append-notes" in flags:
        bead["notes"] = "\n".join(filter(None, [bead.get("notes", ""), flags["--append-notes"]]))
    for entry in repeated.get("--set-metadata", []):
        key, _, value = entry.partition("=")
        bead.setdefault("metadata", {})[key] = value
    save_state(state)
    print(json.dumps(public_view(bead)))


def cmd_list(flags):
    state = load_state()
    status = flags.get("--status")
    label = flags.get("--label")
    beads = [
        public_view(bead)
        for bead in state["beads"].values()
        if (status is None or bead["status"] == status)
        and (label is None or label in bead.get("labels", []))
    ]
    print(json.dumps(beads))


def cmd_close(flags, positionals):
    state = load_state()
    if not positionals:
        fail("close requires an issue id")
    issue_id = positionals[0]
    bead = state["beads"].get(issue_id)
    if bead is None:
        fail(f"issue not found: {issue_id}")
    # As Beads 1.3 does: only the assignee closes an assigned bead, and the
    # tool under test names no actor (af-bm9y90).
    if bead.get("assignee"):
        fail(f"cannot close {issue_id}: assignee is \"{bead['assignee']}\", actor is \"fake\"")
    bead["status"] = "closed"
    bead["close_reason"] = flags.get("--reason", "")
    save_state(state)
    print(json.dumps(public_view(bead)))


def main(argv):
    if not argv:
        fail("no command given")
    command, rest = argv[0], argv[1:]
    flags, repeated, positionals = parse_flags(rest)
    if command == "create":
        cmd_create(flags)
    elif command == "show":
        cmd_show(flags, positionals)
    elif command == "children":
        cmd_children(flags, positionals)
    elif command == "list":
        cmd_list(flags)
    elif command == "update":
        cmd_update(flags, repeated, positionals)
    elif command == "close":
        cmd_close(flags, positionals)
    else:
        fail(f"no canned response configured for: bd {' '.join(argv)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
