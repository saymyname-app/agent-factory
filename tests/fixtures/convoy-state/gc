#!/usr/bin/env -S python3 -S
"""Stateful fake `gc` for convoy-state-test.py (T33, af-p4d6ec).

Backs a tiny tracker in the JSON file named by CONVOY_STATE_FAKE_TRACKER:

    {"beads": {"<id>": {"title": "...", "status": "open",
                        "issue_type": "task" | "convoy",
                        "metadata": {...},
                        "tracks": ["<ticket id>", ...],     # convoy only
                        "blocks": ["<other id>", ...]}}}    # optional

A top-level "sessions" list, when present, is what `session list --json`
answers (T04).

Only the shapes bin/convoy-state, bin/convoy-advance and bin/dispatch-door
use are implemented, with the behavior
observed on the real bd 1.2.2 in an isolated city (2026-10-06): `bd show
<id> --json` returns a one-element list whose `dependencies` carry each
tracked ticket's status and metadata (`metadata` is null when empty, and
`dependency_type` distinguishes `tracks` from other edges), and a bead taken
by a session carries its `assignee` (bin/ticket-exit, T11); `bd update <id>
--set-metadata k=v` stores an integer-looking value as a
number and `true`/`false` as a boolean, anything else as a string, and
refuses a metadata key outside `[a-zA-Z_][a-zA-Z0-9_.]*`. Every
update is appended to CONVOY_STATE_FAKE_WRITE_LOG when set.

For the manual lifecycle of a marked convoy (T22, af-kn83no), observed on gc
1.4.1 in an isolated city (2026-10-08): `bd update <id> --add-label NAME`
adds NAME to the bead's `labels` (null while it has none), in the same write
as its `--set-metadata`.

For bin/planning-artifacts-close (af-nybppo), observed on the live tracker
(2026-10-10): `bd show <id> <id>... --json` returns one list of the ids that
resolve, the others only missing from it, and exits 0; when none resolves it
prints `{"error": "no issues found matching the provided IDs"}` and exits 1.

For bin/convoy-advance (T04, af-gfyj6k), observed on gc 1.4.1 in an isolated
city (2026-10-06): a leading `--city DIR` is accepted; `bd list --json`
filters by `--type`, `--status`, `--has-metadata-key` and `--metadata-field`;
`session list --json` answers `{"sessions": [{"template", "state", ...}]}`;
`sling TARGET BEAD --on FORMULA --reassign` attaches a workflow and leaves the
bead open, unassigned and without new metadata. Every sling is appended to
the write log as ["sling", TARGET, BEAD, FORMULA]; a bead id listed in
CONVOY_STATE_FAKE_SLING_FAIL (comma-separated) makes its sling fail. For the
grouped-answer race, CONVOY_STATE_FAKE_ANSWER_ON_SLING=REQUEST=OPTION records
that response after the first successful sling.

For answer/clear races, CONVOY_STATE_FAKE_ANSWER_ON_CLEAR=REQUEST=OPTION
records the response immediately before escalation-door clears that request.
CONVOY_STATE_FAKE_ANSWER_ON_GROUPED_NOTE=REQUEST=OPTION records it while
convoy-advance prepares to replace a grouped request whose parkings changed.

For the factory incident of bin/convoy-advance and for bin/escalation-door
(T34, af-ckwina): `bd update` also takes `--unset-metadata KEY`, `--status
VALUE` and `--append-notes TEXT`; as bd 1.4.1 does, `--status closed` on a
bead one of whose `blocks` is not closed fails, unless `--force` is given
(af-npz9v1); `bd create TITLE ... --json` adds an open
task and answers `{"id": ...}` (logged as ["create", ID, TITLE]); `bd close
ID --reason TEXT [--json]` closes it (logged as ["close", ID]); `mail send RECIPIENT
... -s SUBJECT ...` is logged as ["mail", RECIPIENT, SUBJECT] and fails when
CONVOY_STATE_FAKE_MAIL_FAIL is set.
Anything else fails loudly.

The tests start this file thousands of times (3,391 for
tests/convoy-state-test.py alone): it runs without `site` (`-S`) and imports
only what it uses (af-xhryl7).
"""
import fcntl
import json
import os
import re
import sys

STATE_PATH = os.environ["CONVOY_STATE_FAKE_TRACKER"]


def read_state():
    with open(STATE_PATH, encoding="utf-8") as handle:
        # Fake Evaluators and the controller now run concurrently. A
        # read must wait for the fake tracker's read-modify-write lock.
        fcntl.flock(handle.fileno(), fcntl.LOCK_SH)
        return json.load(handle)


def fail(message):
    sys.stderr.write(f"fake gc: {message}\n")
    raise SystemExit(1)


def coerce(value):
    if re.fullmatch(r"-?\d+", value):
        return int(value)
    if value in ("true", "false"):
        return value == "true"
    return value


def fake_answer(env_name, bead_id, metadata):
    answer = os.environ.get(env_name)
    if not answer:
        return
    request, separator, option = answer.partition("=")
    if not separator or not request or not option:
        fail(f"{env_name} must be REQUEST=OPTION")
    if request != bead_id or "gc.escalation_response_option" in metadata:
        return
    metadata.update({"gc.needs_benjamin": "none", "gc.escalation_response_option": option,
                     "gc.escalation_response_at": "9999-01-01T00:00:00Z",
                     "gc.escalation_response_actor": "fake-race"})


def view(bead_id, bead):
    extra = {key: bead[key] for key in ("description", "labels", "assignee", "close_reason") if key in bead}
    return {
        **extra,
        "id": bead_id,
        "title": bead.get("title", ""),
        "status": bead.get("status", "open"),
        "issue_type": bead.get("issue_type", "task"),
        "metadata": bead.get("metadata") or None,
    }


def shown(beads, bead_id):
    bead = beads[bead_id]
    out = view(bead_id, bead)
    dependencies = []
    for kind in ("tracks", "blocks"):
        for dep_id in bead.get(kind, []):
            dependencies.append({**view(dep_id, beads[dep_id]), "dependency_type": kind})
    if dependencies:
        out["dependencies"] = dependencies
    return out


def show(beads, bead_id):
    if bead_id not in beads:
        fail(f"issue not found: {bead_id}")
    print(json.dumps([shown(beads, bead_id)]))


def show_many(beads, bead_ids):
    found = [shown(beads, bead_id) for bead_id in bead_ids if bead_id in beads]
    if not found:
        print(json.dumps({"error": "no issues found matching the provided IDs", "schema_version": 1}))
        return 1
    print(json.dumps(found))
    return 0


def update(state, bead_id, rest):
    bead = state["beads"].get(bead_id)
    if bead is None:
        fail(f"issue not found: {bead_id}")
    metadata = dict(bead.get("metadata") or {})
    forced = "--force" in rest
    rest = [arg for arg in rest if arg != "--force"]
    if any(arg.startswith("gc.escalation_cleared_at=") for arg in rest):
        fake_answer("CONVOY_STATE_FAKE_ANSWER_ON_CLEAR", bead_id, metadata)
    if "--append-notes" in rest:
        fake_answer("CONVOY_STATE_FAKE_ANSWER_ON_GROUPED_NOTE", bead_id, metadata)
    i = 0
    while i < len(rest):
        flag = rest[i]
        if flag == "--status" and i + 1 < len(rest) and rest[i + 1] == "closed" and not forced:
            blockers = [dep for dep in bead.get("blocks") or []
                        if (state["beads"].get(dep) or {}).get("status") != "closed"]
            if blockers:
                fail(f"cannot close blocked issue: {bead_id} is blocked by [{' '.join(blockers)}]")
        if flag == "--set-metadata" and i + 1 < len(rest):
            key, sep, value = rest[i + 1].partition("=")
            if not sep:
                fail(f"invalid --set-metadata (want key=value): {rest[i + 1]}")
            if not re.fullmatch(r"[a-zA-Z_][a-zA-Z0-9_.]*", key):
                fail(f'metadata edit failed for {bead_id}: invalid metadata key "{key}": '
                     "must match [a-zA-Z_][a-zA-Z0-9_.]*")
            metadata[key] = coerce(value)
        elif flag == "--unset-metadata" and i + 1 < len(rest):
            metadata.pop(rest[i + 1], None)
        elif flag == "--status" and i + 1 < len(rest):
            bead["status"] = rest[i + 1]
        elif flag == "--add-label" and i + 1 < len(rest):
            bead["labels"] = sorted({*bead.get("labels", []), rest[i + 1]})
        elif flag == "--append-notes" and i + 1 < len(rest):
            bead["notes"] = (bead.get("notes", "") + "\n" + rest[i + 1]).strip()
        else:
            fail(f"no canned response configured for: bd update {bead_id} {' '.join(rest)}")
        i += 2
    bead["metadata"] = metadata
    log_write([bead_id, *rest, *(("--force",) if forced else ())])
    print(f"Updated issue: {bead_id}")


def log_write(entry):
    log = os.environ.get("CONVOY_STATE_FAKE_WRITE_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(entry) + "\n")


def list_beads(beads, rest):
    wanted = {"type": None, "status": None, "keys": [], "fields": []}
    i = 0
    while i < len(rest):
        flag = rest[i]
        if flag in ("--all", "--json"):
            i += 1
            continue
        if i + 1 >= len(rest):
            fail(f"no canned response configured for: bd list {' '.join(rest)}")
        value = rest[i + 1]
        if flag == "--type":
            wanted["type"] = value
        elif flag == "--status":
            wanted["status"] = value.split(",")
        elif flag == "--has-metadata-key":
            wanted["keys"].append(value)
        elif flag == "--metadata-field":
            wanted["fields"].append(value.partition("=")[::2])
        elif flag != "--limit":
            fail(f"no canned response configured for: bd list {' '.join(rest)}")
        i += 2
    if "--json" not in rest:
        fail("bd list is only canned with --json")
    out = []
    for bead_id in sorted(beads):
        shown = view(bead_id, beads[bead_id])
        metadata = shown["metadata"] or {}
        if wanted["type"] and shown["issue_type"] != wanted["type"]:
            continue
        if wanted["status"] and shown["status"] not in wanted["status"]:
            continue
        if not wanted["status"] and "--all" not in rest and shown["status"] == "closed":
            continue
        if any(key not in metadata for key in wanted["keys"]):
            continue
        if any(str(metadata.get(key)) != value for key, value in wanted["fields"]):
            continue
        out.append(shown)
    print(json.dumps(out))


def create(state, rest):
    if not rest or "--json" not in rest:
        fail(f"no canned response configured for: bd create {' '.join(rest)}")
    title, options = rest[0], rest[1:]
    bead = {"title": title, "status": "open", "issue_type": "task", "metadata": {}}
    i = 0
    while i < len(options):
        flag = options[i]
        if flag == "--json":
            i += 1
            continue
        if flag not in ("-p", "-t", "-d", "--metadata", "--labels") or i + 1 >= len(options):
            fail(f"no canned response configured for: bd create {' '.join(rest)}")
        if flag == "--labels":
            bead["labels"] = options[i + 1].split(",")
        elif flag == "--metadata":
            bead["metadata"] = json.loads(options[i + 1])
        elif flag == "-t":
            bead["issue_type"] = options[i + 1]
        elif flag == "-d":
            bead["description"] = options[i + 1]
        i += 2
    bead_id = f"fx-new{sum(1 for known in state['beads'] if known.startswith('fx-new')) + 1}"
    state["beads"][bead_id] = bead
    log_write(["create", bead_id, title])
    print(json.dumps({"id": bead_id, "title": title, "status": "open"}))


def close(state, bead_id, rest):
    if bead_id not in state["beads"] or rest[:1] != ["--reason"] or rest[2:] not in ([], ["--json"]):
        fail(f"no canned response configured for: bd close {bead_id} {' '.join(rest)}")
    blockers = [dep for dep in state["beads"][bead_id].get("blocks") or []
                if (state["beads"].get(dep) or {}).get("status") != "closed"]
    if blockers:
        fail(f"cannot close blocked issue: {bead_id} is blocked by [{' '.join(blockers)}]")
    state["beads"][bead_id]["status"] = "closed"
    log_write(["close", bead_id])
    print(json.dumps([{"id": bead_id, "status": "closed"}]))


def mail(args):
    if len(args) < 2 or args[0] != "send" or "-s" not in args:
        fail(f"no canned response configured for: mail {' '.join(args)}")
    if os.environ.get("CONVOY_STATE_FAKE_MAIL_FAIL"):
        fail("mail refused")
    log_write(["mail", args[1], args[args.index("-s") + 1]])
    print("Sent")


def sling(args):
    if len(args) != 5 or args[2] != "--on" or args[4] != "--reassign":
        fail(f"no canned response configured for: sling {' '.join(args)}")
    target, bead_id, formula = args[0], args[1], args[3]
    state = read_state()
    if bead_id not in state["beads"]:
        fail(f"issue not found: {bead_id}")
    if bead_id in os.environ.get("CONVOY_STATE_FAKE_SLING_FAIL", "").split(","):
        fail(f"sling refused for {bead_id}")
    log_write(["sling", target, bead_id, formula])
    answer = os.environ.get("CONVOY_STATE_FAKE_ANSWER_ON_SLING")
    if answer:
        request, separator, option = answer.partition("=")
        if not separator or not request or not option:
            fail("CONVOY_STATE_FAKE_ANSWER_ON_SLING must be REQUEST=OPTION")
        with open(STATE_PATH, "r+", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            state = json.loads(handle.read())
            bead = state["beads"].get(request)
            if bead is None:
                fail(f"answer-on-sling request not found: {request}")
            metadata = bead.setdefault("metadata", {})
            if "gc.escalation_response_option" not in metadata:
                metadata.update({"gc.needs_benjamin": "none", "gc.escalation_response_option": option,
                                 "gc.escalation_response_at": "9999-01-01T00:00:00Z",
                                 "gc.escalation_response_actor": "fake-sling"})
                handle.seek(0)
                handle.truncate()
                handle.write(json.dumps(state, indent=2, sort_keys=True))
    print(f'Attached workflow wf-{bead_id} (formula "{formula}") to wf-{bead_id}')


def main(args):
    if args[:1] == ["--city"] and len(args) >= 2:
        args = args[2:]
    if args[:2] == ["bd", "list"]:
        list_beads(read_state()["beads"], args[2:])
        return 0
    if args == ["session", "list", "--json"]:
        state = read_state()
        print(json.dumps({"ok": True, "schema_version": "1", "sessions": state.get("sessions", [])}))
        return 0
    if args[:1] == ["sling"]:
        sling(args[1:])
        return 0
    if args[:2] == ["bd", "show"] and len(args) == 4 and args[3] == "--json":
        state = read_state()
        show(state["beads"], args[2])
        return 0
    if args[:2] == ["bd", "show"] and len(args) > 4 and args[-1] == "--json":
        return show_many(read_state()["beads"], args[2:-1])
    if args[:1] == ["mail"]:
        mail(args[1:])
        return 0
    if args[:2] in (["bd", "update"], ["bd", "create"], ["bd", "close"]) and len(args) >= 3:
        # One real `bd` write is one transaction: hold the file for the
        # whole read-modify-write so two fake writes never tear each other.
        with open(STATE_PATH, "r+", encoding="utf-8") as handle:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
            state = json.loads(handle.read())
            if args[1] == "update":
                update(state, args[2], args[3:])
            elif args[1] == "create":
                create(state, args[2:])
            else:
                close(state, args[2], args[3:])
            handle.seek(0)
            handle.truncate()
            handle.write(json.dumps(state, indent=2, sort_keys=True))
        return 0
    fail(f"no canned response configured for: gc {' '.join(args)}")


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
