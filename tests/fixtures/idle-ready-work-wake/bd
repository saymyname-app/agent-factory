#!/usr/bin/env python3
"""Fake `bd` used by idle-ready-work-wake-test.py: returns the ready-work
list from IDLE_TEST_READY (a JSON array) for `bd -C <root> ready --json`."""
import os
import sys

args = sys.argv[1:]
if len(args) >= 2 and args[0] == "-C":
    args = args[2:]

if args[:1] == ["ready"]:
    print(os.environ.get("IDLE_TEST_READY", "[]"))
    raise SystemExit(0)

print(f"unexpected fake bd arguments: {args}", file=sys.stderr)
raise SystemExit(2)
