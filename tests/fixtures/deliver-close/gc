#!/usr/bin/env bash

set -Eeuo pipefail

if [[ ${1:-} == bd && ${2:-} == show ]]; then
  bead_id=${3:-}
  pr_url=${DELIVER_CLOSE_PR_URL:-}
  metadata=${DELIVER_CLOSE_BEAD_METADATA:-}
  [[ -n $metadata ]] || metadata='{}'
  jq -cn --arg id "$bead_id" --arg pr_url "$pr_url" --argjson metadata "$metadata" \
    '[{id:$id,status:"in_progress",metadata:($metadata + {"gc.pr_url":$pr_url})}]'
  exit 0
fi

[[ ${1:-} == bd && ${2:-} == update ]] || exit 64
shift 2

: "${DELIVER_CLOSE_CALL_LOG:?DELIVER_CLOSE_CALL_LOG must be set by the test}"
printf '%s\n' "$*" >> "$DELIVER_CLOSE_CALL_LOG"
