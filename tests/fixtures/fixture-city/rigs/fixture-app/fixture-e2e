#!/usr/bin/env python3

import json
import subprocess
from pathlib import Path

service = Path(__file__).with_name("fixture-service")
result = subprocess.run((str(service),), text=True, capture_output=True, check=True)
payload = json.loads(result.stdout)
if payload != {"contract": "fixture-status/v1", "value": "ready"}:
    raise SystemExit("fixture app returned unexpected public behavior")
