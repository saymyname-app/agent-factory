        (self.workspace / "end-review-plan.json").write_text(json.dumps(["favorable"]))
        # The Evaluator is not sent in the pass that sends the reviewer (its
        # door defers once): review and evaluation are observed one by one.
        # With `story-not-observed`, the Evaluator of the repair then looks
        # at the entry point the repair restores.
        (self.workspace / "evaluation-plan.json").write_text(json.dumps(
            ["door-defers", self.project["evaluation"], *((ITEMS,) if through_the_door else ())]))
        where = {"repo": str(self.root), "environment": self.state_environment(),
                 "profile": str(config / "project-descriptors" / profile)}
        self.remember(inject=inject, project=project, answer=answer, base=self.git("rev-parse", "HEAD"),
                      profile=where["profile"])
        # The publication door numbers the convoy and the ticket: `publish` names them.
        return where if through_the_door else {"convoy": CONVOY, "ticket": TICKET, **where}

    def publish_through_the_door(self, base: str) -> dict:
        """`story-not-observed`: what a Planning Run leaves -- a Spec with
        two user stories, approved by the real bin/spec-approve (T52,
        af-ezqgma: nobody writes its approval by hand), an approved Ticket
        Graph Draft whose one slice covers both, its favorable graph review
        -- then the real publication door, which writes the convoy, marks it
        and opens the integration branch of the Spec."""
        def digest(text: str) -> str:
            return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()

        def favorable(checks: list[str]) -> dict:
            return {"checks": {name: {"state": "favorable"} for name in checks}}

        descriptor = json.loads((ROOT / self.fixture / "descriptor.json").read_text())
        # The Validated Prototype the approval door holds the Spec to: on its
        # prototype branch, never merged, in the repository of the product.
        frozen = materialize(self.workspace / "prototype.git")
        self.git("fetch", "-q", self.workspace / "prototype.git", f"{PROTOTYPE_BRANCH}:{PROTOTYPE_BRANCH}")
        spec = (
            "Spec synthétique de la Fixture City (T26, af-vwcflt). Données de test seulement.\n\n"
            "## Problem Statement\n\nUn visiteur ne voit pas le jeu de données servi, un intégrateur ne peut pas le relire.\n\n"
            "## Solution\n\nUne page d'accueil qui affiche le jeu de données, et ses éléments en JSON.\n\n"
            "## User Stories\n\n"
            "1. As a visiteur, I want voir l'état et les éléments du jeu de données sur la page d'accueil, "
            "so that je sache ce qui est servi. [interface]\n"
            "2. As an intégrateur, I want la liste des éléments en JSON à l'adresse /items, "
            "so that je puisse la relire par programme.\n\n"
            f"## Validated Prototype\n\n- branche : `{PROTOTYPE_BRANCH}`\n- commit : `{frozen}`\n"
            f"- chemin : `{self.fixture}/prototype`\n"
            "- états : `empty`, `content`\n\n### Écran : accueil\n\n"
            "| État | Statut | Détail |\n| --- | --- | --- |\n| vide | prototypé | empty |\n| contenu | prototypé | content |\n"
            "| chargement | sans objet | la page est rendue en une seule réponse du serveur |\n"
            "| erreur | non prototypé | |\n| contenu long | non prototypé | |\n| écran étroit | non prototypé | |\n"
            "| thème sombre | sans objet | la fixture n'a qu'un thème clair |\n\n"
            "## Implementation Decisions\n\nLa page d'accueil porte les ancres du Validated Prototype.\n\n"
            "## Testing Decisions\n\nFixture City Oracle et ligne de commande des portes.\n\n"
            "## Out of Scope\n\nTout le reste.\n")
        draft = yaml.safe_dump({"flow_contract": "new-flow/v1", "operator_needs": [], "tickets": [{
            "id": WALKED_KEY, "kind": "vertical_slice", "title": "La page d'accueil affiche le jeu de données",
            "blocked_by": [], "target_rigs": [RIG],
            "what_it_delivers": "La page d'accueil du produit affiche l'état et les éléments du jeu de données servi.",
            "demonstration_line": "Sur le produit lancé avec le jeu de données « content », la page d'accueil (GET /) "
                                  "affiche les trois éléments « alpha », « beta » et « gamma ».",
            "user_stories": [1, 2], "prototype_fold": True,
            "acceptance_criteria": [{
                "entry_point": "GET / sur le produit lancé avec le jeu de données « content »",
                "observable": "la liste contient trois lignes, libellées « alpha », « beta », « gamma »",
                "false_if": "une ligne manque, ou la liste est absente de la page"}]}]},
            allow_unicode=True, sort_keys=False)
        self.tracker.write_text(json.dumps({"next_id": 1, "sessions": [], "beads": {
            DRAFT: {"id": DRAFT, "title": "Draft", "description": draft, "status": "open", "labels": [], "metadata": {
                "spec_id": SPEC, "display_title": "Fixture City : le jeu de données servi", "language": "fr",
                "approved_by": "benjamin", "approved_evidence": "« j'approuve le graphe » (Benjamin, fixture)",
                "approved_digest": digest(draft)}},
            SPEC: {"id": SPEC, "title": "Spec de la fixture", "description": spec, "status": "open", "labels": [],
                   "metadata": {"spec_state": "DRAFT_SPEC", "planning_map": "none",
                                "no_fog_evidence": "« pas de brouillard » (Benjamin, fixture)",
                                "gc.project_id": descriptor["project_id"], "planning_run_target": "F01"}}}}))
        self.run(SPEC_APPROVE, "bd-approve", "--spec", SPEC, "--approved-by", APPROVER,
                 "--evidence", "« j'approuve la Spec » (Benjamin, fixture)", "--project", descriptor["project_id"],
                 "--repo-root", self.root, "--prototype-remote", self.root)
        # The graph review reads its reviewer role in settings of its own.
        factory = self.workspace / "graph-review-factory"
        (factory / "config").mkdir(parents=True)
        (factory / "config" / "delivery-roles.json").write_text(
            json.dumps({"roles": {"reviewer": {"agent": "delivery-reviewer"}}}))
        (factory / "city.toml").write_text('[providers.reviewer-profile]\nargs_append = ["--model", "modele-relecteur"]\n')
        reviewing = {"FACTORY_ROOT": str(factory), "DELIVERY_ROLE_READ_ONLY": "1",
                     "GRAPH_REVIEW_PROVIDER_FAILOVER_BIN": str(REVIEW_FAILOVER)}
        self.run(GRAPH_REVIEW, "request", DRAFT, "--author-model", "modele-auteur", **reviewing)
        brief = json.loads(self.run(GRAPH_REVIEW, "brief", DRAFT, **reviewing).stdout)
        verdict = self.workspace / "graph-verdict.json"
        verdict.write_text(json.dumps({
            "digest": brief["digest"], "graph": favorable(brief["graph_checks"]),
            "tickets": {ticket["id"]: favorable(ticket["checks"]) for ticket in brief["tickets"]}}))
        self.run(GRAPH_REVIEW, "record", DRAFT, "--verdict-file", verdict, **reviewing)
        published = json.loads(self.run(
            PUBLISHER, "bd-publish", DRAFT, "--project", descriptor["project_id"], "--repo-root", self.root).stdout)
        memo = self.remember(convoy=published["ids"]["_convoy"], ticket=published["ids"][WALKED_KEY],
                             integration=published["integration"]["branch"])
        return {"published": True, "convoy": memo["convoy"], "ticket": memo["ticket"]}

    def publish(self) -> dict:
        base = json.loads(self.memo.read_text())["base"]
        if json.loads(self.memo.read_text())["inject"] in THROUGH_THE_DOOR:
            return self.publish_through_the_door(base)
        interface = self.project["interface"]
        prototype = (
            f"## Validated Prototype\n\n- branche : main\n- commit : {base}\n- chemin : {self.fixture}/prototype\n"
            f"- états : empty, content\n- Prototype Fold : ce ticket\n\n") if interface else ""
        description = (
            f"## Acceptance criteria\n\n- [ ] {self.project['criterion']}\n\n{prototype}"
            f"## Target rigs\n\n{RIG}")
        beads = {
            CONVOY: {"title": "convoi de la fixture", "status": "open", "issue_type": "convoy",
                     "metadata": {"gc.spec_id": SPEC}, "tracks": [TICKET]},
            TICKET: {"title": "ticket de la fixture", "status": "open", "issue_type": "task",
                     "description": description, "metadata": {"gc.ticket_kind": "vertical_slice"}, "blocks": []},
            SPEC: {"title": "Spec de la fixture", "status": "open", "issue_type": "task",
                   "description": "## User Stories\n\n1. As Benjamin, I want la liste des éléments."},
        }
        if json.loads(self.memo.read_text())["inject"] == "three-failures":
            for ticket_id, title, blocks in ((SICK, "ticket dont l'auteur échoue", []), (BEHIND, "ticket qui l'attend", [SICK])):
                beads[ticket_id] = {
                    "title": title, "status": "open", "issue_type": "task",
                    "description": f"## Acceptance criteria\n\n- [ ] Le comportement est inchangé\n\n## Target rigs\n\n{RIG}",
                    "metadata": {"gc.ticket_kind": "prefactoring"}, "blocks": blocks}
            beads[CONVOY]["tracks"] = [TICKET, SICK, BEHIND]
        self.tracker.write_text(json.dumps({"beads": beads, "sessions": []}))
        self.state("mark", self.convoy, "--demonstration-line", f"{TICKET}={self.project['line']}",
                   "--user-stories", f"{TICKET}=1", *(("--prototype-fold", TICKET) if interface else ()))
        self.run(BIN / "spec-integration", "open", self.convoy, "--repo", self.root, "--protected", "main")
        return {"published": True}

    # --- the events ------------------------------------------------------------------

    def order_pass(self) -> str:
        """One pass of the Factory's order on the convoy. A convoy the pass
        stops (exit 3) is an outcome the oracle reads, not a driver failure."""
        proc = self.run(BIN / "convoy-advance", self.convoy, "--stopped-ok", check=False)
        if proc.returncode not in (0, 3):
            raise SystemExit(f"delivery-driver: convoy-advance failed ({proc.returncode}): {proc.stdout[-800:]}{proc.stderr[-300:]}")
        # What the pass answered, for whoever reads the walk afterwards.
        (self.workspace / "order-pass.json").write_text(proc.stdout)
        return "order-pass"

    def gate(self, tool: str, *args, **more: str) -> dict:
        """One gate of the author's step, as an author session runs it:
        the real command, which writes the state it is responsible for."""
        return json.loads(self.run(BIN / tool, *args, **more).stdout)

    def commit(self, worktree: Path, files: dict[str, str], message: str) -> None:
        """One commit of an author in the worktree of its ticket."""
        for path, content in files.items():
            target = worktree / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(content)
        self.run("git", "-C", worktree, *GIT_IDENTITY, "add", "-A")
        self.run("git", "-C", worktree, *GIT_IDENTITY, "commit", "-q", "-m", message)

    def criteria(self, ticket: str) -> int:
        """How many acceptance criteria the ticket carries in the tracker."""
        description = json.loads(self.tracker.read_text())["beads"][ticket].get("description") or ""
        section = description.split("## Acceptance criteria", 1)[-1].split("\n## ", 1)[0]
        return max(1, sum(1 for line in section.splitlines() if line.lstrip().startswith("- [")))

    def author(self, shown: dict, memo: dict) -> str:
        """One event of an author session. What the session leaves (test
        files, commits, its Handoff) is written here; each state of the
        ticket is written by the gate that is responsible for it."""
        ticket, repair = shown["id"], shown["id"] != self.walked
        work = REPAIR if repair else self.project
        worktree = self.workspace / "worktrees" / ticket
        tests = f"{self.fixture}/tests"
        (name, test, content), table = work["test"], f"{tests}/criteria-{'repair' if repair else 'ticket'}.json"
        profile = ("--profile", memo["profile"], "--dataset", "content")
        if not shown.get("branch"):
            started = self.gate("ticket-author", "start", self.convoy, ticket, "--repo", self.root,
                                "--session", f"auteur-{ticket}")
            self.commit(Path(started["worktree"]), {
                f"{tests}/{name}": content,
                table: json.dumps({"criteria": {str(number): [f"{tests}/{name}::{test}"]
                                                for number in range(1, self.criteria(ticket) + 1)}}) + "\n",
            }, "tests de critère")
            self.gate("tdd-step", "red", self.convoy, ticket, "--repo", worktree, *profile,
                      "--base", started["base"], "--table", table)
            return "session:red"
        if not (shown.get("tdd") or {}).get("freeze"):
            self.gate("test-review", "review", self.convoy, ticket, "--repo", worktree, "--wait", "0",
                      TEST_REVIEW_FAKE_REPO=str(worktree))
            self.gate("tdd-step", "freeze", self.convoy, ticket, "--repo", worktree)
            return "session:freeze"
        product, before, after = work["product"]
        served = (worktree / self.fixture / product).read_text()
        if before not in served:
            raise SystemExit(f"delivery-driver: {self.fixture / product} no longer holds what the ticket changes: {before.strip()}")
        self.commit(worktree, {f"{self.fixture}/{product}": served.replace(before, after, 1)}, "travail du ticket")
        self.gate("tdd-step", "green", self.convoy, ticket, "--repo", worktree, *profile)
        self.gate("ticket-author", "demonstrate", self.convoy, ticket, "--repo", worktree, "--dataset", "content",
                  "--profile", memo["profile"], "--", "sh", "-c",
                  f'curl -sf "$PRODUCT_ADDRESS{work["demonstration"]}" | grep -F alpha')
        handoff = self.workspace / "tmp" / f"handoff-{ticket}.json"
        handoff.write_text(json.dumps({**HANDOFF, **({"out_of_ticket": [OUT_OF_TICKET]}
                                                     if memo["inject"] == "proposition" and not repair else {})}))
        self.gate("ticket-exit", "exit", self.convoy, ticket, "--exit", "finished", "--repo", worktree, "--handoff", handoff)
        return "session:code"

    def failed_session(self, memo: dict) -> str | None:
        """`three-failures`: one more author session takes the sick ticket
        and ends without a Ticket Exit, once the order has sent it one."""
        failures = memo.get("failures", 0)
        sick = self.ticket(SICK)
        if failures >= FAILURES or "dispatch" not in (sick.get("gates") or {}) or sick.get("park"):
            return None
        entries = (sick.get("resume") or {}).get("entries") or []
        if failures and (len(entries) < failures or not entries[-1]["launches"]):
            return None  # the order has not sent the resume of the failure before yet
        self.gate("ticket-author", "start", self.convoy, SICK, "--repo", self.root,
                  "--session", f"auteur-{failures + 1}")
        if entries:
            self.run(FAKE_GC, "bd", "close", entries[-1]["launches"][-1]["bead"], "--reason", "session terminée sans sortie")
        self.remember(failures=failures + 1)
        return "session:ended-without-exit"

    def owner_answer(self, memo: dict) -> str | None:
        """`--answer`: once the Outcome is Delivered, what Benjamin answers,
        recorded by the real bin/owner-answer. The driver is the operator
        here: the environment of the call names no agent session."""
        if memo.get("answer", "none") == "none" or memo.get("answered"):
            return None
        shown = json.loads(self.run(BIN / "convoy-state", "show", self.convoy, "--repo", self.root, check=False).stdout)
        delivered = shown["convoy"].get("delivered")
        if not delivered:
            return None

        def say(command: str, *args: str) -> None:
            self.run(BIN / "owner-answer", command, self.convoy, "--repo", self.root, "--approved-by", APPROVER, *args)

        if memo["answer"] == "abandoned":
            say("record", "--response", "abandonné", "--reason", ABANDON_REASON)
        else:
            # « accepté » waits for his verdict on each « proposition » of the dossier.
            judged = {entry["proposition"] for entry in (shown["convoy"].get("judgement") or {}).get("verdicts") or []}
            for ticket in shown["tickets"]:
                for finding in ticket.get("findings") or []:
                    if finding.get("classification") == "proposal" and finding["id"] not in judged:
                        say("verdict", "--proposition", finding["id"], "--verdict", "sans suite", "--words", VERDICT_WORDS)
            say("record", "--response", "accepté", "--words", ACCEPTED_WORDS,
                "--commit", delivered["commit"], "--pack-digest", delivered["pack"])
        self.remember(answered=True)
        return f"owner:{memo['answer']}"

    def advance(self) -> dict:
        memo = json.loads(self.memo.read_text())
        before = self.tracker.read_bytes()
        answered = self.owner_answer(memo)
        if answered:
            return {"event": answered, "idle": before == self.tracker.read_bytes()}
        shown = self.at_work()
        gates, finished = shown.get("gates") or {}, (shown.get("exit") or {}).get("exit") == "finished"
        failed = self.failed_session(memo) if memo["inject"] == "three-failures" else None
        if failed:
            event = failed
        elif memo["inject"] == "three-failures" and "dispatch" in gates and not self.ticket(SICK).get("park"):
            # The sick ticket fails before the walked one goes on: the order
            # counts the failure, then resumes or parks.
            event = self.order_pass()
        elif "dispatch" not in gates or shown.get("status") == "closed":
            event = self.order_pass()
        elif not finished:
            event = self.author(shown, memo)
        else:
            if memo["inject"] == "criterion-edited" and not memo.get("injected"):
                state = json.loads(self.tracker.read_text())
                criterion = self.project["criterion"]
                state["beads"][TICKET]["description"] = state["beads"][TICKET]["description"].replace(
                    criterion, criterion + " ou deux")
                self.tracker.write_text(json.dumps(state))
                self.remember(injected=True)
                before = self.tracker.read_bytes()
            if memo["inject"] == "closed-by-hand" and not memo.get("injected"):
                self.run(FAKE_GC, "bd", "close", TICKET, "--reason", "PR fusionnée, CI verte")
                self.remember(injected=True)
                event = "session:closed-by-hand"
            else:
                event = self.order_pass()
        return {"event": event, "idle": before == self.tracker.read_bytes()}

    def stop_products(self) -> None:
        # An Acceptance Session left open: its product is stopped with it.
        if (self.workspace / "acceptance-sessions").is_dir():
            self.run(BIN / "acceptance-session", "close", self.convoy, check=False)
        launches = self.workspace / "launches"
        for record in launches.rglob("*.json") if launches.is_dir() else ():
            self.run(BIN / "project-launch", "stop", "--state-file", record, check=False)


def main() -> int:
    parser = argparse.ArgumentParser(prog="delivery-driver")
    parser.add_argument("--workspace", type=Path, required=True)
    sub = parser.add_subparsers(dest="command", required=True)
    prepare = sub.add_parser("prepare")
    prepare.add_argument("--inject", choices=INJECTIONS, default="none")
    prepare.add_argument("--project", default=DEFAULT_PROJECT)
    prepare.add_argument("--answer", choices=ANSWERS, default="none")
    for name in ("publish", "advance", "stop"):
        sub.add_parser(name)
    args = parser.parse_args()
    city = City(args.workspace.resolve())
    if args.command == "prepare":
        if args.project not in PROJECTS:
            raise SystemExit(f"delivery-driver: unknown project of the fixture: {args.project} "
                             f"(known: {', '.join(PROJECTS)})")
        if args.inject in THROUGH_THE_DOOR and args.project != DEFAULT_PROJECT:
            raise SystemExit(f"delivery-driver: --inject {args.inject} is played on {DEFAULT_PROJECT} only: "
                             f"the story it leaves unserved is one {args.project} already serves")
        answer = city.prepare(args.inject, args.project, args.answer)
    elif args.command == "publish":
        answer = city.publish()
    elif args.command == "advance":
        answer = city.advance()
    else:
        city.stop_products()
        answer = {"stopped": True}
    print(json.dumps(answer, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
