class City:
    def __init__(self, workspace: Path):
        self.workspace = workspace
        self.root = workspace / "city"
        self.tracker = workspace / "tracker.json"
        self.memo = workspace / "driver.json"
        memo = json.loads(self.memo.read_text()) if self.memo.exists() else {}
        self.use(memo.get("project", DEFAULT_PROJECT))
        # The convoy and the walked ticket: named by the driver, or by the
        # publication door when it publishes them.
        self.convoy, self.walked = memo.get("convoy", CONVOY), memo.get("ticket", TICKET)

    def use(self, project: str) -> None:
        self.project = PROJECTS[project]
        self.fixture = FIXTURES / project

    def path(self) -> str:
        """The PATH of the order: the one the driver was given, and the
        directory of the interpreter of the project when it is not on it
        (the oracle gives its adapters a bare PATH; a per-user install of
        Node.js sits in ~/.local/bin)."""
        given = os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin")
        interpreter = self.project["interpreter"]
        if not interpreter or shutil.which(interpreter, path=given):
            return given
        local = Path(pwd.getpwuid(os.getuid()).pw_dir) / ".local" / "bin"
        if not shutil.which(interpreter, path=str(local)):
            raise SystemExit(f"delivery-driver: {interpreter} is not installed: the project "
                             f"{self.fixture.name} is launched and tested with it")
        return f"{given}:{local}"

    # --- environment -----------------------------------------------------------

    def state_environment(self) -> dict[str, str]:
        """What a reader of the public state needs: the tracker, the
        evidence store, the locks. Nothing of the driver."""
        return {
            "GC_BIN": str(FAKE_GC),
            "FACTORY_ROOT": str(self.root),
            "CONVOY_STATE_FAKE_TRACKER": str(self.tracker),
            "CONVOY_STATE_LOCK_DIR": str(self.workspace / "locks"),
            "EVIDENCE_STORE_DIR": str(self.workspace / "store"),
            "EVIDENCE_PACK_DIR": str(self.workspace / "packs"),
            # The list of the escalation door also counts the pending proposals.
            "PROPOSAL_DOOR_BIN": str(self.workspace / "proposal-door"),
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_CONFIG_SYSTEM": os.devnull,
        }

    def door_environment(self) -> dict[str, str]:
        """What the publication door and its patch door need to write the
        tracker the flow reads: the fake `bd`, on the same file."""
        return {
            "BD_BIN": str(FAKE_BD),
            "TICKET_GRAPH_BD_STATE": str(self.tracker),
            "TICKET_GRAPH_BD_WORKSPACE": str(self.workspace),
        }

    def env(self, **more: str) -> dict[str, str]:
        """The environment of the Factory's order: no agent session."""
        home = self.workspace / "home"
        home.mkdir(exist_ok=True)
        return {
            "PATH": self.path(),
            "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "HOME": str(home), "TMPDIR": str(self.workspace / "tmp"),
            "PYTHONDONTWRITEBYTECODE": "1",
            **self.state_environment(),
            **self.door_environment(),
            "CONVOY_STATE_FAKE_WRITE_LOG": str(self.workspace / "writes.log"),
            "CONVOY_ADVANCE_LOCK_DIR": str(self.workspace / "locks"),
            "SPEC_INTEGRATION_LOCK_DIR": str(self.workspace / "locks"),
            "SPEC_INTEGRATION_WORK_DIR": str(self.workspace / "work"),
            "TICKET_END_WORK_DIR": str(self.workspace / "gate-work"),
            "DISPATCH_DOOR_PROVIDER_FAILOVER_BIN": str(self.workspace / "provider-failover"),
            "DISPATCH_DOOR_MEMINFO_FILE": str(self.workspace / "no-meminfo"),
            "ESCALATION_DOOR_LOCK_FILE": str(self.workspace / "escalation-door.lock"),
            "GC_ESCALATION_RECIPIENT": "human",
            "EVIDENCE_CAPTURE_BROWSER": str(BROWSER),
            "EVIDENCE_FAKE_BROWSER_LOG": str(self.workspace / "browser.log"),
            "CODE_REVIEW_DISPATCH_DOOR_BIN": str(REVIEWER),
            "CODE_REVIEW_FAKE_LOG": str(self.workspace / "code-review-door.log"),
            "CODE_REVIEW_FAKE_PLAN": str(self.workspace / "code-review-plan.json"),
            "CODE_REVIEW_FAKE_REPO": str(self.root),
            "TICKET_EVALUATION_DISPATCH_DOOR_BIN": str(EVALUATOR),
            "TICKET_EVALUATION_STATE_DIR": str(self.workspace / "launches"),
            "TICKET_EVALUATION_FAKE_LOG": str(self.workspace / "evaluation-door.log"),
            "TICKET_EVALUATION_FAKE_PLAN": str(self.workspace / "evaluation-plan.json"),
            "OUTCOME_EVALUATION_DISPATCH_DOOR_BIN": str(END_EVALUATOR),
            "OUTCOME_EVALUATION_STATE_DIR": str(self.workspace / "launches" / "outcome"),
            "OUTCOME_EVALUATION_FAKE_LOG": str(self.workspace / "outcome-door.log"),
            "OUTCOME_EVALUATION_FAKE_PLAN": str(self.workspace / "outcome-plan.json"),
            "SPEC_END_REVIEW_DISPATCH_DOOR_BIN": str(END_REVIEWER),
            "SPEC_END_REVIEW_FAKE_LOG": str(self.workspace / "end-review-door.log"),
            "SPEC_END_REVIEW_FAKE_PLAN": str(self.workspace / "end-review-plan.json"),
            "SPEC_END_REVIEW_FAKE_REPO": str(self.root),
            **more,
        }

    def run(self, *argv, check=True, **more: str) -> subprocess.CompletedProcess:
        proc = subprocess.run([str(part) for part in argv], env=self.env(**more), text=True, capture_output=True,
                              stdin=subprocess.DEVNULL)
        if check and proc.returncode != 0:
            raise SystemExit(f"delivery-driver: {' '.join(str(part) for part in argv[:3])} failed "
                             f"({proc.returncode}): {(proc.stdout + proc.stderr).strip()[-600:]}")
        return proc

    def git(self, *args) -> str:
        return self.run("git", "-C", self.root, *GIT_IDENTITY, *args).stdout.strip()

    def state(self, *args):
        return json.loads(self.run(BIN / "convoy-state", *args).stdout)

    def tickets(self) -> list[dict]:
        proc = self.run(BIN / "convoy-state", "show", self.convoy, "--repo", self.root, check=False)
        return json.loads(proc.stdout)["tickets"]

    def ticket(self, ticket_id: str) -> dict:
        return next(entry for entry in self.tickets() if entry["id"] == ticket_id)

    def at_work(self) -> dict:
        """The ticket an author session works on: the walked one, then,
        once it is closed, a `repair` the order published in the convoy and
        that is still open. The walked one again when nothing is left."""
        shown = self.tickets()
        walked = next(entry for entry in shown if entry["id"] == self.walked)
        candidates = [walked, *(entry for entry in shown if entry.get("kind") == "repair" and entry["id"] != self.walked)]
        return next((entry for entry in candidates if entry.get("status") != "closed"), walked)

    def remember(self, **values) -> dict:
        memo = json.loads(self.memo.read_text()) if self.memo.exists() else {}
        memo.update(values)
        self.memo.write_text(json.dumps(memo))
        return memo

    # --- prepare, publish ----------------------------------------------------------

    def prepare(self, inject: str, project: str) -> dict:
        self.use(project)
        for name in ("tmp", "locks"):
            (self.workspace / name).mkdir(parents=True, exist_ok=True)
        for name, body in (("provider-failover", "#!/bin/sh\nprintf '{}\\n'\n"), ("proposal-door", "#!/bin/sh\necho 0\n")):
            (self.workspace / name).write_text(body)
            (self.workspace / name).chmod(0o755)
        config = self.root / "config"
        (config / "projects").mkdir(parents=True)
        (config / "project-descriptors").mkdir()
        (config / "projects" / f"{RIG}.toml").write_text(
            'rig_dir = "."\nrepo = "example/fx"\nprotected_branch = "main"\nrequired_ci = "CI"\n'
            'sling_target = "fx-worker"\nformulas = "fx-start,fx-resume"\n')
        shutil.copy(ROOT / "config" / "delivery-roles.json", config / "delivery-roles.json")
        (config / "delivery-flow.json").write_text(json.dumps({
            "contract": "agent-factory-delivery-flow/v1", "max_sessions": 5,
            "start": {"formula": "fx-start", "role": None}, "resume": {"formula": "fx-resume", "role": None},
            "code_review": {"formula": "mol-code-review", "role": "reviewer", "rig": RIG, "timeout_seconds": 3600},
            "evaluation": {"formula": "mol-ticket-evaluation", "role": "evaluator", "rig": RIG,
                           "timeout_seconds": 3600, "start_timeout_seconds": 15},
            "outcome_evaluation": {"formula": "mol-outcome-evaluation", "role": "evaluator", "rig": RIG,
                                   "timeout_seconds": 3600, "start_timeout_seconds": 15},
            "end_review": {"formula": "mol-end-review", "role": "reviewer", "rig": RIG, "timeout_seconds": 3600}}))
        descriptor = json.loads((ROOT / self.fixture / "descriptor.json").read_text())
        descriptor["rigs"] = [RIG]
        if self.project["regression_command"]:
            descriptor["launch"]["regression_command"] = self.project["regression_command"]
        through_the_door = inject == "story-not-observed"
        if through_the_door:
            # The doors read the project of the Spec by its key: its human
            # approver, and its profile under the name of the project.
            (config / "projects" / f"{descriptor['project_id']}.toml").write_text(
                f'human_approver = "benjamin"\nrig_dir = "rigs/{descriptor["project_id"]}"\nrepo = "example/fx"\n'
                'protected_branch = "main"\nrequired_ci = "CI"\nsling_target = "fx-worker"\n'
                'formulas = "fx-start,fx-resume"\n')
        profile = f"{descriptor['project_id']}.json" if through_the_door else "fx.json"
        (config / "project-descriptors" / profile).write_text(json.dumps(descriptor))
        (self.root / ".gitignore").write_text("config/\n")
        # The product, launchable; the first project with its Validated Prototype.
        shutil.copytree(ROOT / self.fixture, self.root / self.fixture, ignore=shutil.ignore_patterns("__pycache__"))
        self.git("init", "-q", "-b", "main")
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "base")
        self.tracker.write_text(json.dumps({"beads": {}, "sessions": []}))
        (self.workspace / "code-review-plan.json").write_text(json.dumps(["favorable"]))
        # The Evaluator of the end observes each user story on the home page;
        # with `story-not-observed`, the second one where the Spec says it is
        # served, on the product as it is launched: not at first.
        (self.workspace / "outcome-plan.json").write_text(json.dumps(
            [{"stories": {"2": ITEMS}}] if through_the_door else [{}]))
        # The reviewer of the end finds nothing to block on the assembled diff.
        (self.workspace / "end-review-plan.json").write_text(json.dumps(["favorable"]))
        # The Evaluator is not sent in the pass that sends the reviewer (its
        # door defers once): review and evaluation are observed one by one.
        # With `story-not-observed`, the Evaluator of the repair then looks
        # at the entry point the repair restores.
        (self.workspace / "evaluation-plan.json").write_text(json.dumps(
            ["door-defers", self.project["evaluation"], *((ITEMS,) if through_the_door else ())]))
        self.remember(inject=inject, project=project, base=self.git("rev-parse", "HEAD"))
        where = {"repo": str(self.root), "environment": self.state_environment()}
        # The publication door numbers the convoy and the ticket: `publish` names them.
        return where if through_the_door else {"convoy": CONVOY, "ticket": TICKET, **where}

    def publish_through_the_door(self, base: str) -> dict:
        """`story-not-observed`: what a Planning Run leaves -- an approved
        Spec with two user stories, an approved Ticket Graph Draft whose one
        slice covers both, its favorable graph review -- then the real
        publication door, which writes the convoy, marks it and opens the
        integration branch of the Spec."""
        def digest(text: str) -> str:
            return "sha256:" + hashlib.sha256(text.encode("utf-8")).hexdigest()

        def favorable(checks: list[str]) -> dict:
            return {"checks": {name: {"state": "favorable"} for name in checks}}

        descriptor = json.loads((ROOT / self.fixture / "descriptor.json").read_text())
        spec = (
            "Spec synthétique de la Fixture City (T26, af-vwcflt). Données de test seulement.\n\n"
            "## Problem Statement\n\nUn visiteur ne voit pas le jeu de données servi, un intégrateur ne peut pas le relire.\n\n"
            "## Solution\n\nUne page d'accueil qui affiche le jeu de données, et ses éléments en JSON.\n\n"
            "## User Stories\n\n"
            "1. As a visiteur, I want voir l'état et les éléments du jeu de données sur la page d'accueil, "
            "so that je sache ce qui est servi. [interface]\n"
            "2. As an intégrateur, I want la liste des éléments en JSON à l'adresse /items, "
            "so that je puisse la relire par programme.\n\n"
            f"## Validated Prototype\n\n- branche : `main`\n- commit : `{base}`\n- chemin : `{self.fixture}/prototype`\n"
            "- états : `empty`, `content`\n\n### Écran : accueil\n\n"
            "| État | Statut | Détail |\n| --- | --- | --- |\n| vide | prototypé | empty |\n| contenu | prototypé | content |\n"
            "| chargement | sans objet | la page est rendue en une seule réponse du serveur |\n"
            "| erreur | non prototypé | |\n| contenu long | non prototypé | |\n| écran étroit | non prototypé | |\n"
            "| thème sombre | sans objet | la fixture n'a qu'un thème clair |\n\n"
            "## Implementation Decisions\n\nLa page d'accueil porte les ancres du Validated Prototype.\n\n"
            "## Testing Decisions\n\nFixture City Oracle et ligne de commande des portes.\n\n"
            "## Out of Scope\n\nTout le reste.\n")
        draft = yaml.safe_dump({"flow_contract": "new-flow/v1", "tickets": [{
            "id": WALKED_KEY, "kind": "vertical_slice", "title": "La page d'accueil affiche le jeu de données",
            "blocked_by": [], "target_rigs": [RIG],
            "what_it_delivers": "La page d'accueil du produit affiche l'état et les éléments du jeu de données servi.",
            "demonstration_line": "Sur le produit lancé avec le jeu de données « content », la page d'accueil (GET /) "
                                  "affiche les trois éléments « alpha », « beta » et « gamma ».",
            "user_stories": [1, 2], "prototype_fold": True,
            "acceptance_criteria": [{
                "entry_point": "GET / sur le produit lancé avec le jeu de données « content »",
                "observable": "la liste contient trois lignes, libellées « alpha », « beta », « gamma »",
                "false_if": "une ligne manque, ou la liste est absente de la page"}]}]},
            allow_unicode=True, sort_keys=False)
        self.tracker.write_text(json.dumps({"next_id": 1, "sessions": [], "beads": {
            DRAFT: {"id": DRAFT, "title": "Draft", "description": draft, "status": "open", "labels": [], "metadata": {
                "spec_id": SPEC, "display_title": "Fixture City : le jeu de données servi", "language": "fr",
                "approved_by": "benjamin", "approved_evidence": "« j'approuve le graphe » (Benjamin, fixture)",
                "approved_digest": digest(draft)}},
            SPEC: {"id": SPEC, "title": "Spec de la fixture", "description": spec, "status": "open", "labels": [],
                   "metadata": {"spec_state": "APPROVED_SPEC", "approved_digest": digest(spec),
                                "gc.project_id": descriptor["project_id"], "planning_run_target": "F01"}}}}))
        # The graph review reads its reviewer role in settings of its own.
        factory = self.workspace / "graph-review-factory"
        (factory / "config").mkdir(parents=True)
        (factory / "config" / "delivery-roles.json").write_text(
            json.dumps({"roles": {"reviewer": {"agent": "delivery-reviewer"}}}))
        (factory / "city.toml").write_text('[providers.reviewer-profile]\nargs_append = ["--model", "modele-relecteur"]\n')
        reviewing = {"FACTORY_ROOT": str(factory), "DELIVERY_ROLE_READ_ONLY": "1",
                     "GRAPH_REVIEW_PROVIDER_FAILOVER_BIN": str(REVIEW_FAILOVER)}
        self.run(GRAPH_REVIEW, "request", DRAFT, "--author-model", "modele-auteur", **reviewing)
        brief = json.loads(self.run(GRAPH_REVIEW, "brief", DRAFT, **reviewing).stdout)
        verdict = self.workspace / "graph-verdict.json"
        verdict.write_text(json.dumps({
            "digest": brief["digest"], "graph": favorable(brief["graph_checks"]),
            "tickets": {ticket["id"]: favorable(ticket["checks"]) for ticket in brief["tickets"]}}))
        self.run(GRAPH_REVIEW, "record", DRAFT, "--verdict-file", verdict, **reviewing)
        published = json.loads(self.run(
            PUBLISHER, "bd-publish", DRAFT, "--project", descriptor["project_id"], "--repo-root", self.root).stdout)
        memo = self.remember(convoy=published["ids"]["_convoy"], ticket=published["ids"][WALKED_KEY],
                             integration=published["integration"]["branch"])
        return {"published": True, "convoy": memo["convoy"], "ticket": memo["ticket"]}

    def publish(self) -> dict:
        base = json.loads(self.memo.read_text())["base"]
        if json.loads(self.memo.read_text())["inject"] == "story-not-observed":
            return self.publish_through_the_door(base)
        interface = self.project["interface"]
        prototype = (
            f"## Validated Prototype\n\n- branche : main\n- commit : {base}\n- chemin : {self.fixture}/prototype\n"
            f"- états : empty, content\n- Prototype Fold : ce ticket\n\n") if interface else ""
        description = (
            f"## Acceptance criteria\n\n- [ ] {self.project['criterion']}\n\n{prototype}"
            f"## Target rigs\n\n{RIG}")
        beads = {
            CONVOY: {"title": "convoi de la fixture", "status": "open", "issue_type": "convoy",
                     "metadata": {"gc.spec_id": SPEC}, "tracks": [TICKET]},
            TICKET: {"title": "ticket de la fixture", "status": "open", "issue_type": "task",
                     "description": description, "metadata": {"gc.ticket_kind": "vertical_slice"}, "blocks": []},
            SPEC: {"title": "Spec de la fixture", "status": "open", "issue_type": "task",
                   "description": "## User Stories\n\n1. As Benjamin, I want la liste des éléments."},
        }
        if json.loads(self.memo.read_text())["inject"] == "three-failures":
            for ticket_id, title, blocks in ((SICK, "ticket dont l'auteur échoue", []), (BEHIND, "ticket qui l'attend", [SICK])):
                beads[ticket_id] = {
                    "title": title, "status": "open", "issue_type": "task",
                    "description": f"## Acceptance criteria\n\n- [ ] Le comportement est inchangé\n\n## Target rigs\n\n{RIG}",
                    "metadata": {"gc.ticket_kind": "prefactoring"}, "blocks": blocks}
            beads[CONVOY]["tracks"] = [TICKET, SICK, BEHIND]
        self.tracker.write_text(json.dumps({"beads": beads, "sessions": []}))
        self.state("mark", self.convoy, "--demonstration-line", f"{TICKET}={self.project['line']}",
                   "--user-stories", f"{TICKET}=1", *(("--prototype-fold", TICKET) if interface else ()))
        self.run(BIN / "spec-integration", "open", self.convoy, "--repo", self.root, "--protected", "main")
        return {"published": True}

    # --- the events ------------------------------------------------------------------

    def order_pass(self) -> str:
        """One pass of the Factory's order on the convoy. A convoy the pass
        stops (exit 3) is an outcome the oracle reads, not a driver failure."""
        proc = self.run(BIN / "convoy-advance", self.convoy, "--stopped-ok", check=False)
        if proc.returncode not in (0, 3):
            raise SystemExit(f"delivery-driver: convoy-advance failed ({proc.returncode}): {proc.stdout[-800:]}{proc.stderr[-300:]}")
        return "order-pass"

    def commit(self, branch: str, files: dict[str, str], message: str) -> str:
        """One commit of an author on the branch of its ticket, opened at
        the tip of the integration branch."""
        if self.branch_exists(branch):
            self.git("checkout", "-q", branch)
        else:
            self.git("checkout", "-q", "-b", branch, json.loads(self.memo.read_text()).get("integration", INTEGRATION))
        for path, content in files.items():
            target = self.root / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(content)
        self.git("add", "-A")
        self.git("commit", "-q", "-m", message)
        tip = self.git("rev-parse", "HEAD")
        self.git("checkout", "-q", "--detach", "main")
        return tip

    def branch_exists(self, branch: str) -> bool:
        return self.run("git", "-C", self.root, "rev-parse", "-q", "--verify", f"refs/heads/{branch}",
                        check=False).returncode == 0

    def author(self, shown: dict, memo: dict) -> str:
        """What the author session of the ticket at work leaves, one step
        of its TDD per event. The author of a repair writes what the repair
        restores: the product serves GET /items."""
        ticket, repair = shown["id"], shown["id"] != self.walked
        env, branch, tdd = self.env(), f"ticket/{shown['id']}", shown.get("tdd") or {}
        if not shown.get("branch"):
            # A repair starts from what the tickets before it merged.
            base = self.git("rev-parse", memo.get("integration", INTEGRATION)) if repair else memo["base"]
            self.remember(bases={**memo.get("bases", {}), ticket: base})
            self.state("set-branch", self.convoy, ticket, "--branch", branch)
            self.run(FAKE_GC, "bd", "update", ticket, "--status", "in_progress")
            name, content = ITEMS_TEST if repair else self.project["criterion_test"]
            red = self.commit(branch, {f"{self.fixture}/tests/{name}": content}, "tests de critère")
            ticket_proofs.prove_red(env, self.root, self.convoy, ticket, red, base)
            return "session:red"
        if not tdd.get("freeze"):
            ticket_proofs.prove_freeze(env, self.root, self.convoy, ticket)
            return "session:freeze"
        if repair:
            app = f"{self.fixture}/app.py"
            served = self.git("show", f"{branch}:{app}") + "\n"
            if ITEMS_BEFORE not in served:
                raise SystemExit(f"delivery-driver: {app} no longer routes GET / the way the repair extends it")
            files = {app: served.replace(ITEMS_BEFORE, ITEMS_ROUTE + ITEMS_BEFORE, 1)}
        else:
            files = {"docs/fixture-ticket.md": "la tranche du ticket\n"}
        tip = self.commit(branch, files, "travail du ticket")
        ticket_proofs.finish(env, self.root, self.convoy, ticket, tip, memo["bases"][ticket], branch)
        return "session:code"

    def failed_session(self, memo: dict) -> str | None:
        """`three-failures`: one more author session takes the sick ticket
        and ends without a Ticket Exit, once the order has sent it one."""
        failures = memo.get("failures", 0)
        sick = self.ticket(SICK)
        if failures >= FAILURES or "dispatch" not in (sick.get("gates") or {}) or sick.get("park"):
            return None
        entries = (sick.get("resume") or {}).get("entries") or []
        if failures and (len(entries) < failures or not entries[-1]["launches"]):
            return None  # the order has not sent the resume of the failure before yet
        self.state("set-session", self.convoy, SICK, "--session", f"auteur-{failures + 1}")
        if entries:
            self.run(FAKE_GC, "bd", "close", entries[-1]["launches"][-1]["bead"], "--reason", "session terminée sans sortie")
        self.remember(failures=failures + 1)
        return "session:ended-without-exit"

    def advance(self) -> dict:
        memo = json.loads(self.memo.read_text())
        before = self.tracker.read_bytes()
        shown = self.at_work()
        gates, finished = shown.get("gates") or {}, (shown.get("exit") or {}).get("exit") == "finished"
        failed = self.failed_session(memo) if memo["inject"] == "three-failures" else None
        if failed:
            event = failed
        elif memo["inject"] == "three-failures" and "dispatch" in gates and not self.ticket(SICK).get("park"):
            # The sick ticket fails before the walked one goes on: the order
            # counts the failure, then resumes or parks.
            event = self.order_pass()
        elif "dispatch" not in gates or shown.get("status") == "closed":
            event = self.order_pass()
        elif not finished:
            event = self.author(shown, memo)
        else:
            if memo["inject"] == "criterion-edited" and not memo.get("injected"):
                state = json.loads(self.tracker.read_text())
                criterion = self.project["criterion"]
                state["beads"][TICKET]["description"] = state["beads"][TICKET]["description"].replace(
                    criterion, criterion + " ou deux")
                self.tracker.write_text(json.dumps(state))
                self.remember(injected=True)
                before = self.tracker.read_bytes()
            if memo["inject"] == "closed-by-hand" and not memo.get("injected"):
                self.run(FAKE_GC, "bd", "close", TICKET, "--reason", "PR fusionnée, CI verte")
                self.remember(injected=True)
                event = "session:closed-by-hand"
            else:
                event = self.order_pass()
        return {"event": event, "idle": before == self.tracker.read_bytes()}

    def stop_products(self) -> None:
        launches = self.workspace / "launches"
        for record in launches.rglob("*.json") if launches.is_dir() else ():
            self.run(BIN / "project-launch", "stop", "--state-file", record, check=False)


def main() -> int:
    parser = argparse.ArgumentParser(prog="delivery-driver")
    parser.add_argument("--workspace", type=Path, required=True)
    sub = parser.add_subparsers(dest="command", required=True)
    prepare = sub.add_parser("prepare")
    prepare.add_argument("--inject", choices=INJECTIONS, default="none")
    prepare.add_argument("--project", default=DEFAULT_PROJECT)
    for name in ("publish", "advance", "stop"):
        sub.add_parser(name)
    args = parser.parse_args()
    city = City(args.workspace.resolve())
    if args.command == "prepare":
        if args.project not in PROJECTS:
            raise SystemExit(f"delivery-driver: unknown project of the fixture: {args.project} "
                             f"(known: {', '.join(PROJECTS)})")
        if args.inject == "story-not-observed" and args.project != DEFAULT_PROJECT:
            raise SystemExit(f"delivery-driver: --inject story-not-observed is played on {DEFAULT_PROJECT} only: "
                             f"the story it leaves unserved is one {args.project} already serves")
        answer = city.prepare(args.inject, args.project)
    elif args.command == "publish":
        answer = city.publish()
    elif args.command == "advance":
        answer = city.advance()
    else:
        city.stop_products()
        answer = {"stopped": True}
    print(json.dumps(answer, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
