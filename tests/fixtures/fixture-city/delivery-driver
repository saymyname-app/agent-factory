class City:
    def __init__(self, workspace: Path):
        self.workspace = workspace
        self.root = workspace / "city"
        self.tracker = workspace / "tracker.json"
        self.memo = workspace / "driver.json"
        memo = json.loads(self.memo.read_text()) if self.memo.exists() else {}
        self.use(memo.get("project", DEFAULT_PROJECT))
        # The convoy and the walked ticket: named by the driver, or by the
        # publication door when it publishes them.
        self.convoy, self.walked = memo.get("convoy", CONVOY), memo.get("ticket", TICKET)

    def use(self, project: str) -> None:
        self.project = PROJECTS[project]
        self.fixture = FIXTURES / project

    def path(self) -> str:
        """The PATH of the order: the one the driver was given, and the
        directory of the interpreter of the project when it is not on it
        (the oracle gives its adapters a bare PATH; a per-user install of
        Node.js sits in ~/.local/bin)."""
        given = os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin")
        interpreter = self.project["interpreter"]
        if not interpreter or shutil.which(interpreter, path=given):
            return given
        local = Path(pwd.getpwuid(os.getuid()).pw_dir) / ".local" / "bin"
        if not shutil.which(interpreter, path=str(local)):
            raise SystemExit(f"delivery-driver: {interpreter} is not installed: the project "
                             f"{self.fixture.name} is launched and tested with it")
        return f"{given}:{local}"

    # --- environment -----------------------------------------------------------

    def state_environment(self) -> dict[str, str]:
        """What a reader of the public state needs: the tracker, the
        evidence store, the locks. Nothing of the driver."""
