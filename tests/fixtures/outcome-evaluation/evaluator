#!/usr/bin/env python3
"""Stand-in for the dispatch door and the Evaluator session of the end it
starts, for tests/outcome-evaluation-test.py and the suites of the pass: no
agent runs in CI, only what goes in and out of the command (Spec af-wf4w5r,
Testing Decisions).

Called as bin/dispatch-door is (`<bead> --rig R --formula F --role ROLE`), it
logs its arguments to OUTCOME_EVALUATION_FAKE_LOG, then does what an
Evaluator session of the end does with the routed bead: read the convoy it
names, ask `outcome-evaluation brief` (kept, call by call, in
OUTCOME_EVALUATION_FAKE_BRIEFS), classify the findings « hors ticket », use
the launched product -- each state rests on an entry point of it captured by
the real bin/evidence-capture -- and hand its states to `outcome-evaluation
record` from a read-only role session of its own
(`delivery-evaluator-fixture-<call number>`). It is given no repository.

What each call does is read from the JSON list in OUTCOME_EVALUATION_FAKE_PLAN,
one entry per call, the last one repeated:

    {"stories": {"<n>": {"path": "/x", "dataset": "<name>", "look_for": "<text>"}},
                                    story <n> is « observed » when that entry point of the product launched on
                                    that dataset (default: the home page, on the first dataset) answers and shows
                                    that text (default: any answer), « not_observed » otherwise; a « not_observed »
                                    story gets a drafted repair that cites it, unless "repairs" is false
     "classify": {"<finding>": {"as": "...", "reason": "...", "repair": {...}}},
                                    how each finding is classified (default: « proposal »)
     "exploration": [...], "fidelity_deviations": [...]}   the two non-blocking sections (default: « aucun »)
    "silent"                        the session starts and never answers
    "closed"                        the session closes its bead without states
    "door-refuses"                  the door refuses the dispatch
    "door-defers"                   the door defers the dispatch (exit 75)
"""
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
TOOL = str(ROOT / "bin" / "outcome-evaluation")
CAPTURE = str(ROOT / "bin" / "evidence-capture")
GC = os.environ["GC_BIN"]
FETCH = "import sys, urllib.request; sys.stdout.write(urllib.request.urlopen(sys.argv[1], timeout=10).read().decode())"

log = Path(os.environ["OUTCOME_EVALUATION_FAKE_LOG"])
calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(sys.argv[1:]) + "\n")
plan = json.loads(Path(os.environ["OUTCOME_EVALUATION_FAKE_PLAN"]).read_text(encoding="utf-8"))
step = plan[min(len(calls), len(plan) - 1)]

if step == "door-refuses":
    print("dispatch-door: dispatch refused: no passing adoption trial for role 'evaluator'", file=sys.stderr)
    raise SystemExit(2)
if step == "door-defers":
    print("dispatch-door: deferred -- guest MemAvailable is 1.0 GiB, below the 1.5 GiB floor", file=sys.stderr)
    raise SystemExit(75)
if step == "silent":
    raise SystemExit(0)
bead_id = sys.argv[1]
if step == "closed":
    subprocess.run([GC, "bd", "close", bead_id, "--reason", "aucun état"], capture_output=True, check=True)
    raise SystemExit(0)

bead = json.loads(subprocess.run([GC, "bd", "show", bead_id, "--json"], capture_output=True, text=True, check=True).stdout)[0]
convoy = re.search(r"^convoy: (\S+)$", bead["description"], re.MULTILINE).group(1)
number = len(calls) + 1
session = {**os.environ, "DELIVERY_ROLE_READ_ONLY": "1", "GC_SESSION_NAME": f"delivery-evaluator-fixture-{number}"}
asked = subprocess.run([TOOL, "brief", convoy], env=session, capture_output=True, text=True, check=True)
briefs = os.environ.get("OUTCOME_EVALUATION_FAKE_BRIEFS")
if briefs:
    Path(briefs).mkdir(parents=True, exist_ok=True)
    (Path(briefs) / f"brief-{number}.json").write_text(asked.stdout, encoding="utf-8")
brief = json.loads(asked.stdout)
given = step if isinstance(step, dict) else {}


def json_file(content):
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as handle:
        json.dump(content, handle, ensure_ascii=False)
    return handle.name


def repair_of(what, restores):
    return {
        "title": f"Rétablir {what}",
        "what_it_delivers": f"Le produit assemblé sert {what}, que la Spec demande et qu'il ne sert pas.",
        "restores": restores,
        "demonstration_line": f"Sur le produit lancé, {what} est servi comme la Spec le demande.",
        "acceptance_criteria": [{"entry_point": "GET / sur le produit lancé", "observable": f"{what} y est servi",
                                 "false_if": f"{what} n'y est pas servi"}],
    }


for finding in brief["findings"]:
    if finding["state"] != "non classé":
        continue
    how = given.get("classify", {}).get(finding["finding"], {"as": "proposal"})
    command = [TOOL, "classify", convoy, finding["finding"], "--as", how["as"]]
    if "reason" in how:
        command += ["--reason", how["reason"]]
    if "repair" in how:
        command += ["--file", json_file(how["repair"])]
    proc = subprocess.run(command, env=session, capture_output=True, text=True)
    sys.stderr.write(proc.stdout + proc.stderr)


def state_of(story):
    """Capture the entry point the plan names for the story on the launched
    product; answer its state and the piece it rests on."""
    look = given.get("stories", {}).get(str(story["number"]), {})
    product = next((entry for entry in brief["environments"] if entry["dataset"] == look.get("dataset")),
                   brief["environments"][0])
    piece = f"outcome.s{story['number']}"
    captured = subprocess.run(
        [CAPTURE, "command", convoy, convoy, "--piece", piece, "--launch-state", product["launch_state"], "--",
         sys.executable, "-c", FETCH, product["address"] + look.get("path", "/")],
        env=session, capture_output=True, text=True, check=True)
    record = json.loads(Path(json.loads(captured.stdout)["path"]).read_text(encoding="utf-8"))
    state = {"number": story["number"], "text": story["text"], "evidence": piece}
    if record["exit_code"] == 0 and look.get("look_for", "") in record["output"]:
        return {**state, "state": "observed"}
    return {**state, "state": "not_observed",
            "reason": f"le produit lancé ne sert pas ce que la story décrit ({look.get('path', '/')})"}


stories = [state_of(story) for story in brief["stories"]]
handed = {
    "commit": brief["commit"], "stories": stories,
    "exploration": given.get("exploration", "aucun"),
    "fidelity_deviations": given.get("fidelity_deviations", "aucun"),
}
if given.get("repairs", True):
    handed["repairs"] = [
        {"story": story["number"],
         **repair_of(f"la user story {story['number']}", {"kind": "user_story", "ref": f"user story {story['number']}"})}
        for story in stories if story["state"] == "not_observed"]
path = json_file(handed)
proc = subprocess.run([TOOL, "record", convoy, "--file", path], env=session, capture_output=True, text=True)
os.unlink(path)
sys.stderr.write(proc.stdout + proc.stderr)
subprocess.run([GC, "bd", "close", bead_id, "--reason", "évaluation enregistrée"], capture_output=True)
raise SystemExit(0)
