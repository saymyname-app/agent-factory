#!/usr/bin/env python3
"""Stateful fake `bd` for ticket-graph-publish bead-mode tests (A6b, W05).

Backs a tiny bead store in the JSON file named by TICKET_GRAPH_BD_STATE, so a
test can seed a Ticket Graph Draft bead and a Spec bead, run `bd-publish` /
`bd-patch`, and assert what changed next. It also implements the delivery
graph transaction (`list --all --limit 0 --json`, `create --graph ...`) the
door needs to publish/patch the actual delivery beads, in the same store, so
a single fixture covers both the planning-plane reads and the delivery-plane
writes a bead-mode publish makes in one call.

As bd 1.4.1 does (af-npz9v1), the graph transaction keeps each `blocks`
edge (the ticket waits for its blocker), and `update --status closed` on an
issue that waits for one not closed fails, unless `--force` is given.
"""
import json
import os
import sys
from pathlib import Path

STATE_PATH = Path(os.environ["TICKET_GRAPH_BD_STATE"])

BOOLEAN_FLAGS = {"--all", "--json", "--silent", "--force"}
VALUE_FLAGS = {"--limit", "--title", "--description", "--type", "--priority", "--labels", "--metadata", "--deps", "--graph",
               "--status"}
# `create --deps <type>:<id>`, as the real bd 1.2.2 stores it (compared with
# the real tool by tests/fake-tool-contract-test.py): `blocks:<id>` makes
# <id> wait for the new issue; the others make the new issue wait for <id>.
DEPS_NEW_WAITS = {"", "depends-on", "blocked-by"}
REPEATABLE_VALUE_FLAGS = {"--set-metadata", "--append-notes"}


def load_state():
    if STATE_PATH.exists():
        return json.loads(STATE_PATH.read_text(encoding="utf-8"))
    return {"beads": {}, "next_id": 1}


def save_state(state):
    STATE_PATH.write_text(json.dumps(state, indent=2, sort_keys=True), encoding="utf-8")


def parse_flags(args):
    flags = {}
    repeated = {}
    positionals = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in BOOLEAN_FLAGS:
            flags[arg] = True
            i += 1
        elif arg in REPEATABLE_VALUE_FLAGS:
            repeated.setdefault(arg, []).append(args[i + 1])
            i += 2
        elif arg in VALUE_FLAGS:
            flags[arg] = args[i + 1]
            i += 2
        else:
            positionals.append(arg)
            i += 1
    return flags, repeated, positionals


def public_view(bead):
    return {
        "id": bead["id"],
        "title": bead.get("title", ""),
        "description": bead.get("description", ""),
        "status": bead.get("status", "open"),
        "labels": bead.get("labels", []),
        "metadata": bead.get("metadata", {}),
        **({"dependencies": bead["dependencies"]} if bead.get("dependencies") else {}),
    }


def dependencies_of(state, bead):
    """What `bd show --json` lists under `dependencies`: the issues this one
    waits for (`blocks`) and the ones it tracks."""
    return [
        {"id": dep_id, "status": state["beads"].get(dep_id, {}).get("status", "open"), "dependency_type": dep_type}
        for dep_type, key in (("blocks", "waits_for"), ("tracks", "tracks"))
        for dep_id in bead.get(key, [])
    ]


def add_dependency(state, issue_id, depends_on_id, dep_type):
    """`issue_id` depends on `depends_on_id`: the sense of `bd dep add`."""
    for known in (issue_id, depends_on_id):
        if known not in state["beads"]:
            fail(f"issue not found: {known}")
    held = state["beads"][issue_id].setdefault("waits_for" if dep_type == "blocks" else "tracks", [])
    if depends_on_id not in held:
        held.append(depends_on_id)


def fail(message):
    sys.stderr.write(f"fake bd: {message}\n")
    raise SystemExit(1)


def cmd_show(positionals):
    state = load_state()
    if not positionals:
        fail("show requires an issue id")
    bead = state["beads"].get(positionals[0])
    if bead is None:
        fail(f"issue not found: {positionals[0]}")
    print(json.dumps([public_view({"id": positionals[0], **bead, "dependencies": dependencies_of(state, bead)})]))


def cmd_list(flags):
    # A bead written by the other fake tracker of the suites
    # (tests/fixtures/convoy-state/gc, on the same file) is known by its key.
    state = load_state()
    print(json.dumps([public_view({"id": bead_id, **b}) for bead_id, b in state["beads"].items()]))


def cmd_update(flags, repeated, positionals):
    state = load_state()
    if not positionals:
        fail("update requires an issue id")
    issue_id = positionals[0]
    bead = state["beads"].setdefault(issue_id, {"id": issue_id, "metadata": {}, "labels": [], "status": "open"})
    if "--title" in flags:
        bead["title"] = flags["--title"]
    if "--description" in flags:
        bead["description"] = flags["--description"]
    if flags.get("--status") == "closed" and "--force" not in flags:
        blockers = [dep for dep in bead.get("waits_for", [])
                    if state["beads"].get(dep, {}).get("status", "open") != "closed"]
        if blockers:
            fail(f"cannot close blocked issue {issue_id}: blocked by {', '.join(blockers)} (use --force)")
    if "--status" in flags:
        bead["status"] = flags["--status"]
    for entry in repeated.get("--set-metadata", []):
        key, _, value = entry.partition("=")
        bead.setdefault("metadata", {})[key] = value
    save_state(state)
    print(json.dumps(public_view(bead)))


def cmd_create(flags, positionals):
    state = load_state()
    if "--graph" in flags:
        plan = json.loads(Path(flags["--graph"]).read_text(encoding="utf-8"))
        ids = {}
        for node in plan["nodes"]:
            n = state["next_id"]
            state["next_id"] = n + 1
            new_id = f"af-{n:03d}"
            ids[node["key"]] = new_id
            state["beads"][new_id] = {
                "id": new_id, "title": node["title"], "description": node["description"],
                "status": "open", "labels": node["labels"], "metadata": node["metadata"],
                "issue_type": node.get("type", "task"),
            }
        # The real graph transaction stores each `tracks` edge on the convoy:
        # `bd show <convoy> --json` then lists the tracked tickets, which is
        # what bin/convoy-state reads (see the fake `gc` beside this file).
        for edge in plan.get("edges", []):
            if edge.get("type") == "tracks":
                state["beads"][ids[edge["from_key"]]].setdefault("tracks", []).append(ids[edge["to_key"]])
            elif edge.get("type") == "blocks":
                add_dependency(state, ids[edge["from_key"]], ids[edge["to_key"]], "blocks")
        save_state(state)
        print(json.dumps({"schema_version": 1, "ids": ids}))
        return
    n = state["next_id"]
    state["next_id"] = n + 1
    new_id = f"af-{n:03d}"
    metadata = json.loads(flags["--metadata"]) if "--metadata" in flags else {}
    labels = [l for l in flags.get("--labels", "").split(",") if l]
    state["beads"][new_id] = {
        "id": new_id, "title": flags.get("--title", ""), "description": flags.get("--description", ""),
        "status": "open", "labels": labels, "metadata": metadata,
    }
    for entry in [e for e in flags.get("--deps", "").split(",") if e]:
        dep_type, _, other_id = entry.rpartition(":")
        if dep_type == "blocks":
            add_dependency(state, other_id, new_id, "blocks")
        elif dep_type in DEPS_NEW_WAITS:
            add_dependency(state, new_id, other_id, "blocks")
        elif dep_type == "tracks":
            add_dependency(state, new_id, other_id, "tracks")
        else:
            fail(f"no canned behaviour for the dependency {entry!r} of bd create --deps")
    save_state(state)
    print(new_id)


def main(argv):
    if len(argv) >= 2 and argv[0] == "-C":
        argv = argv[2:]
    if not argv:
        fail("no command given")
    command, rest = argv[0], argv[1:]
    flags, repeated, positionals = parse_flags(rest)
    if command == "show":
        cmd_show(positionals)
    elif command == "list":
        cmd_list(flags)
    elif command == "update":
        cmd_update(flags, repeated, positionals)
    elif command == "create":
        cmd_create(flags, positionals)
    elif command == "dep":
        # `dep add <issue> <depends-on> [--type tracks]`: the issue waits
        # for the other one, or (tracks) the convoy tracks the ticket, as
        # the `tracks` edges of the graph transaction do.
        state = load_state()
        if positionals[:1] == ["add"] and len(positionals) == 3:
            add_dependency(state, positionals[1], positionals[2], flags.get("--type", "blocks"))
        elif positionals[:1] == ["remove"] and len(positionals) == 3:
            waits_for = state["beads"].get(positionals[1], {}).get("waits_for", [])
            if positionals[2] in waits_for:
                waits_for.remove(positionals[2])
        else:
            fail(f"no canned response configured for: bd {' '.join(argv)}")
        save_state(state)
    else:
        fail(f"no canned response configured for: bd {' '.join(argv)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
