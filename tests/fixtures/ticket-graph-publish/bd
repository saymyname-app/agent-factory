#!/usr/bin/env python3
import json
import os
import shutil
import sys
from pathlib import Path

args = sys.argv[1:]
if len(args) >= 2 and args[0] == "-C":
    args = args[2:]

log = Path(os.environ["TICKET_GRAPH_BD_LOG"])
with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(args) + "\n")

if args and args[0] == "list":
    print(os.environ.get("TICKET_GRAPH_EXISTING", "[]"))
    raise SystemExit(0)

if args[:2] == ["create", "--graph"]:
    source = Path(args[2])
    capture = Path(os.environ["TICKET_GRAPH_CAPTURE"])
    shutil.copyfile(source, capture)
    plan = json.loads(source.read_text(encoding="utf-8"))
    print(json.dumps({
        "schema_version": 1,
        "ids": {node["key"]: f"af-{index:03d}" for index, node in enumerate(plan["nodes"])},
    }))
    raise SystemExit(0)

if args and args[0] == "create":
    counter_path = Path(os.environ["TICKET_GRAPH_BD_LOG"]).with_suffix(".counter")
    n = int(counter_path.read_text()) + 1 if counter_path.exists() else 1
    counter_path.write_text(str(n))
    print(f"af-new{n:03d}")
    raise SystemExit(0)

if args and args[0] == "update":
    raise SystemExit(0)

if args[:2] in (["dep", "add"], ["dep", "remove"]):
    raise SystemExit(0)

print(f"unexpected fake bd arguments: {args}", file=sys.stderr)
raise SystemExit(2)
