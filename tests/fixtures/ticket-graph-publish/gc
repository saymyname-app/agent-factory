#!/usr/bin/env python3
"""Fake `gc` used by ticket-graph-publish-test.py to observe Mayor wake
calls without a live Gas City. Every invocation is appended, one JSON array
per line, to TICKET_GRAPH_GC_LOG."""
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
log = Path(os.environ["TICKET_GRAPH_GC_LOG"])
with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(args) + "\n")

if args[:3] == ["mail", "send", "mayor"]:
    raise SystemExit(0)

print(f"unexpected fake gc arguments: {args}", file=sys.stderr)
raise SystemExit(2)
