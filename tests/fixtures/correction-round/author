#!/usr/bin/env python3
"""Stand-in for the dispatch door and the author session it starts, for
tests/correction-round-test.py: no agent runs in CI, only what goes in and
out of the command (Spec af-wf4w5r, Testing Decisions).

Called as bin/dispatch-door is (`<bead> --rig R --formula F --role ROLE`), it
logs its arguments to CORRECTION_ROUND_FAKE_LOG, then does what a fresh
author session does first with the routed bead: read the convoy and the
ticket it names and ask `correction-round brief` (kept, call by call, in
CORRECTION_ROUND_FAKE_BRIEFS). The corrections themselves -- commits, answers
to the Blocking Findings, the Ticket Exit -- are made by the test.

What each call does is read from the JSON list in CORRECTION_ROUND_FAKE_PLAN,
one entry per call, the last one repeated:

    "works"          the session starts, reads its brief and is still at work
    "leaves"         the session reads its brief and ends without correcting anything
    "door-refuses"   the door refuses the dispatch
    "door-defers"    the door defers the dispatch (exit 75)
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
TOOL = str(ROOT / "bin" / "correction-round")
GC = os.environ["GC_BIN"]

log = Path(os.environ["CORRECTION_ROUND_FAKE_LOG"])
calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(sys.argv[1:]) + "\n")
plan = json.loads(Path(os.environ["CORRECTION_ROUND_FAKE_PLAN"]).read_text(encoding="utf-8"))
step = plan[min(len(calls), len(plan) - 1)]

if step == "door-refuses":
    print("dispatch-door: dispatch refused: no passing adoption trial for role 'author'", file=sys.stderr)
    raise SystemExit(2)
if step == "door-defers":
    print("dispatch-door: deferred -- guest MemAvailable is 1.0 GiB, below the 1.5 GiB floor", file=sys.stderr)
    raise SystemExit(75)

bead_id = sys.argv[1]
bead = json.loads(subprocess.run([GC, "bd", "show", bead_id, "--json"], capture_output=True, text=True, check=True).stdout)[0]
convoy = re.search(r"^convoy: (\S+)$", bead["description"], re.MULTILINE).group(1)
ticket = re.search(r"^ticket: (\S+)$", bead["description"], re.MULTILINE).group(1)
number = len(calls) + 1
session = {**os.environ, "GC_SESSION_NAME": f"delivery-author-fixture-{number}"}
asked = subprocess.run([TOOL, "brief", convoy, ticket, "--repo", os.environ["CORRECTION_ROUND_FAKE_REPO"]],
                       env=session, capture_output=True, text=True)
Path(os.environ["CORRECTION_ROUND_FAKE_BRIEFS"]).mkdir(parents=True, exist_ok=True)
(Path(os.environ["CORRECTION_ROUND_FAKE_BRIEFS"]) / f"brief-{number}.json").write_text(asked.stdout, encoding="utf-8")
if step == "leaves":
    subprocess.run([GC, "bd", "close", bead_id, "--reason", "session terminée"], capture_output=True, check=True)
raise SystemExit(0)
