#!/usr/bin/env python3
"""Stand-in for the dispatch door and the Evaluator session it starts, for
tests/ticket-evaluation-test.py: no agent runs in CI, only what goes in and
out of the command (Spec af-wf4w5r, Testing Decisions).

Called as bin/dispatch-door is (`<bead> --rig R --formula F --role ROLE`), it
logs its arguments to TICKET_EVALUATION_FAKE_LOG, then does what an Evaluator
session does with the routed bead: read the convoy and the ticket it names,
ask `ticket-evaluation brief` (kept, call by call, in
TICKET_EVALUATION_FAKE_BRIEFS), use the launched product -- each state rests
on a page of it captured by the real bin/evidence-capture -- and hand its
states to `ticket-evaluation record` from a read-only role session of its own
(`delivery-evaluator-fixture-<call number>`). It is given no repository.

What each call does is read from the JSON list in TICKET_EVALUATION_FAKE_PLAN,
one entry per call, the last one repeated:

    {"look_for": "<text>",          a criterion, or the demonstration line, is « observed » when the page of the
     "dataset": "<name>",           product launched on that dataset (default: the first one) shows that text,
     "path": "<path>",              « not_observed » otherwise; `path` is the entry point captured instead of the
     "states": {"<n>|demo": {...}}} home page (a product with no web page); `states` gives the state of an item instead
    "silent"                        the session starts and never answers
    "closed"                        the session closes its bead without states
    "door-refuses"                  the door refuses the dispatch
    "door-defers"                   the door defers the dispatch (exit 75)
"""
import atexit
import json
import time
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
TOOL = str(ROOT / "bin" / "ticket-evaluation")
CAPTURE = str(ROOT / "bin" / "evidence-capture")
GC = os.environ["GC_BIN"]
FETCH = "import sys, urllib.request; sys.stdout.write(urllib.request.urlopen(sys.argv[1], timeout=10).read().decode())"

log = Path(os.environ["TICKET_EVALUATION_FAKE_LOG"])
calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(sys.argv[1:]) + "\n")
plan = json.loads(Path(os.environ["TICKET_EVALUATION_FAKE_PLAN"]).read_text(encoding="utf-8"))
step = plan[min(len(calls), len(plan) - 1)]

if step == "door-refuses":
    print("dispatch-door: dispatch refused: no passing adoption trial for role 'evaluator'", file=sys.stderr)
    raise SystemExit(2)
if step == "door-defers":
    print("dispatch-door: deferred -- guest MemAvailable is 1.0 GiB, below the 1.5 GiB floor", file=sys.stderr)
    raise SystemExit(75)
if step == "silent":
    raise SystemExit(0)
bead_id = sys.argv[1]
if step == "closed":
    subprocess.run([GC, "bd", "close", bead_id, "--reason", "aucun état"], capture_output=True, check=True)
    raise SystemExit(0)

bead = json.loads(subprocess.run([GC, "bd", "show", bead_id, "--json"], capture_output=True, text=True, check=True).stdout)[0]
convoy = re.search(r"^convoy: (\S+)$", bead["description"], re.MULTILINE).group(1)
ticket = re.search(r"^ticket: (\S+)$", bead["description"], re.MULTILINE).group(1)
number = len(calls) + 1
session = {**os.environ, "DELIVERY_ROLE_READ_ONLY": "1", "GC_SESSION_NAME": f"delivery-evaluator-fixture-{number}"}
asked = subprocess.run([TOOL, "brief", convoy, ticket], env=session, capture_output=True, text=True, check=True)
briefs = os.environ.get("TICKET_EVALUATION_FAKE_BRIEFS")
if briefs:
    Path(briefs).mkdir(parents=True, exist_ok=True)
    (Path(briefs) / f"brief-{number}.json").write_text(asked.stdout, encoding="utf-8")
brief = json.loads(asked.stdout)
given = step if isinstance(step, dict) else {}


def product_for(dataset):
    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        proc = subprocess.run([TOOL, "product", convoy, ticket, "--dataset", dataset], env=session, capture_output=True, text=True)
        if proc.returncode:
            raise RuntimeError(proc.stdout + proc.stderr)
        answer = json.loads(proc.stdout)
        if answer["ready"]:
            return {"dataset": dataset, "address": answer["address"],
                    "launch_state": answer["launch_state"]}
        time.sleep(0.15)
    raise RuntimeError(f"controller never opened {dataset}")


if len(brief.get("datasets") or []) > 1:
    # The fake Evaluator lives beyond the dispatch call, as a real routed
    # session does. Its product requests are served by later controller passes.
    pending = Path(str(log) + ".pending")
    done = Path(str(log) + ".done")
    failed = Path(str(log) + ".failed")
    done.unlink(missing_ok=True)
    failed.unlink(missing_ok=True)
    pending.write_text(bead_id)
    child = os.fork()
    if child:
        raise SystemExit(0)
    os.setsid()
    output = os.open(str(log) + ".worker", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    os.dup2(output, 1)
    os.dup2(output, 2)
    os.close(output)
    outcome = {"ok": False}
    def finish():
        (done if outcome["ok"] else failed).write_text(bead_id)
        pending.unlink(missing_ok=True)
    atexit.register(finish)
product = next((entry for entry in brief["environments"] if entry["dataset"] == given.get("dataset")),
               brief["environments"][0])


def observe(name, product):
    """Capture the home page of the launched product, or the entry point the plan names; answer the piece
    and what it shows."""
    piece = f"evaluation.{name}"
    captured = subprocess.run(
        [CAPTURE, "command", convoy, ticket, "--piece", piece, "--launch-state", product["launch_state"], "--",
         sys.executable, "-c", FETCH, product["address"] + given.get("path", "/")], env=session, capture_output=True, text=True, check=True)
    return piece, json.loads(Path(json.loads(captured.stdout)["path"]).read_text(encoding="utf-8"))["output"]


def state_of(name, text, product):
    piece, page = observe(name, product)
    forced = given.get("states", {}).get(name.removeprefix("c"))
    if forced:
        return {"text": text, "evidence": piece, **forced}
    if given.get("look_for", "<html>") in page:
        return {"text": text, "state": "observed", "evidence": piece}
    return {"text": text, "state": "not_observed", "evidence": piece,
            "reason": f"la page du produit lancé ne montre pas « {given['look_for']} »"}


comparisons = []


def compare(product):
    for item in brief.get("expectations", []):
        if item.get("gap") or item.get("dataset") != product["dataset"]:
            continue
        piece = f"evaluation.expected.{item['id']}"
        path = item["observation"]["path"]
        captured = subprocess.run(
            [CAPTURE, "command", convoy, ticket, "--piece", piece, "--launch-state", product["launch_state"], "--",
             sys.executable, "-c", brief["capture"]["page"][-2], product["address"] + path],
            env=session, capture_output=True, text=True, check=True)
        comparisons.append({"id": item["id"], "evidence": piece})


if len(brief.get("datasets") or []) > 1:
    first = brief["environments"][0]["dataset"]
    selected = given.get("dataset", first)
    criteria = {}
    line = None
    coverage = []
    for dataset in brief["datasets"]:
        product = product_for(dataset)
        compare(product)
        if dataset == selected:
            criteria = {item["number"]: {"number": item["number"],
                        **state_of(f"c{item['number']}", item["text"], product)}
                        for item in brief["criteria"]}
            line = state_of("demo", brief["demonstration_line"], product)
        piece, _ = observe(f"coverage.{dataset}", product)
        coverage.append({"dataset": dataset, "evidence": piece})
    handed = {"commit": brief["commit"], "criteria": [criteria[item["number"]] for item in brief["criteria"]],
              "demonstration_line": line, "coverage": coverage}
else:
    compare(product)
    handed = {
        "commit": brief["commit"],
        "criteria": [{"number": item["number"], **state_of(f"c{item['number']}", item["text"], product)}
                     for item in brief["criteria"]],
        "demonstration_line": state_of("demo", brief["demonstration_line"], product),
        "coverage": [{"dataset": product["dataset"], "evidence": "evaluation.demo"}],
    }
handed["comparisons"] = comparisons
with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as handle:
    json.dump(handed, handle, ensure_ascii=False)
proc = subprocess.run([TOOL, "record", convoy, ticket, "--file", handle.name], env=session, capture_output=True, text=True)
os.unlink(handle.name)
sys.stderr.write(proc.stdout + proc.stderr)
if proc.returncode:
    raise SystemExit(proc.returncode)
closed = subprocess.run([GC, "bd", "close", bead_id, "--reason", "évaluation enregistrée"],
                        capture_output=True, text=True)
if closed.returncode:
    raise RuntimeError(closed.stdout + closed.stderr)
if "outcome" in globals():
    outcome["ok"] = True
raise SystemExit(0)
