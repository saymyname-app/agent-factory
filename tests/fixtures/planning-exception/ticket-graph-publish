#!/usr/bin/env python3
"""Fake `ticket-graph-publish` for planning-exception-test.py: logs its
invocation and returns a canned patch result (or fails) via env vars, so
`resolve --kind behavioral/topology` can be tested without a real Beads
workspace or a fully valid signed draft.
"""
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]

log = os.environ.get("PLANNING_EXCEPTION_PUBLISH_LOG")
if log:
    with Path(log).open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(args) + "\n")

if os.environ.get("PLANNING_EXCEPTION_PUBLISH_FAIL"):
    print("fake ticket-graph-publish: forced failure", file=sys.stderr)
    raise SystemExit(1)

if len(args) >= 2 and args[0] == "bd-patch":
    register = Path(args[args.index("--planning-exception-register") + 1])
    decision = json.loads(register.read_text())["decisions"]["pd-1"]
    assert decision["status"] == "open" and decision["parked"]
    assert decision["patch_authorization"] == {"draft": args[1], "bead": decision["bead"]}
    print(json.dumps({
        "ok": True,
        "graph_digest": "sha256:" + "9" * 64,
        "revises": "sha256:" + "1" * 64,
        "ids": {"_convoy": "af-conv", "B08": "af-b08"},
        "patched": ["B08"],
        "created": [],
    }))
    raise SystemExit(0)

print(f"unexpected fake ticket-graph-publish arguments: {args}", file=sys.stderr)
raise SystemExit(2)
