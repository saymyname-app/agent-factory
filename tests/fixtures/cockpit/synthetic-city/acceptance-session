#!/usr/bin/env python3
"""bin/acceptance-session as an isolated cockpit runs it (bin/cockpit-isolated;
A2, af-ocz64w):

    acceptance-session open <convoy> --trial

The real command holds an Evidence Pack at the tip of an integration branch,
which a synthetic convoy does not have. This one keeps what Essai relies on
and does the launch for real: the commit of the Delivered Outcome the tracker
of the launch records, the first dataset of the profile, bin/project-launch
from a clean copy of that commit. The product belongs to the cockpit that
asked for it, and ends with it. It answers as the real command does: one JSON
object, `address` once the product answers, an `error` with `outage: true`
when it does not start.
"""
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[4]
PROFILE = ROOT / "config" / "project-descriptors" / "agent-factory.json"
LAUNCHER = ROOT / "bin" / "project-launch"
START_SECONDS = "60"


def answer(body, code=0):
    print(json.dumps(body, ensure_ascii=False))
    return code


def delivered_commit(convoy):
    shown = subprocess.run([os.environ["COCKPIT_BD_BIN"], "show", convoy, "--json"],
                           capture_output=True, text=True, check=True)
    bead = json.loads(shown.stdout)
    bead = bead[0] if isinstance(bead, list) else bead
    return json.loads(bead["metadata"]["gc.flow.delivered"])["commit"]


def main(argv):
    if len(argv) != 3 or argv[0] != "open" or argv[2] != "--trial":
        return answer({"ok": False, "error": "refus : acceptance-session open <convoy> --trial"}, 2)
    convoy = argv[1]
    commit = delivered_commit(convoy)
    state = Path(os.environ["HOME"]) / "trials" / f"{convoy}-{commit}.json"
    state.parent.mkdir(exist_ok=True)
    if state.is_file():
        record = json.loads(state.read_text(encoding="utf-8"))
        if record.get("started"):
            return answer({"ok": True, "commit": commit, "address": record["address"]})
    dataset = next(iter(json.loads(PROFILE.read_text(encoding="utf-8"))["launch"]["datasets"]))
    started = subprocess.run(
        [sys.executable, str(LAUNCHER), "--repo-root", str(ROOT), "start", "--owner-pid", str(os.getppid()), str(PROFILE),
         "--commit", commit, "--dataset", dataset, "--timeout", START_SECONDS, "--state-file", str(state)],
        capture_output=True, text=True)
    if started.returncode != 0:
        state.unlink(missing_ok=True)
        return answer({"ok": False, "outage": True,
                       "error": "refus : le produit ne démarre pas au commit %s du dossier ; panne, aucun jugement "
                                "n’est ouvert" % commit[:12]}, 1)
    return answer({"ok": True, "commit": commit, "address": json.loads(started.stdout)["address"]})


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
