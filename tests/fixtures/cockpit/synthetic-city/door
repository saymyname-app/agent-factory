#!/usr/bin/env python3
"""A door of the Factory as an isolated cockpit runs it (bin/cockpit-isolated;
B, af-4uzgzm):

    door <how> <the real door> [its arguments]

- `acts`: the real door, as it is, on the tracker of the launch;
- `expires`: it never answers, and writes nothing -- a command that expires;
- `records-then-expires`: the real door writes its record, then this never
  answers -- the gesture was done, its command cannot say so. A door that
  refuses still answers its refusal: it recorded nothing.

The cockpit gives up on a door after its own delay and kills it.
"""
import os
import subprocess
import sys
import time

FOREVER = 24 * 3600


def main(argv):
    how, door, arguments = argv[0], argv[1], argv[2:]
    if how == "acts":
        os.execv(door, [door, *arguments])
    if how == "expires":
        time.sleep(FOREVER)
        return 1
    if how == "records-then-expires":
        done = subprocess.run([door, *arguments], capture_output=True, text=True)
        if done.returncode != 0:
            sys.stdout.write(done.stdout)
            sys.stderr.write(done.stderr)
            return done.returncode
        time.sleep(FOREVER)
        return 1
    sys.stderr.write("synthetic door: no such way to answer: %s\n" % how)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
