#!/usr/bin/env python3
"""A `bd` that never answers (T02, af-0gonc9): the tracker of the isolated
cockpit while the page is being read (`ui.state` loading). Every call waits,
and ends without an answer when the process that made it ends."""
import os
import sys
import time

caller = os.getppid()
while os.getppid() == caller:
    time.sleep(0.5)
sys.exit(1)
