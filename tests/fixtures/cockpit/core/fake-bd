#!/usr/bin/env python3
"""A fake `bd`, scoped to the cockpit-core seam test (af-0b6ffa).

Refuses every call it wasn't told to answer, loudly, like the other fakes
in tests/fixtures/ (P10, af-ygibh) — a test that stops driving this should
see a clear failure, not a false green from a silent no-op.
"""
import json
import sys

if sys.argv[1:] == ["list", "--json"]:
    print(json.dumps([{"id": "af-fake1", "status": "open", "title": "fixture bead"}]))
    sys.exit(0)

# The beads source's second read (af-1al0t1): beads still carrying a
# NEEDS BENJAMIN whatever their status — none in this fixture.
if sys.argv[1:] == ["list", "--all", "--limit", "0", "--has-metadata-key", "gc.needs_benjamin", "--json"]:
    print(json.dumps([]))
    sys.exit(0)

# The "Projets" zone's read: every convoy and delivery ticket, open or
# closed -- none in this fixture.
if sys.argv[1:] == ["list", "--all", "--limit", "0", "--has-metadata-key", "gc.graph_digest", "--json"]:
    print(json.dumps([]))
    sys.exit(0)

# The journal's reads: every bead that ever bore a proposal or a cockpit
# action trace, and every event held for the journal (af-ltchro) -- none in
# this fixture.
# The runs read (cockpit.runs): ticket beads an agent ran on, and the beads
# the flow marked -- none here.
for _key in ("gc.proposal_state", "gc.cockpit_action_quoi", "gc.journal_event", "gc.flow.models", "gc.flow.mark"):
    if sys.argv[1:] == ["list", "--all", "--limit", "0", "--has-metadata-key", _key, "--json"]:
        print(json.dumps([]))
        sys.exit(0)

sys.stderr.write(
    "fake bd (cockpit-core): no canned response for: bd %s\n" % " ".join(sys.argv[1:])
)
sys.exit(1)
