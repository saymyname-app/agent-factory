#!/usr/bin/env python3
"""A fake `gc` CLI, scoped to the factory-boot/cockpit integration test
(af-0b6ffa): answers just enough for factory-boot to see a healthy,
non-suspended, running city and move on to the cockpit-start decision
under test, without touching a live controller.
"""
import json
import sys

args = sys.argv[1:]

if args[:2] == ["supervisor", "status"]:
    print("supervisor is running")
    sys.exit(0)

if args[:1] == ["status"] and "--json" in args:
    print(json.dumps({"running": True, "suspended": False}))
    sys.exit(0)

sys.stderr.write(
    "fake gc (factory-boot test): no canned response for: gc %s\n" % " ".join(args)
)
sys.exit(1)
