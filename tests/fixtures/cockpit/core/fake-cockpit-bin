#!/usr/bin/env python3
"""A fake `bin/cockpit`, for the factory-boot idempotent-launch test
(af-0b6ffa AC5). Every invocation is appended to
$FAKE_COCKPIT_LOG so the test can assert how many times, and in what
order, factory-boot called `status` and `start`. Whether `status` reports
running is controlled by $FAKE_COCKPIT_RUNNING (1 or 0).
"""
import os
import sys

log_path = os.environ["FAKE_COCKPIT_LOG"]
with open(log_path, "a") as fh:
    fh.write(" ".join(sys.argv[1:]) + "\n")

command = sys.argv[1] if len(sys.argv) > 1 else ""
if command == "status":
    sys.exit(0 if os.environ.get("FAKE_COCKPIT_RUNNING") == "1" else 1)
if command == "start":
    sys.exit(0)
sys.exit(1)
