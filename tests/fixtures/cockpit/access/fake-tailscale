#!/usr/bin/env python3
"""A fake `tailscale`, for the cockpit seam tests. Answers the one call the
cockpit makes, `tailscale status --json`, with the fields of the real
answer the cockpit reads (`BackendState`, `Self.KeyExpiry`, `Self.Online`
-- shape checked against the installed client, 2026-10-06). The key's
expiry comes from the file named by $FAKE_TAILSCALE_EXPIRY_FILE, which a
test rewrites; an absent file is a client that cannot answer (exit 1).
Refuses every other call, loudly.
"""
import json
import os
import sys

if sys.argv[1:] != ["status", "--json"]:
    sys.stderr.write("fake tailscale: no canned response for: tailscale %s\n" % " ".join(sys.argv[1:]))
    sys.exit(2)

path = os.environ.get("FAKE_TAILSCALE_EXPIRY_FILE", "")
try:
    with open(path) as fh:
        expiry = fh.read().strip()
except OSError:
    sys.stderr.write("failed to connect to local Tailscale service; is Tailscale running?\n")
    sys.exit(1)

print(json.dumps({"BackendState": "Running", "Self": {"KeyExpiry": expiry, "Online": True}}))
