#!/usr/bin/env python3
"""A controllable fake `escalation-door` for the T14 (af-peh3yy) Operator
Actions seam test. Understands `repondre <bead> <lettre> --actor <qui>` -- the only
command cockpit.actions.registry's `repondre` handler ever calls -- and
writes the SAME metadata field names the real bin/escalation-door's
`cmd_repondre` writes, onto the SAME $FAKE_BD_STATE_FILE the fake `bd` in
this directory reads and writes, so a test sees one consistent bead state
across all the fakes.

Every invocation is appended, one JSON line per call, to
$FAKE_ESCALATION_DOOR_CALLS_FILE. Forced failure via
$FAKE_ESCALATION_DOOR_FAIL_FLAG_FILE (same idiom as fake-bd's
FAKE_BD_FAIL_FLAG_FILE). The response timestamp is deterministic:
$FAKE_DOOR_NOW (an ISO-8601 UTC string, e.g. "2026-09-30T12:05:00Z") if
set, else real UTC "now".
"""
import json
import os
import sys
from datetime import datetime, timezone


def _state_path():
    return os.environ["FAKE_BD_STATE_FILE"]


def _load():
    path = _state_path()
    if not os.path.exists(path):
        return []
    with open(path) as fh:
        raw = fh.read().strip()
    return json.loads(raw) if raw else []


def _save(beads):
    with open(_state_path(), "w") as fh:
        json.dump(beads, fh)


def _log_call(args):
    log_path = os.environ.get("FAKE_ESCALATION_DOOR_CALLS_FILE")
    if not log_path:
        return
    with open(log_path, "a") as fh:
        fh.write(json.dumps(args) + "\n")


def _fail_if_flagged():
    fail_flag = os.environ.get("FAKE_ESCALATION_DOOR_FAIL_FLAG_FILE")
    if fail_flag and os.path.exists(fail_flag):
        sys.stderr.write("fake escalation-door: forced failure\n")
        sys.exit(1)


def _now_iso():
    forced = os.environ.get("FAKE_DOOR_NOW")
    if forced:
        return forced
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_repondre(args):
    if len(args) != 4 or args[2] != "--actor":
        sys.stderr.write("usage: fake escalation-door repondre <bead> <lettre> --actor <qui>\n")
        sys.exit(2)
    bead_id, lettre = args[:2]
    actor = args[3]
    beads = _load()
    bead = next((b for b in beads if b.get("id") == bead_id), None)
    if bead is None:
        sys.stderr.write("fake escalation-door: %s is unavailable.\n" % bead_id)
        sys.exit(1)
    metadata = bead.setdefault("metadata", {})
    que_faire_raw = metadata.get("gc.escalation_que_faire") or ""
    try:
        que_faire = json.loads(que_faire_raw) if que_faire_raw else []
    except ValueError:
        que_faire = []
    chosen = next((o for o in que_faire if o.get("lettre") == lettre), None)
    if que_faire and chosen is None:
        sys.stderr.write("fake escalation-door: '%s' n'est pas une option connue pour %s.\n" % (lettre, bead_id))
        sys.exit(1)
    option_texte = chosen.get("option") if chosen else lettre
    now = _now_iso()
    metadata["gc.escalation_response_option"] = lettre
    metadata["gc.escalation_response_at"] = now
    metadata["gc.escalation_response_actor"] = actor
    metadata["gc.needs_benjamin"] = "none"
    metadata["gc.escalation_mayor_paged_at"] = "none"
    metadata["gc.escalation_mayor_reason"] = "none"
    note = "RÉPONSE: %s — %s" % (lettre, option_texte)
    notes = bead.get("notes", "")
    bead["notes"] = (notes + "\n" + note) if notes else note
    _save(beads)
    sys.stdout.write("RÉPONDU: %s — %s) %s\n" % (bead_id, lettre, option_texte))
    sys.exit(0)


def main():
    argv = sys.argv[1:]
    _log_call(argv)
    _fail_if_flagged()
    if not argv:
        sys.exit(2)
    command, rest = argv[0], argv[1:]
    if command == "repondre":
        cmd_repondre(rest)
    else:
        sys.stderr.write("fake escalation-door: unsupported command %s\n" % command)
        sys.exit(2)


if __name__ == "__main__":
    main()
