#!/usr/bin/env python3
"""A controllable fake `gc` for the T14 (af-peh3yy) Operator Actions seam
test's `relancer` action on an order target. Understands
`order run <order-name>` -- the only command cockpit.actions.registry's
`relancer` handler ever calls for an order target (there is no dedicated
order-pause/order-resume door yet). Logs the call and exits 0; exits 1 if
$FAKE_GC_BIN_FAIL_FLAG_FILE exists.

Named `fake-gc-bin` (not `fake-gc`) to stay distinct from
tests/fixtures/cockpit/core/fake_gc.py, the unrelated HTTP+SSE fake the
read-model source already uses -- COCKPIT_GC_BIN is a separate,
subprocess-invoked binary for this one action.

Every invocation is appended, one JSON line per call, to
$FAKE_GC_BIN_CALLS_FILE.
"""
import json
import os
import sys


def _log_call(args):
    log_path = os.environ.get("FAKE_GC_BIN_CALLS_FILE")
    if not log_path:
        return
    with open(log_path, "a") as fh:
        fh.write(json.dumps(args) + "\n")


def _fail_if_flagged():
    fail_flag = os.environ.get("FAKE_GC_BIN_FAIL_FLAG_FILE")
    if fail_flag and os.path.exists(fail_flag):
        sys.stderr.write("fake gc: forced failure\n")
        sys.exit(1)


def cmd_order_run(args):
    if not args:
        sys.stderr.write("usage: fake gc order run <order-name>\n")
        sys.exit(2)
    order_name = args[0]
    sys.stdout.write("order %s: started\n" % order_name)
    sys.exit(0)


def main():
    argv = sys.argv[1:]
    _log_call(argv)
    _fail_if_flagged()
    if len(argv) >= 2 and argv[0] == "order" and argv[1] == "run":
        cmd_order_run(argv[2:])
        return
    sys.stderr.write("fake gc: unsupported invocation %r\n" % (argv,))
    sys.exit(2)


if __name__ == "__main__":
    main()
