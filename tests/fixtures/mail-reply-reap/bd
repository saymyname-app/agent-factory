#!/usr/bin/env python3
"""Fake `bd` used by mail-reply-reap-test.py.

Handles the three calls mail-reply-reap makes:
  bd -C <root> list --include-infra --type message --status open --json --limit 0
      -> prints MAIL_TEST_MESSAGES (a JSON array), default "[]"
  bd -C <root> list --assignee <name> --status open,in_progress --json --limit 0
      -> prints the entry for <name> in MAIL_TEST_ASSIGNED_MAP (a JSON object
         mapping assignee -> array), default "[]" if <name> is absent
  bd -C <root> update <id> --if-assignee <holder> --status closed --append-notes <reason>
      -> appends {"id": <id>, "if_assignee": <holder>, "reason": <reason>} to
         MAIL_TEST_CLOSE_LOG; exits 13, writing nothing, for an id listed in
         MAIL_TEST_HOLDER_CHANGED (comma-separated), as bd does when the
         holder is no longer the one named
A bare `bd close` is refused: Beads 1.3 refuses it on a bead another actor
holds, and a mail bead is held by its recipient (af-vhvmsi).
"""
import json
import os
import sys
from pathlib import Path

args = sys.argv[1:]
if len(args) >= 2 and args[0] == "-C":
    args = args[2:]

if args[:1] == ["list"] and "--type" in args and "message" in args:
    print(os.environ.get("MAIL_TEST_MESSAGES", "[]"))
    raise SystemExit(0)

if args[:1] == ["list"] and "--assignee" in args:
    assignee = args[args.index("--assignee") + 1]
    mapping = json.loads(os.environ.get("MAIL_TEST_ASSIGNED_MAP", "{}"))
    print(json.dumps(mapping.get(assignee, [])))
    raise SystemExit(0)

if args[:1] == ["update"] and "--if-assignee" in args and args[args.index("--status") + 1:][:1] == ["closed"]:
    bead_id = args[1]
    if bead_id in os.environ.get("MAIL_TEST_HOLDER_CHANGED", "").split(","):
        print(f"assignee mismatch on {bead_id}", file=sys.stderr)
        raise SystemExit(13)
    log = Path(os.environ["MAIL_TEST_CLOSE_LOG"])
    with log.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps({
            "id": bead_id,
            "if_assignee": args[args.index("--if-assignee") + 1],
            "reason": args[args.index("--append-notes") + 1],
        }) + "\n")
    raise SystemExit(0)

print(f"unexpected fake bd arguments: {args}", file=sys.stderr)
raise SystemExit(2)
