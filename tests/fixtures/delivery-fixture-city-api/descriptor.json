    "seam_mode": "black_box",
    "regression_command": "node tests/fixtures/delivery-fixture-city-api/tests/regression.js",
    "k": 3,
    "anchors": {
      "equivalent": [
        {"name": "items-state", "entry_point": "GET /items", "observable": "champ state"},
        {"name": "items-generated-at", "entry_point": "GET /items", "observable": "champ generated_at"},
        {"name": "items-list", "entry_point": "GET /items", "observable": "champ items"},
