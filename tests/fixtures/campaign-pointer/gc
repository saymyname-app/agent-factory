#!/usr/bin/env bash
#
# Deterministic `gc` fixture for tests/campaign-pointer-test.sh. Beads live
# as one JSON file per id under CP_BEAD_DIR; every call is appended to
# CP_CALL_LOG.

set -Eeuo pipefail

: "${CP_BEAD_DIR:?CP_BEAD_DIR must be set by the test}"
: "${CP_CALL_LOG:?CP_CALL_LOG must be set by the test}"
printf '%q ' "$@" >>"$CP_CALL_LOG"
printf '\n' >>"$CP_CALL_LOG"

bead_file() { printf '%s/%s.json' "$CP_BEAD_DIR" "$1"; }

if [[ ${1:-} == bd && ${2:-} == show && ${4:-} == --json ]]; then
  id=$3
  file=$(bead_file "$id")
  [[ -f $file ]] || { printf 'not found\n' >&2; exit 42; }
  jq -c '[.]' "$file"
  exit 0
fi

if [[ ${1:-} == bd && ${2:-} == update ]]; then
  id=$3
  file=$(bead_file "$id")
  [[ -f $file ]] || printf '{"id":"%s","status":"open","metadata":{},"notes":""}' "$id" >"$file"
  shift 3
  tmp="${file}.tmp"
  cp "$file" "$tmp"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --set-metadata)
        pair=$2
        key=${pair%%=*}
        value=${pair#*=}
        jq --arg key "$key" --arg value "$value" '.metadata[$key] = $value' "$tmp" >"${tmp}.next"
        mv "${tmp}.next" "$tmp"
        shift 2
        ;;
      --append-notes)
        jq --arg note "$2" '.notes = ((.notes // "") + "\n" + $note)' "$tmp" >"${tmp}.next"
        mv "${tmp}.next" "$tmp"
        shift 2
        ;;
      *)
        printf 'unsupported gc bd update flag: %s\n' "$1" >&2
        exit 64
        ;;
    esac
  done
  mv "$tmp" "$file"
  printf '{}\n'
  exit 0
fi

if [[ ${1:-} == mail && ${2:-} == send && ${3:-} == human ]]; then
  [[ ${CP_MAIL_FAIL:-0} != 1 ]] || { printf 'mail unavailable\n' >&2; exit 42; }
  printf '{"ok":true}\n'
  exit 0
fi

printf 'unsupported gc fixture command\n' >&2
exit 64
