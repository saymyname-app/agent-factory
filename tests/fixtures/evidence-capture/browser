#!/usr/bin/env python3
"""Fake headless browser for evidence-capture-test.py (T09, af-pvcg6t).

Takes the command line bin/evidence-capture gives a Chromium (observed on
Chromium 1243, 2026-10-06: `--headless --screenshot=<file> ... <url>` loads
the page and writes a PNG to <file>). It fetches the URL for real, so a test
can prove the page of the launched product was the one captured, and writes a
valid 1x1 PNG whose pixel is derived from the page it received. Each URL is
appended to EVIDENCE_FAKE_BROWSER_LOG when set.

EVIDENCE_FAKE_BROWSER_MODE: `no-file` writes nothing and exits 0; `not-png`
writes a file that is not an image.
"""
import hashlib
import os
import struct
import sys
import urllib.request
import zlib


def chunk(kind: bytes, data: bytes) -> bytes:
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))


def main(args: list[str]) -> int:
    target = next((arg.split("=", 1)[1] for arg in args if arg.startswith("--screenshot=")), None)
    url = args[-1] if args and not args[-1].startswith("--") else None
    if target is None or url is None:
        sys.stderr.write(f"fake browser: no canned response configured for: {' '.join(args)}\n")
        return 1
    with urllib.request.urlopen(url, timeout=5) as response:
        body = response.read()
    log = os.environ.get("EVIDENCE_FAKE_BROWSER_LOG")
    if log:
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(url + "\n")
    mode = os.environ.get("EVIDENCE_FAKE_BROWSER_MODE")
    if mode == "no-file":
        return 0
    if mode == "not-png":
        with open(target, "w", encoding="utf-8") as handle:
            handle.write("ceci n'est pas une image\n")
        return 0
    pixel = hashlib.sha256(body).digest()[:3]
    png = (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(b"\x00" + pixel))
        + chunk(b"IEND", b"")
    )
    with open(target, "wb") as handle:
        handle.write(png)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
