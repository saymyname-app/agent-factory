#!/usr/bin/env bash

set -Eeuo pipefail

if [[ ${1:-} == bd ]]; then
  fixture_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
  exec "$fixture_root/bd" "${@:2}"
fi

[[ ${1:-} == status && ${2:-} == --json ]] || exit 64

running=true
[[ ${STATUS_SCENARIO:-active} != agent-missing ]] || running=false
city_running=true
usable=true
degraded=false
[[ ${STATUS_SCENARIO:-active} != health-down ]] || { city_running=false; usable=false; }
[[ ${STATUS_SCENARIO:-active} != health-partial ]] || degraded=true
cat <<JSON
{"ok":true,"running":$city_running,"health":{"usable":$usable,"degraded":$degraded},"agents":[{"qualified_name":"core.control-dispatcher","running":true},{"qualified_name":"codex-af-test","running":$running}]}
JSON
