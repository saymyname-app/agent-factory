#!/usr/bin/env bash

set -Eeuo pipefail

[[ ${1:-} == status && ${2:-} == --json ]] || exit 64

running=true
[[ ${STATUS_SCENARIO:-active} != agent-missing ]] || running=false
cat <<JSON
{"ok":true,"health":{"usable":true},"agents":[{"qualified_name":"core.control-dispatcher","running":true},{"qualified_name":"codex-af-test","running":$running}]}
JSON
