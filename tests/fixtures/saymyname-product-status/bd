#!/usr/bin/env bash

set -Eeuo pipefail

scenario=${STATUS_SCENARIO:-active}
command_name=${1:-}

emit_parent() {
  local current="af-current"
  local delivered="af-delivered"
  local needs="none"

  [[ $scenario != idle ]] || current="none"
  [[ $scenario != no-candidate ]] || current="none"
  [[ $scenario != all-paused ]] || current="none"
  [[ $scenario != idle-campaign ]] || current="none"
  [[ $scenario != campaign-decision ]] || current="none"
  [[ $scenario != campaign-admin ]] || current="none"
  [[ $scenario != campaign-durable ]] || current="none"
  [[ $scenario != campaign-retry ]] || current="none"
  [[ $scenario != campaign-all-paused ]] || current="none"
  [[ $scenario != direct && $scenario != direct-ambiguous ]] || current="smb-direct"
  [[ $scenario != human ]] || needs="Choose whether to prioritize bounded intent intake"
  [[ $scenario != campaign-decision ]] || needs="Choisir le périmètre du prochain résultat"
  if [[ $scenario == routed ]]; then
    current="smb-current"
    delivered="smf-delivered"
  fi
  local next="Evaluate supported ChatGPT plugin/MCP bridge"
  local resume=''
  [[ $scenario != no-candidate ]] || next="none"
  [[ $scenario != mismatch-next ]] || next="A different candidate"
  local campaign=''
  if [[ $scenario == idle-campaign || $scenario == campaign-retry || $scenario == campaign-all-paused ]]; then
    resume=',"gc.resume_mode":"automatic_campaign","gc.resume_condition":"Le Mayor enchaîne le premier candidat éligible"'
    campaign=',"gc.campaign_mode":"automatic","gc.campaign_state":"active","gc.campaign_candidate":"af-cm1l","gc.campaign_condition":"Le Mayor enchaîne le premier candidat éligible","gc.campaign_owner":"Mayor","gc.campaign_action":"Aucune action de Benjamin","gc.campaign_wake_state":"none","gc.campaign_failure_count":"0"'
  elif [[ $scenario == campaign-decision ]]; then
    resume=',"gc.resume_mode":"automatic_campaign","gc.resume_condition":"Le Mayor enchaîne le premier candidat éligible"'
    campaign=',"gc.campaign_mode":"automatic","gc.campaign_state":"blocked","gc.campaign_candidate":"af-cm1l","gc.campaign_condition":"Le Mayor enchaîne le premier candidat éligible","gc.campaign_owner":"Benjamin","gc.campaign_action":"Valider le périmètre puis demander au Mayor de reprendre","gc.campaign_block_kind":"decision","gc.campaign_cause":"La campagne attend le choix de périmètre","gc.campaign_wake_state":"none","gc.campaign_failure_count":"0"'
  elif [[ $scenario == campaign-admin ]]; then
    resume=',"gc.resume_mode":"automatic_campaign","gc.resume_condition":"Le Mayor enchaîne le premier candidat éligible"'
    campaign=',"gc.campaign_mode":"automatic","gc.campaign_state":"blocked","gc.campaign_candidate":"af-cm1l","gc.campaign_condition":"Le Mayor enchaîne le premier candidat éligible","gc.campaign_owner":"Benjamin","gc.campaign_action":"Autoriser explicitement la rotation du secret","gc.campaign_block_kind":"admin","gc.campaign_cause":"Une rotation de secret ADMIN est requise","gc.campaign_wake_state":"none","gc.campaign_failure_count":"0"'
  elif [[ $scenario == campaign-durable ]]; then
    resume=',"gc.resume_mode":"automatic_campaign","gc.resume_condition":"Le Mayor enchaîne le premier candidat éligible"'
    campaign=',"gc.campaign_mode":"automatic","gc.campaign_state":"blocked","gc.campaign_candidate":"af-cm1l","gc.campaign_condition":"Le Mayor enchaîne le premier candidat éligible","gc.campaign_owner":"Mayor","gc.campaign_action":"Diagnostiquer puis reprendre avec mayor-campaign resume --mayor","gc.campaign_block_kind":"durable_failure","gc.campaign_cause":"Trois lectures déterministes ont échoué","gc.campaign_wake_state":"none","gc.campaign_failure_count":"3","gc.campaign_last_error":"queue lock timeout"'
  fi
  [[ $scenario != campaign-retry ]] || campaign=',"gc.campaign_mode":"automatic","gc.campaign_state":"active","gc.campaign_candidate":"af-cm1l","gc.campaign_condition":"Le Mayor enchaîne le premier candidat éligible","gc.campaign_owner":"Mayor","gc.campaign_action":"Aucune action de Benjamin","gc.campaign_wake_state":"none","gc.campaign_failure_count":"1","gc.campaign_last_error":"queue lock timeout"'
  cat <<JSON
[{"id":"af-1vr4","status":"in_progress","metadata":{"gc.current_jit":"$current","gc.last_delivered":"$delivered","gc.next_outcome":"$next","gc.needs_benjamin":"$needs"$resume$campaign}}]
JSON
}

emit_current() {
  local issue_id="af-current"
  local title="Expose SayMyName product status summary"
  local parent="af-1vr4"
  local status="in_progress"
  [[ $scenario != human ]] || status="open"
  [[ $scenario != blocked ]] || status="blocked"
  [[ $scenario != closed-current ]] || status="closed"
  [[ $scenario != closed-dependency ]] || status="closed"
  [[ $scenario != closed-waiting-on ]] || status="closed"
  if [[ $scenario == routed ]]; then
    issue_id="smb-current"
    title="Implement backend product outcome"
    parent="smb-product-goal"
  fi
  if [[ $scenario == direct || $scenario == direct-ambiguous ]]; then
    issue_id="smb-direct"
    title="Publish verified French presidents challenge"
    parent="smb-product-goal"
  fi
  local metadata='{}'
  [[ $scenario != blocked ]] || metadata='{"gc.blocked_reason":"La preuve externe requise manque"}'
  [[ $scenario != dependency ]] || metadata='{"gc.resume_mode":"automatic_dependency","gc.resume_condition":"La dépendance af-proof se ferme"}'
  [[ $scenario != closed-dependency ]] || metadata='{"gc.resume_mode":"automatic_dependency","gc.resume_condition":"La dépendance af-proof se ferme"}'
  [[ $scenario != closed-waiting-on ]] || metadata='{"gc.waiting_on":"po"}'
  [[ $scenario != finalizing ]] || metadata='{"gc.work_outcome":"pass"}'
  [[ $scenario != direct && $scenario != direct-ambiguous ]] || metadata='{"gc.session_id":"af-jqla","gc.session_name":"codex-af-jqla","gc.routed_to":"saymyname-backend/codex"}'
  [[ $scenario != workflow-root ]] || metadata='{"gc.kind":"workflow","gc.session_id":"af-stale-session","gc.session_name":"codex-af-stale"}'
  [[ $scenario != self-workflow ]] || metadata='{"gc.kind":"workflow","gc.input_convoy_id":"af-self-convoy","gc.session_name":"codex-af-self"}'
  # af-6k6sn: gc.session_name is stamped once from the workflow's first step
  # and never updated as later steps hand off to new sessions. This scenario
  # simulates a workflow long past that handoff -- codex-af-handoff-stale
  # has no more steps assigned to it (emit_handoff_steps below returns [])
  # even though the convoy (af-self-convoy) still has a genuinely open child.
  [[ $scenario != self-workflow-handoff ]] || metadata='{"gc.kind":"workflow","gc.input_convoy_id":"af-self-convoy","gc.session_name":"codex-af-handoff-stale"}'
  cat <<JSON
[{"id":"$issue_id","title":"$title","status":"$status","parent":"$parent","metadata":$metadata}]
JSON
}

emit_delivered() {
  local issue_id="af-delivered"
  local title="Deterministic local preview"
  local parent="af-1vr4"
  local github_repo="saymyname-app/agent-factory"
  if [[ $scenario == routed ]]; then
    issue_id="smf-delivered"
    title="Deliver frontend product outcome"
    parent="smf-product-goal"
    github_repo="saymyname/frontend"
  fi
  [[ $scenario != invalid-repo ]] || github_repo="not a repository"
  if [[ $scenario == proof-missing ]]; then
    cat <<JSON
[{"id":"$issue_id","title":"$title","status":"closed","parent":"$parent","metadata":{"gc.delivery_status":"merged"}}]
JSON
    return
  fi
  cat <<JSON
[{"id":"$issue_id","title":"$title","status":"closed","parent":"$parent","metadata":{"gc.delivery_status":"merged","gc.work_outcome":"shipped","gc.github_repo":"$github_repo","gc.pr_number":24,"gc.pr_head":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","gc.merge_commit":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}}]
JSON
}

emit_workflows() {
  if [[ $scenario == self-workflow || $scenario == self-workflow-handoff ]]; then
    # af-current IS the only in-progress workflow (its own root); the
    # inventory here holds no *other* workflow, and its own convoy (below)
    # tracks its implementation children, never af-current itself.
    printf '[]\n'
    return
  fi
  # af-knbxq: the implementation convoy closing (active_count == 0) is not
  # the same as the workflow finishing -- a full build-basic v2 graph has
  # starter review / publish / finalize-workflow phases downstream of it as
  # the workflow root's own "blocks"-type dependency, never as convoy
  # members. workflow-pending-finalize simulates that open completion gate;
  # workflow-truly-finalizing closes it to prove the finalizing path still
  # fires once nothing is left open.
  if [[ $scenario == workflow-pending-finalize || $scenario == workflow-truly-finalizing ]]; then
    local gate_status=open
    [[ $scenario != workflow-truly-finalizing ]] || gate_status=closed
    cat <<JSON
[{"id":"af-workflow","status":"in_progress","metadata":{"gc.kind":"workflow","gc.input_convoy_id":"af-convoy","gc.session_name":"codex-af-test"},"dependencies":[{"id":"af-finalize-gate","status":"$gate_status","dependency_type":"blocks"}]}]
JSON
    return
  fi
  cat <<'JSON'
[{"id":"af-workflow","status":"in_progress","metadata":{"gc.kind":"workflow","gc.input_convoy_id":"af-convoy","gc.session_name":"codex-af-test"}}]
JSON
}

emit_convoy() {
  local current="af-current"
  [[ $scenario != routed ]] || current="smb-current"
  local tracked_status=in_progress
  [[ $scenario != workflow-pending-finalize && $scenario != workflow-truly-finalizing ]] \
    || tracked_status=closed
  cat <<JSON
[{"id":"af-convoy","status":"open","dependencies":[{"id":"$current","status":"$tracked_status","dependency_type":"tracks"}],"metadata":{}}]
JSON
}

emit_self_convoy() {
  # af-illx1/self-workflow: the workflow's own convoy tracks its
  # implementation children, never itself, so this must not reuse
  # af-current -- a distinct still-open child proves the convoy is
  # genuinely active independent of the workflow-root bead's own status.
  cat <<'JSON'
[{"id":"af-self-convoy","status":"open","dependencies":[{"id":"af-self-child","status":"in_progress","dependency_type":"tracks"}],"metadata":{}}]
JSON
}

emit_steps() {
  cat <<'JSON'
[{"id":"af-step","status":"open","assignee":"codex-af-test","metadata":{"gc.root_bead_id":"af-workflow","gc.session_name":"codex-af-test","gc.step_ref":"mol-polecat-commit.implement"}}]
JSON
}

emit_self_steps() {
  cat <<'JSON'
[{"id":"af-self-step","status":"open","assignee":"codex-af-self","metadata":{"gc.root_bead_id":"af-current","gc.session_name":"codex-af-self","gc.step_ref":"mol-do-work.implement"}}]
JSON
}

case "$command_name" in
  show)
    args=("$@")
    idx=1
    ids=()
    while [[ $idx -lt ${#args[@]} && "${args[$idx]}" != --json ]]; do
      ids+=("${args[$idx]}")
      idx=$((idx + 1))
    done
    [[ $idx -lt ${#args[@]} && "${args[$idx]}" == --json ]] || exit 64
    for issue_id in "${ids[@]}"; do
      if [[ $scenario == source-failure && $issue_id == af-1vr4 ]]; then
        printf 'fixture Beads outage\n' >&2
        exit 42
      fi
    done
    parts=()
    for issue_id in "${ids[@]}"; do
      case "$issue_id" in
        af-1vr4) emitted=$(emit_parent) ;;
        af-current|smb-current|smb-direct) emitted=$(emit_current) ;;
        af-delivered|smf-delivered) emitted=$(emit_delivered) ;;
        af-convoy) emitted=$(emit_convoy) ;;
        af-self-convoy) emitted=$(emit_self_convoy) ;;
        *) printf 'unknown fixture issue: %s\n' "$issue_id" >&2; exit 64 ;;
      esac
      parts+=("$(jq -c '.[0]' <<<"$emitted")")
    done
    (IFS=,; printf '[%s]\n' "${parts[*]}")
    ;;
  list)
    case "${2:-}" in
      --status=in_progress) emit_workflows ;;
      --assignee=codex-af-test) emit_steps ;;
      --assignee=codex-af-self) emit_self_steps ;;
      --assignee=codex-af-handoff-stale) printf '[]\n' ;;
      *) printf 'unsupported fixture list: %s\n' "$*" >&2; exit 64 ;;
    esac
    ;;
  *)
    printf 'unsupported fixture bd command: %s\n' "$*" >&2
    exit 64
    ;;
esac
