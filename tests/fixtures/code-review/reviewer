#!/usr/bin/env python3
"""Stand-in for the dispatch door and the reviewer session it starts, for
tests/code-review-test.py: no agent runs in CI, only what goes in and out of
the command (Spec af-wf4w5r, Testing Decisions).

Called as bin/dispatch-door is (`<bead> --rig R --formula F --role ROLE`), it
logs its arguments to CODE_REVIEW_FAKE_LOG, then does what a reviewer session
does with the routed bead: read the convoy and the ticket it names, ask
`code-review brief` (kept, call by call, in CODE_REVIEW_FAKE_BRIEFS), and
hand a review or a judgement to `code-review record` from a read-only role
session of its own (`delivery-reviewer-fixture-<call number>`).

What each call does is read from the JSON list in CODE_REVIEW_FAKE_PLAN, one
entry per call, the last one repeated:

    "favorable"                     no finding, « oui » to every closed question, every answer judged favorably
    {"findings": [...],             those findings, as a reviewer writes them;
     "no": {"<subject>": "<reason>"},    « non » to the closed questions on those subjects;
     "judgements": {"<finding id>": "<reason>"}}    those Blocking Findings judged unfavorably
    "silent"                        the session starts and never answers
    "closed"                        the session closes its bead without a verdict
    "door-refuses"                  the door refuses the dispatch
    "door-defers"                   the door defers the dispatch (exit 75)
"""
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
TOOL = str(ROOT / "bin" / "code-review")
GC = os.environ["GC_BIN"]

log = Path(os.environ["CODE_REVIEW_FAKE_LOG"])
calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
with log.open("a", encoding="utf-8") as handle:
    handle.write(json.dumps(sys.argv[1:]) + "\n")
plan = json.loads(Path(os.environ["CODE_REVIEW_FAKE_PLAN"]).read_text(encoding="utf-8"))
step = plan[min(len(calls), len(plan) - 1)]

if step == "door-refuses":
    print("dispatch-door: dispatch refused: no passing adoption trial for role 'reviewer'", file=sys.stderr)
    raise SystemExit(2)
if step == "door-defers":
    print("dispatch-door: deferred -- guest MemAvailable is 1.0 GiB, below the 1.5 GiB floor", file=sys.stderr)
    raise SystemExit(75)
if step == "silent":
    raise SystemExit(0)
bead_id = sys.argv[1]
if step == "closed":
    subprocess.run([GC, "bd", "close", bead_id, "--reason", "aucun verdict"], capture_output=True, check=True)
    raise SystemExit(0)

bead = json.loads(subprocess.run([GC, "bd", "show", bead_id, "--json"], capture_output=True, text=True, check=True).stdout)[0]
convoy = re.search(r"^convoy: (\S+)$", bead["description"], re.MULTILINE).group(1)
ticket = re.search(r"^ticket: (\S+)$", bead["description"], re.MULTILINE).group(1)
number = len(calls) + 1
session = {**os.environ, "DELIVERY_ROLE_READ_ONLY": "1", "GC_SESSION_NAME": f"delivery-reviewer-fixture-{number}"}
repo = os.environ["CODE_REVIEW_FAKE_REPO"]
asked = subprocess.run([TOOL, "brief", convoy, ticket, "--repo", repo], env=session, capture_output=True, text=True, check=True)
briefs = os.environ.get("CODE_REVIEW_FAKE_BRIEFS")
if briefs:
    Path(briefs).mkdir(parents=True, exist_ok=True)
    (Path(briefs) / f"brief-{number}.json").write_text(asked.stdout, encoding="utf-8")
brief = json.loads(asked.stdout)
given = step if isinstance(step, dict) else {}
if brief["kind"] == "review":
    no = given.get("no", {})
    handed = {
        "commit": brief["commit"], "findings": given.get("findings", []),
        "answers": {question["id"]: ({"answer": "non", "reason": no[question["subject"]]} if question["subject"] in no
                                     else {"answer": "oui"}) for question in brief["questions"]},
    }
else:
    refused = given.get("judgements", {})
    handed = {
        "commit": brief["commit"],
        "judgements": {finding["id"]: ({"state": "unfavorable", "reason": refused[finding["id"]]}
                                       if finding["id"] in refused else {"state": "favorable"})
                       for finding in brief["findings"]},
    }
with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8") as handle:
    json.dump(handed, handle, ensure_ascii=False)
proc = subprocess.run([TOOL, "record", convoy, ticket, "--file", handle.name, "--repo", repo],
                      env=session, capture_output=True, text=True)
os.unlink(handle.name)
sys.stderr.write(proc.stdout + proc.stderr)
subprocess.run([GC, "bd", "close", bead_id, "--reason", "revue enregistrée"], capture_output=True)
raise SystemExit(0)
