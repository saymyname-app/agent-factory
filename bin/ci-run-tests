#!/usr/bin/env bash
#
# ci-run-tests — discover and run every test under tests/, so CI and the
# main-landing gate run the current test set without anyone editing this
# script or .github/workflows/ci.yml per file (P01, af-tltj3).
#
# Before this, ci.yml listed each tests/*.py|*.sh file by hand: 41 of the
# last 100 PRs touched it just to register a new test, and the registration
# check (tests/ci-registration-test.sh) kept catching test files that were
# neither wired into ci.yml nor declared local-only, because a human had to
# remember the edit. Discovery removes the edit: every tests/*.sh and
# tests/*.py file runs automatically unless it carries a
#   # ci: local-only — <reason>
# marker (tests that need the live gc/bd runtime and a Dolt server, which a
# GitHub runner does not have).
#
# Usage:
#   ci-run-tests            # run every discovered test, print PASS/FAIL, then
#                            # exit non-zero if any failed
#   ci-run-tests --list     # print the discovered file paths, one per line,
#                            # and exit 0 (used by bin/factory-main-gate-like
#                            # callers that want the list without running it)
#   ci-run-tests --shard I/N [--list]
#                            # only lot I of N: the discovered files, longest
#                            # first, each given to the lot that has the least
#                            # so far, so every file is in exactly one lot and
#                            # the lots last about as long as each other.
#                            # Factory CI runs N lots on N runners at once
#                            # (.github/workflows/ci.yml): run one after the
#                            # other, the tests took 48 min on 2026-10-07, up
#                            # from 7 min two days before. How long a file
#                            # lasts is read in config/ci-test-seconds.tsv
#                            # (written by bin/ci-test-seconds from a real
#                            # run); a file it does not name is weighed by its
#                            # size. A stale list only makes the lots uneven:
#                            # the job named "Tests" is then billed while it
#                            # waits for the longest lot (af-mzuprx).
#   ci-run-tests --jobs J   # run J test files at once (default 1, or
#                            # CI_RUN_TESTS_JOBS). The tests are bound by the
#                            # processor -- one file starts thousands of
#                            # Python processes -- so a runner that runs one
#                            # file at a time leaves its other cores idle and
#                            # billed: Factory CI passes its core count
#                            # (af-mzuprx, docs/OPERATIONS.md "Factory CI
#                            # cost"). Each result line ends with the seconds
#                            # the file took.
#   ci-run-tests --changed-since REF [--list]
#                            # leave the long tests out when every file
#                            # committed between REF and HEAD is in an area
#                            # they cannot reach (af-5mw6z0). The long tests
#                            # are the files config/ci-test-seconds.tsv gives
#                            # LONG_TEST_SECONDS or more, less those marked
#                            #   # ci: every-run — <reason>
#                            # the areas are the closed list
#                            # config/ci-long-test-blind-areas.txt.
#                            # Anything else is a full run: a changed file
#                            # outside the list, no changed file, a REF that
#                            # cannot be read, uncommitted changes, or
#                            # CI_RUN_TESTS_FULL=1. Without this option every
#                            # run is a full run. The run says which it is and
#                            # why, and names each test it left out.
#   ci-run-tests --rule-checks [--changed-since REF] [--list]
#                            # not the battery: only the rule checks, the
#                            # files config/ci-test-seconds.tsv gives
#                            # RULE_CHECK_SECONDS or less (catalogues,
#                            # registration, lints), and with --changed-since
#                            # the test files changed since REF, committed or
#                            # not. What a change to docs, CI or tests alone
#                            # runs before its pull request; a delivery runs
#                            # the whole battery, and CI runs it in every case
#                            # (af-66bfyx, docs/DELIVERY.md).
#
# The areas are not believed, they are held: whenever a long test runs, it
# runs without sight of the real areas (see "blindfold" below), and one that
# read them fails the run.

set -uo pipefail

SELF=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/$(basename -- "${BASH_SOURCE[0]}")
REPO_ROOT="${FACTORY_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}"
SELF="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/$(basename -- "${BASH_SOURCE[0]}")"
ARGS=("$@")
cd "$REPO_ROOT" || { echo "ci-run-tests: $REPO_ROOT unreachable" >&2; exit 2; }

NEVER_READ='2000-01-01'  # the access time given to every entry of a copy

# Internal, the inside of the blindfold (see "blindfold" below):
#   ci-run-tests --blindfolded COPIES REACHED AREA_PATH... -- COMMAND...
# COPIES is an empty tmpfs only this mount namespace has. Copy each area
# there, run COMMAND where the areas are those copies and COPIES itself is
# hidden, then write to REACHED the entries of the copies that were read.
if [ "${1:-}" = "--blindfolded" ]; then
  copies=$2 reached=$3
  shift 3
  binds=()
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
    mkdir -p "$copies/$(dirname "$1")" && cp -a "$1" "$copies/$1" || exit 2
    binds+=(--bind "$copies/$1" "$REPO_ROOT/$1")
    shift
  done
  shift
  # Listed whole first: the listing itself reads the directories.
  mapfile -d '' entries < <(find "$copies" -print0)
  touch -a -h -d "$NEVER_READ" "${entries[@]}" || exit 2
  bwrap --dev-bind / / --die-with-parent "${binds[@]}" --tmpfs "$copies" -- "$@"
  status=$?
  (cd "$copies" && find . -mindepth 1 -newerat '2001-01-01' | sed 's|^\./||' | sort) >"$reached"
  exit "$status"
fi

MODE="run"
SHARD_I=""
SHARD_N=""
JOBS="${CI_RUN_TESTS_JOBS:-1}"
CHANGED_SINCE=""
RULE_CHECKS=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --list) MODE="list" ;;
    --rule-checks) RULE_CHECKS=1 ;;
    --shard)
      if ! [[ "${2:-}" =~ ^([1-9][0-9]*)/([1-9][0-9]*)$ ]] || [ "${BASH_REMATCH[1]}" -gt "${BASH_REMATCH[2]}" ]; then
        echo "ci-run-tests: --shard wants I/N with 1 <= I <= N, got: ${2:-nothing}" >&2; exit 2
      fi
      SHARD_I=${BASH_REMATCH[1]}; SHARD_N=${BASH_REMATCH[2]}
      shift
      ;;
    --jobs) JOBS=${2:-}; shift ;;
    --changed-since)
      [ -n "${2:-}" ] || { echo "ci-run-tests: --changed-since wants a commit" >&2; exit 2; }
      CHANGED_SINCE=$2; shift
      ;;
    *) echo "ci-run-tests: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
if ! [[ "$JOBS" =~ ^[1-9][0-9]*$ ]]; then
  echo "ci-run-tests: --jobs wants a number of files to run at once (1 or more), got: ${JOBS:-nothing}" >&2; exit 2
fi

is_local_only() {
  grep -qE '^#[[:space:]]*ci:[[:space:]]*local-only' "$1"
}

# Seconds each file took in a real run: "<path><TAB><seconds>" lines.
declare -A MEASURED=()
if [ -r config/ci-test-seconds.tsv ]; then
  while IFS=$'\t' read -r path seconds; do
    [[ "$seconds" =~ ^[0-9]+$ ]] && MEASURED[$path]=$seconds
  done < config/ci-test-seconds.tsv
fi

by_weight() {  # file paths on stdin -> "<seconds> <path>" lines, longest first
  local f
  while IFS= read -r f; do
    # Not measured yet: about one second per 200 bytes, what the long files show.
    printf '%s %s\n' "${MEASURED[$f]:-$(( $(wc -c < "$f") / 200 + 1 ))}" "$f"
  done | sort -k1,1nr -k2,2
}

# --- the long tests and the areas they cannot reach (af-5mw6z0) -------------
# One line per area: "dir/" is everything under that directory, anything else
# is a glob on the path. A file that is itself in an area is never a long
# test: a change to it must run it. Neither is a file marked
#   # ci: every-run — <reason>
# which is how a test that does read an area (it asks Git for the state of
# the whole repository, say) stays in every run.
LONG_TEST_SECONDS=30
AREAS_FILE=config/ci-long-test-blind-areas.txt
AREAS=()
if [ -r "$AREAS_FILE" ]; then
  while IFS= read -r line; do
    line=${line%%#*}
    line=${line//[[:space:]]/}
    [ -n "$line" ] && AREAS+=("$line")
  done < "$AREAS_FILE"
fi

in_blind_area() {
  local area
  for area in "${AREAS[@]}"; do
    case "$area" in
      */) [[ "$1" == "$area"* ]] && return 0 ;;
      *) # shellcheck disable=SC2053  # the area is a glob
         [[ "$1" == $area ]] && return 0 ;;
    esac
  done
  return 1
}

is_long() {
  [ "${#AREAS[@]}" -gt 0 ] && [ "${MEASURED[$1]:-0}" -ge "$LONG_TEST_SECONDS" ] && ! in_blind_area "$1" \
    && ! grep -qE '^#[[:space:]]*ci:[[:space:]]*every-run' "$1"
}

# SKIP_LONG stays 0 unless every question below has the answer that allows
# leaving the long tests out; SELECTION says which one did not.
SKIP_LONG=0
SELECTION="full run: no --changed-since"
select_tests() {
  local base changed f
  if [ "${CI_RUN_TESTS_FULL:-0}" = 1 ]; then
    SELECTION="full run: CI_RUN_TESTS_FULL=1"; return
  fi
  if [ "${#AREAS[@]}" -eq 0 ]; then
    SELECTION="full run: $AREAS_FILE names no area"; return
  fi
  if ! base=$(git merge-base --end-of-options "$CHANGED_SINCE" HEAD 2>/dev/null) \
    || ! changed=$(git diff --name-only --no-renames "$base" HEAD 2>/dev/null); then
    SELECTION="full run: what changed since $CHANGED_SINCE cannot be read"; return
  fi
  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    SELECTION="full run: the work tree has uncommitted changes"; return
  fi
  if [ -z "$changed" ]; then
    SELECTION="full run: no file changed since $CHANGED_SINCE"; return
  fi
  while IFS= read -r f; do
    if ! in_blind_area "$f"; then
      SELECTION="full run: $f changed, and it is outside the areas of $AREAS_FILE"; return
    fi
  done <<<"$changed"
  SKIP_LONG=1
  SELECTION="every file changed since $CHANGED_SINCE is in an area the long tests cannot reach ($AREAS_FILE)"
}
[ -n "$CHANGED_SINCE" ] && [ "$RULE_CHECKS" -eq 0 ] && select_tests

mapfile -t files < <(
  for f in tests/*.sh tests/*.py; do
    [ -e "$f" ] || continue
    is_local_only "$f" && continue
    printf '%s\n' "$f"
  done | sort
)

skipped=()
if [ "$SKIP_LONG" -eq 1 ]; then
  kept=()
  for f in "${files[@]}"; do
    if is_long "$f"; then skipped+=("$f"); else kept+=("$f"); fi
  done
  files=("${kept[@]}")
fi

# --- the rule checks alone (af-66bfyx) ---------------------------------------
# Of the 6 test files that failed in the pull request runs of the 30 pull
# requests merged before 2026-10-08, 5 were checks of 1 s or less (a stale
# generated catalogue), each seen after about 37 billed minutes. The files
# measured at RULE_CHECK_SECONDS or less were 105 of 150 and 107 s together.
# A file not measured yet is not one of them, unless it changed.
RULE_CHECK_SECONDS=5
touched=()
if [ "$RULE_CHECKS" -eq 1 ]; then
  declare -A CHANGED_TESTS=()
  if [ -n "$CHANGED_SINCE" ]; then
    if ! base=$(git merge-base --end-of-options "$CHANGED_SINCE" HEAD 2>/dev/null); then
      echo "ci-run-tests: --rule-checks: what changed since $CHANGED_SINCE cannot be read" >&2; exit 2
    fi
    while IFS= read -r f; do
      [ -n "$f" ] && CHANGED_TESTS[$f]=1
    done < <(
      git diff --name-only --no-renames "$base" -- tests 2>/dev/null
      git ls-files --others --exclude-standard -- tests 2>/dev/null
    )
  fi
  kept=()
  for f in "${files[@]}"; do
    if [ -n "${CHANGED_TESTS[$f]:-}" ]; then
      kept+=("$f"); touched+=("$f")
    elif [ -n "${MEASURED[$f]:-}" ] && [ "${MEASURED[$f]}" -le "$RULE_CHECK_SECONDS" ]; then
      kept+=("$f")
    fi
  done
  files=("${kept[@]}")
fi

if [ -n "$SHARD_N" ] && [ "${#files[@]}" -gt 0 ]; then
  mapfile -t files < <(
    printf '%s\n' "${files[@]}" | by_weight \
      | awk -v i="$SHARD_I" -v n="$SHARD_N" '{
          least = 1
          for (lot = 2; lot <= n; lot++) if (total[lot] + 0 < total[least] + 0) least = lot
          total[least] += $1
          if (least == i) print $2
        }' \
      | sort
  )
fi

if [ "$MODE" = "list" ]; then
  [ "${#files[@]}" -eq 0 ] || printf '%s\n' "${files[@]}"
  exit 0
fi

if [ "$RULE_CHECKS" -eq 1 ]; then
  echo "ci-run-tests: NOT the battery: the rule checks ($(( ${#files[@]} - ${#touched[@]} )) file(s) of ${RULE_CHECK_SECONDS}s or less in config/ci-test-seconds.tsv) and ${#touched[@]} changed test file(s). Enough before a pull request that changes docs, CI or tests alone; a delivery runs the whole battery (docs/DELIVERY.md)."
elif [ -n "$CHANGED_SINCE" ]; then
  if [ "$SKIP_LONG" -eq 1 ]; then
    echo "ci-run-tests: ${#skipped[@]} long test(s) NOT run: $SELECTION. CI_RUN_TESTS_FULL=1 runs them."
    for f in "${skipped[@]}"; do
      printf '  not run: %s (%ss in the last measured run)\n' "$f" "${MEASURED[$f]}"
    done
  else
    echo "ci-run-tests: $SELECTION"
  fi
fi

if [ "${#files[@]}" -eq 0 ] && [ -n "$SHARD_N" ]; then
  echo "ci-run-tests: lot $SHARD_I/$SHARD_N is empty"
  exit 0
fi
if [ "${#files[@]}" -eq 0 ]; then
  echo "ci-run-tests: no discoverable tests under tests/*.sh, tests/*.py" >&2
  exit 1
fi

# One battery at a time on a host that several sessions share (af-7m7ymg).
# On 2026-10-08 three batteries ran at once beside the live Factory: load 37,
# memory full, one file took 504 s instead of 60, and two Cockpit tests failed
# on "nothing listening on 127.0.0.1:<port> after 5s" that pass alone in 14 s.
# So a run takes a lock for the host and the next one waits its turn, saying
# whose battery it waits for. `flock --close` holds the lock in its own
# process: a server a test leaves behind does not keep the line, and the lock
# goes when the battery ends, however it ends. After CI_RUN_TESTS_HOST_WAIT
# seconds (default 5400) the run gives up with exit 75 and says no test ran:
# that is not a test failure. Not taken on a GitHub runner (one run per
# machine), by --list, or by a ci-run-tests started from inside a battery
# (tests of this script): that one inherits its battery's turn.
# CI_RUN_TESTS_HOST_LOCK_FILE names another lock file (tests only).
HOST_LOCK="${CI_RUN_TESTS_HOST_LOCK_FILE:-/tmp/agent-factory-ci-run-tests-$(id -u).lock}"
if [ "${GITHUB_ACTIONS:-}" != "true" ] && [ "${CI_RUN_TESTS_HOST_LOCK_HELD:-}" != "$HOST_LOCK" ]; then
  HOST_WAIT="${CI_RUN_TESTS_HOST_WAIT:-5400}"
  if ! [[ "$HOST_WAIT" =~ ^[0-9]+$ ]]; then
    echo "ci-run-tests: CI_RUN_TESTS_HOST_WAIT wants a number of seconds, got: $HOST_WAIT" >&2; exit 2
  fi
  step=0
  while :; do
    CI_RUN_TESTS_HOST_LOCK_HELD="$HOST_LOCK" flock --close --timeout "$step" --conflict-exit-code 75 \
      "$HOST_LOCK" "$BASH" "$SELF" "${ARGS[@]}"
    status=$?
    [ "$status" -eq 75 ] || exit "$status"
    holder=$(cat "$HOST_LOCK.holder" 2>/dev/null) || holder="another session"
    if [ "$SECONDS" -ge "$HOST_WAIT" ]; then
      echo "ci-run-tests: NOT RUN -- the battery of $holder still holds the host after ${SECONDS}s (CI_RUN_TESTS_HOST_WAIT=$HOST_WAIT). No test ran: this is not a test failure. Start it again later." >&2
      exit 75
    fi
    echo "ci-run-tests: waiting for the battery of $holder -- one battery at a time on this host; waited ${SECONDS}s of at most ${HOST_WAIT}s" >&2
    step=$(( HOST_WAIT - SECONDS < 60 ? HOST_WAIT - SECONDS : 60 ))
  done
fi
if [ "${GITHUB_ACTIONS:-}" != "true" ]; then
  printf '%s (pid %s, since %s, %s file(s) at once)\n' "$REPO_ROOT" "$$" "$(date +%H:%M)" "$JOBS" > "$HOST_LOCK.holder" 2>/dev/null || true
fi

PYTHON=python3
command -v python3 >/dev/null 2>&1 || PYTHON=python

# Several at once: start the long files first, so the last one to end is not
# a long file that waited its turn behind short ones.
if [ "$JOBS" -gt 1 ]; then
  mapfile -t files < <(printf '%s\n' "${files[@]}" | by_weight | cut -d' ' -f2-)
fi

RESULTS=$(mktemp -d)
trap 'rm -rf -- "$RESULTS"' EXIT

# --- the blindfold: a long test never sees the real areas -------------------
# A change to an area skips the long tests, so none of them may depend on
# one. Each long test therefore runs in its own mount namespace (bwrap) where
# every area is replaced by a private copy with the same content, and the
# copy is read afterwards: an entry whose access time moved was opened or
# listed by that test or by something it started, and the test fails.
# The copies are on a tmpfs that exists only in that namespace, and the test
# reaches them only through the paths of the areas: a process elsewhere on
# the host that walks the temporary directory (seen on the first battery: it
# listed the copies of four tests at once) cannot be mistaken for the test,
# nor can the test walking the temporary directory itself.
# What this does not see: a path that was only tested for existence (stat),
# never opened, and content read through Git objects.
BLIND_PATHS=()  # what exists of the areas
for area in "${AREAS[@]}"; do
  case "$area" in
    */) [ -d "$area" ] && BLIND_PATHS+=("${area%/}") ;;
    *) for p in $area; do [ -e "$p" ] && BLIND_PATHS+=("$p"); done ;;
  esac
done

blindfolded() {  # reached-file command... -> runs command blind to the areas
  local copies status reached=$1
  shift
  copies=$(mktemp -d)
  bwrap --dev-bind / / --die-with-parent --tmpfs "$copies" -- \
    bash "$SELF" --blindfolded "$copies" "$reached" "${BLIND_PATHS[@]}" -- "$@"
  status=$?
  rmdir -- "$copies"
  return "$status"
}

blindfold_works() {  # the namespaces start, and what reads an area is seen
  local reached=$RESULTS/blindfold-probe
  # shellcheck disable=SC2016  # $1 belongs to the inner shell
  blindfolded "$reached" bash -c 'cat "$1" >/dev/null 2>&1 || ls "$1" >/dev/null' - "${BLIND_PATHS[0]}" >/dev/null 2>&1 || return 1
  [ -s "$reached" ]
}

blindfold=0
if [ "${#BLIND_PATHS[@]}" -gt 0 ]; then
  for f in "${files[@]}"; do
    is_long "$f" && { blindfold=1; break; }
  done
fi
if [ "$blindfold" -eq 1 ] && ! blindfold_works; then
  echo "ci-run-tests: the long tests must run without sight of the areas of $AREAS_FILE, and that cannot be set up here: it needs bwrap (package bubblewrap, allowed to create a user namespace inside another) and a tmpfs that records access times." >&2
  exit 2
fi

run_one() {  # index file -> prints its result line, leaves $RESULTS/<index>.failed on failure
  local index=$1 f=$2 interp out status runtime_dir started=$SECONDS
  local reached="" wrap=()
  case "$f" in
    *.py) interp=$PYTHON ;;
    *.sh) interp=bash ;;
  esac
  if [ "$blindfold" -eq 1 ] && is_long "$f"; then
    reached=$RESULTS/$index.reached
    wrap=(blindfolded "$reached")
  fi
  # Each test gets a throwaway XDG_RUNTIME_DIR, so bin/escalation-door's
  # default lock can never be the host's own -- and a test that still
  # reaches that default instead of setting ESCALATION_DOOR_LOCK_FILE fails
  # here, because run by hand it would wait on (or hold) the live Factory's
  # lock (af-wnj692).
  runtime_dir=$(mktemp -d)
  out=$(unset ESCALATION_DOOR_LOCK_FILE; XDG_RUNTIME_DIR="$runtime_dir" "${wrap[@]}" "$interp" "$f" 2>&1)
  status=$?
  if [ -e "$runtime_dir/agent-factory-escalation-door.lock" ]; then
    status=1
    out+=$'\n'"ci-run-tests: $f reached bin/escalation-door's default lock file -- set ESCALATION_DOOR_LOCK_FILE to a path the test owns (tests/lib/sandbox.sh does)"
  fi
  rm -rf -- "$runtime_dir"
  if [ -n "$reached" ]; then
    if [ ! -e "$reached" ]; then
      status=1
      out+=$'\n'"ci-run-tests: $f is a long test and what it read of the areas of $AREAS_FILE could not be established: the blindfold did not end."
    elif [ -s "$reached" ]; then
      status=1
      out+=$'\n'"ci-run-tests: $f is a long test and read an area of $AREAS_FILE. A change to that area does not run this test, so it must not depend on it: remove the dependency, take the area out of the list, or keep this test in every run with a '# ci: every-run — <reason>' line. Read:"$'\n'"$(cat "$reached")"
    fi
  fi
  # One file's result is written whole, never mixed with another's.
  {
    flock 9
    if [ "$status" -eq 0 ]; then
      printf '  %-70s OK   %4ss\n' "$f" "$((SECONDS - started))"
    else
      printf '  %-70s FAIL %4ss\n' "$f" "$((SECONDS - started))"
      printf '%s\n' "$out" | sed 's/^/    /'
      : > "$RESULTS/$index.failed"
    fi
  } 9>"$RESULTS/print.lock"
}

running=0
for index in "${!files[@]}"; do
  if [ "$running" -ge "$JOBS" ]; then
    wait -n
    running=$((running - 1))
  fi
  run_one "$index" "${files[$index]}" &
  running=$((running + 1))
done
wait

failed=()
for index in "${!files[@]}"; do
  [ -e "$RESULTS/$index.failed" ] && failed+=("${files[$index]}")
done

echo
echo "ci-run-tests: ran ${#files[@]} test(s), ${#failed[@]} failure(s)"
if [ "${#failed[@]}" -gt 0 ]; then
  printf 'FAILED: %s\n' "${failed[@]}"
  exit 1
fi
exit 0
