#!/usr/bin/env python3
"""Create one immutable revised graph draft for an authorized replacement of a stopped ticket, or of a
ticket parked by its own Planning Exception once the operator answered it. It reads the convoy's
resulting graph: the ticket may come from an earlier revision still in force (docs/PLANNING_EXCEPTION.md)."""
from __future__ import annotations

import argparse
import copy
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from convoy_state import operator_answer  # noqa: E402

NEW_FLOW = "new-flow/v1"
SHA = re.compile(r"^[0-9a-f]{40}$")


class Refusal(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise Refusal("refused: " + message + "; nothing written")


def digest(text: str) -> str:
    return "sha256:" + hashlib.sha256(text.encode()).hexdigest()


def canonical(value: Any) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def bd(*args: str, stdin: str | None = None) -> str:
    proc = subprocess.run([os.environ.get("BD_BIN") or "bd", *args], input=stdin,
                          capture_output=True, text=True)
    if proc.returncode:
        raise Refusal((proc.stderr or proc.stdout or f"bd exited {proc.returncode}").strip())
    return proc.stdout.strip()


def show(identifier: str) -> dict[str, Any]:
    try:
        value = json.loads(bd("show", identifier, "--json"))
        value = value[0] if isinstance(value, list) and value else value
    except (json.JSONDecodeError, IndexError) as exc:
        raise Refusal(f"cannot read bead {identifier}") from exc
    require(isinstance(value, dict) and value.get("id") == identifier, f"unknown bead {identifier}")
    return value


def comments(identifier: str) -> Any:
    try:
        return json.loads(bd("comments", identifier, "--json"))
    except json.JSONDecodeError as exc:
        raise Refusal(f"cannot read comments of decision {identifier}") from exc


def strings(value: Any):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for child in value.values():
            yield from strings(child)
    elif isinstance(value, list):
        for child in value:
            yield from strings(child)


def metadata(bead: dict[str, Any]) -> dict[str, Any]:
    value = bead.get("metadata") or {}
    require(isinstance(value, dict), f"{bead['id']} has malformed metadata")
    return value


def encoded(meta: dict[str, Any], key: str, owner: str) -> dict[str, Any]:
    try:
        value = json.loads(str(meta.get(key) or ""))
    except json.JSONDecodeError as exc:
        raise Refusal(f"{owner} has malformed {key}") from exc
    require(isinstance(value, dict), f"{owner} has malformed {key}")
    return value


def parsed_draft(bead: dict[str, Any]) -> dict[str, Any]:
    try:
        value = yaml.safe_load(str(bead.get("description") or ""))
    except yaml.YAMLError as exc:
        raise Refusal(f"source draft {bead['id']} is not valid YAML") from exc
    require(isinstance(value, dict), f"source draft {bead['id']} is not an object")
    require(value.get("flow_contract") == NEW_FLOW, f"source draft {bead['id']} is not {NEW_FLOW}")
    require(isinstance(value.get("tickets"), list), f"source draft {bead['id']} has no tickets")
    return value


def replaceable(meta: dict[str, Any], ticket: str) -> str:
    """Why the ticket may be replaced: its active stop, or the parking its own
    Planning Exception caused, once the operator answered that request
    (bin/escalation-door repondre) after it was parked. Read only."""
    if "gc.flow.stop" in meta:
        stop = encoded(meta, "gc.flow.stop", ticket)
        require(str(stop.get("reason") or "").strip(), f"{ticket} has no active stop reason")
        return f"stop {stop['reason']}"
    require("gc.flow.park" in meta, f"{ticket} has no active stop reason")
    park = encoded(meta, "gc.flow.park", ticket)
    since = str(park.get("at") or "")
    answer = operator_answer(meta, since) if since else None
    require(park.get("cause") == "planning_exception" and park.get("origin") == ticket and answer is not None,
            f"{ticket} has no active stop reason and no answered Planning Exception parking (its own, "
            "answered through bin/escalation-door repondre after it was parked)")
    return f"parked by its own Planning Exception, answered {answer['option']} at {answer['at']}"


REVISION_KEYS = {"scope", "acceptance_criteria", "demonstration_line", "what_it_delivers",
                 "drop_establishes_launch_recipe"}
CRITERION_FIELDS = ("entry_point", "observable", "false_if")


def text(value: Any) -> bool:
    return isinstance(value, str) and bool(value.strip())


def revision(path: str) -> dict[str, Any]:
    """The bounded, owner-approved revision of the stopped ticket a replacement may carry."""
    try:
        with open(path, encoding="utf-8") as handle:
            value = json.load(handle)
    except (OSError, ValueError) as exc:
        raise Refusal(f"refused: revision file {path} is not readable JSON; nothing written") from exc
    require(isinstance(value, dict) and value, "revision must be a non-empty JSON object")
    require(not set(value) - REVISION_KEYS,
            f"revision carries unknown keys {sorted(set(value) - REVISION_KEYS)} (allowed: {sorted(REVISION_KEYS)})")
    if "scope" in value:
        scope = value["scope"]
        require(isinstance(scope, dict) and set(scope) == {"paths"} and isinstance(scope["paths"], list)
                and scope["paths"] and all(text(path) for path in scope["paths"]),
                "revision scope must be {paths: [non-empty strings]}")
    if "acceptance_criteria" in value:
        criteria = value["acceptance_criteria"]
        require(isinstance(criteria, list) and criteria and all(
            isinstance(item, dict) and set(item) == set(CRITERION_FIELDS) and all(text(item[f]) for f in CRITERION_FIELDS)
            for item in criteria), "revision acceptance_criteria must be a non-empty list of "
            "{entry_point, observable, false_if} non-empty strings")
    for key in ("demonstration_line", "what_it_delivers"):
        require(key not in value or text(value[key]), f"revision {key} must be a non-empty string")
    require(value.get("drop_establishes_launch_recipe", True) is True,
            "revision drop_establishes_launch_recipe must be true")
    return value


def create(args: argparse.Namespace) -> dict[str, Any]:
    revised = revision(args.revision_file) if args.revision_file else None
    decision = show(args.decision)
    evidence = args.evidence.strip()
    require(evidence and any(evidence in text for text in strings(comments(args.decision))),
            f"decision {args.decision} does not carry the exact authorization evidence")

    stopped, convoy, source, spec = show(args.stopped_ticket), show(args.convoy), show(args.source_draft), None
    stopped_meta, convoy_meta, source_meta = metadata(stopped), metadata(convoy), metadata(source)
    require(stopped.get("status") != "closed", f"stopped ticket {args.stopped_ticket} is already closed")
    require(stopped_meta.get("gc.ticket_kind") == "vertical_slice",
            f"{args.stopped_ticket} is not a vertical_slice")
    source_state = replaceable(stopped_meta, args.stopped_ticket)
    require(convoy_meta.get("gc.flow.mark") == NEW_FLOW, f"convoy {args.convoy} is not {NEW_FLOW}")

    source_text = str(source.get("description") or "")
    graph_digest = digest(source_text)
    require(source_meta.get("approved_digest") == graph_digest,
            f"source draft {args.source_draft} changed after approval")
    # The convoy's resulting graph (af-k08bi1): what it tracks after every
    # revision, as bd-patch reads it. The source draft is the one that
    # published the stopped ticket, possibly an earlier revision still in force.
    current_digest = str(convoy_meta.get("gc.graph_digest") or "")
    require(current_digest, f"convoy {args.convoy} carries no graph digest")
    tracked = {str(dep.get("id")): dep for dep in convoy.get("dependencies") or []
               if isinstance(dep, dict) and dep.get("dependency_type") == "tracks"}
    require(args.stopped_ticket in tracked,
            f"convoy {args.convoy} does not track stopped ticket {args.stopped_ticket}")
    require(stopped_meta.get("gc.graph_digest") == graph_digest,
            f"stopped ticket {args.stopped_ticket} was not published by source draft {args.source_draft}")

    spec_id = str(convoy_meta.get("gc.spec_id") or "")
    require(spec_id and spec_id == source_meta.get("spec_id") == stopped_meta.get("gc.spec_id"),
            "source draft, stopped ticket and convoy do not cite the same Spec")
    spec = show(spec_id)
    spec_meta = metadata(spec)
    spec_digest = digest(str(spec.get("description") or ""))
    require(spec_meta.get("spec_state") == "APPROVED_SPEC" and spec_meta.get("approved_digest") == spec_digest,
            f"Spec {spec_id} is not approved at its current digest")
    require(convoy_meta.get("gc.spec_digest") == spec_digest == stopped_meta.get("gc.spec_digest"),
            "stopped ticket and convoy do not cite the approved Spec digest")
    project = str(convoy_meta.get("gc.project_id") or "")
    require(project and project == source_meta.get("gc.project_id") == spec_meta.get("gc.project_id"),
            "source draft, Spec and convoy do not cite the same project")
    require(args.approved_by == source_meta.get("approved_by"),
            "replacement approver differs from the approved source draft approver")

    handoff = encoded(stopped_meta, "gc.flow.handoff", args.stopped_ticket)
    require(SHA.fullmatch(args.useful_commit) is not None and handoff.get("commit") == args.useful_commit,
            f"useful commit is not the stopped ticket handoff commit")
    criteria_record = encoded(stopped_meta, "gc.flow.criteria", args.stopped_ticket)
    require(criteria_record.get("graph_digest") == graph_digest,
            f"stopped ticket criteria were not frozen for this graph")

    old_key = str(stopped_meta.get("gc.ticket_id") or "")
    require(old_key and args.replacement_id != old_key, "replacement id must be new")
    draft = copy.deepcopy(parsed_draft(source))
    tickets = draft["tickets"]
    originals = [ticket for ticket in tickets if isinstance(ticket, dict) and ticket.get("id") == old_key]
    require(len(originals) == 1, f"source draft does not contain exactly one {old_key}")
    require(not any(isinstance(ticket, dict) and ticket.get("id") == args.replacement_id for ticket in tickets),
            f"source draft already contains {args.replacement_id}")
    graph = {str((dep.get("metadata") or {}).get("gc.ticket_id") or ""): dep for dep in tracked.values()}
    require(args.replacement_id not in graph, f"convoy {args.convoy} already tracks {args.replacement_id}")
    waiters = {key for key, dep in graph.items() if dep.get("status") != "closed"
               and old_key in str((dep.get("metadata") or {}).get("gc.blocked_by") or "").split(",")}
    for key in sorted(waiters):
        require((graph[key].get("metadata") or {}).get("gc.graph_digest") == graph_digest
                and sum(isinstance(t, dict) and t.get("id") == key for t in tickets) == 1,
                f"{key} waits for {old_key} and was not published by source draft {args.source_draft}")
    original = originals[0]
    require(original.get("kind") == "vertical_slice", f"source ticket {old_key} is not a vertical_slice")
    criteria = copy.deepcopy(original.get("acceptance_criteria"))
    require(isinstance(criteria, list) and criteria, f"source ticket {old_key} has no acceptance criteria")
    scope = copy.deepcopy(original.get("scope"))
    scope_paths = scope.get("paths") if isinstance(scope, dict) else []
    require(scope is None or isinstance(scope_paths, list), f"source ticket {old_key} has malformed scope")

    replacement = copy.deepcopy(original)
    replacement["id"] = args.replacement_id
    replacement["title"] = f"{original.get('title', old_key)} — replacement of {old_key}"
    criteria_digest = digest(canonical(criteria))
    scope_digest = digest("\n".join(str(path) for path in scope_paths))
    revised_note, revised_meta = "", {}
    if revised is not None:
        for key in ("scope", "acceptance_criteria", "demonstration_line", "what_it_delivers"):
            if key in revised:
                replacement[key] = copy.deepcopy(revised[key])
        if revised.get("drop_establishes_launch_recipe"):
            replacement.pop("establishes_launch_recipe", None)
        revised_paths = (replacement.get("scope") or {}).get("paths") or []
        revised_meta = {
            "replacement_revised_criteria_digest": digest(canonical(replacement["acceptance_criteria"])),
            "replacement_revised_scope_digest": digest("\n".join(str(path) for path in revised_paths)),
        }
        revised_note = (f"; revised criteria {revised_meta['replacement_revised_criteria_digest']} "
                        f"scope {revised_meta['replacement_revised_scope_digest']}")
    citation = (f" Authorized replacement: decision {args.decision}; stopped ticket {args.stopped_ticket} ({old_key}, {source_state}); "
                f"convoy {args.convoy}; Spec {spec_id} at {spec_digest}; criteria {criteria_digest}; "
                f"scope {scope_digest}{revised_note}; useful commit {args.useful_commit}. The replaced ticket, its stop or parking, "
                "evidence, refusals and counters remain untouched.")
    replacement["what_it_delivers"] = str(replacement.get("what_it_delivers") or "").rstrip() + citation
    # A partial revision, as bd-patch applies it: the replacement and the open
    # tickets that wait for the replaced one; the rest of the graph stays as published.
    draft["tickets"] = [replacement] + [ticket for ticket in tickets
                                        if isinstance(ticket, dict) and ticket.get("id") in waiters]
    drafted = {args.replacement_id, *waiters}
    for ticket in draft["tickets"]:
        if isinstance(ticket, dict) and isinstance(ticket.get("blocked_by"), list):
            blockers = [args.replacement_id if item == old_key else item for item in ticket["blocked_by"]]
            # bd-patch accepts only blockers the draft carries, and keeps the
            # delivered ones on the tickets it patches: drop those, refuse open ones.
            outside = [item for item in blockers if item not in drafted
                       and (graph.get(str(item)) or {}).get("status") != "closed"]
            require(not outside, f"{ticket.get('id')} waits for {', '.join(map(str, outside))}, "
                                 "open and outside the replacement revision")
            ticket["blocked_by"] = [item for item in blockers if item in drafted]
    withdrawn = draft.get("withdrawn") or []
    require(isinstance(withdrawn, list) and not any(isinstance(item, dict) and item.get("ticket") == old_key
                                                    for item in withdrawn),
            f"source draft already withdraws {old_key}")
    draft["withdrawn"] = [{"ticket": old_key, "planning_exception": args.planning_exception}]
    body = yaml.safe_dump(draft, allow_unicode=True, sort_keys=False)
    body_digest = digest(body)
    identifier = "af-r" + hashlib.sha256((args.decision + "\0" + args.stopped_ticket + "\0" +
                                             args.replacement_id + "\0" + body_digest).encode()).hexdigest()[:8]
    draft_meta = {
        "gc.plane": "planning", "gc.project_id": project, "spec_id": spec_id,
        "revises_digest": current_digest, "approved_by": args.approved_by,
        "approved_evidence": f"{args.decision}: {evidence}", "approved_digest": body_digest,
        "replacement_decision": args.decision, "replacement_of": args.stopped_ticket,
        "replacement_convoy": args.convoy, "replacement_commit": args.useful_commit,
        "replacement_criteria_digest": str(criteria_record.get("digest") or criteria_digest),
        "replacement_scope_digest": scope_digest, "replacement_author_session": args.author_session,
        **revised_meta,
    }
    created = bd("create", "--id", identifier, "--title", f"Replacement {args.replacement_id} for {old_key}",
                 "--type", "task", "--labels", "ticket-graph-draft", "--metadata", canonical(draft_meta),
                 "--body-file", "-", "--silent", stdin=body)
    require(created == identifier, f"tracker returned unexpected draft id {created!r}")
    return {"ok": True, "draft": identifier, "digest": body_digest, "replacement": args.replacement_id,
            "replaces": args.stopped_ticket, "convoy": args.convoy, "spec": spec_id}


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(prog="replacement-draft")
    sub = value.add_subparsers(dest="command", required=True)
    create_parser = sub.add_parser("create")
    for name in ("decision", "evidence", "stopped-ticket", "convoy", "source-draft", "replacement-id",
                 "useful-commit", "planning-exception", "approved-by", "author-session"):
        create_parser.add_argument("--" + name, required=True)
    create_parser.add_argument("--revision-file")
    return value


def main(argv=None) -> int:
    try:
        args = parser().parse_args(argv)
        print(json.dumps(create(args), ensure_ascii=False, sort_keys=True))
        return 0
    except Refusal as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False, sort_keys=True))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
