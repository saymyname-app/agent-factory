#!/usr/bin/env python3
"""Compare reversible Planning Run allocations at the convoy boundary."""

from __future__ import annotations

import argparse
import copy
import hashlib
import json
import sys
from pathlib import Path
from typing import Any


PROGRAM = "planning-allocation-prototype"
CONTRACT = "agent-factory-planning-allocation-prototype/v1"
RESULT_CONTRACT = "agent-factory-planning-allocation-result/v1"
ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MANIFEST = ROOT / "config" / "planning-allocation-prototype.json"
ALLOCATION_KINDS = (
    "skills",
    "session_templates",
    "agents",
    "formulas",
    "orders",
    "deterministic_code",
)
SITE_ALLOCATIONS = {
    "session_template": "session_templates",
    "agent": "agents",
    "formula": "formulas",
    "order": "orders",
    "deterministic_code": "deterministic_code",
}
REQUIRED_EXECUTION_SITES = {
    "human_conversation",
    "specialist_work",
    "phase_sequencing",
    "eligibility_triggers",
    "validation",
}


class PrototypeError(RuntimeError):
    pass


def require_dict(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise PrototypeError(f"{label} must be an object")
    return value


def require_list(value: Any, label: str) -> list[Any]:
    if not isinstance(value, list):
        raise PrototypeError(f"{label} must be an array")
    return value


def require_string(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise PrototypeError(f"{label} must be a non-empty string")
    return value


def string_list(value: Any, label: str, *, allow_empty: bool = False) -> list[str]:
    items = require_list(value, label)
    if not allow_empty and not items:
        raise PrototypeError(f"{label} must not be empty")
    if any(not isinstance(item, str) or not item.strip() for item in items):
        raise PrototypeError(f"{label} must contain only non-empty strings")
    if len(set(items)) != len(items):
        raise PrototypeError(f"{label} must not contain duplicates")
    return items


def canonical_digest(value: Any) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def load_manifest(path: Path) -> dict[str, Any]:
    try:
        return require_dict(json.loads(path.read_text(encoding="utf-8")), "manifest")
    except OSError as exc:
        raise PrototypeError(f"cannot read manifest {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise PrototypeError(f"manifest is not valid JSON: {exc}") from exc


def allocation(candidate: dict[str, Any]) -> dict[str, list[str]]:
    raw = require_dict(candidate.get("allocation"), f"candidate {candidate.get('id')} allocation")
    return {
        kind: string_list(raw.get(kind), f"candidate {candidate.get('id')} allocation.{kind}")
        for kind in ALLOCATION_KINDS
    }


def first_site(candidate: dict[str, Any], concern: str) -> dict[str, Any]:
    site = require_dict(
        require_dict(candidate["execution_sites"], "execution_sites").get(concern),
        f"execution_sites.{concern}",
    )
    sites = string_list(site.get("sites"), f"execution_sites.{concern}.sites")
    result = {
        "site_type": require_string(site.get("site_type"), f"execution_sites.{concern}.site_type"),
        "site": sites[0],
    }
    if "owner" in site:
        result["owner"] = require_string(site["owner"], f"execution_sites.{concern}.owner")
    if "mechanism" in site:
        result["mechanism"] = require_string(
            site["mechanism"], f"execution_sites.{concern}.mechanism"
        )
    return result


def sequence_site(candidate: dict[str, Any], kind: str) -> str:
    sites = candidate["execution_sites"]["phase_sequencing"]["sites"]
    marker = "simple" if kind == "simple" else "wayfinding"
    return next((site for site in sites if marker in site), sites[0])


def make_event(
    event_id: str,
    needs: list[str],
    effect: str,
    execution: dict[str, Any],
    sequenced_by: str,
    eligible_by: dict[str, Any],
    skill: str | None = None,
) -> dict[str, Any]:
    event = {
        "id": event_id,
        "needs": needs,
        "effect": effect,
        "execution": execution,
        "sequenced_by": sequenced_by,
        "eligible_by": {
            "site_type": eligible_by["site_type"],
            "site": eligible_by["site"],
        },
    }
    if skill is not None:
        event["skill"] = skill
    return event


def scenario_events(candidate: dict[str, Any], kind: str) -> list[dict[str, Any]]:
    allocation_map = candidate["allocation"]
    conversation = first_site(candidate, "human_conversation")
    specialist = first_site(candidate, "specialist_work")
    eligibility = first_site(candidate, "eligibility_triggers")
    validation = first_site(candidate, "validation")
    writer = candidate["canonical_writer_binding"]
    sequenced_by = sequence_site(candidate, kind)
    run_trigger = candidate["run_trigger"]
    writer_execution = {
        "site_type": "session_template",
        "site": writer["session_template"],
        "owner": writer["agent"],
    }
    door_execution = {
        "site_type": "deterministic_code",
        "site": "planning-run-door",
    }
    artifact_execution = {
        "site_type": "deterministic_code",
        "site": "planning-artifact-door",
    }
    validation_execution = {
        "site_type": validation["site_type"],
        "site": "planning-validation-door",
    }
    events = [
        make_event(
            "run-requested",
            [],
            "wake_planning_run",
            {"site_type": "order", "site": run_trigger},
            sequenced_by,
            eligibility,
        ),
        make_event(
            "create-run",
            ["run-requested"],
            "create_planning_run_identity",
            door_execution,
            sequenced_by,
            eligibility,
        ),
    ]
    if kind == "simple":
        events.extend(
            [
                make_event(
                    "shared-understanding",
                    ["create-run"],
                    "human_conversation",
                    conversation,
                    sequenced_by,
                    eligibility,
                    "grill-with-docs",
                ),
                make_event(
                    "write-spec",
                    ["shared-understanding"],
                    "write_canonical_artifact",
                    writer_execution,
                    sequenced_by,
                    eligibility,
                    "to-spec",
                ),
            ]
        )
    elif kind == "wayfinding":
        events.extend(
            [
                make_event(
                    "chart-wayfinding",
                    ["create-run"],
                    "human_conversation",
                    conversation,
                    sequenced_by,
                    eligibility,
                    "grill-with-docs",
                ),
                make_event(
                    "create-decision-frontier",
                    ["chart-wayfinding"],
                    "create_planning_decisions",
                    door_execution,
                    sequenced_by,
                    eligibility,
                ),
                make_event(
                    "resolve-research-decision",
                    ["create-decision-frontier"],
                    "specialist_work",
                    specialist,
                    sequenced_by,
                    eligibility,
                    "grill-with-docs",
                ),
                make_event(
                    "resolve-prototype-decision",
                    ["create-decision-frontier"],
                    "specialist_work",
                    specialist,
                    sequenced_by,
                    eligibility,
                    "grill-with-docs",
                ),
                make_event(
                    "frontier-clear",
                    ["resolve-research-decision", "resolve-prototype-decision"],
                    "validate_wayfinding_clear",
                    validation_execution,
                    sequenced_by,
                    eligibility,
                ),
                make_event(
                    "write-spec",
                    ["frontier-clear"],
                    "write_canonical_artifact",
                    writer_execution,
                    sequenced_by,
                    eligibility,
                    "to-spec",
                ),
            ]
        )
    else:
        raise PrototypeError(f"unknown scenario kind: {kind}")
    events.extend(
        [
            make_event(
                "validate-spec",
                ["write-spec"],
                "validate_artifact",
                artifact_execution,
                sequenced_by,
                eligibility,
            ),
            make_event(
                "approve-spec",
                ["validate-spec"],
                "human_approval",
                conversation,
                sequenced_by,
                eligibility,
            ),
            make_event(
                "write-ticket-graph-draft",
                ["approve-spec"],
                "write_canonical_artifact",
                writer_execution,
                sequenced_by,
                eligibility,
                "to-tickets",
            ),
            make_event(
                "validate-draft",
                ["write-ticket-graph-draft"],
                "validate_ticket_graph",
                validation_execution,
                sequenced_by,
                eligibility,
            ),
            make_event(
                "publish-convoy",
                ["validate-draft"],
                "publish_convoy_atomically",
                {"site_type": "deterministic_code", "site": "ticket-graph-publish"},
                sequenced_by,
                eligibility,
            ),
            make_event(
                "convoy-continuation",
                ["publish-convoy"],
                "expose_convoy_continuation",
                {
                    "site_type": "delivery_authority",
                    "site": candidate["delivery_authorities"][0],
                },
                sequenced_by,
                eligibility,
            ),
        ]
    )
    allocated_code = set(allocation_map["deterministic_code"])
    used_code = {
        event["execution"]["site"]
        for event in events
        if event["execution"]["site_type"] == "deterministic_code"
    }
    if not used_code.issubset(allocated_code):
        raise PrototypeError(
            f"candidate {candidate['id']} scenario uses unallocated deterministic code"
        )
    used_skills = {event["skill"] for event in events if "skill" in event}
    if not used_skills.issubset(set(allocation_map["skills"])):
        raise PrototypeError(f"candidate {candidate['id']} scenario uses an unallocated skill")
    return events


def execute_events(
    events: list[dict[str, Any]],
    *,
    initial_completed: set[str] | None = None,
    stop_after: str | None = None,
) -> tuple[list[dict[str, Any]], set[str]]:
    completed = set(initial_completed or set())
    pending = [copy.deepcopy(event) for event in events]
    executed: list[dict[str, Any]] = []
    while pending:
        ready_index = next(
            (
                index
                for index, event in enumerate(pending)
                if set(event["needs"]).issubset(completed)
            ),
            None,
        )
        if ready_index is None:
            unresolved = ", ".join(event["id"] for event in pending)
            raise PrototypeError(f"scenario graph is cyclic or has missing needs: {unresolved}")
        event = pending.pop(ready_index)
        executed.append(event)
        completed.add(event["id"])
        if event["id"] == stop_after:
            break
    return executed, completed


def run_scenario(candidate: dict[str, Any], kind: str) -> dict[str, Any]:
    events, _ = execute_events(scenario_events(candidate, kind))
    run_id = f"planning-run-{kind}-fixture"
    writer_actors = sorted(
        {
            event["execution"].get("owner")
            for event in events
            if event["effect"] == "write_canonical_artifact"
        }
    )
    convoy_id = "convoy-" + hashlib.sha256(run_id.encode("utf-8")).hexdigest()[:12]
    return {
        "kind": kind,
        "planning_run_id": run_id,
        "planning_map_id": None if kind == "simple" else f"map-{run_id}",
        "canonical_writer_actors": writer_actors,
        "delivery_authority": candidate["delivery_authorities"][0],
        "events": events,
        "skills_exercised": sorted(
            {event["skill"] for event in events if "skill" in event}
        ),
        "final_state": "CONVOY_CONTINUATION_READY",
        "boundary": "convoy-continuation",
        "convoy_id": convoy_id,
    }


def maintenance_cost(candidate: dict[str, Any]) -> dict[str, Any]:
    counts = {kind: len(candidate["allocation"][kind]) for kind in ALLOCATION_KINDS}
    return {
        "by_kind": counts,
        "configuration_units": sum(counts.values()),
    }


def method_fidelity(candidate: dict[str, Any], runs: list[dict[str, Any]]) -> dict[str, bool]:
    formulas = candidate["allocation"]["formulas"]
    writer_sets = [run["canonical_writer_actors"] for run in runs]
    return {
        "single_planning_run_identity": all(
            sum(event["effect"] == "create_planning_run_identity" for event in run["events"])
            == 1
            for run in runs
        ),
        "single_canonical_writer": all(len(writers) == 1 for writers in writer_sets),
        "all_allocated_skills_exercised": all(
            set(run["skills_exercised"]) == set(candidate["allocation"]["skills"])
            for run in runs
        ),
        "single_mayor_delivery_authority": candidate["delivery_authorities"] == ["mayor"],
        "human_conversation_located": bool(
            candidate["execution_sites"]["human_conversation"]["sites"]
        ),
        "specialist_work_located": bool(
            candidate["execution_sites"]["specialist_work"]["sites"]
        ),
        "phase_sequence_owned_by_gas_city": (
            candidate["coordination_authority"] == "gas-city-formula-runtime"
            and candidate["execution_sites"]["phase_sequencing"]["site_type"] == "formula"
        ),
        "eligibility_is_graph_native_or_deterministic": candidate["execution_sites"]
        ["eligibility_triggers"]["site_type"]
        in {"formula", "order", "deterministic_code"},
        "validation_is_deterministic": candidate["execution_sites"]["validation"]
        ["site_type"]
        == "deterministic_code",
        "no_planning_base_projection": "planning-base" not in formulas,
        "no_second_orchestrator": (
            candidate["coordination_authority"] == "gas-city-formula-runtime"
            and not any("orchestrator" in agent for agent in candidate["allocation"]["agents"])
        ),
        "convoy_boundary_reached": all(
            run["final_state"] == "CONVOY_CONTINUATION_READY"
            and run["boundary"] == "convoy-continuation"
            for run in runs
        ),
    }


def failure_probes(candidate: dict[str, Any]) -> dict[str, Any]:
    events = scenario_events(candidate, "wayfinding")
    writer_index = next(index for index, event in enumerate(events) if event["id"] == "write-spec")
    draft_validation_index = next(
        index for index, event in enumerate(events) if event["id"] == "validate-draft"
    )
    return {
        "canonical_writer_unavailable": {
            "state": "WRITER_RETRYABLE",
            "completed_events": [event["id"] for event in events[:writer_index]],
            "convoy_id": None,
            "published_nodes": [],
            "recovery": "retry the same canonical-writer binding or use the bounded reversal",
        },
        "draft_validation_failure": {
            "state": "TICKET_GRAPH_DRAFT_INVALID",
            "completed_events": [event["id"] for event in events[:draft_validation_index]],
            "failed_event": "validate-draft",
            "convoy_id": None,
            "published_nodes": [],
            "recovery": "return to the sole canonical writer; the publication door remains unopened",
        },
    }


def validate_candidate(
    candidate: dict[str, Any], required_skills: list[str], required_code: list[str]
) -> None:
    candidate_id = require_string(candidate.get("id"), "candidate.id")
    require_string(candidate.get("label"), f"candidate {candidate_id} label")
    if candidate.get("coordination_authority") != "gas-city-formula-runtime":
        raise PrototypeError(
            f"candidate {candidate_id} must leave phase coordination with Gas City"
        )
    authorities = string_list(
        candidate.get("delivery_authorities"),
        f"candidate {candidate_id} delivery_authorities",
    )
    if authorities != ["mayor"]:
        raise PrototypeError(f"candidate {candidate_id} must have exactly one delivery authority: mayor")
    allocation_map = allocation(candidate)
    candidate["allocation"] = allocation_map
    if set(required_skills) - set(allocation_map["skills"]):
        raise PrototypeError(f"candidate {candidate_id} is missing required planning skills")
    if set(required_code) - set(allocation_map["deterministic_code"]):
        raise PrototypeError(f"candidate {candidate_id} is missing required deterministic doors")
    if "planning-base" in allocation_map["formulas"]:
        raise PrototypeError(f"candidate {candidate_id}: planning-base is forbidden")
    if any("orchestrator" in agent for agent in allocation_map["agents"]):
        raise PrototypeError(f"candidate {candidate_id} introduces a second orchestrator")
    run_trigger = require_string(candidate.get("run_trigger"), f"candidate {candidate_id} run_trigger")
    if run_trigger not in allocation_map["orders"]:
        raise PrototypeError(f"candidate {candidate_id} run trigger is not allocated as an order")

    sites = require_dict(candidate.get("execution_sites"), f"candidate {candidate_id} execution_sites")
    if set(sites) != REQUIRED_EXECUTION_SITES:
        raise PrototypeError(
            f"candidate {candidate_id} execution_sites must be exactly "
            + ", ".join(sorted(REQUIRED_EXECUTION_SITES))
        )
    for concern, raw_site in sites.items():
        site = require_dict(raw_site, f"candidate {candidate_id} execution_sites.{concern}")
        site_type = require_string(
            site.get("site_type"), f"candidate {candidate_id} execution_sites.{concern}.site_type"
        )
        if site_type not in SITE_ALLOCATIONS:
            raise PrototypeError(f"candidate {candidate_id} has unknown site type {site_type}")
        names = string_list(
            site.get("sites"), f"candidate {candidate_id} execution_sites.{concern}.sites"
        )
        allocated = allocation_map[SITE_ALLOCATIONS[site_type]]
        if set(names) - set(allocated):
            raise PrototypeError(f"candidate {candidate_id} maps {concern} to an unallocated site")
        owner = site.get("owner")
        if owner is not None and owner not in allocation_map["agents"]:
            raise PrototypeError(f"candidate {candidate_id} maps {concern} to an unallocated agent")

    writer = require_dict(
        candidate.get("canonical_writer_binding"),
        f"candidate {candidate_id} canonical_writer_binding",
    )
    if writer.get("session_template") not in allocation_map["session_templates"]:
        raise PrototypeError(f"candidate {candidate_id} writer session is not allocated")
    if writer.get("agent") not in allocation_map["agents"]:
        raise PrototypeError(f"candidate {candidate_id} writer agent is not allocated")

    runs = [run_scenario(candidate, kind) for kind in ("simple", "wayfinding")]
    fidelity = method_fidelity(candidate, runs)
    failed = [name for name, passed in fidelity.items() if not passed]
    if failed:
        raise PrototypeError(
            f"candidate {candidate_id} is not viable: {', '.join(sorted(failed))}"
        )


def validate_manifest(manifest: dict[str, Any]) -> None:
    if manifest.get("contract") != CONTRACT:
        raise PrototypeError(f"manifest contract must be {CONTRACT}")
    spec_trace = require_dict(manifest.get("spec_trace"), "spec_trace")
    require_string(spec_trace.get("id"), "spec_trace.id")
    require_string(spec_trace.get("digest"), "spec_trace.digest")
    if spec_trace.get("ticket") != "P02":
        raise PrototypeError("spec_trace.ticket must be P02")
    if manifest.get("boundary") != "convoy-continuation":
        raise PrototypeError("prototype must stop at the convoy-continuation boundary")
    required_skills = string_list(manifest.get("required_skills"), "required_skills")
    required_code = string_list(
        manifest.get("required_deterministic_code"), "required_deterministic_code"
    )
    candidates = require_list(manifest.get("candidates"), "candidates")
    if len(candidates) < 2:
        raise PrototypeError("at least two candidate allocations are required")
    candidate_objects = [require_dict(candidate, "candidate") for candidate in candidates]
    candidate_ids = [require_string(candidate.get("id"), "candidate.id") for candidate in candidate_objects]
    if len(set(candidate_ids)) != len(candidate_ids):
        raise PrototypeError("candidate ids must be unique")
    for candidate in candidate_objects:
        validate_candidate(candidate, required_skills, required_code)

    selection = require_dict(manifest.get("selection"), "selection")
    selected_id = require_string(selection.get("candidate_id"), "selection.candidate_id")
    if selected_id not in candidate_ids:
        raise PrototypeError("selected candidate does not exist")
    if selection.get("status") != "provisional":
        raise PrototypeError("selection must remain provisional")
    require_string(selection.get("rationale"), "selection.rationale")
    require_string(selection.get("review_point"), "selection.review_point")
    reversal = require_dict(selection.get("bounded_reversal"), "selection.bounded_reversal")
    reversal_id = require_string(
        reversal.get("to_candidate_id"), "selection.bounded_reversal.to_candidate_id"
    )
    if reversal_id not in candidate_ids or reversal_id == selected_id:
        raise PrototypeError("bounded reversal must name a different viable candidate")
    if reversal.get("checkpoint") != "WAYFINDING_CLEAR":
        raise PrototypeError("bounded reversal checkpoint must be WAYFINDING_CLEAR")
    require_string(reversal.get("rule"), "selection.bounded_reversal.rule")

    costs = {
        candidate["id"]: maintenance_cost(candidate)["configuration_units"]
        for candidate in candidate_objects
    }
    minimum = min(costs.values())
    if costs[selected_id] != minimum:
        raise PrototypeError("selected candidate is not the smallest passing allocation")


def candidate_result(candidate: dict[str, Any]) -> dict[str, Any]:
    runs = [run_scenario(candidate, kind) for kind in ("simple", "wayfinding")]
    return {
        "id": candidate["id"],
        "label": candidate["label"],
        "allocation": candidate["allocation"],
        "execution_sites": candidate["execution_sites"],
        "method_fidelity": method_fidelity(candidate, runs),
        "failure_probes": failure_probes(candidate),
        "maintenance_cost": maintenance_cost(candidate),
        "runs": runs,
    }


def bounded_reversal(manifest: dict[str, Any]) -> dict[str, Any]:
    candidates = {candidate["id"]: candidate for candidate in manifest["candidates"]}
    selection = manifest["selection"]
    source = candidates[selection["candidate_id"]]
    target_id = selection["bounded_reversal"]["to_candidate_id"]
    target = candidates[target_id]
    source_events = scenario_events(source, "wayfinding")
    before_events, completed = execute_events(source_events, stop_after="frontier-clear")
    target_events = scenario_events(target, "wayfinding")
    suffix = [
        event
        for event in target_events
        if event["id"] not in completed
    ]
    after_events, _ = execute_events(suffix, initial_completed=completed)
    writer_actors = sorted(
        {
            event["execution"].get("owner")
            for event in after_events
            if event["effect"] == "write_canonical_artifact"
        }
    )
    run_id = "planning-run-wayfinding-fixture"
    durable = {
        "planning_run_id": run_id,
        "planning_map_id": f"map-{run_id}",
        "resolved_decisions": ["decision-prototype", "decision-research"],
    }
    return {
        "from": source["id"],
        "to": target["id"],
        "checkpoint": "WAYFINDING_CLEAR",
        "before": {
            **durable,
            "state": "WAYFINDING_CLEAR",
            "completed_events": [event["id"] for event in before_events],
        },
        "after": {
            **durable,
            "state": "CONVOY_CONTINUATION_READY",
            "completed_events": [event["id"] for event in after_events],
            "canonical_writer_actors": writer_actors,
            "delivery_authority": target["delivery_authorities"][0],
        },
        "changed_bindings": [
            "session_templates",
            "agents",
            "formulas",
            "orders",
        ],
        "unchanged": [
            "Planning Run identity",
            "Planning Map identity",
            "resolved Planning Decisions",
            "Planning Artifact identities",
            "deterministic validation and publication doors",
            "Mayor delivery authority",
        ],
        "rule": selection["bounded_reversal"]["rule"],
    }


def build_result(manifest: dict[str, Any]) -> dict[str, Any]:
    result = {
        "contract": RESULT_CONTRACT,
        "spec_trace": manifest["spec_trace"],
        "target": {
            "boundary": manifest["boundary"],
            "method": "Matt Pocock observable contracts allocated inside one Gas City topology",
        },
        "candidates": [candidate_result(candidate) for candidate in manifest["candidates"]],
        "selection": manifest["selection"],
        "reversal": bounded_reversal(manifest),
        "proof_scope": {
            "configured": "two candidate allocations and one provisional selection",
            "observed": "deterministic simple, Wayfinding, failure and reversal traces",
            "proven": "allocation invariants and fail-closed convoy boundary in this prototype",
            "not_proven": [
                "live provider quality",
                "concurrent Planning Map writes",
                "cross-provider or cross-surface continuity",
                "the future production planning kernel",
            ],
        },
    }
    result["evidence_digest"] = canonical_digest(result)
    return result


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(prog=PROGRAM)
    subcommands = command.add_subparsers(dest="command", required=True)
    for name in ("run", "validate"):
        subcommand = subcommands.add_parser(name)
        subcommand.add_argument(
            "--manifest",
            type=Path,
            default=DEFAULT_MANIFEST,
            help=f"candidate allocation manifest (default: {DEFAULT_MANIFEST})",
        )
    return command


def main() -> int:
    arguments = parser().parse_args()
    try:
        manifest = load_manifest(arguments.manifest)
        validate_manifest(manifest)
        if arguments.command == "validate":
            print(
                json.dumps(
                    {
                        "ok": True,
                        "contract": manifest["contract"],
                        "candidates": [candidate["id"] for candidate in manifest["candidates"]],
                        "selected": manifest["selection"]["candidate_id"],
                    },
                    sort_keys=True,
                )
            )
        else:
            print(json.dumps(build_result(manifest), indent=2, sort_keys=True))
    except PrototypeError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
