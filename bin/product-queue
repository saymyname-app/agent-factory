#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME="product-queue"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
BD_BIN="${BD_BIN:-bd}"
GC_BIN="${GC_BIN:-gc}"
HUMAN_STATE_BIN="${PRODUCT_QUEUE_HUMAN_STATE_BIN:-$SCRIPT_DIR/factory-human-state}"
PRODUCT="${PRODUCT_QUEUE_PRODUCT:-}"
DEFAULT_GOAL="${PRODUCT_QUEUE_DEFAULT_GOAL:-none}"

die() {
  printf '%s: ERROR: %s\n' "$PROGRAM_NAME" "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: PRODUCT_QUEUE_PRODUCT=<slug> product-queue <command> [arguments]

Commands:
  list [--json]                              Show the ordered active candidate queue.
  next [--json]                              Show the first eligible candidate.
  add --title TEXT --authorized-by TEXT --acceptance TEXT
      [--goal ID] [--urgency LEVEL] [--why TEXT]
                                             Append a deferred candidate.
  move ID POSITION                           Move a candidate to an exact position.
  urgency ID normal|urgent|critical          Change urgency without changing order.
  pause ID REASON                            Skip a candidate while retaining order.
  resume ID                                  Make a paused candidate eligible again.
  cancel ID [REASON]                         Close a candidate without executing it.
  materialize ID EXECUTION_BEAD --mayor      Link and close the first candidate in its lane.

Human states are "Éligible · non programmé" and "En pause". Candidates stay
technically deferred in Beads so they are never worker-ready. Only the Mayor may
materialize the first eligible candidate in its product or Factory-campaign lane
into a separately created executable Bead. Order and urgency are intentionally
independent; NEXT remains product-only.

add requires --authorized-by (what authorizes this candidate: a decision record,
an ADR, a validated parent or review finding) and an --acceptance holding at
least one EARS line (English "shall" or French "doit"). materialize copies the
provenance onto the execution Bead (gc.source_candidate, gc.authorized_by).
USAGE
}

ears_template() {
  cat >&2 <<'EARS'
Acceptance needs at least one EARS line (French: Le/Quand/Tant que/Là où/Si ... doit):
  Ubiquitous:        The <system> shall <response>.
  Event-driven:      When <trigger>, the <system> shall <response>.
  State-driven:      While <state>, the <system> shall <response>.
  Optional feature:  Where <feature>, the <system> shall <response>.
  Unwanted behavior: If <condition>, then the <system> shall <response>.
EARS
}

has_ears_line() {
  local line found=1
  local lead='^[[:space:]]*(-[[:space:]]+)?(\[[^]]*\][[:space:]]*)?'
  local english="${lead}(the|when|while|where|if)[[:space:]].*[^[:alnum:]]shall([^[:alnum:]]|\$)"
  local french="${lead}((le|la|les|quand|lorsque|tant que|là où|si)[[:space:]]|l'|l’|lorsqu'|lorsqu’).*[^[:alnum:]](doit|doivent)([^[:alnum:]]|\$)"
  shopt -s nocasematch
  while IFS= read -r line; do
    if [[ $line =~ $english || $line =~ $french ]]; then
      found=0
      break
    fi
  done <<<"$1"
  shopt -u nocasematch
  return "$found"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is unavailable: $1"
}

validate_product() {
  [[ $PRODUCT =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] \
    || die "PRODUCT_QUEUE_PRODUCT must be a lowercase product slug."
}

priority_for_urgency() {
  case "$1" in
    normal) printf '2\n' ;;
    urgent) printf '1\n' ;;
    critical) printf '0\n' ;;
    *) die "Urgency must be normal, urgent, or critical." ;;
  esac
}

load_inventory() {
  local raw
  raw=$("$BD_BIN" list --all --label product-queue \
    --label "product:$PRODUCT" --limit 0 --json) \
    || die "Beads queue inventory is unavailable."

  INVENTORY=$(jq -ce --arg product "$PRODUCT" '
    if type != "array" then error("inventory must be an array") else . end |
    map(select(.metadata["gc.queue_product"] == $product)) as $candidates |
    if all($candidates[];
      (.status == "deferred" and
       (.metadata["gc.queue_state"] == "queued" or .metadata["gc.queue_state"] == "paused"
        or .metadata["gc.queue_state"] == "blocked_durable_failure"))
      or
      (.status == "closed" and .metadata["gc.queue_state"] == "cancelled")
      or
      (.status == "closed" and .metadata["gc.queue_state"] == "materialized" and
       (.metadata["gc.materialized_bead"] | type == "string" and
        test("^[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)*$"))))
    then $candidates else error("invalid candidate status/state tuple") end |
    map(select(
      .status == "deferred" and
      (.metadata["gc.queue_state"] == "queued" or
       .metadata["gc.queue_state"] == "paused"))) |
    if all(.[].metadata["gc.queue_rank"];
      (tostring | test("^[1-9][0-9]*$"))) then .
    else error("invalid rank") end |
    if all(.[].metadata["gc.queue_urgency"];
      . == "normal" or . == "urgent" or . == "critical") then .
    else error("invalid urgency") end |
    sort_by((.metadata["gc.queue_rank"] | tonumber), .id) |
    . as $items |
    if ([$items[].metadata["gc.queue_rank"] | tonumber] | unique | length) == ($items | length)
    then $items else error("duplicate rank") end
  ' <<<"$raw") || die "Product queue metadata is inconsistent; repair it before mutation."
}

project_inventory() {
  PROJECTED_INVENTORY=$("$HUMAN_STATE_BIN" candidates <<<"$INVENTORY") \
    || die "Human candidate projection failed closed; repair queue metadata before continuing."
}

require_candidate() {
  local id=$1
  CANDIDATE=$(jq -ce --arg id "$id" \
    '[.[] | select(.id == $id)] | if length == 1 then .[0] else error("not found") end' \
    <<<"$INVENTORY") || die "Candidate $id is not in the active $PRODUCT queue."
}

list_queue() {
  local format=${1:-}
  load_inventory
  project_inventory
  if [[ $format == --json ]]; then
    printf '%s\n' "$PROJECTED_INVENTORY"
    return
  fi
  [[ -z $format ]] || die "Unsupported list option: $format"
  printf 'PRODUCT QUEUE: %s\n' "$PRODUCT"
  if [[ $(jq 'length' <<<"$INVENTORY") -eq 0 ]]; then
    printf 'EMPTY\n'
    return
  fi
  jq -r '.[] |
    "\(.position). [" +
    (if .kind == "factory_campaign" then "\(.kind_label) · " else "" end) +
    "\(.state_label)][urgence \(.urgency_label)] \(.title) (\(.id))" +
    (if .state == "paused" then " — \(.reason)" else "" end)' <<<"$PROJECTED_INVENTORY"
  printf '%s\n' "GARDE-FOU: candidats techniquement différés dans Beads; seul le Mayor peut les matérialiser après autorisation EXECUTE."
}

next_candidate() {
  local format=${1:-}
  local next
  load_inventory
  project_inventory
  next=$(jq -c '[.[] | select(.state == "eligible" and .kind == "product_candidate")][0] // null' \
    <<<"$PROJECTED_INVENTORY")
  if [[ $format == --json ]]; then
    printf '%s\n' "$next"
    return
  fi
  [[ -z $format ]] || die "Unsupported next option: $format"
  if [[ $next == null ]]; then
    printf 'NEXT: none\n'
  else
    jq -r '"NEXT: \(.title) (\(.id)) — \(.state_label); lancement non automatique"' <<<"$next"
  fi
}

add_candidate() {
  local title= goal=$DEFAULT_GOAL urgency=normal why= acceptance= authorized_by=
  local priority rank metadata response id
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) [[ $# -ge 2 ]] || die "--title needs a value."; title=$2; shift 2 ;;
      --goal) [[ $# -ge 2 ]] || die "--goal needs a value."; goal=$2; shift 2 ;;
      --urgency) [[ $# -ge 2 ]] || die "--urgency needs a value."; urgency=$2; shift 2 ;;
      --why) [[ $# -ge 2 ]] || die "--why needs a value."; why=$2; shift 2 ;;
      --acceptance) [[ $# -ge 2 ]] || die "--acceptance needs a value."; acceptance=$2; shift 2 ;;
      --authorized-by) [[ $# -ge 2 ]] || die "--authorized-by needs a value."; authorized_by=$2; shift 2 ;;
      *) die "Unsupported add argument: $1" ;;
    esac
  done
  [[ -n $title && $title != *$'\n'* && $title != *$'\r'* ]] \
    || die "A single-line --title is required."
  [[ -n $authorized_by && $authorized_by != *$'\n'* && $authorized_by != *$'\r'* ]] \
    || die "A single-line --authorized-by is required: cite the decision, ADR, or validated parent that authorizes this candidate."
  [[ -n $acceptance ]] || { ears_template; die "--acceptance is required."; }
  has_ears_line "$acceptance" \
    || { ears_template; die "--acceptance holds no EARS-shaped line."; }
  [[ $goal =~ ^[A-Za-z0-9._-]+$ || $goal == none ]] || die "Invalid goal ID."
  priority=$(priority_for_urgency "$urgency")
  [[ -n $why ]] || why="Queued product outcome for $PRODUCT; refine scope before Mayor materialization."

  load_inventory
  rank=$(jq '[.[].metadata["gc.queue_rank"] | tonumber] | max // 0 | . + 1000' \
    <<<"$INVENTORY")
  metadata=$(jq -cn --arg product "$PRODUCT" --arg state queued \
    --arg urgency "$urgency" --arg goal "$goal" --argjson rank "$rank" \
    --arg authorized_by "$authorized_by" '{
      "gc.queue_product": $product,
      "gc.queue_state": $state,
      "gc.queue_rank": $rank,
      "gc.queue_urgency": $urgency,
      "gc.queue_goal": $goal,
      "gc.authorized_by": $authorized_by
    }')
  response=$("$BD_BIN" create "$title" --type feature --priority "$priority" \
    --defer 2125-01-01 \
    --labels "product-queue,product:$PRODUCT" --description "$why" \
    --acceptance "$acceptance" --metadata "$metadata" --json) \
    || die "Candidate creation failed."
  id=$(jq -er '.id // (if type == "array" then .[0].id else empty end)' <<<"$response") \
    || die "Beads did not return the created candidate ID."
  if ! "$BD_BIN" update "$id" --status deferred >/dev/null; then
    "$BD_BIN" close "$id" --reason "Queue insertion rollback: could not defer candidate" \
      >/dev/null 2>&1 || true
    die "Candidate $id could not be made non-executable and was rolled back."
  fi
  printf 'ADDED: %s — position %s (%s)\n' "$id" "$(( $(jq 'length' <<<"$INVENTORY") + 1 ))" "$urgency"
}

move_candidate() {
  local id=${1:-} position=${2:-}
  local count new_order index rank updated_id original_id original_rank
  [[ -n $id && $position =~ ^[1-9][0-9]*$ ]] || die "Usage: $PROGRAM_NAME move ID POSITION"
  load_inventory
  require_candidate "$id"
  count=$(jq 'length' <<<"$INVENTORY")
  (( position <= count )) || die "Position must be between 1 and $count."
  new_order=$(jq -ce --arg id "$id" --argjson position "$position" '
    [.[].id] as $ids |
    ($ids | index($id)) as $old |
    ($ids | del(.[$old])) as $without |
    ($without[0:($position - 1)] + [$id] + $without[($position - 1):])
  ' <<<"$INVENTORY") || die "Could not calculate the new order."

  index=0
  while IFS= read -r updated_id; do
    index=$((index + 1))
    rank=$((index * 1000))
    if ! "$BD_BIN" update "$updated_id" --set-metadata "gc.queue_rank=$rank" >/dev/null; then
      while IFS=$'\t' read -r original_id original_rank; do
        "$BD_BIN" update "$original_id" --set-metadata "gc.queue_rank=$original_rank" \
          >/dev/null 2>&1 || true
      done < <(jq -r '.[] | [.id, (.metadata["gc.queue_rank"] | tostring)] | @tsv' \
        <<<"$INVENTORY")
      die "Reorder failed and the previous ranks were restored."
    fi
  done < <(jq -r '.[]' <<<"$new_order")
  printf 'MOVED: %s — position %s\n' "$id" "$position"
}

set_state() {
  local id=$1 state=$2 reason=${3:-}
  load_inventory
  require_candidate "$id"
  if [[ -n $reason ]]; then
    "$BD_BIN" update "$id" --set-metadata "gc.queue_state=$state" \
      --set-metadata "gc.queue_pause_reason=$reason" \
      --append-notes "Product queue $state: $reason" >/dev/null
  else
    "$BD_BIN" update "$id" --set-metadata "gc.queue_state=$state" \
      --set-metadata "gc.queue_pause_reason=" >/dev/null
  fi
  printf '%s: %s\n' "${state^^}" "$id"
}

resume_candidate() {
  local id=${1:-}
  [[ -n $id ]] || die "Usage: $PROGRAM_NAME resume ID"
  # load_inventory validates the whole product line is internally consistent
  # (fail-closed) even though its INVENTORY deliberately excludes
  # blocked_durable_failure, the same way it excludes materialized/cancelled --
  # a quarantined node must not appear in list/next. Resume is the one command
  # that has to reach past that exclusion to unblock exactly the named node.
  load_inventory
  local raw candidate state
  raw=$("$BD_BIN" list --all --label product-queue \
    --label "product:$PRODUCT" --limit 0 --json) \
    || die "Beads queue inventory is unavailable."
  candidate=$(jq -ce --arg id "$id" --arg product "$PRODUCT" '
    [.[] | select(.metadata["gc.queue_product"] == $product and .id == $id)] |
    if length == 1 then .[0] else error("not found") end
  ' <<<"$raw") || die "Candidate $id is not in the $PRODUCT queue."
  state=$(jq -r '.metadata["gc.queue_state"] // empty' <<<"$candidate")
  [[ $state == paused || $state == blocked_durable_failure ]] \
    || die "Candidate $id is $state, not paused or durably blocked; nothing to resume."
  "$BD_BIN" update "$id" --set-metadata "gc.queue_state=queued" \
    --set-metadata "gc.queue_pause_reason=" >/dev/null
  printf 'QUEUED: %s\n' "$id"
}

set_urgency() {
  local id=${1:-} urgency=${2:-} priority
  [[ -n $id && -n $urgency ]] || die "Usage: $PROGRAM_NAME urgency ID LEVEL"
  priority=$(priority_for_urgency "$urgency")
  load_inventory
  require_candidate "$id"
  "$BD_BIN" update "$id" --priority "$priority" \
    --set-metadata "gc.queue_urgency=$urgency" >/dev/null
  printf 'URGENCY: %s — %s\n' "$id" "$urgency"
}

cancel_candidate() {
  local id=${1:-} reason=${2:-Cancelled by the Product Owner}
  [[ -n $id ]] || die "Usage: $PROGRAM_NAME cancel ID [REASON]"
  load_inventory
  require_candidate "$id"
  "$BD_BIN" update "$id" --set-metadata gc.queue_state=cancelled \
    --append-notes "Product queue cancelled: $reason" >/dev/null
  "$BD_BIN" close "$id" --reason "$reason" >/dev/null
  printf 'CANCELLED: %s\n' "$id"
}

materialize_candidate() {
  local id=${1:-} execution_id=${2:-} authority=${3:-}
  local first response execution_status candidate_goal lane lane_filter
  local authorized_by backlink
  [[ -n $id && -n $execution_id && $authority == --mayor ]] \
    || die "Usage: $PROGRAM_NAME materialize ID EXECUTION_BEAD --mayor"
  require_command "$GC_BIN"
  load_inventory
  require_candidate "$id"
  candidate_goal=$(jq -er '.metadata["gc.queue_goal"] | select(type == "string" and length > 0)' \
    <<<"$CANDIDATE") || die "Candidate $id has no valid lane."
  if [[ $candidate_goal == none ]]; then
    lane="Factory campaign"
    lane_filter='(.metadata["gc.queue_goal"] == "none")'
  else
    lane="product"
    lane_filter='(.metadata["gc.queue_goal"] != "none")'
  fi
  first=$(jq -er "[.[] | select(.metadata[\"gc.queue_state\"] == \"queued\" and $lane_filter)][0].id // empty" \
    <<<"$INVENTORY") || die "The $lane lane has no eligible candidate."
  [[ $id == "$first" ]] \
    || die "Only the first eligible candidate in the $lane lane ($first) may be materialized."

  response=$("$GC_BIN" bd show "$execution_id" --json) \
    || die "Execution Bead $execution_id is unavailable."
  execution_status=$(jq -er 'if type == "array" and length == 1 then .[0].status else empty end' \
    <<<"$response") || die "Execution Bead $execution_id did not resolve uniquely."
  [[ $execution_status == open || $execution_status == in_progress ]] \
    || die "Execution Bead $execution_id is not open or in progress."

  "$BD_BIN" update "$id" --set-metadata gc.queue_state=materialized \
    --set-metadata "gc.materialized_bead=$execution_id" \
    --append-notes "Mayor materialized as executable Bead $execution_id" >/dev/null
  "$BD_BIN" close "$id" --reason "Materialized by Mayor as $execution_id" >/dev/null
  # Provenance back-link; legacy candidates carry no gc.authorized_by. Best
  # effort: the materialization above is already durable and must stand.
  authorized_by=$(jq -r '.metadata["gc.authorized_by"] | strings' <<<"$CANDIDATE")
  backlink=(--set-metadata "gc.source_candidate=$id")
  [[ -z $authorized_by ]] || backlink+=(--set-metadata "gc.authorized_by=$authorized_by")
  "$BD_BIN" update "$execution_id" "${backlink[@]}" >/dev/null \
    || printf '%s: WARNING: %s\n' "$PROGRAM_NAME" \
      "Could not write the provenance back-link on $execution_id; materialization stands." >&2
  printf 'MATERIALIZED: %s -> %s\n' "$id" "$execution_id"
}

main() {
  local command=${1:-}
  [[ -n $command ]] || { usage; return 2; }
  shift
  case "$command" in
    -h|--help|help) usage ;;
    list) list_queue "$@" ;;
    next) next_candidate "$@" ;;
    add) add_candidate "$@" ;;
    move) [[ $# -eq 2 ]] || die "Usage: $PROGRAM_NAME move ID POSITION"; move_candidate "$@" ;;
    urgency) [[ $# -eq 2 ]] || die "Usage: $PROGRAM_NAME urgency ID LEVEL"; set_urgency "$@" ;;
    pause) [[ $# -eq 2 ]] || die "Usage: $PROGRAM_NAME pause ID REASON"; set_state "$1" paused "$2" ;;
    resume) [[ $# -eq 1 ]] || die "Usage: $PROGRAM_NAME resume ID"; resume_candidate "$1" ;;
    cancel) [[ $# -le 2 ]] || die "Usage: $PROGRAM_NAME cancel ID [REASON]"; cancel_candidate "$@" ;;
    materialize) [[ $# -eq 3 ]] || die "Usage: $PROGRAM_NAME materialize ID EXECUTION_BEAD --mayor"; materialize_candidate "$@" ;;
    *) usage >&2; return 2 ;;
  esac
}

validate_product
require_command jq
require_command "$BD_BIN"
require_command flock
[[ -x $HUMAN_STATE_BIN ]] || die "Human state projector is unavailable: $HUMAN_STATE_BIN"
LOCK_FILE="${PRODUCT_QUEUE_LOCK_FILE:-${TMPDIR:-/tmp}/agent-factory-product-queue-${PRODUCT}.lock}"
exec 9>"$LOCK_FILE"
flock -w 10 9 || die "Could not acquire the product queue lock."
main "$@"
