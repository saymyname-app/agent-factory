#!/usr/bin/env python3
"""Entry point of convoy-state. The code is lib/convoy_state.py.

Python compiles a program it is given by path on every start and keeps the
compiled form only of what it imports. Imported, the code is compiled once
instead of on each of the thousands of calls the delivery flow and its tests
make (af-xhryl7; docs/OPERATIONS.md, "Factory CI cost and the Actions
quota").

A merge conflict in this file means a branch edited the code while it still
lived here. Keep this file as it is on main and replay that edit on the
module, from the branch's work tree:

    git diff "$(git merge-base origin/main HEAD)" HEAD -- bin/convoy-state \\
      | sed 's#bin/convoy-state#lib/convoy_state.py#g' | git apply -3
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from convoy_state import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
