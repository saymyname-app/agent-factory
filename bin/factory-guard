#!/usr/bin/env bash
# factory-guard — deterministic (L0, zero-token) protection for the live Factory.
#
# Every failure this guards against actually happened on 2026-09-15:
#
#   1. BRANCH DRIFT     a `git checkout` in the live root swapped city.toml,
#                       agents/ and bin/ out from under the running city —
#                       permission_mode silently returned to "plan" (which
#                       strands unattended Claude agents), three provider
#                       profiles vanished, and bin/pr-autopilot was deleted
#                       from disk, taking the merge actor offline.
#   2. WORK ON DISK ONLY  5 commits existed nowhere but this machine; three of
#                       them had already lost their remote branch.
#   3. SILENT REGRESSION  none of the above raised anything. It was found by
#                       accident, ~20 minutes later.
#
# And on 2026-09-16:
#
#   4. BLIND SPOT       check 2 only ever compared refs/heads/ to origin, so it
#                       printed "nothing exists only on this machine" while 20
#                       entries -- two Accepted ADRs among them -- existed
#                       nowhere else. It now also watches the working tree and
#                       snapshots it off-box without touching HEAD.
#   5. HEALTHY BUT IDLE  every check was green through six hours in which
#                       the campaign advanced nothing. It now also checks
#                       liveness from the sentinel's heartbeats, and files
#                       one defect for the Mayor when the factory stalls.
#
# And on 2026-09-17 (af-ogg8z):
#
#   6. EXEC-BIT LOSS    the Mayor ran `git commit`/`checkout`/`reset --hard`
#                       directly in the live root (23:05-23:08). One side
#                       effect: bin/provider-failover's executable bit was
#                       lost. This guard's runtime-files check only ever
#                       tested `-e` (existence), never `-x` (executable), so
#                       provider-failover silently failed exit 126 every tick
#                       for ~2 hours with no alert, until an unrelated pull
#                       happened to rewrite the file. It now also verifies
#                       every file git tracks as mode 100755 under bin/ is
#                       executable on disk, and restores the bit itself.
#
# Default run is safe and self-healing: it always backs up unpushed work, and
# restores the pinned branch ONLY when drift has actually broken an invariant.
# --check-only reports without touching anything.
#
# Usage: factory-guard [--check-only] [--quiet] [--pin <branch>]
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
STATE="$ROOT/.gc/factory-guard.branch"
CHECK_ONLY=0
QUIET=0
PIN=""

while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) CHECK_ONLY=1 ;;
    --quiet) QUIET=1 ;;
    --pin) PIN="${2:-}"; shift ;;
    -h|--help)
      sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

cd "$ROOT" || { echo "factory-guard: $ROOT unreachable"; exit 2; }

PROBLEMS=(); ACTIONS=(); STATUS=0
say()  { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }
bad()  { PROBLEMS+=("$1"); STATUS=1; }
did()  { ACTIONS+=("$1"); say "  FIXED: $1"; }

# --- pin the expected branch -------------------------------------------------
if [ -n "$PIN" ]; then
  printf '%s\n' "$PIN" > "$STATE"
  say "pinned live-root branch: $PIN"
fi
if [ ! -f "$STATE" ]; then
  git rev-parse --abbrev-ref HEAD > "$STATE"
  say "pinned live-root branch (first run): $(cat "$STATE")"
fi
EXPECTED="$(cat "$STATE")"
CURRENT="$(git rev-parse --abbrev-ref HEAD)"

say "factory-guard — $ROOT"
say ""

# --- 1. critical runtime files ----------------------------------------------
CRITICAL="bin/pr-autopilot orders/pr-autopilot.toml bin/factory-guard orders/factory-guard.toml bin/factory-build-gates bin/provider-failover orders/provider-failover.toml bin/factory-watchdog orders/factory-watchdog.toml"
MISSING=""
for f in $CRITICAL; do [ -e "$f" ] || MISSING="$MISSING $f"; done

# --- 1a. tracked bin/ executables must stay executable (af-ogg8z) -----------
# `-e` above only proves the file exists, not that it runs. 2026-09-17: a
# `git reset --hard`/`checkout` sequence in the live root cleared
# bin/provider-failover's executable bit; it exists (check 1 stayed green)
# but every invocation failed exit 126 for ~2 hours, silently. Compare disk
# mode to what git actually tracks (100755) for every file under bin/, and
# restore it when it drifts -- this is the self-heal `did()` records as FIXED.
NONEXEC=""
while read -r mode _obj _stage f; do
  [ "$mode" = "100755" ] || continue
  [ -f "$f" ] || continue    # missing entirely is check 1's problem, not this one
  [ -x "$f" ] && continue
  if [ "$CHECK_ONLY" = "1" ]; then
    NONEXEC="$NONEXEC $f"
  elif chmod +x "$f" 2>/dev/null; then
    did "restored the executable bit on $f (git tracks it as mode 100755)"
  else
    NONEXEC="$NONEXEC $f"
  fi
done < <(git ls-files -s -- bin/ 2>/dev/null)
[ -n "$NONEXEC" ] && bad "tracked executable(s) under bin/ lost their +x bit and could not be repaired:$NONEXEC"
[ -z "$NONEXEC" ] && say "✓ exec-bits — every bin/ file git tracks as 100755 is executable on disk"

# --- 1b. the generated provider overlay (ADR-0018) --------------------------
# city.toml includes city.provider.toml. The file is generated and gitignored,
# so git cannot bring it back -- and without it the whole city config fails to
# load. Regenerate it before the config checks below, which would fail too.
if grep -qE '^[[:space:]]*include[[:space:]]*=.*city\.provider\.toml' city.toml 2>/dev/null \
   && [ ! -f city.provider.toml ]; then
  if [ "$CHECK_ONLY" = "1" ]; then
    bad "city.provider.toml is missing — the city config cannot load; run factory-guard to regenerate it"
  elif [ -x bin/provider-failover ] && bin/provider-failover apply --no-reload >/dev/null 2>&1 \
       && [ -f city.provider.toml ]; then
    did "regenerated the missing provider overlay city.provider.toml"
  else
    bad "city.provider.toml is missing and could not be regenerated — the city config cannot load"
  fi
fi

# --- 2. config invariants ----------------------------------------------------
BROKEN_CFG=""
if grep -qE '^\s*permission_mode\s*=\s*"plan"' city.toml 2>/dev/null; then
  BROKEN_CFG="permission_mode=plan (strands unattended agents)"
fi
for p in codex claude claude-standard claude-cheap; do
  gc config explain --provider "$p" >/dev/null 2>&1 || \
    BROKEN_CFG="${BROKEN_CFG:+$BROKEN_CFG; }provider '$p' does not resolve"
done

# --- 3. branch drift, and self-heal only if it broke something ---------------
if [ "$CURRENT" != "$EXPECTED" ]; then
  say "✗ branch-drift — live root is on '$CURRENT', pinned '$EXPECTED'"
  if [ -n "$MISSING" ] || [ -n "$BROKEN_CFG" ]; then
    say "  drift has broken live invariants:${MISSING:+ missing:$MISSING}${BROKEN_CFG:+ config: $BROKEN_CFG}"
    if [ "$CHECK_ONLY" = "1" ]; then
      bad "branch drift to '$CURRENT' broke live config; run factory-guard to restore"
    elif [ -n "$(git status --porcelain --untracked-files=no)" ]; then
      bad "branch drift to '$CURRENT' broke live config, but the tree has uncommitted changes — refusing to checkout; resolve by hand"
    # FACTORY_GUARD_INTERNAL: see the matching comment at the fast-forward
    # below -- this lets the live-root-guard hook tell this restore apart
    # from an ordinary interactive/agent checkout.
    elif FACTORY_GUARD_INTERNAL=1 git checkout "$EXPECTED" >/dev/null 2>&1; then
      did "restored live root to '$EXPECTED' (was '$CURRENT')"
      CURRENT="$EXPECTED"; MISSING=""; BROKEN_CFG=""
      for f in $CRITICAL; do [ -e "$f" ] || MISSING="$MISSING $f"; done
      grep -qE '^\s*permission_mode\s*=\s*"plan"' city.toml 2>/dev/null && \
        BROKEN_CFG="permission_mode=plan"
    else
      bad "branch drift to '$CURRENT' broke live config and checkout back to '$EXPECTED' failed"
    fi
  else
    say "  (invariants still intact — leaving the checkout alone; use --pin to adopt it)"
  fi
else
  say "✓ branch — live root on pinned '$EXPECTED'"
fi

# --- 3a. the live root runs what is checked out, not what is merged ----------
# pr-autopilot merges to origin, but nothing pulled the live root: on
# 2026-09-17 a merged sentinel fix (#87) stayed inactive until a human noticed
# the root was 4 commits behind. Fast-forward only, only on the pinned branch,
# only with a clean tracked tree; anything else is reported, never forced.
if [ "$CURRENT" = "$EXPECTED" ] && git remote get-url origin >/dev/null 2>&1 \
   && timeout 30 git fetch -q origin "$EXPECTED" 2>/dev/null; then
  BEHIND=$(git rev-list --count "HEAD..origin/$EXPECTED" 2>/dev/null || echo 0)
  AHEAD=$(git rev-list --count "origin/$EXPECTED..HEAD" 2>/dev/null || echo 0)
  if [ "$BEHIND" -eq 0 ]; then
    say "✓ live-root-sync — running the merged '$EXPECTED'"
  elif [ "$CHECK_ONLY" = "1" ]; then
    say "· live-root-sync — $BEHIND merged commit(s) not running yet (check-only)"
  elif [ "$AHEAD" -gt 0 ]; then
    bad "live root has diverged from origin/$EXPECTED ($AHEAD ahead, $BEHIND behind) — $BEHIND merged commit(s) are not running; resolve by hand"
  elif [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    say "· live-root-sync — $BEHIND merged commit(s) not running yet: tracked files are being edited here, not pulling over them"
  else
    OLD_HEAD=$(git rev-parse HEAD)
    # FACTORY_GUARD_INTERNAL marks this as factory-guard's own fast-forward so
    # the live-root-guard reference-transaction hook (.githooks/reference-
    # transaction, af-ogg8z) lets it through -- it refuses every other ref
    # update to refs/heads/* in the live root.
    if FACTORY_GUARD_INTERNAL=1 git merge -q --ff-only "origin/$EXPECTED" >/dev/null 2>&1; then
      did "fast-forwarded the live root by $BEHIND merged commit(s)"
      # Some config is only read on reload; a reload with nothing new is a no-op.
      if git diff --name-only "$OLD_HEAD" HEAD | grep -qE '^(city\.toml|pack\.toml|orders/|agents/)'; then
        timeout 60 gc reload >/dev/null 2>&1 && did "reloaded the city config changed by that fast-forward"
      fi
    else
      bad "live root is $BEHIND merged commit(s) behind origin/$EXPECTED and the fast-forward failed"
    fi
  fi
fi

[ -n "$MISSING" ] && bad "missing critical runtime file(s):$MISSING"
[ -z "$MISSING" ] && say "✓ runtime-files — all present"
[ -n "$BROKEN_CFG" ] && bad "config invariant broken: $BROKEN_CFG"
[ -z "$BROKEN_CFG" ] && say "✓ config-invariants — permission_mode sane, all 5 providers resolve"

# Unattended agents run with permissions skipped and push rights. With
# enableAllProjectMcpServers=true, any .mcp.json that lands in a checkout (a PR
# is enough) is loaded as a tool server without anyone approving it (audit
# 2026-09-17, S1). Reported, never auto-edited: these files belong to gc.
MCP_OPEN=""
for f in "$ROOT/.gc/settings.json" "$ROOT"/rigs/*/.gc/settings.json "$ROOT"/.gc/agents/*/.gc/settings.json; do
  [ -f "$f" ] || continue
  grep -Eq '"enableAllProjectMcpServers"[[:space:]]*:[[:space:]]*true' "$f" && MCP_OPEN="$MCP_OPEN ${f#$ROOT/}"
done
[ -n "$MCP_OPEN" ] && bad "enableAllProjectMcpServers=true lets a checked-out .mcp.json load unreviewed:$MCP_OPEN"
[ -z "$MCP_OPEN" ] && say "✓ mcp-autoload — no agent settings auto-enable project MCP servers"

# --- 3c. real-PII leak guard, Layer A (af-6eqc) ------------------------------
# Local-only exact-match check against a gitignored real-identifier list
# under .gc/ (see bin/factory-pii-guard for the full mechanism and why it
# never prints the list or a matched value). The real block happens in the
# pre-push hook, which has a real exit code; this is the same check surfaced
# in the periodic report so an unpushed match doesn't wait for a push to be
# noticed. Its own output never contains the list or a matched value, so it
# is safe to fold into say()/bad() here.
PII_GUARD="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/factory-pii-guard"
if [ -x "$PII_GUARD" ]; then
  PII_OUTPUT=$(FACTORY_ROOT="$ROOT" "$PII_GUARD" --repo-root "$ROOT" 2>&1)
  PII_STATUS=$?
  if [ "$PII_STATUS" -eq 1 ]; then
    bad "pii-guard — real identifier found in outgoing diff or working tree (run bin/factory-pii-guard locally for detail; never paste the diff into a bead/mail)"
  elif [ "$PII_STATUS" -eq 3 ]; then
    # INACTIVE: no identifier list on this machine, nothing was actually
    # checked. Reported with the same "not checked" marker as a missing
    # binary below, never "✓" -- af-ox44d: this line used to read "✓
    # pii-guard — nothing to check", which every reader (including a
    # year of Oxyl real-person photos going untracked) reasonably took
    # for "checked, clean" rather than "not checked at all".
    say "· pii-guard — ${PII_OUTPUT#factory-pii-guard: }"
  elif [ "$PII_STATUS" -eq 0 ]; then
    say "✓ pii-guard — ${PII_OUTPUT#factory-pii-guard: }"
  else
    bad "pii-guard — factory-pii-guard exited $PII_STATUS (usage/environment error); containment could not be verified"
  fi
else
  say "· pii-guard — not checked (bin/factory-pii-guard missing)"
fi

# --- 4. back up work that exists only on this machine ------------------------
AT_RISK=0; PUSHED=0
while read -r b; do
  [ -z "$b" ] && continue
  remote=$(git ls-remote --heads origin "$b" 2>/dev/null | awk '{print $1}')
  local_sha=$(git rev-parse "$b")
  if [ -z "$remote" ]; then
    n=$(git rev-list --count origin/main.."$b" 2>/dev/null || echo 0)
    [ "${n:-0}" = "0" ] && continue
  elif [ "$remote" = "$local_sha" ]; then
    continue
  elif git merge-base --is-ancestor "$local_sha" "$remote" 2>/dev/null; then
    # purely behind origin: nothing exists only here, so nothing is at risk
    continue
  else
    # real divergence: local has commits the remote lacks AND vice versa
    git merge-base --is-ancestor "$remote" "$local_sha" 2>/dev/null || {
      bad "branch '$b' has truly diverged from origin — needs a human"; continue; }
  fi
  AT_RISK=$((AT_RISK+1))
  if [ "$CHECK_ONLY" = "1" ]; then
    bad "unpushed work on '$b'"
  elif git push origin "$b:$b" >/dev/null 2>&1; then
    did "backed up '$b' to origin"; PUSHED=$((PUSHED+1))
  else
    bad "could not back up '$b' to origin"
  fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

# --- 4b. work that exists only in the WORKING TREE ---------------------------
# The check above compares refs/heads/ to origin, which is only half the
# question. On 2026-09-16 it printed "nothing exists only on this machine"
# while 20 entries -- including ADR-0015 and ADR-0016, both Accepted -- existed
# nowhere but this disk. A check that asserts the opposite of reality is worse
# than no check, because it is believed.
#
# Scope: modified tracked files AND untracked files that .gitignore does not
# cover. A file the repo declares ignored is out of scope by the repo's own
# statement; a file it does not is, by definition, something meant to be
# tracked -- exactly the class that was lost sight of.
#
# The guard must not commit on anyone's behalf, so it takes a snapshot that
# touches nothing: a throwaway index, write-tree, commit-tree parented on HEAD,
# pushed to refs/factory-guard/snapshots/<utc>. HEAD, the real index and the
# working tree are never modified. The work is off-box in seconds, nobody is
# interrupted, and a human reconciles whenever they like.
DIRTY_LIST=$(git status --porcelain --untracked-files=all 2>/dev/null)
DIRTY=$(printf '%s' "$DIRTY_LIST" | grep -c . || true)
SNAP_REF=""
if [ "${DIRTY:-0}" -gt 0 ]; then
  say "  work-tree — ${DIRTY} entr(y|ies) exist only in this working tree:"
  printf '%s\n' "$DIRTY_LIST" | head -12 | sed 's/^/      /'
  [ "${DIRTY}" -gt 12 ] && say "      ... and $((DIRTY - 12)) more"
  if [ "$CHECK_ONLY" = "1" ]; then
    bad "${DIRTY} uncommitted/untracked entr(y|ies) exist only on this machine"
  elif [ "${DIRTY}" -gt 1000 ]; then
    # A jump this large means something else is wrong (a .gitignore regression,
    # a build dumped in the root). Snapshotting it would push a huge blob, so
    # say so instead and let a human look.
    bad "${DIRTY} dirty entries — too many to snapshot safely; check .gitignore"
  else
    # -u on purpose: git refuses a zero-byte index file, and mktemp creates one.
    SNAP_IDX=$(mktemp -u)
    if GIT_INDEX_FILE="$SNAP_IDX" git add -A 2>/dev/null \
       && tree=$(GIT_INDEX_FILE="$SNAP_IDX" git write-tree 2>/dev/null) \
       && [ -n "$tree" ]; then
      stamp=$(date -u +%Y%m%dT%H%M%SZ)
      commit=$(git commit-tree "$tree" -p HEAD \
        -m "factory-guard snapshot ${stamp}: ${DIRTY} entries that existed only on this machine" \
        2>/dev/null)
      SNAP_REF="refs/factory-guard/snapshots/${stamp}"
      if [ -n "$commit" ] && git push -q origin "$commit:$SNAP_REF" 2>/dev/null; then
        did "snapshotted ${DIRTY} working-tree entr(y|ies) to origin $SNAP_REF"
        # Keep the ten most recent; older ones describe states long superseded.
        git ls-remote --refs origin 'refs/factory-guard/snapshots/*' 2>/dev/null \
          | awk '{print $2}' | sort | head -n -10 \
          | while read -r old; do git push -q origin ":$old" 2>/dev/null || true; done
      else
        bad "could not snapshot the working tree to origin — ${DIRTY} entries at risk"
      fi
    else
      bad "could not build a snapshot of the working tree — ${DIRTY} entries at risk"
    fi
    rm -f "$SNAP_IDX"
  fi
fi

if [ "$AT_RISK" = "0" ] && [ "${DIRTY:-0}" = "0" ]; then
  say "✓ work-backup — branches pushed, working tree clean; nothing exists only here"
elif [ "$AT_RISK" = "0" ] && [ -n "$SNAP_REF" ]; then
  say "✓ work-backup — branches pushed; working tree snapshotted to origin"
fi

# --- 5. a rig with ready work but no dispatcher ------------------------------
for rig in saymyname-backend saymyname-frontend; do
  [ -d "rigs/$rig" ] || continue
  # `gc rig status` reports "unknown (partial status)" whenever its runtime
  # probe times out, which silently hid a genuinely stopped dispatcher. The
  # session list is authoritative — use that instead.
  running=$(gc session list 2>/dev/null \
    | grep -c "$rig/core.control-dispatcher.*active" || true)
  ready=$(cd "rigs/$rig" && gc bd ready 2>/dev/null | grep -c . || echo 0)
  # This city runs its agents scale-to-zero: a dispatcher stops itself with
  # "drain acknowledged by agent" once nothing is claimable, and the reconciler
  # brings it back when work is slung. A stopped dispatcher is therefore NOT a
  # fault on its own, and treating it as one produced a false alarm for hours.
  # Only a suspended rig genuinely blocks delivery.
  suspended=$(gc rig status --rig "$rig" 2>/dev/null | grep -c "Suspended:  yes" || true)
  if [ "${suspended:-0}" -gt 0 ]; then
    bad "rig '$rig' is SUSPENDED — no work can be dispatched to it"
  elif [ "${running:-0}" -gt 0 ]; then
    say "✓ rig:$rig — dispatcher running ($ready ready)"
  else
    say "· rig:$rig — dispatcher idle (scale-to-zero), $ready ready, not suspended"
  fi
done

# --- 5b. resolved formula exec checks exist inside every rig (af-uxz57) -----
# Gas City resolves an exec-check path relative to its target rig, but pack
# assets are not copied there automatically. That made every build-basic gate
# fail before the validator even started. External symlinks do not solve it:
# Gas City's containment check rejects them before execution. The helper reads
# each rig's live resolved formula catalog, deduplicates check paths, and writes
# manifest-tracked regular-file gates plus the pack-linked validator dependency
# whose schemas resolve from its real pack path. Default mode repairs missing or
# stale managed artifacts; --check-only reports each rig/path once without writing.
BUILD_GATES="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/factory-build-gates"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 || [ ! -x "$BUILD_GATES" ]; then
  say "· build-gates — not checked (not a city root, or gc/helper unavailable)"
else
  BG_ARGS=()
  [ "$CHECK_ONLY" = "1" ] && BG_ARGS+=(--check-only)
  BG_OUTPUT=$(FACTORY_ROOT="$ROOT" "$BUILD_GATES" "${BG_ARGS[@]}" 2>&1)
  BG_STATUS=$?
  [ "$QUIET" = "1" ] || printf '%s\n' "$BG_OUTPUT" | sed 's/^/  /'
  BG_PROBLEM_COUNT=0
  while IFS= read -r raw_line; do
    line="${raw_line#"${raw_line%%[![:space:]]*}"}"
    case "$line" in
      FIXED:\ *) ACTIONS+=("build-gates: ${line#FIXED: }") ;;
      !\ *)      PROBLEMS+=("${line#! }"); STATUS=1; BG_PROBLEM_COUNT=$((BG_PROBLEM_COUNT+1)) ;;
    esac
  done <<<"$BG_OUTPUT"
  if [ "$BG_STATUS" -ne 0 ] && [ "$BG_PROBLEM_COUNT" -eq 0 ]; then
    PROBLEMS+=("build-gates: factory-build-gates exited $BG_STATUS with no problem line captured")
    STATUS=1
  fi
fi

# --- 6. worktrees left behind by a finished session --------------------------
# "Never checkout in the live root, use a worktree" is the right rule, but it
# only ever had a create half. Sessions ended without removing their worktree,
# and a worktree still pinning a merged branch makes `gh pr merge
# --delete-branch` exit non-zero AFTER merging -- which pr-autopilot used to
# report as "direct merge failed - left for a human" on a PR that had in fact
# merged. Runtime worktrees under ~/.local/share are the city's own; leave them.
if [ "$CHECK_ONLY" = "1" ]; then
  DANGLING=$(git worktree prune --dry-run -v 2>&1 | grep -c . || true)
  [ "${DANGLING:-0}" -gt 0 ] && bad "${DANGLING} dangling worktree registration(s); run factory-guard to prune"
else
  PRUNED=$(git worktree prune -v 2>&1 | grep -c . || true)
  [ "${PRUNED:-0}" -gt 0 ] && did "pruned ${PRUNED} dangling worktree registration(s)"
fi
STALE=0; LIVE_WT=0
while read -r wt; do
  [ -z "$wt" ] && continue
  [ "$wt" = "$ROOT" ] && continue
  case "$wt" in "$HOME/.local/share/agent-factory-runtime-"*) continue ;; esac
  LIVE_WT=$((LIVE_WT+1))
  br=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
  [ "$br" = "HEAD" ] && continue
  # Uncommitted work means someone may still be in there: never call it stale.
  [ "$(git -C "$wt" status --porcelain 2>/dev/null | wc -l)" != "0" ] && continue
  # A squash merge does NOT make the branch an ancestor of main, so asking git
  # alone would miss every branch this repo actually merges. The PR state is
  # the authoritative answer; the ancestor test only covers the fast-forward
  # case and branches that never had a PR.
  reason=""
  if git merge-base --is-ancestor "$br" origin/main 2>/dev/null; then
    reason="already in origin/main"
  else
    pr_state=$(gh pr list --head "$br" --state all \
      --json state --jq '.[0].state // empty' 2>/dev/null)
    case "$pr_state" in
      MERGED) reason="its PR is merged" ;;
      CLOSED) reason="its PR is closed" ;;
    esac
  fi
  if [ -n "$reason" ]; then
    # Removing it was a human chore on every merge (three of them on
    # 2026-09-18 alone), so the guard does it: clean tree, merged/closed
    # branch, not locked, no live session working in it. Anything else is
    # still only reported.
    in_use=$(gc session list 2>/dev/null | grep -c -F "$wt" || true)
    locked=$(git worktree list --porcelain | awk -v w="$wt" '$1=="worktree" && $2==w {f=1; next} f && /^locked/ {print "yes"; exit} /^$/ {f=0}')
    if [ "$CHECK_ONLY" = "1" ]; then
      STALE=$((STALE+1))
      bad "worktree '$wt' still pins '$br' ($reason) — it will break the next --delete-branch; remove it with: git worktree remove $wt"
    elif [ "${in_use:-0}" = "0" ] && [ -z "$locked" ] && git worktree remove "$wt" >/dev/null 2>&1; then
      did "removed stale worktree '$wt' ($br: $reason)"
    else
      STALE=$((STALE+1))
      bad "worktree '$wt' still pins '$br' ($reason) — in use or locked, not removed; remove it with: git worktree remove $wt"
    fi
  fi
done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')
if [ "$STALE" = "0" ]; then
  say "✓ worktrees — $LIVE_WT human worktree(s), none pinning a merged branch"
fi

# --- 7. campaign liveness, not only health (ADR-0016 s5.3, af-vc39) ---------
# Every check above asks "are the parts in place". None asks "did anything
# move". On the night of 2026-09-15 all of them were green while the wake loop
# was dead for six hours. This reads the heartbeats the sentinel leaves on the
# coordination bead; lib/factory_liveness.py holds the rules and the thresholds.
# It only runs against a real city: a scratch repo has no coordination bead,
# and a guard test must never file a defect into the live store.
GUARD_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" 2>/dev/null && pwd)"
COORD="${CAMPAIGN_COORDINATION_BEAD:-af-1vr4}"
# af-ii0mj: a "stale" liveness verdict diagnosed and closed with a known,
# still-true cause (e.g. product lane paused + factory ladder empty) must not
# re-file every ~5-10 min for as long as that idle window legitimately lasts
# -- see the cooldown gate below, keyed on the underlying progress/watch
# anchor so a genuinely new stall still files immediately.
LIVENESS_COOLDOWN_MINUTES="${FACTORY_GUARD_LIVENESS_COOLDOWN_MINUTES:-60}"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 \
   || [ ! -f "$GUARD_LIB/factory_liveness.py" ]; then
  say "· liveness — not checked (not a city root, or gc unavailable)"
else
  coord_json=$(gc bd show "$COORD" --json 2>/dev/null || true)
  # af-9ur0s: give factory_liveness.py what it needs to name the cause of a
  # stall instead of only "up but not advancing" -- provider-failover's view
  # of the mayor target, and the named mayor session's own state. Both reads
  # are best-effort: a scratch/test city has neither config/provider-policy.json
  # nor a real `gc session list`, so this degrades to "cause unknown" there,
  # exactly like a real city where neither source proves anything yet.
  PF_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/provider-failover"
  provider_status_json=""
  if [ -f "$ROOT/config/provider-policy.json" ] && [ -x "$PF_BIN" ]; then
    provider_status_json=$(FACTORY_ROOT="$ROOT" PROVIDER_NOW="${FACTORY_GUARD_NOW:-}" "$PF_BIN" status --json 2>/dev/null || true)
  fi
  sessions_json=$(gc session list --json 2>/dev/null || echo '{"sessions":[]}')
  mayor_session_json=$(printf '%s' "$sessions_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    sessions = v.get("sessions") if isinstance(v, dict) else None
    sessions = sessions if isinstance(sessions, list) else []
    mayor = next((s for s in sessions if isinstance(s, dict) and s.get("alias") == "mayor"), None)
    print(json.dumps(mayor or {}))
except Exception:
    print("{}")
' 2>/dev/null || true)
  # af-ooob8: gc.campaign_progress_at is only refreshed for the three
  # transition reasons the sentinel's planner recognizes -- a phase of the
  # current result outside that set (a review sub-session after delivery,
  # say) can run for hours without ever touching it, which reads as a stall
  # that isn't one. Give factory_liveness.py the in-flight result bead
  # itself so it can check its own heartbeat/update activity as ground truth.
  current_result_json="{}"
  current_id=$(printf '%s' "$coord_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    meta = (v.get("metadata") or {})
    print(meta.get("gc.current_jit") or meta.get("gc.current") or "")
except Exception:
    print("")' 2>/dev/null || true)
  if [ -n "$current_id" ]; then
    current_result_json=$(gc bd show "$current_id" --json 2>/dev/null | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print(json.dumps(v if isinstance(v, dict) else {}))
except Exception:
    print("{}")' 2>/dev/null || echo "{}")
  fi
  # af-py8n1 / af-f1jhi / af-kozkj: a current result can delegate to phase
  # workflows without touching its own timestamps. Prefer the explicitly
  # supported cross-rig gc.backend_workflow and gc.frontend_workflow pointers;
  # when both exist, an open/in_progress workflow wins over a closed one.
  # Retain the older shared-convoy discovery as a compatibility fallback. Then
  # collect open/in_progress descendants, including drain-launched nested
  # workflows. An active session contributes last_active only when one of
  # those beads explicitly records its session id/name: session existence
  # alone is never progress.
  current_workflow_json="[]"
  workflow_id=""
  workflow_bead_json="{}"
  if [ -n "$current_id" ]; then
    linked_workflow_ids=$(printf '%s' "$current_result_json" | python3 -c '
import json, re, sys
try:
    v = json.load(sys.stdin)
    meta = v.get("metadata") if isinstance(v, dict) else {}
    if not isinstance(meta, dict):
        meta = {}
    for key in ("gc.backend_workflow", "gc.frontend_workflow"):
        candidate = meta.get(key, "")
        if isinstance(candidate, str) and re.fullmatch(r"[a-z0-9]+-[a-z0-9]+", candidate):
            print(candidate)
except Exception:
    pass
' 2>/dev/null || true)
    fallback_workflow_id=""
    fallback_workflow_json="{}"
    open_workflow_id=""
    open_workflow_json="{}"
    failed_workflow_id=""
    failed_workflow_json="{}"
    linked_workflow_seen="|"
    while IFS= read -r linked_workflow_id; do
      [ -n "$linked_workflow_id" ] || continue
      case "$linked_workflow_seen" in
        *"|$linked_workflow_id|"*) continue ;;
        *) linked_workflow_seen="${linked_workflow_seen}${linked_workflow_id}|" ;;
      esac
      linked_workflow_json=$(gc bd show "$linked_workflow_id" --json 2>/dev/null | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print(json.dumps(v if isinstance(v, dict) else {}))
except Exception:
    print("{}")
' 2>/dev/null || echo '{}')
      verified_link=$(printf '%s' "$linked_workflow_json" | LINKED_ID="$linked_workflow_id" python3 -c '
import json, os, sys
try:
    v = json.load(sys.stdin)
    meta = v.get("metadata") if isinstance(v, dict) else {}
    if v.get("id") == os.environ.get("LINKED_ID") and meta.get("gc.kind") == "workflow":
        print(v.get("id"))
except Exception:
    pass
' 2>/dev/null || true)
      [ "$verified_link" = "$linked_workflow_id" ] || continue
      linked_workflow_status=$(printf '%s' "$linked_workflow_json" | jq -r '.status // ""' 2>/dev/null || true)
      linked_workflow_outcome=$(printf '%s' "$linked_workflow_json" | jq -r '.metadata["gc.outcome"] // ""' 2>/dev/null || true)
      case "$linked_workflow_status" in
        in_progress)
          workflow_id="$linked_workflow_id"
          workflow_bead_json="$linked_workflow_json"
          break
          ;;
        open)
          if [ -z "$open_workflow_id" ]; then
            open_workflow_id="$linked_workflow_id"
            open_workflow_json="$linked_workflow_json"
          fi
          ;;
        closed)
          case "$linked_workflow_outcome" in
            ""|pass|no-op|noop) ;;
            *)
              if [ -z "$failed_workflow_id" ]; then
                failed_workflow_id="$linked_workflow_id"
                failed_workflow_json="$linked_workflow_json"
              fi
              ;;
          esac
          ;;
      esac
      if [ -z "$fallback_workflow_id" ]; then
        fallback_workflow_id="$linked_workflow_id"
        fallback_workflow_json="$linked_workflow_json"
      fi
    done <<EOF
$linked_workflow_ids
EOF
    if [ -z "$workflow_id" ] && [ -n "$open_workflow_id" ]; then
      workflow_id="$open_workflow_id"
      workflow_bead_json="$open_workflow_json"
    elif [ -z "$workflow_id" ] && [ -n "$failed_workflow_id" ]; then
      workflow_id="$failed_workflow_id"
      workflow_bead_json="$failed_workflow_json"
    elif [ -z "$workflow_id" ] && [ -n "$fallback_workflow_id" ]; then
      workflow_id="$fallback_workflow_id"
      workflow_bead_json="$fallback_workflow_json"
    fi

    # Compatibility for results created before explicit workflow pointers:
    # find an in-progress workflow whose input convoy tracks this result.
    if [ -z "$workflow_id" ]; then
      workflows_response=$(gc bd list --status=in_progress --json 2>/dev/null || echo '[]')
      candidate_convoys=$(printf '%s' "$workflows_response" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v if isinstance(v, list) else []
except Exception:
    v = []
for w in v:
    if not isinstance(w, dict):
        continue
    meta = w.get("metadata") if isinstance(w.get("metadata"), dict) else {}
    if meta.get("gc.kind") != "workflow":
        continue
    convoy_id = meta.get("gc.input_convoy_id")
    wf_id = w.get("id")
    if isinstance(convoy_id, str) and convoy_id and isinstance(wf_id, str) and wf_id:
        print(f"{wf_id}\t{convoy_id}")
' 2>/dev/null || true)
      while IFS=$'\t' read -r wf_id convoy_id; do
        [ -n "$wf_id" ] && [ -n "$convoy_id" ] || continue
        convoy_json=$(gc bd show "$convoy_id" --json 2>/dev/null || echo '{}')
        tracks_current=$(printf '%s' "$convoy_json" | TARGET_ID="$current_id" python3 -c '
import json, os, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    deps = v.get("dependencies") if isinstance(v.get("dependencies"), list) else []
except Exception:
    deps = []
target = os.environ.get("TARGET_ID", "")
for d in deps:
    if not isinstance(d, dict):
        continue
    dep_id = d.get("id") or d.get("depends_on_id") or ""
    dep_type = d.get("dependency_type") or d.get("type") or ""
    if dep_id == target and dep_type == "tracks":
        print("yes")
        break
' 2>/dev/null || true)
        if [ "$tracks_current" = "yes" ]; then
          workflow_id="$wf_id"
          break
        fi
      done <<EOF
$candidate_convoys
EOF
      if [ -n "$workflow_id" ]; then
        workflow_bead_json=$(gc bd show "$workflow_id" --json 2>/dev/null | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print(json.dumps(v if isinstance(v, dict) else {}))
except Exception:
    print("{}")
' 2>/dev/null || echo '{}')
      fi
    fi

    if [ -n "$workflow_id" ]; then
      current_workflow_json=$(printf '%s' "$workflow_bead_json" | python3 -c '
import json, sys
try:
    root = json.load(sys.stdin)
    print(json.dumps([root] if isinstance(root, dict) and root else []))
except Exception:
    print("[]")
' 2>/dev/null || echo '[]')

      workflow_root_status=$(printf '%s' "$workflow_bead_json" | jq -r '.status // ""' 2>/dev/null || true)
      # A missing legacy status keeps the pre-pointer best-effort behavior;
      # only a positively closed root cuts off descendants and sessions.
      if [ "$workflow_root_status" != "closed" ]; then
        workflow_store_ref=$(printf '%s' "$workflow_bead_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    meta = v.get("metadata") if isinstance(v, dict) else {}
    print(meta.get("gc.root_store_ref") or "")
except Exception:
    print("")
' 2>/dev/null || true)
      workflow_store_dir="$ROOT"
      case "$workflow_store_ref" in
        rig:*)
          workflow_rig=${workflow_store_ref#rig:}
          workflow_store_dir=$(gc rig list --json 2>/dev/null | RIG_NAME="$workflow_rig" python3 -c '
import json, os, sys
try:
    v = json.load(sys.stdin)
    rigs = v.get("rigs") if isinstance(v, dict) else []
    name = os.environ.get("RIG_NAME", "")
    match = next((r for r in rigs if isinstance(r, dict) and r.get("name") == name), {})
    print(match.get("path") or "")
except Exception:
    print("")
' 2>/dev/null || true)
          ;;
        city:*|"") workflow_store_dir="$ROOT" ;;
        *) workflow_store_dir="" ;;
      esac

      if [ -n "$workflow_store_dir" ] && [ -d "$workflow_store_dir" ]; then
        workflow_queue=("$workflow_id")
        workflow_seen="|$workflow_id|"
        workflow_index=0
        # Formula nesting is normally 1-3 deep. The hard cap prevents a
        # malformed graph from turning a five-minute guard into an unbounded
        # traversal while still covering nested drain/item workflows.
        while [ "$workflow_index" -lt "${#workflow_queue[@]}" ] && [ "$workflow_index" -lt 32 ]; do
          parent_workflow_id=${workflow_queue[$workflow_index]}
          workflow_index=$((workflow_index + 1))
          workflow_children_json=$(gc bd list -C "$workflow_store_dir" --limit 0 \
            --status open,in_progress --metadata-field "gc.root_bead_id=$parent_workflow_id" \
            --json 2>/dev/null || echo '[]')
          current_workflow_json=$(jq -cn --argjson current "$current_workflow_json" \
            --argjson additions "$workflow_children_json" \
            '$current + (if ($additions | type) == "array" then $additions else [] end)' \
            2>/dev/null || printf '%s' "$current_workflow_json")

          nested_workflow_ids=$(printf '%s' "$workflow_children_json" | jq -r '
            .[]? | select((.metadata["gc.kind"] // "") == "workflow") | .id // empty' \
            2>/dev/null || true)
          while IFS= read -r nested_workflow_id; do
            [ -n "$nested_workflow_id" ] || continue
            case "$workflow_seen" in
              *"|$nested_workflow_id|"*) ;;
              *) workflow_queue+=("$nested_workflow_id"); workflow_seen="${workflow_seen}${nested_workflow_id}|" ;;
            esac
          done <<EOF
$nested_workflow_ids
EOF

          drain_ids=$(printf '%s' "$workflow_children_json" | jq -r '
            .[]? | select((.metadata["gc.kind"] // "") == "drain") | .id // empty' \
            2>/dev/null || true)
          while IFS= read -r drain_id; do
            [ -n "$drain_id" ] || continue
            drain_workflows_json=$(gc bd list -C "$workflow_store_dir" --limit 0 \
              --status open,in_progress --metadata-field "gc.drain_control_id=$drain_id" \
              --json 2>/dev/null || echo '[]')
            current_workflow_json=$(jq -cn --argjson current "$current_workflow_json" \
              --argjson additions "$drain_workflows_json" \
              '$current + (if ($additions | type) == "array" then $additions else [] end)' \
              2>/dev/null || printf '%s' "$current_workflow_json")
            drain_workflow_ids=$(printf '%s' "$drain_workflows_json" | jq -r '
              .[]? | select((.metadata["gc.kind"] // "") == "workflow") | .id // empty' \
              2>/dev/null || true)
            while IFS= read -r nested_workflow_id; do
              [ -n "$nested_workflow_id" ] || continue
              case "$workflow_seen" in
                *"|$nested_workflow_id|"*) ;;
                *) workflow_queue+=("$nested_workflow_id"); workflow_seen="${workflow_seen}${nested_workflow_id}|" ;;
              esac
            done <<EOF
$drain_workflow_ids
EOF
          done <<EOF
$drain_ids
EOF
        done
      fi

      linked_session_activity=$(jq -cn --argjson workflow "$current_workflow_json" \
        --argjson response "$sessions_json" '
        ($response.sessions // (if ($response | type) == "array" then $response else [] end)) as $sessions
        | [$sessions[]?
          | select((.state // "") == "active")
          | select(((.last_active // "") | type) == "string" and ((.last_active // "") | length) > 0)
          | . as $session
          | select(any($workflow[]?;
              (.metadata // {}) as $meta
              | (($meta["gc.session_id"] // "") != "" and ($meta["gc.session_id"] == ($session.id // "")))
                or (($meta["gc.session_name"] // "") != "" and
                    (($meta["gc.session_name"] == ($session.alias // "")) or
                     ($meta["gc.session_name"] == ($session.name // ""))))))
          | {id:("session:" + (.id // .alias // "unknown")), status:"in_progress",
             updated_at:.last_active,
             metadata:{"gc.last_heartbeat_at":.last_active,
                       "gc.liveness_source":"linked_session"}}]' \
        2>/dev/null || echo '[]')
      current_workflow_json=$(jq -cn --argjson current "$current_workflow_json" \
        --argjson sessions "$linked_session_activity" '$current + $sessions' \
        2>/dev/null || printf '%s' "$current_workflow_json")
      fi
    fi
  fi
  verdict=$(printf '%s' "$coord_json" \
    | FACTORY_LIVENESS_PROVIDER_STATUS_JSON="$provider_status_json" \
      FACTORY_LIVENESS_MAYOR_SESSION_JSON="$mayor_session_json" \
      FACTORY_LIVENESS_CURRENT_RESULT_JSON="$current_result_json" \
      FACTORY_LIVENESS_CURRENT_WORKFLOW_JSON="$current_workflow_json" \
      python3 "$GUARD_LIB/factory_liveness.py")
  level=$(printf '%s' "$verdict" | cut -f1)
  code=$(printf '%s' "$verdict" | cut -f2)
  msg=$(printf '%s' "$verdict" | cut -f3-)
  case "$level" in
    ok)   say "✓ liveness — $msg" ;;
    info) say "· liveness — $msg" ;;
    *)
      bad "liveness — $msg"
      # "Diagnose it, repair it or file it, and say so." A silent loop or a
      # stalled campaign becomes one open defect for the Mayor, never a pile.
      if [ "$CHECK_ONLY" != "1" ] && { [ "$code" = "silent" ] || [ "$code" = "stale" ] || [ "$code" = "durable" ] || [ "$code" = "workflow_failed" ]; }; then
        prior=$(printf '%s' "$coord_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print((v.get("metadata") or {}).get("gc.campaign_liveness_bead", ""))
except Exception:
    print("")')
        still_open=0
        if [ -n "$prior" ]; then
          prior_status=$(gc bd show "$prior" --json 2>/dev/null | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print(v.get("status", ""))
except Exception:
    print("")')
          [ -n "$prior_status" ] && [ "$prior_status" != "closed" ] && still_open=1
        fi
        file_now=1
        current_anchor=""
        if [ "$code" = "stale" ]; then
          current_anchor=$(printf '%s' "$coord_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    meta = v.get("metadata") or {}
    print(meta.get("gc.campaign_progress_at") or meta.get("gc.campaign_watch_since") or "")
except Exception:
    print("")')
        elif [ "$code" = "workflow_failed" ]; then
          current_anchor=$(printf '%s' "$workflow_bead_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    meta = v.get("metadata") if isinstance(v, dict) else {}
    print("workflow:" + ":".join(str(x or "") for x in (
        v.get("id"), v.get("status"), meta.get("gc.outcome"), v.get("updated_at"))))
except Exception:
    print("")')
        fi
        if [ "$still_open" = "1" ]; then
          say "  liveness defect already filed: $prior"
          file_now=0
        elif [ "$code" = "stale" ] || [ "$code" = "workflow_failed" ]; then
          # Same idea as the mayor-session dedup above: compare against the
          # anchor recorded when the prior defect was filed, not merely
          # whether it is closed -- a stall diagnosed and closed with the
          # cause still true must cool down, but a genuinely new stall (the
          # anchor moved: real progress happened, then it stalled again)
          # still files immediately.
          prior_anchor=$(printf '%s' "$coord_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print((v.get("metadata") or {}).get("gc.campaign_liveness_anchor", ""))
except Exception:
    print("")')
          if [ -n "$prior" ] && [ -n "$current_anchor" ] && [ "$current_anchor" = "$prior_anchor" ]; then
            cooldown_until_raw=$(printf '%s' "$coord_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print((v.get("metadata") or {}).get("gc.campaign_liveness_cooldown_until", ""))
except Exception:
    print("")')
            decision=$(COOLDOWN_UNTIL="$cooldown_until_raw" COOLDOWN_MINUTES="$LIVENESS_COOLDOWN_MINUTES" \
              FACTORY_GUARD_NOW="${FACTORY_GUARD_NOW:-}" python3 -c '
import os, time
from datetime import datetime, timezone, timedelta

def epoch(text):
    text = (text or "").strip()
    if not text:
        return None
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None

cooldown_until = epoch(os.environ.get("COOLDOWN_UNTIL"))
minutes = int(os.environ.get("COOLDOWN_MINUTES") or 60)
now = float(os.environ.get("FACTORY_GUARD_NOW") or time.time())

if cooldown_until is None:
    new_until = datetime.fromtimestamp(now, timezone.utc) + timedelta(minutes=minutes)
    print("defer_arm\t" + new_until.strftime("%Y-%m-%dT%H:%M:%SZ"))
elif now < cooldown_until:
    print("cooldown_active")
else:
    print("file")
')
            decision_action=$(printf '%s' "$decision" | cut -f1)
            if [ "$decision_action" = "cooldown_active" ]; then
              file_now=0
              say "  liveness known cause already diagnosed ($prior) — cooldown active until $cooldown_until_raw"
            elif [ "$decision_action" = "defer_arm" ]; then
              file_now=0
              new_until=$(printf '%s' "$decision" | cut -f2-)
              gc bd update "$COORD" --set-metadata "gc.campaign_liveness_cooldown_until=$new_until" >/dev/null 2>&1 || true
              say "  liveness known cause already diagnosed ($prior) — deferring next check until $new_until"
            fi
          fi
        fi
        if [ "$file_now" = "1" ]; then
          created=$(gc bd create "Campagne vivante mais immobile — diagnostiquer" \
            -p 1 -t bug \
            -d "Détecté par factory-guard (vivacité, ADR-0016 §5.3) : $msg. Diagnostiquer pourquoi la campagne n'avance plus — sentinelle, file produit, échelle d'inactivité, Mayor qui ne réagit pas — puis réparer ou documenter, et fermer ce bead avec la cause." \
            --json 2>/dev/null | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print(v.get("id", ""))
except Exception:
    print("")')
          if [ -n "$created" ]; then
            gc bd update "$COORD" --set-metadata "gc.campaign_liveness_bead=$created" >/dev/null 2>&1 || true
            if [ "$code" = "stale" ] || [ "$code" = "workflow_failed" ]; then
              # Record what this filing was diagnosing, and clear any expired
              # cooldown, so the dedup above has a clean anchor/cooldown pair
              # to compare the next tick against.
              gc bd update "$COORD" --set-metadata "gc.campaign_liveness_anchor=$current_anchor" >/dev/null 2>&1 || true
              gc bd update "$COORD" --set-metadata "gc.campaign_liveness_cooldown_until=" >/dev/null 2>&1 || true
            fi
            # Incident 2026-09-16 gap 1: a filed defect nobody is nudged to read
            # is equivalent to silence. Page the Mayor at filing time instead of
            # waiting for its next natural pause; factory-watchdog re-nudges on
            # a cooldown for as long as this stays open.
            gc mail send mayor --notify \
              -s "Liveness defect filed: $created" \
              -m "ACTION: factory-guard detected the campaign is not advancing and filed a defect
STATE: $msg
EVIDENCE: gc bd show $created
NEXT: diagnose why the campaign is not advancing, then close $created with the cause" \
              >/dev/null 2>&1 || true
            did "filed liveness defect $created for the Mayor and paged it"
            if [ "$code" = "durable" ]; then
              # C2: three consecutive sentinel crashes is not "the Mayor is
              # slow", it is "the mechanism itself may be broken" -- the one
              # escalation contract applies: gc.needs_benjamin, mail human, and
              # a cockpit-visible cause, together, once, at filing time.
              # ADR-0023: campaign-pointer is the door for gc.needs_benjamin;
              # this used to write it directly, which is exactly the kind of
              # hand-write the coordination-root pointers had no door for.
              CAMPAIGN_POINTER="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/campaign-pointer"
              [ -x "$CAMPAIGN_POINTER" ] && \
                "$CAMPAIGN_POINTER" escalate "$COORD" "Défaillance durable de la campagne: $msg" \
                  >/dev/null 2>&1 || true
            fi
          else
            bad "could not file the liveness defect"
          fi
        fi
      fi
      ;;
  esac

  # --- 7a. mayor session down (asleep/quarantined), page once per streak ----
  # af-9ur0s: naming the cause in the message above is not the same as acting
  # on it. A Mayor sitting asleep/quarantined for a while cannot receive the
  # "mail send mayor" page above either, so this pages
  # GC_ESCALATION_RECIPIENT (human by default) directly instead, the same
  # door section 7b uses for a session stuck at creating/failed-create.
  # Dedup key is the session's own last_active: it changes exactly when the
  # session moves (a fresh down streak, or recovery then a new one), so this
  # pages once per streak without a separate cooldown timer to maintain.
  if [ "$CHECK_ONLY" != "1" ]; then
    page_since=$(FACTORY_LIVENESS_MAYOR_SESSION_JSON="$mayor_session_json" \
      python3 "$GUARD_LIB/factory_liveness.py" --mayor-page-check 2>/dev/null || true)
    if [ -n "$page_since" ]; then
      prior_paged=$(printf '%s' "$coord_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print((v.get("metadata") or {}).get("gc.mayor_session_down_paged_since", ""))
except Exception:
    print("")')
      if [ "$prior_paged" != "$page_since" ]; then
        mayor_state=$(printf '%s' "$mayor_session_json" | python3 -c 'import json,sys
try:
    print((json.load(sys.stdin) or {}).get("state") or "")
except Exception:
    print("")')
        gc mail send "${GC_ESCALATION_RECIPIENT:-human}" --notify \
          -s "Mayor session down: $mayor_state" \
          -m "ACTION: factory-guard detected the named mayor session is $mayor_state and has been for over 10 minutes
STATE: $mayor_state since $page_since
EVIDENCE: gc session list --json; gc bd show $COORD
NEXT: diagnose why the Mayor session cannot stay active (provider, quota, host), then restart or repair it" \
          >/dev/null 2>&1 || true
        gc bd update "$COORD" --set-metadata "gc.mayor_session_down_paged_since=$page_since" >/dev/null 2>&1 || true
        did "paged ${GC_ESCALATION_RECIPIENT:-human}: mayor session $mayor_state since $page_since"
      fi
    fi
  fi
fi

# --- 7b. named-session boot liveness, distinct from campaign progress -------
# (af-jj9u7 / af-88za4) On 2026-09-18 the Mayor session could not boot for
# hours -- provider-failover resolved it to a provider that hard-rejected
# every attempt with an error shape the detection regexes did not recognise,
# so the named session cycled creating -> failed-create -> creating forever.
# Section 7 above never caught it: campaign-progress liveness only asks "is
# the campaign advancing", a question a Mayor that cannot boot cannot even
# begin to answer, so the idle ladder kept nagging a session that could not
# physically receive the nag. This reads the same identity's session-boot
# events straight from `gc events` (no coordination bead involved) and
# lib/factory_session_boot.py holds the streak-detection rules.
SESSION_BOOT_MINUTES="${FACTORY_SESSION_BOOT_MINUTES:-15}"
SESSION_BOOT_WINDOW_MINUTES="${FACTORY_SESSION_BOOT_WINDOW_MINUTES:-60}"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 \
   || [ ! -f "$GUARD_LIB/factory_session_boot.py" ]; then
  say "· session-boot — not checked (not a city root, or gc unavailable)"
else
  # `--city` is required here, not cosmetic: without it, `gc events` falls
  # back to SUPERVISOR-scoped events (every city on the host, not just this
  # one) whenever city discovery from cwd fails -- a throwaway/test city
  # trips that fallback and silently queries live production event data
  # instead of erroring. Pinning `--city "$ROOT"` makes an unscopeable city
  # fail fast instead.
  boot_events=$(gc events --city "$ROOT" --since "${SESSION_BOOT_WINDOW_MINUTES}m" \
    --payload-match "bead.metadata.configured_named_mode=always" 2>/dev/null || true)
  boot_verdicts=$(printf '%s' "$boot_events" \
    | FACTORY_SESSION_BOOT_MINUTES="$SESSION_BOOT_MINUTES" python3 "$GUARD_LIB/factory_session_boot.py" 2>/dev/null || true)
  if [ -z "$boot_verdicts" ]; then
    say "· session-boot — no named always-on sessions observed in the last ${SESSION_BOOT_WINDOW_MINUTES}m"
  else
    while IFS=$'\t' read -r identity level code message; do
      [ -z "$identity" ] && continue
      case "$level" in
        ok)   say "✓ session-boot — $message" ;;
        info) say "· session-boot — $message" ;;
        *)
          bad "session-boot — $message"
          if [ "$CHECK_ONLY" != "1" ] && [ "$code" = "session-boot-stuck" ]; then
            ptr_key="gc.session_boot_stuck_bead.$identity"
            prior=""
            if [ -n "${coord_json:-}" ]; then
              prior=$(printf '%s' "$coord_json" | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print((v.get("metadata") or {}).get("'"$ptr_key"'", ""))
except Exception:
    print("")')
            fi
            still_open=0
            if [ -n "$prior" ]; then
              prior_status=$(gc bd show "$prior" --json 2>/dev/null | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print(v.get("status", ""))
except Exception:
    print("")')
              [ -n "$prior_status" ] && [ "$prior_status" != "closed" ] && still_open=1
            fi
            if [ "$still_open" = "1" ]; then
              say "  session-boot-stuck defect already filed: $prior"
            else
              created=$(gc bd create "Session bloquée au démarrage — $identity" \
                -p 1 -t bug \
                -d "Détecté par factory-guard (démarrage de session, af-jj9u7) : $message. La session nommée toujours-active « $identity » n'arrive pas à démarrer -- ce n'est pas un problème de progression de campagne (section 7), c'est que l'orchestrateur lui-même ne peut pas s'initialiser. Diagnostiquer la cause (config fournisseur, ressources hôte, autre) via gc events et provider-state.json, puis réparer ou documenter, et fermer ce bead avec la cause." \
                --json 2>/dev/null | python3 -c '
import json, sys
try:
    v = json.load(sys.stdin)
    v = v[0] if isinstance(v, list) else v
    print(v.get("id", ""))
except Exception:
    print("")')
              if [ -n "$created" ]; then
                [ -n "$COORD" ] && gc bd update "$COORD" --set-metadata "$ptr_key=$created" >/dev/null 2>&1 || true
                # The stuck identity may itself be the Mayor and unreachable,
                # so this pages the human directly rather than routing
                # through the orchestrator that cannot boot to read it.
                gc mail send "${GC_ESCALATION_RECIPIENT:-human}" --notify \
                  -s "Session boot stuck: $identity ($created)" \
                  -m "ACTION: factory-guard detected a named always-on session cannot boot and filed a defect
STATE: $message
EVIDENCE: gc bd show $created
NEXT: diagnose why $identity cannot boot (provider config, host resources, other), then fix and close $created with the cause" \
                  >/dev/null 2>&1 || true
                did "filed session-boot-stuck defect $created for $identity and paged ${GC_ESCALATION_RECIPIENT:-human}"
              else
                bad "could not file the session-boot-stuck defect for $identity"
              fi
            fi
          fi
          ;;
      esac
    done <<< "$boot_verdicts"
  fi
fi

# --- 7c. campaign coordination repair (ADR-0023, af-hihkg) ------------------
# 2026-09-18 08:43Z: gc.campaign_candidate was found missing on the
# coordination Bead while the automatic campaign was still marked active (a
# hand-write after ADR-0023's own write-door landed -- PR #114); gc.current*
# held empty strings instead of "none". The sentinel then dies with "Une
# campagne active doit exposer sa condition et son candidat d'autorisation"
# and `mayor-campaign activate` refuses to touch an already-active campaign,
# so no door could repair it -- the PO restored the field by hand at 08:58Z,
# exactly the write ADR-0023 exists to end. `mayor-campaign repair --mayor`
# is that door: it restores gc.campaign_candidate/condition from the last
# valid pair recorded at every successful activate/resume, normalises
# empty-string coordination pointers to "none", and blocks the campaign
# (kind admin) instead of guessing when no last valid pair is on record. It
# is a no-op when nothing needs fixing, so this check calls it every run and
# only reports/pages when it actually changed something.
MAYOR_CAMPAIGN="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/mayor-campaign"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 || [ ! -x "$MAYOR_CAMPAIGN" ]; then
  say "· campaign-repair — not checked (not a city root, or gc unavailable)"
elif [ "$CHECK_ONLY" = "1" ]; then
  say "· campaign-repair — not checked (--check-only never invokes a --mayor door)"
else
  CR_OUTPUT=$("$MAYOR_CAMPAIGN" repair --mayor 2>&1)
  CR_STATUS=$?
  CR_FIXED=$(printf '%s\n' "$CR_OUTPUT" | grep '^FIXED: ' || true)
  if [ "$CR_STATUS" -ne 0 ]; then
    bad "campaign-repair: mayor-campaign repair failed: $(printf '%s' "$CR_OUTPUT" | tr '\n' ' ')"
  elif [ -n "$CR_FIXED" ]; then
    while IFS= read -r cr_line; do
      [ -z "$cr_line" ] && continue
      cr_detail="${cr_line#FIXED: }"
      bad "campaign-repair: coordination bead needed repair: $cr_detail"
      did "campaign-repair: $cr_detail"
    done <<<"$CR_FIXED"
    gc mail send mayor --notify \
      -s "Campaign coordination repaired" \
      -m "ACTION: factory-guard ran mayor-campaign repair --mayor
STATE: $(printf '%s' "$CR_FIXED" | tr '\n' '; ')
EVIDENCE: gc bd show ${CAMPAIGN_COORDINATION_BEAD:-af-1vr4}
NEXT: confirm the repaired candidate/condition are correct; investigate why they went missing if this repeats" \
      >/dev/null 2>&1
  else
    say "✓ campaign-repair — coordination candidate/condition intact"
  fi
fi

# --- 8. delivery-bead proof-field completeness (ADR-0016 s5.3 invariant 2) --
# bin/deliver-close is the only sanctioned door for CLOSING a delivery bead,
# and it already refuses to write without independently verifying a merged
# PR first. Nothing used to check the door OUT — a raw `gc bd close` bypasses
# deliver-close entirely, which is exactly what happened to delivery bead
# af-7700 on 2026-09-16: closed with none of the six proof fields set, which
# silently blocked mayor-campaign status / product-status (both read those
# fields off the last delivered bead) for about half a day before anyone
# noticed. bin/factory-delivery-guard is that missing check: it backfills
# proof fields it can independently verify via `gh pr view`, and flags (once,
# never repeatedly) whatever it cannot verify. See that script and
# lib/factory_delivery_proof.py for the exact rules.
DELIVERY_GUARD="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/factory-delivery-guard"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 || ! command -v gh >/dev/null 2>&1 \
   || [ ! -x "$DELIVERY_GUARD" ]; then
  say "· delivery-proof — not checked (not a city root, or gc/gh unavailable)"
else
  DG_ARGS=()
  [ "$CHECK_ONLY" = "1" ] && DG_ARGS+=(--check-only)
  DG_OUTPUT=$(FACTORY_ROOT="$ROOT" "$DELIVERY_GUARD" "${DG_ARGS[@]}" 2>&1)
  DG_STATUS=$?
  [ "$QUIET" = "1" ] || printf '%s\n' "$DG_OUTPUT" | sed 's/^/  /'
  DG_PROBLEM_COUNT=0
  while IFS= read -r raw_line; do
    line="${raw_line#"${raw_line%%[![:space:]]*}"}"  # strip leading whitespace
    case "$line" in
      REPAIRED:\ *) ACTIONS+=("delivery-proof: ${line#REPAIRED: }") ;;
      !\ *)         PROBLEMS+=("delivery-proof: ${line#! }"); STATUS=1; DG_PROBLEM_COUNT=$((DG_PROBLEM_COUNT+1)) ;;
    esac
  done <<<"$DG_OUTPUT"
  if [ "$DG_STATUS" -ne 0 ] && [ "$DG_PROBLEM_COUNT" -eq 0 ]; then
    PROBLEMS+=("delivery-proof: factory-delivery-guard exited $DG_STATUS with no problem line captured")
    STATUS=1
  fi
fi

# --- 9. product-queue candidate status drift (af-tbkcc, ADR-0005) -----------
# A candidate's status is only ever supposed to change through
# product-queue's own commands. bin/factory-queue-guard detects a candidate
# whose status contradicts its gc.queue_state (someone edited it directly),
# restores status=deferred when no execution Bead is linked, and pages the
# Mayor once per drift instead of repeatedly. See that script for detail.
QUEUE_GUARD="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/factory-queue-guard"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 || [ ! -x "$QUEUE_GUARD" ]; then
  say "· queue-drift — not checked (not a city root, or gc unavailable)"
else
  QG_ARGS=()
  [ "$CHECK_ONLY" = "1" ] && QG_ARGS+=(--check-only)
  QG_OUTPUT=$(FACTORY_ROOT="$ROOT" "$QUEUE_GUARD" "${QG_ARGS[@]}" 2>&1)
  QG_STATUS=$?
  [ "$QUIET" = "1" ] || printf '%s\n' "$QG_OUTPUT" | sed 's/^/  /'
  QG_PROBLEM_COUNT=0
  while IFS= read -r raw_line; do
    line="${raw_line#"${raw_line%%[![:space:]]*}"}"  # strip leading whitespace
    case "$line" in
      REPAIRED:\ *) ACTIONS+=("queue-drift: ${line#REPAIRED: }") ;;
      !\ *)         PROBLEMS+=("queue-drift: ${line#! }"); STATUS=1; QG_PROBLEM_COUNT=$((QG_PROBLEM_COUNT+1)) ;;
    esac
  done <<<"$QG_OUTPUT"
  if [ "$QG_STATUS" -ne 0 ] && [ "$QG_PROBLEM_COUNT" -eq 0 ]; then
    PROBLEMS+=("queue-drift: factory-queue-guard exited $QG_STATUS with no problem line captured")
    STATUS=1
  fi
fi

# --- 10. dispatch drift: a slung bead invisible to its target (af-33a4e) ----
# `gc sling <target> <bead>` does not clear a pre-existing assignee unless
# --reassign is passed, and a pool target's own claim query keys off
# assignee -- so a bead can report "routed" while sitting invisible to the
# target for hours. bin/factory-dispatch-guard detects a routed bead whose
# assignee is stale and mismatched, clears it, and pages the Mayor once per
# drift. See that script for detail.
DISPATCH_GUARD="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/factory-dispatch-guard"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 || [ ! -x "$DISPATCH_GUARD" ]; then
  say "· dispatch-drift — not checked (not a city root, or gc unavailable)"
else
  DPG_ARGS=()
  [ "$CHECK_ONLY" = "1" ] && DPG_ARGS+=(--check-only)
  DPG_OUTPUT=$(FACTORY_ROOT="$ROOT" "$DISPATCH_GUARD" "${DPG_ARGS[@]}" 2>&1)
  DPG_STATUS=$?
  [ "$QUIET" = "1" ] || printf '%s\n' "$DPG_OUTPUT" | sed 's/^/  /'
  DPG_PROBLEM_COUNT=0
  while IFS= read -r raw_line; do
    line="${raw_line#"${raw_line%%[![:space:]]*}"}"  # strip leading whitespace
    case "$line" in
      REPAIRED:\ *) ACTIONS+=("dispatch-drift: ${line#REPAIRED: }") ;;
      !\ *)         PROBLEMS+=("dispatch-drift: ${line#! }"); STATUS=1; DPG_PROBLEM_COUNT=$((DPG_PROBLEM_COUNT+1)) ;;
    esac
  done <<<"$DPG_OUTPUT"
  if [ "$DPG_STATUS" -ne 0 ] && [ "$DPG_PROBLEM_COUNT" -eq 0 ]; then
    PROBLEMS+=("dispatch-drift: factory-dispatch-guard exited $DPG_STATUS with no problem line captured")
    STATUS=1
  fi
fi

# --- 11. stale gc.waiting_on (af-atyry) --------------------------------------
# gc.waiting_on keeps a bead out of the idle ladder (lib/factory_campaign.py
# is_ladder_bead) unconditionally -- nothing used to clear it when the bead
# it names closed, so "waiting on something" silently became "waiting
# forever" (af-p4v9v sat excluded 14+ hours after the bead it waited on
# merged). bin/factory-waiting-guard clears gc.waiting_on once its target is
# terminal and, for PR-backed work, carries coherent merge+exact-head-CI proof.
# It reports when structural proof is rejected, reports once (never repeatedly)
# when the target does not resolve, and leaves free-text waits untouched.
WAITING_GUARD="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/factory-waiting-guard"
if [ ! -f "$ROOT/city.toml" ] || ! command -v gc >/dev/null 2>&1 || [ ! -x "$WAITING_GUARD" ]; then
  say "· waiting-drift — not checked (not a city root, or gc unavailable)"
else
  WG_ARGS=()
  [ "$CHECK_ONLY" = "1" ] && WG_ARGS+=(--check-only)
  WG_OUTPUT=$(FACTORY_ROOT="$ROOT" "$WAITING_GUARD" "${WG_ARGS[@]}" 2>&1)
  WG_STATUS=$?
  [ "$QUIET" = "1" ] || printf '%s\n' "$WG_OUTPUT" | sed 's/^/  /'
  WG_PROBLEM_COUNT=0
  while IFS= read -r raw_line; do
    line="${raw_line#"${raw_line%%[![:space:]]*}"}"  # strip leading whitespace
    case "$line" in
      REPAIRED:\ *) ACTIONS+=("waiting-drift: ${line#REPAIRED: }") ;;
      !\ *)         PROBLEMS+=("waiting-drift: ${line#! }"); STATUS=1; WG_PROBLEM_COUNT=$((WG_PROBLEM_COUNT+1)) ;;
    esac
  done <<<"$WG_OUTPUT"
  if [ "$WG_STATUS" -ne 0 ] && [ "$WG_PROBLEM_COUNT" -eq 0 ]; then
    PROBLEMS+=("waiting-drift: factory-waiting-guard exited $WG_STATUS with no problem line captured")
    STATUS=1
  fi
fi

# --- report ------------------------------------------------------------------
say ""
if [ "${#ACTIONS[@]}" -gt 0 ]; then say "repaired ${#ACTIONS[@]}:"; printf '  - %s\n' "${ACTIONS[@]}"; fi
if [ "${#PROBLEMS[@]}" -gt 0 ]; then
  say "UNRESOLVED ${#PROBLEMS[@]}:"; printf '  ! %s\n' "${PROBLEMS[@]}"
else
  say "healthy"
fi
# O2: this guard runs as a zero-token cooldown order (orders/factory-guard.toml).
# It used to exit 1 whenever it FOUND something -- routine, already-repaired or
# not -- which is indistinguishable from the order itself crashing, and floods
# Gas City's order.failed stream with noise (see O1). "Found" is reported above
# in stdout (UNRESOLVED ... / the exit code below); only the two explicit exit 2
# paths above (bad CLI argument, unreachable root) mean the guard itself broke.
exit 0
