#!/usr/bin/env python3
"""provider-failover — keep every agent on a model provider that can work.

L0, deterministic, zero model tokens. Runs every two minutes as an order.

  tick     look at every live model session, record any quota wall it shows,
           probe any pool held for a credential error (category=auth) against
           its credential file and clear it the moment that file changes
           (af-zdiln -- never wait out the hold for a fixed login), choose a
           provider per target, write city.provider.toml, reload the city if
           that changed, and restart sessions stuck on an exhausted pool.
           Also runs exhaustion_gate (O08, af-harft): when every pool is
           exhausted or erroring, files one bead and escalates it straight
           to Benjamin (bin/dispatch-door then refuses new work); the
           moment a provider is available again the bead closes and the
           pause clears automatically, no human action needed.
  apply    regenerate city.provider.toml from the current state (no detection)
  status   what is chosen and why (--json for scripts)
  check-models  daily (not per-tick): compare the model id configured for each
           provider in city.toml against config/model-catalog.json's
           recommended list. On drift, file a bead and mail the Mayor -- never
           switches a model itself, that stays a human/PO call (af-a1t44,
           ADR-0018).
  set      one manual control -- the only supported way to change providers:
             set --action mark    --args '{"pool":"openai","until":"2026-09-21T05:22:00Z"}'
             set --action clear   --args '{"pool":"openai"}'
             set --action disable --args '{"provider":"codex","reason":"..."}'
             set --action enable  --args '{"provider":"codex"}'
             set --action force   --args '{"target":"mayor","provider":"claude"}'   (provider "auto" undoes it)
             set --action chain   --args '{"target":"workspace","chain":["claude","codex"]}'  ("default" undoes it)
             set --action auto    --args '{"enabled":false}'

Policy: config/provider-policy.json (versioned). State: .gc/provider-state.json
(host-local). Design and rules: ADR-0018 (pre-refactor: active mechanism, not
re-validated).
"""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from bounded_process import run as bounded_run  # noqa: E402
import provider_failover as pf  # noqa: E402

FACTORY_ROOT = Path(os.environ.get("FACTORY_ROOT") or ROOT)
POLICY_FILE = Path(os.environ.get("PROVIDER_POLICY_FILE") or FACTORY_ROOT / "config" / "provider-policy.json")
STATE_FILE = Path(os.environ.get("PROVIDER_STATE_FILE") or FACTORY_ROOT / ".gc" / "provider-state.json")
OVERLAY_FILE = Path(os.environ.get("PROVIDER_OVERLAY_FILE") or FACTORY_ROOT / "city.provider.toml")
MODEL_CATALOG_FILE = Path(os.environ.get("MODEL_CATALOG_FILE") or FACTORY_ROOT / "config" / "model-catalog.json")
CITY_TOML_FILE = Path(os.environ.get("CITY_TOML_FILE") or FACTORY_ROOT / "city.toml")
GC_BIN = os.environ.get("GC_BIN", "gc")
# Reading a pane through `gc session peek` cost 8 s and ~5 s of CPU per call on
# 2026-09-16: one tick took 54 s wall, 22 s CPU, every two minutes. tmux
# answers the same question in milliseconds, so it is tried first; gc stays
# the fallback for any runtime that is not tmux.
TMUX_BIN = os.environ.get("PROVIDER_TMUX_BIN", "tmux")
TMUX_SOCKET = os.environ.get("PROVIDER_TMUX_SOCKET") or FACTORY_ROOT.name
# af-zdiln: the cheap, zero-token, local probe for "is the credential problem
# fixed yet". Each pool's error marking (category=auth) carries a fingerprint
# of the file below, taken when the error was first seen; a tick that finds
# the file has changed since clears the marking immediately instead of
# waiting out the hold. Never an API call -- a genuinely broken/rate-limited
# provider must not be hammered.
CLAUDE_CREDENTIALS_FILE = Path(os.environ.get("CLAUDE_CREDENTIALS_FILE") or
                               Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
                               / ".credentials.json")
CODEX_AUTH_FILE = Path(os.environ.get("CODEX_AUTH_FILE") or
                       Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex") / "auth.json")
CREDENTIAL_FILES = {
    "anthropic": CLAUDE_CREDENTIALS_FILE,
    "openai": CODEX_AUTH_FILE,
}


def local_tz() -> str:
    override = os.environ.get("PROVIDER_LOCAL_TZ")
    if override:
        return override
    try:
        return Path("/etc/timezone").read_text(encoding="utf-8").strip() or "Europe/Paris"
    except OSError:
        return "Europe/Paris"


def now() -> float:
    value = os.environ.get("PROVIDER_NOW")
    return float(value) if value else time.time()


def gc(*args: str, timeout: int = 30) -> subprocess.CompletedProcess[str]:
    return bounded_run(
        [GC_BIN, *args], cwd=FACTORY_ROOT, text=True, capture_output=True,
        timeout=timeout, env={**os.environ, "NO_COLOR": "1"},
    )


def escalation_door(*args: str, timeout: int = 30) -> subprocess.CompletedProcess[str]:
    return bounded_run(
        [str(ROOT / "bin" / "escalation-door"), *args], cwd=FACTORY_ROOT, text=True, capture_output=True,
        timeout=timeout, env={**os.environ, "NO_COLOR": "1"},
    )


def operator_language() -> str:
    try:
        result = bounded_run(
            [str(ROOT / "bin" / "operator-config"), "language"],
            text=True, capture_output=True, timeout=10,
        )
        value = (result.stdout or "").strip()
        return value if result.returncode == 0 and value else "fr"
    except (OSError, subprocess.SubprocessError):
        return "fr"


def escalation_payload(quoi: str, pourquoi: str, option: str, consequence: str) -> str:
    """The JSON escalation-door's `benjamin` command requires (T06, C01
    Cockpit V2): quoi / pourquoi / que_faire (one option here, with its
    consequence) / the Operator Language. Machine events use fixed French
    phrases, not a translated English string."""
    if len(quoi) > 140:
        quoi = quoi[:139] + "…"
    return json.dumps({
        "quoi": quoi,
        "pourquoi": pourquoi,
        "que_faire": [{"option": option, "consequence": consequence}],
        "langue": operator_language(),
    })


def load_policy() -> dict[str, Any]:
    try:
        return pf.validate_policy(json.loads(POLICY_FILE.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError) as exc:
        raise pf.PolicyError(f"cannot read {POLICY_FILE}: {exc}") from exc


def load_catalog() -> dict[str, Any]:
    try:
        return pf.validate_catalog(json.loads(MODEL_CATALOG_FILE.read_text(encoding="utf-8")))
    except (OSError, json.JSONDecodeError) as exc:
        raise pf.PolicyError(f"cannot read {MODEL_CATALOG_FILE}: {exc}") from exc


def load_city_providers() -> dict[str, Any]:
    try:
        data = tomllib.loads(CITY_TOML_FILE.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise pf.PolicyError(f"cannot read {CITY_TOML_FILE}: {exc}") from exc
    providers = data.get("providers")
    return providers if isinstance(providers, dict) else {}


def load_state(policy: dict[str, Any]) -> dict[str, Any]:
    try:
        raw = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        raw = None  # a missing or damaged state degrades to defaults, never fails
    return pf.normalize_state(raw, policy)


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def save_state(state: dict[str, Any]) -> None:
    atomic_write(STATE_FILE, json.dumps(state, ensure_ascii=False, indent=2) + "\n")


class Locked:
    """One writer at a time: the order and a human can both call in."""

    def __enter__(self) -> "Locked":
        STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        self.handle = open(STATE_FILE.with_name(STATE_FILE.name + ".lock"), "w")
        fcntl.flock(self.handle, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc: Any) -> None:
        fcntl.flock(self.handle, fcntl.LOCK_UN)
        self.handle.close()


def live_sessions() -> list[dict[str, Any]]:
    try:
        result = gc("session", "list", "--json")
        value = json.loads(result.stdout or "[]")
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return []
    if isinstance(value, dict):
        value = value.get("sessions") or []
    return [s for s in value if isinstance(s, dict) and s.get("state") == "active"]


def pane_text(session: dict[str, Any]) -> str:
    name = str(session.get("session_name") or "").strip()
    if name:
        try:
            result = bounded_run(
                [TMUX_BIN, "-L", TMUX_SOCKET, "capture-pane", "-p", "-J",
                 "-t", f"={name}:", "-S", "-60"],
                text=True, capture_output=True, timeout=5,
            )
            if result.returncode == 0:
                return result.stdout
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        return gc("session", "peek", str(session.get("id")), timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def write_overlay(policy: dict[str, Any], state: dict[str, Any], resolution: dict[str, Any],
                  moment: float, dry_run: bool) -> tuple[bool, list[str]]:
    text, effective = pf.render_overlay(policy, resolution, state.get("effective") or {})
    try:
        current = OVERLAY_FILE.read_text(encoding="utf-8")
    except OSError:
        current = None
    switches = []
    previous = state.get("effective") or {}
    for target, provider in effective.items():
        if previous.get(target) and previous[target] != provider:
            why = resolution[target]["reason"]
            switches.append(f"{target}: {previous[target]} → {provider} ({why})")
    changed = current != text
    if changed and not dry_run:
        atomic_write(OVERLAY_FILE, text)
    for line in switches:
        pf.note(state, moment, "switch", line)
    state["effective"] = effective
    return changed, switches


def credential_fingerprint(pool: str) -> str | None:
    """A cheap, local, zero-token stand-in for "did the credential change".

    mtime + size, never the content: good enough to notice a re-login
    rewrote the file, without ever reading a secret.
    """
    path = CREDENTIAL_FILES.get(pool)
    if path is None:
        return None
    try:
        st = path.stat()
    except OSError:
        return None
    return f"{st.st_mtime_ns}:{st.st_size}"


def probe_auth_recovery(state: dict[str, Any], moment: float) -> list[str]:
    """Clear a pool's error/auth marking as soon as its credential file changes.

    Only category=auth is probed this way (af-zdiln): a fixed credential
    problem should recover fast, and the fingerprint is a reliable, cheap
    signal for it. No blind clear -- absent or unchanged evidence leaves the
    marking exactly where record_detection put it.
    """
    messages = []
    for pool, entry in list(state.get("pools", {}).items()):
        if entry.get("status") != "error" or entry.get("category") != "auth":
            continue
        baseline = entry.get("auth_fingerprint")
        current = credential_fingerprint(pool)
        if current is None or current == baseline:
            continue
        state["pools"].pop(pool, None)
        line = f"{pool}: credential file changed since the error was marked -- cleared"
        pf.note(state, moment, "auth-recovered", line)
        messages.append(line)
    return messages


def reload_city() -> str:
    try:
        result = gc("reload", timeout=90)
    except (OSError, subprocess.SubprocessError) as exc:
        return f"reload failed: {exc}"
    lines = (result.stdout or result.stderr or "").strip().splitlines()
    return lines[-1] if lines else "reloaded"


def exhaustion_gate(state: dict[str, Any], policy: dict[str, Any], moment: float, dry_run: bool) -> list[str]:
    """O08: edge-triggered pause/resume for total provider exhaustion.

    Entering the state files one bead and escalates it straight to Benjamin
    (dispatch-door then refuses new work while it reads active, af-harft) --
    never re-escalated while the same outage continues, so exactly one line
    lands on the NEEDS BENJAMIN list per outage. Leaving the state clears and
    closes that bead automatically: dispatch resumes the moment a provider
    is available again, with no human action required.
    """
    active_now = pf.total_exhaustion(state, policy, moment)
    tracked = dict(state.get("total_exhaustion") or {})
    was_active = bool(tracked.get("active"))
    messages: list[str] = []
    if active_now and not was_active:
        next_reset = pf.total_exhaustion_next_reset(state, policy, moment)
        detail = ("Total provider exhaustion: every pool is exhausted or erroring; dispatch is "
                 f"paused until {next_reset or 'a provider recovers'}.")
        pf.note(state, moment, "dispatch-paused", detail)
        bead_id = tracked.get("bead")
        if not dry_run:
            try:
                created = json.loads(gc("bd", "create", "Total provider exhaustion -- dispatch paused",
                                        "-p", "1", "-t", "task", "-d", detail, "--json", timeout=30).stdout or "null")
                if isinstance(created, list):
                    created = created[0] if created else None
                bead_id = (created or {}).get("id")
            except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
                bead_id = None
            if bead_id:
                payload = escalation_payload(
                    "Chaque fournisseur de modèle est épuisé ou en erreur : la livraison est en pause",
                    "Aucun agent ne peut relancer un fournisseur de modèle à ta place",
                    "Vérifier les fournisseurs et débloquer manuellement",
                    "La livraison reprend automatiquement dès qu'un fournisseur redevient disponible.",
                )
                escalation_door("benjamin", bead_id, payload, timeout=30)
        state["total_exhaustion"] = {"active": True, "since": pf.iso(moment), "bead": bead_id}
        messages.append(f"dispatch paused: {detail}" + (f" (bead {bead_id})" if bead_id else ""))
    elif not active_now and was_active:
        detail = "Provider available again -- dispatch resumes automatically."
        pf.note(state, moment, "dispatch-resumed", detail)
        bead_id = tracked.get("bead")
        if bead_id and not dry_run:
            escalation_door("clear", bead_id, timeout=30)
            gc("bd", "close", bead_id, "--reason",
               "Provider recovered; dispatch resumed automatically.", timeout=30)
        state["total_exhaustion"] = {"active": False, "since": None, "bead": None}
        messages.append(detail + (f" (bead {bead_id})" if bead_id else ""))
    return messages


def tick(args: argparse.Namespace) -> int:
    moment = now()
    policy = load_policy()
    with Locked():
        state = load_state(policy)
        stuck = []
        sessions = live_sessions()
        state["sessions"] = [
            {"id": x.get("id"), "alias": x.get("alias"), "template": x.get("template"),
             "provider": x.get("provider"), "target": pf.target_of(x, policy)}
            for x in sessions if pf.target_of(x, policy)
        ]
        state["sessions_at"] = pf.iso(moment)
        for session in sessions:
            provider = session.get("provider")
            if provider not in policy["providers"]:
                continue
            finding = pf.detect(pane_text(session), moment, local_tz())
            if not finding:
                continue
            pool = policy["providers"][provider]["pool"]
            if finding["kind"] == "provider_error" and finding.get("category") == "auth":
                finding = {**finding, "auth_fingerprint": credential_fingerprint(pool)}
            if pf.record_detection(state, policy, pool, finding, moment):
                pf.note(state, moment, f"detected:{finding['kind']}",
                        f"{session.get('alias') or session.get('id')} ({provider}) — {finding.get('evidence', '')[:160]}")
            if finding["kind"] in ("exhausted", "provider_error"):
                # A session stuck on a provider that is now erroring (auth,
                # network, 5xx -- af-s6fqv) needs the same restart-onto-the-
                # resolved-provider treatment as one stuck on a quota wall;
                # the pool is unusable either way.
                stuck.append(session)
        probed = probe_auth_recovery(state, moment)
        resolution = pf.resolve(policy, state, moment)
        changed, switches = write_overlay(policy, state, resolution, moment, args.dry_run)
        messages = list(probed) + list(switches)
        if changed and not args.dry_run:
            messages.append(f"overlay rewritten; {reload_city()}")
        messages += exhaustion_gate(state, policy, moment, args.dry_run)
        for session in stuck:
            target = pf.target_of(session, policy)
            chosen = resolution.get(target, {}).get("provider") if target else None
            if chosen and chosen != session.get("provider"):
                if not args.dry_run:
                    gc("session", "reset", str(session.get("id")), timeout=60)
                line = f"restarted {session.get('alias') or session.get('id')}: {session.get('provider')} → {chosen}"
                pf.note(state, moment, "restart", line)
                messages.append(line)
        if not args.dry_run:
            save_state(state)
    if not args.quiet or messages:
        for target, pick in resolution.items():
            print(f"{target:16} {pick['provider'] or '—':16} {pick['reason']}")
        for line in messages:
            print(f"  · {line}")
    return 0


def apply(args: argparse.Namespace) -> int:
    moment = now()
    policy = load_policy()
    with Locked():
        state = load_state(policy)
        resolution = pf.resolve(policy, state, moment)
        changed, switches = write_overlay(policy, state, resolution, moment, False)
        if changed and not args.no_reload:
            switches.append(reload_city())
        save_state(state)
    for line in switches:
        print(f"  · {line}")
    print("overlay " + ("written" if changed else "unchanged") + f": {OVERLAY_FILE}")
    return 0


def status_payload(policy: dict[str, Any], state: dict[str, Any], moment: float) -> dict[str, Any]:
    resolution = pf.resolve(policy, state, moment)
    # A caller may poll this often. It reads the sessions the last tick
    # saw (at most two minutes old) instead of asking gc each time.
    sessions = list(state.get("sessions") or [])
    return {
        "contract": "agent-factory-provider-status/v1",
        "generated_at": pf.iso(moment),
        "auto": state["auto"],
        "overlay_present": OVERLAY_FILE.exists(),
        "pools": {
            name: {"label": pool["label"], **pf.pool_status(state, policy, name, moment)}
            for name, pool in policy["pools"].items()
        },
        "providers": {
            name: {"label": p["label"], "tier": p.get("tier"),
                   **pf.provider_status(state, policy, name, moment)}
            for name, p in policy["providers"].items()
        },
        "targets": {
            name: {
                "label": t["label"], "why": t.get("why"),
                "default_chain": t["chain"],
                "chain_overridden": name in state["chains"],
                "forced": state["forced"].get(name),
                "effective": (state.get("effective") or {}).get(name),
                **resolution[name],
            }
            for name, t in policy["targets"].items()
        },
        "sessions": sessions,
        "sessions_at": state.get("sessions_at"),
        "total_exhaustion": {
            "active": pf.total_exhaustion(state, policy, moment),
            "since": (state.get("total_exhaustion") or {}).get("since"),
            "bead": (state.get("total_exhaustion") or {}).get("bead"),
            "next_reset": pf.total_exhaustion_next_reset(state, policy, moment),
        },
        "history": list(reversed(state["history"][-15:])),
    }


def status(args: argparse.Namespace) -> int:
    policy = load_policy()
    moment = now()
    payload = status_payload(policy, load_state(policy), moment)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False))
        return 0
    print(f"provider-failover — auto={'on' if payload['auto'] else 'OFF'}  overlay={'ok' if payload['overlay_present'] else 'MISSING'}")
    for name, pool in payload["pools"].items():
        extra = f" until {pool['until']}" if pool.get("until") else ""
        print(f"  pool {name:13} {pool['state']:10}{extra}  {pool.get('evidence') or ''}"[:160])
    for name, target in payload["targets"].items():
        print(f"  {name:16} → {target['provider'] or '—':16} ({target['reason']})  chain: {' › '.join(target['default_chain'] if not target['chain_overridden'] else [e['provider'] for e in target['chain']])}")
    return 0


def check_models(args: argparse.Namespace) -> int:
    """Daily, not per-tick: flag configured model ids the catalog no longer lists.

    Reads only; the only writes are the small bookkeeping in provider-state.json
    (last checked-at, last signature flagged, the bead filed for it) needed to
    avoid re-filing the same drift every day. Never touches city.toml,
    city.provider.toml, or the catalog itself -- switching a model stays a
    human/PO call (ADR-0018).
    """
    moment = now()
    catalog = load_catalog()
    policy = load_policy()
    configured = {
        name: model
        for name, cfg in load_city_providers().items()
        if (model := pf.configured_model(cfg))
    }
    stale = pf.stale_models(configured, catalog.get("providers", {}))
    signature = ",".join(f"{e['provider']}={e['configured']}" for e in stale)
    newly_filed = False
    with Locked():
        state = load_state(policy)
        previous = dict(state.get("model_staleness") or {})
        bead_id = previous.get("bead")
        if stale and signature != previous.get("signature"):
            def label(p: str) -> str:
                return policy["providers"].get(p, {}).get("label", p)
            lines = [f"- {label(e['provider'])} ({e['provider']}): configured "
                     f"'{e['configured']}', catalog recommends {', '.join(e['recommended'])}"
                     for e in stale]
            title = "Configured model id(s) look stale against config/model-catalog.json"
            body = (
                "Daily model-staleness check (ADR-0018 part 2, af-a1t44) found configured model "
                "id(s) not in config/model-catalog.json's recommended list for their provider.\n\n"
                + "\n".join(lines) +
                "\n\nThis is a surfaced decision only: nothing here switches a model. Either "
                "update config/model-catalog.json (by commit) if the provider's current/"
                "recommended list changed, or change the configured model via "
                "./bin/provider-failover set -- never by editing city.toml directly (AGENTS.md)."
            )
            bead_id = None
            if not args.dry_run:
                try:
                    created = json.loads(gc("bd", "create", title, "-p", "3", "-t", "task",
                                            "-d", body, "--json", timeout=30).stdout or "null")
                    if isinstance(created, list):
                        created = created[0] if created else None
                    bead_id = (created or {}).get("id")
                except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
                    bead_id = None
                if bead_id:
                    newly_filed = True
                    escalation_door("mayor", bead_id,
                                     f"model-staleness-check: configured model id(s) drifted from the "
                                     f"catalog ({signature})", timeout=30)
        if not args.dry_run:
            state["model_staleness"] = {"checked_at": pf.iso(moment), "signature": signature, "bead": bead_id}
            save_state(state)
    if stale:
        for e in stale:
            print(f"  · stale: {e['provider']} configured={e['configured']} recommended={','.join(e['recommended'])}")
        if newly_filed:
            print(f"  · bead filed: {bead_id}")
        elif bead_id:
            print(f"  · already flagged: {bead_id}")
        else:
            print("  · dry-run: would file a bead" if args.dry_run else "  · could not file a bead")
    elif not args.quiet:
        print("model staleness — every configured model id matches the catalog")
    return 0


def set_control(args: argparse.Namespace) -> int:
    policy = load_policy()
    try:
        control = json.loads(args.args or "{}")
    except json.JSONDecodeError:
        print(json.dumps({"ok": False, "error": "arguments JSON invalides"}))
        return 2
    if not isinstance(control, dict):
        print(json.dumps({"ok": False, "error": "arguments JSON invalides"}))
        return 2
    moment = now()
    with Locked():
        state = load_state(policy)
        try:
            summary = pf.apply_control(state, policy, args.action, control, moment, args.by[:60])
        except pf.PolicyError as exc:
            print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
            return 2
        resolution = pf.resolve(policy, state, moment)
        changed, switches = write_overlay(policy, state, resolution, moment, False)
        reload_note = reload_city() if changed and not args.no_reload else None
        save_state(state)
    print(json.dumps({"ok": True, "summary": summary, "switches": switches,
                      "reload": reload_note,
                      "status": status_payload(policy, load_state(policy), moment)},
                     ensure_ascii=False))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="provider-failover", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    t = sub.add_parser("tick")
    t.add_argument("--quiet", action="store_true")
    t.add_argument("--dry-run", action="store_true")
    a = sub.add_parser("apply")
    a.add_argument("--no-reload", action="store_true")
    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true")
    m = sub.add_parser("check-models")
    m.add_argument("--quiet", action="store_true")
    m.add_argument("--dry-run", action="store_true")
    c = sub.add_parser("set")
    c.add_argument("--action", required=True,
                   choices=["mark", "clear", "disable", "enable", "force", "chain", "auto"])
    c.add_argument("--args", default="{}")
    c.add_argument("--by", default="operator")
    c.add_argument("--no-reload", action="store_true")
    args = parser.parse_args()
    try:
        return {"tick": tick, "apply": apply, "status": status, "set": set_control,
                "check-models": check_models}[args.command](args)
    except pf.PolicyError as exc:
        print(f"provider-failover: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
