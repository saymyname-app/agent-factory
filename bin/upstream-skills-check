#!/usr/bin/env bash
# upstream-skills-check — daily upstream release check, plus a CI-facing
# byte-for-byte comparison of the vendored copy (W13/A6b af-hxc8ra; D01
# T02, Spec af-wf4w5r user story 74, AR-008).
#
# Default mode (no subcommand): compares the tags mattpocock/skills has
# published against the Method Baseline pinned in docs/UPSTREAM_SKILLS.md.
# It never updates a pin, a skill file, or any config -- switching the
# baseline stays a deliberate, by-hand change (docs/UPSTREAM_SKILLS.md's
# update procedure). When a tag newer than the last one this order flagged
# appears, it files exactly one `proposal`-labelled bead (never built
# without Benjamin, same discipline as bin/overlap-conflict-log's lease
# proposal) so it surfaces at the next session start via
# `./bin/escalation-door list`'s pending-proposal count. Seeing the same
# tag again on a later run never files a second proposal.
#
# `compare` mode: diffs the vendored skills/ directory, file for file,
# against the pinned tag's skills/ subtree fetched fresh from
# mattpocock/skills (AR-008). Exits 0 and names the tag when the copy is
# byte-identical. Exits non-zero and names the offending file on any
# modified, added, or removed file. Also exits non-zero when
# docs/ADAPTATION_REGISTER.md carries no entry naming the pinned tag: the
# comparison is itself one of the "contrôles ajoutés" that entry records.
#
# Usage: upstream-skills-check [--dry-run]
#        upstream-skills-check compare
#
# Test/override points (never set these in production):
#   GC_BIN                                  -- bd/gc binary (default: gc)
#   UPSTREAM_SKILLS_CHECK_REPO_URL          -- upstream repo to query
#   UPSTREAM_SKILLS_CHECK_BASELINE_FILE     -- where the pinned baseline lives
#   UPSTREAM_SKILLS_CHECK_STATE_FILE        -- where the last-flagged tag is recorded
#   UPSTREAM_SKILLS_CHECK_TAGS_FILE         -- a file of `git ls-remote --tags`
#                                              output to read instead of the network
#   UPSTREAM_SKILLS_CHECK_NOW               -- epoch seconds to stamp the state file with
#   UPSTREAM_SKILLS_CHECK_LOCAL_SKILLS_DIR  -- vendored skills/ directory to check (compare mode)
#   UPSTREAM_SKILLS_CHECK_REF_DIR           -- a local checkout of the upstream repo at the
#                                              pinned tag, to read instead of cloning (compare mode)
#   UPSTREAM_SKILLS_CHECK_ADAPTATION_REGISTER_FILE -- where the Adaptation Register lives (compare mode)
set -Eeuo pipefail

PROGRAM_NAME="upstream-skills-check"
GC_BIN="${GC_BIN:-gc}"
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P)"
PROPOSAL_DOOR_BIN="${PROPOSAL_DOOR_BIN:-$ROOT/bin/proposal-door}"
OPERATOR_CONFIG_BIN="${OPERATOR_CONFIG_BIN:-$ROOT/bin/operator-config}"

REPO_URL="${UPSTREAM_SKILLS_CHECK_REPO_URL:-https://github.com/mattpocock/skills}"
BASELINE_FILE="${UPSTREAM_SKILLS_CHECK_BASELINE_FILE:-$ROOT/docs/UPSTREAM_SKILLS.md}"
STATE_FILE="${UPSTREAM_SKILLS_CHECK_STATE_FILE:-$ROOT/.gc/runtime/upstream-skills-check-state.json}"
TAGS_FILE="${UPSTREAM_SKILLS_CHECK_TAGS_FILE:-}"
NOW="${UPSTREAM_SKILLS_CHECK_NOW:-$(date +%s)}"
LOCAL_SKILLS_DIR="${UPSTREAM_SKILLS_CHECK_LOCAL_SKILLS_DIR:-$ROOT/skills}"
REF_DIR="${UPSTREAM_SKILLS_CHECK_REF_DIR:-}"
ADAPTATION_REGISTER_FILE="${UPSTREAM_SKILLS_CHECK_ADAPTATION_REGISTER_FILE:-$ROOT/docs/ADAPTATION_REGISTER.md}"

log() { printf '%s: %s\n' "$PROGRAM_NAME" "$*"; }
die() { printf '%s: ERROR: %s\n' "$PROGRAM_NAME" "$*" >&2; exit 1; }

[ -f "$BASELINE_FILE" ] || die "no pinned baseline file at $BASELINE_FILE"

baseline_commit=$(sed -n 's/^Pinned baseline commit: `\{0,1\}\([0-9a-f]\{7,40\}\)`\{0,1\}.*/\1/p' "$BASELINE_FILE" | head -n1)
[ -n "$baseline_commit" ] || die "no 'Pinned baseline commit: <sha>' line found in $BASELINE_FILE"

if [ "${1:-}" = "compare" ]; then
  shift
  baseline_tag=$(sed -n 's/^Pinned baseline tag: `\{0,1\}\([^`]*\)`\{0,1\}.*/\1/p' "$BASELINE_FILE" | head -n1)
  [ -n "$baseline_tag" ] && [ "$baseline_tag" != "none" ] \
    || die "no 'Pinned baseline tag: <tag>' line found in $BASELINE_FILE"

  [ -d "$LOCAL_SKILLS_DIR" ] || die "no vendored skills directory at $LOCAL_SKILLS_DIR"

  [ -f "$ADAPTATION_REGISTER_FILE" ] || die "no Adaptation Register at $ADAPTATION_REGISTER_FILE"
  grep -qE "AR-[0-9]{3}.*${baseline_tag//./\\.}" "$ADAPTATION_REGISTER_FILE" \
    || die "$ADAPTATION_REGISTER_FILE carries no AR-NNN entry naming the pinned tag $baseline_tag -- record its reason there first"

  cleanup_ref_dir=""
  if [ -n "$REF_DIR" ]; then
    [ -d "$REF_DIR/skills" ] || die "reference directory $REF_DIR has no skills/ subtree"
  else
    REF_DIR=$(mktemp -d) || die "could not create a temp dir for the reference checkout"
    cleanup_ref_dir="$REF_DIR"
    trap '[ -n "$cleanup_ref_dir" ] && rm -rf -- "$cleanup_ref_dir"' EXIT
    if ! git clone --quiet --depth 1 --branch "$baseline_tag" "$REPO_URL" "$REF_DIR" >/dev/null 2>&1; then
      die "could not fetch tag $baseline_tag from $REPO_URL"
    fi
  fi

  mismatches=$(mktemp) || die "could not create a temp file"
  trap '[ -n "$cleanup_ref_dir" ] && rm -rf -- "$cleanup_ref_dir"; rm -f -- "$mismatches"' EXIT

  while IFS= read -r diff_line; do
    case "$diff_line" in
      "Files "*" and "*" differ")
        rel="${diff_line#Files $LOCAL_SKILLS_DIR/}"
        rel="${rel%% and *}"
        printf 'modified: skills/%s\n' "$rel" >>"$mismatches"
        ;;
      "Only in $LOCAL_SKILLS_DIR"*)
        rest="${diff_line#Only in $LOCAL_SKILLS_DIR}"
        rest="${rest#: }"
        dir_part="${rest%%: *}"
        file_part="${rest#*: }"
        if [ -n "$dir_part" ]; then
          printf 'added: skills%s/%s\n' "${dir_part#:}" "$file_part" >>"$mismatches"
        else
          printf 'added: skills/%s\n' "$file_part" >>"$mismatches"
        fi
        ;;
      "Only in $REF_DIR/skills"*)
        rest="${diff_line#Only in $REF_DIR/skills}"
        rest="${rest#: }"
        dir_part="${rest%%: *}"
        file_part="${rest#*: }"
        if [ -n "$dir_part" ]; then
          printf 'removed: skills%s/%s\n' "${dir_part#:}" "$file_part" >>"$mismatches"
        else
          printf 'removed: skills/%s\n' "$file_part" >>"$mismatches"
        fi
        ;;
      "")
        ;;
      *)
        printf 'diff: %s\n' "$diff_line" >>"$mismatches"
        ;;
    esac
  done < <(diff -rq "$LOCAL_SKILLS_DIR" "$REF_DIR/skills" 2>&1 || true)

  if [ -s "$mismatches" ]; then
    log "vendored skills/ differs from mattpocock/skills $baseline_tag:"
    while IFS= read -r line; do
      log "  $line"
    done <"$mismatches"
    exit 1
  fi

  log "vendored skills/ is byte-identical to mattpocock/skills $baseline_tag"
  exit 0
fi

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help)
      awk 'NR > 1 && /^set /{exit} NR > 1' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "$PROGRAM_NAME: unrecognized argument: $arg" >&2
      exit 2
      ;;
  esac
done

if [ -n "$TAGS_FILE" ]; then
  [ -f "$TAGS_FILE" ] || die "tags file not found: $TAGS_FILE"
  tags_raw=$(cat "$TAGS_FILE")
else
  tags_raw=$(git ls-remote --tags "$REPO_URL" 2>/dev/null) || tags_raw=""
fi

# `git ls-remote --tags` output is "<sha>\trefs/tags/<name>", with a second
# "<name>^{}" line for an annotated tag's dereferenced commit -- strip both
# the ref prefix and the deref suffix before comparing.
latest_tag=$(printf '%s\n' "$tags_raw" \
  | awk -F'\t' 'NF >= 2 {print $2}' \
  | sed -e 's#^refs/tags/##' -e 's/\^{}$//' \
  | sort -V \
  | tail -n1)

if [ -z "$latest_tag" ]; then
  log "no tags published at $REPO_URL -- nothing to compare"
  exit 0
fi

previous_tag=""
if [ -f "$STATE_FILE" ]; then
  previous_tag=$(jq -r '.last_flagged_tag // empty' "$STATE_FILE" 2>/dev/null || echo "")
fi

if [ "$latest_tag" = "$previous_tag" ]; then
  log "$latest_tag already flagged -- no new proposal"
  exit 0
fi

# proposal-door (T07) requires the same fields an escalation-door request
# needs, in the Operator Language -- no bare `gc bd create -l proposal` any
# more.
quoi="mattpocock/skills a publié $latest_tag, au-delà de la référence Method Baseline"
if [ "${#quoi}" -gt 140 ]; then
  quoi="${quoi:0:139}…"
fi
# The file path goes in `details`, not in `pourquoi`: proposal-door refuses
# a main-text field the Cockpit could not display, and a path can hold an
# identifier-shaped segment (it did under a temporary directory).
pourquoi="Référence épinglée à ${baseline_commit:0:12}, plus ancienne que cette publication"
details="Fichier de référence : $BASELINE_FILE ; commit épinglé : $baseline_commit"
if [ "${#details}" -gt 1000 ]; then
  details="${details:0:999}…"
fi
langue=$("$OPERATOR_CONFIG_BIN" language) || die "could not read the Operator Language"
que_faire=$(jq -n '[
  {option: "Adopter la mise à jour", consequence: "Réépingle la référence Method Baseline et réécrit ses usages (docs/UPSTREAM_SKILLS.md)."},
  {option: "Ne pas adopter pour l'"'"'instant", consequence: "La référence reste inchangée ; le prochain tag sera à nouveau signalé."}
]')
title="Upstream mattpocock/skills published $latest_tag (Method Baseline pinned at $baseline_commit)"
payload=$(jq -n --arg quoi "$quoi" --arg pourquoi "$pourquoi" --arg langue "$langue" --arg details "$details" --argjson que_faire "$que_faire" \
  '{quoi: $quoi, pourquoi: $pourquoi, que_faire: $que_faire, langue: $langue, details: $details}')

if [ "$DRY_RUN" = 1 ]; then
  log "DRY-RUN: would file proposal bead: $title"
  exit 0
fi

create_output=$("$PROPOSAL_DOOR_BIN" create "$payload" 2>&1) \
  || die "proposal-door create failed: $create_output"
bead_id=$(printf '%s\n' "$create_output" | grep -oE '[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+' | head -n1)
bead_id="${bead_id:-unknown}"

mkdir -p "$(dirname "$STATE_FILE")"
tmp_state="$STATE_FILE.$$.tmp"
printf '{"last_flagged_tag": %s, "checked_at": %s, "bead": %s}\n' \
  "$(printf '%s' "$latest_tag" | jq -R .)" "$NOW" "$(printf '%s' "$bead_id" | jq -R .)" \
  >"$tmp_state"
mv "$tmp_state" "$STATE_FILE"

log "filed proposal $bead_id for $latest_tag"
