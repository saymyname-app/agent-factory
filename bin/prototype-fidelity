#!/usr/bin/env python3
"""Compare a delivered screen to its Validated Prototype, state by state
(T16, af-622nya; Spec af-wf4w5r §3, §7, §9).

    prototype-fidelity check DESCRIPTOR --prototype DIR --commit SHA [--repo-root DIR]
                             [--states STATE,STATE] [--screen NAME ...] [--convoy CONVOY --ticket TICKET]
    prototype-fidelity calibrate --prototype DIR [--states STATE,STATE]

For every prototyped state, the product is launched by bin/project-launch
from a clean copy of `--commit` on the dataset of that state, and the page of
its screen, served at its real address, is compared to the page of the frozen
prototype (`--prototype`, the directory `bin/prototype-conformance` checks):

- **tokens, on the sources**: the custom properties the style sheets of the
  page declare on `:root`, `html` or a `[data-theme…]` selector. A token of
  the prototype that the delivered page lacks, or gives another value, is a
  deviation;
- **structure and computed styles, on every anchor**, in a headless Chromium,
  at every reference viewport and theme the prototype declares: an anchor of
  the prototype absent from the delivered page, another element, another
  enclosing anchor, another number of occurrences, or another computed value
  of a compared property, is a deviation. A theme the preferred colour
  scheme does not reach on the prototype (it renders the same in every
  theme) is put on both sides by the common convention (the class
  `theme-<name>` on `<html>` and `<body>`, `data-theme="<name>"`), and
  compared only when that changes the prototype; otherwise it is reported
  « non mesurable » (af-yw9awk). Tokens are resolved per theme on each
  side, and each theme is compared to the same theme.

The states are compared one at a time (af-6xjghg): the product of a state
is stopped before that of the next is launched.

Any deviation is red and is named by state, viewport, anchor and property. A
state that could not be compared is never green: the command refuses.

With `--convoy` and `--ticket` (a ticket of a convoy that carries the
new-flow mark), only the screens the ticket touches are compared (`--screen`,
required when the profile declares several); the full record is sealed as a
piece of the evidence store; side-by-side captures and an image of the
difference are filed per state and viewport by bin/evidence-capture, both
sides rendered at that moment, and judge nothing; and the result is written
on the ticket by bin/convoy-state, tied to the commit. A deviation is never
lifted here: it reads « accepté par Benjamin » only once a Planning Exception
that names its anchor (bin/ticket-exit --anchor) was answered so by the
operator (bin/escalation-door repondre).

Before a state is compared, a delivered page or a file it links from its
own address that has the digest of a file of the prototype is refused, file
named (T46, af-lb9zkz): the prototype file is not promoted as is.

Every answer is one JSON object on stdout. Exit status: 0 green, or every
deviation accepted by Benjamin; 1 red; 2 refused (nothing was compared to the
end, nothing is written on the ticket); 4 the convoy does not carry the mark
("pas un convoi du nouveau flux": nothing is run or written). Details:
docs/PROTOTYPE_FIDELITY.md.
"""

from __future__ import annotations

import argparse
import functools
import hashlib
import html
import http.server
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from html.parser import HTMLParser
from pathlib import Path
from types import ModuleType
from typing import Any


PROGRAM = "prototype-fidelity"
BIN = Path(__file__).resolve().parent
STATE_TOOL = BIN / "convoy-state"
CAPTURE_TOOL = BIN / "evidence-capture"
LAUNCH_TOOL = BIN / "project-launch"
MANIFEST = "validated-prototype.json"
MARK = "new-flow/v1"
MANIFEST_CONTRACT = "agent-factory-validated-prototype/v1"

EXIT_RED = 1
EXIT_REFUSED = 2
EXIT_NOT_NEW_FLOW = 4

GREEN = "vert"
RED = "rouge"
ACCEPTED = "accepté par Benjamin"
CALIBRATED = "étalonné"
NOT_CALIBRATED = "non étalonné"
OPEN = "ouvert"

# The computed properties compared on every anchor (the ones the fidelity
# trial of af-0sayxf.18 found telling).
PROPERTIES = (
    "font-family", "font-size", "font-weight", "line-height", "color", "background-color",
    "border-radius", "padding", "display", "box-shadow",
)
# What a reference theme is for the browser: its preferred colour scheme
# (observed on chrome-headless-shell 1243, 2026-10-07: 0 is dark, 1 is light).
COLOUR_SCHEMES = {"light": "1", "dark": "0"}
# The common way a page is put in a theme without the preferred colour
# scheme: the measuring page applies it when the emulation does not reach a
# theme of the prototype (its `theme` and `themes` parameters).
THEME_CONVENTION = "la classe theme-{0} sur <html> et <body>, data-theme={0} sur <html>"
# The theme a rule declares its tokens for: its `prefers-color-scheme`, or
# a `[data-theme=<name>]` or `.theme-<name>` selector.
CONTEXT_THEME = re.compile(r"prefers-color-scheme\s*:\s*([\w-]+)")
SELECTOR_THEME = re.compile(r"\[data-theme\s*=\s*[\"']?([\w-]+)|\.theme-([\w-]+)")
PIECE = "fidelity"
# The full measure, in the work directory; the piece seals its fingerprint (af-2cpwkh).
MEASURE_FILE = "measure.json"
MEASURE_PATH = "/__fidelity__/measure.html"
MEASURE_RE = re.compile(r'<pre id="fidelity-measure">(.*?)</pre>', re.S)
BROWSER_TIMEOUT = 60
LAUNCH_TIMEOUT = 60

# The page the browser is given: it loads the page to measure in a frame of
# the size of the viewport, reads every anchor, and writes what it read in
# the document, which `--dump-dom` prints.
MEASURE_PAGE = """<!doctype html>
<html><head><meta charset="utf-8"><title>mesure de fidélité</title></head>
<body style="margin:0">
<iframe id="page" style="border:0;display:block"></iframe>
<pre id="fidelity-measure"></pre>
<script>
(function () {
  var query = new URLSearchParams(location.search);
  var out = document.getElementById('fidelity-measure');
  var frame = document.getElementById('page');
  var attribute = query.get('attr');
  var properties = query.get('props').split(',');
  var theme = query.get('theme'), themes = (query.get('themes') || '').split(',');
  frame.style.width = query.get('w') + 'px';
  frame.style.height = query.get('h') + 'px';
  function themed(doc) {
    [doc.documentElement, doc.body].forEach(function (element) {
      if (!element) { return; }
      themes.forEach(function (other) { element.classList.remove('theme-' + other); });
      element.classList.add('theme-' + theme);
    });
    doc.documentElement.setAttribute('data-theme', theme);
    if (doc.body && doc.body.hasAttribute('data-theme')) { doc.body.setAttribute('data-theme', theme); }
  }
  function measure() {
    try {
      var view = frame.contentWindow, anchors = [];
      frame.contentDocument.querySelectorAll('[' + attribute + ']').forEach(function (element) {
        var computed = view.getComputedStyle(element), styles = {}, up = element.parentElement;
        properties.forEach(function (name) { styles[name] = computed.getPropertyValue(name); });
        while (up && !up.hasAttribute(attribute)) { up = up.parentElement; }
        anchors.push({
          name: element.getAttribute(attribute), tag: element.tagName.toLowerCase(),
          parent: up ? up.getAttribute(attribute) : null, styles: styles
        });
      });
      var doc = frame.contentDocument;
      var scheme = view.getComputedStyle(doc.body || doc.documentElement).getPropertyValue('color-scheme');
      out.textContent = JSON.stringify({ok: true, anchors: anchors, scheme: scheme});
    } catch (error) {
      out.textContent = JSON.stringify({ok: false, error: String(error)});
    }
  }
  frame.addEventListener('load', function () {
    if (theme && frame.contentDocument) { themed(frame.contentDocument); }
    var fonts = frame.contentDocument && frame.contentDocument.fonts;
    if (fonts && fonts.ready) { fonts.ready.then(measure, measure); } else { measure(); }
  });
  frame.src = query.get('target');
})();
</script>
</body></html>
"""


class Refusal(RuntimeError):
    """Nothing was compared to the end. `written` says what was already done."""

    def __init__(self, message: str, written: list[str] | None = None):
        super().__init__(message)
        self.written = written or []


class NotNewFlow(RuntimeError):
    def __init__(self, answer: dict[str, Any]):
        super().__init__(answer.get("message", ""))
        self.answer = answer


def load_tool(name: str) -> ModuleType:
    """A sibling tool, loaded as a module: the profile reader and the browser
    finder are the ones the launcher and the capture tool use."""
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(BIN / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def run_json(argv: list[str]) -> tuple[int, Any]:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError as exc:
        raise Refusal(f"impossible de lancer {Path(argv[0]).name} : {exc}") from exc
    try:
        return proc.returncode, json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise Refusal(f"{Path(argv[0]).name} {argv[1]} a rendu une réponse illisible : {detail[-300:]}") from exc


def refusal_text(answer: Any) -> str:
    text = str(answer.get("error") or answer.get("message") or answer) if isinstance(answer, dict) else str(answer)
    return text[len("refus : "):] if text.startswith("refus : ") else text


# --- what is compared ------------------------------------------------------------


def read_manifest(prototype: Path) -> dict[str, Any]:
    path = prototype / MANIFEST
    try:
        manifest = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise Refusal(f"Validated Prototype illisible : {path} ({exc})") from exc
    if not isinstance(manifest, dict) or manifest.get("contract") != MANIFEST_CONTRACT:
        raise Refusal(f"{path} n'est pas le manifeste d'un Validated Prototype ({MANIFEST_CONTRACT})")
    attribute = manifest.get("anchor_attribute")
    if not isinstance(attribute, str) or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", attribute):
        raise Refusal(f"{path} : attribut d'ancre absent ou mal formé ({attribute!r})")
    viewports = manifest.get("viewports")
    if not isinstance(viewports, list) or not viewports or any(
            not isinstance(v, dict) or not isinstance(v.get("name"), str) or not v["name"]
            or any(isinstance(v.get(side), bool) or not isinstance(v.get(side), int) or v[side] < 1 for side in ("width", "height"))
            for v in viewports):
        raise Refusal(f"{path} : tailles d'écran de référence absentes ou mal formées")
    themes = manifest.get("themes")
    if not isinstance(themes, list) or not themes:
        raise Refusal(f"{path} : thèmes de référence absents")
    unknown = [theme for theme in themes if theme not in COLOUR_SCHEMES]
    if unknown:
        raise Refusal(
            f"{path} : thème de référence non comparable ({', '.join(map(str, unknown))}) ; le contrôle sait rendre "
            f"{', '.join(COLOUR_SCHEMES)} et ne passe sur aucun état qu'il n'a pas comparé")
    states = manifest.get("states")
    if not isinstance(states, list) or not states or any(
            not isinstance(s, dict) or not isinstance(s.get("id"), str) or not isinstance(s.get("address"), str)
            for s in states):
        raise Refusal(f"{path} : états absents ou mal formés")
    for state in states:
        page = (prototype / state["address"].split("?")[0].split("#")[0]).resolve()
        if prototype.resolve() not in page.parents or not page.is_file():
            raise Refusal(f"{path} : l'adresse de l'état {state['id']} n'ouvre aucune page du prototype ({state['address']})")
    return manifest


def renderings(manifest: dict[str, Any]) -> list[dict[str, Any]]:
    """Every reference viewport in every reference theme. The light theme
    keeps the name of the viewport; another one is named after it."""
    return [
        {"label": viewport["name"] if theme == "light" else f"{viewport['name']}@{theme}",
         "viewport": viewport["name"], "width": viewport["width"], "height": viewport["height"], "theme": theme}
        for theme in manifest["themes"] for viewport in manifest["viewports"]
    ]


def select_states(
    manifest: dict[str, Any], screens: list[dict[str, Any]], wanted_states: list[str] | None,
    wanted_screens: list[str], ticket: str | None,
) -> tuple[list[dict[str, Any]], list[str]]:
    """The states to compare, each with its screen, and the screens compared.
    Every prototyped state is compared, or the command refuses: none is left
    out in silence."""
    prototype_states = {state["id"]: state for state in manifest["states"]}
    required = wanted_states if wanted_states is not None else list(prototype_states)
    absent = [state for state in required if state not in prototype_states]
    if absent:
        raise Refusal(
            f"état prototypé absent du Validated Prototype : {', '.join(absent)} "
            f"(états du prototype : {', '.join(prototype_states)})")
    by_name = {screen["name"]: screen for screen in screens}
    unknown = [name for name in wanted_screens if name not in by_name]
    if unknown:
        raise Refusal(f"écran inconnu du profil : {', '.join(unknown)} (écrans déclarés : {', '.join(by_name)})")
    if ticket and not wanted_screens and len(screens) > 1:
        raise Refusal(
            f"le profil déclare plusieurs écrans ({', '.join(by_name)}) : nommer par --screen celui que le ticket "
            f"{ticket} touche")
    owner = {state: screen for screen in screens for state in screen["states"]}
    unserved = [state for state in required if state not in owner]
    if unserved:
        raise Refusal(
            f"état prototypé servi par aucun écran du profil (launch.screens) : {', '.join(unserved)} ; "
            "il ne serait pas comparé")
    chosen = wanted_screens or [screen["name"] for screen in screens]
    selected = [
        {"id": state, "address": prototype_states[state]["address"], "screen": owner[state]["name"], "path": owner[state]["path"]}
        for state in required if owner[state]["name"] in chosen
    ]
    if not selected:
        raise Refusal(f"aucun état prototypé sur les écrans demandés ({', '.join(chosen)})")
    return selected, [name for name in chosen if any(state["screen"] == name for state in selected)]


# --- the two sides ---------------------------------------------------------------


class PrototypeHandler(http.server.SimpleHTTPRequestHandler):
    """The frozen prototype, served as it is, and the measuring page."""

    def log_message(self, *args: Any) -> None:
        pass

    def do_GET(self) -> None:  # noqa: N802 - stdlib method name
        if urllib.parse.urlsplit(self.path).path == MEASURE_PATH:
            body = MEASURE_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        super().do_GET()


def serve_prototype(prototype: Path) -> tuple[http.server.ThreadingHTTPServer, str]:
    handler = functools.partial(PrototypeHandler, directory=str(prototype))
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server, f"http://127.0.0.1:{server.server_address[1]}"


def launch(descriptor: Path, repo_root: Path, commit: str, state: str, work: Path) -> tuple[Path, dict[str, Any]]:
    state_file = work / f"launch-{uuid.uuid4().hex}.json"
    status, answer = run_json([
        str(LAUNCH_TOOL), "--repo-root", str(repo_root), "start", "--owner-pid", str(os.getpid()), str(descriptor), "--commit", commit,
        "--dataset", state, "--timeout", str(LAUNCH_TIMEOUT), "--state-file", str(state_file)])
    if status != 0 or not isinstance(answer, dict) or not answer.get("started"):
        raise Refusal(f"le produit n'a pas démarré sur le jeu de données « {state} » : {refusal_text(answer)}")
    return state_file, answer


def stop(state_file: Path) -> None:
    if state_file.exists():
        subprocess.run([str(LAUNCH_TOOL), "stop", "--state-file", str(state_file)], capture_output=True, text=True)


def launch_state(plan: dict[str, Any], state: dict[str, Any]) -> Path:
    """The product launched on the dataset of one state, its page address set
    on the state; a state `check` already launched is not launched again."""
    if state.get("state_file"):
        return Path(state["state_file"])
    state_file, record = launch(Path(plan["descriptor"]), Path(plan["repo_root"]), plan["commit"], state["id"], Path(plan["work"]))
    state["delivered_url"] = record["address"] + state["path"]
    return state_file


# --- tokens, on the sources ------------------------------------------------------


class StyleSources(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.inline: list[str] = []
        self.linked: list[str] = []
        self._in_style = False

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        attributes = dict(attrs)
        if tag == "style":
            self._in_style = True
        elif tag == "link" and "stylesheet" in (attributes.get("rel") or "").lower().split() and attributes.get("href"):
            self.linked.append(attributes["href"] or "")

    def handle_endtag(self, tag: str) -> None:
        if tag == "style":
            self._in_style = False

    def handle_data(self, data: str) -> None:
        if self._in_style:
            self.inline.append(data)


def fetch(url: str, what: str) -> str:
    try:
        with urllib.request.urlopen(url, timeout=10) as response:
            return response.read().decode("utf-8", errors="replace")
    except (urllib.error.URLError, OSError) as exc:
        raise Refusal(f"{what} ne répond pas ({url}) : {getattr(exc, 'reason', exc)}") from exc


class ServedFiles(HTMLParser):
    """The files a page asks its own server for: `href` of a `<link>`, `src`
    of anything."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.references: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        attributes = dict(attrs)
        reference = attributes.get("href") if tag == "link" else attributes.get("src")
        if reference:
            self.references.append(reference)


def served_digests(page_url: str, what: str) -> dict[str, str]:
    """sha256 of every file the delivered page serves: the page itself and
    what it links from its own address, keyed by the path served."""
    def body(url: str) -> bytes | None:
        try:
            with urllib.request.urlopen(url, timeout=10) as response:
                return response.read()
        except (urllib.error.URLError, OSError):
            return None

    page = body(page_url)
    if page is None:
        raise Refusal(f"{what} ne répond pas ({page_url})")
    found = {urllib.parse.urlsplit(page_url).path or "/": hashlib.sha256(page).hexdigest()}
    links = ServedFiles()
    links.feed(page.decode("utf-8", errors="replace"))
    origin = urllib.parse.urlsplit(page_url)[:2]
    for reference in links.references:
        url = urllib.parse.urljoin(page_url, reference)
        if urllib.parse.urlsplit(url)[:2] != origin:
            continue
        linked = body(url)
        if linked is not None:
            found.setdefault(urllib.parse.urlsplit(url).path, hashlib.sha256(linked).hexdigest())
    return found


def frozen_files(prototype: Path, manifest: dict[str, Any]) -> dict[str, str]:
    """Spec section 3, « Prototype Fold »: the prototype file is not promoted
    as is. The files of the prototype by digest; the manifest and the example
    datasets are not prototype pages: the product is launched on the same
    data."""
    kept = {MANIFEST} | {
        urllib.parse.urlsplit(state["dataset"]).path.lstrip("/")
        for state in manifest.get("states") or [] if isinstance(state, dict) and isinstance(state.get("dataset"), str)
    }
    frozen: dict[str, str] = {}
    for path in sorted(prototype.rglob("*")):
        relative = path.relative_to(prototype).as_posix()
        if path.is_file() and relative not in kept:
            frozen.setdefault(hashlib.sha256(path.read_bytes()).hexdigest(), relative)
    return frozen


def promoted_files(frozen: dict[str, str], state: dict[str, Any]) -> list[str]:
    """The files the launched product of a state serves as a prototype file."""
    return [f"{served} (état {state['id']}) a la même empreinte que {frozen[digest]}"
            for served, digest in served_digests(state["delivered_url"], f"le produit lancé (état {state['id']})").items()
            if digest in frozen]


def css_rules(css: str, context: str = "") -> list[tuple[str, str, str]]:
    """(at-rule context, selector, declarations) of every rule, `@media` and
    `@supports` blocks opened."""
    css = re.sub(r"/\*.*?\*/", "", css, flags=re.S)
    rules, at, size = [], 0, len(css)
    while at < size:
        opening = css.find("{", at)
        if opening < 0:
            break
        head = css[at:opening].strip()
        depth, end = 1, opening + 1
        while end < size and depth:
            depth += {"{": 1, "}": -1}.get(css[end], 0)
            end += 1
        body = css[opening + 1:end - 1]
        if head.startswith(("@media", "@supports", "@layer")):
            rules += css_rules(body, (context + " " + head).strip())
        elif not head.startswith("@"):
            rules.append((context, head, body))
        at = end
    return rules


def tokens_of(page_url: str, what: str, themes: list[str]) -> dict[str, str]:
    """The tokens the sources of a page declare: custom properties on `:root`,
    `html`, a `[data-theme…]` or a `.theme-<name>` selector, in its `<style>`
    blocks and the style sheets it links from its own address. They are
    resolved per theme: those of no theme, then those declared for it. A
    token of the light theme keeps its name; another theme's is named after
    it (`--bg (dark)`), so each theme is compared to the same theme."""
    sources = StyleSources()
    sources.feed(fetch(page_url, what))
    css = list(sources.inline)
    origin = urllib.parse.urlsplit(page_url)[:2]
    for href in sources.linked:
        sheet = urllib.parse.urljoin(page_url, href)
        if urllib.parse.urlsplit(sheet)[:2] == origin:
            css.append(fetch(sheet, f"la feuille de style de {what}"))
    declared: dict[str | None, dict[str, str]] = {}
    for context, selectors, body in css_rules("\n".join(css)):
        for selector in selectors.split(","):
            if not re.search(r":root|\bhtml\b|\[data-theme|\.theme-", selector):
                continue
            plain = re.sub(r":not\([^)]*\)", "", selector)
            found = CONTEXT_THEME.search(context) or SELECTOR_THEME.search(plain)
            theme = next((group for group in found.groups() if group), None) if found else next(
                (name for name in ("dark", "light") if name in context or name in plain), None)
            for declaration in body.split(";"):
                name, separator, value = declaration.partition(":")
                if separator and name.strip().startswith("--"):
                    declared.setdefault(theme, {})[name.strip()] = re.sub(r"\s+", "", value).lower()
    return {
        name if theme == "light" else f"{name} ({theme})": value
        for theme in themes for name, value in {**declared.get(None, {}), **declared.get(theme, {})}.items()
    }


# --- structure and computed styles, in the browser -------------------------------


def dump_dom(browser: str, url: str, rendering: dict[str, Any]) -> str:
    work = tempfile.mkdtemp(prefix="prototype-fidelity-")
    argv = [
        browser, "--headless", "--disable-gpu", "--hide-scrollbars", f"--user-data-dir={work}/profile",
        # The measuring page reads a frame served from another port of this
        # host: tried on chrome-headless-shell 1243 (2026-10-07), both
        # switches are needed, and the measuring page must itself be served
        # over HTTP (a file:// page is refused the frame's document).
        "--disable-web-security", "--disable-site-isolation-trials",
        f"--window-size={rendering['width']},{rendering['height']}",
        f"--blink-settings=preferredColorScheme={COLOUR_SCHEMES[rendering['theme']]}",
        "--virtual-time-budget=10000", "--dump-dom", url,
    ]
    proc = None
    try:
        with open(Path(work) / "dom.html", "wb") as out, open(Path(work) / "browser.log", "wb") as log:
            try:
                proc = subprocess.Popen(argv, cwd=work, stdin=subprocess.DEVNULL, stdout=out, stderr=log, start_new_session=True)
                proc.wait(timeout=BROWSER_TIMEOUT)
            except subprocess.TimeoutExpired as exc:
                raise Refusal(f"le navigateur ({browser}) n'a rien rendu en {BROWSER_TIMEOUT} s : aucune mesure") from exc
            except OSError as exc:
                raise Refusal(f"navigateur impossible à lancer : {browser} ({exc.strerror or exc})") from exc
        return (Path(work) / "dom.html").read_text(encoding="utf-8", errors="replace")
    finally:
        if proc is not None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.wait()
        for _ in range(20):
            shutil.rmtree(work, ignore_errors=True)
            if not os.path.exists(work):
                break
            time.sleep(0.1)


def measure_page(
    browser: str, measure_url: str, target: str, attribute: str, rendering: dict[str, Any], what: str,
    themes: list[str] | None = None,
) -> dict[str, Any]:
    """The anchors of one page, in document order (name, element, enclosing
    anchor and computed styles), and the computed `color-scheme` of its body
    (`scheme`). With `themes`, the page is first put in the theme of the
    rendering by the convention (THEME_CONVENTION)."""
    fields = {
        "target": target, "attr": attribute, "props": ",".join(PROPERTIES),
        "w": rendering["width"], "h": rendering["height"]}
    if themes:
        fields.update(theme=rendering["theme"], themes=",".join(themes))
    query = urllib.parse.urlencode(fields)
    found = MEASURE_RE.search(dump_dom(browser, f"{measure_url}?{query}", rendering))
    try:
        measured = json.loads(html.unescape(found.group(1))) if found and found.group(1).strip() else None
    except json.JSONDecodeError:
        measured = None
    if not isinstance(measured, dict):
        raise Refusal(f"aucune mesure rendue par le navigateur pour {what} ({target}, {rendering['label']})")
    if measured.get("ok") is not True or not isinstance(measured.get("anchors"), list):
        raise Refusal(f"mesure impossible pour {what} ({target}, {rendering['label']}) : {measured.get('error')}")
    return {"anchors": measured["anchors"], "scheme": str(measured.get("scheme") or "").strip()}


def unmeasured_themes(renderings_: list[dict[str, Any]], prototype: dict[str, dict[str, Any]]) -> dict[str, str]:
    """The renderings of a theme the preferred colour scheme does not reach on
    the prototype, each with its reason (af-yw9awk). When the prototype
    measures the same in every theme of a viewport, the emulation changed
    nothing there: it shows one theme only, the one the `color-scheme` of its
    root names (none when it names no declared theme), and every other theme
    of that viewport is not measurable on it."""
    by_viewport: dict[str, list[dict[str, Any]]] = {}
    for rendering in renderings_:
        by_viewport.setdefault(rendering["viewport"], []).append(rendering)
    out: dict[str, str] = {}
    for group in by_viewport.values():
        first = prototype[group[0]["label"]]
        if len(group) < 2 or any(prototype[r["label"]] != first for r in group[1:]):
            continue
        themes = ", ".join(r["theme"] for r in group)
        for rendering in group:
            if rendering["theme"] != first["scheme"]:
                out[rendering["label"]] = (
                    f"le prototype mesure à l'identique en {themes} : l'émulation de prefers-color-scheme ne change "
                    f"pas son thème (color-scheme de sa racine : {first['scheme'] or 'aucun'}), "
                    f"{THEME_CONVENTION.format(rendering['theme'])} non plus ; son thème "
                    f"{rendering['theme']} passe par un autre mécanisme, que le manifeste ne déclare pas")
    return out


def by_name(anchors: list[dict[str, Any]]) -> dict[str, list[dict[str, Any]]]:
    grouped: dict[str, list[dict[str, Any]]] = {}
    for anchor in anchors:
        grouped.setdefault(str(anchor.get("name")), []).append(anchor)
    return grouped


def compare_anchors(prototype: list[dict[str, Any]], delivered: list[dict[str, Any]]) -> tuple[list[dict[str, Any]], list[str]]:
    """One record per anchor of the prototype, and the anchors only the
    delivered page has (a note: nothing of the prototype is missing there)."""
    expected, found = by_name(prototype), by_name(delivered)
    records = []
    for name, references in expected.items():
        occurrences = found.get(name)
        if not occurrences:
            records.append({"anchor": name, "verdict": "absente", "deviations": [
                {"kind": "absent", "property": "présence", "prototype": f"{len(references)} occurrence(s)", "delivered": "absente"}]})
            continue
        deviations: list[dict[str, Any]] = []

        def differ(kind: str, name_of_property: str, reference: Any, value: Any) -> None:
            if reference != value and not any(d["kind"] == kind and d["property"] == name_of_property for d in deviations):
                deviations.append({"kind": kind, "property": name_of_property, "prototype": reference, "delivered": value})

        differ("structure", "occurrences", len(references), len(occurrences))
        for reference, occurrence in zip(references, occurrences):
            differ("structure", "tag", reference.get("tag"), occurrence.get("tag"))
            differ("structure", "parent", reference.get("parent"), occurrence.get("parent"))
            for name_of_property in PROPERTIES:
                differ("style", name_of_property, (reference.get("styles") or {}).get(name_of_property),
                       (occurrence.get("styles") or {}).get(name_of_property))
        records.append({"anchor": name, "verdict": "écart" if deviations else "identique", "deviations": deviations})
    return records, [name for name in found if name not in expected]


def measure(plan: dict[str, Any]) -> dict[str, Any]:
    """Compare every state of the plan; the two sides are rendered here, now.
    The product runs on one state at a time (af-6xjghg): launched, compared,
    stopped before the next one is launched."""
    prototype = Path(plan["prototype"])
    frozen = frozen_files(prototype, read_manifest(prototype))
    states: dict[str, Any] = {}
    deviations: list[dict[str, Any]] = []
    promoted: list[str] = []
    for state in plan["states"]:
        state_file = launch_state(plan, state)
        try:
            promoted += promoted_files(frozen, state)
            # Once a state is refused nothing more is compared; the other
            # states are still read, so that the refusal names every file.
            if not promoted:
                states[state["id"]] = measure_state(plan, state, deviations)
        finally:
            stop(state_file)
    if promoted:
        raise Refusal(
            "prototype promu tel quel : un fichier servi par le livré est un fichier du Validated Prototype, "
            "recopié sans être replié dans le vrai code — " + " ; ".join(promoted)
        )
    return {"commit": plan["commit"], "screens": plan["screens"], "states": states, "deviations": deviations}


def measure_state(plan: dict[str, Any], state: dict[str, Any], deviations: list[dict[str, Any]]) -> dict[str, Any]:
    """The records of one launched state; its deviations are added to `deviations`."""
    browser, attribute = plan["browser"], plan["anchor_attribute"]
    themes = list(dict.fromkeys(rendering["theme"] for rendering in plan["renderings"]))
    reference_tokens = tokens_of(state["prototype_url"], f"la page du prototype (état {state['id']})", themes)
    delivered_tokens = tokens_of(state["delivered_url"], f"la page livrée (état {state['id']})", themes)
    for name, value in reference_tokens.items():
        if delivered_tokens.get(name) != value:
            deviations.append({
                "state": state["id"], "viewport": None, "anchor": None, "kind": "token", "property": name,
                "prototype": value, "delivered": delivered_tokens.get(name)})
    records, anchors, extra = [], [], {}
    measured = {}
    for rendering in plan["renderings"]:
        measured[rendering["label"]] = measure_page(
            browser, plan["measure_url"], state["prototype_url"], attribute, rendering, "le prototype")
        if not measured[rendering["label"]]["anchors"]:
            raise Refusal(
                f"aucune ancre mesurée sur le prototype pour l'état {state['id']} ({rendering['label']}) : "
                "rien à comparer n'est pas une fidélité prouvée")
    # A theme not measurable on the prototype is not compared: it is one
    # deviation of its own, never green and never accepted (af-yw9awk).
    unmeasured = unmeasured_themes(plan["renderings"], measured)
    # Such a theme is put on the prototype by the convention, and compared
    # only when that changes what is measured on it.
    by_convention = []
    for rendering in plan["renderings"]:
        if rendering["label"] in unmeasured:
            themed = measure_page(browser, plan["measure_url"], state["prototype_url"], attribute, rendering,
                                  "le prototype", themes)
            if themed["anchors"] != measured[rendering["label"]]["anchors"]:
                measured[rendering["label"]] = themed
                by_convention.append(rendering["label"])
                del unmeasured[rendering["label"]]
    for rendering in plan["renderings"]:
        if rendering["label"] in unmeasured:
            deviations.append({
                "state": state["id"], "viewport": rendering["label"], "anchor": None, "kind": "theme",
                "property": f"thème {rendering['theme']}", "prototype": unmeasured[rendering["label"]],
                "delivered": "non mesurable"})
            continue
        prototype = measured[rendering["label"]]["anchors"]
        delivered = measure_page(browser, plan["measure_url"], state["delivered_url"], attribute, rendering, "le livré",
                                 themes if rendering["label"] in by_convention else None)["anchors"]
        compared, only_delivered = compare_anchors(prototype, delivered)
        for record in compared:
            records.append({"viewport": rendering["label"], **record})
            if record["anchor"] not in anchors:
                anchors.append(record["anchor"])
            deviations += [
                {"state": state["id"], "viewport": rendering["label"], "anchor": record["anchor"], **deviation}
                for deviation in record["deviations"]]
        if only_delivered:
            extra[rendering["label"]] = only_delivered
    return {
        "screen": state["screen"], "path": state["path"],
        "viewports": [r["label"] for r in plan["renderings"] if r["label"] not in unmeasured],
        "unmeasured": unmeasured, "themed_by_convention": by_convention, "anchors": anchors, "records": records,
        "tokens": {"compared": len(reference_tokens),
                   "only_delivered": sorted(name for name in delivered_tokens if name not in reference_tokens)},
        "anchors_only_delivered": extra,
    }


def cmd_measure(args: argparse.Namespace) -> int:
    """Run inside bin/evidence-capture command: its output is the record. It
    exits 0 once everything was compared, red or green, so that only a
    complete record becomes a piece.

    The full measure is written to a file of the work directory and the
    output carries its fingerprint (af-2cpwkh): a measure of a real screen
    runs to megabytes, beyond what the store keeps of an output (1 MB, then
    its first and last 500 kB), and a truncated record cannot be read back."""
    try:
        plan = json.loads(Path(args.plan).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise Refusal(f"plan de mesure illisible ({args.plan}) : {exc}") from exc
    result = measure(plan)
    content = json.dumps(result, sort_keys=True, ensure_ascii=False).encode("utf-8")
    measure_file = Path(plan["work"]) / MEASURE_FILE
    measure_file.write_bytes(content)
    print(json.dumps({
        "commit": result["commit"], "measure": str(measure_file),
        "measure_digest": "sha256:" + hashlib.sha256(content).hexdigest(), "measure_bytes": len(content),
        "deviations": len(result["deviations"]),
    }, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


# --- check -----------------------------------------------------------------------


def read_ticket(convoy: str, ticket: str) -> dict[str, Any]:
    status, answer = run_json([str(STATE_TOOL), "show", convoy])
    if status == EXIT_NOT_NEW_FLOW:
        raise NotNewFlow(answer)
    # 3 is an « état sans règle » : the state is still rendered.
    if status not in (0, 3) or not isinstance(answer, dict) or "tickets" not in answer:
        raise Refusal(refusal_text(answer))
    for entry in answer["tickets"]:
        if entry.get("id") == ticket:
            if entry.get("mark") != MARK:
                raise Refusal(f"le ticket {ticket} ne porte pas la marque du nouveau flux")
            return entry
    raise Refusal(f"le ticket {ticket} n'appartient pas au convoi {convoy}")


def piece_name(*parts: str) -> str:
    return ".".join(re.sub(r"[^A-Za-z0-9_]", "_", part) for part in parts)


def sealed_measure(args: argparse.Namespace, plan: dict[str, Any], work: Path) -> dict[str, Any]:
    """The same measure, run by the capture tool: the record is a sealed
    piece of the evidence store at the commit of the launched product. The
    piece is tied to the launch of the first state, which the measure stops
    once that state is compared."""
    first = plan["states"][0]
    state_file, record = launch(Path(plan["descriptor"]), Path(plan["repo_root"]), plan["commit"], first["id"], work)
    plan = {**plan, "states": [{**first, "state_file": str(state_file), "delivered_url": record["address"] + first["path"]},
                               *plan["states"][1:]]}
    plan_file = work / "plan.json"
    plan_file.write_text(json.dumps(plan), encoding="utf-8")
    # Every state is launched inside the measure: its launch time is added to the default budget.
    timeout = 600 + LAUNCH_TIMEOUT * len(plan["states"])
    status, answer = run_json([
        str(CAPTURE_TOOL), "command", args.convoy, args.ticket, "--piece", PIECE, "--launch-state", str(state_file),
        "--timeout", str(timeout), "--expect-exit", "0", "--attach", str(work / MEASURE_FILE), "--", sys.executable, str(Path(__file__).resolve()), "measure", "--plan", str(plan_file)])
    if status != 0:
        output = answer.get("output") if isinstance(answer, dict) else None
        try:
            inner = json.loads(output) if output else None
        except json.JSONDecodeError:
            inner = None
        raise Refusal(refusal_text(inner) if isinstance(inner, dict) and inner.get("error") else refusal_text(answer))
    try:
        record = json.loads(Path(answer["path"]).read_text(encoding="utf-8"))
        if record.get("output_truncated"):
            raise Refusal(
                f"relevé de fidélité tronqué dans le magasin de preuves ({record.get('output_bytes')} octets) : "
                "la mesure ne se relit pas", [f"pièce {PIECE}"])
        sealed = json.loads(record["output"])
        # The copy filed beside the piece: the work directory is removed below (T02R2, af-r2c0tx).
        content = Path(answer["attachment"]).read_bytes()
        if "sha256:" + hashlib.sha256(content).hexdigest() != sealed["measure_digest"]:
            raise Refusal(
                f"mesure de fidélité {answer['attachment']} différente de l'empreinte scellée dans le magasin de preuves",
                [f"pièce {PIECE}"])
        return json.loads(content)
    except (OSError, KeyError, TypeError, json.JSONDecodeError) as exc:
        raise Refusal(f"relevé de fidélité illisible dans le magasin de preuves : {exc}", [f"pièce {PIECE}"]) from exc


def capture(args: argparse.Namespace, state: dict[str, Any], rendering: dict[str, Any], state_file: Path) -> dict[str, Any]:
    piece = piece_name(PIECE, state["id"], rendering["label"])
    status, answer = run_json([
        str(CAPTURE_TOOL), "comparison", args.convoy, args.ticket, "--piece", piece, "--launch-state", str(state_file),
        "--path", state["path"], "--reference-url", state["prototype_url"],
        "--window-size", f"{rendering['width']}x{rendering['height']}", "--color-scheme", rendering["theme"]])
    if status != 0:
        raise Refusal(f"capture côte à côte impossible ({state['id']}, {rendering['label']}) : {refusal_text(answer)}")
    return {"piece": piece, "side_by_side": answer["image"], "difference": answer["difference"],
            "differing_pixels": answer["differing_pixels"], "pixels": answer["pixels"]}


def cmd_check(args: argparse.Namespace) -> int:
    if bool(args.convoy) != bool(args.ticket):
        raise Refusal("--convoy et --ticket vont ensemble : le résultat s'enregistre sur un ticket d'un convoi marqué")
    prototype = Path(args.prototype).resolve()
    manifest = read_manifest(prototype)
    profile = load_tool("project-planning-profile")
    try:
        descriptor = profile.load_descriptor(Path(args.descriptor).resolve())
    except profile.ProfileError as exc:
        raise Refusal(f"profil de projet illisible ({args.descriptor}) : {exc}") from exc
    launch_block = descriptor.get("launch") or {}
    screens = launch_block.get("screens")
    if not screens:
        raise Refusal(
            f"le profil du projet {descriptor.get('project_id')!r} ne déclare aucun écran (launch.screens) : "
            "nom, chemin servi et états prototypés de chaque écran comparé au prototype")
    wanted_states = [state for state in args.states.split(",") if state] if args.states is not None else None
    selected, compared_screens = select_states(manifest, screens, wanted_states, args.screen, args.ticket)
    accepted: list[str] = []
    if args.ticket:
        ticket = read_ticket(args.convoy, args.ticket)
        accepted = ticket.get("accepted_anchors") or []
    capture_tool = load_tool("evidence-capture")
    try:
        browser = capture_tool.find_browser()
    except capture_tool.Refusal as exc:
        raise Refusal(str(exc)) from exc
    repo_root = Path(args.repo_root).resolve()
    resolved = subprocess.run(
        ["git", "-C", str(repo_root), "rev-parse", "--verify", "--quiet", f"{args.commit}^{{commit}}"],
        capture_output=True, text=True)
    commit = resolved.stdout.strip()
    if resolved.returncode != 0 or not commit:
        raise Refusal(f"commit introuvable dans {repo_root} : {args.commit!r}")

    work = Path(tempfile.mkdtemp(prefix="prototype-fidelity-"))
    server, prototype_address = serve_prototype(prototype)
    written: list[str] = []
    try:
        for state in selected:
            state["prototype_url"] = f"{prototype_address}/{state['address'].lstrip('/')}"
        plan = {
            "browser": browser, "anchor_attribute": manifest["anchor_attribute"], "commit": commit,
            "screens": compared_screens, "renderings": renderings(manifest), "states": selected,
            "measure_url": prototype_address + MEASURE_PATH, "prototype": str(prototype),
            "descriptor": str(Path(args.descriptor).resolve()), "repo_root": str(repo_root), "work": str(work),
        }
        try:
            if args.ticket:
                result = sealed_measure(args, plan, work)
                written.append(f"pièce {PIECE}")
                for state in selected:
                    captures = result["states"][state["id"]]["captures"] = {}
                    state_file = launch_state(plan, state)
                    try:
                        for rendering in plan["renderings"]:
                            captures[rendering["label"]] = capture(args, state, rendering, state_file)
                            written.append(f"pièce {captures[rendering['label']]['piece']}")
                    finally:
                        stop(state_file)
            else:
                result = measure(plan)
                for state in selected:
                    result["states"][state["id"]]["captures"] = None
            missing = [state["id"] for state in selected if not result["states"].get(state["id"], {}).get("records")]
            if missing:
                raise Refusal(f"état sans relevé : {', '.join(missing)} ; il n'a pas été comparé")
            if args.ticket:
                summary = work / "fidelity.json"
                summary.write_text(json.dumps({
                    "screens": result["screens"],
                    "states": {name: {"viewports": state["viewports"], "anchors": state["anchors"]}
                               for name, state in result["states"].items()},
                    "deviations": [{key: deviation[key] for key in ("state", "viewport", "anchor", "kind", "property")}
                                   for deviation in result["deviations"]],
                }, ensure_ascii=False), encoding="utf-8")
                status, answer = run_json([
                    str(STATE_TOOL), "set-fidelity", args.convoy, args.ticket, "--commit", commit, "--piece", PIECE,
                    "--file", str(summary)])
                if status != 0:
                    raise Refusal(f"résultat refusé par la commande d'état : {refusal_text(answer)}")
                result["recorded"] = {"convoy": args.convoy, "ticket": args.ticket, "piece": PIECE, "commit": commit}
            else:
                result["recorded"] = None
        except Refusal as exc:
            raise Refusal(str(exc), written + exc.written) from exc
    finally:
        # A launch a refused or interrupted measure left behind.
        for state_file in work.glob("launch-*.json"):
            stop(state_file)
        server.shutdown()
        server.server_close()
        shutil.rmtree(work, ignore_errors=True)

    for deviation in result["deviations"]:
        deviation["status"] = ACCEPTED if deviation["anchor"] in accepted else OPEN
    if not result["deviations"]:
        result["result"] = GREEN
    elif all(deviation["status"] == ACCEPTED for deviation in result["deviations"]):
        result["result"] = ACCEPTED
    else:
        result["result"] = RED
    result["ok"] = result["result"] != RED
    result["prototype"] = str(prototype)
    print(json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False))
    return 0 if result["ok"] else EXIT_RED


def cmd_calibrate(args: argparse.Namespace) -> int:
    """The Validated Prototype on both sides of the comparison (af-u8cbl0).
    Every control of `check` runs as it does on a ticket -- tokens, anchors,
    structure, computed styles, each state, viewport and theme -- with the
    prototype's own page in place of the delivered one, and no product
    launched. The tool reads the prototype right only when that finds no
    deviation at all: a theme it cannot reach, or a measure that changes
    from one reading to the next, is a deviation here before it is a false
    one on every ticket. The Cockpit's prototype was first measured by T02R,
    and its themes were read wrong for hours of work (#675, #676)."""
    prototype = Path(args.prototype).resolve()
    manifest = read_manifest(prototype)
    declared = {state["id"]: state for state in manifest["states"]}
    wanted = [state for state in args.states.split(",") if state] if args.states is not None else list(declared)
    absent = [state for state in wanted if state not in declared]
    if absent:
        raise Refusal(
            f"état prototypé absent du Validated Prototype : {', '.join(absent)} "
            f"(états du prototype : {', '.join(declared)})")
    capture_tool = load_tool("evidence-capture")
    try:
        browser = capture_tool.find_browser()
    except capture_tool.Refusal as exc:
        raise Refusal(str(exc)) from exc
    server, prototype_address = serve_prototype(prototype)
    try:
        states = []
        for state_id in wanted:
            address = declared[state_id]["address"]
            url = f"{prototype_address}/{address.lstrip('/')}"
            states.append({"id": state_id, "address": address, "screen": None, "path": address,
                           "prototype_url": url, "delivered_url": url})
        plan = {"browser": browser, "anchor_attribute": manifest["anchor_attribute"],
                "renderings": renderings(manifest), "measure_url": prototype_address + MEASURE_PATH}
        deviations: list[dict[str, Any]] = []
        measured = {state["id"]: measure_state(plan, state, deviations) for state in states}
    finally:
        server.shutdown()
        server.server_close()
    result = {
        "ok": not deviations, "result": CALIBRATED if not deviations else NOT_CALIBRATED,
        "prototype": str(prototype), "deviations": deviations,
        "states": {name: {"viewports": state["viewports"], "unmeasured": state["unmeasured"],
                          "themed_by_convention": state["themed_by_convention"], "anchors": state["anchors"],
                          "tokens": state["tokens"]["compared"]}
                   for name, state in measured.items()},
    }
    print(json.dumps(result, indent=2, sort_keys=True, ensure_ascii=False))
    return 0 if result["ok"] else EXIT_RED


# --- command line ----------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="mode", required=True)
    p = sub.add_parser("check")
    p.add_argument("descriptor")
    p.add_argument("--prototype", required=True)
    p.add_argument("--commit", required=True)
    p.add_argument("--repo-root", default=str(BIN.parent))
    p.add_argument("--states")
    p.add_argument("--screen", action="append", default=[])
    p.add_argument("--convoy")
    p.add_argument("--ticket")
    p.set_defaults(handler=cmd_check)
    # Run by `check` through the capture tool; not a command of its own.
    p = sub.add_parser("calibrate")
    p.add_argument("--prototype", required=True)
    p.add_argument("--states")
    p.set_defaults(handler=cmd_calibrate)
    p = sub.add_parser("measure")
    p.add_argument("--plan", required=True)
    p.set_defaults(handler=cmd_measure)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args)
    except NotNewFlow as exc:
        print(json.dumps(exc.answer, indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_NOT_NEW_FLOW
    except Refusal as exc:
        answer: dict[str, Any] = {"ok": False, "error": f"refus : {exc}"}
        if exc.written:
            answer["written"] = exc.written
        print(json.dumps(answer, indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_REFUSED


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
