#!/usr/bin/env bash
#
# escalation-door — the one door for every escalation (O06, replaces
# `bin/campaign-pointer escalate`; ADR-0023's transitional/together write
# discipline, without the retired af-1vr4 campaign-coordination fields).
#
# No escalation of any kind is ever written by hand (no raw
# `gc bd update --set-metadata gc.needs_benjamin=...`); this script is the
# only door, and it fails loudly and non-zero rather than silently
# (`>/dev/null || true` on an escalation path is exactly the failure mode
# this closes).
#
# Routing (spec-factory-operations-v2-2026-09-28, ticket O06):
#   straight to Benjamin  -- only a request whose `motif` is in the closed
#                            list of ADR-0036 point 1 (MOTIFS_BENJAMIN
#                            below): exposition, destruction, sortie,
#                            irreversible, admin (ADR-0016's list),
#                            intention-produit, seuils, b1, outcome (what
#                            ADR-0036 keeps for him), inclassable (a
#                            decision that does not know its box); and,
#                            until 11/12/2026, d01 (the frozen D01
#                            machinery of ADR-0037, counted hors liste).
#   Mayor                  -- everything else. A `benjamin` request without
#                            a listed motif is not refused: it is rerouted
#                            to the Mayor, who decides it (ADR-0036 point
#                            2), answers with `repondre --actor <himself>`
#                            and lists it in the daily report. A repeated
#                            order failure, a stuck PR, or repeated red CI
#                            page the Mayor directly; since J3 (af-q55qqx.1)
#                            an unresolved page is re-mailed to the Mayor
#                            after 2 hours, never promoted to Benjamin.
#
# Usage: escalation-door <command> [arguments]
#
# Commands:
#   benjamin <bead> <json>    Straight-to-Benjamin escalation (C01 Cockpit
#                              V2, T06): a request Benjamin can understand
#                              without opening an agent session. <json> is a
#                              JSON object carrying the fields a decision
#                              needs -- the door infers nothing and refuses
#                              the write (no partial write, the bead stays
#                              intact) if any is missing, malformed, over
#                              140 characters on one line, or not in the
#                              Operator Language (bin/operator-config
#                              language):
#                                quoi       -- one line, what is happening.
#                                pourquoi   -- one line, why it needs
#                                              Benjamin.
#                                que_faire  -- a non-empty array of options,
#                                              each {option, consequence,
#                                              recommande?, raison?}; every
#                                              option needs its consequence,
#                                              at most one option may be
#                                              recommande=true, and that one
#                                              needs its raison.
#                                langue     -- must equal the Operator
#                                              Language.
#                                motif      -- the box of ADR-0036's closed
#                                              list this decision falls in.
#                                              Missing or not listed: the
#                                              request goes to the Mayor
#                                              (same fields recorded, no
#                                              gc.needs_benjamin), printed
#                                              REROUTED.
#                                bloquant   -- optional bool (default
#                                              false): this NEEDS BENJAMIN
#                                              blocks a chantier.
#                                lien       -- optional, one line of any
#                                              length: the dossier Benjamin
#                                              reads to decide (the « non
#                                              conforme » request of a
#                                              convoy carries its Evidence
#                                              Pack). Written as
#                                              gc.escalation_lien, mailed,
#                                              and printed by `list` on the
#                                              request's line; a request
#                                              without one resets the link
#                                              of the request before.
#                              On success the door letters the options (a,
#                              b, c, ...), stamps gc.escalation_first_at the
#                              first time <bead> reaches the operator (never
#                              rewritten afterwards: the latency counts from
#                              the first request, not from a repeat), writes
#                              them with a timestamp and
#                              the blocking flag on <bead>, clears any
#                              pending Mayor-first state, and mails the
#                              escalation recipient ($GC_ESCALATION_RECIPIENT,
#                              default human).
#   repondre <bead> <lettre> [--actor <qui>] [--ref <référence>]
#                              Pure-code response: writes the chosen option
#                              (comment + metadata: option, quand, acteur)
#                              on <bead>. The acteur is --actor, else the
#                              session's BEADS_ACTOR (bd's own signature),
#                              GC_SESSION_NAME or GC_AGENT; with none the
#                              door refuses. --actor benjamin only on
#                              Benjamin's own words or gesture (the Cockpit
#                              click), never a delegated answer (af-zkdvur),
#                              and only with --ref citing where he said it
#                              (lib/operator_gesture.sh, ADR-0036 point 5):
#                              recorded as gc.escalation_response_ref. A
#                              request on the closed list (route benjamin,
#                              a listed motif) is answered by him alone.
#                              Any other acteur is a delegated decision
#                              (ADR-0036 point 3): gc.decided_by=<acteur>
#                              and a comment « Décision déléguée (ADR-0036)
#                              : … » on <bead>. Then it clears its NEEDS BENJAMIN and any
#                              Mayor-first paging state, and wakes the Mayor
#                              with "<Operator> a répondu <lettre> sur
#                              <bead>". Refuses an option <bead> never
#                              offered, or a <bead> with no recorded
#                              options. A <bead> parked as blocked (status
#                              blocked or closed, gc.work_outcome=blocked --
#                              deliver-close --outcome blocked) is reopened
#                              in the same write so the work resumes
#                              (af-1al0t1).
#   mayor <bead> <reason>      Mayor-first escalation: mail mayor and stamp
#                              gc.escalation_mayor_paged_at (only on the
#                              first page; a repeat call re-mails mayor
#                              without resetting the 2h clock).
#   sweep                      Re-mail the Mayor, once, about every Mayor
#                              page still unresolved (no gc.needs_benjamin)
#                              2 hours after its first page, and stamp
#                              gc.escalation_mayor_overdue_at. Since J3
#                              (ADR-0036, af-q55qqx.1) it never promotes a
#                              page to Benjamin: what is not on the closed
#                              list is the Mayor's to decide, however long
#                              it waits. Deterministic: the clock is `date +%s`,
#                              overridable with $ESCALATION_DOOR_NOW for
#                              tests. Reads one list, then re-reads only a
#                              page that is due or can be cleared: a settled
#                              or not-yet-due one costs nothing (af-io8tb7,
#                              af-kj34b5). If another escalation owns the
#                              door, exits 75 so the periodic order retries
#                              without reporting ordinary serialization as
#                              a chronic failure.
#   clear <bead>                Once the decision is resolved without a
#                              recorded answer, clear gc.needs_benjamin and
#                              any Mayor-first paging state on <bead>, and
#                              note the clearance with its time
#                              (gc.escalation_cleared_at, which the Cockpit
#                              journal reads). Prefer `repondre` when
#                              there is an answer to record. Reopens a
#                              parked-blocked <bead> like `repondre`.
#   mesure [--jours N]         Read-only JSON over the last N days (default
#                              7, Europe/Paris days): requests that reached
#                              the operator per day (by gc.escalation_first_at),
#                              how many of them carry no motif of the closed
#                              list (« hors liste », the old ones before J3),
#                              how many requests the door rerouted to the
#                              Mayor, and the median latency to an answer.
#                              The thresholds of FACTORY_OBJECTIVE.md read
#                              it: at most 1 a day, 0 hors liste, median
#                              under 2 h (af-q55qqx, J3).
#   list                       Read-only: print the NEEDS BENJAMIN list
#                              (every bead, whatever its status, carrying
#                              an active gc.needs_benjamin; closed ones in
#                              their own section -- af-1al0t1: a close
#                              never answers the question), the requests
#                              rerouted to the Mayor still waiting for his
#                              decision (J3, ADR-0036) and the pending-proposal
#                              count (open beads labelled `proposal`). Safe
#                              for the operator session to run at startup.
set -Eeuo pipefail

PROGRAM_NAME="escalation-door"
GC_BIN="${GC_BIN:-gc}"
ESCALATION_RECIPIENT="${GC_ESCALATION_RECIPIENT:-human}"
MAYOR_FIRST_GRACE_SECONDS="${ESCALATION_DOOR_MAYOR_GRACE_SECONDS:-7200}"
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P)"
OPERATOR_CONFIG_BIN="${OPERATOR_CONFIG_BIN:-$ROOT/bin/operator-config}"
PROPOSAL_DOOR_BIN="${PROPOSAL_DOOR_BIN:-$ROOT/bin/proposal-door}"
# Runtime messages name the operator from config, not a hardcoded string
# (O14, F23) -- config/operator.toml's `name`, defaulting to "Benjamin" if
# the file is missing or unset. The `gc.needs_benjamin` field and `benjamin`
# subcommand are a separate, stable schema/API and are not renamed by this.
OPERATOR_NAME="${GC_OPERATOR_NAME:-$(sed -n 's/^name[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "${OPERATOR_CONFIG_FILE:-$ROOT/config/operator.toml}" 2>/dev/null | head -n1)}"
OPERATOR_NAME="${OPERATOR_NAME:-Benjamin}"
BEAD_ID_RE='^[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+(\.[A-Za-z0-9]+)*$'
# ADR-0036 point 1, the only boxes that reach Benjamin (J3, af-q55qqx.1).
# ADR-0016's effect tests: exposition (widen who sees real personal data),
# destruction (beyond recovery), sortie (money, third party, publication),
# irreversible (not undone by a revert and a reversible migration), admin
# (host, access, secrets, production). Kept by ADR-0036: intention-produit,
# seuils (FACTORY_OBJECTIVE.md), b1, outcome (accepting an Outcome). And
# inclassable: « une décision qui ne sait pas dans quelle case elle tombe
# va à Benjamin ».
MOTIFS_BENJAMIN=" exposition destruction sortie irreversible admin intention-produit seuils b1 outcome inclassable "
# Transitional, not on the closed list: the frozen D01 machinery of
# ADR-0037 (convoy-advance, correction-round, code-review, ticket-exit,
# ticket-evaluation, outcome-evaluation, spec-end, spec-end-review) keeps
# the route its contracts were written for until its extinction on
# 11/12/2026. Dormant since convoy-advance was paused (16/11); `mesure`
# counts it hors liste. Remove it with the D01 components.
MOTIFS_TRANSITOIRES=" d01 "

log() { printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2; }
die() { log "ERROR: $1"; exit 1; }

# The request fields check, shared with the other request door (T59).
REQUEST_INCOMPLETE="requête incomplète"
# shellcheck source=lib/request_fields.sh
. "$ROOT/lib/request_fields.sh"
# shellcheck source=lib/work_route_release.sh
. "$ROOT/lib/work_route_release.sh"
# shellcheck source=lib/operator_gesture.sh
. "$ROOT/lib/operator_gesture.sh"

usage() {
  awk 'NR > 1 && /^set /{exit} NR > 1' "$0" | sed 's/^# \{0,1\}//'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is unavailable: $1"
}

valid_bead_id() {
  [[ $1 =~ $BEAD_ID_RE ]]
}

now_epoch() {
  printf '%s' "${ESCALATION_DOOR_NOW:-$(date -u +%s)}"
}

now_iso() {
  date -u -d "@$(now_epoch)" +%Y-%m-%dT%H:%M:%SZ
}

operator_language() {  # prints the Operator Language, or dies
  local out
  out=$("$OPERATOR_CONFIG_BIN" language 2>&1) \
    || die "Could not read the Operator Language: $out"
  printf '%s' "$out"
}

show_bead() {  # $1 = bead id -> prints the single-object JSON, or dies
  local id=$1 raw
  raw=$("$GC_BIN" bd show "$id" --json 2>/dev/null) \
    || die "$id is unavailable."
  jq -e 'if type == "array" then (if length == 1 then .[0] else error("ambiguous") end) else . end' \
    <<<"$raw" 2>/dev/null || die "$id did not resolve to exactly one Bead."
}

# emit_request performs the write + mail once a request has validated; never
# called directly from a command handler -- benjamin_payload validates first.
# The route is benjamin (motif on ADR-0036's closed list) or mayor (any other
# request, J3): the same fields are recorded either way so the Mayor can
# answer with `repondre`, but only the benjamin route sets gc.needs_benjamin
# and mails the operator.
emit_request() {  # route motif bead quoi pourquoi lettered_que_faire_json bloquant [lien]
  local route=$1 motif=$2 bead=$3 quoi=$4 pourquoi=$5 que_faire_json=$6 bloquant=$7 lien=${8:-}
  local horodatage options_summary dossier_line=""
  local -a lien_args=() route_args=()
  horodatage=$(now_iso)
  # The link belongs to one request: a value writes it, none resets the one
  # of the request before, nothing leaves a bead that never had one as it is.
  if [[ -n $lien ]]; then
    lien_args=(--set-metadata "gc.escalation_lien=$lien")
    [[ $lien == none ]] || dossier_line="DOSSIER: $lien"$'\n'
  fi
  if [[ $route == benjamin ]]; then
    route_args=(--set-metadata "gc.needs_benjamin=$quoi"
      --set-metadata "gc.escalation_mayor_paged_at=none"
      --set-metadata "gc.escalation_mayor_reason=none"
      --set-metadata "gc.escalation_mayor_overdue_at=none"
      --append-notes "NEEDS BENJAMIN ($motif): $quoi")
    local first_at
    first_at=$(jq -r '.metadata["gc.escalation_first_at"] // ""' <<<"$ISSUE")
    [[ -n $first_at && $first_at != none ]] \
      || route_args+=(--set-metadata "gc.escalation_first_at=$horodatage")
  else
    # A page already running keeps its clock; a new one starts it.
    local paged_at
    paged_at=$(jq -r '.metadata["gc.escalation_mayor_paged_at"] // ""' <<<"$ISSUE")
    if [[ -z $paged_at || $paged_at == none ]]; then
      route_args=(--set-metadata "gc.escalation_mayor_paged_at=$horodatage"
        --set-metadata "gc.escalation_mayor_overdue_at=none")
    fi
    route_args+=(--set-metadata "gc.escalation_mayor_reason=$quoi"
      --append-notes "HORS LISTE ADR-0036 (motif « ${motif:-aucun} ») → Mayor : $quoi")
  fi
  # The route's own fields first: gc.needs_benjamin leads the write, as it
  # always has.
  "$GC_BIN" bd update "$bead" \
    "${route_args[@]}" \
    --set-metadata "gc.escalation_route=$route" \
    --set-metadata "gc.escalation_motif=${motif:-none}" \
    --set-metadata "gc.escalation_pourquoi=$pourquoi" \
    --set-metadata "gc.escalation_que_faire=$que_faire_json" \
    --set-metadata "gc.escalation_bloquant=$bloquant" \
    --set-metadata "gc.escalation_horodatage=$horodatage" \
    "${lien_args[@]}" \
    >/dev/null || die "Beads write failed for $bead."
  options_summary=$(jq -r '
    [.[] | "  \(.lettre)) \(.option) — \(.consequence)"
      + (if (.recommande // false) then " [Recommandé : \(.raison)]" else "" end)]
    | join("\n")' <<<"$que_faire_json")
  if [[ $route == benjamin ]]; then
    "$GC_BIN" mail send "$ESCALATION_RECIPIENT" --notify \
      -s "NEEDS BENJAMIN: $bead" \
      -m "ACTION: escalation-door escalated $bead straight to $OPERATOR_NAME ($motif)
STATE: $quoi
POURQUOI: $pourquoi
QUE FAIRE:
$options_summary
${dossier_line}EVIDENCE: gc bd show $bead
NEXT: escalation-door repondre $bead <lettre>, ou escalation-door clear $bead" \
      >/dev/null || die "Could not mail $ESCALATION_RECIPIENT; gc.needs_benjamin is set but the mail was not sent -- retry rather than clearing it by hand."
    printf 'ESCALATED (benjamin, %s): %s — %s\n' "$motif" "$bead" "$quoi"
    return
  fi
  "$GC_BIN" mail send mayor --notify \
    -s "Décision déléguée à prendre (ADR-0036): $bead" \
    -m "ACTION: escalation-door rerouted to the Mayor a request for $OPERATOR_NAME outside ADR-0036's closed list (motif « ${motif:-aucun} »)
STATE: $quoi
POURQUOI: $pourquoi
QUE FAIRE:
$options_summary
${dossier_line}EVIDENCE: gc bd show $bead
NEXT: decide it -- escalation-door repondre $bead <lettre> --actor <you> (recorded as a delegated decision, listed in the daily report); or escalation-door benjamin $bead with a listed motif if it truly is his" \
    >/dev/null || die "Could not mail mayor; the request is recorded on $bead but the mail failed -- retry."
  printf 'REROUTED (mayor, hors liste ADR-0036, motif « %s »): %s — %s\n' "${motif:-aucun}" "$bead" "$quoi"
}

motif_listed() {  # $1 = motif -> routes to the operator
  [[ -n $1 && ( $MOTIFS_BENJAMIN == *" $1 "* || $MOTIFS_TRANSITOIRES == *" $1 "* ) ]]
}

benjamin_payload() {  # bead payload
  local bead=${1:-} payload=${2:-}
  [[ -n $bead && -n $payload ]] || die "Usage: $PROGRAM_NAME benjamin <bead> <json>"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  jq -e 'type == "object"' <<<"$payload" >/dev/null 2>&1 \
    || die "requête incomplète : le corps n'est pas un objet JSON valide."
  local quoi pourquoi langue bloquant que_faire_raw lettered expected_language lien motif route=mayor
  quoi=$(jq -r '.quoi // ""' <<<"$payload")
  pourquoi=$(jq -r '.pourquoi // ""' <<<"$payload")
  langue=$(jq -r '.langue // ""' <<<"$payload")
  motif=$(jq -r '.motif // "" | tostring' <<<"$payload")
  bloquant=$(jq -r 'if (.bloquant // false) == true then "true" else "false" end' <<<"$payload")
  que_faire_raw=$(jq -c '.que_faire // []' <<<"$payload")
  field_ok "quoi" "$quoi"
  field_ok "pourquoi" "$pourquoi"
  field_ok "langue" "$langue"
  [[ $motif != *[[:space:]]* ]] || die "champ « motif » : un seul mot de la liste fermée (${MOTIFS_BENJAMIN# })."
  if jq -e 'has("lien")' <<<"$payload" >/dev/null; then
    jq -e '.lien | type == "string" and length > 0 and (test("[\n\r]") | not)' <<<"$payload" >/dev/null \
      || die "champ « lien » doit être une ligne de texte non vide."
    lien=$(jq -r '.lien' <<<"$payload")
  fi
  lettered=$(validate_que_faire "$que_faire_raw")
  expected_language=$(operator_language)
  [[ $langue == "$expected_language" ]] \
    || die "la requête est dans la langue « $langue », la langue de l'opérateur est « $expected_language »."
  ISSUE=$(show_bead "$bead")
  if [[ -z ${lien:-} ]] && jq -e '.metadata | has("gc.escalation_lien")' <<<"$ISSUE" >/dev/null; then
    lien=none
  fi
  motif_listed "$motif" && route=benjamin
  emit_request "$route" "$motif" "$bead" "$quoi" "$pourquoi" "$lettered" "$bloquant" "${lien:-}"
}

cmd_benjamin() {
  benjamin_payload "${1:-}" "${2:-}"
}

# af-1al0t1: work parked by `deliver-close --outcome blocked` (status
# blocked) -- or closed as blocked before that fix -- waits on its NEEDS
# BENJAMIN. Answering (repondre) or clearing it reopens the bead in the same
# write, so it returns to the ready pool instead of staying parked forever,
# and its dependents stay gated until it is actually delivered. It goes back
# without the route and session of the launch that parked it (af-asymry): it
# waits to be launched again, never taken by a worker launched for another
# ticket.
REOPEN_ARGS=(--status open --unset-metadata gc.outcome
  --unset-metadata gc.work_outcome --unset-metadata gc.blocked_classification
  "${WORK_ROUTE_RELEASE_ARGS[@]}")

is_parked_blocked() {  # $1 = bead JSON
  jq -e '(.metadata["gc.work_outcome"] // "") == "blocked"
         and ((.status // "") == "blocked" or (.status // "") == "closed")' \
    <<<"$1" >/dev/null
}

cmd_repondre() {
  local bead=${1:-} lettre=${2:-}
  [[ -n $bead && -n $lettre ]] || die "Usage: $PROGRAM_NAME repondre <bead> <lettre> [--actor <qui>] [--ref <référence>]"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  local actor=${BEADS_ACTOR:-${GC_SESSION_NAME:-${GC_AGENT:-}}} qui ref=""
  shift 2
  while (($#)); do
    case $1 in
      --actor) actor=${2:-}; shift 2 || shift ;;
      --ref) ref=${2:-}; shift 2 || shift ;;
      *) die "Usage: $PROGRAM_NAME repondre <bead> <lettre> [--actor <qui>] [--ref <référence>]" ;;
    esac
  done
  [[ -n $actor && $actor != *[[:space:]]* ]] \
    || die "qui répond ? --actor benjamin --ref <où il l'a dit>, sinon l'acteur de la session (--actor ou BEADS_ACTOR) ; rien n'est écrit."
  operator_gesture_check "$actor" "$ref"
  operator_actor "$actor" && actor=benjamin
  qui=$actor
  [[ $actor == benjamin ]] && qui=$OPERATOR_NAME
  local issue que_faire_raw chosen option_texte now reopen_note=""
  local -a reopen_args=() decided_args=() ref_args=()
  issue=$(show_bead "$bead")
  if [[ $actor != benjamin ]] && jq -e --arg listed "$MOTIFS_BENJAMIN" '
      (.metadata["gc.escalation_route"] // "") == "benjamin"
      and ((.metadata["gc.needs_benjamin"] // "none") | tostring) != "none"
      and ((.metadata["gc.escalation_motif"] // "") as $m | $m != "" and ($listed | split(" ") | index($m)) != null)' \
      <<<"$issue" >/dev/null; then
    die "$bead attend une décision de $OPERATOR_NAME (motif $(jq -r '.metadata["gc.escalation_motif"]' <<<"$issue"), ADR-0036) : seul lui y répond (--actor benjamin --ref …) ; rien n'est écrit."
  fi
  [[ -z $ref ]] || ref_args=(--set-metadata "gc.escalation_response_ref=$ref")
  que_faire_raw=$(jq -r '.metadata["gc.escalation_que_faire"] // ""' <<<"$issue")
  [[ -n $que_faire_raw ]] || die "$bead ne porte aucune option enregistrée par escalation-door."
  jq -e 'type == "array" and length > 0' <<<"$que_faire_raw" >/dev/null 2>&1 \
    || die "$bead porte des options illisibles."
  chosen=$(jq -c --arg l "$lettre" '[.[] | select(.lettre == $l)] | .[0] // empty' <<<"$que_faire_raw")
  [[ -n $chosen ]] || die "'$lettre' n'est pas une option connue pour $bead."
  option_texte=$(jq -r '.option' <<<"$chosen")
  now=$(now_iso)
  if is_parked_blocked "$issue"; then
    reopen_args=("${REOPEN_ARGS[@]}")
    reopen_note=" ; $bead rouvert (était bloqué en attente de cette réponse)"
  fi
  # ADR-0036 point 3: an answer by anyone but Benjamin is a delegated
  # decision, recorded with the agent that took it.
  [[ $actor == benjamin ]] || decided_args=(--set-metadata "gc.decided_by=$actor")
  "$GC_BIN" bd update "$bead" \
    --set-metadata "gc.escalation_response_option=$lettre" \
    --set-metadata "gc.escalation_response_at=$now" \
    --set-metadata "gc.escalation_response_actor=$actor" \
    --set-metadata "gc.needs_benjamin=none" \
    --set-metadata "gc.escalation_mayor_paged_at=none" \
    --set-metadata "gc.escalation_mayor_reason=none" \
    --set-metadata "gc.escalation_mayor_overdue_at=none" \
    "${decided_args[@]}" \
    "${ref_args[@]}" \
    "${reopen_args[@]}" \
    --append-notes "RÉPONSE: $lettre — $option_texte$reopen_note" \
    >/dev/null || die "Beads write failed for $bead."
  if [[ $actor != benjamin ]]; then
    # The comment the daily report lists (ADR-0036 point 4); best effort,
    # gc.decided_by above is the record.
    "$GC_BIN" bd comments add "$bead" "Décision déléguée (ADR-0036) : $actor a choisi $lettre) $option_texte sur $bead. Retour arrière : une autre réponse par escalation-door repondre, ou défaire l'effet de cette option." \
      >/dev/null 2>&1 || log "WARNING: the delegated-decision comment was not written on $bead (gc.decided_by is)."
  fi
  "$GC_BIN" mail send mayor --notify \
    -s "Réponse de $qui: $bead" \
    -m "ACTION: escalation-door recorded $qui's answer
STATE: $qui a répondu $lettre sur $bead — $option_texte$reopen_note
EVIDENCE: gc bd show $bead
NEXT: resume work using option $lettre" \
    >/dev/null || die "Could not mail mayor; the response is recorded on $bead but the wake-up mail failed -- retry."
  printf 'RÉPONDU: %s — %s) %s\n' "$bead" "$lettre" "$option_texte"
}

cmd_mayor() {
  local bead=${1:-} reason=${2:-}
  [[ -n $bead && -n $reason ]] || die "Usage: $PROGRAM_NAME mayor <bead> <reason>"
  [[ $reason != *$'\n'* && $reason != *$'\r'* ]] || die "reason must be a single line."
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  local issue paged_at
  issue=$(show_bead "$bead")
  paged_at=$(jq -r '.metadata["gc.escalation_mayor_paged_at"] // empty' <<<"$issue")
  if [[ -z $paged_at || $paged_at == none ]]; then
    paged_at=$(now_iso)
    "$GC_BIN" bd update "$bead" \
      --set-metadata "gc.escalation_mayor_paged_at=$paged_at" \
      --set-metadata "gc.escalation_mayor_reason=$reason" \
      --set-metadata "gc.escalation_mayor_overdue_at=none" \
      --append-notes "MAYOR FIRST: $reason" \
      >/dev/null || die "Beads write failed for $bead."
  fi
  "$GC_BIN" mail send mayor --notify \
    -s "Escalation (Mayor first): $bead" \
    -m "ACTION: escalation-door paged the Mayor first
STATE: $reason
EVIDENCE: gc bd show $bead
NEXT: decide it yourself (ADR-0036); escalation-door sweep re-mails you once 2h after $paged_at, never $OPERATOR_NAME" \
    >/dev/null || die "Could not mail mayor; retry rather than treating this page as delivered."
  printf 'ESCALATED (mayor-first): %s — %s\n' "$bead" "$reason"
}

page_resolved_by_closing() {  # issue_json reason
  jq -e --arg reason "$2" '
    .status == "closed" and (((.metadata["gc.order_subject"] // "") != "")
    or (.metadata["gc.delivery_status"] == "merged"
        and ((.metadata["gc.pr_number"] // "" | tostring) as $n
             | $n != "" and ($reason | startswith("PR #" + $n + " ")))))' \
    <<<"$1" >/dev/null 2>&1
}

cmd_sweep() {
  local now due_json
  now=$(now_epoch)
  # --limit 0: `bd list` stops at 50 beads by default, and this list only
  # grows (below).
  due_json=$("$GC_BIN" bd list --all --limit 0 --has-metadata-key gc.escalation_mayor_paged_at --json 2>/dev/null) \
    || die "Could not list Mayor-first escalations."
  [[ -n $due_json ]] || due_json='[]'
  local count=0
  while IFS= read -r listed_issue; do
    [[ -n $listed_issue ]] || continue
    local bead issue paged_at needs reason paged_epoch age overdue
    bead=$(jq -r '.id // empty' <<<"$listed_issue")
    [[ -n $bead ]] || continue
    issue=$listed_issue
    # A normal `bd list --json` row already carries the issue. Skip a fresh
    # tracker round-trip until this page is old enough to act on (or its
    # closing can clear it). A deliberately thin/older list still gets the
    # compatibility read before any decision.
    if jq -e '(.metadata | type) == "object"' <<<"$issue" >/dev/null 2>&1; then
      paged_at=$(jq -r '.metadata["gc.escalation_mayor_paged_at"] // empty' <<<"$issue")
      reason=$(jq -r '.metadata["gc.escalation_mayor_reason"] // "unresolved"' <<<"$issue")
      paged_epoch=$(date -u -d "$paged_at" +%s 2>/dev/null) || continue
      age=$(( now - paged_epoch ))
      if ! page_resolved_by_closing "$issue" "$reason" && ((age < MAYOR_FIRST_GRACE_SECONDS)); then
        continue
      fi
    fi
    issue=$(show_bead "$bead")
    paged_at=$(jq -r '.metadata["gc.escalation_mayor_paged_at"] // empty' <<<"$issue")
    [[ -n $paged_at && $paged_at != none ]] || continue
    needs=$(jq -r '.metadata["gc.needs_benjamin"] // empty' <<<"$issue")
    [[ -z $needs || $needs == none ]] || continue
    overdue=$(jq -r '.metadata["gc.escalation_mayor_overdue_at"] // empty' <<<"$issue")
    [[ -z $overdue || $overdue == none ]] || continue
    reason=$(jq -r '.metadata["gc.escalation_mayor_reason"] // "unresolved"' <<<"$issue")
    # A page about the bead's own PR ("PR #N rejected ...", pr-autopilot) is
    # resolved once deliver-close has closed the bead on that same PR's
    # verified merge: clear it instead of asking the operator about a ticket
    # already delivered (af-53v22s, 2026-10-01). Likewise a page about a
    # failing order once its bead is closed: the order opens a new bead if it
    # fails again (af-drwmqm, 2026-10-22). A page about anything else, or
    # about another PR, is left to the 2h rule.
    if page_resolved_by_closing "$issue" "$reason"; then
      "$GC_BIN" bd update "$bead" \
        --set-metadata "gc.escalation_mayor_paged_at=none" \
        --set-metadata "gc.escalation_mayor_reason=none" \
        --append-notes "MAYOR FIRST RESOLVED: $reason -- its bead is closed" \
        >/dev/null || die "Beads write failed for $bead."
      printf 'SWEPT: %s resolved by its closing, page cleared\n' "$bead"
      continue
    fi
    paged_epoch=$(date -u -d "$paged_at" +%s 2>/dev/null) || continue
    age=$(( now - paged_epoch ))
    ((age >= MAYOR_FIRST_GRACE_SECONDS)) || continue
    # J3 (ADR-0036): what is not on the closed list stays the Mayor's to
    # decide. One reminder, stamped, never a promotion to the operator.
    "$GC_BIN" bd update "$bead" \
      --set-metadata "gc.escalation_mayor_overdue_at=$(now_iso)" \
      --append-notes "MAYOR FIRST OVERDUE: $reason -- toujours sans décision après 2h" \
      >/dev/null || die "Beads write failed for $bead."
    "$GC_BIN" mail send mayor --notify \
      -s "Décision en retard (ADR-0036): $bead" \
      -m "ACTION: escalation-door sweep found this page unresolved 2h after $paged_at
STATE: $reason
EVIDENCE: gc bd show $bead
NEXT: decide it yourself and record it (gc.decided_by, « Décision déléguée (ADR-0036) : »); it never goes to $OPERATOR_NAME unless it is on ADR-0036's closed list" \
      >/dev/null || die "Could not mail mayor about overdue $bead."
    printf 'SWEPT: %s overdue after %ds, Mayor reminded\n' "$bead" "$age"
    count=$((count + 1))
  # A settled escalation keeps its key for ever, at "none", so the list only
  # grows. The list row is enough to reject settled and not-yet-due pages;
  # only a page about to be changed is re-read against a concurrent closing.
  # A bead listed without metadata is read, never skipped.
  done < <(jq -c '(if type == "array" then . else [.] end)[]
    | select((.metadata | type) != "object"
        or (((.metadata["gc.escalation_mayor_paged_at"] // "") | tostring) as $paged
            | ((.metadata["gc.needs_benjamin"] // "") | tostring) as $needs
            | ((.metadata["gc.escalation_mayor_overdue_at"] // "") | tostring) as $overdue
            | $paged != "" and $paged != "none" and ($needs == "" or $needs == "none")
              and ($overdue == "" or $overdue == "none")))
    ' <<<"$due_json")
  ((count > 0)) || printf 'SWEPT: nothing due\n'
}

cmd_clear() {
  local bead=${1:-}
  [[ -n $bead ]] || die "Usage: $PROGRAM_NAME clear <bead>"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  local issue reopen_note=""
  local -a reopen_args=()
  issue=$(show_bead "$bead")
  if is_parked_blocked "$issue"; then
    reopen_args=("${REOPEN_ARGS[@]}")
    reopen_note=" ; bead rouvert (était bloqué)"
  fi
  "$GC_BIN" bd update "$bead" \
    --set-metadata "gc.needs_benjamin=none" \
    --set-metadata "gc.escalation_mayor_paged_at=none" \
    --set-metadata "gc.escalation_mayor_reason=none" \
    --set-metadata "gc.escalation_mayor_overdue_at=none" \
    --set-metadata "gc.escalation_cleared_at=$(now_iso)" \
    "${reopen_args[@]}" \
    --append-notes "DECISION CLEARED: escalation reset to none$reopen_note" \
    >/dev/null || die "Beads write failed for $bead."
  printf 'CLEARED: decision on %s%s\n' "$bead" "$reopen_note"
}

cmd_mesure() {
  local jours=7
  if [[ ${1:-} == --jours ]]; then
    jours=${2:-}
    [[ $jours =~ ^[1-9][0-9]*$ ]] || die "Usage: $PROGRAM_NAME mesure [--jours N]"
  elif [[ -n ${1:-} ]]; then
    die "Usage: $PROGRAM_NAME mesure [--jours N]"
  fi
  local reached rerouted since
  since=$(( $(now_epoch) - jours * 86400 ))
  reached=$("$GC_BIN" bd list --all --limit 0 --has-metadata-key gc.escalation_first_at --json 2>/dev/null) \
    || die "Could not list the requests that reached $OPERATOR_NAME."
  rerouted=$("$GC_BIN" bd list --all --limit 0 --has-metadata-key gc.escalation_route --json 2>/dev/null) \
    || die "Could not list the rerouted requests."
  # Paris day of each first request: TZ database, not a fixed offset.
  local days
  days=$(jq -r --argjson since "$since" '(if type == "array" then . else [.] end)[]
      | (.metadata["gc.escalation_first_at"] // "") | select(. != "" and . != "none")
      | select(fromdateiso8601 >= $since)' <<<"${reached:-[]}" \
    | while IFS= read -r at; do TZ=Europe/Paris date -d "$at" +%F; done | sort | uniq -c \
    | jq -Rn '[inputs | capture("^ *(?<n>[0-9]+) (?<jour>.+)$") | {jour, demandes: (.n | tonumber)}]')
  jq -n --argjson since "$since" --argjson jours "$jours" --argjson par_jour "$days" \
    --arg listed "$MOTIFS_BENJAMIN" \
    --argjson reached "${reached:-[]}" --argjson rerouted "${rerouted:-[]}" '
    def rows($x): ($x | if type == "array" then . else [.] end);
    def at($k): (.metadata[$k] // "") | if . == "" or . == "none" then null else fromdateiso8601 end;
    ($listed | split(" ") | map(select(. != ""))) as $motifs
    | [rows($reached)[] | select((at("gc.escalation_first_at") // 0) >= $since)] as $r
    | [$r[] | select(at("gc.escalation_response_at") != null)
        | (at("gc.escalation_response_at") - at("gc.escalation_first_at")) / 60
        | select(. >= 0)] | sort as $lat
    | {jours: $jours,
       demandes: ($r | length),
       par_jour: $par_jour,
       max_par_jour: ([$par_jour[].demandes] | max // 0),
       hors_liste: ([$r[] | select((.metadata["gc.escalation_motif"] // "") as $m | ($motifs | index($m)) == null)] | length),
       renvoyees_au_mayor: ([rows($rerouted)[] | select(.metadata["gc.escalation_route"] == "mayor")
                             | select((at("gc.escalation_horodatage") // 0) >= $since)] | length),
       repondues: ($lat | length),
       latence_mediane_min: (if ($lat | length) == 0 then null
                             else ($lat[(($lat | length) - 1) / 2 | floor] + $lat[($lat | length) / 2 | floor]) / 2 | round end)}'
}

cmd_list() {
  local needs_json needs_count closed_count proposals_count
  # af-1al0t1: every status, not only open/in_progress -- a question on a
  # parked (blocked), deferred or even closed bead is still unanswered.
  needs_json=$("$GC_BIN" bd list --all --limit 0 --has-metadata-key gc.needs_benjamin --json 2>/dev/null) \
    || die "Could not list NEEDS BENJAMIN beads."
  [[ -n $needs_json ]] || needs_json='[]'

  printf 'NEEDS BENJAMIN:\n'
  needs_count=0
  closed_count=0
  local closed_lines=""
  while IFS=$'\t' read -r id status reason lien; do
    [[ -n $id ]] || continue
    [[ -n $reason && $reason != none ]] || continue
    [[ -z $lien || $lien == none ]] || reason+=" — dossier : $lien"
    if [[ $status == closed ]]; then
      closed_lines+="  $id — $reason"$'\n'
      closed_count=$((closed_count + 1))
      continue
    fi
    printf '  %s — %s\n' "$id" "$reason"
    needs_count=$((needs_count + 1))
  done < <(jq -r '(if type == "array" then . else [.] end)[]
    | [.id, (.status // "open"), (.metadata["gc.needs_benjamin"] // "" | tostring),
       (.metadata["gc.escalation_lien"] // "" | tostring)] | @tsv' <<<"$needs_json")
  ((needs_count > 0)) || printf '  (none)\n'
  if ((closed_count > 0)); then
    printf 'NEEDS BENJAMIN sur un bead fermé (la fermeture n'"'"'a pas répondu ; repondre ou clear) :\n'
    printf '%s' "$closed_lines"
  fi

  # J3 (ADR-0036): what the door handed to the Mayor stays visible until he
  # decides it -- the operator session and the daily report read it here.
  local rerouted_json rerouted_lines
  rerouted_json=$("$GC_BIN" bd list --all --limit 0 --has-metadata-key gc.escalation_route --json 2>/dev/null) \
    || die "Could not list the requests rerouted to the Mayor."
  rerouted_lines=$(jq -r '(if type == "array" then . else [.] end)[]
    | select((.metadata["gc.escalation_route"] // "") == "mayor")
    | select(((.metadata["gc.escalation_mayor_paged_at"] // "none") | tostring) != "none")
    | select(((.metadata["gc.needs_benjamin"] // "none") | tostring) | . == "none" or . == "")
    | "  \(.id) — \(.metadata["gc.escalation_mayor_reason"] // "")"
      + (((.metadata["gc.escalation_lien"] // "none") | tostring) as $l
         | if $l == "none" or $l == "" then "" else " — dossier : \($l)" end)' <<<"${rerouted_json:-[]}")
  if [[ -n $rerouted_lines ]]; then
    printf 'RENVOYÉ AU MAYOR (hors liste ADR-0036, à lui de décider) :\n%s\n' "$rerouted_lines"
  fi

  # Pending proposals is counted by proposal-door itself (T07) -- it
  # excludes proposals already accepted or rejected; a legacy proposal
  # with no gc.proposal_state still counts as pending.
  proposals_count=$("$PROPOSAL_DOOR_BIN" compte 2>/dev/null) \
    || die "Could not count pending proposals."
  printf 'Pending proposals: %s\n' "${proposals_count:-0}"
}

main() {
  local command=${1:-}
  [[ -n $command ]] || { usage >&2; return 2; }
  shift
  case "$command" in
    -h|--help|help) usage ;;
    benjamin) cmd_benjamin "$@" ;;
    repondre) cmd_repondre "$@" ;;
    mayor) cmd_mayor "$@" ;;
    sweep) cmd_sweep "$@" ;;
    clear) cmd_clear "$@" ;;
    list) cmd_list "$@" ;;
    mesure) cmd_mesure "$@" ;;
    *) usage >&2; return 2 ;;
  esac
}

require_command jq
require_command "$GC_BIN"
require_command flock
ISSUE=""
LOCK_FILE="${ESCALATION_DOOR_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/agent-factory-escalation-door.lock}"
exec 9>"$LOCK_FILE"
if ! flock -w "${ESCALATION_DOOR_LOCK_WAIT_SECONDS:-10}" 9; then
  if [[ ${1:-} == sweep ]]; then
    printf 'SWEPT: NOT RUN -- another escalation owns the door; retry next pass\n'
    exit 75
  fi
  die "Could not acquire the escalation-door lock."
fi
# The lock belongs to this process alone (af-wnj692). `9>&-` closes fd 9 for
# everything main runs; bash keeps the lock on a close-on-exec copy, so it is
# held until this script exits but no child can inherit it. Without this, the
# detached `gc nudge poll` a `gc mail send --notify` leaves behind kept the
# flock for as long as it lived and every later escalation failed on it.
main "$@" 9>&-
