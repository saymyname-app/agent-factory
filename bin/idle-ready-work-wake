#!/usr/bin/env python3
"""Idle-ready-work safety net (O02, t1-dispatch-wake).

`ticket-graph-publish` itself notifies the Mayor at the end of every
successful publish or patch -- the primary wake, and the only door approved
work enters the delivery plane by. This script is the safety net for when
that call is missed (a mail delivery failure, a publish run outside the
router, a manually created delivery-plane bead): it watches for ready
delivery-plane work the Mayor may dispatch (not a convoy bead, nothing that
carries the new-flow mark) with no active worker session, and re-wakes the Mayor
once that condition has held for more than 15 minutes -- then again only
after an hour-long cooldown, not on every evaluation while still idle.

Runtime state (the idle window's start time and the last notify time) is
kept at `.gc/runtime/idle-ready-work-state.json`, gitignored (`.gc/` is
host-local Gas City/runtime state), the same F18 pattern the Planning Run
reservation now uses. Intended to run as a Gas City `condition` order,
evaluated on a short cooldown; each run is a pure function of "now",
ready-work state, and the persisted state, so unit tests inject "now" via
IDLE_READY_WORK_NOW instead of sleeping real minutes.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

PROGRAM = "idle-ready-work-wake"
ROOT = Path(__file__).resolve().parents[1]
# Gas City 1.5 gives an order BD_BIN set and empty: an empty value is no
# override (af-d130xt).
BD_BIN = os.environ.get("BD_BIN") or "bd"
GC_BIN = os.environ.get("GC_BIN", "gc")
IDLE_THRESHOLD = timedelta(minutes=15)
NOTIFY_COOLDOWN = timedelta(hours=1)


def state_path(repo_root: Path) -> Path:
    return repo_root / ".gc" / "runtime" / "idle-ready-work-state.json"


def now() -> datetime:
    override = os.environ.get("IDLE_READY_WORK_NOW")
    if override:
        return datetime.fromisoformat(override)
    return datetime.now(timezone.utc)


# The mark bin/convoy-state poses on a convoy of the new flow and on each of
# its tickets (docs/CONVOY_STATE.md).
NEW_FLOW_MARK_KEY = "gc.flow.mark"


def mayor_may_dispatch(item: dict[str, Any]) -> bool:
    """Ready delivery-plane work is the Mayor's to dispatch unless it is a
    convoy bead (a container, never work: af-vnv59w) or carries the new-flow
    mark: bin/convoy-advance starts those tickets and the dispatch door
    refuses them to the Mayor (docs/CONVOY_ADVANCE.md). Counting them woke
    the Mayor every hour for nothing while a marked convoy was open (17
    wakes in 42 hours, 2026-10-13, af-yzo8fo.1)."""
    metadata = item.get("metadata") or {}
    return (
        metadata.get("gc.plane") == "delivery"
        and item.get("issue_type") != "convoy"
        and NEW_FLOW_MARK_KEY not in metadata
    )


def ready_delivery_plane_count(repo_root: Path) -> int:
    """`bd ready` already excludes in_progress/blocked/deferred/hooked
    issues (blocker-aware ready-work semantics), so every item it returns
    is genuinely unclaimed -- only what the Mayor may dispatch needs
    filtering here."""
    result = subprocess.run(
        [BD_BIN, "-C", str(repo_root), "ready", "--json"],
        check=True, capture_output=True, text=True,
    )
    payload = json.loads(result.stdout or "[]")
    items = payload if isinstance(payload, list) else []
    return sum(1 for item in items if isinstance(item, dict) and mayor_may_dispatch(item))


def worker_session_active() -> bool:
    """The Mayor is an always-awake named session, so "no active Mayor
    session" can never hold -- the Spec's actual intent (docs/planning/
    factory-operations-v2/spec/spec-factory-operations-v2-2026-09-28.json)
    is "no active worker", i.e. no `factory-worker` rig writer in progress."""
    result = subprocess.run(
        [GC_BIN, "session", "list", "--json", "--template", "factory-worker"],
        check=True, capture_output=True, text=True,
    )
    payload = json.loads(result.stdout or "{}")
    sessions = payload.get("sessions") if isinstance(payload, dict) else None
    sessions = sessions if isinstance(sessions, list) else []
    return any(isinstance(s, dict) and s.get("state") == "active" for s in sessions)


def read_state(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
        return payload if isinstance(payload, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def write_state(path: Path, idle_since: str | None, notified_at: str | None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps({"idle_since": idle_since, "notified_at": notified_at}),
        encoding="utf-8",
    )


def notify_mayor(ready_count: int, idle_since: str) -> None:
    subprocess.run(
        [
            GC_BIN, "mail", "send", "mayor", "--notify",
            "-s", "idle-ready-work: ready delivery-plane work, no active worker",
            "-m", (
                f"ACTION: idle-ready-work-wake observed {ready_count} ready delivery-plane "
                f"bead(s) with no active worker session since {idle_since}\n"
                "STATE: idle > 15m\n"
                "EVIDENCE: bd ready --json (gc.plane=delivery); gc session list --template factory-worker\n"
                "NEXT: dispatch the ready work, or investigate why the primary publish-time wake "
                "did not reach the Mayor"
            ),
        ],
        check=False, capture_output=True, text=True,
    )


def evaluate(repo_root: Path, notify: bool = True) -> dict[str, Any]:
    path = state_path(repo_root)
    current = now()
    ready_count = ready_delivery_plane_count(repo_root)
    active = worker_session_active()
    state = read_state(path)
    idle_since = state.get("idle_since")
    notified_at = state.get("notified_at")

    if ready_count == 0 or active:
        if idle_since is not None or notified_at is not None:
            write_state(path, None, None)
        return {"ok": True, "fired": False, "reason": "no idle ready work", "ready_count": ready_count}

    if idle_since is None:
        write_state(path, current.isoformat(), notified_at)
        return {"ok": True, "fired": False, "reason": "idle window just started", "ready_count": ready_count}

    since_dt = datetime.fromisoformat(idle_since)
    if current - since_dt < IDLE_THRESHOLD:
        return {"ok": True, "fired": False, "reason": "idle window under 15m", "ready_count": ready_count}

    if notified_at is not None:
        notified_dt = datetime.fromisoformat(notified_at)
        if current - notified_dt < NOTIFY_COOLDOWN:
            return {
                "ok": True, "fired": False, "reason": "notified recently, cooldown active",
                "ready_count": ready_count,
            }

    if notify:
        notify_mayor(ready_count, idle_since)
        write_state(path, idle_since, current.isoformat())
    return {"ok": True, "fired": True, "ready_count": ready_count, "idle_since": idle_since}


def main() -> int:
    parser = argparse.ArgumentParser(prog=PROGRAM)
    parser.add_argument("--repo-root", default=str(ROOT))
    parser.add_argument(
        "--check-only", action="store_true",
        help="evaluate and report without notifying the Mayor; exit 0 if the "
             "condition would fire, 1 otherwise (for the order's check= leg)",
    )
    args = parser.parse_args()
    result = evaluate(Path(args.repo_root), notify=not args.check_only)
    print(json.dumps(result, sort_keys=True))
    if args.check_only:
        return 0 if result["fired"] else 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
