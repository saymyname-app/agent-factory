#!/usr/bin/env python3
"""Run one simple Planning Session to a canonical Spec (B03).

This is a deterministic synthetic prototype, not a live Gas City Planning
Run: given a Planning Session record naming its request, its declared
authoritative context (a Project Planning Profile's Project Knowledge and
Work Graph), and the Shared Understanding reached with the human, it either
synthesizes one Spec artifact or returns the session to planning -- it never
invents an answer for a real contradiction, a missing trace, an undecided
behavior or a new test seam.

Contract: a session may load only its declared authoritative context (no
other file is a legitimate source); a synthesized Spec always carries
behavior, boundaries, decisions, acceptance evidence, provenance,
experiments and non-objectives; a Spec's identity is a pure function of the
session id and its content digest is a pure function of its sections, so
the same session always reproduces the same Spec; and the tool only ever
writes that one Spec file -- never a second prose artifact or a Release
Contract duplicating it.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path
from typing import Any


PROGRAM = "planning-run-to-spec-oracle"
SESSION_CONTRACT = "agent-factory-planning-session/v1"
SPEC_CONTRACT = "agent-factory-planning-run-spec/v1"
SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

# Shared Understanding topics a Spec must trace back to. Order fixes the
# Spec's section order; the dict value is the Spec section key each topic
# fills.
REQUIRED_TOPICS: dict[str, str] = {
    "behavior": "behavior",
    "boundary": "boundaries",
    "decision": "decisions",
    "acceptance_evidence": "acceptance_evidence",
    "provenance": "provenance",
    "experiment": "experiments",
    "non_objective": "non_objectives",
}

RETURN_TO_PLANNING_SIGNALS = (
    "contradiction",
    "missing_trace",
    "undecided_behavior",
    "new_test_seam",
)


class SessionError(RuntimeError):
    """An actionable diagnostic about a Planning Session record."""


class ReturnToPlanning(RuntimeError):
    """A real contradiction, missing trace, undecided behavior or new test
    seam was found; the session goes back to planning instead of a
    fabricated Spec."""

    def __init__(self, signal: str, reason: str):
        super().__init__(reason)
        self.signal = signal
        self.reason = reason


def as_dict(value: Any, name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise SessionError(f"{name} must be an object")
    return value


def as_list(value: Any, name: str) -> list[Any]:
    if not isinstance(value, list):
        raise SessionError(f"{name} must be an array")
    return value


def required_string(value: Any, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise SessionError(f"{name} must be a non-empty string")
    return value


def safe_id(value: Any, name: str) -> str:
    text = required_string(value, name)
    if not SAFE_ID.fullmatch(text):
        raise SessionError(f"{name} contains unsupported characters: {text!r}")
    return text


def canonical_digest(value: Any) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def resolve_source(path_str: str, field: str, repo_root: Path) -> Path:
    resolved = (repo_root / path_str) if not Path(path_str).is_absolute() else Path(path_str)
    if not resolved.is_file():
        raise SessionError(f"{field} names a source that does not exist: {path_str}")
    return resolved.resolve()


def load_session(path: Path) -> dict[str, Any]:
    try:
        raw = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise SessionError(f"cannot read session {path}: {exc}") from exc
    session = as_dict(raw, "session")
    contract = session.get("contract")
    if contract != SESSION_CONTRACT:
        raise SessionError(f"session.contract must be {SESSION_CONTRACT!r}, got {contract!r}")
    return session


def check_declared_context(session: dict[str, Any], repo_root: Path) -> dict[str, Path]:
    """Resolve the session's declared authoritative context and reject any
    probed path that was not declared -- proves the run loads only what the
    Project Planning Profile authorizes."""
    declared_raw = as_dict(session.get("declared_context"), "declared_context")
    knowledge_path = required_string(
        declared_raw.get("project_knowledge_path"), "declared_context.project_knowledge_path"
    )
    work_graph_path = required_string(
        declared_raw.get("work_graph_path"), "declared_context.work_graph_path"
    )
    declared = {
        knowledge_path: resolve_source(knowledge_path, "declared_context.project_knowledge_path", repo_root),
        work_graph_path: resolve_source(work_graph_path, "declared_context.work_graph_path", repo_root),
    }

    probe = as_list(session.get("context_probe", []), "context_probe")
    for index, item in enumerate(probe):
        probed = required_string(item, f"context_probe[{index}]")
        if probed not in declared:
            raise SessionError(
                f"context_probe[{index}] loaded {probed!r}, which is not in "
                "declared_context -- a Planning Run may load only its "
                "declared authoritative context"
            )
    return declared


def check_target_rigs(session: dict[str, Any], city_registry: list[str]) -> list[str]:
    target_rigs = as_list(session.get("target_rigs"), "target_rigs")
    if not target_rigs:
        raise SessionError("target_rigs must name at least one rig")
    rigs = [safe_id(rig, f"target_rigs[{i}]") for i, rig in enumerate(target_rigs)]
    registry = [safe_id(rig, f"city_registry[{i}]") for i, rig in enumerate(city_registry)]
    for rig in rigs:
        if rig not in registry:
            raise SessionError(f"target_rigs names {rig!r}, which is not registered in the City's rig registry")
    return rigs


def check_ceremony(session: dict[str, Any]) -> None:
    """A simple request stays in one healthy interactive session: it must
    not require the mandatory Wayfinder ceremony or another interview
    round."""
    request = as_dict(session.get("request"), "request")
    complexity = required_string(request.get("complexity"), "request.complexity")
    wayfinder_invoked = bool(session.get("wayfinder_ceremony_invoked", False))
    interview_rounds = session.get("interview_rounds", 1)
    if not isinstance(interview_rounds, int) or interview_rounds < 1:
        raise SessionError("interview_rounds must be a positive integer")
    if complexity == "simple" and (wayfinder_invoked or interview_rounds > 1):
        raise SessionError(
            "a simple request must remain in one healthy interactive "
            "Planning Session -- it triggered the Wayfinder ceremony or "
            "another interview round instead"
        )


def check_explicit_signals(session: dict[str, Any]) -> None:
    signals = as_list(session.get("signals", []), "signals")
    for index, raw_signal in enumerate(signals):
        signal = as_dict(raw_signal, f"signals[{index}]")
        kind = required_string(signal.get("kind"), f"signals[{index}].kind")
        if kind not in RETURN_TO_PLANNING_SIGNALS:
            raise SessionError(f"signals[{index}].kind {kind!r} is not a recognized return-to-planning signal")
        detail = required_string(signal.get("detail"), f"signals[{index}].detail")
        raise ReturnToPlanning(kind, detail)


def collect_shared_understanding(session: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:
    entries = as_list(session.get("shared_understanding", []), "shared_understanding")
    by_topic: dict[str, list[dict[str, Any]]] = {topic: [] for topic in REQUIRED_TOPICS}
    for index, raw_entry in enumerate(entries):
        entry = as_dict(raw_entry, f"shared_understanding[{index}]")
        topic = required_string(entry.get("topic"), f"shared_understanding[{index}].topic")
        if topic not in REQUIRED_TOPICS:
            raise SessionError(f"shared_understanding[{index}].topic {topic!r} is not a recognized Spec topic")
        required_string(entry.get("statement"), f"shared_understanding[{index}].statement")
        required_string(entry.get("confirmed_by"), f"shared_understanding[{index}].confirmed_by")
        by_topic[topic].append(entry)
    return by_topic


def synthesize_spec(session: dict[str, Any], by_topic: dict[str, list[dict[str, Any]]]) -> dict[str, Any]:
    """Every required topic must trace back to at least one confirmed
    Shared Understanding entry, or the run returns to planning instead of
    fabricating that section."""
    for topic in REQUIRED_TOPICS:
        if not by_topic[topic]:
            raise ReturnToPlanning(
                "missing_trace",
                f"no confirmed Shared Understanding entry traces to the "
                f"required Spec topic {topic!r}",
            )

    sections = {
        section_key: [
            {"statement": e["statement"], "confirmed_by": e["confirmed_by"]} for e in by_topic[topic]
        ]
        for topic, section_key in REQUIRED_TOPICS.items()
    }

    session_id = safe_id(session.get("session_id"), "session_id")
    spec_id = f"spec-{session_id}"
    return {
        "contract": SPEC_CONTRACT,
        "spec_id": spec_id,
        "session_id": session_id,
        "state": "DRAFT_SPEC",
        "sections": sections,
        "content_digest": canonical_digest(sections),
    }


def run_session(session_path: Path, city_registry: list[str], repo_root: Path) -> dict[str, Any]:
    session = load_session(session_path)
    check_declared_context(session, repo_root)
    check_target_rigs(session, city_registry)
    check_ceremony(session)
    check_explicit_signals(session)
    by_topic = collect_shared_understanding(session)
    spec = synthesize_spec(session, by_topic)
    return {"contract": "agent-factory-planning-run-to-spec-result/v1", "result": "spec_synthesized", "spec": spec}


def repo_root_default() -> Path:
    return Path(__file__).resolve().parents[1]


def cmd_run(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo_root)
    try:
        city_registry = json.loads(Path(args.city_registry).read_text())
        result = run_session(Path(args.session), city_registry, repo_root)
    except ReturnToPlanning as exc:
        payload = {
            "contract": "agent-factory-planning-run-to-spec-result/v1",
            "result": "returned_to_planning",
            "signal": exc.signal,
            "reason": exc.reason,
        }
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    except SessionError as exc:
        print(json.dumps({"result": "rejected", "error": str(exc)}, indent=2))
        return 1
    except (OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"result": "rejected", "error": f"cannot read city registry: {exc}"}, indent=2))
        return 1

    print(json.dumps(result, indent=2, sort_keys=True))

    if args.out:
        out_dir = Path(args.out)
        out_dir.mkdir(parents=True, exist_ok=True)
        spec_path = out_dir / f"{result['spec']['spec_id']}.json"
        spec_path.write_text(json.dumps(result["spec"], indent=2, sort_keys=True) + "\n")

    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    parser.add_argument(
        "--repo-root", default=str(repo_root_default()), help="repository root used to resolve declared context paths"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    run_parser = subparsers.add_parser("run", help="run one Planning Session to a Spec or back to planning")
    run_parser.add_argument("session", help="path to the Planning Session JSON record")
    run_parser.add_argument(
        "--city-registry", required=True, help="path to a JSON array of the City's registered rig ids"
    )
    run_parser.add_argument(
        "--out", default=None, help="directory to write the synthesized Spec artifact into, if any"
    )
    run_parser.set_defaults(func=cmd_run)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
