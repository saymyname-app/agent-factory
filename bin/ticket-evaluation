#!/usr/bin/env python3
"""Ticket Evaluation on the launched product (T15, af-higj9z; Spec af-wf4w5r
§7, §8; user stories 40 to 42).

Before a `vertical_slice` or a `repair` is merged, an Evaluator uses the
product: a session of the read-only Evaluator role, in a fresh context,
started as routed work through bin/dispatch-door on the formula
`mol-ticket-evaluation`. Code prepares what it evaluates: the product is
launched by bin/project-launch from a clean copy of the commit the author
finished at, once per declared dataset, each on its own free port; the
author's work tree is never what is evaluated. The Evaluator is given the
demonstration line and the frozen criteria only -- neither the Ticket
Handoff nor the diff -- and hands in one state per criterion and for the
demonstration line (`observed`, `not_observed`, `unobservable`), each with a
piece captured by bin/evidence-capture on one of those launched products.
It gives no verdict: code computes it. For a `prefactoring` no session
runs: code checks that the product starts and that its probe answers.

    ticket-evaluation settle  CONVOY [--repo DIR] [--profile FILE]   bin/convoy-advance, at each pass
    ticket-evaluation brief   CONVOY TICKET [--repo DIR] [--profile FILE]   the Evaluator session
    ticket-evaluation record  CONVOY TICKET --file FILE [--repo DIR]        the Evaluator session
    ticket-evaluation verdict CONVOY TICKET [--repo DIR]                    any gate: the verdict, computed
    ticket-evaluation show    CONVOY TICKET [--repo DIR]

The state lives in the tracker, read and written through bin/convoy-state
only (`evaluation`, `models`, `stop`, `park`, and the verdict `evaluation`).
Every answer is one JSON object on stdout. Exit status: 0 done; 1 refused or
could not run; 4 the convoy does not carry the new-flow mark. Details:
docs/TICKET_EVALUATION.md.

Environment (tests and non-default layouts):
  FACTORY_ROOT                          repository whose settings and projects are read
  TICKET_EVALUATION_STATE_DIR           where the launch records of the products are kept
  TICKET_EVALUATION_DISPATCH_DOOR_BIN   door that routes the evaluation to the Evaluator
  DELIVERY_ROLE_PROVIDER_FAILOVER_BIN   what says which provider a role runs on
"""

from __future__ import annotations

import argparse
import calendar
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import tomllib
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Iterator


PROGRAM = "ticket-evaluation"
BIN = Path(__file__).resolve().parent
ROOT = Path(os.environ.get("FACTORY_ROOT") or BIN.parent)
GC_BIN = os.environ.get("GC_BIN", "gc")
STATE_TOOL = BIN / "convoy-state"
LAUNCH_TOOL = BIN / "project-launch"
CAPTURE_TOOL = BIN / "evidence-capture"
ESCALATION_TOOL = BIN / "escalation-door"
OPERATOR_CONFIG_BIN = BIN / "operator-config"
SETTINGS = ROOT / "config" / "delivery-flow.json"
PROJECTS = ROOT / "config" / "projects"
DESCRIPTORS = ROOT / "config" / "project-descriptors"

sys.path.insert(0, str(BIN.parent / "lib"))
from convoy_state import retry_after_lift
from delivery_role_identity import role_identity, role_supplier, supplier_of  # noqa: E402

NEW_FLOW = "new-flow/v1"
KIND_PREFACTORING = "prefactoring"
EVALUATOR_ROLE = "evaluator"
EVALUATION, STARTUP = "evaluation", "startup"
STATES = ("observed", "not_observed", "unobservable")
CAUSES = ("criterion", "environment")
FAVORABLE = "favorable"
RETURN_TO_AUTHOR, PLANNING_EXCEPTION, OUTAGE = "return_to_author", "planning_exception", "environment_outage"
STOP_NO_RESULT, STOP_OUTAGE = "evaluation_no_result", "evaluation_outage"
STOPS = (STOP_NO_RESULT, STOP_OUTAGE)
# bin/convoy-state holds the bound (launch-evaluation refuses a third
# launch): the first launch, then one relaunch.
MAX_LAUNCHES = 2
# An outage of the environment is not a refusal (Spec §7): the evaluation is
# made again once on new products; a second outage at the same commit stops
# the ticket as a breakdown of the Factory.
MAX_OUTAGES = 2
# A product that does not start is launched once more before it is said not
# to start: a free port can be taken between its choice and its use.
START_ATTEMPTS = 2
# A launched product waits for the Evaluator on every dataset at once, and
# one that polls its sources costs the host while it waits (af-5rx5mu: 95
# products, load average above 300, the pass cut by the order's timeout).
# Once it answers its probe it runs at the lowest priority: it takes what the
# rest of the host leaves, and is never starved of it.
PRODUCT_NICE = 19
STARTUP_PIECE = "evaluation.startup"
# What the control of a prefactoring captures: the answer of the health probe.
PROBE = ("import sys, urllib.request\n"
         "with urllib.request.urlopen(sys.argv[1], timeout=10) as answer:\n"
         "    print(answer.status)\n"
         "    sys.stdout.write(answer.read().decode('utf-8', 'replace'))\n"
         "    raise SystemExit(0 if answer.status == int(sys.argv[2]) else 1)\n")
# The same, without a status to expect: what the Evaluator captures a page with.
FETCH = ("import sys, urllib.request\n"
         "with urllib.request.urlopen(sys.argv[1], timeout=10) as answer:\n"
         "    print(answer.status)\n"
         "    sys.stdout.write(answer.read().decode('utf-8', 'replace'))\n")

EXIT_REFUSED = 1
EXIT_NOT_NEW_FLOW = 4
# What bin/dispatch-door exits with when it defers a dispatch (EX_TEMPFAIL).
DOOR_DEFERRED = 75

MAX_DETAIL = 300
# bin/escalation-door refuses a field longer than this, or on several lines.
REQUEST_LINE_MAX = 140

# The publication door renders a ticket's rigs under this heading.
RIGS_SECTION_RE = re.compile(r"^## Target rigs[ \t]*\n+([^\n#]*)$", re.MULTILINE)
RIG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


class Refusal(RuntimeError):
    """The call is refused, or could not run."""

    def __init__(self, message: str):
        super().__init__(" ".join(message.split()))


class Deferred(Refusal):
    """Nothing was sent, and the next call tries again: the dispatch door
    deferred the launch, or the Evaluator would run on the author's supplier
    while another one is declared and available."""


class NotNewFlow(RuntimeError):
    """The convoy does not carry the new-flow mark: bin/convoy-state's answer."""

    def __init__(self, answer: dict[str, Any]):
        super().__init__(answer.get("message", ""))
        self.answer = answer


def short(text: str, limit: int = MAX_DETAIL) -> str:
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


# --- the other commands ----------------------------------------------------------


def run(argv: list[str], timeout: float | None = None, detached: bool = False) -> subprocess.CompletedProcess[str]:
    try:
        # `detached`: what the command starts outlives the caller's process
        # group (the product launched for an evaluation runs between passes).
        return subprocess.run(argv, capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=timeout,
                              start_new_session=detached)
    except subprocess.TimeoutExpired as exc:
        raise Refusal(f"{Path(argv[0]).name} n'a pas répondu en {timeout:.0f} s") from exc
    except OSError as exc:
        raise Refusal(f"impossible de lancer {Path(argv[0]).name} : {exc}") from exc


def detail_of(proc: subprocess.CompletedProcess[str]) -> str:
    return short(proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}")


def state_tool(*args: str) -> tuple[int, dict[str, Any]]:
    """One JSON answer of bin/convoy-state."""
    proc = run([str(STATE_TOOL), *args])
    try:
        answer = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise Refusal(f"convoy-state {args[0]} a rendu une réponse illisible : {detail_of(proc)}") from exc
    if not isinstance(answer, dict):
        raise Refusal(f"convoy-state {args[0]} a rendu une réponse illisible : {answer!r}")
    return proc.returncode, answer


def refusal_text(answer: dict[str, Any]) -> str:
    text = str(answer.get("error") or answer.get("message") or answer)
    return text[len("refus : "):] if text.startswith("refus : ") else text


def state_write(*args: str) -> dict[str, Any]:
    status, answer = state_tool(*args)
    if status == EXIT_NOT_NEW_FLOW:
        raise NotNewFlow(answer)
    if status != 0:
        raise Refusal(f"{args[0]} refusé par la commande d'état : {refusal_text(answer)}")
    return answer


def state_write_file(command: str, convoy_id: str, ticket_id: str, content: dict[str, Any], *args: str) -> dict[str, Any]:
    """A state write whose content goes through a JSON file."""
    handle = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8")
    try:
        with handle:
            json.dump(content, handle, ensure_ascii=False)
        return state_write(command, convoy_id, ticket_id, *args, "--file", handle.name)
    finally:
        os.unlink(handle.name)


def read_bead(bead_id: str) -> dict[str, Any]:
    proc = run([GC_BIN, "bd", "show", bead_id, "--json"])
    if proc.returncode != 0:
        raise Refusal(f"gc bd show {bead_id} a échoué : {detail_of(proc)}")
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise Refusal(f"gc bd show {bead_id} a rendu un JSON illisible : {exc}") from exc
    bead = data[0] if isinstance(data, list) and data else data
    if not isinstance(bead, dict):
        raise Refusal(f"bead introuvable : {bead_id}")
    return bead


# --- settings ----------------------------------------------------------------


def load_settings() -> dict[str, Any]:
    """`evaluation` of config/delivery-flow.json: what the dispatch door is
    given to start the Evaluator, how long a launch may take, and how long a
    product may take to answer its probe."""
    try:
        data = json.loads(SETTINGS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise Refusal(f"config/delivery-flow.json illisible : {exc}") from exc
    block = data.get("evaluation") if isinstance(data, dict) else None
    if not isinstance(block, dict):
        raise Refusal("aucun réglage evaluation dans config/delivery-flow.json : la Ticket Evaluation n'est pas réglée")
    settings = {name: block.get(name) for name in ("formula", "role", "rig", "timeout_seconds", "start_timeout_seconds")}
    for name in ("formula", "role", "rig"):
        if not isinstance(settings[name], str) or not settings[name]:
            raise Refusal(f"evaluation.{name} absent ou invalide dans config/delivery-flow.json : {settings[name]!r}")
    for name in ("timeout_seconds", "start_timeout_seconds"):
        value = settings[name]
        if isinstance(value, bool) or not isinstance(value, int) or value < 0:
            raise Refusal(
                f"evaluation.{name} absent ou invalide dans config/delivery-flow.json : {value!r} "
                "(attendu : un nombre entier de secondes)")
    return settings


# --- the convoy and its tickets ---------------------------------------------------


def ticket_rig(ticket_id: str) -> str | None:
    """The single project the ticket names under « Target rigs », or None."""
    description = read_bead(ticket_id).get("description")
    match = RIGS_SECTION_RE.search(description if isinstance(description, str) else "")
    rigs = [rig.strip() for rig in match.group(1).split(",") if rig.strip()] if match else []
    if len(rigs) != 1 or not RIG_RE.match(rigs[0]) or not (PROJECTS / f"{rigs[0]}.toml").is_file():
        return None
    return rigs[0]


def rig_repository(rig: str) -> Path:
    try:
        rig_dir = tomllib.loads((PROJECTS / f"{rig}.toml").read_text(encoding="utf-8")).get("rig_dir")
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise Refusal(f"config/projects/{rig}.toml illisible : {exc}") from exc
    if not isinstance(rig_dir, str) or not rig_dir:
        raise Refusal(f"config/projects/{rig}.toml ne déclare pas rig_dir")
    return (ROOT / rig_dir).resolve()


def rig_profile(rig: str | None) -> Path | None:
    """The profile of the project that spans the rig: it declares the launch
    recipe, the datasets and the health probe."""
    for path in sorted(DESCRIPTORS.glob("*.json")) if rig else []:
        try:
            profile = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(profile, dict) and isinstance(profile.get("rigs"), list) and rig in profile["rigs"]:
            return path
    return None


class Convoy:
    """A marked convoy as bin/convoy-state renders it, in the repository
    that holds its ticket branches."""

    def __init__(self, convoy_id: str, repo: str | None, profile: str | None = None):
        self.id = convoy_id
        self.given_repo = Path(repo).resolve() if repo else None
        self.given_profile = profile
        self._rig: str | None = None
        self.load()

    def load(self) -> None:
        if self.given_repo is None:
            # The mark is read first: an unmarked convoy is answered as such,
            # whatever its tickets name.
            status, answer = state_tool("show", self.id)
            if status == EXIT_NOT_NEW_FLOW:
                raise NotNewFlow(answer)
            if status not in (0, 3) or not isinstance(answer.get("tickets"), list) or not answer["tickets"]:
                raise Refusal(refusal_text(answer))
            self._rig = self._rig or ticket_rig(answer["tickets"][0]["id"])
            if not self._rig:
                raise Refusal(
                    f"les tickets du convoi {self.id} ne nomment pas un seul projet de config/projects sous "
                    "« Target rigs » : son dépôt se donne par --repo")
            self.repo = rig_repository(self._rig)
        else:
            self.repo = self.given_repo
        status, answer = state_tool("show", self.id, "--repo", str(self.repo))
        if status == EXIT_NOT_NEW_FLOW:
            raise NotNewFlow(answer)
        if status not in (0, 3) or not isinstance(answer.get("tickets"), list):
            raise Refusal(refusal_text(answer))
        self.state = answer["convoy"]
        self.tickets: list[dict[str, Any]] = answer["tickets"]

    def ticket(self, ticket_id: str) -> dict[str, Any]:
        for ticket in self.tickets:
            if ticket.get("id") == ticket_id:
                return readable(ticket)
        raise Refusal(f"le ticket {ticket_id} n'appartient pas au convoi {self.id}")

    def profile(self, ticket_id: str, commit: str | None = None) -> tuple[Path, dict[str, Any]]:
        """The profile of the ticket's project and its `launch` block."""
        if self.given_profile:
            path: Path | None = Path(self.given_profile)
        else:
            if self._rig is None:
                self._rig = ticket_rig(ticket_id)
            path = rig_profile(self._rig)
        if path is None:
            raise Refusal(
                f"aucun profil de projet ne couvre le ticket {ticket_id} (config/project-descriptors) : "
                "le produit se lance par la recette de son profil")
        try:
            profile = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise Refusal(f"profil de projet illisible ({path}) : {exc}") from exc
        ticket = self.ticket(ticket_id)
        if ticket.get("establishes_launch_recipe") is True:
            # Only the published recipe-establishing ticket can supply its
            # recipe before integration. Never read its mutable work tree.
            commit = commit or (evaluation_of(ticket).get("request") or {}).get("commit") or ticket.get("tip")
            if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}", commit):
                raise Refusal("commit exact absent pour la recette du ticket")
            try:
                relative = path.resolve().relative_to(ROOT.resolve())
            except ValueError as exc:
                raise Refusal("le profil du ticket doit appartenir à la racine Factory") from exc
            result = run(["git", "-C", str(self.repo), "show", f"{commit}:{relative.as_posix()}"])
            if result.returncode:
                raise Refusal(f"profil absent au commit évalué {commit} : {detail_of(result)}")
            try:
                candidate = json.loads(result.stdout)
            except ValueError as exc:
                raise Refusal(f"profil illisible au commit évalué {commit}") from exc
            if not isinstance(candidate, dict) or any(candidate.get(key) != profile.get(key)
                                                       for key in ("project_id", "rigs")):
                raise Refusal("le profil du ticket change l'identité du projet ou ses rigs")
            profile = {**profile, "launch": candidate.get("launch")}
            folder = state_dir() / "profiles" / ticket_id
            path = folder / f"{commit}.profile"
            content = json.dumps(profile)
            if path.exists():
                if path.read_text(encoding="utf-8") != content:
                    raise Refusal("le profil conservé de cette évaluation a changé")
            else:
                folder.mkdir(parents=True, exist_ok=True)
                path.write_text(content, encoding="utf-8")
            checked = run([str(BIN / "project-planning-profile"), "describe", str(path)])
            if checked.returncode:
                raise Refusal(f"profil du ticket invalide : {detail_of(checked)}")
        launch = profile.get("launch") if isinstance(profile, dict) else None
        if not isinstance(launch, dict):
            raise Refusal(f"le profil {path} ne déclare pas de recette de lancement (launch) : rien à évaluer")
        return path, launch

    def datasets(self, ticket_id: str) -> list[str]:
        """The named datasets the product is launched on: at least one."""
        path, launch = self.profile(ticket_id)
        declared = launch.get("datasets")
        if not isinstance(declared, dict) or not declared:
            raise Refusal(
                f"le profil {path} ne déclare aucun jeu de données (launch.datasets) : le produit ne se lance "
                "que sur un jeu de données nommé")
        return sorted(declared)


def readable(ticket: dict[str, Any]) -> dict[str, Any]:
    """A ticket whose evaluation this command can decide from."""
    if ticket.get("mark") != NEW_FLOW:
        raise Refusal(f"état sans règle : le ticket {ticket.get('id')} ne porte pas la marque du nouveau flux")
    for name in ("evaluation", "models", "stop", "park", "exit", "handoff", "merge"):
        record = ticket.get(name)
        if isinstance(record, dict) and "unruled" in record:
            raise Refusal(f"état sans règle : {record['unruled']}")
    return ticket


def evaluation_of(ticket: dict[str, Any]) -> dict[str, Any]:
    return ticket.get("evaluation") or {
        "rounds": [], "state": {"verdict": None, "outcome": None, "commit": None, "not_observed": [], "unobservable": []}}


def own_stop(ticket: dict[str, Any]) -> dict[str, Any] | None:
    """The stop of the ticket, when its evaluation is what stopped it."""
    stop = ticket.get("stop")
    return stop if isinstance(stop, dict) and stop.get("reason") in STOPS else None


# --- the roles: who evaluates, on whose supplier --------------------------------


def roles_now(ticket: dict[str, Any]) -> tuple[dict[str, Any], dict[str, bool]]:
    """The provider and the supplier of the author (as recorded on the
    ticket when its session took it) and of the Evaluator (as configured
    now), and the suppliers the Evaluator's chain declares."""
    author_provider = ((ticket.get("models") or {}).get("author") or {}).get("provider")
    author = {"provider": author_provider, "supplier": supplier_of(ROOT, author_provider)} if author_provider else None
    try:
        known = role_supplier(ROOT, EVALUATOR_ROLE)
    except LookupError:
        known = None
    evaluator = {"provider": known["provider"], "supplier": known["supplier"]} if known else None
    declared: dict[str, bool] = dict(known["declared"]) if known else {}
    same = None if author is None or evaluator is None else author["supplier"] == evaluator["supplier"]
    other = sorted(name for name in declared if author is not None and name != author["supplier"])
    return {"author": author, "evaluator": evaluator, "same_provider": same, "other_declared": other}, declared


def independence(roles: dict[str, Any] | None) -> str | None:
    """Never silent (Spec §7): an Evaluator of the author's supplier is said
    so for the Evidence Pack, and so is a supplier that was not recorded."""
    if not roles or roles.get("same_provider") is None:
        return ("indépendance de fournisseur non établie : le fournisseur de l'auteur ou celui de l'Evaluator "
                "n'est pas relevé sur le ticket")
    if roles["same_provider"]:
        mention = f"même fournisseur que l'auteur ({roles['evaluator']['supplier']})"
        if roles["other_declared"]:
            mention += f" ; autre fournisseur déclaré mais indisponible : {', '.join(roles['other_declared'])}"
        return mention
    return None


def record_evaluator(convoy_id: str, ticket: dict[str, Any]) -> dict[str, Any]:
    """Write the model the Evaluator role runs on now on the ticket, and
    answer the roles of the evaluation. Deferred when the Evaluator would
    run on the author's supplier while another declared one is available."""
    try:
        identity = role_identity(ROOT, EVALUATOR_ROLE)
    except LookupError:
        identity = None
    if identity:
        state_write("set-model", convoy_id, ticket["id"], "--role", EVALUATOR_ROLE, "--agent", identity["agent"],
                    "--provider", identity["provider"], "--model", identity["model"])
    roles, declared = roles_now(ticket)
    available = [name for name in roles["other_declared"] if declared.get(name)]
    if roles["same_provider"] and available:
        raise Deferred(
            f"l'Evaluator du ticket {ticket['id']} tournerait sur le fournisseur de son auteur "
            f"({roles['author']['supplier']}) alors qu'un autre fournisseur déclaré est disponible "
            f"({', '.join(available)}) : aucune évaluation n'est lancée ; ./bin/provider-failover règle le rôle")
    return roles


# --- the launched products -------------------------------------------------------


def state_dir() -> Path:
    configured = os.environ.get("TICKET_EVALUATION_STATE_DIR")
    # ~/.local/state is what bin/delivery-role-sandbox leaves readable and
    # writable to a read-only role: the Evaluator names a launch record
    # there to bin/evidence-capture.
    return Path(configured) if configured else Path.home() / ".local" / "state" / "agent-factory-evaluation"


def stop_product(state_file: str) -> None:
    if Path(state_file).is_file():
        run([str(LAUNCH_TOOL), "stop", "--state-file", state_file], timeout=60)


def running(state_file: str) -> bool:
    """Whether the product of that launch record still runs."""
    try:
        pid = int(json.loads(Path(state_file).read_text(encoding="utf-8"))["pid"])
        os.kill(pid, 0)
    except (OSError, ValueError, KeyError, TypeError):
        return False
    return True


def yield_host(state_file: str) -> None:
    """Put the launched product of that record, with whatever it started, at
    PRODUCT_NICE. bin/project-launch is started in a session of its own, so
    the process group of the product holds that launch and nothing else."""
    try:
        group = os.getpgid(int(json.loads(Path(state_file).read_text(encoding="utf-8"))["pid"]))
    except (OSError, ValueError, KeyError, TypeError):
        return
    if group == os.getpgrp():
        return
    # Twice: what a thread starts between two readings inherits its priority.
    for _ in range(2):
        for stat in Path("/proc").glob("[0-9]*/stat"):
            try:
                # After the name: state, parent, process group.
                if int(stat.read_text().rsplit(")", 1)[1].split()[2]) != group:
                    continue
                for task in (stat.parent / "task").iterdir():
                    os.setpriority(os.PRIO_PROCESS, int(task.name), PRODUCT_NICE)
            except (OSError, ValueError, IndexError):
                continue


def product_folder(convoy_id: str, ticket_id: str) -> Path:
    return state_dir() / re.sub(r"[^A-Za-z0-9._-]", "_", convoy_id) / re.sub(r"[^A-Za-z0-9._-]", "_", ticket_id)


def prepared_products(convoy: Convoy, ticket_id: str, commit: str) -> list[dict[str, Any]]:
    """Launch records survive an interrupted pass; only this exact product is reusable."""
    prepared = []
    for path in sorted(product_folder(convoy.id, ticket_id).glob("*.json")):
        try:
            record = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if (record.get("started") is True and record.get("commit") == commit
                and record.get("repo_root") == str(convoy.repo) and running(str(path))):
            prepared.append({"dataset": record["dataset"], "address": record["address"], "state_file": str(path)})
    return prepared


def launch_products(convoy: Convoy, ticket_id: str, commit: str, settings: dict[str, Any]) -> list[dict[str, Any]]:
    """Launch the product from a clean copy of `commit`, once per dataset
    the profile declares, each on its own free port (bin/project-launch).
    A product that answers its probe yields the host to everything else.
    Preparation yields after 60 seconds and resumes from exact launch records.
    No evaluation is opened until every dataset is ready; failure stops them all."""
    profile, _ = convoy.profile(ticket_id, commit)
    datasets = convoy.datasets(ticket_id)
    folder = product_folder(convoy.id, ticket_id)
    folder.mkdir(parents=True, exist_ok=True)
    stamp = f"{commit[:12]}-{int(time.time() * 1000)}"
    prepared = {entry["dataset"]: entry for entry in prepared_products(convoy, ticket_id, commit)}
    launched: list[dict[str, Any]] = []
    deadline = time.monotonic() + 60
    try:
        for dataset in datasets:
            if dataset in prepared:
                yield_host(prepared[dataset]["state_file"])
                launched.append(prepared[dataset])
                continue
            if time.monotonic() >= deadline:
                raise Deferred(f"préparation en cours : {len(launched)}/{len(datasets)} jeux prêts, reprise à la prochaine passe")
            state_file = folder / f"{stamp}-{dataset}.json"
            argv = [str(LAUNCH_TOOL), "--repo-root", str(convoy.repo), "start", str(profile), "--commit", commit,
                    "--timeout", str(settings["start_timeout_seconds"]), "--state-file", str(state_file)]
            argv += ["--dataset", dataset]
            for attempt in range(START_ATTEMPTS):
                started = run(argv, timeout=settings["start_timeout_seconds"] + 60, detached=True)
                if started.returncode == 0 and state_file.is_file():
                    break
            else:
                raise Refusal(
                    f"le produit ne démarre pas depuis une copie propre du commit {commit[:12]}"
                    f" sur le jeu {dataset} : {detail_of(started)}")
            record = json.loads(state_file.read_text(encoding="utf-8"))
            yield_host(str(state_file))
            launched.append({"dataset": dataset, "address": record["address"], "state_file": str(state_file)})
    except Deferred:
        raise
    except (Refusal, OSError, ValueError, KeyError):
        for entry in prepared_products(convoy, ticket_id, commit):
            stop_product(entry["state_file"])
        raise
    return launched


def observation_piece(entry: dict[str, Any]) -> str:
    import hashlib
    return "evaluation.controller." + hashlib.sha256(entry["state_file"].encode()).hexdigest()[:24]


def controller_observation(convoy: Convoy, ticket_id: str, commit: str, entry: dict[str, Any], capture=False):
    """An ordinary sealed command piece, scoped to this exact preparation.
    No exception to commit/address verification or to Evaluator judgement."""
    if not convoy.ticket(ticket_id).get("establishes_launch_recipe"):
        return None
    piece = observation_piece(entry)
    argv = [str(BIN / PROGRAM), "observe", convoy.id, ticket_id, "--repo", str(convoy.repo),
            "--commit", commit, "--launch-state", entry["state_file"]]
    if convoy.given_profile:
        argv += ["--profile", convoy.given_profile]
    checked = run([str(CAPTURE_TOOL), "verify", convoy.id, ticket_id, "--piece", piece])
    if checked.returncode and capture and piece not in (convoy.ticket(ticket_id).get("evidence") or {}):
        made = run([str(CAPTURE_TOOL), "command", convoy.id, ticket_id, "--piece", piece,
                    "--launch-state", entry["state_file"], "--timeout", "180", "--expect-exit", "0", "--", *argv], timeout=200)
        if made.returncode:
            raise Refusal(f"observation du contrôleur indisponible : {detail_of(made)}")
        checked = run([str(CAPTURE_TOOL), "verify", convoy.id, ticket_id, "--piece", piece])
    if checked.returncode:
        raise Refusal(f"observation du contrôleur non vérifiable : {detail_of(checked)}")
    report = json.loads(checked.stdout)["pieces"][0]
    record = json.loads(Path(report["path"]).read_text())
    if (record.get("commit") != commit or record.get("address") != entry["address"]
            or record.get("command") != argv or record.get("exit_code") != 0):
        raise Refusal("observation du contrôleur étrangère à cette préparation")
    observation = json.loads(record["output"])
    for reference in observation["references"]:
        captured = reference["anchors"]
        raw = captured.pop("output")
        try:
            captured["anchors_per_state"] = {name: len(anchors) for name, anchors in json.loads(raw).get("anchors", {}).items()}
        except (ValueError, TypeError, AttributeError):
            captured["output_summary"] = short(raw)
        captured["full_output_in"] = report["path"]
    return {"piece": piece, "path": report["path"], "digest": report["digest"], "observation": observation}


def cmd_observe(args: argparse.Namespace) -> int:
    if os.environ.get("DELIVERY_ROLE_READ_ONLY") or os.environ.get("GC_AGENT"):
        raise Refusal("observations réservées au contrôleur, jamais à une session agent")
    convoy = Convoy(args.convoy, args.repo, args.profile)
    ticket = convoy.ticket(args.ticket)
    if not ticket.get("establishes_launch_recipe") or ticket.get("tip") != args.commit:
        raise Refusal("observation réservée à la recette au commit du ticket")
    prepared = prepared_products(convoy, args.ticket, args.commit)
    if not any(entry["state_file"] == args.launch_state for entry in prepared):
        raise Refusal("le produit n'appartient pas à la préparation du contrôleur")
    profile, _ = convoy.profile(args.ticket, args.commit)
    references = {}
    for other in convoy.tickets:
        ref = other.get("validated_prototype")
        if ref:
            key = (ref["commit"], ref["path"])
            if key not in references:
                references[key] = {**ref, "states": []}
            references[key]["states"] = sorted(set(references[key]["states"]) | set(ref["states"]))
    from evaluation_observations import observe
    try:
        observation = observe(BIN, convoy.repo, profile, args.commit, args.launch_state, list(references.values()))
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        raise Refusal(f"observation interrompue : {exc}") from exc
    print(json.dumps(observation, ensure_ascii=False))
    return 0


def reap(convoy: Convoy, ticket: dict[str, Any], keep: list[str], withdraw: bool = False) -> list[str]:
    """Stop every launched product of the ticket that no open evaluation
    runs on (`keep`), and write that it is gone. Environment prepared and
    stopped by code (Spec §7). `withdraw`: the evaluation that was open on
    them is no longer due (a newer tip, a parked ticket) and is withdrawn
    with them."""
    tracked = evaluation_of(ticket).get("live") or []
    local = [str(path) for pattern in ("*.json", "*.trial")
             for path in product_folder(convoy.id, ticket["id"]).glob(pattern)]
    stale = [path for path in dict.fromkeys([*tracked, *local]) if path not in keep]
    if not stale:
        return []
    for path in stale:
        stop_product(path)
    args: list[str] = ["--withdraw"] if withdraw else []
    for path in stale:
        args += ["--state-file", path]
    if any(path in tracked for path in stale):
        state_write("release-evaluation", convoy.id, ticket["id"], *args)
    return stale


# --- what an evaluation is opened on ----------------------------------------------


def green_at(ticket: dict[str, Any], tip: str) -> bool:
    """The evaluation is of a green ticket: the green proof of bin/tdd-step
    (the regression of a prefactoring) is at the tip."""
    step = "prefactoring" if ticket.get("kind") == KIND_PREFACTORING else "green"
    return ((ticket.get("tdd") or {}).get(step) or {}).get("commit") == tip


def outages_at(evaluation: dict[str, Any], tip: str) -> int:
    count = 0
    for round_ in reversed(evaluation["rounds"]):
        if round_["commit"] != tip or round_["outcome"] != OUTAGE:
            break
        count += 1
    return count


def refusal_of(state: dict[str, Any]) -> str:
    return ", ".join(state["not_observed"] + [entry["what"] for entry in state["unobservable"]])


def wanted(ticket: dict[str, Any]) -> tuple[str, Any]:
    """What is due on the evaluation of one ticket: `skip` (not its
    business), `waiting` (with the reason), `evaluated` (favorable at the
    tip), `exception` (a criterion cannot be observed: back to the Planning
    Run), `outage` (the environment failed twice), or `open` / `startup`
    with the commit to evaluate."""
    exit_record = ticket.get("exit") or {}
    if ticket.get("status") == "closed" or exit_record.get("exit") != "finished" or ticket.get("park") or ticket.get("stop"):
        return "skip", None
    tip = ticket.get("tip")
    if not ticket.get("branch") or not tip:
        return "waiting", "branche du ticket introuvable dans le dépôt"
    merge = ticket.get("merge") or {}
    if merge.get("outcome") == "merged" and merge.get("ticket_commit") == tip:
        return "skip", None
    handoff = ticket.get("handoff") or {}
    if handoff.get("partial") is not False or handoff.get("commit") != tip:
        return "waiting", f"le ticket n'est pas terminé à la pointe de sa branche ({tip[:12]}) : son auteur y travaille"
    if not green_at(ticket, tip):
        return "waiting", (f"le ticket n'est pas prouvé vert à la pointe de sa branche ({tip[:12]}, bin/tdd-step) : "
                           "l'évaluation porte sur un ticket vert")
    evaluation = evaluation_of(ticket)
    last = evaluation["rounds"][-1] if evaluation["rounds"] else None
    if last is not None and last["commit"] == tip and not retry_after_lift(last, ticket.get("park_lifts")):
        state = evaluation["state"]
        if last["outcome"] == FAVORABLE:
            return "evaluated", None
        if last["outcome"] == RETURN_TO_AUTHOR:
            return "waiting", (f"non observé à la pointe ({refusal_of(state)}) : retour à l'auteur, rien ne fusionne "
                               "avant un nouveau commit")
        if last["outcome"] == PLANNING_EXCEPTION:
            return "exception", state
        if outages_at(evaluation, tip) >= MAX_OUTAGES:
            return "outage", state
    # No evaluation at the tip yet (a commit added after a verdict has it
    # replayed in full, Spec §8), or one that the environment hid.
    return ("startup" if ticket.get("kind") == KIND_PREFACTORING else "open"), tip


# --- launching the Evaluator --------------------------------------------------------


@contextmanager
def ticket_lock(ticket_id: str) -> Iterator[None]:
    """One decision at a time on the evaluation of a ticket."""
    lock_dir = Path(os.environ.get("CONVOY_STATE_LOCK_DIR") or os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
    lock_dir.mkdir(parents=True, exist_ok=True)
    safe_id = re.sub(r"[^A-Za-z0-9._-]", "_", ticket_id)
    with (lock_dir / f"agent-factory-ticket-evaluation-{safe_id}.lock").open("w") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def launch(convoy: Convoy, ticket_id: str, request: dict[str, Any], settings: dict[str, Any]) -> str:
    """Send the open evaluation to a new Evaluator session: a bead of its
    own, routed through the dispatch door on the Evaluator role."""
    number = len(request["launches"]) + 1
    proc = run([
        GC_BIN, "bd", "create", f"Ticket Evaluation — {ticket_id} (lancement {number})",
        "-p", "1", "-t", "task", "-d",
        f"Ticket Evaluation of {ticket_id} on the launched product, at commit {request['commit']} "
        f"(launch {number}).\n\nconvoy: {convoy.id}\nticket: {ticket_id}\n",
        "--json"])
    try:
        created = json.loads(proc.stdout)
        created = created[0] if isinstance(created, list) and created else created
        bead_id = created["id"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise Refusal(f"gc bd create n'a pas rendu l'identifiant du bead d'évaluation : {detail_of(proc)}") from exc
    door = os.environ.get("TICKET_EVALUATION_DISPATCH_DOOR_BIN") or str(BIN / "dispatch-door")
    routed = run([door, bead_id, "--rig", settings["rig"], "--formula", settings["formula"], "--role", settings["role"]])
    if routed.returncode != 0:
        run([GC_BIN, "bd", "close", bead_id, "--reason", "Évaluation non routée par la porte de dispatch."])
        if routed.returncode == DOOR_DEFERRED:
            raise Deferred(
                f"le lancement de l'évaluation du ticket {ticket_id} est différé par la porte de dispatch : "
                f"{detail_of(routed)} ; aucun lancement n'est compté, le prochain appel réessaie")
        raise Refusal(
            f"l'évaluation du ticket {ticket_id} n'a pas été routée vers le rôle Evaluator : "
            f"{detail_of(routed)} ; aucun lancement n'est compté")
    try:
        state_write("launch-evaluation", convoy.id, ticket_id, "--bead", bead_id)
    except Refusal:
        # The Evaluator answered before its launch was written: its states
        # closed the request, and there is nothing left to record.
        convoy.load()
        if evaluation_of(convoy.ticket(ticket_id)).get("request") is not None:
            raise
    return bead_id


def launched_at(launched: dict[str, Any]) -> int:
    try:
        return calendar.timegm(time.strptime(launched["at"], "%Y-%m-%dT%H:%M:%SZ"))
    except (KeyError, TypeError, ValueError) as exc:
        raise Refusal(f"heure de lancement de l'évaluation illisible : {launched!r}") from exc


def expired(launched: dict[str, Any], timeout: int) -> bool:
    """A launch that gave no result: its time is over, its bead was
    closed without states (the record closes the request first),
    or the session that answered it had already rendered another review of
    the convoy (`refused`, set by bin/convoy-state)."""
    if launched.get("refused"):
        return True
    if time.time() >= launched_at(launched) + timeout:
        return True
    try:
        return read_bead(launched["bead"]).get("status") == "closed"
    except Refusal:
        return False


# --- what leaves the flow: the operator ----------------------------------------------


def operator_language() -> str:
    language = run([str(OPERATOR_CONFIG_BIN), "language"])
    if language.returncode != 0:
        raise Refusal(f"la langue de l'opérateur est illisible : {detail_of(language)}")
    return language.stdout.strip()


def escalate(ticket_id: str, request: dict[str, Any], what: str) -> None:
    payload = {**request, "langue": operator_language(), "bloquant": True}
    proc = run([str(ESCALATION_TOOL), "benjamin", ticket_id, json.dumps(payload, ensure_ascii=False)])
    if proc.returncode != 0:
        raise Refusal(f"{what} mais la porte d'escalade a refusé sa remontée : {detail_of(proc)}")


def raise_stop(convoy_id: str, ticket: dict[str, Any], stop: dict[str, Any]) -> bool:
    """One request per stop: the escalation door puts the ticket on the
    operator's list, and bin/convoy-state records that it did."""
    if "raised" in stop:
        return False
    if stop["reason"] == STOP_OUTAGE:
        what = f"Ticket {ticket['id']} arrêté : l'environnement d'évaluation est en panne, deux évaluations de suite"
        why = "Une panne de l'environnement n'est pas un refus : le ticket n'est ni refusé ni fusionné tant qu'elle dure."
        first = "Faire réparer l'environnement d'évaluation par la maintenance de l'usine"
    else:
        what = f"Ticket {ticket['id']} arrêté : sa Ticket Evaluation n'a rendu aucun état, relance comprise"
        why = "Une évaluation sans résultat n'est pas passée : sans verdict favorable, rien de ce ticket ne fusionne."
        first = "Faire vérifier le rôle Evaluator par la maintenance de l'usine"
    request = {
        "quoi": short(what, REQUEST_LINE_MAX), "pourquoi": why,
        "que_faire": [
            {"option": first, "consequence": "Le ticket reste arrêté tant que son arrêt n'est pas levé."},
            {"option": "Laisser le ticket arrêté",
             "consequence": "Rien de ce ticket ne fusionne ; les tickets qui l'attendent ne démarrent pas."},
        ],
    }
    escalate(ticket["id"], request, f"le ticket {ticket['id']} est arrêté ({stop['reason']})")
    state_write("stop-raised", convoy_id, ticket["id"])
    return True


def raise_planning_exception(convoy_id: str, ticket: dict[str, Any], state: dict[str, Any]) -> list[str]:
    """Spec §7: a criterion the Evaluator could not observe because of the
    criterion itself goes back to the Planning Run, so to the operator. The
    ticket and those that wait for it are parked; nobody waives a criterion."""
    names = ", ".join(entry["what"] for entry in state["unobservable"] if entry["cause"] == "criterion")
    head = f"Planning Exception sur {ticket['id']} : "
    what = head + short(f"inobservable sur le produit lancé ({names})", REQUEST_LINE_MAX - len(head))
    request = {
        "quoi": what,
        "pourquoi": "Un critère gelé que l'Evaluator ne peut pas observer ne se dispense ni ne se reformule.",
        "que_faire": [
            {"option": "Trancher dans le Planning Run",
             "consequence": "Le ticket et ceux qui l'attendent restent parqués jusqu'à ta décision."},
            {"option": "Retirer le ticket du graphe",
             "consequence": "Le graphe révisé passe par la porte de patch ; la couverture est recalculée."},
        ],
    }
    escalate(ticket["id"], request, f"le ticket {ticket['id']} a un critère inobservable")
    return state_write("park", convoy_id, ticket["id"], "--cause", "planning_exception", "--detail", what)["parked"]


# --- settle: what is due on one ticket ----------------------------------------------


def probe_of(launch_block: dict[str, Any]) -> tuple[str, int]:
    probe = launch_block.get("health_probe") if isinstance(launch_block.get("health_probe"), dict) else {}
    return str(probe.get("path") or "/"), int(probe.get("expect_status", 200))


def startup_control(convoy: Convoy, ticket_id: str, commit: str, settings: dict[str, Any]) -> dict[str, Any]:
    """Spec §7, a prefactoring: no Evaluator session. Code launches the
    product from a clean copy of the commit, captures the answer of its
    probe, stops it, and records what it saw."""
    try:
        launched = launch_products(convoy, ticket_id, commit, settings)
    except Deferred:
        raise
    except Refusal as exc:
        written = state_write("record-startup", convoy.id, ticket_id, "--commit", commit, "--detail", short(str(exc), 240))
        return {"ticket": ticket_id, "action": "refused_startup", "commit": commit, "verdict": written["verdict"]}
    try:
        path, status = probe_of(convoy.profile(ticket_id)[1])
        first = launched[0]
        captured = run([
            str(CAPTURE_TOOL), "command", convoy.id, ticket_id, "--piece", STARTUP_PIECE,
            "--launch-state", first["state_file"], "--expect-exit", "0", "--timeout", "60", "--",
            sys.executable, "-c", PROBE, first["address"] + path, str(status)], timeout=120)
    finally:
        for entry in launched:
            stop_product(entry["state_file"])
    environment = [{"dataset": entry["dataset"], "address": entry["address"]} for entry in launched]
    if captured.returncode != 0:
        written = state_write("record-startup", convoy.id, ticket_id, "--commit", commit, "--detail",
                              short(f"la sonde du produit lancé ne répond pas comme attendu : {detail_of(captured)}", 240))
        return {"ticket": ticket_id, "action": "refused_startup", "commit": commit, "verdict": written["verdict"]}
    written = state_write_file("record-startup", convoy.id, ticket_id, {"environment": environment},
                               "--commit", commit, "--piece", STARTUP_PIECE)
    return {"ticket": ticket_id, "action": "started", "commit": commit, "verdict": written["verdict"],
            "evidence": STARTUP_PIECE}


def settle_ticket(convoy: Convoy, ticket_id: str, settings: dict[str, Any]) -> dict[str, Any]:
    """Do what is due on the evaluation of one ticket, from the tracker and
    its branch alone: stop the products nothing runs on any more, raise a
    stop that did not reach the operator, launch the products and send the
    evaluation that is due at the tip, send it once more when it gave no
    result, stop the ticket when the relaunch gave none either. A second
    call on the same state does nothing."""
    with ticket_lock(ticket_id):
        convoy.load()
        ticket = convoy.ticket(ticket_id)
        what, detail = wanted(ticket)
        request = evaluation_of(ticket).get("request")
        current = request if request and what == "open" and request["commit"] == detail else None
        # An evaluation left open on a ticket that is no longer to be
        # evaluated at that commit is withdrawn with its products; the one
        # of a stopped ticket stays, as what stopped it.
        preparing = prepared_products(convoy, ticket_id, detail) if what in ("open", "startup") and not current else []
        # A completed/outage round must get fresh products. Only records
        # not yet attached to any evaluation represent partial preparation.
        previous_live = evaluation_of(ticket).get("live") or []
        preparing = [entry for entry in preparing if entry["state_file"] not in previous_live]
        keep = current["environment"] if current else preparing
        reap(convoy, ticket, [entry["state_file"] for entry in keep],
             withdraw=request is not None and current is None and not ticket.get("stop"))
        stop = own_stop(ticket)
        if stop:
            return {"ticket": ticket_id, "action": "escalated" if raise_stop(convoy.id, ticket, stop) else "none"}
        if what in ("skip", "evaluated"):
            return {"ticket": ticket_id, "action": "none"}
        if what == "waiting":
            return {"ticket": ticket_id, "action": "waiting", "reason": detail}
        if what == "exception":
            parked = raise_planning_exception(convoy.id, ticket, detail)
            return {"ticket": ticket_id, "action": "planning_exception", "parked": parked}
        if what == "outage":
            stop_detail = f"l'environnement d'évaluation a manqué {MAX_OUTAGES} fois de suite au commit {ticket['tip'][:12]}"
            state_write("stop-ticket", convoy.id, ticket_id, "--reason", STOP_OUTAGE, "--detail", stop_detail)
            convoy.load()
            ticket = convoy.ticket(ticket_id)
            raise_stop(convoy.id, ticket, ticket["stop"])
            return {"ticket": ticket_id, "action": "stopped", "stop": STOP_OUTAGE}
        commit = detail
        # Refused before anything is launched or recorded: no named dataset.
        convoy.datasets(ticket_id)
        if what == "startup":
            return startup_control(convoy, ticket_id, commit, settings)
        launches = current["launches"] if current else []
        timeout = settings["timeout_seconds"]
        if launches and not expired(launches[-1], timeout):
            deadline = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(launched_at(launches[-1]) + timeout))
            return {"ticket": ticket_id, "action": "pending", "commit": commit, "launches": len(launches),
                    "deadline": deadline}
        if len(launches) >= MAX_LAUNCHES:
            stop_detail = (f"la Ticket Evaluation n'a rendu aucun état en {len(launches)} lancements "
                           f"({', '.join(launch_['bead'] for launch_ in launches)})")
            state_write("stop-ticket", convoy.id, ticket_id, "--reason", STOP_NO_RESULT, "--detail", stop_detail)
            convoy.load()
            ticket = convoy.ticket(ticket_id)
            reap(convoy, ticket, [])
            raise_stop(convoy.id, ticket, ticket["stop"])
            return {"ticket": ticket_id, "action": "stopped", "stop": STOP_NO_RESULT}
        if current is None or not all(running(entry["state_file"]) for entry in current["environment"]):
            # The roles first: an evaluation that is deferred launches nothing.
            roles = record_evaluator(convoy.id, ticket)
            try:
                environment = launch_products(convoy, ticket_id, commit, settings)
            except Deferred:
                raise
            except Refusal as exc:
                # The clean copy does not start: nothing can be observed on it.
                written = state_write("record-startup", convoy.id, ticket_id, "--commit", commit, "--detail",
                                      short(str(exc), 240))
                return {"ticket": ticket_id, "action": "refused_startup", "commit": commit, "verdict": written["verdict"]}
            controller_observation(convoy, ticket_id, commit, environment[0], capture=True)
            try:
                state_write_file("open-evaluation", convoy.id, ticket_id, {"roles": roles, "environment": environment},
                                 "--commit", commit)
            except (Refusal, NotNewFlow):
                for entry in environment:
                    stop_product(entry["state_file"])
                raise
            convoy.load()
            ticket = convoy.ticket(ticket_id)
            reap(convoy, ticket, [entry["state_file"] for entry in environment])
            current = evaluation_of(convoy.ticket(ticket_id))["request"]
        bead_id = launch(convoy, ticket_id, current, settings)
        return {"ticket": ticket_id, "action": "relaunched" if launches else "launched", "commit": commit,
                "bead": bead_id, "launches": len(launches) + 1,
                "environment": [{"dataset": entry["dataset"], "address": entry["address"]}
                                for entry in current["environment"]]}


def cmd_settle(args: argparse.Namespace) -> int:
    settings = load_settings()
    convoy = Convoy(args.convoy, args.repo, args.profile)
    answer: dict[str, Any] = {"ok": True, "convoy": args.convoy, "launched": [], "relaunched": [], "pending": [],
                              "waiting": [], "started": [], "refused_startup": [], "planning_exception": [],
                              "stopped": [], "escalated": [], "deferred": [], "refused": []}
    for ticket_id in [ticket.get("id") for ticket in convoy.tickets]:
        try:
            done = settle_ticket(convoy, ticket_id, settings)
        except Deferred as exc:
            answer["deferred"].append({"ticket": ticket_id, "reason": str(exc)})
            continue
        except Refusal as exc:
            answer["refused"].append({"ticket": ticket_id, "reason": str(exc)})
            continue
        if done["action"] != "none":
            answer[done.pop("action")].append(done)
    answer["ok"] = not answer["refused"]
    print(json.dumps(answer, indent=2, sort_keys=True, ensure_ascii=False))
    return 0 if answer["ok"] else EXIT_REFUSED


# --- brief: what the Evaluator is given ----------------------------------------------


def open_request(convoy: Convoy, ticket_id: str) -> dict[str, Any]:
    request = evaluation_of(convoy.ticket(ticket_id)).get("request")
    if request is None:
        raise Refusal(
            f"aucune évaluation n'est demandée sur le ticket {ticket_id} : l'évaluation répond à une demande "
            f"ouverte par {PROGRAM} settle")
    return request


def cmd_brief(args: argparse.Namespace) -> int:
    """What the Evaluator session is given, and nothing of the author: the
    demonstration line, the frozen criteria, the launched products, how a
    piece of evidence is captured on them, and the shape of what it hands
    to `record`. Neither the Ticket Handoff, nor the diff, nor the
    repository, nor the branch."""
    convoy = Convoy(args.convoy, args.repo, args.profile)
    request = open_request(convoy, args.ticket)
    _, launch_block = convoy.profile(args.ticket, request["commit"])
    capture = [str(CAPTURE_TOOL), "command", args.convoy, args.ticket, "--piece", "evaluation.<name>",
               "--launch-state", "<launch_state of the product>", "--"]
    brief = {
        "ok": True, "convoy": args.convoy, "ticket": args.ticket, "commit": request["commit"],
        "demonstration_line": request["demonstration_line"],
        "criteria": [{"number": number, "text": text} for number, text in enumerate(request["criteria"], start=1)],
        "environments": [{"dataset": entry["dataset"], "address": entry["address"], "launch_state": entry["state_file"]}
                         for entry in request["environment"]],
        "entry_points": launch_block.get("entry_points") or [],
        "controller_observation": controller_observation(convoy, args.ticket, request["commit"], request["environment"][0]),
        "states": list(STATES), "unobservable_causes": list(CAUSES),
        "capture": {
            "command": capture + ["<any command that uses the product at its address>"],
            "page": capture + [sys.executable, "-c", FETCH, "<address><path>"],
            "screenshot": [str(CAPTURE_TOOL), "screenshot", args.convoy, args.ticket, "--piece", "evaluation.<name>",
                           "--launch-state", "<launch_state of the product>", "--path", "/<path>"],
        },
        "result_shape": {
            "commit": request["commit"],
            "criteria": [{"number": "<criterion number>", "text": "<the criterion, copied exactly>",
                          "state": "|".join(STATES), "evidence": "<piece name>",
                          "reason": "<required unless observed>", "cause": "|".join(CAUSES) + " (unobservable only)"}],
            "demonstration_line": {"text": "<the demonstration line, copied exactly>", "state": "|".join(STATES),
                                   "evidence": "<piece name>"},
        },
        "roles": request["roles"], "independence": independence(request["roles"]),
    }
    print(json.dumps(brief, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


# --- the pieces of evidence -----------------------------------------------------------


def piece_refusal(convoy_id: str, ticket_id: str, piece: Any, commit: str, addresses: list[str]) -> str | None:
    """Why `piece` is not a valid Evidence Record of this evaluation, or
    None when it is one: produced by the capture tool, on one of the
    products code launched for it, at the evaluated commit."""
    if not isinstance(piece, str) or not piece.strip():
        return "aucune pièce de preuve nommée"
    proc = run([str(CAPTURE_TOOL), "verify", convoy_id, ticket_id, "--piece", piece])
    try:
        answer = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return f"la pièce {piece} n'a pas pu être vérifiée : {detail_of(proc)}"
    if proc.returncode != 0 or not answer.get("ok"):
        return refusal_text(answer)
    try:
        path = next(entry["path"] for entry in answer["pieces"] if entry["piece"] == piece)
        record = json.loads(Path(path).read_text(encoding="utf-8"))
    except (StopIteration, KeyError, TypeError, OSError, ValueError):
        return f"la pièce {piece} est illisible dans le magasin de preuves"
    if record.get("commit") != commit:
        return f"la pièce {piece} a été capturée au commit {record.get('commit')}, non au commit évalué {commit}"
    if record.get("address") not in addresses:
        return (f"la pièce {piece} n'a pas été capturée sur le produit lancé pour cette évaluation "
                f"(adresse {record.get('address')!r}, attendu : {', '.join(addresses)}) : l'environnement de l'auteur "
                "n'est jamais celui qui est évalué")
    return None


def handed_pieces(given: dict[str, Any]) -> list[Any]:
    items = [item for item in given.get("criteria") or [] if isinstance(item, dict)] \
        if isinstance(given.get("criteria"), list) else []
    if isinstance(given.get("demonstration_line"), dict):
        items.append(given["demonstration_line"])
    return list(dict.fromkeys(item.get("evidence") for item in items if isinstance(item.get("evidence"), str)))


# --- record: what the Evaluator hands in ---------------------------------------------


def cmd_record(args: argparse.Namespace) -> int:
    convoy = Convoy(args.convoy, args.repo)
    if os.environ.get("DELIVERY_ROLE_READ_ONLY") != "1":
        raise Refusal(
            "une Ticket Evaluation ne s'enregistre que depuis une session du rôle Evaluator, en lecture seule "
            "(bin/delivery-role-sandbox)")
    try:
        given = json.loads(Path(args.file or "").read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise Refusal(f"l'évaluation {args.file!r} n'est pas lisible ({exc})") from exc
    if not isinstance(given, dict):
        raise Refusal("l'évaluation rendue n'est pas un objet JSON")
    request = evaluation_of(convoy.ticket(args.ticket)).get("request")
    if request is None:
        raise Refusal(
            f"aucune évaluation n'est demandée sur le ticket {args.ticket} : des états répondent à une demande ouverte")
    addresses = [entry["address"] for entry in request["environment"]]
    refused = [reason for reason in (piece_refusal(args.convoy, args.ticket, piece, request["commit"], addresses)
                                     for piece in handed_pieces(given)) if reason]
    if refused:
        raise Refusal("état sans Evidence Record valide : " + " ; ".join(refused))
    # Never GC_AGENT: it names a place in the pool of the agent, which the next session takes.
    session = os.environ.get("GC_SESSION_NAME") or os.environ.get("GC_SESSION_ID") or ""
    written = state_write_file("record-evaluation", args.convoy, args.ticket, {**given, "recorded_by": session})
    print(json.dumps({
        "ok": True, "convoy": args.convoy, "ticket": args.ticket, "commit": request["commit"],
        "outcome": written["outcome"], "verdict": written["verdict"], "state": written["state"],
    }, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


# --- verdict: computed by code ---------------------------------------------------------


CONSEQUENCES = {
    FAVORABLE: "favorable : chaque critère et la ligne de démonstration sont observés avec preuve au commit de tête",
    RETURN_TO_AUTHOR: "défavorable : retour à l'auteur",
    PLANNING_EXCEPTION: "défavorable : Planning Exception, un critère inobservable ne se dispense ni ne se reformule",
    OUTAGE: "panne de l'environnement : non comptée comme refus, l'évaluation est à refaire",
}


def computed_verdict(convoy: Convoy, ticket: dict[str, Any]) -> dict[str, Any]:
    """The verdict of the Ticket Evaluation of a ticket, from the tracker,
    the evidence store and the tip of its branch: favorable only if every
    criterion and the demonstration line are « observé », each with a valid
    piece, at the head commit."""
    evaluation = evaluation_of(ticket)
    last = evaluation["rounds"][-1] if evaluation["rounds"] else None
    tip = ticket.get("tip")
    answer: dict[str, Any] = {"favorable": False, "verdict": None, "outcome": None, "commit": None, "tip": tip,
                              "reasons": []}
    if last is None:
        answer["reasons"].append("aucune Ticket Evaluation rendue : l'absence d'évaluation ne vaut pas accord")
        return answer
    answer.update(verdict=last["verdict"], outcome=last["outcome"], commit=last["commit"],
                  consequence=CONSEQUENCES[last["outcome"]], state=evaluation["state"])
    if evaluation.get("request"):
        answer["reasons"].append("une évaluation est en cours : les états de la pointe ne sont pas rendus")
    if last["commit"] != tip:
        answer["reasons"].append(
            f"évaluation rendue au commit {last['commit'][:12]} et non au commit de tête "
            f"{str(tip)[:12]} : à rejouer sur la pointe")
    if last["outcome"] != FAVORABLE:
        answer["reasons"].append(CONSEQUENCES[last["outcome"]] + (
            f" ({refusal_of(evaluation['state'])})" if refusal_of(evaluation["state"]) else ""))
    addresses = [entry["address"] for entry in last.get("environment") or []]
    if last["kind"] == STARTUP:
        pieces = [last["evidence"]] if last.get("started") else []
    else:
        pieces = list(dict.fromkeys([item["evidence"] for item in last["criteria"]] + [last["demonstration_line"]["evidence"]]))
    for piece in pieces:
        refusal = piece_refusal(convoy.id, ticket["id"], piece, last["commit"], addresses)
        if refusal:
            answer["reasons"].append(f"preuve non recevable : {refusal}")
    stored = (ticket.get("verdicts") or {}).get(EVALUATION) or {}
    if last["verdict"] is not None and (stored.get("state") != last["verdict"] or stored.get("commit") != last["commit"]):
        answer["reasons"].append("le verdict écrit sur le ticket n'est pas celui de sa dernière évaluation")
    answer["favorable"] = not answer["reasons"]
    if not answer["favorable"] and last["outcome"] == FAVORABLE:
        answer["verdict"] = None
    return answer


def cmd_verdict(args: argparse.Namespace) -> int:
    convoy = Convoy(args.convoy, args.repo)
    ticket = convoy.ticket(args.ticket)
    print(json.dumps({"ok": True, "convoy": args.convoy, "ticket": args.ticket, **computed_verdict(convoy, ticket)},
                     indent=2, sort_keys=True, ensure_ascii=False))
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    convoy = Convoy(args.convoy, args.repo)
    ticket = convoy.ticket(args.ticket)
    evaluation = evaluation_of(ticket)
    last = evaluation["rounds"][-1] if evaluation["rounds"] else None
    roles = (evaluation.get("request") or last or {}).get("roles")
    print(json.dumps({
        "ok": True, "convoy": args.convoy, "ticket": args.ticket, "tip": ticket.get("tip"),
        "rounds": evaluation["rounds"], "request": evaluation.get("request"), "state": evaluation["state"],
        "live": evaluation.get("live") or [],
        "verdict": (ticket.get("verdicts") or {}).get(EVALUATION),
        "models": ticket.get("models"), "roles": roles, "independence": independence(roles) if roles else None,
        "stop": ticket.get("stop"), "park": ticket.get("park"),
    }, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


# --- command line --------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    def command(name: str, handler: Any) -> argparse.ArgumentParser:
        p = sub.add_parser(name)
        p.add_argument("convoy")
        p.add_argument("ticket")
        p.add_argument("--repo")
        p.set_defaults(handler=handler, profile=None)
        return p

    # Required values are checked by the handlers, not by argparse: a
    # refusal is one JSON answer.
    p = command("observe", cmd_observe)
    p.add_argument("--profile")
    p.add_argument("--commit", required=True)
    p.add_argument("--launch-state", required=True)
    command("brief", cmd_brief).add_argument("--profile")
    command("record", cmd_record).add_argument("--file")
    command("verdict", cmd_verdict)
    command("show", cmd_show)
    p = sub.add_parser("settle")
    p.add_argument("convoy")
    p.add_argument("--repo")
    p.add_argument("--profile")
    p.set_defaults(handler=cmd_settle, ticket=None)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args)
    except NotNewFlow as exc:
        print(json.dumps(exc.answer, indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_NOT_NEW_FLOW
    except Refusal as exc:
        print(json.dumps({"ok": False, "ticket": args.ticket, "error": f"refus : {exc}"},
                         indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_REFUSED


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
