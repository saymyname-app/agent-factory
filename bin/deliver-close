#!/usr/bin/env bash
#
# Close a Factory delivery-outcome Bead only after independently verifying
# that the named GitHub pull request is merged and its required workflow
# succeeded on the exact PR head --
# or, for the lighter ADR-0009 work-record outcome (no PR yet, or none ever
# expected), write gc.work_outcome and close the bead through the same door.
#
# ADR-0016 invariant 2: closing a delivery bead without its six proof fields
# (gc.delivery_status, gc.work_outcome, gc.github_repo, gc.pr_number,
# gc.pr_head, gc.merge_commit) must be refused, never silent. The --repo/--pr
# form is the only path that is allowed to set gc.delivery_status=merged: it
# derives all six fields plus merge/CI evidence from GitHub and writes them in
# the same `gc bd update` call that closes the bead, so a delivery bead can
# never end up closed-but-undocumented. On any verification failure it exits
# non-zero and makes no metadata change at all.
#
# ADR-0023: mol-do-work used to write gc.work_outcome itself with a raw
# `gc bd update` at the point a worker closes its own work bead -- long
# before any PR exists to verify, since push-and-pr runs as a later step.
# The --outcome form is that door: it writes gc.outcome / gc.work_outcome
# (and, for shipped, gc.work_commit / gc.work_branch) and closes the bead.
# There is usually nothing to verify yet at that point in the workflow --
# but af-fzlp2 (2026-09-18, twice in about an hour: af-jj9u7/PR #120 still
# open with red CI, af-cwitl/PR #123 with unresolved conflicts) showed a
# bead can already carry its own gc.pr_url from an earlier attempt when this
# door runs again. Since close_by_outcome always sets gc.outcome=pass, that
# is exactly the af-x45xw shape factory-delivery-guard otherwise only catches
# after the close already happened. So the --outcome form checks first: if
# the bead already names a gc.pr_url, it is independently verified with
# the same way the --repo/--pr form does, and the close is refused (no metadata
# change) unless that PR is merged with exact-head CI success. A bead
# with no gc.pr_url yet -- the ordinary case -- has nothing to verify and
# closes exactly as before.
#
# af-zwhh0/af-cphvt: --outcome blocked|abandoned must carry --classification
# repair|semantic|topology (bin/planning-exception's own vocabulary --
# "classify" tells a worker whether its situation is a bounded technical
# repair or a genuine semantic/topology surprise that must raise a Planning
# Exception, ADR-0028). A repair classification writes gc.blocked_classification
# and nothing else. A semantic or topology classification requires
# --planning-exception-id <decision-id> naming the decision an earlier
# `bin/planning-exception raise` already produced for this bead -- without it
# the close is refused outright, before any Beads write, so a worker cannot
# record "this needs a Planning Exception" in free text and close anyway (the
# af-4a44k shape this bead exists to close: a worker's own closing note said
# exactly this, but no exception was ever raised). A blocked/abandoned close
# with no --classification at all is refused the same way (af-cphvt): the
# original af-zwhh0 cut left --classification optional, which let a worker
# skip the triage question entirely by just never passing the flag -- the
# same silent-skip shape with one fewer step.
# bin/factory-planning-exception-guard is the complementary detection net for
# beads already closed this way without going through this enforcement (e.g.
# a raw `gc bd update` bypassing this door).
#
# af-1al0t1 (2026-09-30, C01 T21): a delivery worker posted a NEEDS BENJAMIN
# (a variant choice) through escalation-door, then ran `--outcome blocked
# --classification repair` as mol-do-work step 3b told it to. This door
# closed the ticket with gc.outcome=pass: its dependents (T22 among them)
# were released without the choice, and `escalation-door list` never showed
# the question. Two rules close that class:
#   * --outcome blocked parks the bead instead of closing it: status
#     blocked, gc.outcome=blocked, gc.work_outcome=blocked. Blocked work is
#     neither ready nor done, so its dependents stay gated. The linked-PR
#     check does not apply (parking claims nothing delivered).
#     `escalation-door repondre` reopens it once the operator answers.
#   * no form of this door closes a bead that still carries an active
#     gc.needs_benjamin (set and not "none"): the close would silently drop
#     the operator's question. Answer it (`escalation-door repondre`) or
#     clear it (`escalation-door clear`) first. Parking stays allowed.

set -Eeuo pipefail

PROGRAM_NAME="deliver-close"
GC_BIN="${GC_BIN:-gc}"
GH_BIN="${GH_BIN:-gh}"
ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
# shellcheck source=lib/project_registry.sh
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/lib/project_registry.sh"

log() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

die() {
  log "ERROR: $1"
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: deliver-close <bead-id> --repo <owner/repository> --pr <number> [--required-workflow <name>] [--reason <text>]
   or: deliver-close <bead-id> --outcome shipped --commit <sha> --branch <branch> [--verification <text>] [--reason <text>]
   or: deliver-close <bead-id> --outcome no-op [--reason <text>]
   or: deliver-close <bead-id> --outcome blocked|abandoned --classification repair|semantic|topology \
       [--planning-exception-id <decision-id>] [--reason <text>]

--repo/--pr form: verifies with GitHub that the pull request is merged and that
the required workflow succeeded on the exact PR head, then atomically records
the ADR-0016 fields plus merge_result/merged_sha/merged_target and gc.ci_* proof
before closing <bead-id>. Known Factory repositories infer their required
workflow; other repositories must pass --required-workflow.

--outcome form: writes the ADR-0009 work-record outcome (gc.outcome=pass,
gc.work_outcome=<outcome>, and for shipped gc.work_commit/gc.work_branch) and
closes the bead -- except --outcome blocked, which parks it instead (status
blocked, gc.outcome=blocked; dependents stay gated; escalation-door repondre
reopens it).

No form closes a bead whose gc.needs_benjamin is still active (set and not
"none"): answer or clear it through escalation-door first. If <bead-id> already carries its own gc.pr_url (a previous
attempt's PR), that PR is independently verified with `gh pr view` first and
the close is refused unless it is genuinely merged; a bead with no gc.pr_url
yet has nothing to verify. A bead explicitly governed by
gc.delivery_contract=pr-ci-merged-v1 (or an approved delivery graph) cannot use
--outcome shipped without a linked PR.

--classification (required for --outcome blocked|abandoned): repair writes
gc.blocked_classification and parks (blocked) or closes (abandoned). semantic/topology means the
delivery worker hit a question about approved intent, behavior, or topology
(ADR-0028) -- it must also pass --planning-exception-id naming the decision
id an already-run `bin/planning-exception raise` produced for this bead, or
the close is refused before any Beads write. A blocked/abandoned close with
no --classification at all is refused the same way.
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is unavailable: $1"
}

capture_json() {
  local destination=$1
  local source_name=$2
  local output
  shift 2

  if ! output=$("$@"); then
    die "$source_name source command failed."
  fi
  jq -e . >/dev/null 2>&1 <<<"$output" || die "$source_name returned invalid JSON."
  printf -v "$destination" '%s' "$output"
}

bead_object() {
  jq -c 'if type == "array" then .[0] else . end' <<<"$1"
}

metadata_value() {
  local bead_json=$1 key=$2
  bead_object "$bead_json" | jq -r --arg key "$key" '.metadata[$key] // empty'
}

required_workflow_for() {  # repo explicit-name
  local repo=$1 explicit=${2:-} ci
  if [[ -n $explicit ]]; then
    printf '%s\n' "$explicit"
    return
  fi
  if ci=$(project_registry_ci_for_repo "$ROOT/config/projects" "$repo"); then
    printf '%s\n' "$ci"
    return
  fi
  die "--required-workflow is required for $repo; refusing to guess which CI run gates delivery."
}

parse_pr_url() {  # url -> owner/repo<TAB>number
  local pr_url=$1
  if [[ $pr_url =~ ^https?://github\.com/([A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]{1,100})/pull/([1-9][0-9]*)/?$ ]]; then
    printf '%s\t%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}"
  else
    return 1
  fi
}

refuse_close_on_active_needs_benjamin() {  # bead-id bead-json
  local question
  question=$(bead_object "$2" | jq -r '.metadata["gc.needs_benjamin"] // "" | tostring')
  [[ -z $question || $question == none ]] \
    || die "$1 carries an active NEEDS BENJAMIN ($question); refusing to close it. Answer it with 'escalation-door repondre $1 <lettre>' or clear it with 'escalation-door clear $1' first; to wait for the answer use --outcome blocked, which parks the bead without closing it."
}

requires_pr_contract() {
  bead_object "$1" | jq -e '
    (.metadata["gc.delivery_contract"] // "") == "pr-ci-merged-v1"
    or (((.metadata["gc.plane"] // "") == "delivery")
        and ((.metadata["gc.graph_digest"] // "") | startswith("sha256:")))
    or any([
      .metadata["gc.github_repo"], .metadata["gc.pr_number"], .metadata.pr_number,
      .metadata.merge_result, .metadata.merged_sha, .metadata["gc.ci_run_id"]
    ][]; (. // "") | tostring | length > 0)
  ' >/dev/null
}

# Populates the PR_* and CI_* globals only after all authoritative evidence is
# coherent.  No Beads write occurs in this function.
verify_pr_delivery() {  # bead-id bead-json repo pr-number required-workflow
  local bead_id=$1 bead_json=$2 repo=$3 pr_number=$4 required_workflow=$5
  local actions_response ci_run linked_url linked_branch linked_base linked_via parsed

  require_command "$GH_BIN"
  capture_json PR_RESPONSE "GitHub PR $pr_number" "$GH_BIN" pr view "$pr_number" \
    --repo "$repo" --json number,state,mergedAt,mergeCommit,headRefOid,headRefName,baseRefName,url

  jq -e --argjson number "$pr_number" '
    .number == $number and
    .state == "MERGED" and
    (.mergedAt | type == "string" and length > 0) and
    (.headRefOid | type == "string" and test("^[0-9a-f]{40}$")) and
    (.headRefName | type == "string" and length > 0) and
    (.baseRefName | type == "string" and length > 0) and
    (.mergeCommit.oid | type == "string" and test("^[0-9a-f]{40}$")) and
    (.url | type == "string" and test("^https://github\\.com/"))
  ' >/dev/null <<<"$PR_RESPONSE" \
    || die "PR $pr_number in $repo is not verifiably merged; refusing to close $bead_id without proof."

  PR_HEAD=$(jq -r '.headRefOid' <<<"$PR_RESPONSE")
  PR_HEAD_BRANCH=$(jq -r '.headRefName' <<<"$PR_RESPONSE")
  MERGED_TARGET=$(jq -r '.baseRefName' <<<"$PR_RESPONSE")
  MERGE_COMMIT=$(jq -r '.mergeCommit.oid' <<<"$PR_RESPONSE")
  PR_URL=$(jq -r '.url' <<<"$PR_RESPONSE")

  linked_url=$(metadata_value "$bead_json" "gc.pr_url")
  linked_branch=$(metadata_value "$bead_json" "gc.work_branch")
  linked_base=$(metadata_value "$bead_json" "gc.work_base_branch")
  if [[ -n $linked_url ]]; then
    parsed=$(parse_pr_url "$linked_url") \
      || die "$bead_id carries gc.pr_url=$linked_url that is not a recognizable GitHub PR URL; refusing to close without verifiable proof."
    [[ ${parsed%$'\t'*} == "$repo" && ${parsed#*$'\t'} == "$pr_number" ]] \
      || die "$bead_id links $linked_url, not $repo#$pr_number; refusing mismatched delivery evidence."
  fi
  # P07 (mol-do-work step 3c): a bead fixed inside another ticket's PR names
  # that PR with gc.delivered_via_pr. Its own gc.work_branch, stamped at
  # dispatch on every routed bead, is by definition not that PR's head: the
  # PR number is the link there, the branch is not evidence.
  linked_via=$(metadata_value "$bead_json" "gc.delivered_via_pr")
  [[ -z $linked_branch || $linked_branch == "$PR_HEAD_BRANCH" || $linked_via == "$pr_number" ]] \
    || die "$bead_id records gc.work_branch=$linked_branch but PR $pr_number head is $PR_HEAD_BRANCH."
  [[ -z $linked_base || $linked_base == "$MERGED_TARGET" ]] \
    || die "$bead_id records gc.work_base_branch=$linked_base but PR $pr_number target is $MERGED_TARGET."

  capture_json actions_response "GitHub Actions for PR head $PR_HEAD" "$GH_BIN" api \
    "repos/$repo/actions/runs?head_sha=$PR_HEAD&per_page=100"
  ci_run=$(jq -c --arg workflow "$required_workflow" --arg head "$PR_HEAD" '
    [.workflow_runs[]?
      | select((.name // "") == $workflow)
      | select((.head_sha // "") == $head)
      | select((.event // "") == "pull_request")][0] // empty
  ' <<<"$actions_response")
  [[ -n $ci_run ]] \
    || die "Required workflow '$required_workflow' has no pull_request run on exact PR head $PR_HEAD."
  jq -e --arg head "$PR_HEAD" '
    (.id | (type == "number" and . > 0)) and
    .head_sha == $head and .event == "pull_request" and
    .status == "completed" and .conclusion == "success"
  ' >/dev/null <<<"$ci_run" \
    || die "Required workflow '$required_workflow' is not successful on exact PR head $PR_HEAD."
  CI_RUN_ID=$(jq -r '.id' <<<"$ci_run")
  REQUIRED_WORKFLOW=$required_workflow
}

close_verified_pr() {  # bead-id repo pr reason verification
  local bead_id=$1 repo=$2 pr_number=$3 reason=$4 verification=$5
  local -a args=("$GC_BIN" bd update "$bead_id"
    --set-metadata "gc.outcome=pass"
    --set-metadata "gc.delivery_contract=pr-ci-merged-v1"
    --set-metadata "gc.delivery_status=merged"
    --set-metadata "gc.work_outcome=shipped"
    --set-metadata "gc.github_repo=$repo"
    --set-metadata "gc.pr_number=$pr_number"
    --set-metadata "gc.pr_head=$PR_HEAD"
    --set-metadata "gc.merge_commit=$MERGE_COMMIT"
    --set-metadata "gc.pr_url=$PR_URL"
    --set-metadata "gc.work_commit=$PR_HEAD"
    --set-metadata "gc.work_branch=$PR_HEAD_BRANCH"
    --set-metadata "pr_number=$pr_number"
    --set-metadata "merge_result=merged"
    --set-metadata "merged_sha=$MERGE_COMMIT"
    --set-metadata "merged_target=$MERGED_TARGET"
    --set-metadata "gc.required_ci_workflow=$REQUIRED_WORKFLOW"
    --set-metadata "gc.ci_run_id=$CI_RUN_ID"
    --set-metadata "gc.ci_head_sha=$PR_HEAD"
    --set-metadata "gc.ci_conclusion=success")
  [[ -z $verification ]] || args+=(--set-metadata "gc.work_verification=$verification")
  args+=(--status=closed --notes "$reason")
  "${args[@]}" || die "Beads update failed for $bead_id after delivery verification succeeded."
  log "Closed $bead_id after verified merge and '$REQUIRED_WORKFLOW' success on $PR_HEAD ($repo#$pr_number, $MERGE_COMMIT)."
}

close_by_outcome() {
  local bead_id=$1 outcome=$2 commit=$3 branch=$4 verification=$5 reason=$6 \
    classification=$7 planning_exception_id=$8
  # af-1al0t1: blocked parks, it never records a success nor closes.
  local gc_outcome=pass final_status=closed
  if [[ $outcome == blocked ]]; then
    gc_outcome=blocked
    final_status=blocked
  fi
  local -a args=("$GC_BIN" bd update "$bead_id" --set-metadata "gc.outcome=$gc_outcome" \
    --set-metadata "gc.work_outcome=$outcome")
  if [[ $outcome == shipped ]]; then
    [[ -n $commit && -n $branch ]] \
      || die "--outcome shipped requires --commit <sha> and --branch <branch>."
    [[ -z $classification && -z $planning_exception_id ]] \
      || die "--classification/--planning-exception-id only apply to --outcome blocked|abandoned."
    args+=(--set-metadata "gc.work_commit=$commit" --set-metadata "gc.work_branch=$branch")
  elif [[ $outcome == blocked || $outcome == abandoned ]]; then
    [[ -z $commit && -z $branch ]] \
      || die "--commit/--branch only apply to --outcome shipped."
    if [[ -z $classification ]]; then
      [[ -z $planning_exception_id ]] \
        || die "--planning-exception-id requires --classification semantic|topology."
      die "--outcome blocked|abandoned requires --classification repair|semantic|topology (run bin/planning-exception classify first)."
    fi
    case "$classification" in
      repair|semantic|topology) ;;
      *) die "--classification must be one of repair, semantic, topology." ;;
    esac
    if [[ $classification == semantic || $classification == topology ]]; then
      [[ -n $planning_exception_id ]] \
        || die "--classification $classification requires --planning-exception-id <decision-id> (run bin/planning-exception raise first)."
    fi
    args+=(--set-metadata "gc.blocked_classification=$classification")
  else
    [[ -z $commit && -z $branch ]] \
      || die "--commit/--branch only apply to --outcome shipped."
    [[ -z $classification && -z $planning_exception_id ]] \
      || die "--classification/--planning-exception-id only apply to --outcome blocked|abandoned."
  fi
  [[ -z $verification ]] || args+=(--set-metadata "gc.work_verification=$verification")
  [[ -z $planning_exception_id ]] || args+=(--set-metadata "gc.planning_exception_id=$planning_exception_id")
  args+=(--status="$final_status" --notes "$reason")
  "${args[@]}" || die "Beads update failed for $bead_id."
  if [[ $final_status == blocked ]]; then
    log "Parked $bead_id (status blocked, gc.work_outcome=blocked); dependents stay gated until it is answered and reopened."
  else
    log "Closed $bead_id with gc.work_outcome=$outcome."
  fi
}

main() {
  local bead_id="" repo="" pr_number="" outcome="" commit="" branch="" verification="" \
    required_workflow="" reason="Delivery verified and closed" classification="" \
    planning_exception_id=""

  bead_id=${1:-}
  [[ -n $bead_id && $bead_id != -* ]] || { usage >&2; return 2; }
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        repo=$2
        shift 2
        ;;
      --pr)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        pr_number=$2
        shift 2
        ;;
      --outcome)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        outcome=$2
        shift 2
        ;;
      --classification)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        classification=$2
        shift 2
        ;;
      --planning-exception-id)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        planning_exception_id=$2
        shift 2
        ;;
      --required-workflow)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        required_workflow=$2
        shift 2
        ;;
      --commit)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        commit=$2
        shift 2
        ;;
      --branch)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        branch=$2
        shift 2
        ;;
      --verification)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        verification=$2
        shift 2
        ;;
      --reason)
        [[ $# -ge 2 ]] || { usage >&2; return 2; }
        reason=$2
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        usage >&2
        return 2
        ;;
    esac
  done

  require_command "$GC_BIN"
  require_command jq

  local bead_json
  capture_json bead_json "Bead lookup for $bead_id" "$GC_BIN" bd show "$bead_id" --json
  bead_object "$bead_json" | jq -e --arg id "$bead_id" '.id == $id' >/dev/null \
    || die "Bead lookup for $bead_id did not return that exact bead."

  if [[ -z $outcome ]]; then
    [[ -z $classification && -z $planning_exception_id ]] \
      || die "--classification/--planning-exception-id require --outcome blocked|abandoned."
  fi

  if [[ -n $outcome ]]; then
    [[ -z $repo && -z $pr_number ]] || die "--outcome cannot be combined with --repo/--pr."
    case "$outcome" in
      shipped|no-op|blocked|abandoned) ;;
      *) die "--outcome must be one of shipped, no-op, blocked, abandoned." ;;
    esac
    if [[ $outcome != blocked && $outcome != abandoned ]]; then
      [[ -z $classification && -z $planning_exception_id ]] \
        || die "--classification/--planning-exception-id only apply to --outcome blocked|abandoned."
    fi
    [[ $outcome == blocked ]] || refuse_close_on_active_needs_benjamin "$bead_id" "$bead_json"
    local linked_url linked_pair linked_repo linked_number resolved_workflow
    linked_url=$(metadata_value "$bead_json" "gc.pr_url")
    # Parking (blocked) claims nothing delivered: no linked-PR proof needed.
    if [[ $outcome == blocked ]]; then
      linked_url=""
    fi
    if [[ -n $linked_url ]]; then
      linked_pair=$(parse_pr_url "$linked_url") \
        || die "$bead_id carries gc.pr_url=$linked_url that is not a recognizable GitHub PR URL; refusing to close without verifiable proof."
      linked_repo=${linked_pair%$'\t'*}
      linked_number=${linked_pair#*$'\t'}
      resolved_workflow=$(required_workflow_for "$linked_repo" "$required_workflow")
      verify_pr_delivery "$bead_id" "$bead_json" "$linked_repo" "$linked_number" "$resolved_workflow"
      if [[ $outcome == shipped ]]; then
        [[ -n $commit && -n $branch ]] \
          || die "--outcome shipped requires --commit <sha> and --branch <branch>."
        [[ $branch == "$PR_HEAD_BRANCH" ]] \
          || die "--branch $branch does not match linked PR head $PR_HEAD_BRANCH."
        [[ $reason == "Delivery verified and closed" ]] && reason="Delivery verified and closed"
        close_verified_pr "$bead_id" "$linked_repo" "$linked_number" "$reason" "$verification"
        return 0
      fi
    elif [[ $outcome == shipped ]] && requires_pr_contract "$bead_json"; then
      die "$bead_id requires PR+CI delivery proof; --outcome shipped cannot close it before a PR is linked and merged."
    fi
    [[ $reason == "Delivery verified and closed" ]] && reason="Closed with gc.work_outcome=$outcome"
    close_by_outcome "$bead_id" "$outcome" "$commit" "$branch" "$verification" "$reason" \
      "$classification" "$planning_exception_id"
    return 0
  fi

  require_command "$GH_BIN"
  refuse_close_on_active_needs_benjamin "$bead_id" "$bead_json"

  [[ -n $repo ]] || die "--repo owner/repository is required; refusing to close $bead_id without it."
  [[ $repo =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]{1,100}$ ]] \
    || die "--repo must be a valid owner/repository name."
  [[ $pr_number =~ ^[1-9][0-9]*$ ]] \
    || die "--pr must be a positive pull request number; refusing to close $bead_id without it."

  required_workflow=$(required_workflow_for "$repo" "$required_workflow")
  verify_pr_delivery "$bead_id" "$bead_json" "$repo" "$pr_number" "$required_workflow"
  close_verified_pr "$bead_id" "$repo" "$pr_number" "$reason" "$verification"
}

if [[ ${DELIVER_CLOSE_SOURCE_ONLY:-0} != 1 ]]; then
  main "$@"
fi
