#!/usr/bin/env python3
"""The Evidence Pack of a "new flow" convoy, generated by code (T27,
af-r43we4; Spec af-wf4w5r §10, §9 point 6, user stories 19 and 62).

One static page, tied to one commit of the integration branch, assembled
from what is recorded and from nothing else: the state of the convoy as
bin/convoy-state renders it, the verdict of each condition of the end of
the Spec as bin/spec-end reads it, the Spec of the convoy, and the pieces of
the evidence store, each verified by bin/evidence-capture before it is
shown. No agent writes a word of it, and the command takes no text from its
caller: every sentence is a fixed line of this file or of
config/evidence-pack.json, every value a recorded one. Two generations on
the same state write the same bytes.

    evidence-pack generate CONVOY --repo DIR
    evidence-pack check    CONVOY --repo DIR

`generate` writes the page and the pieces it shows under
<EVIDENCE_PACK_DIR>/<spec>/<convoy>/<commit>/ (default
~/.local/state/agent-factory-evidence-packs), each piece under the name of
its fingerprint, and records the pack on the convoy (bin/convoy-state
record-evidence-pack): its commit, the fingerprint of the page, its folder.
The rubrics are those of the Spec §10, 1 to 9, in order. A condition of the
end of the Spec that is not met does not refuse the page: its header says
« non conforme » and gives the verdict of each condition. The rubric « Ce
qui n'a PAS été vérifié » is always there; when it cannot be filled the
generation is refused and nothing is written.

`check` reads and writes nothing. The pack holds while its commit is the tip
of the integration branch, its page and pieces are the bytes that were
written, what the recorded state gives now is still that page, and no piece
it shows was refused by the evidence store. Otherwise it is « absent »,
« périmé », « altéré » or « incomplet », and the reason is said. It is what
bin/spec-end reads as its last condition.

Every answer is one JSON object on stdout. Exit status: 0 done, or the pack
holds; 1 refused, or the pack does not hold; 3 the convoy is in an "état sans
règle"; 4 the convoy does not carry the new-flow mark. Details:
docs/EVIDENCE_PACK.md.
"""

from __future__ import annotations

import argparse
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path
from typing import Any, Iterable


PROGRAM = "evidence-pack"
BIN = Path(__file__).resolve().parent
STATE_TOOL = BIN / "convoy-state"
GATE_TOOL = BIN / "spec-end"
CAPTURE_TOOL = BIN / "evidence-capture"
SPEC_READER = BIN / "spec-approve"
GC_BIN = os.environ.get("GC_BIN") or "gc"
SETTINGS_NAME = Path("config") / "evidence-pack.json"

VERSION = "evidence-pack/v1"
EXIT_REFUSED = 1
EXIT_UNRULED = 3
EXIT_NOT_NEW_FLOW = 4

PAGE = "index.html"
PIECES = "pieces"
ASSET_RE = re.compile(r'(?:src|href)="(pieces/([0-9a-f]{64})\.(?:json|png))"')
COMPARISON_RE = re.compile(r"^fidelity\.[A-Za-z0-9_]+\.[A-Za-z0-9_]+$")
MAX_OUTPUT = 2000
NOT_VERIFIED = "Ce qui n'a PAS été vérifié"
RUBRICS = (
    "En-tête", "Ce qui demande les yeux de Benjamin", NOT_VERIFIED, "Par user story", "Par ticket",
    "Éléments suivis", "Hors graphe initial", "Relevés", "Preuves TDD et constats de revue")

HELD, ABSENT, OUTDATED, ALTERED, INCOMPLETE = "à jour", "absent", "périmé", "altéré", "incomplet"

VERDICTS = {"pass": "réunie", "fail": "non réunie", "not_run": "non lancée", "stale": "périmée"}
STATES = {"observed": "observé", "not_observed": "non observé", "unobservable": "inobservable"}
CAUSES = {"criterion": "par le critère", "environment": "par l'environnement"}
KINDS = {"vertical_slice": "tranche verticale", "prefactoring": "prefactoring", "repair": "repair"}
EXITS = {"finished": "terminé", "planning_exception": "Planning Exception", "operator_request": "demande opérateur",
         "technically_blocked": "bloqué technique", "interrupted": "interrompu"}
FAVOR = {"favorable": "favorable", "unfavorable": "défavorable", "incomplete": "incomplète", None: "sans verdict"}
OUTCOMES = {"favorable": "favorable", "return_to_author": "retour à l'auteur", "planning_exception": "Planning Exception",
            "environment_outage": "panne d'environnement", "repair": "repair à livrer"}
SECTIONS = {"deviations": "écart", "not_done": "« non fait »"}
TDD_STEPS = (("red", "rouge"), ("freeze", "gel"), ("green", "vert"), ("amendment", "amendement"),
             ("prefactoring", "régression du prefactoring"))
ROLES = (("author", "auteur"), ("reviewer", "relecteur"), ("evaluator", "Evaluator"))
PARK_CAUSES = {"planning_exception": "Planning Exception", "operator_request": "demande opérateur",
               "resumes_exhausted": "reprises épuisées"}
RESUME_CAUSES = {"interrupted": "session interrompue", "returned": "retour de la fusion", "unblocked": "bloqueur levé",
                 "answered": "réponse de l'opérateur"}
NONE = "aucun"


# Why the repair rounds of the end of a Spec are stopped (T26), as the page says it.
END_STOPS = {
    "end_rounds_exhausted": "tours de réparation épuisés",
    "stories_not_reduced": "un tour n'a pas réduit les user stories non observées",
    "story_refused_twice": "la même user story refusée deux fois",
}


class Refusal(RuntimeError):
    def __init__(self, message: str):
        super().__init__(" ".join(message.split()))


class PassedOn(RuntimeError):
    """The answer of another command, to give as it is: a convoy without the
    mark, or one in an "état sans règle"."""

    def __init__(self, status: int, answer: dict[str, Any]):
        super().__init__(str(answer.get("message", "")))
        self.status, self.answer = status, answer


# --- the other commands ----------------------------------------------------------


def run(argv: list[str], stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(argv, capture_output=True, text=True, errors="replace", input=stdin,
                              stdin=subprocess.DEVNULL if stdin is None else None)
    except OSError as exc:
        raise Refusal(f"impossible de lancer {Path(argv[0]).name} : {exc}") from exc


def tool(path: Path, *args: str) -> tuple[int, dict[str, Any]]:
    """One JSON answer of another command of the flow."""
    proc = run([str(path), *args])
    try:
        answer = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        detail = " ".join((proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}").split())[:300]
        raise Refusal(f"{path.name} {args[0]} a rendu une réponse illisible : {detail}") from exc
    if not isinstance(answer, dict):
        raise Refusal(f"{path.name} {args[0]} a rendu une réponse illisible : {answer!r}")
    return proc.returncode, answer


def refusal_text(answer: dict[str, Any]) -> str:
    text = str(answer.get("error") or answer.get("message") or answer)
    return text[len("refus : "):] if text.startswith("refus : ") else text


def digest_of(data: bytes) -> str:
    return "sha256:" + hashlib.sha256(data).hexdigest()


def sha(commit: Any) -> str:
    return str(commit)[:12]


# --- what is read --------------------------------------------------------------------


def require_repo(path: str | None) -> Path:
    if not path:
        raise Refusal("--repo absent : le dépôt du projet porte la branche d'intégration à laquelle le dossier est lié")
    return Path(path).resolve()


def read_gate(convoy_id: str, repo: Path) -> dict[str, Any]:
    """The verdict of each condition of the end of the Spec before the pack,
    on the tip of the integration branch as it is now (bin/spec-end check)."""
    status, answer = tool(GATE_TOOL, "check", convoy_id, "--repo", str(repo), "--before-pack")
    if status in (EXIT_NOT_NEW_FLOW, EXIT_UNRULED):
        raise PassedOn(status, answer)
    if not isinstance(answer.get("conditions"), list) or not isinstance(answer.get("commit"), str):
        raise Refusal(f"lecture des conditions de fin de Spec impossible : {refusal_text(answer)}")
    return answer


def read_state(convoy_id: str, repo: Path) -> dict[str, Any]:
    status, answer = tool(STATE_TOOL, "show", convoy_id, "--repo", str(repo))
    if status in (EXIT_NOT_NEW_FLOW, EXIT_UNRULED):
        raise PassedOn(status, answer)
    if status != 0 or not isinstance(answer.get("tickets"), list):
        raise Refusal(f"lecture de l'état du convoi {convoy_id} impossible : {refusal_text(answer)}")
    return answer


def read_spec(spec_id: Any) -> dict[str, Any]:
    """The Spec of the convoy: its text as the tracker holds it, and what
    the reader of bin/spec-approve finds in it."""
    if not isinstance(spec_id, str) or not spec_id:
        raise Refusal("le convoi ne nomme pas sa Spec : l'en-tête du dossier ne peut pas la porter")
    proc = run([GC_BIN, "bd", "show", spec_id, "--json"])
    try:
        bead = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise Refusal(f"gc bd show {spec_id} a rendu un JSON illisible") from exc
    bead = bead[0] if isinstance(bead, list) and bead else bead
    text = bead.get("description") if isinstance(bead, dict) else None
    if proc.returncode != 0 or not isinstance(text, str) or not text.strip():
        raise Refusal(f"la Spec {spec_id} est introuvable ou vide")
    proc = run([str(SPEC_READER), "outline"], stdin=text)
    try:
        outline = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise Refusal(f"lecture de la Spec {spec_id} impossible (spec-approve outline)") from exc
    if proc.returncode != 0 or not isinstance(outline, dict) or not outline.get("ok"):
        raise Refusal(f"la Spec {spec_id} n'a pas de user stories numérotées lisibles : "
                      f"{refusal_text(outline) if isinstance(outline, dict) else proc.stderr.strip()}")
    return {"id": spec_id, "title": bead.get("title"), "digest": digest_of(text.encode("utf-8")),
            "stories": [{"number": int(story["number"]), "text": " ".join(str(story["text"]).split())}
                        for story in outline["user_stories"]],
            "prototype": outline.get("validated_prototype"), "prototype_problem": outline.get("validated_prototype_problem"),
            "screens": outline.get("screens") or []}


def read_settings() -> dict[str, Any]:
    """The fixed lines of « Ce qui n'a PAS été vérifié »: the file of the
    Factory root in use, else the Factory's own. A list that is absent or
    empty refuses the generation: the rubric is mandatory."""
    roots = dict.fromkeys((Path(os.environ.get("FACTORY_ROOT") or BIN.parent), BIN.parent))
    path = next((root / SETTINGS_NAME for root in roots if (root / SETTINGS_NAME).is_file()), None)
    cannot = f"rubrique « {NOT_VERIFIED} » impossible à remplir : "
    if path is None:
        raise Refusal(cannot + f"{SETTINGS_NAME} est absent")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise Refusal(cannot + f"{path} (config/evidence-pack.json) est illisible : {exc}") from exc
    baseline = data.get("baseline_without_mechanism") if isinstance(data, dict) else None
    if not isinstance(baseline, list) or not baseline or any(
            not isinstance(entry, dict) or set(entry) != {"criterion", "detail"}
            or any(not isinstance(value, str) or not value.strip() for value in entry.values()) for entry in baseline):
        raise Refusal(cannot + f"baseline_without_mechanism absent, vide ou mal formé dans {path} (attendu : une liste "
                      "non vide de {criterion, detail}) : les critères du socle sans mécanisme ne peuvent pas être listés")
    limits = data.get("known_limits")
    if not isinstance(limits, list) or not limits or any(not isinstance(line, str) or not line.strip() for line in limits):
        raise Refusal(cannot + f"known_limits absent, vide ou mal formé dans {path} (attendu : une liste non vide de "
                      "lignes) : les limites connues des contrôles ne peuvent pas être listées")
    return {"baseline": baseline, "limits": limits}


class Pieces:
    """The pieces of the evidence store the tracker names, each verified by
    bin/evidence-capture before the page shows it. A piece the store refuses
    is said, with the reason of the tool, and its content is left out."""

    def __init__(self, convoy_id: str, state: dict[str, Any]):
        self.convoy = convoy_id
        self.records: dict[tuple[str, str], dict[str, Any]] = {}
        self.refused: dict[tuple[str, str], str] = {}
        self.assets: dict[str, Path] = {}
        owners = [(convoy_id, state["convoy"].get("evidence") or {})]
        owners += [(ticket["id"], ticket.get("evidence") or {}) for ticket in state["tickets"]]
        for owner, named in owners:
            if isinstance(named, dict) and named:
                self.load(owner, sorted(named))

    def load(self, owner: str, names: list[str]) -> None:
        status, answer = tool(CAPTURE_TOOL, "verify", self.convoy, owner)
        if status == 0 and isinstance(answer.get("pieces"), list):
            entries = {entry["piece"]: entry for entry in answer["pieces"]}
        else:
            # One piece at least is refused: each is asked on its own.
            entries = {}
            for name in names:
                status, answer = tool(CAPTURE_TOOL, "verify", self.convoy, owner, "--piece", name)
                if status == 0 and isinstance(answer.get("pieces"), list) and answer["pieces"]:
                    entries[name] = answer["pieces"][0]
                else:
                    self.refused[(owner, name)] = refusal_text(answer)
        for name in names:
            entry = entries.get(name)
            if entry is None:
                self.refused.setdefault((owner, name), f"pièce {name} : absente du magasin de preuves")
                continue
            try:
                record = json.loads(Path(entry["path"]).read_text(encoding="utf-8"))
            except (OSError, ValueError, KeyError) as exc:
                self.refused[(owner, name)] = f"pièce {name} : illisible dans le magasin de preuves ({exc})"
                continue
            self.records[(owner, name)] = {"entry": entry, "record": record}

    def asset(self, source: str, digest: str, suffix: str) -> str:
        name = f"{PIECES}/{digest.removeprefix('sha256:')}{suffix}"
        self.assets[name] = Path(source)
        return name

    def inadmissible(self) -> list[dict[str, str]]:
        return [{"piece": f"{owner}/{name}", "reason": reason} for (owner, name), reason in sorted(self.refused.items())]

    def comparisons(self, state: dict[str, Any]) -> list[tuple[str, str]]:
        """The comparison pieces to show: per prototyped state and
        rendering, the one of the interface ticket merged last; then those
        captured on the assembled product."""
        chosen: dict[str, tuple[tuple[str, str], str]] = {}
        for ticket in state["tickets"]:
            if withdrawn(ticket):
                continue
            order = (str((ticket.get("merge") or {}).get("at") or ""), ticket["id"])
            for (owner, name), held in self.records.items():
                if owner == ticket["id"] and held["record"].get("kind") == "comparison" and COMPARISON_RE.match(name):
                    if name not in chosen or chosen[name][0] < order:
                        chosen[name] = (order, owner)
        found = [(owner, name) for name, (_, owner) in sorted(chosen.items())]
        found += sorted(key for key, held in self.records.items()
                        if key[0] == self.convoy and held["record"].get("kind") == "comparison")
        return found


# --- the page: fixed lines and recorded values -----------------------------------------


def e(value: Any) -> str:
    return html.escape(str(value), quote=True)


def items(lines: Iterable[str], empty: str = NONE) -> str:
    lines = list(lines)
    return "<ul>\n" + "\n".join(lines) + "\n</ul>" if lines else f"<p>{e(empty)}</p>"


def li(text: str, **data: Any) -> str:
    attributes = "".join(f' data-{name.replace("_", "-")}="{e(value)}"' for name, value in data.items())
    return f"<li{attributes}>{text}</li>"


def pairs(rows: Iterable[tuple[str, Any]]) -> str:
    rows = [(label, value) for label, value in rows if value is not None]
    return "<dl>\n" + "\n".join(f"<dt>{e(label)}</dt><dd>{value}</dd>" for label, value in rows) + "\n</dl>"


def withdrawn(ticket: dict[str, Any]) -> bool:
    return "at" in (ticket.get("gates") or {}).get("withdrawn", {})


def closed_by_gate(ticket: dict[str, Any]) -> bool:
    return ticket.get("status") == "closed" and "at" in (ticket.get("gates") or {}).get("ticket_end", {})


def status_of(ticket: dict[str, Any]) -> str:
    if withdrawn(ticket):
        return "retiré du graphe par une Planning Exception résolue"
    if closed_by_gate(ticket):
        return "fermé par la porte de fin de ticket"
    if ticket.get("status") == "closed":
        return "fermé hors porte"
    if ticket.get("park"):
        return "parqué"
    if ticket.get("stop"):
        return "arrêté"
    return {"open": "ouvert", "in_progress": "en cours"}.get(str(ticket.get("status")), str(ticket.get("status")))


def last_round(record: Any, kind: str | None = None) -> dict[str, Any] | None:
    rounds = (record or {}).get("rounds") if isinstance(record, dict) else None
    rounds = [entry for entry in rounds or [] if kind is None or entry.get("kind") == kind]
    return rounds[-1] if rounds else None


class Page:
    def __init__(self, convoy_id: str, gate: dict[str, Any], state: dict[str, Any], spec: dict[str, Any],
                 settings: dict[str, Any], pieces: Pieces):
        self.id, self.gate, self.state, self.spec, self.settings, self.pieces = convoy_id, gate, state, spec, settings, pieces
        self.convoy = state["convoy"]
        self.tickets = state["tickets"]
        self.commit = gate["commit"]
        self.conditions = gate["conditions"]
        self.conforming = all(entry["verdict"] == "pass" for entry in self.conditions)
        self.outcome = last_round(self.convoy.get("outcome_evaluation"))
        self.end_review = self.convoy.get("end_review") or {}
        self.elsewhere: list[str] = []

    # --- a piece -----------------------------------------------------------------

    def piece(self, owner: str, name: Any) -> str:
        """One piece, as the evidence store holds it: what was run or
        captured, the commit, the time, and the sealed record beside the
        page. Nothing of a piece the store refuses is shown."""
        if not isinstance(name, str) or not name:
            return "<p>aucune pièce jointe</p>"
        key = f"{owner}/{name}"
        if (owner, name) in self.pieces.refused:
            return (f'<p class="irrecevable" data-inadmissible="{e(key)}">Pièce {e(name)} irrecevable : '
                    f"{e(self.pieces.refused[(owner, name)])}</p>")
        held = self.pieces.records.get((owner, name))
        if held is None:
            return f'<p class="irrecevable">Pièce {e(name)} : aucune empreinte dans le tracker.</p>'
        record, entry = held["record"], held["entry"]
        link = self.pieces.asset(entry["path"], entry["digest"], ".json")
        head = (f"pièce {e(name)} — commit {e(record.get('commit'))} — {e(record.get('at'))} — "
                f'<a href="{link}">enregistrement scellé</a>')
        if record.get("kind") == "comparison":
            return self.comparison(owner, name)
        if record.get("kind") == "screenshot":
            image = self.pieces.asset(entry["image"], record["image_digest"], ".png")
            return (f'<details class="piece" data-piece="{e(key)}"><summary>{head} — capture de {e(record.get("address"))} '
                    f'(HTTP {e(record.get("http_status"))})</summary><img src="{image}" alt="capture {e(name)}"></details>')
        output = str(record.get("output") or "")
        shown = output[:MAX_OUTPUT]
        cut = (f"<p>Sortie tronquée à l'affichage : {e(record.get('output_bytes'))} octet(s) au total ; "
               "l'enregistrement scellé la porte.</p>") if len(output) > MAX_OUTPUT else ""
        command = " ".join(str(part) for part in record.get("command") or [])
        address = f" — produit lancé à {e(record['address'])}" if record.get("address") else ""
        return (f'<details class="piece" data-piece="{e(key)}"><summary>{head} — code de sortie '
                f'{e(record.get("exit_code"))}{address}</summary><p>Commande : <code>{e(command)}</code></p>'
                f"<pre>{e(shown)}</pre>{cut}</details>")

    def comparison(self, owner: str, name: str) -> str:
        """The two captures side by side and the image of their difference."""
        held = self.pieces.records[(owner, name)]
        record, entry = held["record"], held["entry"]
        both = self.pieces.asset(entry["image"], record["image_digest"], ".png")
        difference = self.pieces.asset(entry["difference"], record["difference_digest"], ".png")
        link = self.pieces.asset(entry["path"], entry["digest"], ".json")
        apart = ""
        if record.get("commit") != self.commit:
            apart = f" Capture prise au commit du ticket, non au commit du dossier ({e(sha(self.commit))})."
            self.elsewhere.append(f"{owner}/{name}")
        return (
            f'<figure data-comparison="{e(name)}" data-owner="{e(owner)}"><figcaption>{e(name)} ({e(owner)}) — commit '
            f'{e(record.get("commit"))} — {e(record.get("at"))} — fenêtre {e(record.get("window_size"))}, thème '
            f'{e(record.get("color_scheme"))} — {e(record.get("differing_pixels"))} pixel(s) différent(s) sur '
            f'{e(record.get("pixels"))}, sans seuil — référence {e(record.get("reference"))}, produit '
            f'{e(record.get("address"))} — <a href="{link}">enregistrement scellé</a>.{apart}</figcaption>'
            f'<p>Référence à gauche, produit livré à droite :</p><img src="{both}" alt="captures côte à côte {e(name)}">'
            f'<p>Image de différence :</p><img src="{difference}" alt="image de différence {e(name)}"></figure>')

    # --- 1. the header -------------------------------------------------------------

    def header(self) -> str:
        integration = self.convoy.get("integration") or {}
        protected = self.gate.get("protected") or {}
        red = [str(entry["number"]) for entry in self.conditions if entry["verdict"] != "pass"]
        if self.conforming:
            verdict = (f'<p class="verdict conforme">Les {len(self.conditions)} conditions de fin de Spec qui précèdent '
                       f"ce dossier sont réunies au commit {e(self.commit)}.</p>")
        else:
            verdict = (f'<p class="verdict non-conforme">Dossier non conforme : condition(s) de fin de Spec non '
                       f"réunie(s) au commit {e(self.commit)} : {e(', '.join(red))}.</p>")
        published = self.convoy.get("spec_digest")
        same = None if published is None else (
            "identique au texte lu" if published == self.spec["digest"] else
            f"différent du texte lu aujourd'hui ({e(self.spec['digest'])})")
        launched = "Aucun produit n'est lancé par ce dossier : du code le lance à ce commit à l'ouverture de l'Acceptance Session."
        if self.outcome and self.outcome.get("commit") == self.commit and self.outcome.get("environment"):
            launched += " Adresses du produit lancé pour l'Outcome Evaluation, arrêté depuis : " + ", ".join(
                f"{product.get('address')} (jeu de données {product.get('dataset')})"
                for product in self.outcome["environment"]) + "."
        rows = [
            ("Spec", f"{e(self.spec['id'])} — {e(self.spec.get('title') or '')}"),
            ("Digest de la Spec", e(self.spec["digest"])),
            ("Digest de la Spec à la publication du convoi", f"{e(published)} — {same}" if published else "non relevé sur le convoi"),
            ("Convoi", f"{e(self.id)} — {e(self.convoy.get('title') or '')}"),
            ("Branche d'intégration", e(self.gate.get("branch") or integration.get("branch"))),
            ("Commit du dossier", e(self.commit)),
            ("Branche protégée", f"{e(protected.get('branch'))} à {e(protected.get('commit'))}"),
            ("Liste des conditions", e(self.gate.get("version"))),
            ("Produit lancé", e(launched)),
        ]
        table = "\n".join(
            f'<tr data-condition="{entry["number"]}" data-verdict="{e(entry["verdict"])}"><td>{entry["number"]}</td>'
            f'<td>{e(entry["label"])}</td><td>{e(VERDICTS.get(entry["verdict"], entry["verdict"]))}</td>'
            f'<td>{e(entry["detail"])}</td></tr>' for entry in self.conditions)
        return (f"{verdict}\n{pairs(rows)}\n<table>\n<tr><th>#</th><th>Condition de fin de Spec</th><th>Verdict</th>"
                f"<th>Ce qui a été lu</th></tr>\n{table}\n</table>")

    # --- 2. what asks for the eyes of Benjamin ---------------------------------------

    def findings(self) -> list[dict[str, Any]]:
        return [finding for ticket in self.tickets for finding in ticket.get("findings") or []]

    def free_section(self, name: str) -> str:
        if self.outcome is None:
            return "<p>Aucune Outcome Evaluation n'est rendue.</p>"
        value = self.outcome.get(name)
        if not isinstance(value, list):
            return f"<p>{e(value if isinstance(value, str) else NONE)}</p>"
        return items(li(e(entry.get("text")) + (self.piece(self.id, entry["evidence"]) if entry.get("evidence") else ""))
                     for entry in value)

    def measured_deviations(self) -> list[str]:
        lines = []
        record = ((self.convoy.get("spec_end") or {}).get("records") or {}).get("fidelity") or {}
        sources = [(f"fin de Spec, commit {record.get('commit')}", deviation)
                   for entry in record.get("prototypes") or [] for deviation in entry.get("deviations") or []]
        for ticket in self.tickets:
            fidelity = ticket.get("fidelity") or {}
            sources += [(f"ticket {ticket['id']}, commit {fidelity.get('commit')}", deviation)
                        for deviation in fidelity.get("deviations") or []]
        for where, deviation in sources:
            lines.append(li(
                f"{e(where)} : état {e(deviation.get('state'))}, rendu {e(deviation.get('viewport') or '—')}, ancre "
                f"{e(deviation.get('anchor') or '—')}, {e(deviation.get('kind'))} sur {e(deviation.get('property'))} — "
                f"{e(deviation.get('status'))}"))
        return lines

    def mentions(self) -> tuple[list[str], list[str]]:
        """« Même fournisseur ou même modèle que l'auteur », and apart what
        nobody recorded: an independence that is not established is said."""
        same, unknown = [], []

        def model(value: Any, what: str, name: str, **where: str) -> None:
            if value is True:
                same.append(li(f"{e(what)} : relecteur sur le même modèle que l'auteur ({e(name)}).",
                               mention="same_model", **where))
            elif value is None:
                unknown.append(li(f"{e(what)} : modèle de l'auteur ou du relecteur non relevé.", mention="unknown", **where))

        def provider(roles: dict[str, Any], what: str, **where: str) -> None:
            if roles.get("same_provider") is True:
                supplier = (roles.get("evaluator") or {}).get("supplier")
                other = roles.get("other_declared") or []
                more = f" ; autre fournisseur déclaré : {', '.join(other)}" if other else ""
                same.append(li(f"{e(what)} : Evaluator sur le même fournisseur que l'auteur ({e(supplier)}){e(more)}.",
                               mention="same_provider", **where))
            elif roles.get("same_provider") is None:
                unknown.append(li(f"{e(what)} : fournisseur de l'auteur ou de l'Evaluator non relevé.",
                                  mention="unknown", **where))

        for ticket in self.tickets:
            review = last_round(ticket.get("code_review"), "review")
            if review:
                models = review.get("models") or {}
                model(models.get("same_model"), f"Revue de code du ticket {ticket['id']}", models.get("reviewer"),
                      ticket=ticket["id"], check="code_review")
            evaluation = last_round(ticket.get("evaluation"), "evaluation")
            if evaluation:
                provider(evaluation.get("roles") or {}, f"Ticket Evaluation du ticket {ticket['id']}",
                         ticket=ticket["id"], check="evaluation")
        review = last_round(self.end_review)
        if review:
            models = review.get("models") or {}
            reviewer = models.get("reviewer")
            model(models.get("same_model"), "Revue de code de fin",
                  reviewer.get("model") if isinstance(reviewer, dict) else reviewer, check="end_review")
        if self.outcome:
            provider(self.outcome.get("roles") or {}, "Outcome Evaluation", check="outcome_evaluation")
        return same, unknown

    def eyes(self) -> str:
        proposals = [li(f"Ticket {e(finding['ticket'])} : {e(finding['text'])}", proposal=finding["id"])
                     for finding in self.findings() if finding.get("classification") == "proposal"]
        captures = [self.comparison(owner, name) for owner, name in self.pieces.comparisons(self.state)]
        same, unknown = self.mentions()
        return "\n".join((
            "<h3>Propositions</h3>", items(proposals, "aucune"),
            "<h3>Écarts de fidélité relevés par l'Evaluator de fin</h3>", self.free_section("fidelity_deviations"),
            "<h3>Écarts de fidélité mesurés par les contrôles mécaniques</h3>", items(self.measured_deviations()),
            "<h3>Captures côte à côte et images de différence, par état prototypé et par rendu</h3>",
            "\n".join(captures) if captures else "<p>Aucune capture de comparaison n'est enregistrée.</p>",
            "<h3>Remarques d'exploration</h3>", self.free_section("exploration"),
            "<h3>Même fournisseur ou même modèle que l'auteur</h3>", items(same, "aucune mention"),
            "<h3>Indépendance non établie</h3>", items(unknown, "aucune"),
        ))

    # --- 3. what was NOT verified ------------------------------------------------------

    def not_verified(self) -> str:
        cannot = f"rubrique « {NOT_VERIFIED} » impossible à remplir : "
        screens = self.spec["screens"]
        if self.spec["prototype"] is None and self.spec["prototype_problem"] is None and not screens:
            states = ('<p data-no-prototype="true">La Spec ne référence aucun Validated Prototype : aucun état d\'écran '
                      "n'est prototypé, la fidélité n'est prouvée sur aucun écran.</p>")
        elif not screens or any(not screen.get("states") for screen in screens):
            raise Refusal(cannot + f"la Spec {self.spec['id']} nomme un Validated Prototype sans l'inventaire des états "
                          "de ses écrans (« Écran : <nom> », tableau « État | Statut | Détail ») : les états non "
                          "prototypés ne peuvent pas être listés")
        else:
            missing = [li(f"Écran {e(screen['name'])}, état « {e(state['name'])} » : non prototypé, la fidélité n'y est "
                          "pas prouvée.", screen=screen["name"], state=state["name"])
                       for screen in screens for state in screen["states"] if state["status"] == "non prototypé"]
            apart = [li(f"Écran {e(screen['name'])}, état « {e(state['name'])} » : sans objet — {e(state['detail'])}",
                        screen=screen["name"], not_applicable=state["name"])
                     for screen in screens for state in screen["states"] if state["status"] == "sans objet"]
            other = [li(f"Écran {e(screen['name'])}, état « {e(state['name'])} » : statut « {e(state['status'])} »",
                        screen=screen["name"], unknown_status=state["name"])
                     for screen in screens for state in screen["states"]
                     if state["status"] not in ("prototypé", "non prototypé", "sans objet")]
            states = items(missing, "aucun : chaque état listé par la Spec est prototypé ou sans objet")
            if apart or other:
                states += "\n<p>États déclarés sans objet, ou d'un autre statut, par la Spec :</p>\n" + items(apart + other)
        baseline = items(li(f"<strong>{e(entry['criterion'])}</strong> — {e(entry['detail'])}")
                         for entry in self.settings["baseline"])
        limits = items(li(e(line)) for line in self.settings["limits"])
        return "\n".join((
            "<h3>États d'écran non prototypés</h3>", states,
            "<h3>Critères du socle sans mécanisme</h3>", baseline,
            "<h3>Limites connues des contrôles</h3>", limits,
            "<h3>Relevé sur cette livraison</h3>", "<!--delivery-->",
        ))

    def delivery_limits(self) -> str:
        """What this very delivery leaves unverified, read in its records:
        rendered last, once every rubric said what it could not show."""
        lines = [li(f"Pièce irrecevable, ce qu'elle prouvait n'est pas vérifié : {e(entry['piece'])} — {e(entry['reason'])}",
                    inadmissible=entry["piece"]) for entry in self.pieces.inadmissible()]
        if self.outcome is None:
            lines.append(li("Aucune Outcome Evaluation n'est rendue : aucune user story n'est observée sur le produit assemblé."))
        elif self.outcome.get("commit") != self.commit:
            lines.append(li(f"L'Outcome Evaluation a été rendue au commit {e(self.outcome.get('commit'))}, non au commit du dossier."))
        for story in (self.outcome or {}).get("stories") or []:
            if story.get("state") != "observed":
                lines.append(li(f"User story {e(story['number'])} : {e(STATES.get(story['state'], story['state']))} sur le "
                                "produit assemblé."))
        if self.elsewhere:
            lines.append(li(f"{len(set(self.elsewhere))} capture(s) de comparaison prise(s) à un autre commit que celui du "
                            f"dossier : {e(', '.join(sorted(set(self.elsewhere))))}."))
        for entry in self.conditions:
            if entry["verdict"] != "pass":
                lines.append(li(f"Condition {entry['number']} de fin de Spec {e(VERDICTS.get(entry['verdict'], entry['verdict']))} : "
                                f"{e(entry['label'])}."))
        return items(lines, "aucun relevé propre à cette livraison")

    # --- 4. per user story ------------------------------------------------------------

    def stories(self) -> str:
        judged = {story["number"]: story for story in (self.outcome or {}).get("stories") or []}
        repairs = {entry.get("story"): entry for entry in (self.outcome or {}).get("repairs") or []}
        covering: dict[int, list[str]] = {}
        for ticket in self.tickets:
            for number in ticket.get("user_stories") or []:
                covering.setdefault(int(number), []).append(ticket["id"])
        head = ("<p>Aucune Outcome Evaluation n'est rendue.</p>" if self.outcome is None else
                f"<p>Outcome Evaluation rendue au commit {e(self.outcome.get('commit'))} le {e(self.outcome.get('at'))} par "
                f"{e(self.outcome.get('recorded_by'))} : {e(OUTCOMES.get(self.outcome.get('outcome'), self.outcome.get('outcome')))}.</p>")
        blocks = []
        for story in self.spec["stories"]:
            state = judged.get(story["number"])
            rows: list[tuple[str, Any]] = [
                ("État", e(STATES.get(state["state"], state["state"])) if state else "non évaluée"),
                ("Tickets couvrants", e(", ".join(covering.get(story["number"], [])) or "aucun")),
            ]
            if state:
                rows += [("Raison", e(state["reason"]) if state.get("reason") else None),
                         ("Cause", e(CAUSES.get(state.get("cause"), state.get("cause"))) if state.get("cause") else None),
                         ("Preuve", self.piece(self.id, state.get("evidence")))]
            repair = repairs.get(story["number"])
            if repair:
                rows.append(("Repair", e(repair.get("repair") or "rédigé, pas encore publié") + " — "
                             + e((repair.get("draft") or {}).get("title") or "")))
            blocks.append(f'<article data-story="{story["number"]}" data-state="{e(state["state"] if state else "none")}">'
                          f'<h3>User story {story["number"]}</h3><p>{e(story["text"])}</p>{pairs(rows)}</article>')
        return head + "\n" + "\n".join(blocks)

    # --- 5. per ticket ----------------------------------------------------------------

    def judged(self, owner: str, entry: dict[str, Any]) -> str:
        text = e(STATES.get(entry.get("state"), entry.get("state")))
        if entry.get("reason"):
            text += f" — {e(entry['reason'])}"
        if entry.get("cause"):
            text += f" ({e(CAUSES.get(entry['cause'], entry['cause']))})"
        return text + self.piece(owner, entry.get("evidence"))

    def refusals(self, ticket: dict[str, Any]) -> str:
        counters = ticket.get("counters") or {}
        lines = [li(f"Reprises : {e(counters.get('resumes'))} ; tours de correction : {e(counters.get('correction_rounds'))}.")]
        for entry in ((ticket.get("resume") or {}).get("entries") or []):
            lines.append(li(f"Reprise du {e(entry.get('at'))} : {e(RESUME_CAUSES.get(entry.get('cause'), entry.get('cause')))} — "
                            f"{e(entry.get('ref'))}"))
        correction = ticket.get("correction")
        if correction:
            lines.append(li(f"Tour de correction ouvert le {e(correction.get('at'))} au commit {e(correction.get('commit'))} : "
                            f"{len(correction.get('blocking_findings') or [])} Blocking Finding(s), "
                            f"{len(correction.get('not_observed') or [])} observation(s) manquante(s)."))
        for entry in (ticket.get("evaluation") or {}).get("rounds") or []:
            if entry.get("outcome") != "favorable":
                lines.append(li(f"Évaluation du {e(entry.get('at'))} au commit {e(entry.get('commit'))} : "
                                f"{e(OUTCOMES.get(entry.get('outcome'), entry.get('outcome')))}."))
        for entry in (ticket.get("code_review") or {}).get("rounds") or []:
            if entry.get("verdict") != "favorable":
                lines.append(li(f"Revue de code du {e(entry.get('at'))} au commit {e(entry.get('commit'))} : "
                                f"{e(FAVOR.get(entry.get('verdict'), entry.get('verdict')))}."))
        for entry in (ticket.get("test_review") or {}).get("rounds") or []:
            if entry.get("verdict") != "favorable":
                lines.append(li(f"Relecture des tests du {e(entry.get('at'))} au commit {e(entry.get('commit'))} : défavorable."))
        merge = ticket.get("merge")
        if merge and merge.get("outcome") != "merged":
            lines.append(li(f"Fusion du {e(merge.get('at'))} : {e(merge.get('outcome'))}."))
        stop = ticket.get("stop")
        if stop:
            lines.append(li(f"Arrêt ({e(stop.get('reason'))}) : {e(stop.get('detail'))}"))
        park = ticket.get("park")
        if park:
            lines.append(li(f"Parqué ({e(PARK_CAUSES.get(park.get('cause'), park.get('cause')))}, par {e(park.get('origin'))}) : "
                            f"{e(park.get('detail'))}"))
        for entry in ticket.get("park_lifts") or []:
            lines.append(li(f"Parcage levé le {e(entry.get('at'))} ({e(PARK_CAUSES.get(entry.get('cause'), entry.get('cause')))}) : "
                            f"{e(entry.get('detail'))}"))
        return items(lines)

    def ticket(self, ticket: dict[str, Any]) -> str:
        owner = ticket["id"]
        evaluation = last_round(ticket.get("evaluation"), "evaluation")
        startup = last_round(ticket.get("evaluation"), "startup")
        line = ticket.get("demonstration_line")
        if not isinstance(line, str):
            demonstration = "<p>Sans objet : un prefactoring n'a pas de ligne de démonstration.</p>"
            if startup:
                demonstration += (f"<p>Démarrage du produit vérifié par du code au commit {e(startup.get('commit'))} : "
                                  f"{'démarré' if startup.get('started') else 'non démarré'}.</p>")
                demonstration += self.piece(owner, startup.get("evidence")) if startup.get("evidence") else ""
        else:
            demonstration = f"<p>{e(line)}</p>"
            proof = ((ticket.get("handoff") or {}).get("records") or {}).get("demonstration_proof") or {}
            demonstration += "<p>Preuve de l'auteur :</p>" + self.piece(owner, proof.get("piece"))
            demonstration += "<p>Ticket Evaluation : " + (
                self.judged(owner, evaluation["demonstration_line"]) if evaluation else "aucune évaluation rendue") + "</p>"
        states = {entry["number"]: entry for entry in (evaluation or {}).get("criteria") or []}
        criteria = items(
            li(f"Critère {number} : {e(text)}<br>" + (self.judged(owner, states[number]) if number in states else "non évalué"))
            for number, text in enumerate(ticket.get("criteria") or [], start=1))
        record = (ticket.get("gates") or {}).get("ticket_end") or {}
        gate = items(li(f"{entry['number']}. {e(entry['name'])} : {e(VERDICTS.get(entry['verdict'], entry['verdict']))} — "
                        f"{e(entry['detail'])}") for entry in record.get("conditions") or [])
        rows = [
            ("Genre", e(KINDS.get(ticket.get("kind"), ticket.get("kind")))),
            ("État", e(status_of(ticket))),
            ("User stories couvertes", e(", ".join(str(number) for number in ticket.get("user_stories") or []) or "aucune")),
            ("Branche", f"{e(ticket.get('branch'))} à {e(ticket.get('tip'))}" if ticket.get("branch") else None),
            ("Sortie de l'auteur", e(EXITS.get((ticket.get("exit") or {}).get("exit"), "aucune"))),
        ]
        named = sorted(name for (holder, name) in [*self.pieces.records, *self.pieces.refused] if holder == owner)
        return (f'<article data-ticket="{e(owner)}"><h3>{e(owner)} — {e(ticket.get("title") or "")}</h3>{pairs(rows)}'
                f"<h4>Ligne de démonstration</h4>{demonstration}<h4>Critères</h4>{criteria}"
                f"<h4>Refus et reprises</h4>{self.refusals(ticket)}"
                f"<h4>Porte de fin de ticket ({e(record.get('version') or 'aucun relevé')})</h4>{gate}"
                f"<h4>Pièces du ticket</h4><p>{e(', '.join(named) or NONE)}</p></article>")

    # --- 6. tracked elements ------------------------------------------------------------

    def tracked(self) -> str:
        lines = []
        for ticket in self.tickets:
            for item in ticket.get("tracked_items") or []:
                more = f" — repair {e(item['repair'])}" if item.get("repair") else ""
                lines.append(li(f"Ticket {e(ticket['id'])}, {e(SECTIONS.get(item['section'], item['section']))} "
                                f"{e(item['number'])} : {e(item['text'])} — <strong>{e(item['state'])}</strong>{more}",
                                tracked=f"{ticket['id']}:{item['id']}", state=item["state"]))
        found = []
        for finding in self.findings():
            more = "".join((f" — raison : {e(finding['reason'])}" if finding.get("reason") else "",
                            f" — repair {e(finding['repair'])}" if finding.get("repair") else ""))
            found.append(li(f"Ticket {e(finding['ticket'])}, constat hors ticket {e(finding['number'])} : {e(finding['text'])} — "
                            f"<strong>{e(finding['state'])}</strong>{more}", finding=finding["id"], state=finding["state"]))
        return "\n".join(("<h3>Écarts et « non faits »</h3>", items(lines), "<h3>Constats hors ticket</h3>", items(found)))

    # --- 7. outside the initial graph ---------------------------------------------------

    def repair_origins(self) -> dict[str, list[str]]:
        origins: dict[str, list[str]] = {}

        def add(repair: Any, origin: str) -> None:
            if isinstance(repair, str) and repair:
                origins.setdefault(repair, []).append(origin)

        red = self.convoy.get("integration_red") or {}
        add(red.get("repair"), f"rouge de la branche d'intégration : {red.get('control')}")
        for entry in ((self.convoy.get("outcome_evaluation") or {}).get("rounds") or []):
            for repair in entry.get("repairs") or []:
                add(repair.get("repair"), f"user story {repair.get('story')} non observée par l'Outcome Evaluation")
        for entry in self.end_review.get("rounds") or []:
            for finding in entry.get("findings") or []:
                add(finding.get("repair"), f"Blocking Finding {finding.get('id')} de la revue de fin : {finding.get('summary')}")
        for ticket in self.tickets:
            for exception in ticket.get("planning_exceptions") or []:
                add(exception.get("repair"), f"écart ou « non fait » du ticket {ticket['id']}, réparation demandée par Benjamin")
            for finding in ticket.get("findings") or []:
                add(finding.get("repair"), f"constat hors ticket {finding['id']}")
        return origins

    def outside_graph(self) -> str:
        origins = self.repair_origins()
        repairs = [
            li(f"{e(ticket['id'])} — {e(ticket.get('title') or '')} — {e(status_of(ticket))} — rétablit : "
               f"{e(' ; '.join(origins.get(ticket['id'], [])) or 'origine non relevée')} — ligne de démonstration : "
               f"{e(ticket.get('demonstration_line'))}", repair=ticket["id"])
            for ticket in self.tickets if ticket.get("kind") == "repair"]
        exceptions, overrides, answers = [], [], []
        for ticket in self.tickets:
            for number, entry in enumerate(ticket.get("planning_exceptions") or [], start=1):
                response = entry.get("response") or entry.get("resolution") or {}
                named = [*(entry.get("items") or []), *(f"ancre {anchor}" for anchor in entry.get("anchors") or [])]
                answered = (f" — réponse de Benjamin : option {e(response.get('option'))} le {e(response.get('at'))}"
                            + (" (accepte ce qui est livré)" if entry.get("accepted") or (
                                entry.get("items") and response.get("option") == entry.get("accept_option")) else "")
                            if response else " — sans réponse")
                exceptions.append(li(
                    f"Ticket {e(ticket['id'])}, le {e(entry.get('at'))} ({e(entry.get('kind'))}) : {e(entry.get('summary'))}"
                    + (f" — porte sur : {e(', '.join(named))}" if named else "") + answered
                    + (f" — repair {e(entry['repair'])}" if entry.get("repair") else ""),
                    planning_exception=f"{ticket['id']}.{number}", state=entry.get("state")))
            for entry in ticket.get("overrides") or []:
                overrides.append(li(
                    f"Ticket {e(ticket['id'])}, Blocking Finding {e(entry['finding'])}, revue au commit {e(entry['commit'])} — "
                    f"{e(entry['approver'])}, le {e(entry['at'])} : « {e(entry['words'])} »",
                    override=f"{ticket['id']}:{entry['finding']}"))
            answer = (ticket.get("park") or {}).get("answer")
            if answer:
                answers.append(li(f"Ticket {e(ticket['id'])} parqué : option {e(answer.get('option'))} le {e(answer.get('at'))}."))
            for entry in ticket.get("park_lifts") or []:
                answers.append(li(f"Ticket {e(ticket['id'])}, parcage levé le {e(entry.get('at'))} sur la demande "
                                  f"{e(entry.get('request'))} : option {e(entry.get('option'))}."))
        raised = []
        for name, label in (("outcome_evaluation", "Outcome Evaluation"), ("end_review", "revue de fin")):
            stop = (self.convoy.get(name) or {}).get("stop")
            if stop:
                raised.append(li(f"Arrêt de la {label} au commit {e(stop.get('commit'))} ({e(stop.get('reason'))}) : "
                                 f"{e(stop.get('detail'))}"))
        for name, label in (("grouped_request", "Demande groupée"), ("incident", "Incident d'usine")):
            if self.convoy.get(name):
                raised.append(li(f"{label} : {e(self.convoy[name].get('bead'))}"))
        return "\n".join((
            "<h3>Tickets repair créés</h3>", items(repairs),
            "<h3>Planning Exceptions</h3>", items(exceptions, "aucune"),
            "<h3>Dérogations enregistrées</h3>", items(overrides, "aucune"),
            "<h3>Autres réponses de Benjamin</h3>", items(answers, "aucune"),
            "<h3>Arrêts et demandes remontés</h3>", items(raised),
        ))

    # --- 8. records ----------------------------------------------------------------------

    def duration(self) -> str:
        start = (self.convoy.get("integration") or {}).get("at")
        ends = [value.get("at") for value in (self.convoy.get("spec_end"), self.outcome, last_round(self.end_review))
                if isinstance(value, dict) and value.get("at")]
        if not start or not ends:
            return "<p>Durée non relevée : la branche d'intégration ou les verdicts de fin n'ont pas d'heure enregistrée.</p>"
        end = max(ends)
        try:
            spent = datetime.fromisoformat(end.replace("Z", "+00:00")) - datetime.fromisoformat(start.replace("Z", "+00:00"))
            minutes = int(spent.total_seconds() // 60)
            text = f"{minutes // 60} h {minutes % 60:02d} min"
        except ValueError:
            text = "non calculable"
        return (f"<p>De l'ouverture de la branche d'intégration ({e(start)}) au dernier relevé de fin de Spec ({e(end)}) : "
                f"{e(text)}.</p>")

    def records(self) -> str:
        outside = []
        for ticket in self.tickets:
            paths = ((ticket.get("handoff") or {}).get("records") or {}).get("files_outside_declared_scope")
            if isinstance(paths, list) and paths:
                outside.append(li(f"Ticket {e(ticket['id'])} : {e(', '.join(paths))}", outside_scope=ticket["id"]))
            elif paths is None and not withdrawn(ticket):
                outside.append(li(f"Ticket {e(ticket['id'])} : aucun Declared Scope déclaré, ou aucun relevé."))
        models = []
        for ticket in self.tickets:
            for role, label in ROLES:
                entry = (ticket.get("models") or {}).get(role)
                if entry:
                    models.append(li(f"Ticket {e(ticket['id'])}, {label} : {e(entry.get('model'))} ({e(entry.get('provider'))}, "
                                     f"agent {e(entry.get('agent'))})"))
        review = last_round(self.end_review)
        if review:
            reviewer = (review.get("models") or {}).get("reviewer")
            models.append(li(f"Revue de fin, relecteur : {e(json.dumps(reviewer, ensure_ascii=False, sort_keys=True))}"))
        if self.outcome:
            evaluator = (self.outcome.get("roles") or {}).get("evaluator")
            models.append(li(f"Outcome Evaluation, Evaluator : {e(json.dumps(evaluator, ensure_ascii=False, sort_keys=True))}"))
        counted = self.convoy.get("end_round")
        rounds = f"<p>Tours de fin comptés : {e((self.convoy.get('counters') or {}).get('end_rounds'))}." + (
            f" Dernier tour compté au commit {e(counted.get('commit'))} ({e(counted.get('source'))}) le {e(counted.get('at'))}."
            if counted else "") + "</p>"
        # The stop of the rounds (T26), not the request it leads to: that
        # one is written once this page exists, and carries its link.
        stop = self.convoy.get("end_stop")
        if isinstance(stop, dict) and "reason" in stop:
            rounds += (f"\n<p>Tours de réparation de fin arrêtés ({e(END_STOPS.get(stop['reason'], stop['reason']))}) au commit "
                       f"{e(stop.get('commit'))}, le {e(stop.get('at'))} : {e(stop.get('detail'))}. Aucun tour de plus ne "
                       "démarre ; une demande « non conforme » part vers l'opérateur.</p>")
        contradictions = [
            li(f"User story {e(entry.get('story'))} non observée sur le produit assemblé, alors que ses tickets couvrants "
               "étaient observés : " + e(" ; ".join(
                   f"{ticket.get('id')} (évaluation favorable au commit {ticket.get('commit')}, le {ticket.get('at')})"
                   for ticket in entry.get("tickets") or [])), contradiction=entry.get("story"))
            for entry in ((self.convoy.get("outcome_evaluation") or {}).get("state") or {}).get("contradictions") or []]
        return "\n".join((
            "<h3>Fichiers hors Declared Scope</h3>", items(outside),
            "<h3>Modèles par rôle</h3>", items(models, "aucun modèle relevé"),
            "<h3>Durée</h3>", self.duration(),
            "<h3>Tours de fin</h3>", rounds,
            "<h3>Contradictions preuve de ticket / fin de Spec</h3>", items(contradictions, "aucune"),
        ))

    # --- 9. TDD proofs and review findings --------------------------------------------------

    def finding(self, entry: dict[str, Any]) -> str:
        citation = entry.get("citation") or {}
        cited = (f" — cite {e(citation.get('source'))}" + (f" {e(citation['path'])}" if citation.get("path") else "")
                 + f" : « {e(citation.get('quote'))} »") if citation else ""
        demoted = f" — rétrogradé : {e(entry['demoted'])}" if entry.get("demoted") else ""
        repair = "".join((f" — repair {e(entry['repair'])}" if entry.get("repair") else "",
                          f" — repair refusé : {e(entry['repair_refused'])}" if entry.get("repair_refused") else ""))
        return (f"{e(entry.get('id'))} ({e(entry.get('axis'))}, {'bloquant' if entry.get('blocking') else 'non bloquant'}) : "
                f"{e(entry.get('summary'))}{cited}{demoted}{repair}")

    def review_round(self, entry: dict[str, Any]) -> str:
        head = (f"{'Jugement' if entry.get('kind') == 'judgement' else 'Revue'} du {e(entry.get('at'))} au commit "
                f"{e(entry.get('commit'))} par {e(entry.get('recorded_by'))} : "
                f"{e(FAVOR.get(entry.get('verdict', entry.get('outcome')), entry.get('verdict', entry.get('outcome'))))}")
        lines = [li(self.finding(finding)) for finding in entry.get("findings") or []]
        for name, response in sorted((entry.get("responses") or {}).items()):
            lines.append(li(f"Réponse à {e(name)} : {e(json.dumps(response, ensure_ascii=False, sort_keys=True))}"))
        for name, judgement in sorted((entry.get("judgements") or {}).items()):
            lines.append(li(f"Jugement de {e(name)} : {e(json.dumps(judgement, ensure_ascii=False, sort_keys=True))}"))
        for name, answer in sorted((entry.get("answers") or {}).items()):
            lines.append(li(f"Question fermée {e(name)} : {e(json.dumps(answer, ensure_ascii=False, sort_keys=True))}"))
        return f"<p>{head}</p>" + items(lines, "aucun constat")

    def proofs(self) -> str:
        blocks = []
        for ticket in self.tickets:
            owner, tdd = ticket["id"], ticket.get("tdd") or {}
            steps = []
            for step, label in TDD_STEPS:
                if step in tdd:
                    entry = tdd[step]
                    base = f", depuis {e(entry['base'])}" if entry.get("base") else ""
                    reason = f" — {e(entry['reason'])}" if entry.get("reason") else ""
                    piece = f"tdd_{step}"
                    held = (owner, piece) in self.pieces.records or (owner, piece) in self.pieces.refused
                    steps.append(li(f"{label} prouvé au commit {e(entry.get('commit'))}{base} le {e(entry.get('at'))}{reason}"
                                    + (self.piece(owner, piece) if held else "")))
            reviews = [li(f"Relecture des tests du {e(entry.get('at'))} au commit {e(entry.get('commit'))} par "
                          f"{e(entry.get('recorded_by'))} : {e(FAVOR.get(entry.get('verdict'), entry.get('verdict')))} — "
                          + e(" ; ".join(f"{name} : {test.get('state')}" + (f" ({test['reason']})" if test.get("reason") else "")
                                         for name, test in sorted((entry.get("tests") or {}).items()))))
                       for entry in (ticket.get("test_review") or {}).get("rounds") or []]
            rounds = "\n".join(self.review_round(entry) for entry in (ticket.get("code_review") or {}).get("rounds") or [])
            blocks.append(f'<article data-proofs="{e(owner)}"><h3>{e(owner)}</h3><h4>Preuves TDD</h4>'
                          f'{items(steps, "aucune étape prouvée")}<h4>Relecture des tests de critère</h4>{items(reviews, "aucune")}'
                          f"<h4>Revue de code</h4>{rounds or '<p>aucune revue rendue</p>'}</article>")
        rounds = []
        for entry in self.end_review.get("rounds") or []:
            extent, coverage = entry.get("extent") or {}, entry.get("coverage") or {}
            rounds.append(self.review_round(entry) + (
                f"<p>Étendue : {e(extent.get('files'))} fichier(s), {e(extent.get('commits'))} commit(s), "
                f"+{e(extent.get('insertions'))} −{e(extent.get('deletions'))} ; diff {e(sha(entry.get('base')))}.."
                f"{e(sha(entry.get('commit')))} ; axes relus : {e(', '.join(coverage.get('axes') or []))} ; fichiers non "
                f"relus : {e(len(coverage.get('missing') or []))} ; durée : {e(entry.get('duration_seconds'))} s.</p>"))
        return "\n".join(blocks) + "\n<h3>Revue de code de fin</h3>\n" + ("\n".join(rounds) or "<p>aucune revue de fin rendue</p>")

    # --- the whole page ---------------------------------------------------------------------

    def render(self) -> str:
        bodies = [self.header(), self.eyes(), self.not_verified(), self.stories(),
                  "\n".join(self.ticket(ticket) for ticket in self.tickets) or f"<p>{NONE}</p>",
                  self.tracked(), self.outside_graph(), self.records(), self.proofs()]
        bodies[2] = bodies[2].replace("<!--delivery-->", self.delivery_limits())
        sections = "\n".join(
            f'<section id="rubrique-{number}">\n<h2>{number}. {e(title)}</h2>\n{body}\n</section>'
            for number, (title, body) in enumerate(zip(RUBRICS, bodies), start=1))
        nav = " · ".join(f'<a href="#rubrique-{number}">{number}. {e(title)}</a>' for number, title in enumerate(RUBRICS, start=1))
        title = f"Evidence Pack — Spec {self.spec['id']} — commit {sha(self.commit)}"
        return (
            "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n"
            f"<title>{e(title)}</title>\n<style>{STYLE}</style>\n</head>\n<body>\n<h1>{e(title)}</h1>\n"
            f"<p>Dossier assemblé par du code ({VERSION}) à partir des pièces enregistrées, sans synthèse d'agent. "
            f"Un commit de plus sur la branche d'intégration le périme.</p>\n<nav>{nav}</nav>\n{sections}\n</body>\n</html>\n")


STYLE = (
    "body{font-family:system-ui,sans-serif;max-width:72rem;margin:2rem auto;padding:0 1rem;line-height:1.45;color:#1b1b1b}"
    "h2{margin-top:2.5rem;border-bottom:2px solid #1b1b1b}h3{margin-top:1.5rem}"
    "table{border-collapse:collapse;width:100%}td,th{border:1px solid #999;padding:.3rem .5rem;text-align:left;vertical-align:top}"
    "dt{font-weight:600;margin-top:.4rem}dd{margin-left:1.5rem}pre{background:#f3f3f3;padding:.5rem;overflow:auto;white-space:pre-wrap}"
    "img{max-width:100%;border:1px solid #999}figure{margin:1rem 0;padding:.5rem;border:1px solid #ccc}"
    "article{border-left:4px solid #ccc;padding-left:1rem;margin:1rem 0}details.piece{margin:.3rem 0}"
    ".verdict{font-size:1.2rem;font-weight:700;padding:.6rem;border:2px solid}.conforme{border-color:#1a7f37}"
    ".non-conforme{border-color:#b42318;color:#b42318}.irrecevable{color:#b42318;font-weight:600}"
    "tr[data-verdict=fail] td,tr[data-verdict=stale] td{color:#b42318}")


# --- generate and check ------------------------------------------------------------------


def build(convoy_id: str, repo: Path) -> dict[str, Any]:
    """The page the recorded state gives now, and the pieces it shows:
    nothing is written."""
    gate = read_gate(convoy_id, repo)
    state = read_state(convoy_id, repo)
    spec = read_spec(state["convoy"].get("spec"))
    settings = read_settings()
    pieces = Pieces(convoy_id, state)
    page = Page(convoy_id, gate, state, spec, settings, pieces)
    data = page.render().encode("utf-8")
    return {"page": data, "digest": digest_of(data), "assets": pieces.assets, "commit": gate["commit"],
            "branch": gate.get("branch"), "spec": spec["id"], "conforming": page.conforming, "conditions": gate["conditions"],
            "inadmissible": pieces.inadmissible(), "recorded": state["convoy"].get("evidence_pack")}


def packs_dir() -> Path:
    base = os.environ.get("EVIDENCE_PACK_DIR")
    path = Path(base) if base else Path.home() / ".local" / "state" / "agent-factory-evidence-packs"
    path = path.absolute()
    probe = next(parent for parent in (path, *path.parents) if parent.is_dir())
    inside = run(["git", "-C", str(probe), "rev-parse", "--is-inside-work-tree"])
    if ".git" in path.parts or (inside.returncode == 0 and inside.stdout.strip() == "true"):
        raise Refusal(f"le dossier des Evidence Packs {path} est dans un dépôt Git : un dossier porte des pièces du magasin "
                      "de preuves, qui restent hors de tout historique Git (EVIDENCE_PACK_DIR)")
    return path


def conditions_out(conditions: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [{name: entry[name] for name in ("number", "name", "verdict")} for entry in conditions]


def cmd_generate(args: argparse.Namespace) -> int:
    repo = require_repo(args.repo)
    built = build(args.convoy, repo)
    folder = packs_dir() / built["spec"] / args.convoy / built["commit"]
    folder.parent.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=".evidence-pack-", dir=folder.parent))
    try:
        (staging / PIECES).mkdir()
        for name, source in sorted(built["assets"].items()):
            data = source.read_bytes()
            if digest_of(data).removeprefix("sha256:") != Path(name).stem:
                raise Refusal(f"la pièce {source} a changé dans le magasin de preuves pendant la génération : rien n'est écrit")
            (staging / name).write_bytes(data)
        (staging / PAGE).write_bytes(built["page"])
        # Recorded first: a pack the tracker refuses is not left on disk.
        command = [str(STATE_TOOL), "record-evidence-pack", args.convoy, "--commit", built["commit"], "--digest",
                   built["digest"], "--path", str(folder), "--conforming" if built["conforming"] else "--non-conforming",
                   "--inadmissible", str(len(built["inadmissible"]))]
        status, answer = tool(Path(command[0]), *command[1:])
        if status != 0:
            raise Refusal(f"record-evidence-pack refusé par la commande d'état : {refusal_text(answer)}")
        shutil.rmtree(folder, ignore_errors=True)
        os.replace(staging, folder)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    print(json.dumps({
        "ok": True, "convoy": args.convoy, "spec": built["spec"], "branch": built["branch"], "commit": built["commit"],
        "version": VERSION, "path": str(folder), "page": str(folder / PAGE), "digest": built["digest"],
        "conforming": built["conforming"], "conditions": conditions_out(built["conditions"]),
        "inadmissible": built["inadmissible"], "pieces": len(built["assets"]), "written": bool(answer.get("written")),
    }, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


def altered(folder: Path, recorded: dict[str, Any]) -> str | None:
    """Why the files of the pack are not the bytes that were written."""
    try:
        data = (folder / PAGE).read_bytes()
    except OSError:
        return f"la page {folder / PAGE} est absente"
    if digest_of(data) != recorded["digest"]:
        return f"la page {folder / PAGE} n'a plus l'empreinte enregistrée ({digest_of(data)} au lieu de {recorded['digest']})"
    for name, digest in sorted(set(ASSET_RE.findall(data.decode("utf-8", "replace")))):
        try:
            found = hashlib.sha256((folder / name).read_bytes()).hexdigest()
        except OSError:
            return f"la pièce {folder / name} que la page montre est absente"
        if found != digest:
            return f"la pièce {folder / name} que la page montre n'a plus son empreinte"
    return None


def cmd_check(args: argparse.Namespace) -> int:
    repo = require_repo(args.repo)
    built = build(args.convoy, repo)
    recorded = built["recorded"]
    answer: dict[str, Any] = {"convoy": args.convoy, "spec": built["spec"], "branch": built["branch"], "tip": built["commit"],
                              "version": VERSION, "commit": None, "digest": None, "path": None, "page": None,
                              "conforming": None}
    if isinstance(recorded, dict) and "unruled" not in recorded:
        answer.update(commit=recorded["commit"], digest=recorded["digest"], path=recorded["path"],
                      page=str(Path(recorded["path"]) / PAGE), conforming=recorded["conforming"])
    if not isinstance(recorded, dict) or "unruled" in recorded:
        state, reason = ABSENT, f"aucun Evidence Pack n'est généré pour le convoi {args.convoy}"
    elif recorded["commit"] != built["commit"]:
        state, reason = OUTDATED, (
            f"dossier périmé : généré au commit {sha(recorded['commit'])}, la branche d'intégration {built['branch']} est à "
            f"{sha(built['commit'])} ; un commit de plus le périme, il est à générer de nouveau")
    elif altered(Path(recorded["path"]), recorded):
        state, reason = ALTERED, f"dossier altéré depuis sa génération : {altered(Path(recorded['path']), recorded)}"
    elif recorded["digest"] != built["digest"]:
        state, reason = OUTDATED, (
            f"dossier périmé : l'état enregistré a changé depuis sa génération au commit {sha(recorded['commit'])} (ce que les "
            "relevés donnent aujourd'hui n'est plus la page enregistrée) ; il est à générer de nouveau")
    elif recorded["inadmissible"] or built["inadmissible"]:
        named = ", ".join(entry["piece"] for entry in built["inadmissible"])
        state, reason = INCOMPLETE, f"dossier incomplet : pièce(s) irrecevable(s) dans le magasin de preuves : {named}"
    else:
        state, reason = HELD, None
    answer.update(ok=state == HELD, state=state)
    if reason:
        answer["error"] = f"refus : {reason}"
    print(json.dumps(answer, indent=2, sort_keys=True, ensure_ascii=False))
    return 0 if state == HELD else EXIT_REFUSED


# --- command line ------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    # Required values are checked by the handlers, not by argparse: a refusal
    # is one JSON answer. No option carries a text for the page.
    for name, handler in (("generate", cmd_generate), ("check", cmd_check)):
        p = sub.add_parser(name)
        p.add_argument("convoy")
        p.add_argument("--repo")
        p.set_defaults(handler=handler)
    return parser


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args)
    except PassedOn as exc:
        print(json.dumps(exc.answer, indent=2, sort_keys=True, ensure_ascii=False))
        return exc.status
    except Refusal as exc:
        print(json.dumps({"ok": False, "error": f"refus : {exc}"}, indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_REFUSED


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
