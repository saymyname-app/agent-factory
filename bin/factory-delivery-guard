#!/usr/bin/env bash
# factory-delivery-guard — catches a delivery Bead closed without its six
# ADR-0016 proof fields (gc.delivery_status, gc.work_outcome, gc.github_repo,
# gc.pr_number, gc.pr_head, gc.merge_commit).
#
# bin/deliver-close is the only sanctioned door IN: it refuses to close a
# delivery bead without first verifying, via `gh pr view`, that the named PR
# is genuinely merged. Nothing used to check the door OUT — a raw
# `gc bd close` bypasses deliver-close entirely, which is exactly what
# happened to delivery bead af-7700 on 2026-09-16: closed with none of the six
# fields set, which silently blocked the then-live campaign status and
# product-status readers (both retired since; they read those fields off the
# last delivered bead) for about half a day before anyone noticed.
#
# This is the missing check on the way out. It lists every CLOSED bead
# labelled product-goal (the label the rest of the Factory already uses to
# mean "delivery/goal outcome") in the city and
# in the SayMyName rigs, and for each one missing a proof field
# (lib/factory_delivery_proof.py holds the exact rules):
#
#   - if the bead already names a GitHub repo + PR number, independently
#     verify with `gh pr view` — the same check bin/deliver-close performs —
#     and if it is genuinely merged, backfill all six fields from that
#     verified evidence. Never from a guess: a PR that does not verify as
#     merged is reported, not papered over.
#   - otherwise (no repo/PR recorded at all, or `gh` disagrees with what is
#     recorded), flag the bead exactly once by writing
#     gc.delivery_proof_flagged_at / gc.delivery_proof_missing on the bead
#     itself, and page the Mayor once. A bead that already carries that flag
#     is reported again (so it never silently disappears) but the flag
#     itself is not rewritten and the Mayor is not paged again, so a human
#     or the Mayor sees it once, not on every guard run.
#
# ADR-0023 bullet 5 asks for an orphan-label repair here too (a product-goal
# label with no door-written state gets the label stripped mechanically).
# That is deliberately NOT done: nothing writes the product-goal label
# through a door yet (bullet 3 is aspirational), so "missing proof" cannot
# mechanically distinguish a genuine mislabel from a real delivery bead
# closed the wrong way (the actual af-7700 shape above) -- stripping the
# label on that signal alone would erase real incidents, not just orphans.
# Until a door writes the label, this guard stays in the safe half of
# bullet 5: it pages the Mayor once for a human/Mayor call instead of
# guessing.
#
# It also scans the adjacent gap (af-1xz1g): a CLOSED bead of any label
# carrying gc.outcome=pass or gc.work_outcome=shipped plus its own
# gc.pr_url, that does not already carry the six verified proof fields --
# this is the af-x45xw shape, closed gc.outcome=pass on 2026-09-18 while its
# own PR #114 was still OPEN and CI was red, a raw close that bypassed
# bin/deliver-close entirely and carried no `product-goal` label so the
# check above never saw it. Each such bead's named PR is independently
# verified with `gh pr view`; one that does not verify as merged is flagged
# exactly once, the same way. Reopening stays a human/Mayor call, never
# automatic.
#
# It also reconciles a third, distinct gap (af-gpq0y): a workflow bead (e.g.
# a build-basic root) can close with full verified delivery proof while the
# *originating* execution bead a convoy tracks -- the one the Mayor actually
# created -- never receives it and stays open forever, because build-basic's
# graph.v2 contract closes its own workflow-root bead instead of the
# convoy's tracked child (unlike mol-do-work/mol-polecat-commit, which close
# that child directly). Any closed bead carrying gc.delivery_status=merged is
# followed back to its execution bead via `gc.var.convoy_id` (through the
# convoy) or a direct `gc.authorized_by` bead id; if that execution bead is
# still open, its six proof fields are copied over, it is closed, and its
# convoy (when found via gc.var.convoy_id) is closed alongside it. No new
# GitHub verification happens here -- the workflow bead's own proof fields
# already are that verification.
#
# --check-only reports without writing anything (no repair, no flag).
#
# Usage: factory-delivery-guard [--check-only]
set -uo pipefail

PROGRAM_NAME="factory-delivery-guard"
ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
GC_BIN="${GC_BIN:-gc}"
GH_BIN="${GH_BIN:-gh}"
# Host-local cache of PRs gh already confirmed merged ("<repo>#<pr>\t<head>\t<merge>").
MERGED_CACHE="${FACTORY_DELIVERY_GUARD_MERGED_CACHE:-$ROOT/.gc/runtime/delivery-guard-merged-prs.tsv}"
PY_BIN="${PYTHON_BIN:-python3}"
LIB_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib" 2>/dev/null && pwd -P)"
CHECK_ONLY=0
# shellcheck source=lib/project_registry.sh
. "$LIB_DIR/project_registry.sh"
RIGS=()
while IFS= read -r rig_name; do RIGS+=("$rig_name"); done < <(project_registry_rig_names "$ROOT/config/projects")

while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) CHECK_ONLY=1 ;;
    -h|--help)
      sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "$PROGRAM_NAME: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

require_command() {
  command -v "$1" >/dev/null 2>&1 || { echo "$PROGRAM_NAME: required command unavailable: $1" >&2; exit 2; }
}
require_command "$GC_BIN"
require_command "$GH_BIN"
require_command "$PY_BIN"
require_command jq
[ -f "$LIB_DIR/factory_delivery_proof.py" ] || { echo "$PROGRAM_NAME: lib/factory_delivery_proof.py not found" >&2; exit 2; }

PROBLEMS=(); ACTIONS=(); STATUS=0
CHECKED=0; INCOMPLETE=0

say()  { printf '%s\n' "$*"; }
bad()  { PROBLEMS+=("$1"); STATUS=1; }
did()  { ACTIONS+=("$1"); say "  REPAIRED: $1"; }

page_mayor_once() {  # id label why
  local id=$1 label=$2 why=$3
  (cd "$ROOT" && "$GC_BIN" mail send mayor --notify \
    -s "Delivery proof incomplete: $id" \
    -m "ACTION: factory-delivery-guard flagged $id ($label) — delivery proof incomplete and unverifiable
STATE: $why
EVIDENCE: gc bd show $id
NEXT: decide whether $id is a genuine delivery bead closed the wrong way (repair via bin/deliver-close's evidence) or a mislabel (remove the product-goal label by hand)" \
    >/dev/null 2>&1)
}

# gc_for <rig>: prints the gc invocation prefix for the city (rig="") or a rig.
gc_for() {
  if [ -z "$1" ]; then printf '%s bd' "$GC_BIN"; else printf '%s bd --rig %s' "$GC_BIN" "$1"; fi
}

list_closed_delivery_beads() {  # $1 = rig name, or "" for the city root
  local rig=$1 out
  if [ -z "$rig" ]; then
    out=$(cd "$ROOT" && "$GC_BIN" bd list --all --status closed --label-any product-goal --limit 0 --json 2>/dev/null)
  else
    out=$(cd "$ROOT" && "$GC_BIN" bd --rig "$rig" list --all --status closed --label-any product-goal --limit 0 --json 2>/dev/null)
  fi
  jq -e . >/dev/null 2>&1 <<<"$out" && printf '%s' "$out" || printf '[]'
}

# verify_pr_merged repo pr -> prints "<pr_head>\t<merge_commit>" and returns 0
# only when gh independently confirms the PR is genuinely merged. Mirrors
# bin/deliver-close's own verification exactly, on purpose: this is the same
# proof deliver-close would have required at close time.
verify_pr_merged() {
  local repo=$1 pr=$2 response hit shas
  # A merge is terminal: once gh confirmed it, never ask again. Every guard
  # tick used to re-ask for every claimed-shipped bead (~110 s on
  # 2026-09-26, most of factory-guard's 180 s budget). Written only outside
  # --check-only; never turned into a Beads write.
  hit=$(awk -F'\t' -v k="$repo#$pr" '$1 == k {print $2 "\t" $3; exit}' "$MERGED_CACHE" 2>/dev/null)
  if [ -n "$hit" ]; then printf '%s\n' "$hit"; return 0; fi
  response=$("$GH_BIN" pr view "$pr" --repo "$repo" \
    --json number,state,mergedAt,mergeCommit,headRefOid,url 2>/dev/null) || return 1
  jq -e . >/dev/null 2>&1 <<<"$response" || return 1
  jq -e --argjson number "$pr" '
    .number == $number and
    .state == "MERGED" and
    (.mergedAt | type == "string" and length > 0) and
    (.headRefOid | type == "string" and test("^[0-9a-f]{40}$")) and
    (.mergeCommit.oid | type == "string" and test("^[0-9a-f]{40}$"))
  ' >/dev/null <<<"$response" || return 1
  shas=$(jq -r '[.headRefOid, .mergeCommit.oid] | @tsv' <<<"$response")
  if [ "$CHECK_ONLY" != "1" ]; then
    { mkdir -p "$(dirname "$MERGED_CACHE")" && printf '%s\t%s\n' "$repo#$pr" "$shas" >> "$MERGED_CACHE"; } 2>/dev/null || true
  fi
  printf '%s\n' "$shas"
}

handle_unverifiable() {  # id label rig missing already_flagged why
  local id=$1 label=$2 rig=$3 missing=$4 flagged=$5 why=$6
  if [ "$flagged" = "1" ]; then
    say "  · $id ($label) still missing: $missing ($why) — already flagged, awaiting a human"
    bad "$id ($label) delivery proof incomplete and unverifiable ($why); already flagged, unresolved"
    return
  fi
  bad "$id ($label) delivery proof incomplete and unverifiable ($why); missing: $missing"
  if [ "$CHECK_ONLY" != "1" ]; then
    if (cd "$ROOT" && $(gc_for "$rig") update "$id" \
          --set-metadata "gc.delivery_proof_flagged_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
          --set-metadata "gc.delivery_proof_missing=$missing" >/dev/null 2>&1); then
      did "flagged $id ($label) once for human review ($why)"
      page_mayor_once "$id" "$label" "$why (missing: $missing)"
    else
      bad "$id ($label) could not be flagged — the Beads write itself failed"
    fi
  fi
}

list_closed_claimed_shipped_beads() {  # $1 = rig name, or "" for the city root
  local rig=$1 out
  if [ -z "$rig" ]; then
    out=$(cd "$ROOT" && "$GC_BIN" bd list --all --status closed --has-metadata-key gc.pr_url --limit 0 --json 2>/dev/null)
  else
    out=$(cd "$ROOT" && "$GC_BIN" bd --rig "$rig" list --all --status closed --has-metadata-key gc.pr_url --limit 0 --json 2>/dev/null)
  fi
  jq -e . >/dev/null 2>&1 <<<"$out" && printf '%s' "$out" || printf '[]'
}

# process_claimed_shipped_scope: the af-x45xw-shaped sibling check (af-1xz1g).
# Any closed bead (no label required) claiming gc.outcome=pass or
# gc.work_outcome=shipped with its own gc.pr_url, that lacks the six verified
# proof fields, gets its named PR independently checked. A bead that verifies
# merged needs nothing further; one that does not is flagged exactly once via
# the same handle_unverifiable path as the label-scoped check above.
process_claimed_shipped_scope() {  # rig label
  local rig=$1 label=$2 beads reports
  beads=$(list_closed_claimed_shipped_beads "$rig")
  reports=$("$PY_BIN" "$LIB_DIR/factory_delivery_proof.py" --mode claimed-shipped <<<"$beads")
  if [ -z "$reports" ]; then
    say "✓ claimed-shipped:$label — every closed bead claiming shipped verifies against its own PR"
    return
  fi
  local id repo pr flagged
  while IFS=$'\x1f' read -r id repo pr flagged; do
    [ -z "$id" ] && continue
    CHECKED=$((CHECKED + 1))
    say "  · $id ($label) claims shipped (gc.outcome=pass/gc.work_outcome=shipped) via $repo#$pr — verifying with gh"
    if verify_pr_merged "$repo" "$pr" >/dev/null; then
      say "    ✓ $repo#$pr verifies merged"
    else
      INCOMPLETE=$((INCOMPLETE + 1))
      handle_unverifiable "$id" "$label" "$rig" "gc.pr_url ($repo#$pr not verifiably merged)" "$flagged" \
        "closed claiming shipped but $repo#$pr is not verifiably merged"
    fi
  done <<<"$reports"
}

# convoy_target rig convoy_id -> id of the single child the convoy tracks, or
# empty if it has zero or more than one (never guess which one is "the" work).
convoy_target() {
  local rig=$1 convoy_id=$2 out
  if [ -z "$rig" ]; then
    out=$(cd "$ROOT" && "$GC_BIN" convoy status "$convoy_id" --json 2>/dev/null)
  else
    out=$(cd "$ROOT" && "$GC_BIN" convoy status "$convoy_id" --rig "$rig" --json 2>/dev/null)
  fi
  jq -r 'if (.children|length)==1 then .children[0].id else empty end' <<<"$out" 2>/dev/null
}

# scope_statuses rig -> {id: status} for every bead of that store, in ONE
# read. Looking each bead up with `bd show` cost ~1 s a call and ~64 calls a
# tick (2026-09-27), most of factory-guard's 180 s order budget.
scope_statuses() {
  local rig=$1
  (cd "$ROOT" && $(gc_for "$rig") list --all --limit 0 --json 2>/dev/null) \
    | jq -c 'if type=="array" then (map({(.id): .status}) | add // {}) else {} end' 2>/dev/null \
    || echo '{}'
}

# status_of statuses rig id -> status from the one-read map; falls back to a
# single `bd show` only when that read returned nothing at all.
status_of() {
  local statuses=$1 rig=$2 id=$3
  if [ "$statuses" = '{}' ] || [ -z "$statuses" ]; then bead_status "$rig" "$id"; return; fi
  jq -r --arg id "$id" '.[$id] // empty' <<<"$statuses"
}

# bead_status rig id -> the bead's stored status, or empty if it cannot be read.
bead_status() {
  local rig=$1 id=$2
  (cd "$ROOT" && $(gc_for "$rig") show "$id" --json 2>/dev/null) \
    | jq -r 'if type=="array" then .[0].status else .status end // empty' 2>/dev/null
}

# process_convoy_delivery_scope: af-gpq0y. A closed workflow bead (e.g. a
# build-basic root such as smb-44tt) can carry full verified delivery proof
# (gc.delivery_status=merged, gc.pr_number, gc.merge_commit, ...) while the
# *originating* execution bead -- the one the Mayor created and a convoy
# tracks (smb-a6bm) -- never receives any of it and stays open indefinitely.
# Root cause: build-basic's graph.v2 contract creates its own workflow-root
# bead as the unit it closes with delivery proof, instead of closing the
# convoy's tracked child directly the way mol-do-work/mol-polecat-commit do
# on every other rig. The link back to the execution bead is either
# `gc.var.convoy_id` (build-basic: the input convoy id, whose single tracked
# child is the execution bead) or a direct `gc.authorized_by` execution-bead
# id (other workflow shapes, e.g. smb-jz34 -> smb-fpbj). This never
# re-verifies against GitHub: the workflow bead's own six proof fields
# already are that verification (deliver-close or the graph.v2 dispatcher
# wrote them), so this only copies them onto the still-open execution bead
# (and closes its convoy alongside it, when resolved via gc.var.convoy_id).
process_convoy_delivery_scope() {  # rig label
  local rig=$1 label=$2 delivered row found=0
  delivered=$(cd "$ROOT" && $(gc_for "$rig") list --all --status closed \
    --has-metadata-key gc.delivery_status --metadata-field gc.delivery_status=merged \
    --limit 0 --json 2>/dev/null)
  jq -e . >/dev/null 2>&1 <<<"$delivered" || delivered='[]'
  local statuses='{}'
  [ "$(jq length <<<"$delivered")" = "0" ] || statuses=$(scope_statuses "$rig")

  while IFS= read -r row; do
    [ -z "$row" ] && continue
    local id convoy_id authorized_by exec_id exec_status
    id=$(jq -r '.id' <<<"$row")
    convoy_id=$(jq -r '.metadata["gc.var.convoy_id"] // empty' <<<"$row")
    authorized_by=$(jq -r '.metadata["gc.authorized_by"] // empty' <<<"$row")
    exec_id=""
    if [ -n "$convoy_id" ]; then
      exec_id=$(convoy_target "$rig" "$convoy_id")
    elif [[ $authorized_by =~ ^[a-zA-Z][a-zA-Z0-9]*-[a-zA-Z0-9]+$ ]]; then
      [ -n "$(status_of "$statuses" "$rig" "$authorized_by")" ] && exec_id=$authorized_by
    fi
    [ -n "$exec_id" ] || continue
    [ "$exec_id" != "$id" ] || continue

    exec_status=$(status_of "$statuses" "$rig" "$exec_id")
    [ -n "$exec_status" ] || continue          # lookup failed -- nothing safe to do
    [ "$exec_status" != "closed" ] || continue # already fine

    found=1
    CHECKED=$((CHECKED + 1))
    local ghr prn prh mc wo
    ghr=$(jq -r '.metadata["gc.github_repo"] // empty' <<<"$row")
    prn=$(jq -r '.metadata["gc.pr_number"] // empty' <<<"$row")
    prh=$(jq -r '.metadata["gc.pr_head"] // empty' <<<"$row")
    mc=$(jq -r '.metadata["gc.merge_commit"] // empty' <<<"$row")
    wo=$(jq -r '.metadata["gc.work_outcome"] // "shipped"' <<<"$row")
    say "  · $id ($label) delivered (merged $ghr#$prn) but its execution bead $exec_id is still $exec_status -- reconciling"
    if [ "$CHECK_ONLY" = "1" ]; then
      bad "$id ($label) delivered but execution bead $exec_id was never closed -- run factory-delivery-guard to reconcile"
      continue
    fi
    if (cd "$ROOT" && $(gc_for "$rig") update "$exec_id" \
          --set-metadata "gc.delivery_status=merged" \
          --set-metadata "gc.work_outcome=$wo" \
          --set-metadata "gc.github_repo=$ghr" \
          --set-metadata "gc.pr_number=$prn" \
          --set-metadata "gc.pr_head=$prh" \
          --set-metadata "gc.merge_commit=$mc" \
          --set-metadata "gc.delivered_via=$id" \
          --status=closed \
          --notes "Closed by factory-delivery-guard: delivered via $id ($ghr#$prn, $mc)." >/dev/null 2>&1); then
      did "$exec_id ($label) closed -- delivery proof copied from workflow bead $id ($ghr#$prn)"
      INCOMPLETE=$((INCOMPLETE + 1))
      if [ -n "$convoy_id" ]; then
        local convoy_stat
        convoy_stat=$(status_of "$statuses" "$rig" "$convoy_id")
        if [ -n "$convoy_stat" ] && [ "$convoy_stat" != "closed" ]; then
          if (cd "$ROOT" && $(gc_for "$rig") update "$convoy_id" --status=closed \
                --notes "Closed by factory-delivery-guard: tracked bead $exec_id delivered via $id." >/dev/null 2>&1); then
            did "$convoy_id ($label) input convoy closed alongside $exec_id"
          fi
        fi
      fi
    else
      bad "$id ($label) delivered but closing its execution bead $exec_id failed -- the Beads write itself failed"
    fi
  done < <(jq -c '.[]' <<<"$delivered")
  [ "$found" = "1" ] || say "✓ convoy-delivery:$label — no delivered workflow bead has an open execution bead behind it"
}

process_scope() {  # rig label
  local rig=$1 label=$2 beads incomplete
  beads=$(list_closed_delivery_beads "$rig")
  incomplete=$("$PY_BIN" "$LIB_DIR/factory_delivery_proof.py" <<<"$beads")
  if [ -z "$incomplete" ]; then
    say "✓ delivery-proof:$label — every closed delivery bead is fully documented"
    return
  fi
  local id missing repo pr flagged
  # 0x1F (unit separator), not a tab: a tab is bash read's own IFS-whitespace
  # character and silently collapses adjacent delimiters, dropping exactly
  # the empty repo/pr-number fields this loop depends on distinguishing.
  while IFS=$'\x1f' read -r id missing repo pr flagged; do
    [ -z "$id" ] && continue
    CHECKED=$((CHECKED + 1))
    INCOMPLETE=$((INCOMPLETE + 1))
    if [ -n "$repo" ] && [ -n "$pr" ]; then
      say "  · $id ($label) missing: $missing — repo/PR recorded ($repo#$pr), verifying with gh"
      local shas pr_head merge_commit
      if shas=$(verify_pr_merged "$repo" "$pr"); then
        IFS=$'\t' read -r pr_head merge_commit <<<"$shas"
        if [ "$CHECK_ONLY" = "1" ]; then
          bad "$id ($label) closed without full delivery proof, but $repo#$pr verifies merged — run factory-delivery-guard to backfill"
        elif (cd "$ROOT" && $(gc_for "$rig") update "$id" \
                --set-metadata "gc.delivery_status=merged" \
                --set-metadata "gc.work_outcome=shipped" \
                --set-metadata "gc.github_repo=$repo" \
                --set-metadata "gc.pr_number=$pr" \
                --set-metadata "gc.pr_head=$pr_head" \
                --set-metadata "gc.merge_commit=$merge_commit" \
                --unset-metadata "gc.delivery_proof_flagged_at" \
                --unset-metadata "gc.delivery_proof_missing" >/dev/null 2>&1); then
          did "$id ($label) backfilled all six proof fields from verified $repo#$pr ($merge_commit)"
        else
          bad "$id ($label) verified merged via $repo#$pr but the Beads write failed — re-run"
        fi
      else
        handle_unverifiable "$id" "$label" "$rig" "$missing" "$flagged" "$repo#$pr is not verifiably merged"
      fi
    else
      handle_unverifiable "$id" "$label" "$rig" "$missing" "$flagged" "no verifiable GitHub repo/PR recorded on the bead"
    fi
  done <<<"$incomplete"
}

process_scope "" "city"
process_claimed_shipped_scope "" "city"
process_convoy_delivery_scope "" "city"
for rig in "${RIGS[@]}"; do
  [ -d "$ROOT/rigs/$rig" ] || continue
  process_scope "$rig" "$rig"
  process_claimed_shipped_scope "$rig" "$rig"
  process_convoy_delivery_scope "$rig" "$rig"
done

say ""
if [ "${#ACTIONS[@]}" -gt 0 ]; then say "repaired ${#ACTIONS[@]}:"; printf '  - %s\n' "${ACTIONS[@]}"; fi
if [ "${#PROBLEMS[@]}" -gt 0 ]; then
  say "UNRESOLVED ${#PROBLEMS[@]}:"; printf '  ! %s\n' "${PROBLEMS[@]}"
elif [ "$INCOMPLETE" -gt 0 ]; then
  say "healthy — $INCOMPLETE incomplete delivery bead(s) seen this run, all repaired"
else
  say "healthy — no closed delivery bead is missing a proof field"
fi
exit "$STATUS"
