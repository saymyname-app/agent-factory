#!/usr/bin/env bash
# pr-autopilot — deterministic (L0, zero-token) merge actor for the protected rigs in
# lib/protected_rigs.sh (the SayMyName rigs' dev, the Factory repo's main).
#
# Closes the delivery loop without spending a single model token:
#   1. ARM     every open non-draft PR targeting a rig's protected branch with GitHub
#              auto-merge (squash). GitHub then merges it itself the moment the
#              required status check goes green. Nothing polls, nothing watches.
#              When GitHub does not (PR #479, 2026-10-09: armed, green on its
#              head, CLEAN, open 17 minutes), the PR is merged here by the
#              direct path once it has been green for a short delay (af-n8gft2).
#   2. FINALIZE merged PRs through bin/deliver-close only after the configured
#              required workflow succeeded on the exact PR head. The door
#              writes merge_result/merged_sha/merged_target + CI proof and
#              closes the work bead atomically.
#   3. FLAG    PRs whose required checks failed, as a P1 bead, so a red build is
#              visible as work instead of silently sitting open.
#   4. HOLD    PRs whose migrations are not undoable inside the release
#              (bin/reversibility-check, ADR-0019): never armed, disarmed if
#              already armed, labelled and explained once on the PR. A change
#              declared irreversible is escalated to the Mayor (test 4 of
#              ADR-0016) and only ever merged by a human.
#
# Production safety: PRs targeting anything other than the rig's protected
# branch (lib/protected_rigs.sh) are never armed. For the product rigs that is
# dev, so their dev -> main promotion stays a human decision by construction;
# the Factory repo's protected branch is main itself, which is armed.
#
# Outside authors (af-996mmd): a pull request from a fork, or whose author is
# not one of the operator's own GitHub accounts (config/operator.toml,
# `github_logins`), is never armed, merged, retried, labelled or turned into
# a bead. It is left to a human.
#
# Usage: pr-autopilot [--dry-run] [--verbose]
set -uo pipefail

FACTORY="${FACTORY_ROOT:-/home/benja/agent-factory}"
DRY_RUN=0
VERBOSE=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --verbose|-v) VERBOSE=1 ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

# rig_dir | repo | protected branch | required GitHub Actions workflow
#
# af-09hxz: this table is the same one bin/factory-do-work-workspace consults
# to decide when a do-work dispatch must be isolated in a worktree instead of
# committing in place, so it lives in lib/protected_rigs.sh and both scripts
# source it from there. Add a rig once, and it is protected everywhere.
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/lib/protected_rigs.sh"
RIGS=("${PROTECTED_RIGS[@]}")
DELIVER_CLOSE_BIN="${DELIVER_CLOSE_BIN:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/deliver-close}"
DELIVERY_PROOF_BIN="${DELIVERY_PROOF_BIN:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib" && pwd -P)/factory_delivery_proof.py}"
ESCALATION_DOOR_BIN="${ESCALATION_DOOR_BIN:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/escalation-door}"
# The test-4 escalation message below names the operator from config, not a
# hardcoded string (O14, F23, same pattern as bin/escalation-door) --
# config/operator.toml's `name`, defaulting to "Benjamin" if the file is
# missing or unset.
OPERATOR_NAME="${GC_OPERATOR_NAME:-$(sed -n 's/^name[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "${OPERATOR_CONFIG_FILE:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/config/operator.toml}" 2>/dev/null | head -n1)}"
OPERATOR_NAME="${OPERATOR_NAME:-Benjamin}"
# af-996mmd: the closed list of GitHub accounts whose pull requests this
# script acts on, comma-separated, from the same file. Every pull request the
# Factory opens is the operator's (agents push with the operator's token). An
# empty list arms nothing (fail closed): on a public repository, anyone can
# open a pull request and rewrite the workflow that reports the required check.
PR_AUTHORS="${GC_PR_AUTHORS:-$(sed -n 's/^github_logins[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "${OPERATOR_CONFIG_FILE:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/config/operator.toml}" 2>/dev/null | head -n1)}"

# af-37h58 (P03): RIGS' 4th field (required_ci) is the required GitHub
# Actions *workflow* name (e.g. "Factory CI") -- retry_ci_failure and
# deliver-close's --required-workflow both need exactly that, to match
# `gh run list`'s workflow-run `.name`. It is NOT the ruleset's required
# *status check* name actually reported on a PR (the workflow's job name,
# e.g. "Tests") -- arming/holding below must gate on that instead, or an
# unrelated failing check (or a same-named-workflow coincidence) can hold a
# healthy PR, and a genuinely red required check can be missed entirely.
# Each project file names both (config/projects/*.toml); read the check
# name straight from there via project_registry's existing optional-field
# reader instead of widening PROTECTED_RIGS' row shape, which
# bin/factory-guard, bin/factory-delivery-guard, bin/deliver-close and
# bin/dispatch-door all also consume and do not need this field.
CONFIG_PROJECTS_DIR="${PROTECTED_RIGS_CONFIG_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/config/projects}"
declare -A REQUIRED_CHECK_FOR_REPO
while IFS='|' read -r _pc_rig_dir _pc_repo _pc_branch _pc_ci _pc_name; do
  [ -n "$_pc_repo" ] || continue
  REQUIRED_CHECK_FOR_REPO["$_pc_repo"]=$(project_registry_field "$CONFIG_PROJECTS_DIR" "$_pc_name" "required_check")
done < <(project_registry_rows "$CONFIG_PROJECTS_DIR")
unset _pc_rig_dir _pc_repo _pc_branch _pc_ci _pc_name

# The live ruleset is the ground truth for which check name actually gates
# a merge; config/projects/*.toml just declares what pr-autopilot believes
# that name is. Read-only `gh api` on the "rules for a branch" endpoint
# (a fine-grained PAT can read this -- facts sheet 2026-09-29 §3) proves the
# two agree, once per rig per tick, and never mutates anything.
verify_required_check_live() {  # repo branch required-check -> 0 ok, 1 mismatch, 2 unknown
  local repo=$1 branch=$2 required=$3 actual
  actual=$(bounded "$AP_READ_CAP" gh api "repos/$repo/rules/branches/$branch" --jq '
    [.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context]
    | unique' 2>/dev/null) || return 2
  [ -n "$actual" ] || return 2
  printf '%s' "$actual" | jq -e --arg c "$required" 'index($c) != null' >/dev/null 2>&1 && return 0
  return 1
}

log()  { printf '%s\n' "$*"; }
vlog() { [ "$VERBOSE" = "1" ] && printf '  %s\n' "$*"; return 0; }
run()  { if [ "$DRY_RUN" = "1" ]; then log "  DRY-RUN: $*"; return 0; fi; bounded "$AP_WRITE_CAP" "$@"; }

# Labels go through the REST issues endpoint, never `gh pr edit`: the host's
# gh (2.45, Ubuntu package) asks GitHub for the retired Projects (classic)
# field on every `pr edit`, which fails before the label is touched. The
# failure was discarded, so a hold whose "already explained" proof is its
# label re-explained itself every pass (PR #356: one comment per 3 min).
add_label() {  # repo num label
  run gh api -X POST "repos/$1/issues/$2/labels" -f "labels[]=$3" >/dev/null 2>&1 \
    || { log "  PR #$2: could not add label '$3' -> retried next pass"; return 1; }
}
remove_label() {  # repo num label
  run gh api -X DELETE "repos/$1/issues/$2/labels/$3" >/dev/null 2>&1 \
    || { log "  PR #$2: could not remove label '$3' -> retried next pass"; return 1; }
}

# A hold is explained once even if its label does not stick: the label is the
# cheap "already explained" check, this hidden marker in the comment is the
# proof. -> 0 posted now, 2 already on the PR, 1 unknown (read failed: hold,
# post nothing, retry next pass).
explain_once() {  # repo num marker body-file
  local repo=$1 num=$2 marker="<!-- pr-autopilot:$3 -->" body=$4 comments rc
  comments=$(bounded "$AP_READ_CAP" gh pr view "$num" --repo "$repo" --json comments --jq '.comments[].body' 2>/dev/null); rc=$?
  if [ "$rc" != 0 ]; then
    log "  PR #$num: could not read PR comments -> not explaining this pass (retried next tick)"
    return 1
  fi
  if grep -qF "$marker" <<<"$comments"; then
    vlog "PR #$num: hold already explained on the PR (label missing, re-adding)"
    return 2
  fi
  printf '\n%s\n' "$marker" >> "$body"
  run gh pr comment "$num" --repo "$repo" --body-file "$body" >/dev/null 2>&1
  return 0
}

finalize_delivery() {  # rig-path bead repo pr required-workflow
  local rig_path=$1 bead=$2 repo=$3 pr=$4 workflow=$5
  if [ "$DRY_RUN" = "1" ]; then
    log "  DRY-RUN: $DELIVER_CLOSE_BIN $bead --repo $repo --pr $pr --required-workflow $workflow"
    return 0
  fi
  (
    cd "$rig_path" || exit 1
    bounded "$AP_DOOR_CAP" "$DELIVER_CLOSE_BIN" "$bead" --repo "$repo" --pr "$pr" \
      --required-workflow "$workflow" \
      --reason "Merged PR #$pr after required workflow '$workflow' succeeded on the exact PR head."
  )
}

# Bring a BEHIND PR up to date with its base through the REST endpoint
# (PUT /repos/{repo}/pulls/{num}/update-branch), which every gh version can
# call via `gh api` -- unlike `gh pr update-branch`, absent from gh 2.45.
# expected_head_sha makes GitHub refuse (422) if the head moved since this
# tick read it, instead of updating a branch we did not look at. On failure
# the first stderr line is logged, never discarded. A single PR's failed
# update is NOT counted in ERRORS: it is retried next tick, and a refused
# update is made visible by flag_stuck (label on the first refusal, bead + PR
# comment on the next), so one transient 422/5xx must not turn the whole
# order into order.failed every 3 minutes. UPDATE_BRANCH_ERR carries GitHub's
# answer to a refusal; it stays empty when the call was cut (unknown, never a
# reason to flag).
UPDATE_BRANCH_ERR=""
update_branch() {  # repo num head_sha -> 0 requested, 1 failed (logged)
  local repo=$1 num=$2 sha=$3 err rc
  UPDATE_BRANCH_ERR=""
  local -a args=(api -X PUT "repos/$repo/pulls/$num/update-branch")
  [ -n "$sha" ] && args+=(-f "expected_head_sha=$sha")
  if [ "$DRY_RUN" = "1" ]; then log "  DRY-RUN: gh ${args[*]}"; return 0; fi
  err=$(bounded "$AP_WRITE_CAP" gh "${args[@]}" 2>&1 >/dev/null); rc=$?
  [ "$rc" = 0 ] && return 0
  if timed_out "$rc"; then log "    branch update timed out -- outcome unknown, re-read next tick"; return 1; fi
  err=$(printf '%s
' "$err" | sed -n '/[^[:space:]]/{p;q}')
  UPDATE_BRANCH_ERR=${err:-gh exited non-zero with no stderr}
  log "    branch update failed: $UPDATE_BRANCH_ERR"
  return 1
}

ARMED=0; RECONCILED=0; FLAGGED=0; SKIPPED=0; ERRORS=0; HELD=0
# af-s6lef (P04): a BEHIND PR is never armed for auto-merge (before P05 makes
# the ruleset strict, GitHub would otherwise merge it without ever picking up
# the base's latest required check), and at most one BEHIND PR per repository
# is updated per tick. A failed branch update is only logged here -- nothing
# marks the attempt, so the same PR (still BEHIND) is naturally retried on the
# next tick. It goes through the REST endpoint (update_branch below), never
# `gh pr update-branch`: the installed gh (2.45) has no such subcommand, and
# calling it failed every BEHIND tick silently (its stderr was discarded)
# until 2026-09-29.
#
# af-31t0y8: one queue head per repository.
# Intent (Benjamin, his words, 2026-10-11): « là ya plein de CI qui sont
# refaites car la PR n'est plus à jour, il faut eviter ca structurellement
# non ? »
# Mechanism (agent interpretation): a BEHIND PR is brought up to date only
# when no other PR of the same repository is the queue head, i.e. already up
# to date with its required check waiting, running, or green and about to
# merge. Updating one BEHIND PR per tick put one run in the queue per PR,
# and each merge made every other run stale (40 runs for 9 merges on
# 2026-10-11). The head is chosen among the BEHIND PRs once the whole list
# was read: the oldest whose last required run is not red, else the oldest.
# A head that goes red (after its single retry) or conflicts stops being the
# head, so the next BEHIND PR takes over on the same tick. It does not mean
# the "up to date before merge" rule is relaxed. Known limit: a waiting PR
# meets the recent base only at its turn, so a red caused by the combination
# shows late and costs one run.
QUEUE_HEAD=""; PRS_UNSEEN=0
BEHIND_NUMS=(); BEHIND_SHAS=(); BEHIND_CHECKS=(); BEHIND_LABELS=()
queue_head() {  # mergeStateStatus checks labels -> 0 when this PR holds the queue
  case "$1" in BEHIND|DIRTY) return 1 ;; esac
  case "$2" in PENDING|OK|NONE) ;; *) return 1 ;; esac
  # Marked stuck (blocked with nothing pending, or no check ever reported, on
  # an earlier pass): it will not merge by itself, so it must not hold the
  # queue for ever.
  case " ${3//,/ } " in *" $STUCK_LABEL "*) return 1 ;; esac
  return 0
}
TMPDIR_AP=$(mktemp -d); trap 'rm -rf "$TMPDIR_AP"' EXIT

# --- run budget (2026-09-30, same shape as bin/factory-guard's, PR #283) ----
# O3: the order (orders/pr-autopilot.toml) hard-kills the whole run at 120 s
# with no trace at all ("context deadline exceeded" -> order.failed). A
# deadline checked once per repo did not prevent it: on 2026-09-29 23:58 and
# 2026-09-30 00:05 (Paris), with many PRs open during an overnight delivery,
# one repo's PR loop -- or one hung gh/gc call inside it -- ran past 120 s
# between two checks. So now:
#  - every gh/gc call and sub-door goes through bounded() (its own cap, never
#    past the hard stop). A cut call is "unknown": never a green answer, never
#    a reason to arm, merge, flag, reject or close -- the PR is re-read on the
#    next tick (3 min later);
#  - no repo and no PR is started once the budget is spent; each one left is
#    logged "not checked (time budget exhausted)" and the run exits 0 with its
#    report. Real errors (ERRORS) still fail the order exactly as before;
#  - a run past PR_AUTOPILOT_SLOW_SECONDS, or one that skipped or cut anything,
#    prints per-repo timings and the host loadavg, to tell a saturated host
#    (every repo slower) from one hung call (a "timed out" line).
# PR_AUTOPILOT_TICK_DEADLINE_SECONDS is the former name, still honoured.
AP_BUDGET="${PR_AUTOPILOT_BUDGET_SECONDS:-${PR_AUTOPILOT_TICK_DEADLINE_SECONDS:-90}}"  # nothing new starts after this
AP_GRACE="${PR_AUTOPILOT_GRACE_SECONDS:-15}"   # budget+grace (+5 s kill) stays under the order's 120 s
AP_SLOW="${PR_AUTOPILOT_SLOW_SECONDS:-60}"     # print timings past this
for _v in "$AP_BUDGET" "$AP_GRACE" "$AP_SLOW"; do
  case "$_v" in *[!0-9]*|'') log "invalid pr-autopilot time budget: '$_v'"; exit 2 ;; esac
done
AP_HARD=$((AP_BUDGET + AP_GRACE))              # no bounded call outlives this
AP_READ_CAP=20; AP_WRITE_CAP=30; AP_DOOR_CAP=60
AP_TMO="$TMPDIR_AP/timeouts"; : > "$AP_TMO"
AP_REPO="-"; AP_REPO_T0=0; AP_TIMINGS=(); AP_NOT_CHECKED=()

timed_out()   { [ "$1" = 124 ] || [ "$1" = 137 ]; }
over_budget() { [ "$SECONDS" -ge "$AP_BUDGET" ]; }
not_checked() {
  AP_NOT_CHECKED+=("$1")
  log "  $1 — not checked (time budget exhausted: ${SECONDS}s of ${AP_BUDGET}s), retried next tick"
}

# bounded <cap-seconds> <cmd...>: timeout(1) capped by what is left before the
# hard stop. A cut call returns 124/137 and is logged for the timing report
# (from subshells and pipelines too: it is a file); callers treat it as unknown.
bounded() {
  local cap=$1 left=$((AP_HARD - SECONDS)) rc; shift
  [ "$left" -lt 1 ] && left=1
  [ "$cap" -gt "$left" ] && cap=$left
  timeout -k 5 "$cap" "$@"; rc=$?
  timed_out "$rc" && printf '%s: %.80s — cut at %ss\n' "$AP_REPO" "${*:1:4}" "$cap" >> "$AP_TMO"
  return "$rc"
}
# For a pipeline or command substitution whose exit status is not bounded's:
# mark=$(tmo_mark) before, cut_since "$mark" after.
tmo_mark()  { wc -l < "$AP_TMO"; }
cut_since() { [ "$(wc -l < "$AP_TMO")" -gt "$1" ]; }
repo_done() {
  [ "$AP_REPO" != "-" ] && AP_TIMINGS+=("$AP_REPO $((SECONDS - AP_REPO_T0))s")
  AP_REPO="-"
}

# af-i3k3f (B02): PR #209's fix made the RECONCILE loop re-verify every
# already-terminal merged PR with a live `gc bd show` before trusting the
# once-per-tick snapshot -- correct, but paid on EVERY PR in the last-30-
# merged window, EVERY tick, forever, growing with the rig's own history. A
# live measurement on 2026-09-24 showed one full pr-autopilot tick (three
# repos) taking 100-107s against this same order's 100s soft / 120s hard
# (SIGKILL, no trace) budget -- almost entirely spent inside agent-factory's
# own already-proven-PR re-verification. A merged PR's bead, once actually
# observed status=closed live, can never legitimately un-close through this
# path again, so that one live confirmation is durable: record it here and
# never re-pay the Dolt round trip for the same repo#PR on a later tick. New
# merges (not yet in the cache) still get the exact live re-check PR #209
# added -- this only removes the *repeated* cost, not the protection.
RECONCILE_CACHE="${PR_AUTOPILOT_RECONCILE_CACHE:-$FACTORY/.gc/pr-autopilot-reconciled-cache.tsv}"

# A reconciliation is not automatically a useful wake. When closed history
# became visible (af-6s0xy), old merges were backfilled correctly but each one
# also mailed the Mayor; then every merge of the last hour did, waited on or
# not (af-yzo8fo.3). Keep the durable backfill, and wake only when live work
# explicitly waits on the reconciled bead. The clock override keeps the
# direct-merge delay deterministic under test.
RECONCILE_NOW_EPOCH="${PR_AUTOPILOT_NOW_EPOCH:-$(date -u +%s)}"
case "$RECONCILE_NOW_EPOCH" in *[!0-9]*|'') log "invalid reconciliation clock"; exit 2 ;; esac

# af-n8gft2: armed is not merged. GitHub's auto-merge left PR #479 open for 17
# minutes on 2026-10-09 with its required check green on the exact head and
# mergeStateStatus CLEAN (PR #459: 13 minutes the day before); `gh pr merge
# --squash` then merged it at once. The cause is GitHub's and was not found in
# the ruleset or the PR's events (UPSTREAM). So an armed PR that is CLEAN and
# whose required check completed green at least this long ago is merged by the
# direct path below: same gate as auto-merge, which normally fires within two
# minutes. The age is read from the check's own completion time, so nothing
# is remembered between ticks; a check without one is never merged on a guess.
ARMED_MERGE_DELAY_SECONDS="${PR_AUTOPILOT_ARMED_MERGE_DELAY_SECONDS:-180}"
case "$ARMED_MERGE_DELAY_SECONDS" in *[!0-9]*|'') log "invalid armed merge delay"; exit 2 ;; esac

# The direct path: one squash request, pinned to the head this tick read (GitHub
# refuses it if the head moved). The caller has established that the required
# check is green and the state CLEAN, which is the gate auto-merge waits for.
# Hard rule (gastown land-and-deploy): never retry `gh pr merge` after a
# non-zero exit. It does NOT mean the merge failed: gh also returns non-zero
# when it merged fine but could not delete the local branch -- which is what
# happens whenever a leftover worktree still pins it. Ask the server what
# actually happened.
# Branch deletion is separate: a queued request is not a merge (af-x2ozgs).
# GitHub/native maintenance cleans branches only after confirmed merge.
direct_merge() {  # repo num head_sha
  local repo=$1 num=$2 sha=$3 rc d_rc final
  local -a args=(pr merge "$num" --repo "$repo" --squash)
  [ "$sha" != "unknown" ] && args+=(--match-head-commit "$sha")
  if [ "$DRY_RUN" = "1" ]; then log "  DRY-RUN: gh ${args[*]}"; return 0; fi
  bounded "$AP_WRITE_CAP" gh "${args[@]}" >/dev/null 2>&1; d_rc=$?
  # A successful request may only enqueue the PR; read GitHub before claiming merge.
  if [ "$d_rc" = 0 ]; then log "    merge requested (GitHub confirms completion)"; ARMED=$((ARMED+1)); return 0; fi
  final=$(bounded "$AP_READ_CAP" gh pr view "$num" --repo "$repo" --json state \
    --jq .state 2>/dev/null); rc=$?
  if [ "$final" = "MERGED" ]; then
    log "    merged (local cleanup failed; see factory-guard worktrees)"
    ARMED=$((ARMED+1))
  elif timed_out "$d_rc" || timed_out "$rc"; then
    log "    direct merge outcome unknown (a gh call timed out) -- re-read next tick"
  else
    log "    direct merge failed — left for a human"; ERRORS=$((ERRORS+1))
  fi
}

active_waiters_for() {  # bead -> comma-separated open/in_progress waiter ids
  local bead=$1
  printf '%s' "$RIG_ALL_BEADS_JSON" | jq -r --arg bead "$bead" '
    [.[]
      | select(.id != $bead)
      | select(.status == "open" or .status == "in_progress")
      | select(
          (.metadata["gc.waiting_on"] // "") == $bead
          or any(.dependencies[]?;
            ((.depends_on_id // .id // "") == $bead)
            and ((.type // .dependency_type // "") == "blocks")))
      | .id]
    | unique | join(",")
  ' 2>/dev/null
}

# ---------- reversibility gate (ADR-0019) ----------
# docs/DELIVERY.md calls Flyway changes GUARDED, yet this actor used to arm
# every green PR to dev, migrations included -- two DROP COLUMNs among them.
# The verdict is cached per PR head commit, so a PR is diffed once per push.
REV_CHECK="${REVERSIBILITY_CHECK_BIN:-$FACTORY/bin/reversibility-check}"
REV_CACHE="${REVERSIBILITY_CACHE:-$FACTORY/.gc/reversibility-cache.tsv}"
HOLD_LABELS="reversibility-declaration-needed irreversible-change"

reversibility_gate() {  # repo num sha labels armed -> 0 proceed, 1 hold
  local repo=$1 num=$2 sha=$3 labels=" $4 " armed=$5
  local key="$repo#$num@$sha" rc label color c_rc
  rc=$(grep -F "${key}"$'\t' "$REV_CACHE" 2>/dev/null | tail -1 | cut -f2)
  if [ -z "$rc" ]; then
    bounded "$AP_WRITE_CAP" "$REV_CHECK" --pr "$num" --repo "$repo" --json >/dev/null 2>&1; rc=$?
    if timed_out "$rc"; then   # unknown: never cached, never armed on
      log "  PR #$num: reversibility check timed out -> unknown, not arming this pass (retried next tick)"
      return 1
    fi
    if [ "$rc" != "2" ]; then
      mkdir -p "$(dirname "$REV_CACHE")"
      printf '%s\t%s\n' "$key" "$rc" >> "$REV_CACHE"
    fi
  fi
  case "$rc" in
    0)
      for l in $HOLD_LABELS; do
        case "$labels" in *" $l "*)
          log "  PR #$num: reversibility now ok -> removing '$l'"
          remove_label "$repo" "$num" "$l" ;;
        esac
      done
      return 0 ;;
    3|4)
      if [ "$rc" = "4" ]; then label=irreversible-change; color=B60205
      else label=reversibility-declaration-needed; color=FBCA04; fi
      if [ "$armed" != "null" ] && [ -n "$armed" ]; then
        log "  PR #$num: disarming auto-merge (reversibility)"
        run gh pr merge "$num" --repo "$repo" --disable-auto >/dev/null 2>&1
      fi
      case "$labels" in
        *" $label "*) vlog "PR #$num: held ($label), already explained on the PR" ;;
        *)
          log "  PR #$num: HELD -> $label"
          bounded "$AP_WRITE_CAP" "$REV_CHECK" --pr "$num" --repo "$repo" --comment > "$TMPDIR_AP/comment.md" 2>/dev/null; c_rc=$?
          if timed_out "$c_rc"; then
            # No label without its explanation: the next pass explains and labels it.
            log "    explanation timed out -> labelled and explained next pass"
            HELD=$((HELD+1)); return 1
          fi
          explain_once "$repo" "$num" "$label@$sha" "$TMPDIR_AP/comment.md"; c_rc=$?
          if [ "$c_rc" = 1 ]; then HELD=$((HELD+1)); return 1; fi
          run gh label create "$label" --repo "$repo" --color "$color" --force \
            --description "pr-autopilot reversibility gate (ADR-0019)" >/dev/null 2>&1
          add_label "$repo" "$num" "$label"
          if [ "$rc" = "4" ] && [ "$c_rc" = 0 ]; then
            run bash -c "cd '$FACTORY' && gc mail send mayor --from mayor --notify \
              --subject 'ESCALADE test 4 · PR #$num irréversible ($repo)' \
              --message 'Auteur : pr-autopilot (script déterministe), pas $OPERATOR_NAME. La PR https://github.com/$repo/pull/$num contient une migration déclarée irréversible. Test d escalade 4 (ADR-0016) : ne la fusionne pas toi-même ; mets ce sous-graphe en attente et soumets la décision à $OPERATOR_NAME avec la raison déclarée dans la migration. Le reste de la campagne continue.'" >/dev/null 2>&1
          fi ;;
      esac
      HELD=$((HELD+1))
      return 1 ;;
    *)
      log "  PR #$num: reversibility could not be checked -> not arming this pass (fail closed)"
      ERRORS=$((ERRORS+1))
      return 1 ;;
  esac
}

# ---------- project declaration gate (af-1epwsn) ----------
# A PR that adds or retires a project descriptor (config/project-descriptors/)
# is never merged by pr-autopilot itself, by exception to the "factory
# maintenance" auto-merge authorization (Spec af-oohx2x .101): declaring or
# retiring a project is $OPERATOR_NAME's decision, same as an irreversible
# migration. A PR that only modifies an existing descriptor, or touches none
# at all, is unaffected and follows the normal path.
PROJECT_DESCRIPTOR_DIR="config/project-descriptors/"
PROJECT_HOLD_LABEL="project-declaration-needs-benjamin"

project_descriptor_gate() {  # repo num sha labels armed -> 0 proceed, 1 hold
  local repo=$1 num=$2 labels=" $3 " armed=$4
  local rows rc added removed
  rows=$(bounded "$AP_READ_CAP" gh api "repos/$repo/pulls/$num/files" --paginate --jq \
    '.[] | select(.filename | startswith("'"$PROJECT_DESCRIPTOR_DIR"'")) | [.filename,.status] | @tsv' 2>/dev/null); rc=$?
  if timed_out "$rc"; then
    log "  PR #$num: project descriptor check timed out -> not arming this pass (retried next tick)"
    return 1
  fi
  added=$(printf '%s\n' "$rows" | awk -F'\t' '$2=="added"{print $1}')
  removed=$(printf '%s\n' "$rows" | awk -F'\t' '$2=="removed"{print $1}')
  if [ -z "$added" ] && [ -z "$removed" ]; then
    case "$labels" in *" $PROJECT_HOLD_LABEL "*)
      log "  PR #$num: no longer adds/removes a project descriptor -> removing '$PROJECT_HOLD_LABEL'"
      remove_label "$repo" "$num" "$PROJECT_HOLD_LABEL" ;;
    esac
    return 0
  fi
  if [ "$armed" != "null" ] && [ -n "$armed" ]; then
    log "  PR #$num: disarming auto-merge (project descriptor add/remove)"
    run gh pr merge "$num" --repo "$repo" --disable-auto >/dev/null 2>&1
  fi
  case "$labels" in
    *" $PROJECT_HOLD_LABEL "*) vlog "PR #$num: held ($PROJECT_HOLD_LABEL), already explained on the PR" ;;
    *)
      log "  PR #$num: HELD -> $PROJECT_HOLD_LABEL"
      {
        printf '### Décision projet requise\n\n'
        printf 'Cette PR ajoute ou retire un descripteur de projet (dossier `%s`) :\n\n' "$PROJECT_DESCRIPTOR_DIR"
        [ -n "$added" ] && printf '%s\n' "$added" | sed 's/^/- ajouté : `/; s/$/`/'
        [ -n "$removed" ] && printf '%s\n' "$removed" | sed 's/^/- retiré : `/; s/$/`/'
        printf '\nAjouter ou retirer un projet reste la décision de %s, par exception à la fusion automatique de la maintenance usine : pr-autopilot ne fusionne jamais cette PR seul. %s la fusionne lui-même une fois relue.\n' "$OPERATOR_NAME" "$OPERATOR_NAME"
      } > "$TMPDIR_AP/project-hold.md"
      if explain_once "$repo" "$num" "$PROJECT_HOLD_LABEL" "$TMPDIR_AP/project-hold.md" || [ $? = 2 ]; then
        run gh label create "$PROJECT_HOLD_LABEL" --repo "$repo" --color 5319E7 --force \
          --description "pr-autopilot: ajout/retrait de projet, fusion réservée à $OPERATOR_NAME" >/dev/null 2>&1
        add_label "$repo" "$num" "$PROJECT_HOLD_LABEL"
      fi
      ;;
  esac
  HELD=$((HELD+1))
  return 1
}

# ---------- maintenance form gate (af-npz9v1.25) ----------
# A fix of the Factory itself (rig ".", branch fix/... or do-work/...) is
# armed only once its body says where else its defect is: « Catégorie : »
# a code of docs/DEFECT_CLASSES.md, « Où ailleurs : », « Contrôle de
# catégorie : » (docs/DELIVERY.md, study B). From 15 to 22/10/2026 three
# defect classes came back 5 to 7 times each: every fix repaired the place
# it was seen and wrote the rest « hors périmètre ». The class is read from
# the register of main, then from the PR's own head when main does not know
# it yet: the fix that finds a new class adds its entry in the same PR.
MAINTENANCE_FORM_LABEL="maintenance-form-missing"
DEFECT_CLASSES_TOOL="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/lib/defect_classes.py"

maintenance_form_gate() {  # repo rig_dir num sha branch labels armed -> 0 proceed, 1 hold
  local repo=$1 rig_dir=$2 num=$3 sha=$4 branch=$5 labels=" $6 " armed=$7
  local body rc problems
  [ "$rig_dir" = "." ] || return 0
  case "$branch" in fix/*|do-work/*) ;; *) return 0 ;; esac
  body=$(bounded "$AP_READ_CAP" gh pr view "$num" --repo "$repo" --json body --jq .body 2>/dev/null); rc=$?
  if [ "$rc" != 0 ]; then
    log "  PR #$num: body unreadable -> maintenance form unknown, not arming this pass (retried next tick)"
    return 1
  fi
  problems=$(printf '%s' "$body" | python3 "$DEFECT_CLASSES_TOOL" check-pr-body 2>&1); rc=$?
  if [ "$rc" = 1 ] && grep -q 'absente de docs/DEFECT_CLASSES.md' <<<"$problems"; then
    if bounded "$AP_READ_CAP" gh api -H "Accept: application/vnd.github.raw" \
        "repos/$repo/contents/docs/DEFECT_CLASSES.md?ref=$sha" > "$TMPDIR_AP/defect-classes-$num.md" 2>/dev/null; then
      problems=$(printf '%s' "$body" | python3 "$DEFECT_CLASSES_TOOL" --registry "$TMPDIR_AP/defect-classes-$num.md" \
        check-pr-body 2>&1); rc=$?
    fi
  fi
  if [ "$rc" = 0 ]; then
    case "$labels" in *" $MAINTENANCE_FORM_LABEL "*)
      log "  PR #$num: maintenance form complete -> removing '$MAINTENANCE_FORM_LABEL'"
      remove_label "$repo" "$num" "$MAINTENANCE_FORM_LABEL" ;;
    esac
    return 0
  fi
  if [ "$rc" != 1 ]; then
    log "  PR #$num: maintenance form could not be checked ($problems) -> not arming this pass (fail closed)"
    return 1
  fi
  if [ "$armed" != "null" ] && [ -n "$armed" ]; then
    log "  PR #$num: disarming auto-merge (maintenance form missing)"
    run gh pr merge "$num" --repo "$repo" --disable-auto >/dev/null 2>&1
  fi
  case "$labels" in
    *" $MAINTENANCE_FORM_LABEL "*) vlog "PR #$num: held ($MAINTENANCE_FORM_LABEL), already explained on the PR" ;;
    *)
      log "  PR #$num: HELD -> $MAINTENANCE_FORM_LABEL"
      {
        printf '### Où ailleurs ? Lignes de maintenance manquantes\n\n'
        printf 'Un correctif de l'"'"'usine dit où ailleurs est son défaut avant que pr-autopilot arme sa fusion (`docs/DELIVERY.md`, af-npz9v1.25) :\n\n'
        printf '%s\n' "$problems" | sed 's/^/- /'
        printf '\nÀ écrire dans la description de la PR :\n\n```\nCatégorie : <code de docs/DEFECT_CLASSES.md> — <la catégorie en quelques mots>\nOù ailleurs : <la recherche faite et ce qu'"'"'elle a trouvé : corrigé ici, ou un Bead par occurrence laissée>\nContrôle de catégorie : <le test ou lint qui échouera sur la prochaine occurrence, ou pourquoi il n'"'"'y en a pas>\n```\n\n'
        printf 'Un changement qui ne corrige aucun défaut écrit `Catégorie : aucune — <raison>`. pr-autopilot relit la description à chaque passe.\n'
      } > "$TMPDIR_AP/maintenance-form.md"
      if explain_once "$repo" "$num" "$MAINTENANCE_FORM_LABEL" "$TMPDIR_AP/maintenance-form.md" || [ $? = 2 ]; then
        run gh label create "$MAINTENANCE_FORM_LABEL" --repo "$repo" --color FBCA04 --force \
          --description "pr-autopilot: Catégorie / Où ailleurs / Contrôle de catégorie manquants" >/dev/null 2>&1
        add_label "$repo" "$num" "$MAINTENANCE_FORM_LABEL"
      fi
      ;;
  esac
  HELD=$((HELD+1))
  return 1
}

# af-grln2: a draft, DIRTY, BLOCKED, or zero-check PR used to get one
# identical log line every pass, forever -- indistinguishable from one
# quietly waiting its natural turn. This acts directly on data the loop
# already fetched this tick (mergeStateStatus, statusCheckRollup, labels) --
# no separate read, matching the audit's "act in the mechanism" ask. A label
# is the memory of "seen before": the first stuck pass just marks it: the
# label already being present is what proves it survived to a second pass,
# so a bead is only filed once a PR is stuck across passes, not on the first.
STUCK_LABEL="autopilot-stuck"

stuck_reason() {  # mergeStateStatus checks -> prints why the PR is stuck, or nothing
  local state=$1 checks=$2 reason=""
  case "$state" in
    DIRTY) reason="merge conflict (DIRTY)" ;;
    # BLOCKED is the NORMAL state while a required check is still running (the
    # repo ruleset requires "Tests"): a healthy PR whose CI outlasts two passes
    # is waiting, not stuck. Only BLOCKED with nothing left pending is.
    BLOCKED) [ "$checks" = "PENDING" ] || reason="blocked (no check is pending: a required check never ran or another merge rule is unmet)" ;;
    # BEHIND is a wait too (af-jaimhb): pr-autopilot itself brings one BEHIND
    # PR up to date per tick, oldest first, and since Factory CI runs one job
    # at a time every merge puts the PRs queued behind it BEHIND again.
    # Marking it here filed a bug bead for every PR but the first of the
    # queue, at every merge (27 beads for 17 PRs, 2026-10-01 to 2026-10-11).
    # Only a branch update GitHub refuses is flagged, where it is attempted.
  esac
  [ "$checks" = "NONE" ] && reason="${reason:+$reason; }no status check ever reported"
  printf '%s' "$reason"
}

stuck_beads() {  # num -> ids of the open stuck bead(s) filed for this PR
  # By title prefix, not the full title: the reason can change between passes
  # (DIRTY -> BEHIND) and is unknown once the PR has recovered.
  # af-k1f97: reads the per-rig $RIG_OPEN_BEADS_JSON cache (fetched once per
  # rig) instead of shelling out to `gc bd list` per PR -- see that variable's
  # definition below for why.
  printf '%s' "$RIG_OPEN_BEADS_JSON" \
    | jq -r --arg t "[autopilot] PR #$1 stuck:" '.[]|select((.title//"")|startswith($t))|.id' 2>/dev/null
}

closed_stuck_bead() {  # num -> id of the last closed stuck bead filed for this PR, or nothing
  # af-jaimhb: one bead per PR. Reads $RIG_ALL_BEADS_JSON (ensure_rig_all_beads).
  printf '%s' "$RIG_ALL_BEADS_JSON" \
    | jq -r --arg t "[autopilot] PR #$1 stuck:" '[.[]|select(.status=="closed")|select((.title//"")|startswith($t))]
        | sort_by(.closed_at // .updated_at // "") | last | .id // empty' 2>/dev/null
}

ci_failure_beads() {  # num -> ids of the open "[ci] PR #num failed" bead(s) filed for this PR
  # af-gpq0y: smb-au8d ("[ci] PR #47 failed required checks", P1) stayed open
  # after PR #47's checks went green and it merged -- nothing ever closed the
  # flag once the failure it reported was resolved. By title prefix, same
  # reasoning as stuck_beads: the base branch name is fixed per rig here so
  # the full title is stable, but matching the prefix keeps this resilient if
  # that ever changes.
  printf '%s' "$RIG_OPEN_BEADS_JSON" \
    | jq -r --arg t "[ci] PR #$1 failed" '.[]|select((.title//"")|startswith($t))|.id' 2>/dev/null
}

close_ci_failure_beads() {  # repo rig_path num reason
  local repo=$1 rig_path=$2 num=$3 reason=$4 b
  for b in $(ci_failure_beads "$num"); do
    log "  PR #$num: $reason -> closing CI-failure bead $b"
    run bash -c "cd '$rig_path' && gc bd update '$b' --status closed \
      --append-notes 'Closed by pr-autopilot: PR #$num $reason.'"
  done
}

stuck_pr() {  # repo rig_path num mergeStateStatus checks labels
  local reason tried
  reason=$(stuck_reason "$4" "$5")
  [ -n "$reason" ] || return 0
  case "$4" in
    DIRTY) tried="nothing: it never resolves a conflict, and this PR has no open ticket to send back to the pool" ;;
    *)     tried="nothing: it cannot make a required check run or meet another merge rule" ;;
  esac
  flag_stuck "$1" "$2" "$3" "$reason" "$tried" "$6"
}

# af-jaimhb: a bead is opened once per PR, when pr-autopilot has nothing left
# to try, and says what it tried. A PR stuck again after its bead was closed
# (PR #441, 2026-10-08: three conflicts, three beads in 50 minutes) reopens
# that bead instead of getting a new one.
flag_stuck() {  # repo rig_path num reason tried labels
  local repo=$1 rig_path=$2 num=$3 reason=$4 tried=${5//\'/} labels=" ${6//,/ } "
  local title old
  case "$labels" in
    *" $STUCK_LABEL "*)
      title="[autopilot] PR #$num stuck: $reason"
      if [ -n "$(stuck_beads "$num")" ]; then
        vlog "PR #$num: stuck ($reason), already filed"
        return 0
      fi
      ensure_rig_all_beads
      if [ "$RIG_ALL_BEADS_UNKNOWN" = "1" ]; then
        log "  PR #$num: stuck ($reason), earlier beads unknown (a read timed out) -> nothing filed this pass"
        return 0
      fi
      old=$(closed_stuck_bead "$num")
      if [ -n "$old" ]; then
        log "  PR #$num: stuck again ($reason) -> reopening $old"
        run bash -c "cd '$rig_path' && gc bd update '$old' --status open --title '$title' \
          --append-notes 'Reopened by pr-autopilot: PR #$num is stuck again: $reason. What pr-autopilot tried: $tried.'"
      else
        log "  PR #$num: stuck across passes ($reason) -> filing"
        run bash -c "cd '$rig_path' && gc bd create '$title' -p 2 -t bug \
          -d 'PR stuck across multiple pr-autopilot passes (every 3 min): $reason.
https://github.com/$repo/pull/$num
What pr-autopilot tried: $tried.
Left to a human or the Mayor: resolve the conflict, push a commit to (re)trigger the required check, or rebase onto the latest base. pr-autopilot closes this bead when the PR is no longer stuck, and reopens it if the PR gets stuck again.' \
          --metadata '{\"pr_number\":\"$num\",\"source\":\"pr-autopilot\"}'"
      fi
      run gh pr comment "$num" --repo "$repo" \
        --body "pr-autopilot: this PR has been $reason across multiple passes and needs attention (filed as a bead)." >/dev/null 2>&1
      FLAGGED=$((FLAGGED+1))
      ;;
    *)
      run gh label create "$STUCK_LABEL" --repo "$repo" --color EDEDED --force \
        --description "pr-autopilot: not armable across at least 2 passes" >/dev/null 2>&1
      add_label "$repo" "$num" "$STUCK_LABEL"
      vlog "PR #$num: stuck ($reason), marked -- filing next pass if still stuck"
      ;;
  esac
}

# A required check failing is not proof the PR is broken -- GitHub's own
# hosted runners occasionally never get past actions/checkout's initial
# fetch (a not-yet-warm TLS cert store, a network blip reaching github.com):
# the job fails within seconds, before a single test line runs. Give every
# required-check failure exactly one automatic retry per commit before
# paging anyone: a real code failure reproduces identically and falls
# straight through to the flag below on the very next pass; a transient one
# usually clears without anyone noticing it happened. The marker is a PR
# comment naming the exact head SHA, not a label -- a label survives a new
# push and would silently skip the retry on a commit that was never
# actually retried.
retry_ci_failure() {  # repo num sha workflow -> 0 retried this pass, 1 flag as before, 2 unknown (a call timed out)
  local repo=$1 num=$2 sha=$3 workflow=$4 marker run_id comments rc
  marker="pr-autopilot: retried CI once for ${sha:0:12}"
  comments=$(bounded "$AP_READ_CAP" gh pr view "$num" --repo "$repo" --json comments --jq '.comments[].body' 2>/dev/null); rc=$?
  timed_out "$rc" && return 2
  grep -qF "$marker" <<<"$comments" && return 1
  run_id=$(bounded "$AP_READ_CAP" gh run list --repo "$repo" --commit "$sha" --json databaseId,name,conclusion \
    --jq --arg wf "$workflow" \
    '[.[]|select(.name==$wf and .conclusion=="failure")][0].databaseId // empty' 2>/dev/null); rc=$?
  timed_out "$rc" && return 2
  [ -n "$run_id" ] || return 1
  log "  PR #$num: required check failed -> retrying once (run $run_id)"
  run gh run rerun "$run_id" --repo "$repo" --failed >/dev/null 2>&1; rc=$?
  timed_out "$rc" && return 2
  [ "$rc" = 0 ] || return 1
  run gh pr comment "$num" --repo "$repo" --body "$marker" >/dev/null 2>&1
  return 0
}

# ---------- P06: DIRTY/red-after-retry returns a ticket to the pool ----------
# af-elhn7: a factory-worker used to leave a red or conflicted PR behind when
# it moved on to the next ticket -- nobody watched the PR come back, and a
# human had to notice and manually re-dispatch it. This reuses the same
# ticket-lookup RECONCILE already does for a merged PR (linked_work_candidate_for,
# below) to find the work bead a still-open PR belongs to, so a ticket-owned
# PR that goes DIRTY, or whose required check is still red after the one
# automatic retry, is put straight back in the ready pool with a structured
# rejection reason -- instead of only filing a side "[ci] failed"/"[autopilot]
# stuck" bead nobody is dispatched to act on. The branch and PR are left
# exactly as they are: `bin/factory-do-work-workspace enter` is keyed on the
# same bead id, so the next dispatch resumes the same worktree/branch instead
# of starting cold. A PR with no linked work bead (a manual/non-ticket PR)
# falls through to the pre-existing stuck/CI-failure flagging unchanged.
ensure_rig_all_beads() {  # fetch $RIG_ALL_BEADS_JSON once per rig, lazily
  [ "$RIG_ALL_BEADS_FETCHED" = "1" ] && return 0
  local rc
  RIG_ALL_BEADS_JSON=$(cd "$rig_path" && bounded "$AP_WRITE_CAP" gc bd list --all --limit 0 --json 2>/dev/null); rc=$?
  # A cut read is not "no beads": callers must not act on it (RIG_ALL_BEADS_UNKNOWN).
  timed_out "$rc" && RIG_ALL_BEADS_UNKNOWN=1
  [ -n "$RIG_ALL_BEADS_JSON" ] || RIG_ALL_BEADS_JSON='[]'
  RIG_ALL_BEADS_FETCHED=1
}

# Same exclusions RECONCILE below relies on: never a bead pr-autopilot itself
# filed, never a step-tracking wisp, never a latch/tracking bead (af-6xs2n,
# af-q7r0d/B04) -- and prefer a still-open candidate over an already-closed
# one on any remaining duplicate match. One definition, used both per PR
# (reject_ticket) and for a whole merged-PR window in one pass (index_merged).
LINKED_WORK_JQ='def linked($b; $n):
  [.[]|select((.metadata.source//"")!="pr-autopilot")
      |select((.metadata["gc.step_ref"]//"")=="")
      |select((.metadata["gc.kind"]//"") as $k
              | ["workflow","scope","check","fanout","scope-check","workflow-finalize"]
                | index($k) | not)
      |select((.metadata["gc.work_branch"]//"")==$b
             or (.metadata.pr_number|tostring)==$n)]
  | sort_by(if .status=="closed" then 1 else 0 end)
  | .[0] // empty;'

linked_work_candidate_for() {  # branch num -> json of the linked work bead, or empty
  printf '%s' "$RIG_ALL_BEADS_JSON" \
    | jq -r --arg b "$1" --arg n "$2" "$LINKED_WORK_JQ"' linked($b; $n) | @json' 2>/dev/null
}

# 2026-09-30: RECONCILE used to call linked_work_candidate_for and
# delivered_via_pr_candidates_for once per merged PR -- 2 full parses of the
# rig's whole bead history (every closed bead, tens of MB) per PR, x30 merged
# PRs, x3 repos. Measured live that day: ~96 s of a 120 s order for a tick
# with nothing to do. index_merged parses it once per rig and answers every
# merged PR of the window from LINKED_FOR / VIA_FOR, with the same filters.
declare -A LINKED_FOR=() VIA_FOR=()
index_merged() {  # merged-TSV -> fills LINKED_FOR[num]=candidate-json, VIA_FOR[num]=ids
  local pairs n v
  LINKED_FOR=(); VIA_FOR=()
  [ -n "$1" ] || return 0
  pairs=$(printf '%s\n' "$1" | jq -Rn '[inputs|split("\t")|select(length>=2 and .[1]!="")|{n:.[0],b:.[1]}]' 2>/dev/null)
  [ -n "$pairs" ] || pairs='[]'
  while IFS=$'\t' read -r n v; do
    [ -n "$n" ] && LINKED_FOR[$n]=$v
  done < <(printf '%s' "$RIG_ALL_BEADS_JSON" | jq -r --argjson pairs "$pairs" "$LINKED_WORK_JQ"'
    . as $all | $pairs[] | . as $p | ($all | linked($p.b; $p.n)) as $c
    | select((($c.metadata["gc.needs_benjamin"] // "") | tostring) as $needs
             | $needs == "" or $needs == "none")
    | "\($p.n)\t\($c|tojson)"' 2>/dev/null)
  while IFS=$'\t' read -r n v; do
    [ -n "$n" ] && VIA_FOR[$n]+="$v"$'\n'
  done < <(printf '%s' "$RIG_ALL_BEADS_JSON" | jq -r '
    .[]|(.metadata["gc.delivered_via_pr"]|tostring) as $v
    |select($v!="null")
    |select(.status=="open" or .status=="in_progress")
    |((.metadata["gc.needs_benjamin"] // "") | tostring) as $needs
    |select($needs == "" or $needs == "none")
    |"\($v)\t\(.id)"' 2>/dev/null)
}

# ---------- P07 (af-87f9u): a ticket fixed through another ticket's PR ----------
# A repair sometimes lands on another ticket's branch instead of its own (the
# fix and the other change are the same logical unit). The worker records
# that with `gc.delivered_via_pr=<PR number>` on the fixed ticket
# (formulas/mol-do-work.formula.toml, step 3c) instead of opening a branch/PR
# of its own -- so the branch-keyed RECONCILE above, which matches on
# gc.work_branch/pr_number, can never find it. This closes that ticket
# directly, through the same deliver-close merge+CI proof, once the *named*
# PR (not its own) merges.
delivered_via_pr_candidates_for() {  # num -> newline-separated still-open bead ids naming it (from index_merged)
  printf '%s' "${VIA_FOR[$1]:-}"
}

ensure_base_sha() {  # sets $BASE_SHA (cached per rig per tick) for the "conflict with <base>@<sha>" reason
  [ -n "$BASE_SHA" ] && return 0
  BASE_SHA=$(bounded "$AP_READ_CAP" gh api "repos/$repo/commits/$dev" --jq '.sha' 2>/dev/null)
  [ -n "$BASE_SHA" ] || BASE_SHA="unknown"
}

# ---------- P16 (af-45knz): measure undeclared-scope PR conflicts ----------
# A DIRTY ticket-owned PR is a real merge conflict against the base -- almost
# always caused by whatever ticket most recently landed there. record_pr_conflict
# is best-effort and never fails the caller: it identifies that other ticket
# from the same published graph (the most recently closed, merged one) and
# hands both tickets' declared scopes to bin/overlap-conflict-log, which is the
# single place that decides whether the undeclared-conflict count crosses the
# threshold for filing the "dynamic leases" proposal (never built without
# Benjamin). No other ticket can be identified -> nothing is recorded, since
# the log only ever carries entries naming both tickets.
OVERLAP_CONFLICT_LOG_BIN="${OVERLAP_CONFLICT_LOG_BIN:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/overlap-conflict-log}"

record_pr_conflict() {  # candidate_json sha rig_name
  local candidate=$1 sha=$2 rig_name=$3
  local ticket_a scope_a digest other ticket_b scope_b

  ticket_a=$(printf '%s' "$candidate" | jq -r '.metadata["gc.ticket_id"] // .id // empty' 2>/dev/null)
  [ -n "$ticket_a" ] || return 0
  digest=$(printf '%s' "$candidate" | jq -r '.metadata["gc.graph_digest"] // empty' 2>/dev/null)
  [ -n "$digest" ] || return 0
  scope_a=$(printf '%s' "$candidate" | jq -r '.metadata["gc.scope_paths"] // ""' 2>/dev/null)

  other=$(printf '%s' "$RIG_ALL_BEADS_JSON" \
    | jq -r --arg digest "$digest" --arg self "$ticket_a" \
      '[.[]|select(.status=="closed")
            |select((.metadata["gc.graph_digest"]//"")==$digest)
            |select((.metadata["merge_result"]//"")=="merged")
            |select((.metadata["gc.ticket_id"]//.id))
            |select((.metadata["gc.ticket_id"]//.id)!=$self)]
       | sort_by(.updated_at) | reverse | .[0] // empty
       | @json' 2>/dev/null)
  [ -n "$other" ] || return 0

  ticket_b=$(printf '%s' "$other" | jq -r '.metadata["gc.ticket_id"] // .id // empty' 2>/dev/null)
  [ -n "$ticket_b" ] || return 0
  scope_b=$(printf '%s' "$other" | jq -r '.metadata["gc.scope_paths"] // ""' 2>/dev/null)

  run "$OVERLAP_CONFLICT_LOG_BIN" record-conflict \
    --ticket-a "$ticket_a" --scope-a "$scope_a" \
    --ticket-b "$ticket_b" --scope-b "$scope_b" \
    --sha "$sha" --rig "$rig_name" >/dev/null 2>&1
}

reject_ticket() {  # repo rig_path num sha reason -> 0 handled (ticket-owned PR), 1 not ticket-owned, 2 unknown (a read timed out)
  local repo=$1 rig_path=$2 num=$3 sha=$4 reason=$5
  local branch candidate bead status marker count comments rc held if_held

  REJECT_TICKET_CANDIDATE_JSON=""
  REJECT_TICKET_FRESH=0

  branch=$(bounded "$AP_READ_CAP" gh pr view "$num" --repo "$repo" --json headRefName --jq .headRefName 2>/dev/null); rc=$?
  timed_out "$rc" && return 2
  [ -n "$branch" ] || return 1
  ensure_rig_all_beads
  [ "$RIG_ALL_BEADS_UNKNOWN" = "1" ] && return 2
  candidate=$(linked_work_candidate_for "$branch" "$num")
  [ -n "$candidate" ] || return 1
  bead=$(printf '%s' "$candidate" | jq -r '.id // empty' 2>/dev/null)
  [ -n "$bead" ] || return 1
  status=$(printf '%s' "$candidate" | jq -r '.status // empty' 2>/dev/null)
  case "$status" in
    open|in_progress) ;;
    *) return 1 ;;  # closed/terminal -- never reopen an already-delivered ticket
  esac
  REJECT_TICKET_CANDIDATE_JSON="$candidate"

  # Idempotent per head: a PR comment names the exact sha so the same
  # rejection is never counted (or re-mailed) twice while nobody has pushed a
  # fix for it yet -- the ticket just waits in the pool until it does.
  marker="pr-autopilot: rejected $bead for ${sha:0:12}"
  comments=$(bounded "$AP_READ_CAP" gh pr view "$num" --repo "$repo" --json comments --jq '.comments[].body' 2>/dev/null); rc=$?
  timed_out "$rc" && return 2
  if grep -qF "$marker" <<<"$comments"; then
    vlog "PR #$num: already rejected for this head ($bead)"
    return 0
  fi

  REJECT_TICKET_FRESH=1
  count=$(( $(printf '%s' "$candidate" | jq -r '.metadata["gc.pr_rejection_count"] // 0' 2>/dev/null) + 1 ))
  log "  PR #$num: $reason -> reopening ticket $bead to the pool (rejection $count)"
  # --if-assignee: Beads 1.3 refuses a bare --assignee '' over another
  # actor's in_progress claim (exit 1), and this order is never that actor.
  # The compare-and-set releases the claim this pass read and no other: exit
  # 13 means the holder changed since, so the ticket is left to it and nothing
  # is recorded for this head -- the next pass reads it again (af-33wuoh).
  held=$(printf '%s' "$candidate" | jq -r '.assignee // empty' 2>/dev/null)
  if_held=""
  [ -z "$held" ] || if_held="--if-assignee '${held//\'/}' "
  run bash -c "cd '$rig_path' && gc bd update '$bead' ${if_held}--status open --assignee '' \
    --set-metadata 'gc.pr_rejection_reason=$reason' \
    --set-metadata 'gc.pr_rejection_count=$count' \
    --append-notes 'pr-autopilot: rejected PR #$num ($reason); rejection $count.'"; rc=$?
  if [ "$rc" = 13 ]; then
    log "    $bead: its assignee is no longer '$held' (changed since this pass read it) -> left alone"
    REJECT_TICKET_FRESH=0
    return 0
  fi
  run gh pr comment "$num" --repo "$repo" --body "$marker: $reason." >/dev/null 2>&1

  if [ "$count" -ge 3 ]; then
    if ! run "$ESCALATION_DOOR_BIN" mayor "$bead" "PR #$num rejected $count times: $reason" >/dev/null 2>&1; then
      log "    escalation-door mayor failed for $bead"
      ERRORS=$((ERRORS+1))
    fi
  fi
  return 0
}

if [ -z "$PR_AUTHORS" ]; then
  log "ERROR: config/operator.toml names no github_logins -- every open PR is treated as an outsider's, nothing is armed"
  ERRORS=$((ERRORS+1))
fi

for entry in "${RIGS[@]}"; do
  IFS='|' read -r rig_dir repo dev required_workflow <<<"$entry"
  repo_done
  if over_budget; then
    not_checked "$repo and any repo after it"
    break
  fi
  AP_REPO=$repo; AP_REPO_T0=$SECONDS
  log "=== $repo (base: $dev) ==="
  rig_path="$FACTORY/$rig_dir"
  [ -d "$rig_path" ] || { log "  SKIP: $rig_path missing"; ERRORS=$((ERRORS+1)); continue; }

  required_check="${REQUIRED_CHECK_FOR_REPO[$repo]:-}"
  if [ -z "$required_check" ]; then
    log "  ERROR: config/projects has no required_check for $repo -- refusing to gate arming on an unnamed check"
    ERRORS=$((ERRORS+1))
    continue
  fi
  verify_required_check_live "$repo" "$dev" "$required_check"
  case $? in
    1) log "  LOUD: config/projects names required_check='$required_check' for $repo but the live ruleset on $dev does not require it -- fix the config or the ruleset before trusting this repo's gating"
       ERRORS=$((ERRORS+1)) ;;
    2) vlog "could not verify $repo's live ruleset required checks (gh api unavailable) -- proceeding with configured required_check='$required_check'" ;;
  esac

  # af-k1f97: fetch this rig's bead lists ONCE per tick and reuse them for
  # every PR below, instead of re-running `gc bd list` per PR. The RECONCILE
  # loop used to run close_ci_failure_beads() (one `gc bd list --status open`)
  # plus a second unfiltered `gc bd list` per merged PR -- up to 60 calls for
  # ~30 merged PRs on one rig, each measured at ~4.6s, which alone blew the
  # whole tick's 100s budget before agent-factory (rig 3) was ever reached.
  # Stale-within-a-tick is fine: a bead this script itself closes/creates for
  # PR N is never looked up again for that same N within the same pass, and a
  # PR cannot be both "open" and "merged" in the same `gh pr list` snapshot.
  # "Open" here means not closed: a flag bead a worker has claimed is
  # in_progress, and `--status open` alone does not return it -- each new red
  # head of PR #372 was filed again (3 beads, 3 workers, 2026-10-01) and a
  # claimed bead would never have been closed on recovery.
  RIG_OPEN_BEADS_JSON=$(cd "$rig_path" && bounded "$AP_READ_CAP" gc bd list --status open,in_progress --json 2>/dev/null); rc=$?
  if timed_out "$rc"; then
    # "No open bead" would re-file every stuck/CI flag already filed: skip the repo.
    log "  open beads unknown (gc bd list timed out) -- $repo not processed this tick"
    continue
  fi
  [ -n "$RIG_OPEN_BEADS_JSON" ] || RIG_OPEN_BEADS_JSON='[]'
  # Lazily fetched by ensure_rig_all_beads only when reject_ticket or the
  # RECONCILE loop below actually needs it (a DIRTY/red PR, or a merge).
  RIG_ALL_BEADS_JSON='[]'
  RIG_ALL_BEADS_FETCHED=0
  RIG_ALL_BEADS_UNKNOWN=0
  BASE_SHA=""
  QUEUE_HEAD=""; PRS_UNSEEN=0
  BEHIND_NUMS=(); BEHIND_SHAS=(); BEHIND_CHECKS=(); BEHIND_LABELS=()

  # ---------- 1. ARM open PRs targeting dev ----------
  mark=$(tmo_mark)
  open_prs=$(bounded "$AP_READ_CAP" gh pr list --repo "$repo" --state open --base "$dev" --limit 50 \
    --json number,isDraft,autoMergeRequest,mergeStateStatus,statusCheckRollup,headRefOid,headRefName,labels,author,isCrossRepository 2>/dev/null)
  # A fine-grained token cannot read check runs; rebuild them from Actions runs.
  [ -n "$open_prs" ] || cut_since "$mark" || open_prs=$(bounded "$AP_READ_CAP" gh pr list --repo "$repo" --state open --base "$dev" --limit 50 \
    --json number,isDraft,autoMergeRequest,mergeStateStatus,headRefOid,headRefName,labels,author,isCrossRepository 2>/dev/null \
    | bounded "$AP_WRITE_CAP" "$(dirname "${BASH_SOURCE[0]}")/factory-gh-rollup" "$repo" 2>/dev/null)
  if cut_since "$mark"; then
    log "  open PRs unknown (a gh call timed out) -- nothing armed or flagged for $repo this tick"; open_prs='[]'
  elif [ -z "$open_prs" ]; then
    log "  (could not list open PRs)"; ERRORS=$((ERRORS+1)); open_prs='[]'
  fi

  while IFS=$'\t' read -r num draft armed state checks sha green_at origin branch labels; do
    [ -z "${num:-}" ] && continue
    if over_budget; then not_checked "$repo open PR #$num and any open PR after it"; PRS_UNSEEN=1; break; fi
    # af-996mmd: before anything else, so that nothing below (arming, direct
    # merge, retry, label, bead) ever runs for an outsider's pull request.
    if [ "$origin" != "own" ]; then
      log "  PR #$num: fork or outside author -> left to a human (never armed, retried or flagged)"
      SKIPPED=$((SKIPPED+1)); continue
    fi
    if [ "$draft" = "true" ]; then
      vlog "PR #$num: draft, not arming"; SKIPPED=$((SKIPPED+1)); continue
    fi

    # A PR that recovered (state healthy again) sheds the stuck label; a
    # human/Mayor fixing it manually should not leave a stale marker behind --
    # nor the bead filed for it, which nothing else would ever close.
    case " ${labels//,/ } " in
      *" $STUCK_LABEL "*)
        # Not while BEHIND: the label may be the mark of a refused branch
        # update, and whether that still holds is only known once the update
        # is attempted again below.
        if [ -z "$(stuck_reason "$state" "$checks")" ] && [ "$state" != "BEHIND" ]; then
          remove_label "$repo" "$num" "$STUCK_LABEL"
          vlog "PR #$num: no longer stuck -> removed $STUCK_LABEL"
          for stale in $(stuck_beads "$num"); do
            log "  PR #$num: recovered -> closing stuck bead $stale"
            run bash -c "cd '$rig_path' && gc bd update '$stale' --status closed \
              --append-notes 'Closed by pr-autopilot: PR #$num is no longer stuck (state=$state, checks=$checks).'"
          done
        fi ;;
    esac

    # af-gpq0y: checks recovered to green (or reset to pending/none, e.g. a
    # new commit re-ran them) without the PR merging yet -- close any
    # previously filed CI-failure bead now, the same way the stuck-label
    # recovery above does, instead of waiting for the merge pass below.
    [ "$checks" = "FAILURE" ] || close_ci_failure_beads "$repo" "$rig_path" "$num" "checks are now '$checks' (no longer FAILURE)"

    # Red required check -> retry once (maybe transient), else flag as work.
    # Not when the PR is also BEHIND: that red belongs to a head the BEHIND
    # update below is about to replace, and the new head gets a fresh
    # required run. Deciding on the stale head first left PR #373 stuck
    # (2026-10-01): already rejected for that head, nothing for the worker to
    # push, and this branch `continue`d before the update was ever reached.
    if [ "$checks" = "FAILURE" ] && [ "$state" != "BEHIND" ]; then
      retry_ci_failure "$repo" "$num" "$sha" "$required_workflow"; rc=$?
      if [ "$rc" = 0 ]; then
        vlog "PR #$num: retried once, re-checking next pass"
        # af-31t0y8: its required run is on again, on an up-to-date branch.
        [ "$state" = "DIRTY" ] || QUEUE_HEAD=${QUEUE_HEAD:-$num}
        continue
      elif [ "$rc" = 2 ]; then
        log "  PR #$num: required check failed, retry state unknown (a call timed out) -> nothing decided this pass"
        continue
      fi
      # P06: a ticket-owned PR still red after the single retry goes straight
      # back to the pool with a rejection reason instead of a side bead.
      reject_ticket "$repo" "$rig_path" "$num" "$sha" \
          "required check '$required_check' failed after one retry"; rc=$?
      if [ "$rc" = 0 ]; then
        continue
      elif [ "$rc" = 2 ]; then
        log "  PR #$num: required check failed, ticket link unknown (a read timed out) -> not flagging this pass"
        continue
      fi
      log "  PR #$num: required checks FAILED -> flagging"
      title="[ci] PR #$num failed required checks on $dev"
      existing=$(printf '%s' "$RIG_OPEN_BEADS_JSON" \
        | jq -r --arg t "$title" '[.[]|select(.title==$t)]|length' 2>/dev/null)
      if [ "${existing:-0}" = "0" ]; then
        run bash -c "cd '$rig_path' && gc bd create '$title' -p 1 -t bug \
          -d 'Required status check failed twice on the same commit (one automatic retry already attempted). PR: https://github.com/$repo/pull/$num
Auto-merge was not armed. Fix the build, then pr-autopilot will arm it on the next pass.' \
          --metadata '{\"pr_number\":\"$num\",\"source\":\"pr-autopilot\"}'"
        FLAGGED=$((FLAGGED+1))
      else
        vlog "PR #$num: failure already tracked"
      fi
      continue
    fi

    # P06: a ticket-owned PR that went DIRTY (a real merge conflict, never
    # self-healing the way a pending check does) goes straight back to the
    # pool with a rejection reason instead of waiting for the generic
    # two-pass stuck flow below. A non-ticket PR falls through unchanged.
    if [ "$state" = "DIRTY" ]; then
      ensure_base_sha
      reject_ticket "$repo" "$rig_path" "$num" "$sha" "conflict with $dev@${BASE_SHA:0:12}"; rc=$?
      if [ "$rc" = 0 ]; then
        if [ "$REJECT_TICKET_FRESH" = "1" ]; then
          record_pr_conflict "$REJECT_TICKET_CANDIDATE_JSON" "$sha" "$repo"
        fi
        continue
      elif [ "$rc" = 2 ]; then
        log "  PR #$num: DIRTY, ticket link unknown (a read timed out) -> nothing decided this pass"
        continue
      fi
    fi

    # af-grln2: a DIRTY/BLOCKED/BEHIND merge state or a PR with no status
    # check at all is not fixed by arming auto-merge -- GitHub accepts the
    # arm request regardless and just waits, so this must be evaluated here,
    # independent of whether arming below succeeds.
    stuck_pr "$repo" "$rig_path" "$num" "$state" "$checks" "$labels"

    # Before the "already armed" shortcut: a push can add a destructive
    # migration to a PR that was armed while it was harmless. (The labels field
    # is never empty -- jq writes "-" -- because read would swallow it.)
    reversibility_gate "$repo" "$num" "$sha" "${labels//,/ }" "$armed" || continue
    project_descriptor_gate "$repo" "$num" "${labels//,/ }" "$armed" || continue
    maintenance_form_gate "$repo" "$rig_dir" "$num" "$sha" "$branch" "${labels//,/ }" "$armed" || continue

    # af-s6lef (P04): BEHIND is never armable -- GitHub would happily arm
    # auto-merge and, on a non-strict ruleset, merge without the base's
    # latest required check ever running against this branch. It is only
    # noted here: which BEHIND PR is brought up to date, if any, is decided
    # after the loop, once it is known whether another PR holds the queue
    # (af-31t0y8).
    if [ "$state" = "BEHIND" ]; then
      BEHIND_NUMS+=("$num"); BEHIND_SHAS+=("$sha"); BEHIND_CHECKS+=("$checks"); BEHIND_LABELS+=("$labels")
      SKIPPED=$((SKIPPED+1))
      continue
    fi
    # af-31t0y8: past the gates and up to date, with its required check
    # waiting, running or green: this PR holds the queue.
    if queue_head "$state" "$checks" "$labels"; then QUEUE_HEAD=${QUEUE_HEAD:-$num}; fi

    if [ "$armed" != "null" ] && [ -n "$armed" ]; then
      # af-n8gft2: armed, green and CLEAN is GitHub's turn -- for a short
      # delay. Past it, GitHub has not merged what it was armed to merge.
      case "$green_at" in ''|*[!0-9]*) green_at=0 ;; esac
      green_for=$((RECONCILE_NOW_EPOCH - green_at))
      if [ "$checks" = "OK" ] && [ "$state" = "CLEAN" ] && [ "$green_at" -gt 0 ] \
          && [ "$green_for" -ge "$ARMED_MERGE_DELAY_SECONDS" ]; then
        log "  PR #$num: armed, required check green for ${green_for}s, CLEAN, still open -> direct squash merge"
        direct_merge "$repo" "$num" "$sha"
        continue
      fi
      vlog "PR #$num: auto-merge already armed"; SKIPPED=$((SKIPPED+1)); continue
    fi

    log "  PR #$num: arming auto-merge (squash, state=$state)"
    if [ "$DRY_RUN" = "1" ]; then
      log "  DRY-RUN: gh pr merge $num --repo $repo --auto --squash"
      ARMED=$((ARMED+1))
    else
      bounded "$AP_WRITE_CAP" gh pr merge "$num" --repo "$repo" --auto --squash >/dev/null 2>&1; rc=$?
      if [ "$rc" = 0 ]; then
        ARMED=$((ARMED+1))
      elif timed_out "$rc"; then
        # Unknown, not failed: no re-read and no direct merge on a guess -- the
        # next tick reads autoMergeRequest from the server like any other PR.
        log "    arm request timed out -- outcome unknown, re-read next tick"
      else
        # Hard rule (gastown land-and-deploy): never retry `gh pr merge` after a
        # non-zero exit. Re-read authoritative server state instead.
        after=$(bounded "$AP_READ_CAP" gh pr view "$num" --repo "$repo" --json state,autoMergeRequest \
          --jq '[.state,(.autoMergeRequest!=null)]|@tsv' 2>/dev/null); rc=$?
        timed_out "$rc" && after="TIMEOUT"
        case "$after" in
          TIMEOUT) log "    state re-read timed out -- unknown, not merging this pass" ;;
          MERGED*) log "    already merged server-side"; ARMED=$((ARMED+1)) ;;
          *true)   log "    auto-merge is armed server-side"; ARMED=$((ARMED+1)) ;;
          *)
            # GitHub refuses allow_auto_merge on a private repo without Pro, so
            # arming is simply unavailable there. Fall back to the documented
            # direct path: merge only once the required checks are actually
            # green, which is the same gate auto-merge would have waited for.
            if [ "$checks" = "OK" ] && [ "$state" = "CLEAN" ]; then
              log "    auto-merge unavailable; checks green -> direct squash merge"
              direct_merge "$repo" "$num" "$sha"
            else
              log "    not armable and checks are '$checks'/'$state' — waiting, not merging"
            fi ;;
        esac
      fi
    fi
  done < <(printf '%s' "$open_prs" | jq -r --arg reqcheck "$required_check" --arg authors "$PR_AUTHORS" '
    # af-s6lef (P04): "oldest ready first" for BEHIND PRs needs a stable order
    # -- gh pr list is not guaranteed sorted by age. PR numbers increase
    # monotonically per repo, so ascending number is exactly oldest-first.
    sort_by(.number)|.[]|[
      .number, (.isDraft|tostring), (.autoMergeRequest|if .==null then "null" else "armed" end),
      (.mergeStateStatus//"?"),
      # Gate on the one required check by name/context, not every check the
      # commit happens to report (af-37h58/P03): an unrelated check failing
      # must never hold a PR whose required check is green, and vice versa.
      # An entry with no name/context at all (older/synthetic single-check
      # fixtures) is treated as a match -- there is nothing to disambiguate.
      ((.statusCheckRollup//[]) as $roll
       | ($roll|map(select((((.name//.context//"")=="") or ((.name//.context//"")==$reqcheck))))) as $req
       | if ($req|length)==0 then "NONE"
         elif ($req|map(.conclusion//.state//"")|any(.=="FAILURE" or .=="ERROR" or .=="TIMED_OUT")) then "FAILURE"
         # A check run not yet COMPLETED, or a commit status still PENDING/EXPECTED.
         elif ($req|any((.status//"COMPLETED")!="COMPLETED" or .state=="PENDING" or .state=="EXPECTED")) then "PENDING"
         else "OK" end),
      (.headRefOid//"unknown"),
      # af-n8gft2: when the required check completed (epoch seconds), 0 when
      # any matching entry carries no usable completion time.
      ((.statusCheckRollup//[])
       | map(select((((.name//.context//"")=="") or ((.name//.context//"")==$reqcheck)))
             | (.completedAt//"") as $t | try ($t|fromdateiso8601) catch 0)
       | if length==0 or any(.<=0) then 0 else max end),
      # af-996mmd: "own" only for a branch of this repository whose author is
      # on the closed list; a missing field reads as an outsider.
      ((.author.login//"") as $who
       | if .isCrossRepository==false and $who!=""
            and (($authors|split(",")|map(gsub("^\\s+|\\s+$";""))|index($who))!=null)
         then "own" else "outside" end),
      (.headRefName//"-"),
      ((.labels//[])|map(.name)|join(",")|if .=="" then "-" else . end)
    ]|@tsv' 2>/dev/null)

  # af-31t0y8: bring one BEHIND PR up to date, only when no PR holds the
  # queue. Not when the list was cut short: a PR that was not read may be the
  # head.
  if [ "${#BEHIND_NUMS[@]}" -gt 0 ]; then
    if [ -n "$QUEUE_HEAD" ]; then
      vlog "PR #$QUEUE_HEAD holds the queue -- ${#BEHIND_NUMS[@]} BEHIND PR(s) waiting: ${BEHIND_NUMS[*]}"
    elif [ "$PRS_UNSEEN" = "1" ] || over_budget; then
      not_checked "$repo BEHIND branch update"
    else
      # Oldest first (the list is in ascending PR number); a PR whose last
      # required run is red only when no other is waiting.
      pick=0
      for i in "${!BEHIND_NUMS[@]}"; do
        if [ "${BEHIND_CHECKS[$i]}" != "FAILURE" ]; then pick=$i; break; fi
      done
      num=${BEHIND_NUMS[$pick]}
      log "  PR #$num: BEHIND base -> updating branch"
      if update_branch "$repo" "$num" "${BEHIND_SHAS[$pick]}"; then
        vlog "PR #$num: branch update requested"
      elif [ -n "$UPDATE_BRANCH_ERR" ]; then
        log "    will retry next tick (marked now, filed if GitHub refuses again)"
        flag_stuck "$repo" "$rig_path" "$num" "behind base, branch update refused" \
          "bringing the branch up to date with its base (update-branch), refused on at least two passes; GitHub answered: $UPDATE_BRANCH_ERR" "${BEHIND_LABELS[$pick]}"
      else
        log "    will retry next tick"
      fi
    fi
  fi

  # ---------- 2. RECONCILE merged PRs onto their beads ----------
  # This pack's publisher does NOT write pr_number metadata (that was the
  # un-imported refinery's convention). The reliable link here is the branch:
  # bead metadata `gc.work_branch` == PR headRefName.
  if over_budget; then not_checked "$repo merged-PR reconciliation"; continue; fi
  mark=$(tmo_mark)
  merged=$(bounded "$AP_READ_CAP" gh pr list --repo "$repo" --state merged --base "$dev" --limit 30 \
    --json number,headRefName,mergeCommit,mergedAt 2>/dev/null \
    | jq -r '.[]|[.number,.headRefName,(.mergeCommit.oid//""),(.mergedAt//"")]|@tsv' 2>/dev/null)
  if cut_since "$mark"; then
    log "  merged PRs unknown (gh pr list timed out) -- reconciliation retried next tick"
    continue
  fi

  # The work bead now remains in_progress while its PR is under review. Keep
  # the full-history lookup for pre-gate false-close records and historical
  # backfills; it also avoids a race between merge and a status-filtered read.
  # ensure_rig_all_beads reuses the same fetch reject_ticket already paid for
  # above, on any tick that also had a DIRTY/red-after-retry PR this rig.
  [ -n "$merged" ] && ensure_rig_all_beads
  if [ "$RIG_ALL_BEADS_UNKNOWN" = "1" ]; then
    log "  beads unknown (gc bd list timed out) -- reconciliation retried next tick"
    continue
  fi
  index_merged "$merged"

  while IFS=$'\t' read -r num branch sha merged_at; do
    [ -z "${num:-}" ] && continue
    [ -z "${branch:-}" ] && continue
    if over_budget; then not_checked "$repo merged PR #$num and any merged PR after it"; break; fi

    # The flag beads filed above ("[ci] ... failed", "[autopilot] ... stuck")
    # carry pr_number too; they are about the PR, not the work it delivers, and
    # must never be stamped merged in place of the work bead.
    #
    # 2026-09-24 (af-q7r0d/B04): a graph.v2 formula step-tracking wisp
    # (metadata gc.step_ref set, e.g. "mol-do-work.workspace-setup") copies
    # gc.work_branch from its parent work bead onto itself for its own
    # bookkeeping -- so it can match this same query. With no way to prefer
    # the real ticket, `[0]` picked whichever of the two `gc bd list --all`
    # happened to return first: it stamped merge_result=merged/gc.work_outcome
    # =shipped onto the wisp (af-unzig) instead of the actual work bead
    # (af-q7r0d), which then looked "already terminal" to nothing and sat
    # in_progress, unreconciled, forever -- silently stranding every
    # dependent ticket behind it in the convoy chain. A step wisp is never a
    # legitimate reconciliation target on its own; exclude it explicitly so
    # the query can only ever land on the real work bead.
    #
    # af-6xs2n: the step-wisp shape above is one instance of a broader class
    # -- ANY duplicate match on gc.work_branch/pr_number where the wrong one
    # gets picked leaves the real work bead permanently unreconciled with no
    # error (af-cfl9j/PR#206, af-i3k3f/PR#210 both showed this: the real bead
    # stayed status=in_progress -- proven by a direct `gc bd show` -- while
    # pr-autopilot's own snapshot query kept resolving "already terminal" to
    # a different bead entirely). Latch/tracking beads (gc.kind in the set
    # below) are never legitimate reconciliation targets either, so exclude
    # the whole class, not just step-tracking wisps. As a last line of
    # defense against any *other* duplicate shape this doesn't yet name,
    # break ties deterministically toward a candidate that is not already
    # closed: the real, not-yet-reconciled work bead is always the one still
    # open when this loop runs, so preferring it over an already-closed
    # match can only ever recover the wrong-pick failure mode, never cause
    # one -- a correctly-closed candidate with no open sibling is unaffected.
    candidate="${LINKED_FOR[$num]:-}"
    [ -z "$candidate" ] && { vlog "PR #$num ($branch): no linked work bead"; continue; }
    bead=$(printf '%s' "$candidate" | jq -r '.id // empty' 2>/dev/null)
    [ -z "$bead" ] && { vlog "PR #$num ($branch): linked bead has no id"; continue; }

    # A legacy pass could already have written merge_result=merged without the
    # exact-head CI tuple.  Re-run those partial records through the single
    # delivery door after this gate reaches the live root.  Fully proven rows
    # and explicit no-op/blocked/abandoned outcomes remain terminal.
    readiness=$(printf '%s' "$candidate" | python3 "$DELIVERY_PROOF_BIN" --mode readiness 2>/dev/null || true)
    readiness_reason=$(printf '%s' "$readiness" | jq -r '.reason // empty' 2>/dev/null)
    merge_result=$(printf '%s' "$candidate" | jq -r '.metadata.merge_result // empty' 2>/dev/null)
    already_terminal=0
    if [ "$readiness_reason" = "explicit-non-delivery" ] \
      || { [ "$merge_result" = "merged" ] && printf '%s' "$readiness" | jq -e '.ready == true' >/dev/null 2>&1; }; then
      already_terminal=1
    fi
    # This tick's whole bead snapshot (RIG_ALL_BEADS_JSON) is fetched once, up
    # front, for performance (af-k1f97) -- by the time this loop reaches a
    # given PR it can be stale relative to the live store. Trusting it to SKIP
    # the only step that ever closes a delivery bead is the one place
    # staleness is fatal: af-cfl9j (B01) sat merged, CI-proven, and stuck
    # in_progress for 1h40 because a stale snapshot said "already terminal"
    # and nothing ever re-checked it. A fresh, single `gc bd show` right
    # before trusting that verdict is cheap (paid only for PRs this tick
    # already believes are done) and closes that failure mode regardless of
    # what staled the snapshot.
    if [ "$already_terminal" = "1" ]; then
      cache_key="$repo#$num"
      if grep -qF "${cache_key}"$'\t' "$RECONCILE_CACHE" 2>/dev/null; then
        vlog "PR #$num ($branch): delivery already terminal and proven (cached, no live re-check)"
        continue
      fi
      mark=$(tmo_mark)
      live_status=$(cd "$rig_path" && bounded "$AP_READ_CAP" gc bd show "$bead" --json 2>/dev/null | jq -r '.[0].status // empty' 2>/dev/null)
      if cut_since "$mark"; then
        log "  PR #$num ($branch): live status of $bead unknown (gc bd show timed out) -- retried next tick"
        continue
      fi
      if [ "$live_status" = "closed" ]; then
        vlog "PR #$num ($branch): delivery already terminal and proven"
        mkdir -p "$(dirname "$RECONCILE_CACHE")"
        printf '%s\t%s\n' "$cache_key" "$bead" >> "$RECONCILE_CACHE"
        continue
      fi
      log "  PR #$num ($branch): snapshot said already-terminal but live bead $bead is '${live_status:-unknown}' -- reconciling for real"
    fi
    log "  PR #$num merged at ${sha:0:8} -> reconciling bead $bead"
    # The Mayor is woken only when open work waits on this bead. A merge
    # nothing waits behind used to wake it too (any merge of the last hour):
    # 8 wakes in 42 hours answered "nothing to advance" (2026-10-13,
    # af-yzo8fo.3). The delivery door already resolves the proposals the
    # merge answers.
    waiters=$(active_waiters_for "$bead")
    wake_reason=""
    [ -n "$waiters" ] && wake_reason="active waiter(s): $waiters"
    finalize_delivery "$rig_path" "$bead" "$repo" "$num" "$required_workflow"; rc=$?
    if timed_out "$rc"; then
      log "    delivery door timed out for bead $bead -- outcome unknown, re-checked next tick"
    elif [ "$rc" = 0 ]; then
      # Exact merge+CI proof is now the completion edge. Only after the door
      # succeeds may a former CI-failure finding close or a dependent wake.
      close_ci_failure_beads "$repo" "$rig_path" "$num" "merged at ${sha:0:8} with exact-head CI success"
      # af-4ruvv: this used to pass --from pr-autopilot for honest attribution.
      # `gc mail send` validates --from against live sessions (or "human")
      # only -- pr-autopilot is a deterministic exec script with no session,
      # so every wake with a non-empty $wake_reason failed with "session not
      # found: pr-autopilot", incrementing ERRORS and failing the whole order
      # (9x order.failed on 2026-09-28, clustered around merges: every one had
      # a fresh wake_reason). Omit --from; the message body's own "ACTION:
      # pr-autopilot reconciled ..." line already names the true actor.
      if [ -n "$wake_reason" ] && ! run bash -c "cd '$rig_path' && gc mail send mayor --notify \
        --subject 'SHIPPED: $bead via PR #$num' \
        --message 'ACTION: pr-autopilot reconciled $bead from merged PR #$num
STATE: SHIPPED
EVIDENCE: $bead; PR #$num; merge SHA $sha
NEXT: Mayor advances or finalizes work waiting on $bead.' >/dev/null 2>&1"; then
        log "    reconciliation wake failed for bead $bead"
        ERRORS=$((ERRORS+1))
      elif [ -z "$wake_reason" ]; then
        vlog "PR #$num: nothing waits on $bead -> metadata only, no wake"
      fi
      RECONCILED=$((RECONCILED+1))
    else
      log "    delivery proof rejected for bead $bead — leaving it open/unreleased"
      ERRORS=$((ERRORS+1))
    fi
  done <<<"$merged"

  # ---------- 2b. RECONCILE delivered_via_pr tickets (P07, af-87f9u) ----------
  # A distinct bead from the one(s) reconciled above can also name one of
  # this tick's merged PRs as its own delivery vehicle, via
  # gc.delivered_via_pr (formulas/mol-do-work.formula.toml, step 3c) --
  # separate from the loop above because that loop `continue`s past a PR with
  # no branch-linked candidate, which would otherwise skip this check too. An
  # unmerged, or closed-without-merging, named PR never appears in $merged, so
  # a ticket naming one of those simply stays open with nothing further to do.
  while IFS=$'\t' read -r num branch sha merged_at; do
    [ -z "${num:-}" ] && continue
    [ -n "${VIA_FOR[$num]:-}" ] || continue
    if over_budget; then not_checked "$repo delivered_via_pr for merged PR #$num and after it"; break; fi
    while IFS= read -r via_bead; do
      [ -z "$via_bead" ] && continue
      log "  PR #$num merged at ${sha:0:8} -> delivered_via_pr reconciles $via_bead"
      finalize_delivery "$rig_path" "$via_bead" "$repo" "$num" "$required_workflow"; rc=$?
      if timed_out "$rc"; then
        log "    delivery door timed out for bead $via_bead -- outcome unknown, re-checked next tick"
      elif [ "$rc" = 0 ]; then
        via_waiters=$(active_waiters_for "$via_bead")
        via_wake_reason=""
        [ -n "$via_waiters" ] && via_wake_reason="active waiter(s): $via_waiters"
        if [ -n "$via_wake_reason" ] && ! run bash -c "cd '$rig_path' && gc mail send mayor --notify \
          --subject 'SHIPPED: $via_bead via PR #$num' \
          --message 'ACTION: pr-autopilot reconciled $via_bead from merged PR #$num (delivered via another ticket)
STATE: SHIPPED
EVIDENCE: $via_bead; PR #$num; merge SHA $sha
NEXT: Mayor advances or finalizes work waiting on $via_bead.' >/dev/null 2>&1"; then
          log "    reconciliation wake failed for bead $via_bead"
          ERRORS=$((ERRORS+1))
        fi
        RECONCILED=$((RECONCILED+1))
      else
        log "    delivery proof rejected for delivered_via_pr bead $via_bead — leaving it open/unreleased"
        ERRORS=$((ERRORS+1))
      fi
    done < <(delivered_via_pr_candidates_for "$num")
  done <<<"$merged"
done

repo_done
log ""
log "armed=$ARMED reconciled=$RECONCILED flagged=$FLAGGED held=$HELD skipped=$SKIPPED errors=$ERRORS"
# Slow, cut short or partly timed out: what each repo cost and the host load.
if [ "$SECONDS" -ge "$AP_SLOW" ] || [ "${#AP_NOT_CHECKED[@]}" -gt 0 ] || [ -s "$AP_TMO" ]; then
  log "timing: ${SECONDS}s of a ${AP_BUDGET}s budget — loadavg $(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)"
  [ "${#AP_TIMINGS[@]}" -gt 0 ] && log "  repos: $(printf '%s · ' "${AP_TIMINGS[@]}" | sed 's/ · $//')"
  [ -s "$AP_TMO" ] && sed 's/^/  timed out: /' "$AP_TMO"
  [ "${#AP_NOT_CHECKED[@]}" -gt 0 ] && printf '  not checked (time budget exhausted): %s\n' "${AP_NOT_CHECKED[@]}"
fi
# Skipped or timed-out work is retried next tick (3 min): only real errors fail the order.
[ "$ERRORS" -gt 0 ] && exit 1
exit 0
