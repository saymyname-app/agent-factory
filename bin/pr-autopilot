#!/usr/bin/env bash
# pr-autopilot — deterministic (L0, zero-token) merge actor for the SayMyName rigs.
#
# Closes the delivery loop without spending a single model token:
#   1. ARM     every open non-draft PR targeting a rig's dev branch with GitHub
#              auto-merge (squash). GitHub then merges it itself the moment the
#              required status check goes green. Nothing polls, nothing watches.
#   2. FINALIZE merged PRs through bin/deliver-close only after the configured
#              required workflow succeeded on the exact PR head. The door
#              writes merge_result/merged_sha/merged_target + CI proof and
#              closes the work bead atomically.
#   3. FLAG    PRs whose required checks failed, as a P1 bead, so a red build is
#              visible as work instead of silently sitting open.
#   4. HOLD    PRs whose migrations are not undoable inside the release
#              (bin/reversibility-check, ADR-0019): never armed, disarmed if
#              already armed, labelled and explained once on the PR. A change
#              declared irreversible is escalated to the Mayor (test 4 of
#              ADR-0016) and only ever merged by a human.
#
# Production safety: PRs targeting anything other than the rig's dev branch are
# never armed. dev -> main promotion stays a human decision by construction.
#
# Usage: pr-autopilot [--dry-run] [--verbose]
set -uo pipefail

FACTORY="${FACTORY_ROOT:-/home/benja/agent-factory}"
DRY_RUN=0
VERBOSE=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --verbose|-v) VERBOSE=1 ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

# rig_dir | repo | dev branch | required GitHub Actions workflow
RIGS=(
  "rigs/saymyname-backend|saymyname-app/Say-my-name-back|dev|Backend CI"
  "rigs/saymyname-frontend|saymyname-app/Say-my-name-front|dev|Frontend CI"
  # The Factory's own repo. Its only long-lived branch is main and it now has a
  # required check (Factory CI), so the same rule applies: green check merges
  # itself, red check becomes a bead. Without this, agent-factory branches pile
  # up unmerged — 28 of them by 2026-09-15.
  ".|saymyname-app/agent-factory|main|Factory CI"
)
DELIVER_CLOSE_BIN="${DELIVER_CLOSE_BIN:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/deliver-close}"
DELIVERY_PROOF_BIN="${DELIVERY_PROOF_BIN:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../lib" && pwd -P)/factory_delivery_proof.py}"

log()  { printf '%s\n' "$*"; }
vlog() { [ "$VERBOSE" = "1" ] && printf '  %s\n' "$*"; return 0; }
run()  { if [ "$DRY_RUN" = "1" ]; then log "  DRY-RUN: $*"; return 0; fi; "$@"; }

finalize_delivery() {  # rig-path bead repo pr required-workflow
  local rig_path=$1 bead=$2 repo=$3 pr=$4 workflow=$5
  if [ "$DRY_RUN" = "1" ]; then
    log "  DRY-RUN: $DELIVER_CLOSE_BIN $bead --repo $repo --pr $pr --required-workflow $workflow"
    return 0
  fi
  (
    cd "$rig_path" || exit 1
    "$DELIVER_CLOSE_BIN" "$bead" --repo "$repo" --pr "$pr" \
      --required-workflow "$workflow" \
      --reason "Merged PR #$pr after required workflow '$workflow' succeeded on the exact PR head."
  )
}

ARMED=0; RECONCILED=0; FLAGGED=0; SKIPPED=0; ERRORS=0; HELD=0
TMPDIR_AP=$(mktemp -d); trap 'rm -rf "$TMPDIR_AP"' EXIT

# O3: the order (orders/pr-autopilot.toml) hard-kills the whole run at 120s
# with no trace at all -- the same gap as C8/mayor-campaign, seen here in
# `context deadline exceeded` events (9 in 24h, live). A stuck `gh` call on
# one repo used to be able to burn the whole budget silently. $SECONDS is
# bash's own elapsed-time counter since the script started; checked once per
# repo, leaving margin below the order's hard kill to still report and exit
# cleanly instead of being SIGKILLed.
TICK_DEADLINE_SECONDS="${PR_AUTOPILOT_TICK_DEADLINE_SECONDS:-100}"

# af-i3k3f (B02): PR #209's fix made the RECONCILE loop re-verify every
# already-terminal merged PR with a live `gc bd show` before trusting the
# once-per-tick snapshot -- correct, but paid on EVERY PR in the last-30-
# merged window, EVERY tick, forever, growing with the rig's own history. A
# live measurement on 2026-09-24 showed one full pr-autopilot tick (three
# repos) taking 100-107s against this same order's 100s soft / 120s hard
# (SIGKILL, no trace) budget -- almost entirely spent inside agent-factory's
# own already-proven-PR re-verification. A merged PR's bead, once actually
# observed status=closed live, can never legitimately un-close through this
# path again, so that one live confirmation is durable: record it here and
# never re-pay the Dolt round trip for the same repo#PR on a later tick. New
# merges (not yet in the cache) still get the exact live re-check PR #209
# added -- this only removes the *repeated* cost, not the protection.
RECONCILE_CACHE="${PR_AUTOPILOT_RECONCILE_CACHE:-$FACTORY/.gc/pr-autopilot-reconciled-cache.tsv}"

# A first reconciliation is not automatically a useful wake. When closed
# history became visible (af-6s0xy), old merges were backfilled correctly but
# each one also mailed the Mayor. Keep the durable backfill, and wake only for
# a merge fresh enough to belong to the current delivery loop or when live work
# explicitly waits on the reconciled bead. The clock override keeps the policy
# deterministic under test.
RECONCILE_WAKE_WINDOW_SECONDS="${PR_AUTOPILOT_RECONCILE_WAKE_WINDOW_SECONDS:-3600}"
RECONCILE_NOW_EPOCH="${PR_AUTOPILOT_NOW_EPOCH:-$(date -u +%s)}"
case "$RECONCILE_WAKE_WINDOW_SECONDS" in *[!0-9]*|'') log "invalid reconciliation wake window"; exit 2 ;; esac
case "$RECONCILE_NOW_EPOCH" in *[!0-9]*|'') log "invalid reconciliation clock"; exit 2 ;; esac

merge_is_recent() {  # mergedAt -> 0 when within the bounded wake window
  local merged_at=$1 merged_epoch age
  [ -n "$merged_at" ] || return 1
  merged_epoch=$(jq -nr --arg timestamp "$merged_at" '$timestamp|fromdateiso8601' 2>/dev/null) || return 1
  case "$merged_epoch" in *[!0-9]*|'') return 1 ;; esac
  age=$((RECONCILE_NOW_EPOCH - merged_epoch))
  [ "$age" -ge 0 ] && [ "$age" -le "$RECONCILE_WAKE_WINDOW_SECONDS" ]
}

active_waiters_for() {  # bead -> comma-separated open/in_progress waiter ids
  local bead=$1
  printf '%s' "$RIG_ALL_BEADS_JSON" | jq -r --arg bead "$bead" '
    [.[]
      | select(.id != $bead)
      | select(.status == "open" or .status == "in_progress")
      | select(
          (.metadata["gc.waiting_on"] // "") == $bead
          or any(.dependencies[]?;
            ((.depends_on_id // .id // "") == $bead)
            and ((.type // .dependency_type // "") == "blocks")))
      | .id]
    | unique | join(",")
  ' 2>/dev/null
}

# ---------- reversibility gate (ADR-0019) ----------
# docs/DELIVERY.md calls Flyway changes GUARDED, yet this actor used to arm
# every green PR to dev, migrations included -- two DROP COLUMNs among them.
# The verdict is cached per PR head commit, so a PR is diffed once per push.
REV_CHECK="${REVERSIBILITY_CHECK_BIN:-$FACTORY/bin/reversibility-check}"
REV_CACHE="${REVERSIBILITY_CACHE:-$FACTORY/.gc/reversibility-cache.tsv}"
HOLD_LABELS="reversibility-declaration-needed irreversible-change"

reversibility_gate() {  # repo num sha labels armed -> 0 proceed, 1 hold
  local repo=$1 num=$2 sha=$3 labels=" $4 " armed=$5
  local key="$repo#$num@$sha" rc label color
  rc=$(grep -F "${key}"$'\t' "$REV_CACHE" 2>/dev/null | tail -1 | cut -f2)
  if [ -z "$rc" ]; then
    "$REV_CHECK" --pr "$num" --repo "$repo" --json >/dev/null 2>&1; rc=$?
    if [ "$rc" != "2" ]; then
      mkdir -p "$(dirname "$REV_CACHE")"
      printf '%s\t%s\n' "$key" "$rc" >> "$REV_CACHE"
    fi
  fi
  case "$rc" in
    0)
      for l in $HOLD_LABELS; do
        case "$labels" in *" $l "*)
          log "  PR #$num: reversibility now ok -> removing '$l'"
          run gh pr edit "$num" --repo "$repo" --remove-label "$l" >/dev/null 2>&1 ;;
        esac
      done
      return 0 ;;
    3|4)
      if [ "$rc" = "4" ]; then label=irreversible-change; color=B60205
      else label=reversibility-declaration-needed; color=FBCA04; fi
      if [ "$armed" != "null" ] && [ -n "$armed" ]; then
        log "  PR #$num: disarming auto-merge (reversibility)"
        run gh pr merge "$num" --repo "$repo" --disable-auto >/dev/null 2>&1
      fi
      case "$labels" in
        *" $label "*) vlog "PR #$num: held ($label), already explained on the PR" ;;
        *)
          log "  PR #$num: HELD -> $label"
          "$REV_CHECK" --pr "$num" --repo "$repo" --comment > "$TMPDIR_AP/comment.md" 2>/dev/null
          run gh label create "$label" --repo "$repo" --color "$color" --force \
            --description "pr-autopilot reversibility gate (ADR-0019)" >/dev/null 2>&1
          run gh pr comment "$num" --repo "$repo" --body-file "$TMPDIR_AP/comment.md" >/dev/null 2>&1
          run gh pr edit "$num" --repo "$repo" --add-label "$label" >/dev/null 2>&1
          if [ "$rc" = "4" ]; then
            run bash -c "cd '$FACTORY' && gc mail send mayor --from mayor --notify \
              --subject 'ESCALADE test 4 · PR #$num irréversible ($repo)' \
              --message 'Auteur : pr-autopilot (script déterministe), pas Benjamin. La PR https://github.com/$repo/pull/$num contient une migration déclarée irréversible. Test d escalade 4 (ADR-0016) : ne la fusionne pas toi-même ; mets ce sous-graphe en attente et soumets la décision à Benjamin avec la raison déclarée dans la migration. Le reste de la campagne continue.'" >/dev/null 2>&1
          fi ;;
      esac
      HELD=$((HELD+1))
      return 1 ;;
    *)
      log "  PR #$num: reversibility could not be checked -> not arming this pass (fail closed)"
      ERRORS=$((ERRORS+1))
      return 1 ;;
  esac
}

# af-grln2: a draft, DIRTY, BEHIND, BLOCKED, or zero-check PR used to get one
# identical log line every pass, forever -- indistinguishable from one
# quietly waiting its natural turn. This acts directly on data the loop
# already fetched this tick (mergeStateStatus, statusCheckRollup, labels) --
# no separate read, matching the audit's "act in the mechanism" ask. A label
# is the memory of "seen before": the first stuck pass just marks it: the
# label already being present is what proves it survived to a second pass,
# so a bead is only filed once a PR is stuck across passes, not on the first.
STUCK_LABEL="autopilot-stuck"

stuck_reason() {  # mergeStateStatus checks -> prints why the PR is stuck, or nothing
  local state=$1 checks=$2 reason=""
  case "$state" in
    DIRTY) reason="merge conflict (DIRTY)" ;;
    # BLOCKED is the NORMAL state while a required check is still running (the
    # repo ruleset requires "Tests"): a healthy PR whose CI outlasts two passes
    # is waiting, not stuck. Only BLOCKED with nothing left pending is.
    BLOCKED) [ "$checks" = "PENDING" ] || reason="blocked (no check is pending: a required check never ran or another merge rule is unmet)" ;;
    BEHIND) reason="behind base (needs a merge/rebase to pick up new required checks)" ;;
  esac
  [ "$checks" = "NONE" ] && reason="${reason:+$reason; }no status check ever reported"
  printf '%s' "$reason"
}

stuck_beads() {  # num -> ids of the open stuck bead(s) filed for this PR
  # By title prefix, not the full title: the reason can change between passes
  # (DIRTY -> BEHIND) and is unknown once the PR has recovered.
  # af-k1f97: reads the per-rig $RIG_OPEN_BEADS_JSON cache (fetched once per
  # rig) instead of shelling out to `gc bd list` per PR -- see that variable's
  # definition below for why.
  printf '%s' "$RIG_OPEN_BEADS_JSON" \
    | jq -r --arg t "[autopilot] PR #$1 stuck:" '.[]|select((.title//"")|startswith($t))|.id' 2>/dev/null
}

ci_failure_beads() {  # num -> ids of the open "[ci] PR #num failed" bead(s) filed for this PR
  # af-gpq0y: smb-au8d ("[ci] PR #47 failed required checks", P1) stayed open
  # after PR #47's checks went green and it merged -- nothing ever closed the
  # flag once the failure it reported was resolved. By title prefix, same
  # reasoning as stuck_beads: the base branch name is fixed per rig here so
  # the full title is stable, but matching the prefix keeps this resilient if
  # that ever changes.
  printf '%s' "$RIG_OPEN_BEADS_JSON" \
    | jq -r --arg t "[ci] PR #$1 failed" '.[]|select((.title//"")|startswith($t))|.id' 2>/dev/null
}

close_ci_failure_beads() {  # repo rig_path num reason
  local repo=$1 rig_path=$2 num=$3 reason=$4 b
  for b in $(ci_failure_beads "$num"); do
    log "  PR #$num: $reason -> closing CI-failure bead $b"
    run bash -c "cd '$rig_path' && gc bd update '$b' --status closed \
      --append-notes 'Closed by pr-autopilot: PR #$num $reason.'"
  done
}

stuck_pr() {  # repo rig_path num mergeStateStatus checks labels
  local repo=$1 rig_path=$2 num=$3 state=$4 checks=$5 labels=" ${6//,/ } "
  local reason
  reason=$(stuck_reason "$state" "$checks")
  [ -n "$reason" ] || return 0
  case "$labels" in
    *" $STUCK_LABEL "*)
      title="[autopilot] PR #$num stuck: $reason"
      if [ -z "$(stuck_beads "$num")" ]; then
        log "  PR #$num: stuck across passes ($reason) -> filing"
        run bash -c "cd '$rig_path' && gc bd create '$title' -p 2 -t bug \
          -d 'PR stuck across multiple pr-autopilot passes (every 3 min): $reason.
https://github.com/$repo/pull/$num
Not armable as-is; needs a human/Mayor look (resolve conflicts, push a commit to (re)trigger the required check, or rebase onto the latest base). pr-autopilot only observes and pages -- it never resolves a conflict or forces a check to run.' \
          --metadata '{\"pr_number\":\"$num\",\"source\":\"pr-autopilot\"}'"
        run gh pr comment "$num" --repo "$repo" \
          --body "pr-autopilot: this PR has been $reason across multiple passes and needs attention (filed as a bead)." >/dev/null 2>&1
        FLAGGED=$((FLAGGED+1))
      else
        vlog "PR #$num: stuck ($reason), already filed"
      fi
      ;;
    *)
      run gh label create "$STUCK_LABEL" --repo "$repo" --color EDEDED --force \
        --description "pr-autopilot: not armable across at least 2 passes" >/dev/null 2>&1
      run gh pr edit "$num" --repo "$repo" --add-label "$STUCK_LABEL" >/dev/null 2>&1
      vlog "PR #$num: stuck ($reason), marked -- filing next pass if still stuck"
      ;;
  esac
}

# A required check failing is not proof the PR is broken -- GitHub's own
# hosted runners occasionally never get past actions/checkout's initial
# fetch (a not-yet-warm TLS cert store, a network blip reaching github.com):
# the job fails within seconds, before a single test line runs. Give every
# required-check failure exactly one automatic retry per commit before
# paging anyone: a real code failure reproduces identically and falls
# straight through to the flag below on the very next pass; a transient one
# usually clears without anyone noticing it happened. The marker is a PR
# comment naming the exact head SHA, not a label -- a label survives a new
# push and would silently skip the retry on a commit that was never
# actually retried.
retry_ci_failure() {  # repo num sha workflow -> 0 retried this pass, 1 flag as before
  local repo=$1 num=$2 sha=$3 workflow=$4 marker run_id
  marker="pr-autopilot: retried CI once for ${sha:0:12}"
  gh pr view "$num" --repo "$repo" --json comments --jq '.comments[].body' 2>/dev/null \
    | grep -qF "$marker" && return 1
  run_id=$(gh run list --repo "$repo" --commit "$sha" --json databaseId,name,conclusion \
    --jq --arg wf "$workflow" \
    '[.[]|select(.name==$wf and .conclusion=="failure")][0].databaseId // empty' 2>/dev/null)
  [ -n "$run_id" ] || return 1
  log "  PR #$num: required check failed -> retrying once (run $run_id)"
  run gh run rerun "$run_id" --repo "$repo" --failed >/dev/null 2>&1 || return 1
  run gh pr comment "$num" --repo "$repo" --body "$marker" >/dev/null 2>&1
  return 0
}

for entry in "${RIGS[@]}"; do
  if [ "$SECONDS" -ge "$TICK_DEADLINE_SECONDS" ]; then
    log "TICK_TIMEOUT: ${SECONDS}s elapsed (budget ${TICK_DEADLINE_SECONDS}s) -- stopping before $entry, remaining repos wait for the next run"
    ERRORS=$((ERRORS+1))
    break
  fi
  IFS='|' read -r rig_dir repo dev required_workflow <<<"$entry"
  log "=== $repo (base: $dev) ==="
  rig_path="$FACTORY/$rig_dir"
  [ -d "$rig_path" ] || { log "  SKIP: $rig_path missing"; ERRORS=$((ERRORS+1)); continue; }

  # af-k1f97: fetch this rig's bead lists ONCE per tick and reuse them for
  # every PR below, instead of re-running `gc bd list` per PR. The RECONCILE
  # loop used to run close_ci_failure_beads() (one `gc bd list --status open`)
  # plus a second unfiltered `gc bd list` per merged PR -- up to 60 calls for
  # ~30 merged PRs on one rig, each measured at ~4.6s, which alone blew the
  # whole tick's 100s budget before agent-factory (rig 3) was ever reached.
  # Stale-within-a-tick is fine: a bead this script itself closes/creates for
  # PR N is never looked up again for that same N within the same pass, and a
  # PR cannot be both "open" and "merged" in the same `gh pr list` snapshot.
  RIG_OPEN_BEADS_JSON=$(cd "$rig_path" && gc bd list --status open --json 2>/dev/null)
  [ -n "$RIG_OPEN_BEADS_JSON" ] || RIG_OPEN_BEADS_JSON='[]'

  # ---------- 1. ARM open PRs targeting dev ----------
  open_prs=$(gh pr list --repo "$repo" --state open --base "$dev" --limit 50 \
    --json number,isDraft,autoMergeRequest,mergeStateStatus,statusCheckRollup,headRefOid,labels 2>/dev/null)
  # A fine-grained token cannot read check runs; rebuild them from Actions runs.
  [ -n "$open_prs" ] || open_prs=$(gh pr list --repo "$repo" --state open --base "$dev" --limit 50 \
    --json number,isDraft,autoMergeRequest,mergeStateStatus,headRefOid,labels 2>/dev/null \
    | "$(dirname "${BASH_SOURCE[0]}")/factory-gh-rollup" "$repo" 2>/dev/null)
  if [ -z "$open_prs" ]; then
    log "  (could not list open PRs)"; ERRORS=$((ERRORS+1)); open_prs='[]'
  fi

  while IFS=$'\t' read -r num draft armed state checks sha labels; do
    [ -z "${num:-}" ] && continue
    if [ "$draft" = "true" ]; then
      vlog "PR #$num: draft, not arming"; SKIPPED=$((SKIPPED+1)); continue
    fi

    # A PR that recovered (state healthy again) sheds the stuck label; a
    # human/Mayor fixing it manually should not leave a stale marker behind --
    # nor the bead filed for it, which nothing else would ever close.
    case " ${labels//,/ } " in
      *" $STUCK_LABEL "*)
        if [ -z "$(stuck_reason "$state" "$checks")" ]; then
          run gh pr edit "$num" --repo "$repo" --remove-label "$STUCK_LABEL" >/dev/null 2>&1
          vlog "PR #$num: no longer stuck -> removed $STUCK_LABEL"
          for stale in $(stuck_beads "$num"); do
            log "  PR #$num: recovered -> closing stuck bead $stale"
            run bash -c "cd '$rig_path' && gc bd update '$stale' --status closed \
              --append-notes 'Closed by pr-autopilot: PR #$num is no longer stuck (state=$state, checks=$checks).'"
          done
        fi ;;
    esac

    # af-gpq0y: checks recovered to green (or reset to pending/none, e.g. a
    # new commit re-ran them) without the PR merging yet -- close any
    # previously filed CI-failure bead now, the same way the stuck-label
    # recovery above does, instead of waiting for the merge pass below.
    [ "$checks" = "FAILURE" ] || close_ci_failure_beads "$repo" "$rig_path" "$num" "checks are now '$checks' (no longer FAILURE)"

    # Red required check -> retry once (maybe transient), else flag as work.
    if [ "$checks" = "FAILURE" ]; then
      if retry_ci_failure "$repo" "$num" "$sha" "$required_workflow"; then
        vlog "PR #$num: retried once, re-checking next pass"
        continue
      fi
      log "  PR #$num: required checks FAILED -> flagging"
      title="[ci] PR #$num failed required checks on $dev"
      existing=$(printf '%s' "$RIG_OPEN_BEADS_JSON" \
        | jq -r --arg t "$title" '[.[]|select(.title==$t)]|length' 2>/dev/null)
      if [ "${existing:-0}" = "0" ]; then
        run bash -c "cd '$rig_path' && gc bd create '$title' -p 1 -t bug \
          -d 'Required status check failed twice on the same commit (one automatic retry already attempted). PR: https://github.com/$repo/pull/$num
Auto-merge was not armed. Fix the build, then pr-autopilot will arm it on the next pass.' \
          --metadata '{\"pr_number\":\"$num\",\"source\":\"pr-autopilot\"}'"
        FLAGGED=$((FLAGGED+1))
      else
        vlog "PR #$num: failure already tracked"
      fi
      continue
    fi

    # af-grln2: a DIRTY/BLOCKED/BEHIND merge state or a PR with no status
    # check at all is not fixed by arming auto-merge -- GitHub accepts the
    # arm request regardless and just waits, so this must be evaluated here,
    # independent of whether arming below succeeds.
    stuck_pr "$repo" "$rig_path" "$num" "$state" "$checks" "$labels"

    # Before the "already armed" shortcut: a push can add a destructive
    # migration to a PR that was armed while it was harmless. (The labels field
    # is never empty -- jq writes "-" -- because read would swallow it.)
    reversibility_gate "$repo" "$num" "$sha" "${labels//,/ }" "$armed" || continue

    if [ "$armed" != "null" ] && [ -n "$armed" ]; then
      vlog "PR #$num: auto-merge already armed"; SKIPPED=$((SKIPPED+1)); continue
    fi

    log "  PR #$num: arming auto-merge (squash, state=$state)"
    if [ "$DRY_RUN" = "1" ]; then
      log "  DRY-RUN: gh pr merge $num --repo $repo --auto --squash --delete-branch"
      ARMED=$((ARMED+1))
    else
      if gh pr merge "$num" --repo "$repo" --auto --squash --delete-branch >/dev/null 2>&1; then
        ARMED=$((ARMED+1))
      else
        # Hard rule (gastown land-and-deploy): never retry `gh pr merge` after a
        # non-zero exit. Re-read authoritative server state instead.
        after=$(gh pr view "$num" --repo "$repo" --json state,autoMergeRequest \
          --jq '[.state,(.autoMergeRequest!=null)]|@tsv' 2>/dev/null)
        case "$after" in
          MERGED*) log "    already merged server-side"; ARMED=$((ARMED+1)) ;;
          *true)   log "    auto-merge is armed server-side"; ARMED=$((ARMED+1)) ;;
          *)
            # GitHub refuses allow_auto_merge on a private repo without Pro, so
            # arming is simply unavailable there. Fall back to the documented
            # direct path: merge only once the required checks are actually
            # green, which is the same gate auto-merge would have waited for.
            if [ "$checks" = "OK" ] && [ "$state" = "CLEAN" ]; then
              log "    auto-merge unavailable; checks green -> direct squash merge"
              if gh pr merge "$num" --repo "$repo" --squash --delete-branch >/dev/null 2>&1; then
                log "    merged"; ARMED=$((ARMED+1))
              else
                # A non-zero exit here does NOT mean the merge failed. gh also
                # returns non-zero when it merged fine but could not delete the
                # local branch -- which is what happens whenever a leftover
                # worktree still pins it. Same rule as above: never retry, ask
                # the server what actually happened.
                final=$(gh pr view "$num" --repo "$repo" --json state \
                  --jq .state 2>/dev/null)
                if [ "$final" = "MERGED" ]; then
                  log "    merged (local cleanup failed; see factory-guard worktrees)"
                  ARMED=$((ARMED+1))
                else
                  log "    direct merge failed — left for a human"; ERRORS=$((ERRORS+1))
                fi
              fi
            else
              log "    not armable and checks are '$checks'/'$state' — waiting, not merging"
            fi ;;
        esac
      fi
    fi
  done < <(printf '%s' "$open_prs" | jq -r '.[]|[
      .number, (.isDraft|tostring), (.autoMergeRequest|if .==null then "null" else "armed" end),
      (.mergeStateStatus//"?"),
      ((.statusCheckRollup//[]) as $roll|$roll|map(.conclusion//.state//"")|
        if any(.=="FAILURE" or .=="ERROR" or .=="TIMED_OUT") then "FAILURE"
        elif length==0 then "NONE"
        # A check run not yet COMPLETED, or a commit status still PENDING/EXPECTED.
        elif ($roll|any((.status//"COMPLETED")!="COMPLETED" or .state=="PENDING" or .state=="EXPECTED")) then "PENDING"
        else "OK" end),
      (.headRefOid//"unknown"),
      ((.labels//[])|map(.name)|join(",")|if .=="" then "-" else . end)
    ]|@tsv' 2>/dev/null)

  # ---------- 2. RECONCILE merged PRs onto their beads ----------
  # This pack's publisher does NOT write pr_number metadata (that was the
  # un-imported refinery's convention). The reliable link here is the branch:
  # bead metadata `gc.work_branch` == PR headRefName.
  merged=$(gh pr list --repo "$repo" --state merged --base "$dev" --limit 30 \
    --json number,headRefName,mergeCommit,mergedAt 2>/dev/null \
    | jq -r '.[]|[.number,.headRefName,(.mergeCommit.oid//""),(.mergedAt//"")]|@tsv' 2>/dev/null)

  # The work bead now remains in_progress while its PR is under review. Keep
  # the full-history lookup for pre-gate false-close records and historical
  # backfills; it also avoids a race between merge and a status-filtered read.
  RIG_ALL_BEADS_JSON='[]'
  if [ -n "$merged" ]; then
    RIG_ALL_BEADS_JSON=$(cd "$rig_path" && gc bd list --all --limit 0 --json 2>/dev/null)
    [ -n "$RIG_ALL_BEADS_JSON" ] || RIG_ALL_BEADS_JSON='[]'
  fi

  while IFS=$'\t' read -r num branch sha merged_at; do
    [ -z "${num:-}" ] && continue
    [ -z "${branch:-}" ] && continue

    # The flag beads filed above ("[ci] ... failed", "[autopilot] ... stuck")
    # carry pr_number too; they are about the PR, not the work it delivers, and
    # must never be stamped merged in place of the work bead.
    candidate=$(printf '%s' "$RIG_ALL_BEADS_JSON" \
      | jq -r --arg b "$branch" --arg n "$num" \
        '[.[]|select((.metadata.source//"")!="pr-autopilot")
              |select((.metadata["gc.work_branch"]//"")==$b
                     or (.metadata.pr_number|tostring)==$n)][0] // empty
         | @json' 2>/dev/null)
    [ -z "$candidate" ] && { vlog "PR #$num ($branch): no linked work bead"; continue; }
    bead=$(printf '%s' "$candidate" | jq -r '.id // empty' 2>/dev/null)
    [ -z "$bead" ] && { vlog "PR #$num ($branch): linked bead has no id"; continue; }

    # A legacy pass could already have written merge_result=merged without the
    # exact-head CI tuple.  Re-run those partial records through the single
    # delivery door after this gate reaches the live root.  Fully proven rows
    # and explicit no-op/blocked/abandoned outcomes remain terminal.
    readiness=$(printf '%s' "$candidate" | python3 "$DELIVERY_PROOF_BIN" --mode readiness 2>/dev/null || true)
    readiness_reason=$(printf '%s' "$readiness" | jq -r '.reason // empty' 2>/dev/null)
    merge_result=$(printf '%s' "$candidate" | jq -r '.metadata.merge_result // empty' 2>/dev/null)
    already_terminal=0
    if [ "$readiness_reason" = "explicit-non-delivery" ] \
      || { [ "$merge_result" = "merged" ] && printf '%s' "$readiness" | jq -e '.ready == true' >/dev/null 2>&1; }; then
      already_terminal=1
    fi
    # This tick's whole bead snapshot (RIG_ALL_BEADS_JSON) is fetched once, up
    # front, for performance (af-k1f97) -- by the time this loop reaches a
    # given PR it can be stale relative to the live store. Trusting it to SKIP
    # the only step that ever closes a delivery bead is the one place
    # staleness is fatal: af-cfl9j (B01) sat merged, CI-proven, and stuck
    # in_progress for 1h40 because a stale snapshot said "already terminal"
    # and nothing ever re-checked it. A fresh, single `gc bd show` right
    # before trusting that verdict is cheap (paid only for PRs this tick
    # already believes are done) and closes that failure mode regardless of
    # what staled the snapshot.
    if [ "$already_terminal" = "1" ]; then
      cache_key="$repo#$num"
      if grep -qF "${cache_key}"$'\t' "$RECONCILE_CACHE" 2>/dev/null; then
        vlog "PR #$num ($branch): delivery already terminal and proven (cached, no live re-check)"
        continue
      fi
      live_status=$(cd "$rig_path" && gc bd show "$bead" --json 2>/dev/null | jq -r '.[0].status // empty' 2>/dev/null)
      if [ "$live_status" = "closed" ]; then
        vlog "PR #$num ($branch): delivery already terminal and proven"
        mkdir -p "$(dirname "$RECONCILE_CACHE")"
        printf '%s\t%s\n' "$cache_key" "$bead" >> "$RECONCILE_CACHE"
        continue
      fi
      log "  PR #$num ($branch): snapshot said already-terminal but live bead $bead is '${live_status:-unknown}' -- reconciling for real"
    fi
    log "  PR #$num merged at ${sha:0:8} -> reconciling bead $bead"
    waiters=$(active_waiters_for "$bead")
    wake_reason=""
    if merge_is_recent "$merged_at"; then
      wake_reason="merge $merged_at is within ${RECONCILE_WAKE_WINDOW_SECONDS}s"
    elif [ -n "$waiters" ]; then
      wake_reason="active waiter(s): $waiters"
    fi
    if finalize_delivery "$rig_path" "$bead" "$repo" "$num" "$required_workflow"; then
      # Exact merge+CI proof is now the completion edge. Only after the door
      # succeeds may a former CI-failure finding close or a dependent wake.
      close_ci_failure_beads "$repo" "$rig_path" "$num" "merged at ${sha:0:8} with exact-head CI success"
      if [ -n "$wake_reason" ] && ! run bash -c "cd '$rig_path' && gc mail send mayor --from pr-autopilot --notify \
        --subject 'SHIPPED: $bead via PR #$num' \
        --message 'ACTION: pr-autopilot reconciled $bead from merged PR #$num
STATE: SHIPPED
EVIDENCE: $bead; PR #$num; merge SHA $sha
NEXT: Mayor advances or finalizes work waiting on $bead.' >/dev/null 2>&1"; then
        log "    reconciliation wake failed for bead $bead"
        ERRORS=$((ERRORS+1))
      elif [ -z "$wake_reason" ]; then
        vlog "PR #$num: historical reconciliation has no active waiter -> metadata only"
      fi
      RECONCILED=$((RECONCILED+1))
    else
      log "    delivery proof rejected for bead $bead — leaving it open/unreleased"
      ERRORS=$((ERRORS+1))
    fi
  done <<<"$merged"
done

log ""
log "armed=$ARMED reconciled=$RECONCILED flagged=$FLAGGED held=$HELD skipped=$SKIPPED errors=$ERRORS"
[ "$ERRORS" -gt 0 ] && exit 1
exit 0
