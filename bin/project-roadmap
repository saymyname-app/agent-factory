#!/usr/bin/env python3
"""Validate a Project's structured Roadmap and check a Roadmap Step id.

A Roadmap (CONTEXT.md: Roadmap Step) is a TOML file of `[[step]]` tables,
each with an id, a title, a "done when" condition, an order, and a status
(to-do / in-progress / done), so the Cockpit and any tool can read the
current step without interpreting prose. `roadmap.md` in the same project
keeps the human-readable intent and cites the same ids; this tool only
reads the structured file.

Status changes by normal commit -- this tool never writes the roadmap, it
only validates it and answers whether a given id names one of its steps
(the check a Spec's `planning_run_target` needs, CONTEXT.md: Roadmap Step).
"""

from __future__ import annotations

import argparse
import json
import sys
import tomllib
from pathlib import Path
from typing import Any


PROGRAM = "project-roadmap"
VALID_STATUSES = ("todo", "in_progress", "done")
REQUIRED_FIELDS = ("id", "title", "done_when", "order", "status")


class RoadmapError(RuntimeError):
    """An actionable diagnostic about a Roadmap, naming the faulty step."""


def load_steps(path: Path) -> list[dict[str, Any]]:
    try:
        data = tomllib.loads(path.read_text())
    except OSError as exc:
        raise RoadmapError(f"cannot read roadmap {path}: {exc}") from exc
    except tomllib.TOMLDecodeError as exc:
        raise RoadmapError(f"{path} is not valid TOML: {exc}") from exc

    steps = data.get("step")
    if not isinstance(steps, list) or not steps:
        raise RoadmapError(f"{path} must declare at least one [[step]]")

    seen_ids: dict[str, int] = {}
    seen_orders: dict[Any, str] = {}
    for index, step in enumerate(steps):
        label = f"step[{index}]"
        if not isinstance(step, dict):
            raise RoadmapError(f"{label} must be a table")

        step_id = step.get("id")
        if not isinstance(step_id, str) or not step_id.strip():
            raise RoadmapError(f"{label} is missing a non-empty 'id'")
        label = f"step {step_id!r}"

        missing = [field for field in REQUIRED_FIELDS if field not in step]
        if missing:
            raise RoadmapError(f"{label} is missing required field(s): {', '.join(missing)}")

        for field in ("title", "done_when"):
            if not isinstance(step[field], str) or not step[field].strip():
                raise RoadmapError(f"{label} field {field!r} must be a non-empty string")

        if not isinstance(step["order"], int) or isinstance(step["order"], bool):
            raise RoadmapError(f"{label} field 'order' must be an integer")

        if step["status"] not in VALID_STATUSES:
            raise RoadmapError(
                f"{label} has unknown status {step['status']!r}; must be one of {VALID_STATUSES}"
            )

        if step_id in seen_ids:
            raise RoadmapError(f"duplicate step id {step_id!r} (steps {seen_ids[step_id]} and {index})")
        seen_ids[step_id] = index

        order = step["order"]
        if order in seen_orders:
            raise RoadmapError(
                f"duplicate order {order!r} shared by step {seen_orders[order]!r} and {label}"
            )
        seen_orders[order] = step_id

    return steps


def cmd_validate(args: argparse.Namespace) -> int:
    try:
        load_steps(Path(args.roadmap))
    except RoadmapError as exc:
        print(json.dumps({"valid": False, "error": str(exc)}, indent=2))
        return 1
    print(json.dumps({"valid": True}, indent=2))
    return 0


def cmd_check_target(args: argparse.Namespace) -> int:
    try:
        steps = load_steps(Path(args.roadmap))
    except RoadmapError as exc:
        print(json.dumps({"valid": False, "error": str(exc)}, indent=2))
        return 1

    for step in steps:
        if step["id"] == args.target:
            print(json.dumps({"valid": True, "step": step}, indent=2, sort_keys=True))
            return 0

    print(
        json.dumps(
            {"valid": False, "error": f"{args.target!r} does not name a Roadmap Step in {args.roadmap}"},
            indent=2,
        )
    )
    return 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    validate_parser = subparsers.add_parser(
        "validate", help="validate a roadmap.toml: required fields, no duplicate id/order, known status"
    )
    validate_parser.add_argument("roadmap", help="path to the roadmap TOML file")
    validate_parser.set_defaults(func=cmd_validate)

    check_parser = subparsers.add_parser(
        "check-target", help="verify a planning_run_target id names a Roadmap Step in this roadmap"
    )
    check_parser.add_argument("roadmap", help="path to the roadmap TOML file")
    check_parser.add_argument("target", help="the planning_run_target id to look up")
    check_parser.set_defaults(func=cmd_check_target)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
