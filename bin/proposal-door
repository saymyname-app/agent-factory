#!/usr/bin/env bash
#
# proposal-door — the one door for every proposal (C01 Cockpit V2, T07).
#
# Creates a proposal only with the same required fields an escalation-door
# request needs (quoi / pourquoi / que_faire, each option with its
# consequence and at most one "Recommandé" with its raison, langue = the
# Operator Language) -- no proposal producer writes `gc bd create ... -l
# proposal` by hand any more. Moves a proposal between states: accepter (->
# "à planifier"), rejeter (raison obligatoire), reporter (jusqu'à une
# heure). Every transition is traced on the bead (comment + metadata,
# acteur), never by erasing a prior trace.
#
# Proposals are Benjamin's hand (accepter / rejeter). One more transition,
# `resoudre`, exists for a proposal whose fix has already merged (2026-10-07:
# af-3yo0we, af-yc2ly0, af-1ai5e3, af-r2y2w9 stayed « pending » in the
# Cockpit's « Ce qui t'attend » for days after PRs #385, #376 and #340 had
# landed). It is legitimate only on proof of a merge: the proof must name a
# PR number or a commit sha, it is recorded on the bead, and the door
# refuses to resolve a proposal Benjamin already accepted or rejected -- his
# decision is never overridden by a delivery. bin/deliver-close calls it
# for every pending proposal a merged PR names (title, body, commits, or
# gc.resolves_proposal on the delivered ticket); bin/upstream-skills-check
# calls it for a mattpocock/skills proposal whose tag is at or before the
# pinned baseline. See docs/COCKPIT.md « Proposition résolue par une
# livraison fusionnée ».
#
# Two classes (ADR-0029, 2026-10-07 -- Intent, Benjamin: « oui pour R1 »):
#   maintenance  corrects a defect of the factory the producer observed,
#                without changing what the operator sees or must do, nor a
#                method rule (orders, guards, formulas, tests, docs, page
#                filters, technical thresholds). It never waits on the
#                operator: at creation this door files one bug bead
#                authorized by ADR-0029 (gc.authorized_by=ADR-0029), links
#                it to the proposal, moves the proposal to
#                `prise_en_charge`, and dispatches the
#                bead through the usual door (bin/factory-work-dispatch).
#                The Cockpit shows it in the health zone and the journal.
#   decision     changes what the operator sees or must do, a method rule,
#                a spend, a consent, personal data, an irreversible effect
#                or a product behaviour. It enters « Ce qui t'attend » and
#                must carry exactly one « Recommandé » option with its
#                raison -- refused otherwise, nothing written.
# In doubt the producer chooses `decision`. A maintenance bead that turns
# out to touch what the operator sees is stopped and reconverted
# (`reconvertir`), never pursued (ADR-0029 point 6).
#
# A proposal created before this door existed (no gc.proposal_* fields)
# stays readable -- this door never rewrites an existing proposal's
# fields, only adds the new ones going forward. The Cockpit shows it in
# the health zone as « à reformuler par la porte » (ADR-0029 point 4).
#
# Usage: proposal-door <command> [arguments]
#
# Commands:
#   create <json>               Create a proposal. <json> is a JSON object
#                                 carrying the same fields escalation-door's
#                                 `benjamin` command requires -- the door
#                                 infers nothing and refuses the write (no
#                                 bead created) if any is missing, malformed,
#                                 over 140 characters on one line, not in
#                                 the Operator Language, or not displayable
#                                 by the Cockpit as written (an identifier
#                                 such as af-xxx or #300, an internal term
#                                 outside the Cockpit Lexicon such as
#                                 « bead » or « Mayor ») -- the exact check
#                                 the Cockpit inbox applies, run here through
#                                 bin/operator-text-check so the producer
#                                 reads the reason instead of the operator
#                                 reading « incomplète » (2026-10-07):
#                                   quoi       -- one line, what the proposal
#                                                 is.
#                                   pourquoi   -- one line, why it is being
#                                                 proposed.
#                                   que_faire  -- a non-empty array of
#                                                 options, each {option,
#                                                 consequence, recommande?,
#                                                 raison?}; every option
#                                                 needs its consequence, at
#                                                 most one option may be
#                                                 recommande=true, and that
#                                                 one needs its raison.
#                                   langue     -- must equal the Operator
#                                                 Language.
#                                   classe     -- `maintenance` or
#                                                 `decision` (ADR-0029);
#                                                 a `decision` needs
#                                                 exactly one option
#                                                 recommande=true with
#                                                 its raison.
#                                   details    -- optional, one line, at
#                                                 most 1000 characters: the
#                                                 identifiers and evidence
#                                                 (bead ids, PR numbers,
#                                                 tool names) the three
#                                                 fields above may not
#                                                 hold. The Cockpit shows it
#                                                 only in the folded
#                                                 « Détails », unchecked.
#                                 On success, creates a bead labelled
#                                 `proposal` with those fields recorded as
#                                 metadata (gc.proposal_classe, state:
#                                 ouverte) and prints
#                                 "PROPOSITION CRÉÉE: <bead> — <quoi>".
#                                 For `maintenance`, then files the bug
#                                 bead (type bug, label maintenance,
#                                 gc.authorized_by=ADR-0029,
#                                 gc.source=proposal-door,
#                                 gc.proposal_id=<proposal>), relates the
#                                 two, sets the proposal to
#                                 prise_en_charge (gc.proposal_bug=<bead>,
#                                 traced), dispatches it, and prints
#                                 "PRISE EN CHARGE: <proposal> — ticket
#                                 <bead>".
#   accepter <bead> <acteur>    Accept: gc.proposal_state -> a_planifier,
#                                 traced (comment + metadata, acteur).
#   rejeter <bead> <raison> <acteur>
#                                Reject with a mandatory reason; refuses
#                                 (no write) without one. gc.proposal_state
#                                 -> rejetee, traced.
#   reporter <bead> <heure> <acteur>
#                                Defer until <heure> (free text: an hour or
#                                 a date); traced. State is unchanged --
#                                 a reported proposal is still pending.
#   resoudre <bead> <preuve> <acteur>
#                                Resolve a pending proposal on proof of a
#                                 merged delivery. <preuve> is one line that
#                                 must name a PR number (`#385`) or a commit
#                                 sha (7-40 hex); refused (no write)
#                                 otherwise, and refused on a proposal that
#                                 is not labelled `proposal` or is already
#                                 accepted / rejected / resolved.
#                                 gc.proposal_state -> resolue,
#                                 gc.proposal_resolved_by=<preuve>, traced
#                                 (comment + metadata, acteur).
#   reconvertir <proposition> <raison> <que_faire_json> <acteur>
#                                ADR-0029 point 6: a maintenance bead that
#                                 touches what the operator sees is
#                                 stopped, never pursued. Closes its bug
#                                 bead (reason traced), turns the proposal
#                                 into a `decision` (state ouverte) with
#                                 the given options -- exactly one
#                                 recommande=true with its raison, same
#                                 rules as create -- keeps the maintenance
#                                 options as gc.proposal_que_faire_maintenance,
#                                 and traces the reason and the acteur.
#                                 Refused (no write) on a proposal that is
#                                 not of class maintenance.
#   compte [--classe <classe>]  Read-only: print the count of proposals
#                                 still pending (open, labelled `proposal`,
#                                 not accepted, rejected, resolved nor
#                                 taken over as maintenance). A legacy
#                                 proposal with no gc.proposal_state counts
#                                 as pending. --classe keeps one class:
#                                 maintenance, decision (a proposal with
#                                 fields and no class counts as decision)
#                                 or sans_champs (no gc.proposal_* field).
#   list [--classe <classe>]    Read-only: one pending proposal per line,
#                                 "<bead>\t<classe>\t<state>\t<quoi>",
#                                 same filter as compte.
set -Eeuo pipefail

PROGRAM_NAME="proposal-door"
GC_BIN="${GC_BIN:-gc}"
MAX_DETAILS_LENGTH=1000
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P)"
OPERATOR_CONFIG_BIN="${OPERATOR_CONFIG_BIN:-$ROOT/bin/operator-config}"
OPERATOR_TEXT_CHECK_BIN="${OPERATOR_TEXT_CHECK_BIN:-$ROOT/bin/operator-text-check}"
BEAD_ID_RE='^[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+(\.[A-Za-z0-9]+)*$'
CLASSE_MAINTENANCE="maintenance"
CLASSE_DECISION="decision"
CLASSE_SANS_CHAMPS="sans_champs"
AUTHORIZING_ADR="ADR-0029"
MAYOR_RECIPIENT="${PROPOSAL_DOOR_MAYOR_RECIPIENT:-mayor}"
# The door a maintenance bead is dispatched through (af-yzo8fo.3).
DISPATCH_BIN="${PROPOSAL_DOOR_DISPATCH_BIN:-$ROOT/bin/factory-work-dispatch}"
# The acteur the door itself writes in a trace it authors (a take-over).
DOOR_ACTOR="proposal-door"

log() { printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2; }
die() { log "ERROR: $1"; exit 1; }

# The request fields check, shared with the other request door (T59).
REQUEST_INCOMPLETE="proposition incomplète"
# shellcheck source=lib/request_fields.sh
. "$ROOT/lib/request_fields.sh"

usage() {
  awk 'NR > 1 && /^set /{exit} NR > 1' "$0" | sed 's/^# \{0,1\}//'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is unavailable: $1"
}

valid_bead_id() {
  [[ $1 =~ $BEAD_ID_RE ]]
}

now_epoch() {
  printf '%s' "${PROPOSAL_DOOR_NOW:-$(date -u +%s)}"
}

now_iso() {
  date -u -d "@$(now_epoch)" +%Y-%m-%dT%H:%M:%SZ
}

operator_language() {  # prints the Operator Language, or dies
  local out
  out=$("$OPERATOR_CONFIG_BIN" language 2>&1) \
    || die "Could not read the Operator Language: $out"
  printf '%s' "$out"
}

show_bead() {  # $1 = bead id -> prints the single-object JSON, or dies
  local id=$1 raw
  raw=$("$GC_BIN" bd show "$id" --json 2>/dev/null) \
    || die "$id is unavailable."
  jq -e 'if type == "array" then (if length == 1 then .[0] else error("ambiguous") end) else . end' \
    <<<"$raw" 2>/dev/null || die "$id did not resolve to exactly one Bead."
}

# validate_classe checks the class field (ADR-0029 point 1) and, for a
# decision, that exactly one option is recommended (point 3) -- dies without
# printing anything otherwise. $1 = classe, $2 = validated que_faire JSON.
validate_classe() {
  local classe=$1 que_faire=$2 recommended_count
  [[ -n $classe ]] || die "proposition incomplète : champ « classe » manquant ($CLASSE_MAINTENANCE | $CLASSE_DECISION, $AUTHORIZING_ADR)."
  [[ $classe == "$CLASSE_MAINTENANCE" || $classe == "$CLASSE_DECISION" ]] \
    || die "classe « $classe » inconnue : $CLASSE_MAINTENANCE ou $CLASSE_DECISION ($AUTHORIZING_ADR)."
  if [[ $classe == "$CLASSE_DECISION" ]]; then
    recommended_count=$(jq '[.[] | (.recommande // false)] | map(select(. == true)) | length' <<<"$que_faire")
    (( recommended_count == 1 )) \
      || die "une proposition de classe $CLASSE_DECISION porte exactement une option « Recommandé » avec sa raison ($AUTHORIZING_ADR point 3)."
  fi
}

# classe_of_bead reads a proposal bead's class the way the Cockpit does
# (lib/cockpit/requests/proposals.py): the recorded class; else decision
# when the door wrote its fields; else sans_champs. $1 = bead JSON.
classe_of_bead() {
  jq -r --arg m "$CLASSE_MAINTENANCE" --arg d "$CLASSE_DECISION" --arg s "$CLASSE_SANS_CHAMPS" '
    (.metadata // {}) as $meta
    | ($meta["gc.proposal_classe"] // "") as $c
    | if $c == $m then $m
      elif $c == $d then $d
      elif (($meta["gc.proposal_quoi"] // "") != "" or ($meta["gc.proposal_pourquoi"] // "") != "" or ($meta["gc.proposal_que_faire"] // "") != "") then $d
      else $s end' <<<"$1"
}

# take_over_maintenance files the bug bead a maintenance proposal becomes
# (ADR-0029 point 2) and dispatches it through bin/factory-work-dispatch, the
# usual door. The Mayor used to receive a mail and run that same command,
# one wake per bead (10 in 42 hours, 2026-10-13, af-yzo8fo.3); it is now
# mailed only when the dispatch did not go through (a refusal, or a deferral
# on memory or a hot path), to dispatch it later. Never escalation-door
# mayor -- its sweep would promote the bead to the operator after 2 h,
# which is exactly what this class must not do.
# $1 = proposal bead id, $2 = quoi, $3 = pourquoi, $4 = lettered que_faire.
take_over_maintenance() {
  local proposal=$1 quoi=$2 pourquoi=$3 que_faire=$4
  local options description create_output bug_id dispatch_output dispatch_rc
  options=$(jq -r '.[] | "- \(.lettre). \(.option) — \(.consequence)"' <<<"$que_faire")
  description="$pourquoi

Proposition $proposal, classe $CLASSE_MAINTENANCE, autorisée par $AUTHORIZING_ADR : corriger ce défaut constaté et toutes ses occurrences de la même catégorie (docs/DEFECT_CLASSES.md), avec un contrôle qui tient la catégorie ; ne jamais limiter la correction au cas observé ; « hors périmètre » ne vaut que pour une autre catégorie, ou pour une occurrence cherchée, nommée et confiée à un Bead dans « Où ailleurs : ». Avant de coder : bin/factory-fix-preflight --class <code> <chemins>. La PR écrit « Catégorie : », « Où ailleurs : » et « Contrôle de catégorie : » (docs/DELIVERY.md). ADR-0017 tient toujours : pas de refactor ni d'audit sans défaut constaté.
Options proposées :
$options

Si la correction touche un comportement visible de l'opérateur ou une règle de méthode : arrêter, ne pas poursuivre, et lancer
  bin/proposal-door reconvertir $proposal '<raison>' '<que_faire JSON avec une option recommande=true et sa raison>' <acteur>
($AUTHORIZING_ADR point 6)."
  create_output=$("$GC_BIN" bd create "$quoi" -t bug -p 2 -l "$CLASSE_MAINTENANCE" -d "$description" 2>&1) \
    || die "gc bd create (bead de maintenance) failed for $proposal: $create_output"
  bug_id=$(printf '%s\n' "$create_output" | grep -oE '[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+' | head -n1)
  [[ -n $bug_id && $bug_id != "$proposal" ]] || die "gc bd create did not report a bead id for the maintenance bead of $proposal: $create_output"
  "$GC_BIN" bd update "$bug_id" \
    --set-metadata "gc.authorized_by=$AUTHORIZING_ADR" \
    --set-metadata "gc.source=$DOOR_ACTOR" \
    --set-metadata "gc.proposal_id=$proposal" \
    --set-metadata "gc.proposal_classe=$CLASSE_MAINTENANCE" \
    --append-notes "MAINTENANCE: proposition $proposal, autorisée par $AUTHORIZING_ADR" \
    >/dev/null || die "Beads write failed for the maintenance bead $bug_id."
  "$GC_BIN" bd dep relate "$bug_id" "$proposal" >/dev/null 2>&1 \
    || log "WARNING: could not relate $bug_id to $proposal (gc bd dep relate); the link is in their metadata."
  "$GC_BIN" bd update "$proposal" \
    --set-metadata "gc.proposal_state=prise_en_charge" \
    --set-metadata "gc.proposal_bug=$bug_id" \
    --set-metadata "gc.proposal_response_at=$(now_iso)" \
    --set-metadata "gc.proposal_response_actor=$DOOR_ACTOR" \
    --append-notes "PROPOSITION PRISE EN CHARGE par $DOOR_ACTOR — ticket $bug_id" \
    >/dev/null || die "Beads write failed for $proposal."
  dispatch_rc=0
  dispatch_output=$(GC_BIN="$GC_BIN" "$DISPATCH_BIN" "$bug_id" 2>&1) || dispatch_rc=$?
  if [[ $dispatch_rc -ne 0 ]]; then
    "$GC_BIN" mail send "$MAYOR_RECIPIENT" --notify \
      -s "Maintenance ($AUTHORIZING_ADR): $bug_id" \
      -m "ACTION: proposal-door filed a maintenance bead from proposal $proposal; its dispatch did not go through (exit $dispatch_rc: $(tr '\n' ' ' <<<"$dispatch_output" | cut -c1-300))
STATE: $quoi
EVIDENCE: gc bd show $bug_id (gc.authorized_by=$AUTHORIZING_ADR); gc bd show $proposal
NEXT: dispatch it with ./bin/factory-work-dispatch $bug_id -- correct the observed defect only; if it touches what the operator sees, stop and run bin/proposal-door reconvertir ($AUTHORIZING_ADR point 6)" \
      >/dev/null || die "Could not dispatch $bug_id (exit $dispatch_rc) nor mail $MAYOR_RECIPIENT about it; the bead and the proposal are written -- run $DISPATCH_BIN $bug_id rather than creating a second proposal."
  fi
  printf 'PRISE EN CHARGE: %s — ticket %s\n' "$proposal" "$bug_id"
}

# cockpit_can_display runs the Cockpit's own main-text control
# (bin/operator-text-check, lib/cockpit/text/validate.py) on the exact
# fields about to be written, and dies with its reasons -- the same reasons
# the Cockpit would otherwise count as a producer defect while showing a
# fixed repli in place of the text (spec .73, .78). One contract, checked
# at the door and at the screen.
cockpit_can_display() {  # quoi pourquoi lettered_que_faire_json
  local quoi=$1 pourquoi=$2 que_faire=$3 payload reasons
  payload=$(jq -nc --arg quoi "$quoi" --arg pourquoi "$pourquoi" --argjson que_faire "$que_faire" \
    '{quoi: $quoi, pourquoi: $pourquoi, que_faire: $que_faire}')
  if ! reasons=$("$OPERATOR_TEXT_CHECK_BIN" "$payload" 2>&1 >/dev/null); then
    die "proposition refusée, le Cockpit ne pourrait pas l'afficher telle quelle : $(paste -sd '|' <<<"$reasons" | sed 's/|/ ; /g')"
  fi
}

cmd_create() {
  local payload=${1:-}
  [[ -n $payload ]] || die "Usage: $PROGRAM_NAME create <json>"
  jq -e 'type == "object"' <<<"$payload" >/dev/null 2>&1 \
    || die "proposition incomplète : le corps n'est pas un objet JSON valide."
  local quoi pourquoi langue classe que_faire_raw lettered expected_language titre bead_id create_output details
  local -a details_args=()
  details=$(jq -r 'if (.details | type) == "string" then .details else "" end' <<<"$payload")
  [[ $details != *$'\n'* && $details != *$'\r'* ]] || die "champ « details » doit tenir sur une seule ligne."
  (( ${#details} <= MAX_DETAILS_LENGTH )) || die "champ « details » dépasse $MAX_DETAILS_LENGTH caractères."
  [[ -z $details ]] || details_args=(--set-metadata "gc.proposal_details=$details")
  quoi=$(jq -r '.quoi // ""' <<<"$payload")
  pourquoi=$(jq -r '.pourquoi // ""' <<<"$payload")
  langue=$(jq -r '.langue // ""' <<<"$payload")
  classe=$(jq -r '.classe // ""' <<<"$payload")
  que_faire_raw=$(jq -c '.que_faire // []' <<<"$payload")
  field_ok "quoi" "$quoi"
  field_ok "pourquoi" "$pourquoi"
  field_ok "langue" "$langue"
  lettered=$(validate_que_faire "$que_faire_raw")
  expected_language=$(operator_language)
  [[ $langue == "$expected_language" ]] \
    || die "la proposition est dans la langue « $langue », la langue de l'opérateur est « $expected_language »."
  cockpit_can_display "$quoi" "$pourquoi" "$lettered"
  validate_classe "$classe" "$lettered"

  titre="PROPOSITION: $quoi"
  create_output=$("$GC_BIN" bd create "$titre" -l proposal -t task -d "$pourquoi" 2>&1) \
    || die "gc bd create failed: $create_output"
  bead_id=$(printf '%s\n' "$create_output" | grep -oE '[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+' | head -n1)
  [[ -n $bead_id ]] || die "gc bd create did not report a bead id: $create_output"

  "$GC_BIN" bd update "$bead_id" \
    --set-metadata "gc.proposal_quoi=$quoi" \
    --set-metadata "gc.proposal_pourquoi=$pourquoi" \
    --set-metadata "gc.proposal_que_faire=$lettered" \
    --set-metadata "gc.proposal_langue=$langue" \
    --set-metadata "gc.proposal_classe=$classe" \
    --set-metadata "gc.proposal_state=ouverte" \
    --set-metadata "gc.proposal_horodatage=$(now_iso)" \
    "${details_args[@]}" \
    --append-notes "PROPOSITION: $quoi" \
    >/dev/null || die "Beads write failed for $bead_id."
  printf 'PROPOSITION CRÉÉE: %s — %s\n' "$bead_id" "$quoi"
  if [[ $classe == "$CLASSE_MAINTENANCE" ]]; then
    take_over_maintenance "$bead_id" "$quoi" "$pourquoi" "$lettered"
  fi
}

cmd_reconvertir() {
  local proposal=${1:-} raison=${2:-} que_faire_raw=${3:-} acteur=${4:-}
  [[ -n $proposal && -n $acteur ]] || die "Usage: $PROGRAM_NAME reconvertir <proposition> <raison> <que_faire_json> <acteur>"
  field_ok "raison" "$raison"
  valid_bead_id "$proposal" || die "'$proposal' is not a Bead id."
  local bead_json classe lettered old_que_faire bug_id bug_json bug_holder
  bead_json=$(show_bead "$proposal")
  jq -e '(.labels // []) | index("proposal") != null' <<<"$bead_json" >/dev/null 2>&1 \
    || die "$proposal n'est pas une proposition (label proposal absent)."
  classe=$(classe_of_bead "$bead_json")
  [[ $classe == "$CLASSE_MAINTENANCE" ]] \
    || die "$proposal est de classe « $classe » : seule une proposition $CLASSE_MAINTENANCE se reconvertit en $CLASSE_DECISION ($AUTHORIZING_ADR point 6)."
  jq -e 'type == "array"' <<<"$que_faire_raw" >/dev/null 2>&1 \
    || die "proposition incomplète : « que faire » doit être un tableau JSON d'options."
  lettered=$(validate_que_faire "$que_faire_raw")
  validate_classe "$CLASSE_DECISION" "$lettered"
  old_que_faire=$(jq -r '(.metadata // {})["gc.proposal_que_faire"] // ""' <<<"$bead_json")
  bug_id=$(jq -r '(.metadata // {})["gc.proposal_bug"] // ""' <<<"$bead_json")
  if [[ -n $bug_id ]]; then
    # Beads 1.3 refuses `bd close` to any actor but the assignee, and the
    # worker the bug bead was dispatched to holds it while it is worked
    # (af-vhvmsi). Point 6 is the authority to stop it whoever holds it;
    # --if-assignee never closes a bead whose holder changed since this read.
    # The reason goes to the notes: `bd update` records no close reason.
    bug_json=$(show_bead "$bug_id")
    bug_holder=$(jq -r '.assignee // ""' <<<"$bug_json")
    "$GC_BIN" bd update "$bug_id" --if-assignee "$bug_holder" --status closed \
      --append-notes "Reconvertie en décision ($AUTHORIZING_ADR point 6) par $acteur — $raison" >/dev/null \
      || die "Could not close the maintenance bead $bug_id (held by ${bug_holder:-nobody} when read); nothing reconverted."
  fi
  "$GC_BIN" bd update "$proposal" \
    --set-metadata "gc.proposal_classe=$CLASSE_DECISION" \
    --set-metadata "gc.proposal_state=ouverte" \
    --set-metadata "gc.proposal_que_faire=$lettered" \
    --set-metadata "gc.proposal_que_faire_maintenance=$old_que_faire" \
    --set-metadata "gc.proposal_reconversion_raison=$raison" \
    --set-metadata "gc.proposal_response_at=$(now_iso)" \
    --set-metadata "gc.proposal_response_actor=$acteur" \
    --append-notes "PROPOSITION RECONVERTIE en décision par $acteur — $raison" \
    >/dev/null || die "Beads write failed for $proposal."
  printf 'RECONVERTIE: %s — décision (%s)\n' "$proposal" "$raison"
}

cmd_accepter() {
  local bead=${1:-} acteur=${2:-}
  [[ -n $bead && -n $acteur ]] || die "Usage: $PROGRAM_NAME accepter <bead> <acteur>"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  show_bead "$bead" >/dev/null
  "$GC_BIN" bd update "$bead" \
    --set-metadata "gc.proposal_state=a_planifier" \
    --set-metadata "gc.proposal_response_at=$(now_iso)" \
    --set-metadata "gc.proposal_response_actor=$acteur" \
    --append-notes "PROPOSITION ACCEPTÉE par $acteur — passe à planifier" \
    >/dev/null || die "Beads write failed for $bead."
  printf 'ACCEPTÉE: %s — à planifier\n' "$bead"
}

cmd_rejeter() {
  local bead=${1:-} raison=${2:-} acteur=${3:-}
  [[ -n $bead && -n $acteur ]] || die "Usage: $PROGRAM_NAME rejeter <bead> <raison> <acteur>"
  field_ok "raison" "$raison"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  show_bead "$bead" >/dev/null
  "$GC_BIN" bd update "$bead" \
    --set-metadata "gc.proposal_state=rejetee" \
    --set-metadata "gc.proposal_reject_reason=$raison" \
    --set-metadata "gc.proposal_response_at=$(now_iso)" \
    --set-metadata "gc.proposal_response_actor=$acteur" \
    --append-notes "PROPOSITION REJETÉE par $acteur — $raison" \
    >/dev/null || die "Beads write failed for $bead."
  printf 'REJETÉE: %s — %s\n' "$bead" "$raison"
}

cmd_reporter() {
  local bead=${1:-} heure=${2:-} acteur=${3:-}
  [[ -n $bead && -n $acteur ]] || die "Usage: $PROGRAM_NAME reporter <bead> <heure> <acteur>"
  field_ok "heure" "$heure"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  show_bead "$bead" >/dev/null
  "$GC_BIN" bd update "$bead" \
    --set-metadata "gc.proposal_report_until=$heure" \
    --set-metadata "gc.proposal_response_at=$(now_iso)" \
    --set-metadata "gc.proposal_response_actor=$acteur" \
    --append-notes "PROPOSITION REPORTÉE par $acteur — jusqu'à $heure" \
    >/dev/null || die "Beads write failed for $bead."
  printf 'REPORTÉE: %s — jusqu'"'"'à %s\n' "$bead" "$heure"
}

cmd_resoudre() {
  local bead=${1:-} preuve=${2:-} acteur=${3:-}
  [[ -n $bead && -n $acteur ]] || die "Usage: $PROGRAM_NAME resoudre <bead> <preuve> <acteur>"
  field_ok "preuve" "$preuve"
  grep -qE '#[0-9]+|[0-9a-f]{7,40}' <<<"$preuve" \
    || die "la preuve « $preuve » ne nomme ni PR (#123) ni commit (sha) : une proposition ne se résout que sur preuve de merge."
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  local bead_json state
  bead_json=$(show_bead "$bead")
  jq -e '(.labels // []) | index("proposal") != null' <<<"$bead_json" >/dev/null 2>&1 \
    || die "$bead n'est pas une proposition (label proposal absent)."
  state=$(jq -r '(.metadata // {})["gc.proposal_state"] // "ouverte"' <<<"$bead_json")
  case "$state" in
    ouverte|prise_en_charge) ;;
    a_planifier) die "$bead a déjà été acceptée par l'opérateur (à planifier) : une livraison ne l'annule pas." ;;
    rejetee) die "$bead a déjà été rejetée par l'opérateur : une livraison ne l'annule pas." ;;
    resolue) die "$bead est déjà résolue ($(jq -r '(.metadata // {})["gc.proposal_resolved_by"] // "?"' <<<"$bead_json"))." ;;
    *) die "$bead est dans l'état inconnu « $state » ; refus de la résoudre." ;;
  esac
  "$GC_BIN" bd update "$bead" \
    --set-metadata "gc.proposal_state=resolue" \
    --set-metadata "gc.proposal_resolved_by=$preuve" \
    --set-metadata "gc.proposal_response_at=$(now_iso)" \
    --set-metadata "gc.proposal_response_actor=$acteur" \
    --append-notes "PROPOSITION RÉSOLUE par $acteur — $preuve" \
    >/dev/null || die "Beads write failed for $bead."
  printf 'RÉSOLUE: %s — %s\n' "$bead" "$preuve"
}

# pending_proposals prints the JSON array of pending proposals (open,
# labelled proposal, state neither a_planifier, rejetee, resolue nor
# prise_en_charge -- a maintenance proposal the factory holds waits on no
# one), each with its .classe read as classe_of_bead does. $1 = optional
# class filter (maintenance | decision | sans_champs).
pending_proposals() {
  local classe_filter=${1:-} proposals_json
  if [[ -n $classe_filter ]]; then
    case "$classe_filter" in
      "$CLASSE_MAINTENANCE"|"$CLASSE_DECISION"|"$CLASSE_SANS_CHAMPS") ;;
      *) die "classe « $classe_filter » inconnue : $CLASSE_MAINTENANCE, $CLASSE_DECISION ou $CLASSE_SANS_CHAMPS." ;;
    esac
  fi
  proposals_json=$("$GC_BIN" bd list --status open --label proposal --json 2>/dev/null) \
    || die "Could not list pending proposals."
  [[ -n $proposals_json ]] || proposals_json='[]'
  jq -c --arg m "$CLASSE_MAINTENANCE" --arg d "$CLASSE_DECISION" --arg s "$CLASSE_SANS_CHAMPS" --arg f "$classe_filter" '
    (if type == "array" then . else [.] end)
    | map(select(((.metadata // {})["gc.proposal_state"] // "ouverte") as $st
        | ($st != "a_planifier" and $st != "rejetee" and $st != "resolue" and $st != "prise_en_charge")))
    | map(. + {classe: ((.metadata // {}) as $meta | ($meta["gc.proposal_classe"] // "") as $c
        | if $c == $m then $m
          elif $c == $d then $d
          elif (($meta["gc.proposal_quoi"] // "") != "" or ($meta["gc.proposal_pourquoi"] // "") != "" or ($meta["gc.proposal_que_faire"] // "") != "") then $d
          else $s end)})
    | map(select($f == "" or .classe == $f))
  ' <<<"$proposals_json"
}

parse_classe_option() {  # prints the --classe value from "$@", or ""
  local classe=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --classe) [[ $# -ge 2 ]] || die "--classe requires a value."; classe=$2; shift 2 ;;
      --classe=*) classe=${1#--classe=}; shift ;;
      *) die "unsupported argument '$1'." ;;
    esac
  done
  printf '%s' "$classe"
}

cmd_compte() {
  local classe
  classe=$(parse_classe_option "$@")
  pending_proposals "$classe" | jq -r 'length'
}

cmd_list() {
  local classe
  classe=$(parse_classe_option "$@")
  pending_proposals "$classe" | jq -r '
    .[] | [.id, .classe, ((.metadata // {})["gc.proposal_state"] // "ouverte"),
           ((.metadata // {})["gc.proposal_quoi"] // .title // "")] | @tsv'
}

main() {
  local command=${1:-}
  [[ -n $command ]] || { usage >&2; return 2; }
  shift
  case "$command" in
    -h|--help|help) usage ;;
    create) cmd_create "$@" ;;
    accepter) cmd_accepter "$@" ;;
    rejeter) cmd_rejeter "$@" ;;
    reporter) cmd_reporter "$@" ;;
    resoudre) cmd_resoudre "$@" ;;
    reconvertir) cmd_reconvertir "$@" ;;
    compte) cmd_compte "$@" ;;
    list) cmd_list "$@" ;;
    *) usage >&2; return 2 ;;
  esac
}

require_command jq
require_command "$GC_BIN"
require_command flock
LOCK_FILE="${PROPOSAL_DOOR_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/agent-factory-proposal-door.lock}"
exec 9>"$LOCK_FILE"
flock -w 10 9 || die "Could not acquire the proposal-door lock."
# The lock belongs to this process alone, as in bin/escalation-door
# (af-wnj692): `9>&-` closes fd 9 for everything main runs. Without it the
# detached `gc nudge poll` that the `gc mail send --notify` of a maintenance
# `create` leaves behind kept the flock for as long as it lived, and every
# later call -- the `reconvertir` of that same proposal first -- failed on it
# (af-vhvmsi, seen on the real tracker).
main "$@" 9>&-
