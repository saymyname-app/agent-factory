#!/usr/bin/env bash
# local-only-tests — run the tests marked `# ci: local-only` nightly and
# page the Mayor on failure (O13, spec-factory-operations-v2-2026-09-28;
# docs/INVENTORY.md F21: "local-only tests run nowhere automatically").
#
# Local-only tests exist precisely because CI cannot run them (they need
# the installed gc/bd runtime and/or drive the live city). Nobody was
# running them at all, so regressions in that surface went unnoticed until
# someone happened to run them by hand. This closes that gap without
# giving CI new requirements.
#
# What runs is read from the marker itself (T49, af-xcfup7): every
# tests/*.sh and tests/*.py marked `# ci: local-only`, one at a time, except
# the files config/local-only-tests-exclusions.txt names with their reason (a real
# model session, a real Mayor session). A list of names kept here went stale:
# seven adoption trials of D01 were red on main and ran nowhere.
#
# Usage: local-only-tests [--quiet]
#        local-only-tests --list
#
# --list prints what a run would do, one line per marked file -- `run <path>`
# or `excluded <path> <reason>` -- and runs nothing; it needs no gc. It exits
# 2 on an exclusion that names no marked file or gives no reason.
# The output of a run names each test (PASS, FAIL, SKIPPED) and each
# exclusion (EXCLUDED). A test that runs longer than LOCAL_ONLY_TEST_TIMEOUT
# (default 1800 s) is stopped and counted as failed.
#
# A test that exits 77 says this host cannot run it (for example the capture
# browser refused by the host sandbox, af-yb2cb5): it is SKIPPED, not failed,
# with its last `SKIP:` line as the reason. Each SKIPPED line is printed even
# under --quiet, and the bead a failing run files lists the skipped tests
# too; skips alone file no bead and page nobody. A test exits 77 only on a
# precise, cheap probe of its host (tests/lib/capture-browser.sh), so a real
# regression still fails.
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
QUIET=0
LIST=0
# Overridable so a test city (which has no bin/ of its own) can point this
# at the real repo's escalation-door instead of $FACTORY_ROOT's.
ESCALATION_DOOR_BIN="${ESCALATION_DOOR_BIN:-$ROOT/bin/escalation-door}"
EXCLUSIONS_FILE="config/local-only-tests-exclusions.txt"
TEST_TIMEOUT="${LOCAL_ONLY_TEST_TIMEOUT:-1800}"

while [ $# -gt 0 ]; do
  case "$1" in
    --quiet) QUIET=1 ;;
    --list) LIST=1 ;;
    -h|--help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

say() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }

cd "$ROOT" || { echo "local-only-tests: $ROOT unreachable" >&2; exit 2; }

# Same marker, same files as bin/ci-run-tests leaves out.
is_local_only() { grep -qE '^#[[:space:]]*ci:[[:space:]]*local-only' "$1"; }

declare -A EXCLUDED=()
if [ -f "$EXCLUSIONS_FILE" ]; then
  while read -r path reason; do
    case "$path" in ''|'#'*) continue ;; esac
    if [ -z "$reason" ]; then
      echo "local-only-tests: $EXCLUSIONS_FILE excludes $path without a reason" >&2; exit 2
    fi
    if [ ! -f "$path" ] || ! is_local_only "$path"; then
      echo "local-only-tests: $EXCLUSIONS_FILE excludes $path, which is not a test marked ci: local-only" >&2; exit 2
    fi
    EXCLUDED["$path"]="$reason"
  done <"$EXCLUSIONS_FILE"
fi

TESTS=()
SKIPPED=()
for t in tests/*.sh tests/*.py; do
  [ -f "$t" ] && is_local_only "$t" || continue
  if [ -n "${EXCLUDED[$t]:-}" ]; then SKIPPED+=("$t"); else TESTS+=("$t"); fi
done

if [ "$LIST" = "1" ]; then
  for t in ${TESTS[@]+"${TESTS[@]}"}; do printf 'run %s\n' "$t"; done
  for t in ${SKIPPED[@]+"${SKIPPED[@]}"}; do printf 'excluded %s %s\n' "$t" "${EXCLUDED[$t]}"; done
  exit 0
fi

command -v gc >/dev/null 2>&1 || { say "local-only-tests: gc unavailable, skipping"; exit 0; }

for t in ${SKIPPED[@]+"${SKIPPED[@]}"}; do
  say "local-only-tests: EXCLUDED $t — ${EXCLUDED[$t]}"
done

FAILED=()
HOST_SKIPPED=()
for t in ${TESTS[@]+"${TESTS[@]}"}; do
  if [ ! -x "$t" ]; then
    say "local-only-tests: $t missing or not executable — treating as failed"
    FAILED+=("$t: missing or not executable")
    continue
  fi
  OUTPUT=$(timeout --kill-after=30 "$TEST_TIMEOUT" "$t" 2>&1)
  rc=$?
  if [ "$rc" -eq 0 ]; then
    say "local-only-tests: PASS $t"
  elif [ "$rc" -eq 77 ]; then
    why=$(printf '%s\n' "$OUTPUT" | grep '^SKIP:' | tail -1)
    HOST_SKIPPED+=("$t: ${why:-exit 77 without a SKIP: line}")
    printf 'local-only-tests: SKIPPED %s — %s\n' "$t" "${why:-exit 77 without a SKIP: line}"
  else
    [ "$rc" -eq 124 ] && OUTPUT="$OUTPUT
stopped after ${TEST_TIMEOUT}s"
    say "local-only-tests: FAIL $t"
    FAILED+=("$t: $(printf '%s' "$OUTPUT" | tail -5 | tr '\n' ' ')")
  fi
done

[ "${#FAILED[@]}" -eq 0 ] && { say "local-only-tests: no failure in ${#TESTS[@]} test(s), ${#HOST_SKIPPED[@]} skipped"; exit 0; }

TITLE="[local-only-tests] $(date -u +%Y-%m-%d) run: ${#FAILED[@]} failure(s)"
REASON=$(printf '%s\n' "${FAILED[@]}")
if [ "${#HOST_SKIPPED[@]}" -gt 0 ]; then
  REASON="$REASON

Skipped, this host cannot run them (exit 77, not counted as failures):
$(printf '%s\n' "${HOST_SKIPPED[@]}")"
fi

CREATED=$(gc bd create "$TITLE" -p 1 -t bug \
  -d "The nightly local-only-tests order found ${#FAILED[@]} failing test(s):

$REASON

These tests are marked \`# ci: local-only\` and only run here, nightly (docs/INVENTORY.md F21). Diagnose and fix, then close this bead with the cause." \
  --metadata '{"gc.source":"local-only-tests"}' \
  --json 2>/dev/null | jq -r '(.[0]?.id // .id // empty)')

if [ -z "$CREATED" ]; then
  say "local-only-tests: could not file a bead"
  exit 1
fi

if ! "$ESCALATION_DOOR_BIN" mayor "$CREATED" \
  "${#FAILED[@]} local-only test(s) failed: $(printf '%s' "${FAILED[0]}" | cut -c1-160)"; then
  say "local-only-tests: escalation-door failed for $CREATED"
  exit 1
fi

say "local-only-tests: filed $CREATED and paged mayor"
exit 1
