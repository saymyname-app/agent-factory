#!/usr/bin/env python3
"""Black-box public-behavior oracle for an isolated fixture City.

    fixture-city-oracle run SCENARIO --operator EXE --publication-door EXE
    fixture-city-oracle run SCENARIO --delivery-driver EXE

The first form walks a Planning Run (scenario contract
agent-factory-fixture-scenario/v1). The second walks the delivery of one
ticket of a marked convoy (agent-factory-fixture-delivery-scenario/v1; T19,
af-iefuud): the driver makes the flow advance one event at a time, and after
each event the oracle itself reads the public state -- bin/convoy-state
show, the branches of the repository, bin/evidence-capture verify,
bin/ticket-end check -- and requires the lifecycle published, started, red,
frozen, coded, reviewed, evaluated, merged, closed by the ticket-end gate.
It reads no prompt, no formula and no role. Details: docs/FIXTURE_CITY_ORACLE.md.
"""

from __future__ import annotations

import argparse
import errno
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


PROGRAM = "fixture-city-oracle"
SCENARIO_CONTRACT = "agent-factory-fixture-scenario/v1"
OBSERVATION_CONTRACT = "agent-factory-fixture-observation/v1"
RESULT_CONTRACT = "agent-factory-fixture-oracle-result/v1"
DELIVERY_SCENARIO_CONTRACT = "agent-factory-fixture-delivery-scenario/v1"
DELIVERY_RESULT_CONTRACT = "agent-factory-fixture-delivery-result/v1"
# The lifecycle of one ticket of a marked convoy, in the only order the flow
# allows (Spec af-wf4w5r §4 to §9).
DELIVERY_STATES = ("published", "started", "red", "frozen", "coded", "reviewed", "evaluated", "merged", "closed")
DELIVERY_INJECTIONS = ("none", "criterion-edited", "closed-by-hand")
DELIVERY_MAX_EVENTS = 16
TICKET_END_VERSION = "ticket-end/v1"
TICKET_END_CONDITIONS = (
    "criteria", "handoff", "evaluation", "fidelity", "deferral", "merge", "evidence", "tdd", "review")
BIN = Path(__file__).resolve().parent
SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
REVISION = re.compile(r"^[0-9a-f]{40}$")


class OracleError(RuntimeError):
    pass


def as_dict(value: Any, name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise OracleError(f"{name} must be an object")
    return value


def as_list(value: Any, name: str) -> list[Any]:
    if not isinstance(value, list):
        raise OracleError(f"{name} must be an array")
    return value


def required_string(value: Any, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise OracleError(f"{name} must be a non-empty string")
    return value


def digest_bytes(value: bytes) -> str:
    return "sha256:" + hashlib.sha256(value).hexdigest()


def canonical_digest(value: Any) -> str:
    return digest_bytes(
        json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    )


def validate_scenario(path: Path) -> tuple[dict[str, Any], dict[str, Any]]:
    try:
        scenario = as_dict(json.loads(path.read_text(encoding="utf-8")), "scenario")
    except (OSError, json.JSONDecodeError) as exc:
        raise OracleError(f"cannot read scenario {path}: {exc}") from exc
    if scenario.get("contract") != SCENARIO_CONTRACT:
        raise OracleError(f"scenario contract must be {SCENARIO_CONTRACT}")
    scenario_id = required_string(scenario.get("scenario_id"), "scenario_id")
    if not SAFE_ID.fullmatch(scenario_id):
        raise OracleError("scenario_id contains unsupported characters")

    request = as_dict(scenario.get("request"), "request")
    project_id = required_string(request.get("project_id"), "request.project_id")
    if not SAFE_ID.fullmatch(project_id):
        raise OracleError("request.project_id contains unsupported characters")
    required_string(request.get("intent"), "request.intent")

    rigs = as_list(request.get("rigs"), "request.rigs")
    if not rigs:
        raise OracleError("request.rigs must name at least one fixture rig")
    if len(rigs) > 2:
        raise OracleError("fixture scenarios support one or two exact-revision rigs")
    rig_names: set[str] = set()
    for index, raw_rig in enumerate(rigs):
        rig = as_dict(raw_rig, f"request.rigs[{index}]")
        name = required_string(rig.get("name"), f"request.rigs[{index}].name")
        revision = required_string(rig.get("revision"), f"request.rigs[{index}].revision")
        fixture_source = required_string(
            rig.get("fixture_source"), f"request.rigs[{index}].fixture_source"
        )
        if not SAFE_ID.fullmatch(name) or name in rig_names:
            raise OracleError(f"fixture rig name is invalid or duplicated: {name}")
        if not REVISION.fullmatch(revision):
            raise OracleError(f"fixture rig {name} must use an exact 40-character revision")
        source_path = Path(fixture_source)
        if source_path.is_absolute() or ".." in source_path.parts:
            raise OracleError(f"fixture rig {name} source must stay beneath the scenario directory")
        rig_names.add(name)

    slices = as_list(request.get("slices"), "request.slices")
    if not slices:
        raise OracleError("request.slices must name at least one vertical slice")
    keys: set[str] = set()
    normalized: list[dict[str, Any]] = []
    for index, raw_slice in enumerate(slices):
        item = as_dict(raw_slice, f"request.slices[{index}]")
        key = required_string(item.get("key"), f"request.slices[{index}].key")
        title = required_string(item.get("title"), f"request.slices[{index}].title")
        if not SAFE_ID.fullmatch(key) or key in keys:
            raise OracleError(f"vertical slice key is invalid or duplicated: {key}")
        target_rigs = as_list(item.get("rigs"), f"request.slices[{index}].rigs")
        blockers = as_list(item.get("blocked_by"), f"request.slices[{index}].blocked_by")
        if (
            not target_rigs
            or any(rig not in rig_names for rig in target_rigs)
            or len(set(target_rigs)) != len(target_rigs)
        ):
            raise OracleError(f"vertical slice {key} names an undeclared or empty rig set")
        if (
            any(not isinstance(blocker, str) for blocker in blockers)
            or len(set(blockers)) != len(blockers)
        ):
            raise OracleError(f"vertical slice {key} has a non-string blocker")
        normalized.append({"key": key, "title": title, "rigs": target_rigs, "blocked_by": blockers})
        keys.add(key)
    for item in normalized:
        if item["key"] in item["blocked_by"] or any(key not in keys for key in item["blocked_by"]):
            raise OracleError(f"vertical slice {item['key']} has an invalid blocker")

    visiting: set[str] = set()
    visited: set[str] = set()
    blockers_by_key = {item["key"]: item["blocked_by"] for item in normalized}

    def visit(key: str) -> None:
        if key in visiting:
            raise OracleError("fixture delivery graph must be acyclic")
        if key in visited:
            return
        visiting.add(key)
        for blocker in blockers_by_key[key]:
            visit(blocker)
        visiting.remove(key)
        visited.add(key)

    for key in keys:
        visit(key)

    inject = as_dict(scenario.get("inject", {}), "inject")
    failure = inject.get("publication_failure", "none")
    if failure not in {"none", "after-stage"}:
        raise OracleError("inject.publication_failure must be none or after-stage")
    reject_reason = inject.get("reject_reason", "none")
    if reject_reason not in {"none", "spec_mismatch", "changed_behavior", "active_danger"}:
        raise OracleError(
            "inject.reject_reason must be none, spec_mismatch, changed_behavior, or active_danger"
        )

    legacy_path = request.get("legacy_path", "none")
    if legacy_path not in {"none", "planning-base", "release-contract", "cockpit-v1-export"}:
        raise OracleError(
            "request.legacy_path must be none, planning-base, release-contract, or cockpit-v1-export"
        )
    return scenario, request


def hermetic_env(workspace: Path) -> dict[str, str]:
    home = workspace / "home"
    tmp = workspace / "tmp"
    cache = workspace / "cache"
    for directory in (home, tmp, cache):
        directory.mkdir(parents=True, exist_ok=True)
    return {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "HOME": str(home),
        "TMPDIR": str(tmp),
        "XDG_CACHE_HOME": str(cache),
        "PYTHONDONTWRITEBYTECODE": "1",
        "FIXTURE_CITY_EFFECT_MODE": "deny",
    }


def git_env() -> dict[str, str]:
    return {
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_AUTHOR_NAME": "Fixture City",
        "GIT_AUTHOR_EMAIL": "fixture@example.invalid",
        "GIT_COMMITTER_NAME": "Fixture City",
        "GIT_COMMITTER_EMAIL": "fixture@example.invalid",
        "GIT_AUTHOR_DATE": "2000-01-01T00:00:00Z",
        "GIT_COMMITTER_DATE": "2000-01-01T00:00:00Z",
        "TZ": "UTC",
    }


def run_git(*arguments: str) -> str:
    try:
        result = subprocess.run(
            ("git", *arguments),
            env=git_env(),
            text=True,
            capture_output=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise OracleError(f"fixture Git command failed to run: {exc}") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise OracleError(f"fixture Git command failed: {detail}")
    return result.stdout.strip()


def prepare_assemblies(
    scenario_directory: Path, request: dict[str, Any], workspace: Path
) -> dict[str, dict[str, Any]]:
    scenario_directory = scenario_directory.resolve()
    repositories = workspace / "repositories"
    checkouts = workspace / "assembly"
    repositories.mkdir()
    checkouts.mkdir()
    assemblies: dict[str, dict[str, Any]] = {}
    for rig in request["rigs"]:
        source = (scenario_directory / rig["fixture_source"]).resolve()
        try:
            source.relative_to(scenario_directory)
        except ValueError as exc:
            raise OracleError(f"fixture rig {rig['name']} source escapes the scenario directory") from exc
        if not source.is_dir() or any(path.name == ".git" for path in source.rglob(".git")):
            raise OracleError(f"fixture rig {rig['name']} source is missing or contains repository state")
        repository = repositories / rig["name"]
        checkout = checkouts / rig["name"]
        shutil.copytree(source, repository)
        run_git("-C", str(repository), "init", "-q", "--initial-branch=main", "--object-format=sha1")
        run_git("-C", str(repository), "-c", "core.autocrlf=false", "add", "-A")
        run_git(
            "-C",
            str(repository),
            "-c",
            "commit.gpgsign=false",
            "commit",
            "-q",
            "-m",
            f"fixture revision for {rig['name']}",
        )
        observed_revision = run_git("-C", str(repository), "rev-parse", "HEAD")
        if observed_revision != rig["revision"]:
            raise OracleError(
                f"fixture rig {rig['name']} source resolves to {observed_revision}, "
                f"not pinned revision {rig['revision']}"
            )
        run_git("clone", "-q", "--no-checkout", str(repository), str(checkout))
        run_git("-C", str(checkout), "checkout", "-q", "--detach", rig["revision"])
        checked_out_revision = run_git("-C", str(checkout), "rev-parse", "HEAD")
        tree = run_git("-C", str(checkout), "rev-parse", "HEAD^{tree}")
        if checked_out_revision != rig["revision"]:
            raise OracleError(f"fixture rig {rig['name']} did not assemble at its exact revision")
        assemblies[rig["name"]] = {
            "checkout": checkout,
            "revision": checked_out_revision,
            "tree": tree,
        }
    return assemblies


def validate_clean_assemblies(assemblies: dict[str, dict[str, Any]]) -> None:
    for rig_name, assembly in assemblies.items():
        dirty = run_git(
            "-C",
            str(assembly["checkout"]),
            "status",
            "--porcelain=v1",
            "--untracked-files=all",
        )
        if dirty:
            raise OracleError(f"assembled checkout for {rig_name} differs from its exact revision")


def validate_assembly_evidence(
    snapshot: dict[str, Any],
    request: dict[str, Any],
    assemblies: dict[str, dict[str, Any]],
) -> dict[str, Any]:
    observed = as_dict(snapshot.get("assembly_check"), "assembly_check")
    expected_participants = [
        {
            "rig": rig["name"],
            "revision": assemblies[rig["name"]]["revision"],
            "tree": assemblies[rig["name"]]["tree"],
        }
        for rig in request["rigs"]
    ]
    if (
        observed.get("check") != "fixture-end-to-end"
        or observed.get("passed") is not True
        or observed.get("participants") != expected_participants
    ):
        raise OracleError("public assembly check does not cover the exact participating revisions")
    return observed


def sandbox_copy(executable: Path, workspace: Path) -> Path:
    interfaces = workspace / "interfaces"
    interfaces.mkdir(exist_ok=True)
    suffix = hashlib.sha256(str(executable).encode("utf-8")).hexdigest()[:12]
    target = interfaces / f"{suffix}-{executable.name}"
    if not target.exists():
        shutil.copy2(executable, target)
        target.chmod(0o755)
    return target


def network_seccomp_filter() -> bytes:
    """Deny creation of sockets and io_uring inside a shared network namespace."""
    machine = os.uname().machine
    architectures = {
        "x86_64": (0xC000003E, (41, 53, 425, 426, 427, 0x40000029, 0x40000035)),
        "aarch64": (0xC00000B7, (198, 199, 425, 426, 427)),
    }
    if machine not in architectures:
        raise OracleError(f"fixture sandbox does not support seccomp on {machine}")
    audit_arch, denied_syscalls = architectures[machine]

    load_word = 0x20
    jump_equal = 0x15
    return_value = 0x06
    kill_process = 0x80000000
    allow = 0x7FFF0000
    fail_with_errno = 0x00050000 | errno.EPERM

    instructions = [
        (load_word, 0, 0, 4),
        (jump_equal, 1, 0, audit_arch),
        (return_value, 0, 0, kill_process),
        (load_word, 0, 0, 0),
    ]
    for syscall_number in denied_syscalls:
        instructions.extend((
            (jump_equal, 0, 1, syscall_number),
            (return_value, 0, 0, fail_with_errno),
        ))
    instructions.append((return_value, 0, 0, allow))
    return b"".join(struct.pack("=HBBI", *instruction) for instruction in instructions)


def run_interface(
    executable: Path,
    workspace: Path,
    command: str,
    *arguments: str,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    if not executable.is_absolute() or not executable.is_file() or not os.access(executable, os.X_OK):
        raise OracleError(f"interface executable must be an absolute executable file: {executable}")
    bubblewrap = shutil.which("bwrap", path="/usr/local/bin:/usr/bin:/bin")
    if bubblewrap is None:
        raise OracleError("bubblewrap is required to contain fixture adapters")
    contained_executable = sandbox_copy(executable, workspace)
    environment = hermetic_env(workspace)
    sandbox = [
        bubblewrap,
        "--unshare-all",
        "--share-net",
        "--die-with-parent",
        "--new-session",
    ]
    for system_path in ("/usr", "/bin", "/lib", "/lib64"):
        if Path(system_path).exists():
            sandbox.extend(("--ro-bind", system_path, system_path))
    if Path("/etc/ld.so.cache").exists():
        sandbox.extend(("--ro-bind", "/etc/ld.so.cache", "/etc/ld.so.cache"))
    sandbox.extend((
        "--dev", "/dev",
        "--proc", "/proc",
        "--bind", str(workspace), str(workspace),
    ))
    assembly_directory = workspace / "assembly"
    if assembly_directory.is_dir():
        sandbox.extend(("--ro-bind", str(assembly_directory), str(assembly_directory)))
    sandbox.extend((
        "--chdir", str(workspace),
        "--clearenv",
    ))
    for key, value in environment.items():
        sandbox.extend(("--setenv", key, value))
    command_line = (
        str(contained_executable),
        "--workspace", str(workspace),
        command,
        *arguments,
    )
    try:
        with tempfile.TemporaryFile() as seccomp_filter:
            seccomp_filter.write(network_seccomp_filter())
            seccomp_filter.flush()
            seccomp_filter.seek(0)
            sandbox.extend(("--seccomp", str(seccomp_filter.fileno())))
            sandbox.extend(command_line)
            result = subprocess.run(
                sandbox,
                cwd=workspace,
                env=environment,
                text=True,
                capture_output=True,
                timeout=15,
                check=False,
                pass_fds=(seccomp_filter.fileno(),),
            )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise OracleError(f"{command} interface failed to run: {exc}") from exc
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise OracleError(f"{command} interface failed: {detail}")
    return result


def json_output(result: subprocess.CompletedProcess[str], command: str) -> dict[str, Any]:
    try:
        return as_dict(json.loads(result.stdout), f"{command} output")
    except json.JSONDecodeError as exc:
        raise OracleError(f"{command} interface did not return one JSON object") from exc


def observe(operator: Path, workspace: Path) -> dict[str, Any]:
    return json_output(run_interface(operator, workspace, "observe"), "observe")


def validate_snapshot(
    snapshot: dict[str, Any], expected_state: str, planning_run_id: str | None = None
) -> str:
    if snapshot.get("contract") != OBSERVATION_CONTRACT:
        raise OracleError(f"observation contract must be {OBSERVATION_CONTRACT}")
    planning_run = as_dict(snapshot.get("planning_run"), "observation.planning_run")
    observed_run_id = required_string(planning_run.get("id"), "observation.planning_run.id")
    if planning_run_id is not None and observed_run_id != planning_run_id:
        raise OracleError("Planning Run identity changed during one fixture scenario")
    if planning_run.get("state") != expected_state:
        raise OracleError(
            f"expected Planning Run state {expected_state}, observed {planning_run.get('state')}"
        )
    if snapshot.get("effects") != []:
        raise OracleError("fixture observation reported a forbidden real-world effect")
    graph = snapshot.get("delivery_graph")
    planning_items = 0
    for raw_item in as_list(snapshot.get("work_items"), "observation.work_items"):
        item = as_dict(raw_item, "observation.work_item")
        plane = item.get("plane")
        if plane == "planning":
            planning_items += 1
            if item.get("routable") is not False:
                raise OracleError("planning-plane work became routable")
        elif plane == "delivery":
            if graph is None:
                raise OracleError("delivery-plane work exists without a published graph")
            if item.get("routable") is not True or item.get("publication_validated") is not True:
                raise OracleError("published delivery-plane work is not positively validated and routable")
            convoy = as_dict(as_dict(graph, "delivery_graph").get("convoy"), "delivery_graph.convoy")
            if item.get("convoy_id") != convoy.get("id"):
                raise OracleError("delivery-plane work is not attached to the published convoy")
        else:
            raise OracleError(f"work item has no recognized positive Work Plane: {plane}")
    if planning_items == 0:
        raise OracleError("observation contains no planning-plane work")
    return observed_run_id


def validate_artifact_summary(
    snapshot: dict[str, Any], artifact_id: str, artifact_digest: str, state: str
) -> None:
    artifact = as_dict(snapshot.get("artifact"), "artifact")
    if (artifact.get("id"), artifact.get("digest"), artifact.get("state")) != (
        artifact_id,
        artifact_digest,
        state,
    ):
        raise OracleError("Planning Artifact identity, digest, or approval state changed unexpectedly")


def graph_projection(nodes: list[Any], edges: list[Any]) -> dict[str, Any]:
    projected_nodes = []
    for raw in nodes:
        node = as_dict(raw, "delivery_graph.node")
        projected_nodes.append({
            "key": node.get("key"),
            "title": node.get("title"),
            "rigs": node.get("rigs"),
            "plane": node.get("plane"),
            "routable": node.get("routable"),
            "publication_validated": node.get("publication_validated"),
        })
    projected_edges = []
    for raw in edges:
        edge = as_dict(raw, "delivery_graph.edge")
        projected_edges.append({"from": edge.get("from"), "blocked_by": edge.get("blocked_by")})
    return {"nodes": projected_nodes, "edges": projected_edges}


def validate_graph(snapshot: dict[str, Any], request: dict[str, Any]) -> tuple[str, str]:
    graph = as_dict(snapshot.get("delivery_graph"), "delivery_graph")
    convoy = as_dict(graph.get("convoy"), "delivery_graph.convoy")
    convoy_id = required_string(convoy.get("id"), "delivery_graph.convoy.id")
    nodes = as_list(graph.get("nodes"), "delivery_graph.nodes")
    edges = as_list(graph.get("edges"), "delivery_graph.edges")
    slices = request["slices"]
    expected_by_key = {item["key"]: item for item in slices}
    node_keys = [
        required_string(as_dict(node, "delivery_graph.node").get("key"), "delivery_graph.node.key")
        for node in nodes
    ]
    if (
        set(node_keys) != set(expected_by_key)
        or len(node_keys) != len(expected_by_key)
        or len(set(node_keys)) != len(node_keys)
    ):
        raise OracleError("published graph does not preserve the exact approved slice keys")
    node_ids = [
        required_string(as_dict(node, "delivery_graph.node").get("id"), "delivery_graph.node.id")
        for node in nodes
    ]
    if len(set(node_ids)) != len(node_ids):
        raise OracleError("published graph contains duplicate delivery node identities")
    for raw_node in nodes:
        node = as_dict(raw_node, "delivery_graph.node")
        expected = expected_by_key[node["key"]]
        if (node.get("title"), node.get("rigs")) != (expected["title"], expected["rigs"]):
            raise OracleError(f"published slice {node['key']} was semantically changed")
        if (
            node.get("plane") != "delivery"
            or node.get("routable") is not True
            or node.get("publication_validated") is not True
            or node.get("convoy_id") != convoy_id
        ):
            raise OracleError(f"published slice {node['key']} lacks positive delivery routing")
    expected_edges = {
        (item["key"], blocker) for item in slices for blocker in item["blocked_by"]
    }
    observed_edges = {
        (edge.get("from"), edge.get("blocked_by"))
        for edge in edges
        if isinstance(edge, dict)
    }
    if observed_edges != expected_edges or len(edges) != len(expected_edges):
        raise OracleError("published graph does not preserve the exact blocker edges")
    delivery_items = [
        item for item in snapshot["work_items"]
        if isinstance(item, dict) and item.get("plane") == "delivery"
    ]
    if (
        {item.get("id") for item in delivery_items} != {node.get("id") for node in nodes}
        or len(delivery_items) != len(nodes)
    ):
        raise OracleError("published graph and observable delivery-plane work disagree")
    graph_digest = canonical_digest(graph_projection(nodes, edges))
    if graph.get("digest") != graph_digest:
        raise OracleError("published graph digest is not reproducible from public graph content")
    publication = as_dict(snapshot.get("publication"), "publication")
    if (
        publication.get("state") != "published"
        or publication.get("graph_digest") != graph_digest
        or publication.get("convoy_id") != convoy_id
    ):
        raise OracleError("publication observation disagrees with the public delivery graph")
    return graph_digest, convoy_id


def validate_integrations(
    snapshot: dict[str, Any],
    request: dict[str, Any],
    assemblies: dict[str, dict[str, Any]],
) -> list[dict[str, Any]]:
    observed = as_list(snapshot.get("integrations"), "integrations")
    expected = [
        {
            "rig": rig["name"],
            "revision": assemblies[rig["name"]]["revision"],
            "tree": assemblies[rig["name"]]["tree"],
            "verified": True,
        }
        for rig in request["rigs"]
    ]
    if observed != expected:
        raise OracleError("integration evidence does not name the exact participating revisions")
    return expected


def append_state(trace: list[str], snapshot: dict[str, Any]) -> None:
    state = str(as_dict(snapshot.get("planning_run"), "planning_run").get("state"))
    if not trace or trace[-1] != state:
        trace.append(state)


def unique_commands(calls: list[str]) -> list[str]:
    return list(dict.fromkeys(calls))


def execute(scenario_path: Path, operator: Path, publication_door: Path) -> dict[str, Any]:
    scenario, request = validate_scenario(scenario_path)
    operator = operator.resolve()
    publication_door = publication_door.resolve()
    operator_calls: list[str] = []
    states: list[str] = []
    failure = scenario.get("inject", {}).get("publication_failure", "none")
    reject_reason = scenario.get("inject", {}).get("reject_reason", "none")
    legacy_path = request.get("legacy_path", "none")

    with tempfile.TemporaryDirectory(prefix="fixture-city-oracle-") as directory:
        workspace = Path(directory)
        assemblies = prepare_assemblies(scenario_path.parent, request, workspace)
        request_path = workspace / "request.json"
        request_path.write_text(
            json.dumps(request, ensure_ascii=False, sort_keys=True), encoding="utf-8"
        )

        if legacy_path != "none":
            start_result = run_interface(
                operator, workspace, "start", "--request", str(request_path), check=False
            )
            operator_calls.append("start")
            if start_result.returncode == 0:
                raise OracleError(f"legacy path selection {legacy_path!r} unexpectedly succeeded")
            reason = (start_result.stderr or "").strip()
            if not reason:
                raise OracleError(
                    f"legacy path rejection for {legacy_path!r} produced no operator-readable reason"
                )
            result: dict[str, Any] = {
                "contract": RESULT_CONTRACT,
                "ok": True,
                "scenario_id": scenario["scenario_id"],
                "planning_run_id": None,
                "planning_states": [],
                "artifact": None,
                "publication": {"state": "not_attempted", "graph_digest": None, "convoy_id": None},
                "integration": {"mode": None, "evidence": [], "assembly_check": None},
                "outcome": {"delivered": False, "accepted": False},
                "effects": [],
                "legacy_path_rejection": {"selection": legacy_path, "reason": reason},
                "interfaces": {
                    "operator": unique_commands(operator_calls),
                    "write_doors": [],
                },
            }
            result["oracle_digest"] = canonical_digest(result)
            return result

        run_interface(operator, workspace, "start", "--request", str(request_path))
        operator_calls.append("start")
        snapshot = observe(operator, workspace)
        operator_calls.append("observe")
        planning_run_id = validate_snapshot(snapshot, "REQUESTED")
        append_state(states, snapshot)

        run_interface(operator, workspace, "synthesize")
        operator_calls.append("synthesize")
        snapshot = observe(operator, workspace)
        operator_calls.append("observe")
        validate_snapshot(snapshot, "SPEC_AWAITING_APPROVAL", planning_run_id)
        append_state(states, snapshot)
        artifact_summary = as_dict(snapshot.get("artifact"), "artifact")
        artifact_id = required_string(artifact_summary.get("id"), "artifact.id")
        artifact_digest = required_string(artifact_summary.get("digest"), "artifact.digest")
        validate_artifact_summary(snapshot, artifact_id, artifact_digest, "SPEC")
        artifact = json_output(
            run_interface(operator, workspace, "artifact", "--id", artifact_id), "artifact"
        )
        operator_calls.append("artifact")
        content = required_string(artifact.get("content"), "artifact.content")
        if (
            artifact.get("id") != artifact_id
            or artifact.get("digest") != artifact_digest
            or digest_bytes(content.encode("utf-8")) != artifact_digest
        ):
            raise OracleError("artifact identity or digest is not reproducible from public content")

        run_interface(
            operator,
            workspace,
            "approve",
            "--artifact-id",
            artifact_id,
            "--digest",
            artifact_digest,
        )
        operator_calls.append("approve")
        snapshot = observe(operator, workspace)
        operator_calls.append("observe")
        validate_snapshot(snapshot, "APPROVED_SPEC", planning_run_id)
        append_state(states, snapshot)
        validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
        approval = as_dict(snapshot.get("approval"), "approval")
        if (approval.get("artifact_id"), approval.get("digest")) != (
            artifact_id,
            artifact_digest,
        ):
            raise OracleError("approval did not name the exact artifact identity and digest")

        publish_result = run_interface(
            publication_door,
            workspace,
            "publish",
            "--inject-failure",
            failure,
            check=False,
        )
        snapshot = observe(operator, workspace)
        operator_calls.append("observe")
        if failure == "after-stage":
            if publish_result.returncode == 0:
                raise OracleError("injected publication failure unexpectedly succeeded")
            validate_snapshot(snapshot, "APPROVED_SPEC", planning_run_id)
            validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
            publication = as_dict(snapshot.get("publication"), "publication")
            delivery_items = [
                item for item in snapshot["work_items"]
                if isinstance(item, dict) and item.get("plane") == "delivery"
            ]
            if (
                snapshot.get("delivery_graph") is not None
                or delivery_items
                or publication.get("graph_digest") is not None
                or publication.get("convoy_id") is not None
            ):
                raise OracleError("failed publication left a partial delivery graph or convoy")
            if publication.get("state") != "failed":
                raise OracleError("failed publication was not visible through the operator surface")
            result: dict[str, Any] = {
                "contract": RESULT_CONTRACT,
                "ok": True,
                "scenario_id": scenario["scenario_id"],
                "planning_run_id": planning_run_id,
                "planning_states": states,
                "artifact": {"id": artifact_id, "digest": artifact_digest},
                "publication": {
                    "state": "failed_atomically",
                    "graph_digest": None,
                    "convoy_id": None,
                },
                "integration": {
                    "mode": "single-rig" if len(request["rigs"]) == 1 else "exact-revision-multi-rig",
                    "evidence": [],
                    "assembly_check": None,
                },
                "outcome": {"delivered": False, "accepted": False},
                "effects": [],
                "interfaces": {
                    "operator": unique_commands(operator_calls),
                    "write_doors": ["publish"],
                },
            }
        else:
            if publish_result.returncode != 0:
                detail = publish_result.stderr.strip() or f"exit {publish_result.returncode}"
                raise OracleError(f"publish interface failed: {detail}")
            validate_snapshot(snapshot, "DELIVERY_GRAPH_PUBLISHED", planning_run_id)
            append_state(states, snapshot)
            validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
            graph_digest, convoy_id = validate_graph(snapshot, request)

            for rig in request["rigs"]:
                run_interface(
                    operator,
                    workspace,
                    "integrate",
                    "--rig",
                    rig["name"],
                    "--revision",
                    rig["revision"],
                    "--checkout",
                    str(assemblies[rig["name"]]["checkout"]),
                )
                operator_calls.append("integrate")
            validate_clean_assemblies(assemblies)
            snapshot = observe(operator, workspace)
            operator_calls.append("observe")
            validate_snapshot(snapshot, "DELIVERING", planning_run_id)
            append_state(states, snapshot)
            validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
            integration_evidence = validate_integrations(snapshot, request, assemblies)

            run_interface(operator, workspace, "verify-assembly")
            operator_calls.append("verify-assembly")
            validate_clean_assemblies(assemblies)
            snapshot = observe(operator, workspace)
            operator_calls.append("observe")
            validate_snapshot(snapshot, "DELIVERING", planning_run_id)
            validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
            validate_integrations(snapshot, request, assemblies)
            assembly_check = validate_assembly_evidence(snapshot, request, assemblies)

            multi_slice = len(request["slices"]) > 1
            if multi_slice:
                run_interface(operator, workspace, "review-assembly")
                operator_calls.append("review-assembly")
                snapshot = observe(operator, workspace)
                operator_calls.append("observe")
                review = as_dict(snapshot.get("review"), "review")
                if (
                    review.get("verdict") != "pass"
                    or review.get("scope") != "assembled_diff"
                    or set(as_list(review.get("focus"), "review.focus"))
                    != {"interaction_risks", "spec_drift"}
                ):
                    raise OracleError(
                        "multi-slice outcome did not receive one independent "
                        "assembled-diff review of interaction risks and Spec drift"
                    )
                duplicate_review = run_interface(operator, workspace, "review-assembly", check=False)
                operator_calls.append("review-assembly")
                if duplicate_review.returncode == 0:
                    raise OracleError("a second assembled-diff review was accepted for one outcome")
            else:
                duplicate_review = run_interface(operator, workspace, "review-assembly", check=False)
                operator_calls.append("review-assembly")
                if duplicate_review.returncode == 0:
                    raise OracleError("a single-slice outcome received a duplicate final review")

            run_interface(operator, workspace, "deliver")
            operator_calls.append("deliver")
            snapshot = observe(operator, workspace)
            operator_calls.append("observe")
            validate_snapshot(snapshot, "DELIVERED_OUTCOME", planning_run_id)
            append_state(states, snapshot)
            validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
            outcome = as_dict(snapshot.get("outcome"), "outcome")
            if outcome.get("state") != "delivered" or outcome.get("accepted") is not False:
                raise OracleError("Delivered Outcome was not observable before acceptance")
            validate_integrations(snapshot, request, assemblies)

            blocked_effect = run_interface(
                operator, workspace, "attempt-effect", "--kind", "production", check=False
            )
            operator_calls.append("attempt-effect")
            if blocked_effect.returncode == 0 or not blocked_effect.stderr.strip():
                raise OracleError("a sensitive effect was not blocked after Delivered")
            snapshot = observe(operator, workspace)
            operator_calls.append("observe")
            if snapshot.get("effects") != []:
                raise OracleError("a sensitive effect leaked into observation after Delivered")

            if reject_reason != "none":
                run_interface(operator, workspace, "reject", "--reason", reject_reason)
                operator_calls.append("reject")
                snapshot = observe(operator, workspace)
                operator_calls.append("observe")
                validate_snapshot(snapshot, "REJECTED_OUTCOME", planning_run_id)
                append_state(states, snapshot)
                validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
                outcome = as_dict(snapshot.get("outcome"), "outcome")
                routing = {
                    "spec_mismatch": "targeted_repair",
                    "changed_behavior": "planning",
                    "active_danger": "safe_neutralization",
                }[reject_reason]
                if (
                    outcome.get("state") != "rejected"
                    or outcome.get("accepted") is not False
                    or outcome.get("reason") != reject_reason
                    or outcome.get("routing") != routing
                ):
                    raise OracleError("rejection did not route to the reason-specific destination")
                if (
                    snapshot.get("delivery_graph") is None
                    or as_dict(snapshot.get("publication"), "publication").get("state") != "published"
                ):
                    raise OracleError(
                        "rejection performed a default whole-outcome rollback of the delivery graph"
                    )
                validate_integrations(snapshot, request, assemblies)

                blocked_after_reject = run_interface(operator, workspace, "accept", check=False)
                operator_calls.append("accept")
                if blocked_after_reject.returncode == 0:
                    raise OracleError("acceptance succeeded for a rejected outcome")

                blocked_effect = run_interface(
                    operator, workspace, "attempt-effect", "--kind", "destructive", check=False
                )
                operator_calls.append("attempt-effect")
                if blocked_effect.returncode == 0:
                    raise OracleError("a sensitive effect was not blocked after rejection")

                result = {
                    "contract": RESULT_CONTRACT,
                    "ok": True,
                    "scenario_id": scenario["scenario_id"],
                    "planning_run_id": planning_run_id,
                    "planning_states": states,
                    "artifact": {"id": artifact_id, "digest": artifact_digest},
                    "publication": {
                        "state": "published",
                        "graph_digest": graph_digest,
                        "convoy_id": convoy_id,
                    },
                    "integration": {
                        "mode": "single-rig" if len(request["rigs"]) == 1 else "exact-revision-multi-rig",
                        "evidence": integration_evidence,
                        "assembly_check": assembly_check,
                    },
                    "review": {"required": multi_slice, "performed": multi_slice},
                    "outcome": {"delivered": True, "accepted": False},
                    "rejection": {"reason": reject_reason, "routing": routing},
                    "effects": [],
                    "interfaces": {
                        "operator": unique_commands(operator_calls),
                        "write_doors": ["publish"],
                    },
                }
            else:
                run_interface(operator, workspace, "accept")
                operator_calls.append("accept")
                snapshot = observe(operator, workspace)
                operator_calls.append("observe")
                validate_snapshot(snapshot, "ACCEPTED_OUTCOME", planning_run_id)
                append_state(states, snapshot)
                validate_artifact_summary(snapshot, artifact_id, artifact_digest, "APPROVED_SPEC")
                outcome = as_dict(snapshot.get("outcome"), "outcome")
                if outcome.get("state") != "accepted" or outcome.get("accepted") is not True:
                    raise OracleError("Accepted Outcome was not distinct from Delivered Outcome")
                validate_integrations(snapshot, request, assemblies)

                blocked_effect = run_interface(
                    operator, workspace, "attempt-effect", "--kind", "spend", check=False
                )
                operator_calls.append("attempt-effect")
                if blocked_effect.returncode == 0:
                    raise OracleError("a sensitive effect was not blocked after Accepted")
                snapshot = observe(operator, workspace)
                operator_calls.append("observe")
                if snapshot.get("effects") != []:
                    raise OracleError("a sensitive effect leaked into observation after Accepted")

                result = {
                    "contract": RESULT_CONTRACT,
                    "ok": True,
                    "scenario_id": scenario["scenario_id"],
                    "planning_run_id": planning_run_id,
                    "planning_states": states,
                    "artifact": {"id": artifact_id, "digest": artifact_digest},
                    "publication": {
                        "state": "published",
                        "graph_digest": graph_digest,
                        "convoy_id": convoy_id,
                    },
                    "integration": {
                        "mode": "single-rig" if len(request["rigs"]) == 1 else "exact-revision-multi-rig",
                        "evidence": integration_evidence,
                        "assembly_check": assembly_check,
                    },
                    "review": {"required": multi_slice, "performed": multi_slice},
                    "outcome": {"delivered": True, "accepted": True},
                    "effects": [],
                    "interfaces": {
                        "operator": unique_commands(operator_calls),
                        "write_doors": ["publish"],
                    },
                }

    result["oracle_digest"] = canonical_digest(result)
    return result


# --- the delivery of one ticket of a marked convoy (T19) -------------------------


def validate_delivery_scenario(scenario: dict[str, Any]) -> tuple[str, dict[str, Any], str | None]:
    scenario_id = required_string(scenario.get("scenario_id"), "scenario_id")
    if not SAFE_ID.fullmatch(scenario_id):
        raise OracleError("scenario_id contains unsupported characters")
    unknown = sorted(set(scenario) - {"contract", "scenario_id", "project", "inject", "expect"})
    if unknown:
        raise OracleError(f"delivery scenario has unknown fields: {', '.join(unknown)}")
    # The project of the fixture the ticket belongs to (T35); absent, the
    # driver walks a ticket of its first project.
    project = scenario.get("project")
    if project is not None and (not isinstance(project, str) or not SAFE_ID.fullmatch(project)):
        raise OracleError(f"project must name a project of the fixture, got {project!r}")
    inject = as_dict(scenario.get("inject", {}), "inject").get("delivery", "none")
    if inject not in DELIVERY_INJECTIONS:
        raise OracleError(f"inject.delivery must be one of {', '.join(DELIVERY_INJECTIONS)}")
    expect = as_dict(scenario.get("expect"), "expect")
    if not isinstance(expect.get("closed"), bool) or set(expect) - {"closed", "missing"}:
        raise OracleError("expect must be {closed: true} or {closed: false, missing: [condition numbers]}")
    missing = expect.get("missing", [])
    if expect["closed"] == bool(missing) or any(
            isinstance(n, bool) or not isinstance(n, int) or not 1 <= n <= len(TICKET_END_CONDITIONS) for n in missing):
        raise OracleError("expect.missing names the conditions of the ticket-end gate an open ticket misses, and only then")
    return inject, {"closed": expect["closed"], "missing": sorted(missing)}, project


def run_driver(driver: Path, workspace: Path, command: str, *arguments: str) -> dict[str, Any]:
    """One call of the delivery driver. It launches the product on a
    loopback port, so it is not contained by the no-socket sandbox of the
    planning adapters; it gets a clean environment and its own workspace."""
    if not driver.is_absolute() or not driver.is_file() or not os.access(driver, os.X_OK):
        raise OracleError(f"delivery driver must be an absolute executable file: {driver}")
    try:
        result = subprocess.run(
            (str(driver), "--workspace", str(workspace), command, *arguments),
            cwd=workspace, env=hermetic_env(workspace), text=True, capture_output=True,
            stdin=subprocess.DEVNULL, timeout=600, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise OracleError(f"delivery driver {command} failed to run: {exc}") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise OracleError(f"delivery driver {command} failed: {detail}")
    return json_output(result, f"delivery driver {command}")


class DeliveryTarget:
    """Where the public state of the walked ticket is read."""

    def __init__(self, prepared: dict[str, Any], workspace: Path):
        self.convoy = required_string(prepared.get("convoy"), "prepare.convoy")
        self.ticket = required_string(prepared.get("ticket"), "prepare.ticket")
        self.repo = Path(required_string(prepared.get("repo"), "prepare.repo"))
        environment = as_dict(prepared.get("environment"), "prepare.environment")
        if any(not isinstance(key, str) or not isinstance(value, str) for key, value in environment.items()):
            raise OracleError("prepare.environment must map names to strings")
        self.environment = {**hermetic_env(workspace), **environment}

    def read(self, tool: str, *arguments: str) -> tuple[int, dict[str, Any]]:
        """One read-only command of the flow, run by the oracle itself."""
        try:
            result = subprocess.run((str(BIN / tool), *arguments), env=self.environment, text=True,
                                    capture_output=True, stdin=subprocess.DEVNULL, timeout=120, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise OracleError(f"{tool} {arguments[0]} failed to run: {exc}") from exc
        return result.returncode, json_output(result, f"{tool} {arguments[0]}")

    def is_ancestor(self, commit: Any, of: str) -> bool:
        if not isinstance(commit, str) or not REVISION.fullmatch(commit):
            return False
        return subprocess.run(("git", "-C", str(self.repo), "merge-base", "--is-ancestor", commit, of),
                              env=git_env(), capture_output=True, check=False).returncode == 0


def gate_record(ticket: dict[str, Any]) -> dict[str, Any]:
    """The record of the ticket-end gate of a closed ticket: the version of
    the list and its nine passing verdicts, or the ticket was not closed by
    the gate."""
    record = (ticket.get("gates") or {}).get("ticket_end")
    conditions = record.get("conditions") if isinstance(record, dict) else None
    if (not isinstance(conditions, list) or record.get("version") != TICKET_END_VERSION
            or [(entry.get("number"), entry.get("name"), entry.get("verdict")) for entry in conditions
                if isinstance(entry, dict)]
            != [(number, name, "pass") for number, name in enumerate(TICKET_END_CONDITIONS, start=1)]):
        raise OracleError(
            "the ticket is closed without the record of the ticket-end gate (its version and nine passing verdicts): "
            "it was closed outside the gate")
    return record


def observe_delivery(target: DeliveryTarget) -> list[tuple[str, str]]:
    """The lifecycle states the ticket has reached, each with the time of
    the public record that shows it, read on bin/convoy-state show and on
    the branches of the repository."""
    status, shown = target.read("convoy-state", "show", target.convoy, "--repo", str(target.repo))
    convoy = as_dict(shown.get("convoy"), "convoy state")
    ticket = next((entry for entry in as_list(shown.get("tickets"), "convoy tickets")
                   if isinstance(entry, dict) and entry.get("id") == target.ticket), None)
    if ticket is None:
        raise OracleError(f"ticket {target.ticket} is not tracked by convoy {target.convoy}")
    if ticket.get("status") == "closed":
        gate_record(ticket)
    anomalies = [*convoy.get("unruled", []), *ticket.get("unruled", [])]
    if status != 0 or anomalies:
        reasons = "; ".join(str(entry.get("reason", entry)) for entry in anomalies) or shown.get("message") or shown.get("error")
        raise OracleError(f"the convoy is in a state the flow has no rule for: {reasons}")

    tip = ticket.get("tip")
    integration = convoy.get("integration") or {}
    frozen = ticket.get("criteria_frozen") or {}
    gates, tdd = ticket.get("gates") or {}, ticket.get("tdd") or {}
    reached: list[tuple[str, str]] = []

    def reach(state: str, at: Any) -> None:
        reached.append((state, required_string(at, f"time of the record of « {state} »")))

    if convoy.get("mark") and integration.get("branch") and frozen.get("identical") is not None:
        reach("published", integration.get("at"))
    if "dispatch" in gates:
        reach("started", gates["dispatch"].get("at"))
    if tdd.get("red"):
        reach("red", tdd["red"].get("at"))
    reviews = (ticket.get("test_review") or {}).get("rounds") or []
    if tdd.get("freeze") and reviews and reviews[-1].get("verdict") == "favorable":
        reach("frozen", tdd["freeze"].get("at"))
    handoff, exit_record = ticket.get("handoff") or {}, ticket.get("exit") or {}
    if (tdd.get("green") and tdd["green"].get("commit") == tip and exit_record.get("exit") == "finished"
            and handoff.get("partial") is False and handoff.get("commit") == tip):
        reach("coded", exit_record.get("at"))
    review = ticket.get("code_review") or {}
    if (review.get("state") or {}).get("verdict") == "favorable" and review["state"].get("commit") == tip:
        reach("reviewed", (review.get("rounds") or [{}])[-1].get("at"))
    evaluation = ticket.get("evaluation") or {}
    if (evaluation.get("state") or {}).get("outcome") == "favorable" and evaluation["state"].get("commit") == tip:
        reach("evaluated", (evaluation.get("rounds") or [{}])[-1].get("at"))
    merge = ticket.get("merge") or {}
    if merge.get("outcome") == "merged":
        branch = required_string(integration.get("branch"), "integration branch")
        if (merge.get("ticket_commit") != tip or not target.is_ancestor(tip, str(merge.get("commit")))
                or not target.is_ancestor(merge.get("commit"), f"refs/heads/{branch}")):
            raise OracleError("the merge recorded on the ticket is not the tip of its branch merged into the integration branch")
        reach("merged", merge.get("at"))
    if ticket.get("status") == "closed":
        record = gate_record(ticket)
        if record.get("commit") != merge.get("ticket_commit"):
            raise OracleError("the record of the ticket-end gate is not tied to the commit of the ticket that was merged")
        reach("closed", record.get("at"))

    names = [state for state, _ in reached]
    if names != list(DELIVERY_STATES[:len(names)]):
        raise OracleError(f"lifecycle out of order: the ticket shows {', '.join(names) or 'nothing'} "
                          f"without {next(state for state in DELIVERY_STATES if state not in names)}")
    times = [at for _, at in reached]
    if times != sorted(times):
        raise OracleError(f"lifecycle out of order: the records of {', '.join(names)} are not in the order of the flow")
    return reached


def execute_delivery(scenario: dict[str, Any], driver: Path) -> dict[str, Any]:
    inject, expect, project = validate_delivery_scenario(scenario)
    with tempfile.TemporaryDirectory(prefix="fixture-city-delivery-") as temporary:
        workspace = Path(temporary).resolve()
        prepare = ("--inject", inject, *(("--project", project) if project else ()))
        target = DeliveryTarget(run_driver(driver, workspace, "prepare", *prepare), workspace)
        try:
            run_driver(driver, workspace, "publish")
            lifecycle = [state for state, _ in observe_delivery(target)]
            if lifecycle != ["published"]:
                raise OracleError(f"a published ticket shows {', '.join(lifecycle) or 'nothing'}: expected published, not started")
            observations = [list(lifecycle)]
            for _ in range(DELIVERY_MAX_EVENTS):
                event = run_driver(driver, workspace, "advance")
                reached = [state for state, _ in observe_delivery(target)]
                if reached[:len(lifecycle)] != lifecycle:
                    raise OracleError(f"lifecycle went backwards: {', '.join(lifecycle)} then {', '.join(reached)}")
                observations.append(reached[len(lifecycle):])
                lifecycle = reached
                if lifecycle[-1] == "closed" or event.get("idle") is True:
                    break
            closed = lifecycle[-1] == "closed"
            status, check = target.read("ticket-end", "check", target.convoy, target.ticket, "--repo", str(target.repo))
            missing = sorted(check.get("missing") or [])
            conditions = [
                {"number": entry.get("number"), "name": entry.get("name"), "verdict": entry.get("verdict")}
                for entry in as_list(check.get("conditions"), "ticket-end check conditions")]
            if closed != expect["closed"]:
                named = "; ".join(f"condition {n} ({TICKET_END_CONDITIONS[n - 1]})" for n in missing)
                raise OracleError(
                    f"the ticket is {'closed' if closed else 'open'} after {', '.join(lifecycle)}"
                    + (f"; the ticket-end gate names: {named}" if named else ""))
            if missing != expect["missing"] or (status == 0) != (not missing):
                raise OracleError(f"the ticket-end gate names conditions {missing}, the scenario expects {expect['missing']}")
            verify_status, verified = target.read("evidence-capture", "verify", target.convoy, target.ticket)
            if closed and verify_status != 0:
                raise OracleError(f"the evidence of the closed ticket does not verify: {verified.get('error')}")
        finally:
            run_driver(driver, workspace, "stop")
    result = {
        "contract": DELIVERY_RESULT_CONTRACT,
        "ok": True,
        "scenario_id": scenario["scenario_id"],
        "lifecycle": lifecycle,
        "observations": observations,
        "closed": closed,
        "ticket_end": {"version": check.get("version"), "conditions": conditions, "missing": missing},
        "evidence": {"verified": verify_status == 0,
                     "pieces": sorted(entry.get("piece") for entry in verified.get("pieces") or [])},
        "interfaces": {
            "driver": ["prepare", "publish", "advance", "stop"],
            "read": ["convoy-state show", "git merge-base", "ticket-end check", "evidence-capture verify"],
        },
    }
    if project:
        result["project"] = project
    result["oracle_digest"] = canonical_digest(result)
    return result


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(prog=PROGRAM)
    subparsers = value.add_subparsers(dest="command", required=True)
    run = subparsers.add_parser("run")
    run.add_argument("scenario", type=Path)
    run.add_argument("--operator", type=Path)
    run.add_argument("--publication-door", type=Path)
    run.add_argument("--delivery-driver", type=Path)
    return value


def run_scenario(args: argparse.Namespace) -> dict[str, Any]:
    """The contract of the scenario says which walk it is."""
    path = args.scenario.resolve()
    try:
        contract = as_dict(json.loads(path.read_text(encoding="utf-8")), "scenario").get("contract")
    except (OSError, json.JSONDecodeError) as exc:
        raise OracleError(f"cannot read scenario {path}: {exc}") from exc
    if contract == DELIVERY_SCENARIO_CONTRACT:
        if args.delivery_driver is None or args.operator is not None or args.publication_door is not None:
            raise OracleError("a delivery scenario is run with --delivery-driver, and with no planning adapter")
        return execute_delivery(json.loads(path.read_text(encoding="utf-8")), args.delivery_driver)
    if args.operator is None or args.publication_door is None or args.delivery_driver is not None:
        raise OracleError("a planning scenario is run with --operator and --publication-door")
    return execute(path, args.operator, args.publication_door)


def main() -> int:
    try:
        args = parser().parse_args()
        result = run_scenario(args)
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
        return 0
    except OracleError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
