#!/usr/bin/env bash
# human-mail-archive — archive the mail addressed to `human` once it is older
# than HUMAN_MAIL_ARCHIVE_DAYS (3), at most HUMAN_MAIL_ARCHIVE_BATCH (200)
# messages a run (orders/human-mail-archive.toml, af-q55qqx.10).
#
# Nobody reads that mailbox: Benjamin answers in the Cockpit, and what waits
# on him is the gc.needs_benjamin field of a bead, never a mail. On 21/11/2026
# it held 3324 unread messages since 14/09 (1790 « Reaper anomalies » from
# gc's core reaper, 231 « NEEDS BENJAMIN »), about 50 more a day. gc's status
# counts the open mail under a 1 s limit (upstream, statusStoreReadTimeout):
# it answered `partial: true, mail: count timed out after 1s`, and the
# Cockpit's health stayed ok:false.
#
# Archiving closes the message bead; `gc bd reopen <id>` brings one back.
# Read-but-open mail is left to gc's own sweep-nudge-mail.
#
# Usage: human-mail-archive [--dry-run]
set -uo pipefail

GC_BIN="${GC_BIN:-gc}"
DAYS="${HUMAN_MAIL_ARCHIVE_DAYS:-3}"
BATCH="${HUMAN_MAIL_ARCHIVE_BATCH:-200}"
DRY=0
case "${1:-}" in
  --dry-run) DRY=1 ;;
  "") ;;
  -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "human-mail-archive: unknown argument: $1" >&2; exit 2 ;;
esac

cutoff=$(date -u -d "-$DAYS days" +%Y-%m-%dT%H:%M:%SZ)
inbox=$("$GC_BIN" mail inbox human --json 2>/dev/null) \
  || { echo "human-mail-archive: the human mailbox could not be read" >&2; exit 1; }
# The batch is cut in jq: `| head` would close the pipe on jq (SIGPIPE, and
# pipefail reads it as a failure) as soon as the backlog exceeds one batch.
ids=$(jq -r --arg cut "$cutoff" --argjson n "$BATCH" \
  '[.messages[]? | select(.created_at < $cut) | .id][:$n][]' <<<"$inbox") \
  || { echo "human-mail-archive: unreadable inbox answer" >&2; exit 1; }
[ -n "$ids" ] || { echo "human-mail-archive: nothing to human older than $DAYS days"; exit 0; }
count=$(grep -c . <<<"$ids")
if [ "$DRY" = 1 ]; then
  echo "human-mail-archive: would archive $count message(s) to human older than $DAYS days"
  exit 0
fi
# shellcheck disable=SC2086  # one id per word
"$GC_BIN" mail archive $ids >/dev/null \
  || { echo "human-mail-archive: gc mail archive failed for $count message(s)" >&2; exit 1; }
echo "human-mail-archive: archived $count message(s) to human older than $DAYS days"
