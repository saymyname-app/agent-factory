#!/usr/bin/env python3
"""Read JSON observations on stdin and emit the deterministic human contract."""

from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from factory_state import StateContractError, project_candidates, project_human_state  # noqa: E402


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) == 2 else "state"
    if mode not in {"state", "candidates"}:
        print("factory-human-state: ERROR: usage: factory-human-state [state|candidates]", file=sys.stderr)
        return 2
    try:
        value = json.load(sys.stdin)
        projected = project_candidates(value) if mode == "candidates" else project_human_state(value)
    except (json.JSONDecodeError, StateContractError) as exc:
        print(f"factory-human-state: ERROR: {exc}", file=sys.stderr)
        return 1
    json.dump(projected, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
