#!/usr/bin/env bash
#
# campaign-pointer — the one door for the coordination-root pointers
# (ADR-0023, pre-refactor: active mechanism, not re-validated).
#
# gc.current, gc.current_jit, gc.last_delivered, gc.needs_benjamin and
# gc.blocked_reason on the coordination Bead had no door at all: the Mayor
# prompt and docs/OPERATIONS.md told agents to set them by hand with
# `gc bd update --set-metadata`. Four campaign stops in 48h trace back to a
# hand-written pointer a reader then died on (missing proof fields, a stale
# gc.next_outcome, a direct candidate status write, prose left in gc.current).
# This script validates the bead id and the transition before writing, and
# writes every field of the transition together -- the same shape as
# bin/product-queue and bin/deliver-close, which were never corrupted
# *through* their own door, only around it.
#
# Usage: campaign-pointer <command> [arguments]
#
# Commands:
#   start <bead>                 Set gc.current and gc.current_jit to <bead>
#                                 after checking it exists and is open or
#                                 in_progress.
#   finish <bead>                Move <bead> into gc.last_delivered -- only if
#                                 it already carries the six ADR-0016 delivery-
#                                 proof fields (bin/deliver-close is the only
#                                 door that writes them) -- and clear
#                                 gc.current / gc.current_jit to none.
#   escalate <bead> <reason>     Set gc.needs_benjamin on <bead>, append the
#                                 cause to its notes, and mail human -- the
#                                 escalation contract (agents/mayor/prompt.
#                                 template.md) as one atomic command instead of
#                                 three prompt lines. <bead> is whatever needs
#                                 the decision: an ordinary work Bead, or the
#                                 coordination Bead itself when the decision
#                                 blocks the whole automatic campaign (that is
#                                 what mayor-campaign's activate/block/resume
#                                 gates read).
#   clear-decision [<bead>]       Once the decision is resolved, clear
#                                 gc.needs_benjamin on <bead> (default: the
#                                 coordination Bead, where gc.blocked_reason is
#                                 cleared too) and note the clearance.
set -Eeuo pipefail

PROGRAM_NAME="campaign-pointer"
GC_BIN="${GC_BIN:-gc}"
COORDINATION_BEAD="${CAMPAIGN_COORDINATION_BEAD:-af-1vr4}"
BEAD_ID_RE='^[A-Za-z][A-Za-z0-9]*-[A-Za-z0-9]+(\.[A-Za-z0-9]+)*$'

log() { printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2; }
die() { log "ERROR: $1"; exit 1; }

usage() {
  awk 'NR > 1 && /^set /{exit} NR > 1' "$0" | sed 's/^# \{0,1\}//'
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is unavailable: $1"
}

valid_bead_id() {
  [[ $1 =~ $BEAD_ID_RE ]]
}

show_bead() {  # $1 = bead id -> prints the single-object JSON, or dies
  local id=$1 raw
  raw=$("$GC_BIN" bd show "$id" --json 2>/dev/null) \
    || die "$id is unavailable."
  jq -e 'if type == "array" then (if length == 1 then .[0] else error("ambiguous") end) else . end' \
    <<<"$raw" 2>/dev/null || die "$id did not resolve to exactly one Bead."
}

cmd_start() {
  local bead=${1:-}
  [[ -n $bead ]] || die "Usage: $PROGRAM_NAME start <bead>"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  local issue status
  issue=$(show_bead "$bead")
  status=$(jq -r '.status' <<<"$issue")
  [[ $status == open || $status == in_progress ]] \
    || die "$bead is $status, not open or in_progress; refusing to make it the current outcome."
  "$GC_BIN" bd update "$COORDINATION_BEAD" \
    --set-metadata "gc.current=$bead" \
    --set-metadata "gc.current_jit=$bead" \
    --set-metadata "gc.campaign_progress_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >/dev/null || die "Beads write failed for $COORDINATION_BEAD."
  printf 'STARTED: gc.current -> %s\n' "$bead"
}

cmd_finish() {
  local bead=${1:-}
  [[ -n $bead ]] || die "Usage: $PROGRAM_NAME finish <bead>"
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  local issue metadata missing=()
  issue=$(show_bead "$bead")
  metadata=$(jq -c '.metadata // {}' <<<"$issue")
  [[ $(jq -r '.["gc.delivery_status"] // empty' <<<"$metadata") == merged ]] \
    || missing+=("gc.delivery_status=merged")
  for field in gc.work_outcome gc.github_repo gc.pr_number gc.pr_head gc.merge_commit; do
    [[ -n $(jq -r --arg f "$field" '.[$f] // empty' <<<"$metadata") ]] || missing+=("$field")
  done
  ((${#missing[@]} == 0)) \
    || die "$bead is missing delivery proof (${missing[*]}); close it with bin/deliver-close first."
  "$GC_BIN" bd update "$COORDINATION_BEAD" \
    --set-metadata "gc.last_delivered=$bead" \
    --set-metadata "gc.current=none" \
    --set-metadata "gc.current_jit=none" \
    --set-metadata "gc.campaign_progress_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    >/dev/null || die "Beads write failed for $COORDINATION_BEAD."
  printf 'FINISHED: gc.last_delivered -> %s\n' "$bead"
}

cmd_escalate() {
  local bead=${1:-} reason=${2:-}
  [[ -n $bead && -n $reason ]] || die "Usage: $PROGRAM_NAME escalate <bead> <reason>"
  [[ $reason != *$'\n'* && $reason != *$'\r'* ]] || die "reason must be a single line."
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  show_bead "$bead" >/dev/null
  "$GC_BIN" bd update "$bead" \
    --set-metadata "gc.needs_benjamin=$reason" \
    --append-notes "NEEDS BENJAMIN: $reason" \
    >/dev/null || die "Beads write failed for $bead."
  "$GC_BIN" mail send human --notify \
    -s "NEEDS BENJAMIN: $bead" \
    -m "ACTION: campaign-pointer escalated $bead
STATE: $reason
EVIDENCE: gc bd show $bead
NEXT: decide, then run campaign-pointer clear-decision $bead" \
    >/dev/null || die "Could not mail human; gc.needs_benjamin is set but the mail was not sent -- retry rather than clearing it by hand."
  printf 'ESCALATED: %s — %s\n' "$bead" "$reason"
}

cmd_clear_decision() {
  local bead=${1:-$COORDINATION_BEAD}
  valid_bead_id "$bead" || die "'$bead' is not a Bead id."
  show_bead "$bead" >/dev/null
  if [[ $bead == "$COORDINATION_BEAD" ]]; then
    "$GC_BIN" bd update "$bead" \
      --set-metadata "gc.needs_benjamin=none" \
      --set-metadata "gc.blocked_reason=none" \
      >/dev/null || die "Beads write failed for $bead."
  else
    "$GC_BIN" bd update "$bead" \
      --set-metadata "gc.needs_benjamin=none" \
      --append-notes "DECISION CLEARED: gc.needs_benjamin reset to none" \
      >/dev/null || die "Beads write failed for $bead."
  fi
  printf 'CLEARED: decision on %s\n' "$bead"
}

main() {
  local command=${1:-}
  [[ -n $command ]] || { usage >&2; return 2; }
  shift
  case "$command" in
    -h|--help|help) usage ;;
    start) cmd_start "$@" ;;
    finish) cmd_finish "$@" ;;
    escalate) cmd_escalate "$@" ;;
    clear-decision) cmd_clear_decision "$@" ;;
    *) usage >&2; return 2 ;;
  esac
}

require_command jq
require_command "$GC_BIN"
require_command flock
LOCK_FILE="${CAMPAIGN_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/agent-factory-mayor-campaign.lock}"
exec 9>"$LOCK_FILE"
flock -w 10 9 || die "Could not acquire the campaign coordination lock."
main "$@"
