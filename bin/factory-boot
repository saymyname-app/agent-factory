#!/usr/bin/env bash
# factory-boot — bring the Factory back after an UNPLANNED machine restart.
#
# On 2026-09-17 a Windows reboot brought WSL and gascity-supervisor back
# (systemd), but not the controller: the Factory
# sat dark until a PO session replayed RUNBOOK_STOP_AND_RESTART.md §3 by hand.
# This is that section, idempotent, for the Windows logon task to call.
#
# It restores what a restart breaks. It never overrides a deliberate stop:
# a city suspended by an operator (`gc suspend`) stays suspended.
#
# Usage: factory-boot [--dry-run]
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
GC_BIN="${GC_BIN:-gc}"
LOG="${FACTORY_BOOT_LOG:-$ROOT/.gc/runtime/factory-boot.log}"
LOCK="${FACTORY_BOOT_LOCK:-${XDG_RUNTIME_DIR:-/tmp}/agent-factory-boot.lock}"
WAIT_SECONDS="${FACTORY_BOOT_WAIT_SECONDS:-120}"
DRY_RUN=0

case "${1:-}" in
  --dry-run) DRY_RUN=1 ;;
  -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") ;;
  *) echo "unknown argument: $1" >&2; exit 2 ;;
esac

cd "$ROOT" || { echo "factory-boot: $ROOT unreachable" >&2; exit 2; }
mkdir -p "$(dirname "$LOG")"
exec 9>"$LOCK"
flock -n 9 || { echo "factory-boot: already running"; exit 0; }

FAILED=0
say() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG"; }
step() {  # step <label> <command...>
  local label=$1; shift
  if [ "$DRY_RUN" = "1" ]; then say "WOULD  $label: $*"; return 0; fi
  if "$@" >>"$LOG" 2>&1; then say "OK     $label"; else say "FAILED $label (see $LOG)"; FAILED=1; return 1; fi
}

say "factory-boot — $ROOT$([ "$DRY_RUN" = 1 ] && echo ' (dry run)')"

# 1. The provider overlay must exist before the city config can load.
step "provider overlay" ./bin/provider-failover apply --no-reload

# 2. Supervisor (systemd normally has it already).
if "$GC_BIN" supervisor status 2>/dev/null | grep -qi 'is running'; then
  say "OK     supervisor already running"
else
  step "supervisor start" "$GC_BIN" supervisor start
fi

# Pack formula exec checks are resolved relative to each rig. Re-materialise
# containment-safe managed artifacts before the controller can dispatch a
# workflow after a reboot, rig re-clone, or pack re-pin.
step "build gate materialisation" ./bin/factory-build-gates

# 2b. Cockpit — a process separate from gc that must keep reading and
# showing status through a suspended or stopped city (af-0b6ffa, spec .9,
# .13), so it starts here unconditionally, ahead of the suspended-city
# early exit below. Idempotent: `cockpit start` is itself a no-op if an
# instance is already running, but the status check keeps that visible in
# the boot log instead of silent.
COCKPIT_BIN="${COCKPIT_BIN:-./bin/cockpit}"
if "$COCKPIT_BIN" status >/dev/null 2>&1; then
  say "OK     cockpit already running"
else
  step "cockpit start" "$COCKPIT_BIN" start
fi

# 3. Controller. A suspended city is an operator's decision: leave it alone.
city_json() { timeout 30 "$GC_BIN" status --json 2>/dev/null; }
STATUS_JSON=$(city_json || true)
[ -n "$STATUS_JSON" ] || STATUS_JSON='{}'
if [ "$(jq -r '.suspended // false' <<<"$STATUS_JSON" 2>/dev/null)" = "true" ]; then
  say "SKIP   city is suspended by an operator — not resuming it"
  exit 0
fi
if [ "$(jq -r '.running // false' <<<"$STATUS_JSON" 2>/dev/null)" = "true" ]; then
  say "OK     controller already running"
else
  step "controller start" "$GC_BIN" start
  deadline=$(( $(date +%s) + WAIT_SECONDS ))
  until [ "$DRY_RUN" = "1" ] || [ "$(city_json | jq -r '.running // false' 2>/dev/null)" = "true" ]; do
    [ "$(date +%s)" -ge "$deadline" ] && { say "FAILED controller did not report running within ${WAIT_SECONDS}s"; FAILED=1; break; }
    sleep 5
  done
fi

[ "$FAILED" = "0" ] && say "factory-boot done — healthy start" || say "factory-boot done — WITH FAILURES, run ./bin/factory-guard"
exit "$FAILED"
