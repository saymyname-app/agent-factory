#!/usr/bin/env python3
"""Launch and stop a project's product at an exact commit (spec af-wf4w5r
.12, T01, af-m8m1kc).

This is the launcher that an author, the Evaluator and the Acceptance
Session all use: it reads a project's launch recipe from its Project
Planning Profile descriptor (`bin/project-planning-profile describe`), runs
it from a clean `git worktree` checkout of the exact commit requested (never
the caller's current working tree), on a freshly chosen free port, against a
named synthetic dataset, and polls the declared health probe until the
product answers or the timeout expires. `stop` tears the process and its
worktree down and frees the port.

    ./bin/project-launch [--repo-root <product repo>] start <descriptor.json> --commit <sha> --dataset <name> --state-file <path>
    ./bin/project-launch stop --state-file <path>
    ./bin/project-launch sweep

Every launch has an owner and a lifetime, whoever calls. The owner is the
process named by `--owner-pid`, or else the caller of `start` itself; a
guard stops the launch as soon as that process ends, however it ends. A
`finally` that would have stopped it does not run on SIGKILL, and the
product, in its own session, lived on for days (af-f7x7w7). Only a caller
whose product must outlive the command (an open Acceptance Session, a
product an evaluation reuses between passes) says `--detached`: it has no
owner. Every launch ends at `--max-lifetime` (DEFAULT_LIFETIME) at the
latest, and when its record is removed without `stop` (a test that deletes
its folder): on 22/10/2026 24 cockpits of criteria tests whose folders were
deleted held the VM at a load of 141 for up to 283 minutes.

`sweep` is the net under the guard (a guard killed, a host restarted, a
launch made before this rule): it stops every launch whose owner has ended,
whose lifetime is over, or whose matching sidecar names a source repository
that has disappeared, and releases copies left behind. Each stop is written
to TRACE_FILE. orders/project-launch-sweep.toml runs it.

`--repo-root` is the repository of the product (default: the Factory's own);
the profile tool is always the one next to this launcher.

A project whose descriptor declares no `launch` block is refused: exit
non-zero, a message naming the missing declaration, and no process left
running.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path
from types import ModuleType

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from account_home import account_home  # noqa: E402


def process_identity(pid: int) -> str | None:
    """The start time of a running `pid`: with the pid, it names one process
    for its whole life, so a reused pid is not mistaken for the owner."""
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
    except (OSError, IndexError):
        return None
    return None if fields[0] in {"Z", "X"} else fields[19]


# The longest a launch lives without `--max-lifetime`: above the longest
# evaluation of config/delivery-flow.json (24 datasets x 240 s = 5760 s),
# relaunched once.
DEFAULT_LIFETIME = 6 * 3600
# What the sweep leaves to the guard, which acts within a second.
SWEEP_GRACE = 60
# Where the guard and the sweep write each launch they stop: ~/.local/state
# is writable inside bin/delivery-role-sandbox too.
TRACE_FILE = Path(os.environ.get("FACTORY_LAUNCH_TRACE")
                  or account_home() / ".local" / "state" / "agent-factory-launch" / "stops.jsonl")


def trace(event: dict) -> None:
    """One line per launch stopped by the guard or the sweep; a trace that
    cannot be written never keeps a launch alive."""
    line = json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), **event}, sort_keys=True)
    try:
        TRACE_FILE.parent.mkdir(parents=True, exist_ok=True)
        with TRACE_FILE.open("a") as out:
            out.write(line + "\n")
    except OSError:
        print(line, file=sys.stderr)


def guard(args: argparse.Namespace) -> int:
    """Stop the launch `--launch-id` once its owner has ended, once `start`
    has ended before the product was healthy (killed while it waited for
    the probe), or once its lifetime is over. A record removed or replaced
    without `stop` leaves the launch to this guard alone: it stops what
    remains of it, then leaves."""
    # Read once and kept by the module: a caller's TMPDIR removed while the
    # launch runs (a test's folder) made every later read fail, and the
    # guard ended on that error, its product left running.
    tempfile.gettempdir()
    known = None
    while True:
        try:
            record = json.loads(Path(args.state_file).read_text())
        except FileNotFoundError:
            record = None
        except (OSError, ValueError):
            time.sleep(1)  # replaced at this instant: read it again next round
            continue
        if not isinstance(record, dict) or record.get("launch_id") != args.launch_id:
            if known and (owned_processes(args.launch_id) or Path(known["worktree"]).exists()):
                return end_launch(known, "record_removed", None)
            return 0
        known = record
        if args.owner_pid and process_identity(args.owner_pid) != args.owner_start:
            return end_launch(record, "owner_ended", args.state_file)
        if not record.get("started") and process_identity(args.start_pid) != args.start_start:
            return end_launch(record, "start_ended", args.state_file)
        if time.time() > args.deadline:
            return end_launch(record, "lifetime_over", args.state_file)
        time.sleep(1)


def end_launch(record: dict, reason: str, state_file: str | None) -> int:
    """Stop the launch of `record` for `reason`, and trace it."""
    try:
        error = stop_record(record, legacy=False)
    except Exception as exc:  # traced, and left to the sweep
        error = f"{type(exc).__name__}: {exc}"
    if error is None and state_file:
        Path(state_file).unlink(missing_ok=True)
    trace({"by": "guard", "reason": reason, "launch_id": record.get("launch_id"),
           "worktree": record.get("worktree"), "repo_root": record.get("repo_root"),
           "state_file": state_file, "stopped": error is None, "error": error})
    return 0 if error is None else 1


def write_record(path: str, record: dict) -> None:
    """An interrupted update must leave the previous recovery record intact."""
    target = Path(path)
    temporary = target.with_name(f".{target.name}.{uuid.uuid4().hex}.tmp")
    try:
        temporary.write_text(json.dumps(record, sort_keys=True))
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)


def repo_root_default() -> Path:
    return Path(__file__).resolve().parent.parent


def load_profile_module() -> ModuleType:
    # The profile tool is the Factory's, next to this launcher: `--repo-root`
    # names the repository of the product, which may be another one.
    tool_path = Path(__file__).resolve().parent / "project-planning-profile"
    loader = importlib.machinery.SourceFileLoader("project_planning_profile", str(tool_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def pick_free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


# The port chosen is free when chosen, not reserved: another process of the
# host can bind it before the product does. A launch whose port is lost so is
# made again on another port, this many times in all.
PORT_ATTEMPTS = 3


def listening_sockets(port: int) -> set[str]:
    """The inodes of the sockets listening on `port` of the loopback (or of
    every address), as /proc/net/tcp and tcp6 list them."""
    inodes = set()
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            lines = Path(table).read_text().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            fields = line.split()
            address, _, hex_port = fields[1].rpartition(":")
            if int(hex_port, 16) == port and fields[3] == "0A" and address.strip("0") in ("", "100007F"):
                inodes.add(fields[9])
    return inodes


def process_tree(pid: int) -> set[int]:
    """`pid` and every live process descended from it."""
    parents: dict[int, list[int]] = {}
    for stat in Path("/proc").glob("[0-9]*/stat"):
        try:
            ppid = int(stat.read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            continue
        parents.setdefault(ppid, []).append(int(stat.parent.name))
    tree, pending = set(), [pid]
    while pending:
        current = pending.pop()
        if current not in tree:
            tree.add(current)
            pending.extend(parents.get(current, []))
    return tree


def listener_is_launched(port: int, pid: int, launch_id: str) -> bool:
    """Whether what listens on `port` is a process of the launch: `pid`, one
    of its descendants, or a process carrying its mark -- the product's
    identity, not only an answer on its port."""
    sockets = {f"socket:[{inode}]" for inode in listening_sockets(port)}
    for member in process_tree(pid) | set(owned_processes(launch_id)):
        try:
            if any(os.readlink(fd) in sockets for fd in Path(f"/proc/{member}/fd").iterdir()):
                return True
        except OSError:
            continue
    return False


def terminate(pid: int) -> bool:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return True
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True
        if sys.platform == "linux":
            try:
                # kill(pid, 0) also succeeds for a zombie. It has exited;
                # waiting for its parent to reap it spends the whole grace.
                state = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0]
                if state in {"Z", "X"}:
                    return True
            except FileNotFoundError:
                return True
            except (OSError, IndexError):
                pass  # Cannot inspect it: keep the ordinary signal check.
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return True
    for _ in range(10):
        if not process_alive(pid):
            return True
        time.sleep(0.1)
    return False


def process_alive(pid: int) -> bool:
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0] not in {"Z", "X"}
    except FileNotFoundError:
        return False


def group_members(group: int) -> list[int]:
    members = []
    for stat in Path("/proc").glob("[0-9]*/stat"):
        try:
            fields = stat.read_text().rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            continue
        if fields[0] not in {"Z", "X"} and int(fields[2]) == group:
            members.append(int(stat.parent.name))
    return members


def owned_processes(launch_id: str) -> list[int]:
    """Find product descendants even when they create another process group."""
    marker = f"FACTORY_LAUNCH_ID={launch_id}".encode()
    found = []
    for environ in Path("/proc").glob("[0-9]*/environ"):
        try:
            if marker in environ.read_bytes().split(b"\0") and process_alive(int(environ.parent.name)):
                found.append(int(environ.parent.name))
        except (OSError, ValueError):
            continue
    return found


def terminate_owned(launch_id: str) -> bool:
    for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 1)):
        pending = owned_processes(launch_id)
        if not pending:
            return True
        for pid in pending:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if not owned_processes(launch_id):
                return True
            time.sleep(0.1)
    return not owned_processes(launch_id)


def worktree_processes(worktree: str) -> list[int]:
    """A child that cleared the launch marker still holds the isolated copy."""
    target = Path(worktree).resolve()
    found = []
    for cwd_link in Path("/proc").glob("[0-9]*/cwd"):
        try:
            cwd = cwd_link.resolve(strict=True)
            pid = int(cwd_link.parent.name)
        except (OSError, RuntimeError, ValueError):
            continue
        if (cwd == target or target in cwd.parents) and process_alive(pid):
            found.append(pid)
    return found


def port_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def resolve_commit(repo_root: Path, commit: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(repo_root), "rev-parse", commit],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        raise RuntimeError(f"cannot resolve commit {commit!r}: {result.stderr.strip()}")
    return result.stdout.strip()


def add_worktree(repo_root: Path, commit: str, worktree: str) -> None:
    result = subprocess.run(
        ["git", "-C", str(repo_root), "worktree", "add", "--detach", worktree, commit],
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        raise RuntimeError(f"cannot check out {commit}: {result.stderr.strip()}")


def verify_worktree(repo_root: str, worktree: str, launch_id: str | None = None,
                    commit: str | None = None) -> tuple[bool, Path | None]:
    """Refuse cleanup outside a launcher-owned temporary worktree."""
    target = Path(worktree)
    temporary = Path(tempfile.gettempdir()).resolve()
    if (not target.is_absolute() or target.parent != temporary or target.is_symlink()
            or not re.fullmatch(r"project-launch-[A-Za-z0-9_-]+", target.name)):
        raise RuntimeError(f"unexpected product worktree path: {worktree}")
    registered = False
    # A removed product repository (a deleted ticket worktree) registers
    # nothing: only the owner sidecar below can still vouch for the copy.
    if Path(repo_root).exists():
        listed = subprocess.run(["git", "-C", repo_root, "worktree", "list", "--porcelain"],
                                text=True, capture_output=True)
        if listed.returncode:
            raise RuntimeError(f"cannot verify product worktree: {listed.stderr.strip()}")
        registered = any(block.splitlines()[0] == f"worktree {target}"
                         for block in listed.stdout.strip().split("\n\n") if block)
    owner = Path(f"{worktree}.owner")
    owned = False
    if launch_id and commit and owner.is_file():
        try:
            owned = json.loads(owner.read_text()) == {
                "launch_id": launch_id, "repo_root": repo_root, "commit": commit}
        except (OSError, ValueError):
            pass
    if target.exists() and not (registered or owned):
        raise RuntimeError(f"unverified product worktree kept: {worktree}")
    return registered, owner if owned else None


def remove_worktree(repo_root: str, worktree: str, launch_id: str | None = None,
                    commit: str | None = None) -> None:
    import shutil

    registered, owner = verify_worktree(repo_root, worktree, launch_id, commit)
    if registered and Path(worktree).exists():
        result = subprocess.run(["git", "-C", repo_root, "worktree", "remove", "--force", worktree],
                                capture_output=True, text=True)
        if result.returncode:
            raise RuntimeError(f"worktree was not released: {worktree}: {result.stderr.strip()}")
    elif Path(worktree).exists():
        # An interrupted git worktree add can leave an unregistered partial
        # checkout. Its owner sidecar was written before that operation.
        shutil.rmtree(worktree)
    if Path(repo_root).exists():
        result = subprocess.run(["git", "-C", repo_root, "worktree", "prune"],
                                capture_output=True, text=True)
        if result.returncode:
            raise RuntimeError(f"worktree was not released: {worktree}: {result.stderr.strip()}")
    if Path(worktree).exists():
        raise RuntimeError(f"worktree was not released: {worktree}")
    if owner is not None:
        owner.unlink(missing_ok=True)


def end_attempt(proc: subprocess.Popen, launch_id: str, worktree: str) -> bool:
    """Stop an attempt of the launch, and reap it: True when no process of
    the launch is left (the marked ones, and those still inside its copy)."""
    stopped = (terminate_owned(launch_id) and
               all(terminate(pid) for pid in worktree_processes(worktree)) and
               not worktree_processes(worktree))
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        stopped = False
    return stopped


def spawn(recipe: list[str], worktree: str, port: int, dataset: str, marks: dict[str, str]) -> subprocess.Popen:
    """Run `recipe` on `port`, in its own session, carrying the launch marks:
    its identity, its owner and its deadline, which the sweep reads."""
    argv = [token.format(python=sys.executable, port=str(port), dataset=dataset) for token in recipe]
    with open(Path(worktree) / "launch.log", "a") as log_file:
        return subprocess.Popen(argv, cwd=worktree, stdout=log_file, stderr=subprocess.STDOUT,
                                start_new_session=True, env={**os.environ, **marks})


def probe_until_healthy(proc: subprocess.Popen, port: int, launch_id: str, probe_url: str,
                        expect_status: int, timeout: float) -> str:
    """Probe the launched product. The outcome: `healthy` (the probe
    answers, and the answer comes from the launch), `port_lost` (another
    process answers on the port, or holds it when the product ended) or
    `unhealthy`."""
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            return "port_lost" if listening_sockets(port) else "unhealthy"
        try:
            with urllib.request.urlopen(probe_url, timeout=1) as response:
                answered = response.status == expect_status
        except (urllib.error.URLError, ConnectionError, OSError):
            answered = False
        if answered:
            if listener_is_launched(port, proc.pid, launch_id):
                return "healthy"
            if proc.poll() is None and listening_sockets(port):
                return "port_lost"
        time.sleep(0.1)
    return "unhealthy"


def release_guard(watch: subprocess.Popen, state_file: str) -> int:
    """A refused start whose cleanup is confirmed leaves nothing, its guard
    included; one that kept its record keeps its guard. The exit code of
    the refusal."""
    if not Path(state_file).exists():
        watch.kill()
        watch.wait()
    return 1


def cmd_start(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo_root).resolve()
    if args.state_file and Path(args.state_file).exists():
        print(json.dumps({"started": False, "error": "launch record still exists; stop it before retry"}, sort_keys=True))
        return 1
    if args.detached and args.owner_pid is not None:
        print(json.dumps({"started": False, "error": "--detached and --owner-pid name two owners"}, sort_keys=True))
        return 1
    if not args.max_lifetime > 0:
        print(json.dumps({"started": False, "error": f"--max-lifetime must be positive: {args.max_lifetime}"},
                         sort_keys=True))
        return 1
    owner_pid = None if args.detached else args.owner_pid if args.owner_pid is not None else os.getppid()
    owner_start = None
    if owner_pid is not None:
        owner_start = process_identity(owner_pid)
        if owner_start is None:
            print(json.dumps({"started": False, "error": f"owner process {owner_pid} is not running"},
                             sort_keys=True))
            return 1
    deadline = time.time() + args.max_lifetime
    descriptor_path = Path(args.descriptor).resolve()
    ppp = load_profile_module()

    try:
        descriptor = ppp.load_descriptor(descriptor_path)
    except ppp.ProfileError as exc:
        print(json.dumps({"started": False, "error": str(exc)}, sort_keys=True))
        return 1

    launch = descriptor.get("launch")
    if not launch:
        print(
            json.dumps(
                {
                    "started": False,
                    "error": (
                        f"project {descriptor['project_id']!r} declares no "
                        "launch recipe in its profile"
                    ),
                },
                sort_keys=True,
            )
        )
        return 1

    # A product is launched on a named synthetic dataset, never without one
    # (spec af-wf4w5r .12, T38).
    if args.dataset is None:
        print(
            json.dumps(
                {
                    "started": False,
                    "error": (
                        "no dataset named: a product is launched on a named dataset "
                        f"(--dataset); declared datasets: {sorted(launch['datasets'])}"
                    ),
                },
                sort_keys=True,
            )
        )
        return 1
    if args.dataset not in launch["datasets"]:
        print(
            json.dumps(
                {
                    "started": False,
                    "error": (
                        f"unknown dataset {args.dataset!r}; declared "
                        f"datasets: {sorted(launch['datasets'])}"
                    ),
                },
                sort_keys=True,
            )
        )
        return 1
    dataset_rel = launch["datasets"][args.dataset]

    try:
        resolved_commit = resolve_commit(repo_root, args.commit)
    except RuntimeError as exc:
        print(json.dumps({"started": False, "error": str(exc)}, sort_keys=True))
        return 1

    # The record owns the capacity slot before git starts materializing the
    # copy. A crash during checkout therefore leaves a recoverable path.
    worktree = str(Path(tempfile.gettempdir()) / f"project-launch-{uuid.uuid4().hex}")
    launch_id = uuid.uuid4().hex
    record = {"started": False, "launch_id": launch_id, "worktree": worktree,
              "repo_root": str(repo_root), "commit": resolved_commit, "dataset": args.dataset,
              "owner_pid": owner_pid, "deadline": deadline}
    marks = {"FACTORY_LAUNCH_ID": launch_id, "FACTORY_LAUNCH_DEADLINE": str(deadline),
             "FACTORY_LAUNCH_OWNER": f"{owner_pid}:{owner_start}" if owner_pid is not None else ""}
    try:
        write_record(args.state_file, record)
    except OSError as exc:
        print(json.dumps({"started": False, "error": f"launch record could not be written: {exc}"}, sort_keys=True))
        return 1
    # From the first record on: the owner can die while the product still
    # answers its probe, and this start with it.
    watch = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "guard",
                              "--owner-pid", str(owner_pid or 0), "--owner-start", owner_start or "",
                              "--start-pid", str(os.getpid()), "--start-start", process_identity(os.getpid()),
                              "--launch-id", launch_id, "--deadline", str(deadline),
                              "--state-file", str(Path(args.state_file).resolve())],
                             cwd="/", stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        Path(f"{worktree}.owner").write_text(json.dumps({
            "launch_id": launch_id, "repo_root": str(repo_root), "commit": resolved_commit}))
        add_worktree(repo_root, resolved_commit, worktree)
    except (OSError, RuntimeError) as exc:
        try:
            remove_worktree(str(repo_root), worktree, launch_id, resolved_commit)
        except (OSError, RuntimeError):
            pass
        else:
            Path(args.state_file).unlink(missing_ok=True)
        print(json.dumps({"started": False, "error": str(exc),
                          "cleanup_confirmed": not Path(args.state_file).exists()}, sort_keys=True))
        return release_guard(watch, args.state_file)

    dataset_abs = str(Path(worktree) / dataset_rel) if dataset_rel else ""
    probe_path = launch["health_probe"]["path"]
    expect_status = launch["health_probe"].get("expect_status", 200)
    # The port chosen is free when chosen, not reserved (PORT_ATTEMPTS): an
    # attempt whose port another process took is stopped, reaped, and made
    # again on another port; the record names the port and process of the
    # current attempt, so a crash at any moment leaves what `stop` needs.
    for attempt in range(1, PORT_ATTEMPTS + 1):
        port = pick_free_port()
        record["port"] = port
        try:
            write_record(args.state_file, record)
        except OSError as exc:
            try:
                remove_worktree(str(repo_root), worktree, launch_id, resolved_commit)
            except (OSError, RuntimeError):
                pass
            else:
                Path(args.state_file).unlink(missing_ok=True)
            print(json.dumps({"started": False, "error": f"launch record could not be updated: {exc}",
                              "cleanup_confirmed": not Path(args.state_file).exists()}, sort_keys=True))
            return release_guard(watch, args.state_file)
        address = f"http://127.0.0.1:{port}"
        try:
            proc = spawn(launch["recipe"], worktree, port, dataset_abs, marks)
        except OSError as exc:
            # Nothing was started: the copy and the record are released below.
            outcome, stopped, error = "unhealthy", True, f"recipe could not be started: {exc}"
            break
        record.update(pid=proc.pid, process_group=proc.pid)
        write_record(args.state_file, record)
        outcome = probe_until_healthy(proc, port, launch_id, address + probe_path, expect_status, args.timeout)
        if outcome == "healthy":
            break
        stopped = end_attempt(proc, launch_id, worktree)
        if outcome != "port_lost":
            error = f"product did not become healthy within {args.timeout}s"
            break
        error = (f"port {port} was taken by another process before the product bound it "
                 f"({attempt} of {PORT_ATTEMPTS} ports tried)")
        # The lost port is the other process's: a kept record must not make
        # `stop` wait for it to be free.
        record.pop("port")
        write_record(args.state_file, record)
        if not stopped:
            break

    if outcome != "healthy":
        # A lost port is held by another process: only an unhealthy product
        # must have released its own.
        cleaned = stopped and (outcome == "port_lost" or port_free(port))
        if cleaned:
            try:
                remove_worktree(str(repo_root), worktree, launch_id, resolved_commit)
            except (OSError, RuntimeError):
                cleaned = False
        if cleaned:
            Path(args.state_file).unlink(missing_ok=True)
        print(json.dumps({
            "started": False,
            "error": error,
            "cleanup_confirmed": cleaned,
            "state_file": args.state_file if not cleaned else None,
        }, sort_keys=True))
        return release_guard(watch, args.state_file)

    record.update(started=True, address=address)
    write_record(args.state_file, record)
    print(json.dumps(record, sort_keys=True))
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    if args.state_file:
        try:
            record = json.loads(Path(args.state_file).read_text())
        except (OSError, json.JSONDecodeError) as exc:
            print(json.dumps({"stopped": False, "error": str(exc)}, sort_keys=True))
            return 1
    else:
        record = {"pid": args.pid, "worktree": args.worktree, "repo_root": args.repo_root}

    error = stop_record(record, legacy=bool(args.state_file))
    if error is not None:
        print(json.dumps({"stopped": False, "error": error}, sort_keys=True))
        return 1
    if args.state_file:
        Path(args.state_file).unlink(missing_ok=True)

    print(json.dumps({"stopped": True}, sort_keys=True))
    return 0


def stop_record(record: dict, legacy: bool) -> str | None:
    """Stop the launch `record` describes and release its copy: None once
    done, else why not. `legacy`: a record read from a file, which may
    predate the launch marker."""
    pid = record.get("pid")
    worktree = record.get("worktree")
    repo_root = record.get("repo_root") or str(repo_root_default())

    group = record.get("process_group")
    launch_id = record.get("launch_id")
    if worktree:
        try:
            verify_worktree(repo_root, worktree, launch_id, record.get("commit"))
        except RuntimeError as exc:
            return str(exc)
    if launch_id:
        stopped = terminate_owned(launch_id)
        if stopped and worktree:
            # A descendant may drop the marker but still hold this verified copy.
            stopped = all(terminate(pid) for pid in worktree_processes(worktree))
        if (group and group_members(int(group))) or (worktree and worktree_processes(worktree)):
            stopped = False
    elif legacy:
        # Old records had no launch marker. A PID may now belong to another
        # process; only stop processes still inside the verified worktree.
        stopped = all(terminate(member) for member in worktree_processes(worktree)) if worktree else False
        if worktree and worktree_processes(worktree):
            stopped = False
    else:
        stopped = terminate(int(pid)) if pid else True
    if not stopped or (record.get("port") and not port_free(int(record["port"]))):
        return "product or port remains active"
    try:
        if worktree:
            remove_worktree(repo_root, worktree, launch_id, record.get("commit"))
    except (OSError, RuntimeError) as exc:
        return str(exc)
    return None


def launch_marks(pid: int) -> dict[str, str]:
    try:
        environ = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
    except OSError:
        return {}
    return {key: value for key, _, value in (entry.decode(errors="replace").partition("=") for entry in environ)
            if key.startswith("FACTORY_LAUNCH_")}


def process_age(pid: int) -> float | None:
    try:
        started = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19])
        uptime = float(Path("/proc/uptime").read_text().split()[0])
    except (OSError, IndexError, ValueError):
        return None
    return uptime - started / os.sysconf("SC_CLK_TCK")


def overdue(marks: dict[str, str], age: float | None, now: float,
            source_repository: str | None = None) -> str | None:
    """Why a running launch must end, from the marks its product carries."""
    owner = marks.get("FACTORY_LAUNCH_OWNER")
    if owner:
        pid, _, start = owner.partition(":")
        if process_identity(int(pid)) != start:
            return "owner_ended"
    deadline = marks.get("FACTORY_LAUNCH_DEADLINE")
    if deadline:
        return "lifetime_over" if now > float(deadline) + SWEEP_GRACE else None
    # Revisions from before owner/deadline marks still have a launch id and
    # an ownership sidecar. Criteria tests run such revisions from temporary
    # repositories: once that repository is gone, no test can still own the
    # product, so waiting DEFAULT_LIFETIME only lets an orphan consume the
    # host (af-0uhmdl).
    if source_repository and not Path(source_repository).exists():
        return "source_repository_gone"
    # Launched before every launch had a deadline: its age is all there is.
    return "lifetime_over" if age is not None and age > DEFAULT_LIFETIME else None


def launch_copy(members: list[int]) -> str | None:
    """The launcher's copy a launch runs in, from its processes' folders."""
    temporary = Path(tempfile.gettempdir()).resolve()
    for pid in members:
        try:
            cwd = Path(os.readlink(f"/proc/{pid}/cwd"))
        except OSError:
            continue
        for folder in (cwd, *cwd.parents):
            if folder.parent == temporary and re.fullmatch(r"project-launch-[A-Za-z0-9_-]+", folder.name):
                return str(folder)
    return None


def copy_owner(worktree: str) -> dict:
    try:
        owner = json.loads(Path(f"{worktree}.owner").read_text())
    except (OSError, ValueError):
        return {}
    return owner if isinstance(owner, dict) else {}


def cmd_sweep(args: argparse.Namespace) -> int:
    """Stop every launch whose owner has ended or whose lifetime is over,
    whoever started it, then release the copies no process holds any more
    once they are older than a lifetime. Each stop is traced."""
    now = time.time()
    launches: dict[str, list[int]] = {}
    for environ in Path("/proc").glob("[0-9]*/environ"):
        try:
            pid = int(environ.parent.name)
            launch_id = launch_marks(pid).get("FACTORY_LAUNCH_ID")
        except ValueError:
            continue
        if launch_id and process_alive(pid) and (not args.launch_id or launch_id in args.launch_id):
            launches.setdefault(launch_id, []).append(pid)
    stopped, kept = [], 0
    for launch_id, members in sorted(launches.items()):
        first = min(members)
        worktree = launch_copy(members)
        owner = copy_owner(worktree) if worktree else {}
        source_repository = owner.get("repo_root")
        if owner.get("launch_id") != launch_id or not isinstance(source_repository, str):
            source_repository = None
        reason = overdue(launch_marks(first), process_age(first), now, source_repository)
        if reason is None:
            kept += 1
            continue
        event = {"by": "sweep", "reason": reason, "launch_id": launch_id, "pids": sorted(members),
                 "worktree": worktree, "repo_root": owner.get("repo_root"), "dry_run": args.dry_run}
        if not args.dry_run:
            error = None
            if owner.get("launch_id") == launch_id:
                error = stop_record({"launch_id": launch_id, "worktree": worktree, "repo_root": owner.get("repo_root"),
                                     "commit": owner.get("commit")}, legacy=False)
            elif not terminate_owned(launch_id):
                error = "product remains active"
            event.update(stopped=error is None, error=error)
            trace(event)
        stopped.append(event)
    released = []
    temporary = Path(tempfile.gettempdir())
    for sidecar in sorted(temporary.glob("project-launch-*.owner")):
        worktree = str(sidecar)[:-len(".owner")]
        try:
            age = now - sidecar.stat().st_mtime
        except OSError:
            continue
        owner = copy_owner(worktree)
        if args.launch_id and owner.get("launch_id") not in args.launch_id:
            continue
        if (age <= DEFAULT_LIFETIME or owner.get("launch_id") in launches
                or (Path(worktree).exists() and worktree_processes(worktree))):
            continue
        event = {"by": "sweep", "reason": "copy_left", "launch_id": owner.get("launch_id"), "worktree": worktree,
                 "repo_root": owner.get("repo_root"), "dry_run": args.dry_run}
        if not args.dry_run:
            error = None
            try:
                if Path(worktree).exists():
                    remove_worktree(owner.get("repo_root") or str(repo_root_default()), worktree,
                                    owner.get("launch_id"), owner.get("commit"))
                sidecar.unlink(missing_ok=True)
            except (OSError, RuntimeError) as exc:
                error = str(exc)
            event.update(released=error is None, error=error)
            trace(event)
        released.append(event)
    print(json.dumps({"stopped": stopped, "released": released, "running_kept": kept}, sort_keys=True))
    # A copy that cannot be released only takes disk, and is traced; a
    # launch that cannot be stopped fails the order.
    return 0 if all(event.get("error") is None for event in stopped) else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="project-launch", description=__doc__)
    parser.add_argument("--repo-root", default=str(repo_root_default()))
    subparsers = parser.add_subparsers(dest="command", required=True)

    start = subparsers.add_parser("start", help="launch a project's product at an exact commit")
    start.add_argument("descriptor", help="path to the project's descriptor JSON file")
    start.add_argument("--commit", default="HEAD", help="exact commit to check out and launch")
    start.add_argument("--dataset", default=None, help="named synthetic dataset to launch on")
    start.add_argument("--timeout", type=float, default=15.0, help="seconds to wait for the health probe")
    start.add_argument("--state-file", required=True, help="where to write the recoverable launch record for stop")
    start.add_argument("--owner-pid", type=int, default=None,
                       help="process whose end stops the launch (default: the caller of start)")
    start.add_argument("--detached", action="store_true",
                       help="no owner: the product outlives the command, until stop or its lifetime")
    start.add_argument("--max-lifetime", type=float, default=DEFAULT_LIFETIME,
                       help=f"seconds after which the launch is stopped (default {DEFAULT_LIFETIME})")
    start.set_defaults(func=cmd_start)

    watch = subparsers.add_parser("guard", help=argparse.SUPPRESS)
    watch.add_argument("--owner-pid", type=int, required=True)
    watch.add_argument("--owner-start", required=True)
    watch.add_argument("--start-pid", type=int, required=True)
    watch.add_argument("--start-start", required=True)
    watch.add_argument("--launch-id", required=True)
    watch.add_argument("--deadline", type=float, required=True)
    watch.add_argument("--state-file", required=True)
    watch.set_defaults(func=guard)

    sweep = subparsers.add_parser("sweep", help="stop launches whose owner ended or whose lifetime is over")
    sweep.add_argument("--dry-run", action="store_true", help="name them without stopping anything")
    sweep.add_argument("--launch-id", action="append", default=[],
                       help="only this launch (repeatable): a test sweeps its own launches, not the host's")
    sweep.set_defaults(func=cmd_sweep)

    stop = subparsers.add_parser("stop", help="stop a launched product and release its port")
    stop.add_argument("--state-file", default=None, help="launch record written by `start --state-file`")
    stop.add_argument("--pid", type=int, default=None, help="process id, if not using --state-file")
    stop.add_argument("--worktree", default=None, help="worktree path, if not using --state-file")
    stop.set_defaults(func=cmd_stop)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
