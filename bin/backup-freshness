#!/usr/bin/env bash
# backup-freshness — page the Mayor when the off-box jsonl archive hasn't
# been pushed in over 24h while beads kept changing underneath it (O13,
# spec-factory-operations-v2-2026-09-28; docs/INVENTORY.md F24: "archive
# repo last pushed 18:42Z while jsonl-export completes every 15 min: no
# freshness signal says whether pushes still happen").
#
# Symptom-only (SRE: page on symptoms, not causes): this never touches
# jsonl-export itself, only observes its output and pages when the archive
# is both stale AND there was something worth backing up.
#
# Usage: backup-freshness [--check-only] [--quiet]
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
CHECK_ONLY=0
QUIET=0
STALE_AFTER="${BACKUP_FRESHNESS_STALE_AFTER:-86400}"  # 24h, in seconds
# Overridable so a test city (which has no bin/ of its own) can point this
# at the real repo's escalation-door instead of $FACTORY_ROOT's.
ESCALATION_DOOR_BIN="${ESCALATION_DOOR_BIN:-$ROOT/bin/escalation-door}"

while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) CHECK_ONLY=1 ;;
    --quiet) QUIET=1 ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

say() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }

cd "$ROOT" || { echo "backup-freshness: $ROOT unreachable" >&2; exit 2; }
for required in gc jq git; do
  command -v "$required" >/dev/null 2>&1 || { say "backup-freshness: $required unavailable, skipping"; exit 0; }
done

PACK_STATE_DIR="${GC_PACK_STATE_DIR:-$ROOT/.gc/runtime/packs/core}"
ARCHIVE_REPO="${GC_JSONL_ARCHIVE_REPO:-$PACK_STATE_DIR/jsonl-archive}"

if [ ! -d "$ARCHIVE_REPO/.git" ]; then
  say "backup-freshness: no archive repo at $ARCHIVE_REPO, skipping"
  exit 0
fi

LAST_COMMIT_EPOCH=$(git -C "$ARCHIVE_REPO" log -1 --format=%ct 2>/dev/null)
[ -n "$LAST_COMMIT_EPOCH" ] || LAST_COMMIT_EPOCH=0
NOW=$(date +%s)
AGE=$((NOW - LAST_COMMIT_EPOCH))

if [ "$AGE" -le "$STALE_AFTER" ]; then
  say "backup-freshness: archive pushed $((AGE / 3600))h ago, within threshold"
  exit 1
fi

LAST_COMMIT_ISO=$(date -u -d "@$LAST_COMMIT_EPOCH" +%Y-%m-%dT%H:%M:%SZ)
if [ -n "${BACKUP_FRESHNESS_CHANGED_OVERRIDE:-}" ]; then
  # Test seam only: gc events needs a running supervisor/API server, which a
  # deterministic test shouldn't have to stand up just to assert this branch.
  CHANGED="$BACKUP_FRESHNESS_CHANGED_OVERRIDE"
else
  UPDATED=$(gc events --type bead.updated --since "${AGE}s" 2>/dev/null | jq -s 'length' 2>/dev/null)
  CLOSED=$(gc events --type bead.closed --since "${AGE}s" 2>/dev/null | jq -s 'length' 2>/dev/null)
  CHANGED=$(( ${UPDATED:-0} + ${CLOSED:-0} ))
fi

if [ "$CHANGED" -eq 0 ]; then
  say "backup-freshness: archive is stale (${AGE}s) but no bead activity since $LAST_COMMIT_ISO — nothing to back up, not paging"
  exit 1
fi

if [ "$CHECK_ONLY" = "1" ]; then
  say "backup-freshness: would page (archive ${AGE}s stale, $CHANGED bead change(s) since $LAST_COMMIT_ISO)"
  exit 0
fi

TITLE="[backup-freshness] off-box archive stale for $((AGE / 3600))h"
EXISTING=$(gc bd list --status open --title-contains "$TITLE" --json 2>/dev/null | jq 'length' 2>/dev/null)
if [ "${EXISTING:-0}" != "0" ]; then
  say "backup-freshness: already flagged"
  exit 0
fi

CREATED=$(gc bd create "$TITLE" -p 1 -t bug \
  -d "The off-box jsonl archive at $ARCHIVE_REPO last committed $LAST_COMMIT_ISO ($((AGE / 3600))h ago), but $CHANGED bead change event(s) have landed since then. jsonl-export runs every 15m and should be pushing continuously (docs/INVENTORY.md F24). Diagnose why jsonl-export stopped pushing (check its order history and $ARCHIVE_REPO/.git for push failures), fix it, then close this bead with the cause." \
  --metadata '{"gc.source":"backup-freshness"}' \
  --json 2>/dev/null | jq -r '(.[0]?.id // .id // empty)')

if [ -z "$CREATED" ]; then
  say "backup-freshness: could not file a bead"
  exit 1
fi

if ! "$ESCALATION_DOOR_BIN" mayor "$CREATED" \
  "off-box archive stale ${AGE}s (>${STALE_AFTER}s) with $CHANGED bead change(s) since last push"; then
  say "backup-freshness: escalation-door failed for $CREATED"
  exit 1
fi

say "backup-freshness: filed $CREATED and paged mayor"
exit 0
