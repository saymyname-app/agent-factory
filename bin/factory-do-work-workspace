#!/usr/bin/env bash
# factory-do-work-workspace — git-worktree lifecycle for mol-do-work, but
# ONLY when the caller's cwd is currently on a protected branch (lib/
# protected_rigs.sh: main on the live agent-factory root, dev on a product
# rig pr-autopilot arms).
#
# 2026-09-17 incident: a worker running mol-do-work committed af-lb3q
# directly in the live agent-factory root (no branch, no worktree, no PR) --
# the same class of mistake the Mayor made minutes earlier in the same
# session. This script is what mol-do-work's workspace-setup and push-and-pr
# steps call to fix that: elsewhere (a non-protected branch, or a worktree
# that already exists) it is a documented no-op, so it is safe to call
# unconditionally from the formula regardless of which rig dispatched the
# work.
#
# af-09hxz: the original version only ever isolated the live agent-factory
# root, keyed on directory identity (cwd == FACTORY_ROOT). Dispatching this
# formula at saymyname-backend/saymyname-frontend committed straight to
# their protected `dev` branch instead, bypassing the CI gate pr-autopilot
# relies on (incident smb-u3zzt / smb-intx3). The check is now keyed on
# whether the repo's *current branch* is one lib/protected_rigs.sh lists for
# that rig, not on which directory the repo happens to live in.
#
# Usage:
#   factory-do-work-workspace enter  <bead-id>
#       Prints "." and does nothing if the calling repo is not on a
#       protected branch (see lib/protected_rigs.sh). Otherwise creates (or
#       reuses) an isolated worktree at
#       $HOME/.local/share/agent-factory-runtime-worktrees/<bead-id> on
#       branch do-work/<bead-id>, off the protected branch, and prints the
#       worktree path. A newly created branch is pushed immediately (O04:
#       "workers push their branch from the first commit"), and the
#       worktree is given a per-worktree post-commit hook that pushes after
#       every commit made in it -- so a session that dies mid-run before
#       reaching `finish` still leaves its commits on the remote branch
#       instead of losing them with the worktree.
#
#   factory-do-work-workspace finish <bead-id> <worktree-path> <branch> <base-branch>
#       No-op if <worktree-path> is "." (enter's no-op marker) or does not
#       exist. Otherwise: commits any remaining changes, pushes <branch>
#       (rebasing onto <base-branch> up to twice on conflict), opens a PR
#       with `gh` if available -- or, if one is already open for <branch>
#       (a re-dispatch resuming earlier work, O04), resumes that PR instead
#       of trying to create a duplicate -- (prints the PR URL on its own
#       stdout line either way), then removes the worktree from whichever
#       repo it was created against.
#
#   factory-do-work-workspace restart <bead-id> <worktree-path> <branch> <reason>
#       O04: "starting over requires a written reason." The one supported
#       way to discard an existing do-work branch/worktree instead of
#       resuming it. Refuses (exit 2, no changes made) if <reason> is
#       empty. With a reason: force-removes the worktree (if present) and
#       deletes the local and (if pushed) remote do-work/<bead-id> branch,
#       so the next `enter` starts clean, and prints the reason it used so
#       the caller can record it on the bead.
#
# $HOME/.local/share/agent-factory-runtime-worktrees/ shares the
# `agent-factory-runtime-*` prefix bin/factory-guard's stale-worktree check
# (section 6) already treats as "the city's own; leave them" -- these
# worktrees are this script's responsibility to remove, not factory-guard's
# to flag.
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
CMD="${1:-}"
[ $# -gt 0 ] && shift

usage() {
  echo "usage: factory-do-work-workspace enter <bead-id>" >&2
  echo "       factory-do-work-workspace finish <bead-id> <worktree-path> <branch> <base-branch>" >&2
  exit 2
}

# protected_branch_for <repo-toplevel> — prints the branch lib/protected_rigs.sh
# says is protected for this repo, or nothing if the repo isn't listed.
protected_branch_for() {
  local here="$1" rel_dir entry rig_dir _repo branch _workflow
  case "$here" in
    "$ROOT") rel_dir="." ;;
    "$ROOT"/*) rel_dir="${here#"$ROOT"/}" ;;
    *) return 0 ;;  # repo lives outside FACTORY_ROOT entirely -- not tracked
  esac
  [ -f "$ROOT/lib/protected_rigs.sh" ] || return 0
  # shellcheck source=/dev/null
  . "$ROOT/lib/protected_rigs.sh"
  for entry in "${PROTECTED_RIGS[@]}"; do
    IFS='|' read -r rig_dir _repo branch _workflow <<<"$entry"
    if [ "$rig_dir" = "$rel_dir" ]; then
      printf '%s\n' "$branch"
      return 0
    fi
  done
}

# install_post_commit_push_hook <worktree-path> — O04: "workers push their
# branch ... after each commit." A per-worktree (not repo-wide) hooksPath so
# this only affects commits made inside the isolated do-work worktree, never
# the live root or other worktrees sharing the same .git. Best-effort: a
# push failure here never blocks the commit that triggered it, the branch
# is still recoverable from the worktree at `finish` or by hand.
install_post_commit_push_hook() {
  local wt="$1" hooks_dir="$1/.git-hooks"
  git -C "$wt" config extensions.worktreeConfig true || return 0
  mkdir -p "$hooks_dir"
  cat > "$hooks_dir/post-commit" <<'HOOK'
#!/usr/bin/env bash
branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
git push origin "HEAD:refs/heads/$branch" >/dev/null 2>&1 || true
HOOK
  chmod +x "$hooks_dir/post-commit"
  git -C "$wt" config --worktree core.hooksPath "$hooks_dir"
}

case "$CMD" in
  enter)
    BEAD_ID="${1:-}"
    [ -n "$BEAD_ID" ] || usage
    HERE=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
    if [ -z "$HERE" ]; then
      echo "."
      exit 0
    fi

    PROTECTED_BRANCH=$(protected_branch_for "$HERE")
    if [ -z "$PROTECTED_BRANCH" ]; then
      echo "."
      exit 0
    fi

    CURRENT_BRANCH=$(git -C "$HERE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [ -z "$CURRENT_BRANCH" ] || [ "$CURRENT_BRANCH" = "HEAD" ]; then
      echo "factory-do-work-workspace: $HERE is in a detached HEAD state; refusing to guess a base branch" >&2
      exit 1
    fi
    if [ "$CURRENT_BRANCH" != "$PROTECTED_BRANCH" ]; then
      # Already on a feature branch off the protected branch -- a direct
      # commit here isn't a direct commit to the protected branch.
      echo "."
      exit 0
    fi

    BRANCH="do-work/$BEAD_ID"
    WT="$HOME/.local/share/agent-factory-runtime-worktrees/$BEAD_ID"

    if [ -d "$WT" ]; then
      install_post_commit_push_hook "$WT" >/dev/null 2>&1 || true
      echo "$WT"
      exit 0
    fi

    git -C "$HERE" fetch --prune origin >/dev/null 2>&1 || true

    mkdir -p "$(dirname "$WT")"
    if git -C "$HERE" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      git -C "$HERE" worktree add "$WT" "$BRANCH" >/dev/null 2>&1 || {
        echo "factory-do-work-workspace: could not add a worktree for existing branch $BRANCH" >&2
        exit 1
      }
    else
      git -C "$HERE" worktree add "$WT" -b "$BRANCH" "$CURRENT_BRANCH" >/dev/null 2>&1 || {
        echo "factory-do-work-workspace: could not create worktree/branch $BRANCH off $CURRENT_BRANCH" >&2
        exit 1
      }
      # O04: push the branch immediately, before any work commit lands, so
      # it exists remotely from the start and the post-commit hook below
      # always has a remote branch to push onto.
      git -C "$WT" push -u origin "$BRANCH" >/dev/null 2>&1 || true
    fi
    install_post_commit_push_hook "$WT" >/dev/null 2>&1 || true
    echo "$WT"
    ;;

  finish)
    BEAD_ID="${1:-}"; WT="${2:-}"; BRANCH="${3:-}"; BASE_BRANCH="${4:-}"
    [ -n "$BEAD_ID" ] && [ -n "$WT" ] && [ -n "$BRANCH" ] && [ -n "$BASE_BRANCH" ] || usage

    if [ "$WT" = "." ]; then
      exit 0   # enter was a no-op (not the live root) -- nothing to finish
    fi
    [ -d "$WT" ] || {
      echo "factory-do-work-workspace: worktree $WT does not exist, nothing to finish" >&2
      exit 0
    }

    (
      cd "$WT" || exit 1
      if [ -n "$(git status --porcelain)" ]; then
        git add -A && git commit -qm "chore: capture remaining work ($BEAD_ID)"
      fi
      ok=0
      for attempt in 1 2 3; do
        if git push -u origin "$BRANCH" >/dev/null 2>&1; then
          ok=1
          break
        fi
        [ "$attempt" -eq 3 ] && break
        git fetch origin "$BASE_BRANCH" >/dev/null 2>&1
        git rebase "origin/$BASE_BRANCH" >/dev/null 2>&1
      done
      [ "$ok" = "1" ]
    ) || {
      echo "factory-do-work-workspace: could not push $BRANCH after 3 attempts" >&2
      exit 1
    }

    PR_URL=""
    if command -v gh >/dev/null 2>&1; then
      PR_URL=$(cd "$WT" && gh pr create --base "$BASE_BRANCH" --head "$BRANCH" \
        --title "do-work: $BEAD_ID" --body "Closes $BEAD_ID." 2>/dev/null || true)
      if [ -z "$PR_URL" ]; then
        # O04: a re-dispatch resuming an existing branch that already has an
        # open PR must resume that PR, not silently fail to record one --
        # `gh pr create` above fails when a PR already exists for this head.
        PR_URL=$(cd "$WT" && gh pr view "$BRANCH" --json url -q .url 2>/dev/null || true)
      fi
    fi

    # af-09hxz: the worktree's origin repo is no longer always $ROOT (a
    # product rig's own checkout can be the origin too) -- resolve it from
    # the worktree's own git metadata instead of assuming FACTORY_ROOT.
    GIT_COMMON_DIR=$(cd "$WT" && git rev-parse --git-common-dir 2>/dev/null)
    case "$GIT_COMMON_DIR" in
      /*) ;;
      *) GIT_COMMON_DIR="$WT/$GIT_COMMON_DIR" ;;
    esac
    ORIGIN_REPO=""
    [ -n "$GIT_COMMON_DIR" ] && ORIGIN_REPO=$(cd -- "$(dirname -- "$GIT_COMMON_DIR")" 2>/dev/null && pwd -P)
    # O05: never fall back to rm -rf. By this point $BRANCH is already
    # pushed (the block above exits before here otherwise), so a failed
    # `worktree remove` loses nothing -- it just leaves a directory for
    # factory-guard's runtime-worktree audit (bin/factory-guard section 6b)
    # to report and a human to clean up by hand.
    if [ -n "$ORIGIN_REPO" ] && [ -d "$ORIGIN_REPO" ]; then
      git -C "$ORIGIN_REPO" worktree remove "$WT" --force 2>/dev/null || \
        echo "factory-do-work-workspace: could not remove worktree $WT after pushing $BRANCH; leaving it in place" >&2
    else
      echo "factory-do-work-workspace: could not resolve the origin repo for worktree $WT; leaving it in place" >&2
    fi

    [ -n "$PR_URL" ] && echo "$PR_URL"
    exit 0
    ;;

  restart)
    BEAD_ID="${1:-}"; WT="${2:-}"; BRANCH="${3:-}"; REASON="${4:-}"
    [ -n "$BEAD_ID" ] && [ -n "$WT" ] && [ -n "$BRANCH" ] || {
      echo "usage: factory-do-work-workspace restart <bead-id> <worktree-path> <branch> <reason>" >&2
      exit 2
    }
    [ -n "$REASON" ] || {
      echo "factory-do-work-workspace: restart of $BEAD_ID refused -- a written reason is required (O04: starting over without a recorded reason is refused)" >&2
      exit 2
    }

    if [ "$WT" != "." ] && [ -d "$WT" ]; then
      GIT_COMMON_DIR=$(cd "$WT" && git rev-parse --git-common-dir 2>/dev/null)
      case "$GIT_COMMON_DIR" in
        /*) ;;
        *) GIT_COMMON_DIR="$WT/$GIT_COMMON_DIR" ;;
      esac
      ORIGIN_REPO=""
      [ -n "$GIT_COMMON_DIR" ] && ORIGIN_REPO=$(cd -- "$(dirname -- "$GIT_COMMON_DIR")" 2>/dev/null && pwd -P)
      if [ -n "$ORIGIN_REPO" ] && [ -d "$ORIGIN_REPO" ]; then
        git -C "$ORIGIN_REPO" worktree remove "$WT" --force 2>/dev/null || \
          echo "factory-do-work-workspace: could not remove worktree $WT while restarting $BEAD_ID; leaving it in place" >&2
        git -C "$ORIGIN_REPO" branch -D "$BRANCH" >/dev/null 2>&1 || true
        git -C "$ORIGIN_REPO" push origin --delete "$BRANCH" >/dev/null 2>&1 || true
      else
        echo "factory-do-work-workspace: could not resolve the origin repo for worktree $WT; leaving it in place" >&2
      fi
    fi

    echo "restart: $REASON"
    exit 0
    ;;

  *)
    usage
    ;;
esac
