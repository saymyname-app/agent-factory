#!/usr/bin/env bash
# factory-do-work-workspace — git-worktree lifecycle for mol-do-work, but
# ONLY when the caller's cwd is currently on a protected branch (lib/
# protected_rigs.sh: main on the live agent-factory root, dev on a product
# rig pr-autopilot arms).
#
# 2026-09-17 incident: a worker running mol-do-work committed af-lb3q
# directly in the live agent-factory root (no branch, no worktree, no PR) --
# the same class of mistake the Mayor made minutes earlier in the same
# session. This script is what mol-do-work's workspace-setup and push-and-pr
# steps call to fix that: elsewhere (a non-protected branch, or a worktree
# that already exists) it is a documented no-op, so it is safe to call
# unconditionally from the formula regardless of which rig dispatched the
# work.
#
# af-09hxz: the original version only ever isolated the live agent-factory
# root, keyed on directory identity (cwd == FACTORY_ROOT). Dispatching this
# formula at saymyname-backend/saymyname-frontend committed straight to
# their protected `dev` branch instead, bypassing the CI gate pr-autopilot
# relies on (incident smb-u3zzt / smb-intx3). The check is now keyed on
# whether the repo's *current branch* is one lib/protected_rigs.sh lists for
# that rig, not on which directory the repo happens to live in.
#
# af-jz4zb (P08): `enter` now takes an exclusive per-repository lock around
# the fetch+worktree-add sequence (two concurrent dispatches on the same
# repo used to race on git's internal refs/index locks with no
# serialization), branches off a freshly fetched `origin/<base>` instead of
# the possibly-stale local branch, and fails loudly -- exits non-zero with a
# readable reason, and removes any worktree it just created -- if the
# auto-push hook cannot be installed, instead of silently swallowing that
# failure and handing back a worktree with no safety net.
#
# Usage:
#   factory-do-work-workspace enter  <bead-id>
#       Prints "." and does nothing if the calling repo is not on a
#       protected branch (see lib/protected_rigs.sh). Otherwise creates (or
#       reuses) an isolated worktree at
#       $HOME/.local/share/agent-factory-runtime-worktrees/<bead-id> on
#       branch do-work/<bead-id>, off the protected branch, and prints the
#       worktree path. A newly created branch is pushed immediately (O04:
#       "workers push their branch from the first commit"), and the
#       worktree is given a per-worktree post-commit hook that pushes after
#       every commit made in it -- so a session that dies mid-run before
#       reaching `finish` still leaves its commits on the remote branch
#       instead of losing them with the worktree.
#
#   factory-do-work-workspace finish <bead-id> <worktree-path> <branch> <base-branch>
#       No-op if <worktree-path> is "." (enter's no-op marker) or does not
#       exist. Otherwise: commits any remaining changes, pushes <branch>
#       (rebasing onto <base-branch> up to twice on conflict), opens a PR
#       with `gh` if available -- or, if one is already open for <branch>
#       (a re-dispatch resuming earlier work, O04), resumes that PR instead
#       of trying to create a duplicate -- (prints the PR URL on its own
#       stdout line either way), then removes the worktree from whichever
#       repo it was created against.
#
#       PR body (D01 watch, 2026-10-06): the body is "Closes <bead-id>."
#       followed by the content of <worktree git dir>/PR_BODY.md when the
#       author wrote one (`git rev-parse --absolute-git-dir` inside the
#       worktree; the file is never committed and goes away with the
#       worktree). On a resumed PR the body is replaced only when that file
#       exists, through the REST pulls endpoint (af-rki3nh: `gh pr edit`
#       always fails on this host). A ticket whose description demands
#       the sections « Non fait », « Écarts », « Constats hors ticket » is
#       refused with exit 3
#       -- before anything is pushed or opened, worktree left as is -- until
#       that file (or the already-open PR's body) carries all three.
#
#       Nothing to deliver (af-cjaj8o): when the branch's head is exactly
#       the head of a PR already merged into <base-branch>, or its tree has
#       no difference with origin/<base-branch>, `finish` pushes nothing,
#       opens no PR, prints no URL, removes the worktree and exits 4. The
#       caller must then leave the ticket's delivery record untouched.
#
#   factory-do-work-workspace restart <bead-id> <worktree-path> <branch> <reason>
#       O04: "starting over requires a written reason." The one supported
#       way to discard an existing do-work branch/worktree instead of
#       resuming it. Refuses (exit 2, no changes made) if <reason> is
#       empty. With a reason: force-removes the worktree (if present) and
#       deletes the local and (if pushed) remote do-work/<bead-id> branch,
#       so the next `enter` starts clean, and prints the reason it used so
#       the caller can record it on the bead.
#
# $HOME/.local/share/agent-factory-runtime-worktrees/ shares the
# `agent-factory-runtime-*` prefix bin/factory-guard's stale-worktree check
# (section 6) already treats as "the city's own; leave them" -- these
# worktrees are this script's responsibility to remove, not factory-guard's
# to flag.
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
CMD="${1:-}"
[ $# -gt 0 ] && shift

usage() {
  echo "usage: factory-do-work-workspace enter <bead-id>" >&2
  echo "       factory-do-work-workspace finish <bead-id> <worktree-path> <branch> <base-branch>" >&2
  exit 2
}

# protected_branch_for <repo-toplevel> — prints the branch lib/protected_rigs.sh
# says is protected for this repo, or nothing if the repo isn't listed.
protected_branch_for() {
  local here="$1" rel_dir entry rig_dir _repo branch _workflow
  case "$here" in
    "$ROOT") rel_dir="." ;;
    "$ROOT"/*) rel_dir="${here#"$ROOT"/}" ;;
    *) return 0 ;;  # repo lives outside FACTORY_ROOT entirely -- not tracked
  esac
  [ -f "$ROOT/lib/protected_rigs.sh" ] || return 0
  # shellcheck source=/dev/null
  . "$ROOT/lib/protected_rigs.sh"
  for entry in "${PROTECTED_RIGS[@]}"; do
    IFS='|' read -r rig_dir _repo branch _workflow <<<"$entry"
    if [ "$rig_dir" = "$rel_dir" ]; then
      printf '%s\n' "$branch"
      return 0
    fi
  done
}

# install_post_commit_push_hook <worktree-path> — O04: "workers push their
# branch ... after each commit." A per-worktree (not repo-wide) hooksPath so
# this only affects commits made inside the isolated do-work worktree, never
# the live root or other worktrees sharing the same .git.
#
# af-jz4zb (P08): installing the hook itself must fail loudly -- a worktree
# with no working auto-push hook silently loses O04's "commits survive a
# session dying mid-run" guarantee. The *push* that hook performs after each
# commit stays best-effort (a transient network failure must never block the
# commit that triggered it; the branch is still recoverable at `finish` or
# by hand), but getting the hook installed in the first place is not.
#
# af-po8j3u: the hook lives under the worktree's own git dir, never in the
# work tree. Written to <worktree>/.git-hooks/, it was an untracked file in
# every repository that did not already track it, and `finish`'s "capture
# remaining work" commit delivered it in the PR.
install_post_commit_push_hook() {
  local wt="$1" git_dir hooks_dir
  git_dir=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null) && [ -n "$git_dir" ] || {
    echo "factory-do-work-workspace: could not resolve the git dir of $wt" >&2
    return 1
  }
  hooks_dir="$git_dir/do-work-hooks"
  git -C "$wt" config extensions.worktreeConfig true || {
    echo "factory-do-work-workspace: could not enable worktree-scoped git config for $wt" >&2
    return 1
  }
  mkdir -p "$hooks_dir" || {
    echo "factory-do-work-workspace: could not create hooks dir $hooks_dir" >&2
    return 1
  }
  cat > "$hooks_dir/post-commit" <<'HOOK'
#!/usr/bin/env bash
branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
git push origin "HEAD:refs/heads/$branch" >/dev/null 2>&1 || true
HOOK
  if [ $? -ne 0 ]; then
    echo "factory-do-work-workspace: could not write post-commit hook at $hooks_dir" >&2
    return 1
  fi
  chmod +x "$hooks_dir/post-commit" || {
    echo "factory-do-work-workspace: could not make post-commit hook executable at $hooks_dir" >&2
    return 1
  }
  git -C "$wt" config --worktree core.hooksPath "$hooks_dir" || {
    echo "factory-do-work-workspace: could not set core.hooksPath to $hooks_dir for $wt" >&2
    return 1
  }
}

# with_repo_lock <repo-toplevel> <command...> — af-jz4zb (P08): an exclusive
# per-repository lock around the fetch+worktree-add sequence. Two concurrent
# `enter` calls for different bead ids on the same repo used to race on
# git's shared internal state (refs/index locks, the .git/worktrees
# directory) with no serialization; this makes them queue instead, so both
# still succeed. Scoped per-repository (keyed on the repo's absolute path),
# not global, so concurrent `enter` calls against different repos never wait
# on each other.
with_repo_lock() {
  local repo="$1"; shift
  local lock_dir="$HOME/.local/share/agent-factory-runtime-worktrees/.locks"
  mkdir -p "$lock_dir"
  local lock_file="$lock_dir/$(printf '%s' "$repo" | cksum | awk '{print $1}').lock"
  (
    exec 9>"$lock_file"
    flock -w 60 9 || {
      echo "factory-do-work-workspace: could not acquire the workspace lock for $repo within 60s" >&2
      exit 1
    }
    "$@"
  )
}

# D01 watch 2026-10-06 (convoy af-wtjo2x): T01's PR #384 merged with the body
# "Closes af-m8m1kc." and nothing else, although its ticket demands that what
# is missing, what differs and what was seen elsewhere be written in the PR
# description under three sections. The author never opens the PR -- `finish`
# does, with a fixed body -- so a rule written only in the ticket could not
# be followed. The rule is now held here.
PR_SECTION_NAMES=("Non fait" "Écarts" "Constats hors ticket")
PR_SECTION_PATTERNS=("Non fait" "Écarts|Ecarts" "Constats hors ticket")

# bead_requires_pr_sections <bead-id> — true when the ticket's description
# names the « Constats hors ticket » section. Fails open (false) when the
# tracker cannot be read: a tracker outage must not block a push.
bead_requires_pr_sections() {
  command -v bd >/dev/null 2>&1 || return 1
  # Read whole, then ask: piped into grep -q under pipefail, a match would
  # read as "no section demanded" whenever bd is killed by SIGPIPE.
  grep -q 'Constats hors ticket' \
    <<<"$(cd "$ROOT" 2>/dev/null && timeout 30 bd show "$1" --json 2>/dev/null)"
}

# missing_pr_sections <file> — prints the demanded sections <file> lacks.
missing_pr_sections() {
  local file="$1" i out=""
  for i in "${!PR_SECTION_NAMES[@]}"; do
    grep -qE -- "${PR_SECTION_PATTERNS[$i]}" "$file" 2>/dev/null \
      || out="${out:+$out, }« ${PR_SECTION_NAMES[$i]} »"
  done
  printf '%s' "$out"
}

case "$CMD" in
  enter)
    BEAD_ID="${1:-}"
    [ -n "$BEAD_ID" ] || usage
    HERE=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
    if [ -z "$HERE" ]; then
      echo "."
      exit 0
    fi

    PROTECTED_BRANCH=$(protected_branch_for "$HERE")
    if [ -z "$PROTECTED_BRANCH" ]; then
      echo "."
      exit 0
    fi

    CURRENT_BRANCH=$(git -C "$HERE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [ -z "$CURRENT_BRANCH" ] || [ "$CURRENT_BRANCH" = "HEAD" ]; then
      echo "factory-do-work-workspace: $HERE is in a detached HEAD state; refusing to guess a base branch" >&2
      exit 1
    fi
    if [ "$CURRENT_BRANCH" != "$PROTECTED_BRANCH" ]; then
      # Already on a feature branch off the protected branch -- a direct
      # commit here isn't a direct commit to the protected branch.
      echo "."
      exit 0
    fi

    BRANCH="do-work/$BEAD_ID"
    WT="$HOME/.local/share/agent-factory-runtime-worktrees/$BEAD_ID"

    if [ -d "$WT" ]; then
      install_post_commit_push_hook "$WT" || {
        echo "factory-do-work-workspace: existing worktree $WT has no working auto-push hook and it could not be (re)installed" >&2
        exit 1
      }
      echo "$WT"
      exit 0
    fi

    # af-jz4zb (P08): the whole create-or-reuse sequence runs under an
    # exclusive per-repository lock -- two concurrent `enter` calls for
    # different bead ids on the same repo must not race on git's shared
    # internal state.
    with_repo_lock "$HERE" bash -c '
      set -uo pipefail
      HERE="$1"; BEAD_ID="$2"; BRANCH="$3"; WT="$4"; CURRENT_BRANCH="$5"

      git -C "$HERE" fetch --prune origin >/dev/null 2>&1 || true

      # af-jz4zb (P08): branch off a freshly fetched origin/<base> when the
      # remote branch exists, not the possibly-stale local branch -- the
      # live root/rig checkout may be behind origin at dispatch time.
      START_REF="$CURRENT_BRANCH"
      if git -C "$HERE" show-ref --verify --quiet "refs/remotes/origin/$CURRENT_BRANCH"; then
        START_REF="origin/$CURRENT_BRANCH"
      fi

      mkdir -p "$(dirname "$WT")"
      if git -C "$HERE" show-ref --verify --quiet "refs/heads/$BRANCH"; then
        git -C "$HERE" worktree add "$WT" "$BRANCH" >/dev/null 2>&1 || {
          echo "factory-do-work-workspace: could not add a worktree for existing branch $BRANCH" >&2
          exit 1
        }
      else
        git -C "$HERE" worktree add "$WT" -b "$BRANCH" "$START_REF" >/dev/null 2>&1 || {
          echo "factory-do-work-workspace: could not create worktree/branch $BRANCH off $START_REF" >&2
          exit 1
        }
        # O04: push the branch immediately, before any work commit lands, so
        # it exists remotely from the start and the post-commit hook below
        # always has a remote branch to push onto.
        git -C "$WT" push -u origin "$BRANCH" >/dev/null 2>&1 || true
      fi
    ' -- "$HERE" "$BEAD_ID" "$BRANCH" "$WT" "$CURRENT_BRANCH" || exit 1

    install_post_commit_push_hook "$WT" || {
      echo "factory-do-work-workspace: could not install the auto-push hook for $WT; removing the worktree rather than handing back one with no safety net" >&2
      git -C "$HERE" worktree remove --force "$WT" 2>/dev/null || true
      exit 1
    }
    echo "$WT"
    ;;

  finish)
    BEAD_ID="${1:-}"; WT="${2:-}"; BRANCH="${3:-}"; BASE_BRANCH="${4:-}"
    [ -n "$BEAD_ID" ] && [ -n "$WT" ] && [ -n "$BRANCH" ] && [ -n "$BASE_BRANCH" ] || usage

    if [ "$WT" = "." ]; then
      exit 0   # enter was a no-op (not the live root) -- nothing to finish
    fi
    [ -d "$WT" ] || {
      echo "factory-do-work-workspace: worktree $WT does not exist, nothing to finish" >&2
      exit 0
    }

    WT_GIT_DIR=$(git -C "$WT" rev-parse --absolute-git-dir 2>/dev/null || true)
    PR_BODY_SRC="${WT_GIT_DIR:+$WT_GIT_DIR/PR_BODY.md}"
    PR_BODY_FILE=$(mktemp "${TMPDIR:-/tmp}/factory-do-work-workspace.pr-body.XXXXXX")
    printf 'Closes %s.\n' "$BEAD_ID" > "$PR_BODY_FILE"
    HAVE_PR_BODY=0
    if [ -n "$PR_BODY_SRC" ] && [ -s "$PR_BODY_SRC" ]; then
      { printf '\n'; cat "$PR_BODY_SRC"; } >> "$PR_BODY_FILE"
      HAVE_PR_BODY=1
    fi
    if bead_requires_pr_sections "$BEAD_ID"; then
      CHECK_FILE="$PR_BODY_FILE"
      EXISTING_BODY=""
      if [ "$HAVE_PR_BODY" = "0" ] && command -v gh >/dev/null 2>&1; then
        # a re-dispatch resuming an open PR that already carries the sections
        EXISTING_BODY=$(mktemp "${TMPDIR:-/tmp}/factory-do-work-workspace.pr-existing.XXXXXX")
        if ! (cd "$WT" && gh pr view "$BRANCH" --json body -q .body) >"$EXISTING_BODY" 2>/dev/null; then
          : > "$EXISTING_BODY"   # no open PR for this branch yet: judge the file alone
        fi
        [ -s "$EXISTING_BODY" ] && CHECK_FILE="$EXISTING_BODY"
      fi
      MISSING=$(missing_pr_sections "$CHECK_FILE")
      [ -n "$EXISTING_BODY" ] && rm -f "$EXISTING_BODY"
      if [ -n "$MISSING" ]; then
        rm -f "$PR_BODY_FILE"
        cat >&2 <<MSG
factory-do-work-workspace: finish of $BEAD_ID refused -- this is NOT a push failure, do not escalate it.
The ticket demands that the PR description carry the sections « Non fait », « Écarts », « Constats hors ticket » (write "aucun" under one that is empty).
Missing: $MISSING
Write them, as Markdown headings each followed by its content, in this file (it is not committed):
  $PR_BODY_SRC
then run the same finish command again. Nothing was pushed, opened or removed by this call.
MSG
        exit 3
      fi
    fi

    if [ -n "$(git -C "$WT" status --porcelain)" ]; then
      git -C "$WT" add -A && git -C "$WT" commit -qm "chore: capture remaining work ($BEAD_ID)"
    fi

    # af-cjaj8o (2026-10-08, af-cbp84n): the post-commit hook pushes every
    # commit, so on a re-dispatch the ticket's open PR can merge before
    # `finish` runs. `gh pr create` then succeeds a second time on the branch
    # left behind (its commits are not in the base after a squash merge) and
    # opens an empty duplicate (#445 after #444). Nothing is left to deliver
    # when this exact head already merged, or when the tree is the base's:
    # push nothing, open nothing, remove the worktree, exit 4.
    DELIVERED=""
    HEAD_SHA=$(git -C "$WT" rev-parse HEAD 2>/dev/null || true)
    if [ -n "$HEAD_SHA" ] && command -v gh >/dev/null 2>&1; then
      MERGED_URL=$(cd "$WT" && gh pr list --head "$BRANCH" --base "$BASE_BRANCH" --state merged \
        --json url,headRefOid -q ".[] | select(.headRefOid == \"$HEAD_SHA\") | .url" 2>/dev/null | head -n 1) || true
      [ -n "$MERGED_URL" ] && DELIVERED="its head $HEAD_SHA already merged as $MERGED_URL"
    fi
    if [ -z "$DELIVERED" ]; then
      git -C "$WT" fetch origin "$BASE_BRANCH" >/dev/null 2>&1 || true
      git -C "$WT" diff --quiet "origin/$BASE_BRANCH" HEAD 2>/dev/null \
        && DELIVERED="it has no difference with origin/$BASE_BRANCH"
    fi

    if [ -z "$DELIVERED" ]; then
      (
        cd "$WT" || exit 1
        ok=0
        for attempt in 1 2 3; do
          if git push -u origin "$BRANCH" >/dev/null 2>&1; then
            ok=1
            break
          fi
          [ "$attempt" -eq 3 ] && break
          git fetch origin "$BASE_BRANCH" >/dev/null 2>&1
          git rebase "origin/$BASE_BRANCH" >/dev/null 2>&1
        done
        [ "$ok" = "1" ]
      ) || {
        echo "factory-do-work-workspace: could not push $BRANCH after 3 attempts" >&2
        exit 1
      }
    fi

    PR_URL=""
    if [ -z "$DELIVERED" ] && command -v gh >/dev/null 2>&1; then
      GH_ERR_FILE=$(mktemp "${TMPDIR:-/tmp}/factory-do-work-workspace.gh-err.XXXXXX")
      # af-kiy7lm: capture stderr instead of `2>/dev/null || true`, so a
      # failed `gh pr create`/`gh pr view` (auth expired, rate-limited,
      # network) is logged instead of silently leaving PR_URL empty.
      CREATE_ERR=$(cd "$WT" && gh pr create --base "$BASE_BRANCH" --head "$BRANCH" \
        --title "do-work: $BEAD_ID" --body-file "$PR_BODY_FILE" 2>&1 1>"$GH_ERR_FILE.out") || true
      PR_URL=$(cat "$GH_ERR_FILE.out" 2>/dev/null || true)
      if [ -z "$PR_URL" ]; then
        # O04: a re-dispatch resuming an existing branch that already has an
        # open PR must resume that PR, not silently fail to record one --
        # `gh pr create` above fails when a PR already exists for this head.
        VIEW_ERR=$(cd "$WT" && gh pr view "$BRANCH" --json url -q .url 2>&1 1>"$GH_ERR_FILE.out") || true
        PR_URL=$(cat "$GH_ERR_FILE.out" 2>/dev/null || true)
        if [ -z "$PR_URL" ]; then
          echo "factory-do-work-workspace: could not create or resume a PR for $BRANCH: create: ${CREATE_ERR:-<no output>}; view: ${VIEW_ERR:-<no output>}" >&2
        elif [ "$HAVE_PR_BODY" = "1" ]; then
          # resumed PR and the author wrote a new body: replace the old one.
          # af-rki3nh: through the REST pulls endpoint, never `gh pr edit` --
          # the host's gh asks GitHub for the retired Projects (classic)
          # field on every `pr edit` and fails before the body is touched
          # (PR #394, #416, #442 kept the text of their first attempt).
          EDIT_ERR=$(cd "$WT" && gh api -X PATCH "repos/{owner}/{repo}/pulls/${PR_URL##*/}" \
            -F "body=@$PR_BODY_FILE" 2>&1 >/dev/null) \
            || echo "factory-do-work-workspace: could not update the body of the open PR for $BRANCH from $PR_BODY_SRC: ${EDIT_ERR:-<no output>}" >&2
        fi
      fi
      rm -f "$GH_ERR_FILE.out" "$GH_ERR_FILE"
    fi
    rm -f "$PR_BODY_FILE"

    # af-09hxz: the worktree's origin repo is no longer always $ROOT (a
    # product rig's own checkout can be the origin too) -- resolve it from
    # the worktree's own git metadata instead of assuming FACTORY_ROOT.
    GIT_COMMON_DIR=$(cd "$WT" && git rev-parse --git-common-dir 2>/dev/null)
    case "$GIT_COMMON_DIR" in
      /*) ;;
      *) GIT_COMMON_DIR="$WT/$GIT_COMMON_DIR" ;;
    esac
    ORIGIN_REPO=""
    [ -n "$GIT_COMMON_DIR" ] && ORIGIN_REPO=$(cd -- "$(dirname -- "$GIT_COMMON_DIR")" 2>/dev/null && pwd -P)
    # O05: never fall back to rm -rf. By this point $BRANCH is already
    # pushed (the block above exits before here otherwise) or has nothing
    # left to deliver (af-cjaj8o), so a failed
    # `worktree remove` loses nothing -- it just leaves a directory for
    # factory-guard's runtime-worktree audit (bin/factory-guard section 6b)
    # to report and a human to clean up by hand.
    if [ -n "$ORIGIN_REPO" ] && [ -d "$ORIGIN_REPO" ]; then
      git -C "$ORIGIN_REPO" worktree remove "$WT" --force 2>/dev/null || \
        echo "factory-do-work-workspace: could not remove worktree $WT after pushing $BRANCH; leaving it in place" >&2
    else
      echo "factory-do-work-workspace: could not resolve the origin repo for worktree $WT; leaving it in place" >&2
    fi

    if [ -n "$DELIVERED" ]; then
      echo "factory-do-work-workspace: nothing to deliver for $BRANCH -- $DELIVERED. No PR opened; leave the ticket's delivery record as it is." >&2
      exit 4
    fi
    [ -n "$PR_URL" ] && echo "$PR_URL"
    exit 0
    ;;

  restart)
    BEAD_ID="${1:-}"; WT="${2:-}"; BRANCH="${3:-}"; REASON="${4:-}"
    [ -n "$BEAD_ID" ] && [ -n "$WT" ] && [ -n "$BRANCH" ] || {
      echo "usage: factory-do-work-workspace restart <bead-id> <worktree-path> <branch> <reason>" >&2
      exit 2
    }
    [ -n "$REASON" ] || {
      echo "factory-do-work-workspace: restart of $BEAD_ID refused -- a written reason is required (O04: starting over without a recorded reason is refused)" >&2
      exit 2
    }

    if [ "$WT" != "." ] && [ -d "$WT" ]; then
      GIT_COMMON_DIR=$(cd "$WT" && git rev-parse --git-common-dir 2>/dev/null)
      case "$GIT_COMMON_DIR" in
        /*) ;;
        *) GIT_COMMON_DIR="$WT/$GIT_COMMON_DIR" ;;
      esac
      ORIGIN_REPO=""
      [ -n "$GIT_COMMON_DIR" ] && ORIGIN_REPO=$(cd -- "$(dirname -- "$GIT_COMMON_DIR")" 2>/dev/null && pwd -P)
      if [ -n "$ORIGIN_REPO" ] && [ -d "$ORIGIN_REPO" ]; then
        git -C "$ORIGIN_REPO" worktree remove "$WT" --force 2>/dev/null || \
          echo "factory-do-work-workspace: could not remove worktree $WT while restarting $BEAD_ID; leaving it in place" >&2
        git -C "$ORIGIN_REPO" branch -D "$BRANCH" >/dev/null 2>&1 || true
        git -C "$ORIGIN_REPO" push origin --delete "$BRANCH" >/dev/null 2>&1 || true
      else
        echo "factory-do-work-workspace: could not resolve the origin repo for worktree $WT; leaving it in place" >&2
      fi
    fi

    echo "restart: $REASON"
    exit 0
    ;;

  *)
    usage
    ;;
esac
