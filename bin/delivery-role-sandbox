#!/usr/bin/env bash
# delivery-role-sandbox — run a provider CLI with the filesystem read-only
# (T03, af-pbxbgj, Spec af-wf4w5r §1: the reviewer and the Evaluator are
# read-only).
#
# Gas City 1.4.1 has no read-only switch for an agent, and an agent-level
# `start_command` replaces the whole provider (no args, no env, no prompt).
# What does hold is a provider whose `command` is this wrapper and whose env
# names the real binary in DELIVERY_ROLE_SANDBOX_EXEC: gc then launches the
# session exactly as it would the plain provider, inside a Bubblewrap mount
# namespace where every path is read-only except what a session cannot run
# without -- its own work directory, the provider's state, the city runtime
# directory and the tracker -- and where no push credential exists (the
# GitHub CLI config that backs the git credential helper, and ~/.ssh, are
# replaced by empty directories; token variables are dropped). Inside those
# writable directories, what another, unconfined session executes or reads
# as instructions (provider settings, hooks, MCP servers, memory, gc
# settings, the other sessions' work directories) stays read-only.
#
# Proven on real sessions by bin/role-adoption-trial, which is what
# bin/dispatch-door requires before a read-only role runs on a provider.
set -Eeuo pipefail

[ -n "${DELIVERY_ROLE_SANDBOX_EXEC:-}" ] || {
  printf 'delivery-role-sandbox: DELIVERY_ROLE_SANDBOX_EXEC is not set -- refusing to start a read-only role without its sandbox\n' >&2
  exit 2
}
command -v bwrap >/dev/null 2>&1 || {
  printf 'delivery-role-sandbox: bwrap is not installed -- refusing to start a read-only role without its sandbox\n' >&2
  exit 2
}

args=(--ro-bind / / --dev-bind /dev /dev --proc /proc --tmpfs /tmp)
rw() { [ -e "$1" ] && args+=(--bind "$1" "$1"); return 0; }
ro() { [ -e "$1" ] && args+=(--ro-bind "$1" "$1"); return 0; }
# A file the session rewrites but no other session may read back: the
# session gets a private copy (bwrap --bind-data), the real file is untouched.
private() {
  local fd
  [ -f "$1" ] || return 0
  exec {fd}<"$1"
  args+=(--perms 0600 --bind-data "$fd" "$1")
}
# A path that must exist to be mounted read-only: created empty when missing,
# with a content its reader takes as « nothing configured ».
placeholder() {
  [ -e "$1" ] && return 0
  case "$2" in
    dir) mkdir -p "$1" ;;
    *) printf '%s' "$2" > "$1" ;;
  esac
}

claude_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
codex_dir="${CODEX_HOME:-$HOME/.codex}"
rw "$PWD"
rw "$claude_dir"
rw "$codex_dir"
rw "$HOME/.local/state"
rw "$HOME/.cache"
# The controller writes exact launch/commit/socket attestations here. The
# Evaluator can read them but cannot forge or update one inside its sandbox.
# Keep this child mount after its writable parents: a later parent bind hides it.
attest_dir="${EVALUATION_CAPACITY_STATE_DIR:-$HOME/.local/state/agent-factory-product-capacity}/attestations"
mkdir -p "$attest_dir"
args+=(--ro-bind "$attest_dir" "$attest_dir")
if [ -n "${GC_CITY:-}" ]; then
  rw "$GC_CITY/.gc"
  rw "$GC_CITY/.beads"
fi
[ -n "${XDG_RUNTIME_DIR:-}" ] && rw "$XDG_RUNTIME_DIR"

# What an unconfined session (author, Mayor, PO, worker) later executes or
# takes as its instructions stays read-only, even inside the directories
# above (af-q55qqx, F7 of the 16/11/2026 analysis: a reviewer could drop a
# hook in ~/.claude that an unconfined session ran). Class C of
# docs/DEFECT_CLASSES.md; tests/delivery-role-sandbox-config-test.py holds it.
# Child mounts: they come after their writable parents, or a later parent
# bind hides them.
for entry in hooks agents commands skills plugins output-styles rules; do
  placeholder "$claude_dir/$entry" dir
done
placeholder "$claude_dir/CLAUDE.md" ''
placeholder "$claude_dir/settings.json" '{}'
placeholder "$claude_dir/settings.local.json" '{}'
for entry in settings.json settings.local.json CLAUDE.md hooks agents commands skills plugins output-styles rules; do
  ro "$claude_dir/$entry"
done
# Its MCP servers (a command each) and per-project state.
private "$claude_dir/.claude.json"
private "$HOME/.claude.json"
# Auto memory goes to projects/<repository root>/memory, the one an
# unconfined session of the same repository reads (the Mayor's, for the
# Factory): the projects stay read-only but the session's own transcript
# directory (projects/<work directory, every other character as '-'>).
if [ -d "$claude_dir/projects" ]; then
  own_project="$claude_dir/projects/$(printf '%s' "$PWD" | tr -c 'A-Za-z0-9' '-')"
  mkdir -p "$own_project"
  ro "$claude_dir/projects"
  rw "$own_project"
fi
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

for entry in rules skills plugins prompts; do
  placeholder "$codex_dir/$entry" dir
done
placeholder "$codex_dir/hooks.json" '{"hooks":{}}'
# Codex reads AGENTS.override.md instead of AGENTS.md: an empty override
# would silence a real AGENTS.md, so with one and not the other, refuse.
if [ -e "$codex_dir/AGENTS.md" ] && [ ! -e "$codex_dir/AGENTS.override.md" ]; then
  printf 'delivery-role-sandbox: %s exists without AGENTS.override.md -- cannot keep the override read-only without silencing it; refusing to start a read-only role\n' "$codex_dir/AGENTS.md" >&2
  exit 2
fi
placeholder "$codex_dir/AGENTS.md" ''
placeholder "$codex_dir/AGENTS.override.md" ''
for entry in config.toml hooks.json AGENTS.md AGENTS.override.md rules skills plugins prompts; do
  ro "$codex_dir/$entry"
done

if [ -n "${GC_CITY:-}" ]; then
  # The hooks of every gc-managed session, the bd wrapper, the city's rigs.
  for entry in settings.json scripts site.toml system services; do
    ro "$GC_CITY/.gc/$entry"
  done
  # The other sessions' work directories and worktrees (their own
  # .claude/settings.json, .codex/hooks.json and code); the session's own
  # work directory is bound again below.
  ro "$GC_CITY/.gc/agents"
  ro "$GC_CITY/.gc/worktrees"
  ro "$GC_CITY/.beads/formulas"
  ro "$GC_CITY/.beads/config.yaml"
  case "$PWD/" in
    "$GC_CITY/.gc/agents/"*|"$GC_CITY/.gc/worktrees/"*) rw "$PWD" ;;
  esac
fi
# Every gc command takes this lock before it reads the city's imported packs
# (`city import "bd": opening repo cache lock file`): without it a read-only
# role cannot claim its routed work, read a bead or record a verdict (seen on
# a real reviewer session, T08, af-n575g4). The lock file only: the cached
# packs beside it stay read-only.
rw "${GC_HOME:-$HOME/.gc}/cache/repos/.packman-cache.lock"
[ -d "$HOME/.config/gh" ] && args+=(--tmpfs "$HOME/.config/gh")
[ -d "$HOME/.ssh" ] && args+=(--tmpfs "$HOME/.ssh")
# Codex lists the user skills of ~/.agents/skills on top of the role's own
# copies (af-npz9v1.12: tdd, codebase-design, ponytail-review seen on a
# reviewer): a role sees its distribution only.
[ -d "$HOME/.agents/skills" ] && args+=(--tmpfs "$HOME/.agents/skills")
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN
export DELIVERY_ROLE_READ_ONLY=1 DELIVERY_ROLE_SANDBOXED=1
exec bwrap "${args[@]}" -- "$DELIVERY_ROLE_SANDBOX_EXEC" "$@"
