#!/usr/bin/env python3
"""Route one Planning Run request through to-spec, Wayfinding, approve and
publish as a single live sequence (B12.1).

This is the one caller wiring the existing standalone B03/B04/B05/B06 tools
(`planning-run-to-spec-oracle`, `wayfinding-run`, `spec-approve`,
`ticket-graph-publish`) into one Planning Run lifecycle. It writes nothing
directly: every mutation happens inside one of those tools' own doors, each
of which is already all-or-nothing, so a failure at any step leaves no
partial identity behind -- re-running the same request from scratch is safe.

`legacy_path` is translated before any Planning Run identity is created: a
non-`none` value is rejected fail-closed with a plain-language reason naming
the quarantined artifact (the ADR-0027 kernel obligation), and no session,
Spec, map or convoy is touched.

A `session` request drives `planning-run-to-spec-oracle run` directly. A
request that also declares `wayfinding` first drives `wayfinding-run
promote`, then loops `claim`/`resolve` over its declared decisions; once the
map reports the route clear, `to-spec` runs the same way a simple request
does -- no second fog audit. A synthesized `DRAFT_SPEC` is approved only
when the caller supplies approval evidence; an `APPROVED_SPEC` is published
only when the caller supplies an already-approved Ticket Graph Draft --
this router does not re-slice a Spec into tickets, it only sequences the
existing to-tickets and publication doors.

This is the only Planning Run entry point (af-mav0b): there is no flag, env
var, or code branch that falls back to a legacy planning path. Right after
`legacy_path` translation, a reservation recorded in
`.gc/runtime/planning-run-reservation.json` (B12 AC#5; untracked runtime
state per F18 -- seeded once from the tracked, read-only
`config/planning-run-reservation.json`) is checked, also before any Planning
Run identity is created: while a reservation is active, only a request that
declares a matching `planning_run_target` proceeds -- every other request is
rejected the same identity-free way as a `legacy_path` selector. Publishing
through as the reserved target clears the reservation for every request
after it.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


PROGRAM = "planning-run-router"
REQUEST_CONTRACT = "agent-factory-planning-run-router-request/v1"
RESULT_CONTRACT = "agent-factory-planning-run-router-result/v1"
RESERVATION_CONTRACT = "agent-factory-planning-run-reservation/v1"

MAP_STATUS_CLOSED = "closed"
SPEC_STATE_APPROVED = "APPROVED_SPEC"

BIN_DIR = Path(__file__).resolve().parent
TO_SPEC_ORACLE = BIN_DIR / "planning-run-to-spec-oracle"
WAYFINDING_RUN = BIN_DIR / "wayfinding-run"
SPEC_APPROVE = BIN_DIR / "spec-approve"
TICKET_GRAPH_PUBLISH = BIN_DIR / "ticket-graph-publish"

# ADR-0027's exact legacy_path vocabulary and the quarantined artifact each
# selector names -- rejecting one of these before any Planning Run identity
# exists is the outstanding kernel obligation the ADR itself flags.
LEGACY_ARTIFACTS: dict[str, str] = {
    "planning-base": (
        "the planning-base methodology (.beads/formulas/planning-base.toml)"
    ),
    "release-contract": (
        "the agent-factory-product-release/v1 contract "
        "(pre-refactor, quarantined)"
    ),
    "cockpit-v1-export": (
        "Cockpit V1 (pre-refactor, quarantined)"
    ),
}


class RouterError(RuntimeError):
    """An actionable diagnostic about a Planning Run router request."""


def as_dict(value: Any, name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise RouterError(f"{name} must be an object")
    return value


def as_list(value: Any, name: str) -> list[Any]:
    if not isinstance(value, list):
        raise RouterError(f"{name} must be an array")
    return value


def required_string(value: Any, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise RouterError(f"{name} must be a non-empty string")
    return value


def resolve_path(value: str, repo_root: Path) -> Path:
    path = Path(value)
    return path if path.is_absolute() else repo_root / path


def reservation_seed_path(repo_root: Path) -> Path:
    """The git-tracked path a reservation used to live and mutate at before
    F18. Read-only from here on: it seeds the untracked runtime copy the
    first time a repo checkout sees this reservation, so the C01 reservation
    already committed there is not lost by the move."""
    return repo_root / "config" / "planning-run-reservation.json"


def reservation_path(repo_root: Path) -> Path:
    """The untracked runtime location a reservation reads and writes from
    (F18): `.gc/` is Host-local Gas City/runtime state (gitignored), so a
    router run that clears or promotes a reservation no longer dirties the
    repo root's git status."""
    return repo_root / ".gc" / "runtime" / "planning-run-reservation.json"


def load_reservation(repo_root: Path) -> dict[str, Any] | None:
    """Read the active Planning Run reservation, if any (B12 AC#5).

    Returns None when there is no reservation file, it is malformed as
    "no reservation" (missing/blank `reserved_for`), or it has already been
    cleared -- in every one of those cases the router proceeds unreserved.
    """
    path = reservation_path(repo_root)
    if not path.exists():
        seed = reservation_seed_path(repo_root)
        if not seed.exists():
            return None
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(seed.read_text(encoding="utf-8"), encoding="utf-8")
    try:
        reservation = as_dict(json.loads(path.read_text(encoding="utf-8")), "reservation")
    except (OSError, json.JSONDecodeError) as exc:
        raise RouterError(f"cannot read reservation {path}: {exc}") from exc
    if reservation.get("cleared_at") is not None:
        return None
    target = reservation.get("reserved_for")
    if not isinstance(target, str) or not target.strip():
        return None
    return reservation


def clear_reservation(repo_root: Path, reservation: dict[str, Any]) -> None:
    """Close the active reservation once its target publishes.

    When the reservation carries a `next` reservation with a non-blank
    `reserved_for`, that one becomes active instead, so an ordered sequence
    of Planning Runs is enforced one at a time. Otherwise `cleared_at` is
    stamped and the router runs unreserved from then on.
    """
    path = reservation_path(repo_root)
    now = datetime.now(timezone.utc).isoformat()
    following = reservation.get("next")
    if isinstance(following, dict) and str(following.get("reserved_for") or "").strip():
        promoted = dict(following)
        promoted.setdefault("contract", reservation.get("contract", RESERVATION_CONTRACT))
        promoted["cleared_at"] = None
        promoted["promoted_at"] = now
        promoted["promoted_after"] = reservation.get("reserved_for")
        path.write_text(json.dumps(promoted, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return
    cleared = dict(reservation)
    cleared["cleared_at"] = now
    path.write_text(json.dumps(cleared, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def load_request(path: Path) -> dict[str, Any]:
    try:
        request = as_dict(json.loads(path.read_text(encoding="utf-8")), "request")
    except (OSError, json.JSONDecodeError) as exc:
        raise RouterError(f"cannot read request {path}: {exc}") from exc
    if request.get("contract") != REQUEST_CONTRACT:
        raise RouterError(
            f"request.contract must be {REQUEST_CONTRACT!r}, got {request.get('contract')!r}"
        )
    return request


def invoke(*argv: str) -> tuple[int, dict[str, Any]]:
    """Run one existing tool's documented CLI and parse its one JSON object
    from stdout. The router never inspects or duplicates the called tool's
    internal state machine -- only its public result."""
    try:
        result = subprocess.run(argv, text=True, capture_output=True, check=False)
    except OSError as exc:
        raise RouterError(f"failed to run {argv[0]}: {exc}") from exc
    try:
        payload = as_dict(json.loads(result.stdout), f"{Path(argv[0]).name} output")
    except json.JSONDecodeError as exc:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RouterError(f"{Path(argv[0]).name} did not return one JSON object: {detail}") from exc
    return result.returncode, payload


# --- step wrappers over the four existing tools -----------------------------


def to_spec_run(session_path: Path, city_registry_path: Path) -> dict[str, Any]:
    """Synthesize the Spec a session would produce, without writing it.

    The router decides whether to actually write the result once it has
    seen what (if anything) already sits at the target spec path -- an
    already-`APPROVED_SPEC` there must never be overwritten by a rerun, so
    `--out` is never passed here; only `run_router` writes the Spec file.
    """
    returncode, payload = invoke(
        str(TO_SPEC_ORACLE), "run", str(session_path),
        "--city-registry", str(city_registry_path),
    )
    if returncode != 0:
        raise RouterError(f"to-spec rejected the session: {payload.get('error')}")
    return payload


def wayfinding_promote(request_path: Path, map_path: Path) -> dict[str, Any]:
    returncode, payload = invoke(str(WAYFINDING_RUN), "promote", str(request_path), "--out", str(map_path))
    if returncode != 0 or not payload.get("ok"):
        raise RouterError(f"Wayfinding promote failed: {payload.get('error')}")
    return payload


def wayfinding_claim(map_path: Path, decision: str, claimant: str, session: str) -> dict[str, Any]:
    returncode, payload = invoke(
        str(WAYFINDING_RUN), "claim", str(map_path),
        "--decision", decision, "--claimant", claimant, "--session", session,
    )
    if returncode != 0 or not payload.get("ok"):
        raise RouterError(f"Wayfinding claim of {decision!r} failed: {payload.get('error')}")
    return payload


def wayfinding_resolve(
    map_path: Path, decision: str, session: str, resolution: str, evidence: str
) -> dict[str, Any]:
    returncode, payload = invoke(
        str(WAYFINDING_RUN), "resolve", str(map_path),
        "--decision", decision, "--session", session,
        "--resolution", resolution, "--evidence", evidence,
    )
    if returncode != 0 or not payload.get("ok"):
        raise RouterError(f"Wayfinding resolve of {decision!r} failed: {payload.get('error')}")
    return payload


def load_map_status(map_path: Path) -> str | None:
    try:
        state = as_dict(json.loads(map_path.read_text(encoding="utf-8")), "map")
    except (OSError, json.JSONDecodeError) as exc:
        raise RouterError(f"cannot read map {map_path}: {exc}") from exc
    status = state.get("status")
    return status if isinstance(status, str) else None


def wayfinding_status(map_path: Path) -> dict[str, Any]:
    returncode, payload = invoke(str(WAYFINDING_RUN), "status", str(map_path))
    if returncode != 0 or not payload.get("ok"):
        raise RouterError(f"Wayfinding status failed: {payload.get('error')}")
    return payload


def spec_approve_approve(
    spec_path: Path, approved_by: str, evidence: str, map_path: Path | None
) -> dict[str, Any]:
    argv = [str(SPEC_APPROVE), "approve", str(spec_path), "--approved-by", approved_by, "--evidence", evidence]
    if map_path is not None:
        argv += ["--map", str(map_path)]
    returncode, payload = invoke(*argv)
    if returncode != 0 or not payload.get("ok"):
        raise RouterError(f"Spec approval failed: {payload.get('error')}")
    return payload


def ticket_graph_publish(draft_path: Path) -> dict[str, Any]:
    try:
        result = subprocess.run(
            (str(TICKET_GRAPH_PUBLISH), "publish", str(draft_path)),
            text=True, capture_output=True, check=False,
            env={**os.environ, "TICKET_GRAPH_PUBLISH_NOTIFY_MAYOR": "1"},
        )
    except OSError as exc:
        raise RouterError(f"failed to run ticket-graph-publish: {exc}") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RouterError(f"Ticket graph publication failed: {detail}")
    try:
        payload = as_dict(json.loads(result.stdout), "ticket-graph-publish output")
    except json.JSONDecodeError as exc:
        raise RouterError("ticket-graph-publish did not return one JSON object") from exc
    if not payload.get("ok"):
        raise RouterError("Ticket graph publication failed")
    return payload


# --- router sequencing -------------------------------------------------------


def run_wayfinding(wayfinding: dict[str, Any], repo_root: Path) -> Path:
    """Promote (if needed) and drive claim/resolve for every decision the
    caller supplied. Returns the map path once every supplied decision has
    been resolved; the caller checks route-clear separately, since a caller
    may submit fewer decisions than the map declares across more than one
    router call -- the map itself is the durable, resumable state, exactly
    as B04 designed it."""
    request_path = resolve_path(required_string(wayfinding.get("request"), "wayfinding.request"), repo_root)
    map_path = resolve_path(required_string(wayfinding.get("map"), "wayfinding.map"), repo_root)
    if not map_path.exists():
        wayfinding_promote(request_path, map_path)
    elif load_map_status(map_path) == MAP_STATUS_CLOSED:
        # A prior call already reached publication: `spec-approve approve`
        # closes the map in the same call it approves the Spec, so a closed
        # map means every decision here is already resolved. Replaying
        # claim/resolve against it would hit "already resolved"/"not active"
        # guards for no reason -- resume past Wayfinding entirely instead.
        return map_path

    decisions = as_list(wayfinding.get("decisions", []), "wayfinding.decisions")
    for index, raw_entry in enumerate(decisions):
        entry = as_dict(raw_entry, f"wayfinding.decisions[{index}]")
        decision = required_string(entry.get("decision"), f"wayfinding.decisions[{index}].decision")
        claimant = required_string(entry.get("claimant"), f"wayfinding.decisions[{index}].claimant")
        session = required_string(entry.get("session"), f"wayfinding.decisions[{index}].session")
        resolution = required_string(entry.get("resolution"), f"wayfinding.decisions[{index}].resolution")
        evidence = required_string(entry.get("evidence"), f"wayfinding.decisions[{index}].evidence")
        wayfinding_claim(map_path, decision, claimant, session)
        wayfinding_resolve(map_path, decision, session, resolution, evidence)
    return map_path


def run_router(request_path: Path, repo_root: Path) -> dict[str, Any]:
    request = load_request(request_path)

    legacy_path = request.get("legacy_path", "none")
    if legacy_path != "none":
        if legacy_path not in LEGACY_ARTIFACTS:
            raise RouterError(f"legacy_path {legacy_path!r} is not a recognized quarantine selector")
        return {
            "contract": RESULT_CONTRACT,
            "ok": True,
            "result": "legacy_path_rejected",
            "legacy_path": legacy_path,
            "reason": (
                f"legacy_path {legacy_path!r} is quarantined per ADR-0027: {LEGACY_ARTIFACTS[legacy_path]} "
                "-- no Planning Run identity, Spec, map or convoy was created"
            ),
        }

    reservation = load_reservation(repo_root)
    if reservation is not None:
        reserved_for = reservation["reserved_for"]
        if request.get("planning_run_target") != reserved_for:
            return {
                "contract": RESULT_CONTRACT,
                "ok": True,
                "result": "reservation_blocked",
                "reserved_for": reserved_for,
                "reason": (
                    f"the next Planning Run is reserved for {reserved_for} -- "
                    f"declare request.planning_run_target={reserved_for!r} once "
                    "that work starts, or wait until it does -- no Planning Run "
                    "identity, Spec, map or convoy was created"
                ),
            }

    session_path = resolve_path(required_string(request.get("session"), "session"), repo_root)
    city_registry_path = resolve_path(
        required_string(request.get("city_registry"), "city_registry"), repo_root
    )
    spec_out_dir = resolve_path(required_string(request.get("spec_out"), "spec_out"), repo_root)

    resumed_from: list[str] = []

    map_path: Path | None = None
    wayfinding = request.get("wayfinding")
    if wayfinding is not None:
        map_path = run_wayfinding(as_dict(wayfinding, "wayfinding"), repo_root)
        if load_map_status(map_path) == MAP_STATUS_CLOSED:
            resumed_from.append("wayfinding")
        else:
            status = wayfinding_status(map_path)
            if not status.get("to_spec_eligible"):
                return {
                    "contract": RESULT_CONTRACT,
                    "ok": True,
                    "result": "wayfinding_pending",
                    "map": str(map_path),
                    "decisions": status.get("decisions"),
                }

    to_spec_result = to_spec_run(session_path, city_registry_path)
    if to_spec_result.get("result") == "returned_to_planning":
        return {
            "contract": RESULT_CONTRACT,
            "ok": True,
            "result": "returned_to_planning",
            "signal": to_spec_result.get("signal"),
            "reason": to_spec_result.get("reason"),
        }
    if to_spec_result.get("result") != "spec_synthesized":
        raise RouterError(f"unrecognized to-spec result: {to_spec_result.get('result')!r}")

    synthesized_spec = as_dict(to_spec_result.get("spec"), "to-spec result.spec")
    spec_id = required_string(synthesized_spec.get("spec_id"), "spec.spec_id")
    spec_path = spec_out_dir / f"{spec_id}.json"

    existing_spec: dict[str, Any] | None = None
    if spec_path.exists():
        try:
            existing_spec = as_dict(json.loads(spec_path.read_text(encoding="utf-8")), "existing spec")
        except (OSError, json.JSONDecodeError) as exc:
            raise RouterError(f"cannot read existing spec {spec_path}: {exc}") from exc

    approved_digest: str | None = None
    if existing_spec is not None and existing_spec.get("state") == SPEC_STATE_APPROVED:
        if existing_spec.get("content_digest") != synthesized_spec.get("content_digest"):
            raise RouterError(
                f"session {session_path} would synthesize Spec {spec_id!r} with digest "
                f"{synthesized_spec.get('content_digest')!r}, but the already-approved Spec at "
                f"{spec_path} carries digest {existing_spec.get('content_digest')!r} -- refusing to "
                "resume a session whose content no longer matches what was already approved"
            )
        resumed_from.append("spec_approval")
        approved_digest = existing_spec.get("approved_digest") or existing_spec.get("content_digest")
    else:
        spec_out_dir.mkdir(parents=True, exist_ok=True)
        spec_path.write_text(json.dumps(synthesized_spec, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    approval = request.get("approval")
    if approved_digest is None:
        if approval is None:
            return {
                "contract": RESULT_CONTRACT,
                "ok": True,
                "result": "awaiting_approval",
                "spec_id": spec_id,
                "spec_path": str(spec_path),
            }
        approval = as_dict(approval, "approval")
        approved_by = required_string(approval.get("approved_by"), "approval.approved_by")
        evidence = required_string(approval.get("evidence"), "approval.evidence")
        approve_result = spec_approve_approve(spec_path, approved_by, evidence, map_path)
        approved_digest = approve_result.get("digest")

    publish = request.get("publish")
    if publish is None:
        result: dict[str, Any] = {
            "contract": RESULT_CONTRACT,
            "ok": True,
            "result": "approved_awaiting_publication",
            "spec_id": spec_id,
            "spec_path": str(spec_path),
            "spec_digest": approved_digest,
        }
        if resumed_from:
            result["resumed_from"] = resumed_from
        return result
    publish = as_dict(publish, "publish")
    draft_path = resolve_path(required_string(publish.get("draft"), "publish.draft"), repo_root)
    publish_result = ticket_graph_publish(draft_path)
    ids = as_dict(publish_result.get("ids"), "publish result.ids")

    if reservation is not None:
        clear_reservation(repo_root, reservation)

    result = {
        "contract": RESULT_CONTRACT,
        "ok": True,
        "result": "published",
        "spec_id": spec_id,
        "spec_digest": approved_digest,
        "graph_digest": publish_result.get("graph_digest"),
        "convoy_id": ids.get("_convoy"),
        "ids": ids,
    }
    if resumed_from:
        result["resumed_from"] = resumed_from
    return result


def repo_root_default() -> Path:
    return Path(__file__).resolve().parents[1]


def cmd_run(args: argparse.Namespace) -> int:
    try:
        result = run_router(Path(args.request), Path(args.repo_root))
    except RouterError as exc:
        print(json.dumps({"contract": RESULT_CONTRACT, "ok": False, "error": str(exc)}, indent=2))
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    parser.add_argument(
        "--repo-root", default=str(repo_root_default()), help="repository root used to resolve request-relative paths"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    run_parser = subparsers.add_parser("run", help="route one Planning Run request end to end")
    run_parser.add_argument("request", help="path to the Planning Run router request JSON record")
    run_parser.set_defaults(func=cmd_run)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
