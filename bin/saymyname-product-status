#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME="saymyname-product-status"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
GC_BIN="${GC_BIN:-gc}"
GH_BIN="${GH_BIN:-gh}"
QUEUE_BIN="${SAYMYNAME_QUEUE_BIN:-$SCRIPT_DIR/saymyname-product-queue}"
HUMAN_STATE_BIN="${FACTORY_HUMAN_STATE_BIN:-$SCRIPT_DIR/factory-human-state}"
RELEASE_BIN="${PRODUCT_RELEASE_BIN:-$SCRIPT_DIR/product-release}"
RELEASE_FILE="${SAYMYNAME_RELEASE_FILE:-$SCRIPT_DIR/../config/releases/saymyname-v1.json}"
PRODUCT_ROOT_BEAD="${SAYMYNAME_PRODUCT_ROOT_BEAD:-af-1vr4}"

log() {
  printf '%s: %s\n' "$PROGRAM_NAME" "$*" >&2
}

die() {
  log "ERROR: $1"
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: saymyname-product-status [--json]

Print the canonical human Factory state, current SayMyName delivery, exact last
delivery evidence, next eligible candidate, resume semantics, and any blocking
Benjamin decision. --json emits the versioned machine contract.
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command is unavailable: $1"
}

gc_json() {
  "$GC_BIN" "$@"
}

gh_json() {
  "$GH_BIN" "$@"
}

# A fine-grained token cannot read check runs (statusCheckRollup); fall back to
# rebuilding them from the Actions runs of the PR head.
pr_view_with_rollup() {
  local number=$1 repo=$2 fields=number,state,mergedAt,mergeCommit,headRefOid,url
  gh_json pr view "$number" --repo "$repo" --json "$fields,statusCheckRollup" 2>/dev/null \
    || gh_json pr view "$number" --repo "$repo" --json "$fields" \
      | GH_BIN="$GH_BIN" "$SCRIPT_DIR/factory-gh-rollup" "$repo"
}

capture_json() {
  local destination=$1
  local source_name=$2
  local output
  shift 2

  if ! output=$("$@"); then
    die "$source_name source command failed. Restore that source, then retry."
  fi
  jq -e . >/dev/null 2>&1 <<<"$output" \
    || die "$source_name returned invalid JSON. Restore that source, then retry."
  printf -v "$destination" '%s' "$output"
}

# Independent `gc`/`gh`/queue-tool invocations each carry several seconds of
# fixed process/DB-connect overhead (af-rt1t2, af-7rd5r). Where two or more
# of those calls don't depend on each other's output, fire them concurrently
# with bg_start and join with capture_json_bg/bg_wait instead of paying that
# fixed cost once per call in sequence. bg_wait polls a sentinel file rather
# than using bash job-control `wait <pid>`, because it must also be callable
# from inside a `$(...)` subshell (derive_active_context_or_degrade,
# derive_delivery's prepare/finish split) -- those subshells are siblings of,
# not parents of, a background job started in the calling function, so a
# plain `wait <pid>` there would fail with "not a child of this shell".
bg_start() {
  local outfile=$1
  shift
  # `set +e` inside the subshell: the script runs under `set -e`, which the
  # subshell inherits, so a failing "$@" would abort the subshell before the
  # printf below ever writes the .rc sentinel -- bg_wait would then poll for
  # a file that is never coming and hang forever (caught by the fixture
  # suite's source-failure/queue-failure scenarios).
  ( set +e; "$@" >"$outfile" 2>&2; printf '%s' "$?" >"$outfile.rc" ) &
}

bg_wait() {
  local outfile=$1
  while [[ ! -e "$outfile.rc" ]]; do sleep 0.02; done
  local rc
  rc=$(<"$outfile.rc")
  return "$rc"
}

capture_json_bg() {
  local destination=$1
  local source_name=$2
  local outfile=$3
  local output

  bg_wait "$outfile" \
    || die "$source_name source command failed. Restore that source, then retry."
  output=$(cat "$outfile")
  jq -e . >/dev/null 2>&1 <<<"$output" \
    || die "$source_name returned invalid JSON. Restore that source, then retry."
  printf -v "$destination" '%s' "$output"
}

single_issue() {
  local json=$1
  local label=$2
  local issue

  issue=$(jq -ce 'if type == "array" and length == 1 and .[0].id then .[0] else error("expected one issue") end' \
    <<<"$json") || die "$label did not resolve to exactly one Bead."
  printf '%s\n' "$issue"
}

required_string() {
  local json=$1
  local expression=$2
  local label=$3
  local value

  value=$(jq -er "$expression | select(type == \"string\" and length > 0)" <<<"$json") \
    || die "$label is missing or invalid."
  [[ $value != *$'\n'* && $value != *$'\r'* ]] || die "$label must be a single line."
  printf '%s\n' "$value"
}

metadata_string() {
  local issue=$1
  local key=$2
  local label=$3
  local value

  value=$(jq -er --arg key "$key" \
    '.metadata[$key] | select(type == "string" and length > 0)' <<<"$issue") \
    || die "$label is missing or invalid."
  [[ $value != *$'\n'* && $value != *$'\r'* ]] || die "$label must be a single line."
  printf '%s\n' "$value"
}

metadata_optional() {
  local issue=$1
  local key=$2
  local value
  value=$(jq -er --arg key "$key" '
    (.metadata[$key] // "") |
    if type == "string" then . else error("not a string") end
  ' <<<"$issue") || die "Optional metadata $key is invalid."
  [[ $value != *$'\n'* && $value != *$'\r'* ]] \
    || die "Optional metadata $key must be a single line."
  printf '%s\n' "$value"
}

show_issue() {
  local destination=$1
  local issue_id=$2
  local label=$3
  local response

  capture_json response "Beads ($label)" gc_json bd show "$issue_id" --json
  printf -v "$destination" '%s' "$(single_issue "$response" "$label")"
}

show_issue_bg() {
  local destination=$1
  local label=$2
  local outfile=$3
  local response

  capture_json_bg response "Beads ($label)" "$outfile"
  printf -v "$destination" '%s' "$(single_issue "$response" "$label")"
}

phase_for_step() {
  case "$1" in
    *.load-context|*.workspace-setup) printf 'Préparation\n' ;;
    *.preflight-tests) printf 'Validation préalable\n' ;;
    *.implement) printf 'Réalisation\n' ;;
    *.self-review) printf 'Vérification\n' ;;
    *.commit-and-push) printf 'Livraison\n' ;;
    *) die "Active workflow phase is unsupported: $1" ;;
  esac
}

convoy_tracks_issue() {
  local convoy=$1
  local issue_id=$2

  jq -e --arg issue_id "$issue_id" '
    any(.dependencies[]?;
      ((.id // .depends_on_id // "") == $issue_id) and
      ((.dependency_type // .type // "") == "tracks"))
  ' >/dev/null <<<"$convoy"
}

derive_active_context() {
  local current_issue=$1
  local current_id=$2
  local workflows_outfile=$3
  local current_status
  local workflows_response workflow convoy_id convoy_response convoy cause resume_mode work_outcome
  local -a matching_workflows=()
  local workflow_id session_name steps_response current_step step_ref live_count active_count
  local workflow_convoy_id workflow_convoy workflow_convoy_response
  local direct_session_id direct_session_name direct_matches direct_agent

  CURRENT_OUTCOME=$(required_string "$current_issue" '.title' "Current outcome title")
  current_status=$(required_string "$current_issue" '.status' "Current outcome status")
  resume_mode=$(metadata_optional "$current_issue" "gc.resume_mode")
  work_outcome=$(metadata_optional "$current_issue" "gc.work_outcome")

  case "$current_status" in
    open)
      CURRENT_STATE="materialized"
      CURRENT_PHASE="Matérialisé, aucun agent produit actif"
      CURRENT_AGENT="none"
      return
      ;;
    blocked)
      cause=$(metadata_optional "$current_issue" "gc.blocked_reason")
      [[ -n $cause ]] || cause=$(metadata_optional "$current_issue" "gc.blocker")
      [[ -n $cause ]] || die "Blocked current outcome $current_id has no explicit cause."
      CURRENT_STATE="blocked"
      CURRENT_CAUSE=$cause
      CURRENT_PHASE=$cause
      CURRENT_AGENT="none"
      return
      ;;
    in_progress) ;;
    closed)
      # C7: a result closed on purpose while waiting on a declared dependency
      # or explicit hold is not the same thing as one closed with its proofs
      # skipped. Honour that first (live case: af-u8id.4.1), or every such
      # result gets nagged to finalize forever even though nothing is owed.
      # automatic_dependency reuses the already-wired waiting_dependency state
      # (it requires gc.resume_condition further down); a bare gc.waiting_on
      # hold has no such contract, so it degrades to materialized instead of
      # either nagging to finalize or crashing on a missing condition.
      if [[ $resume_mode == automatic_dependency ]]; then
        CURRENT_STATE="waiting_dependency"
        CURRENT_PHASE="Fermé, en attente d'une dépendance automatique · rien à finaliser tant que ce n'est pas levé"
        CURRENT_AGENT="none"
        return
      fi
      waiting_on=$(metadata_optional "$current_issue" "gc.waiting_on")
      if [[ -n $waiting_on ]]; then
        CURRENT_STATE="materialized"
        CURRENT_PHASE="Fermé, en attente délibérée ($waiting_on) · rien à finaliser tant que ce n'est pas levé"
        CURRENT_AGENT="none"
        return
      fi
      # A result closed while it is still the coordination's current pointer
      # has not been finalized: its six delivery proofs and the campaign
      # pointers (gc.last_delivered, gc.current) are still owed. On
      # 2026-09-16 af-7700 was delivered and closed with a raw `gc bd close`;
      # this case used to die(), the degrade path then reported it as
      # "materialized, no agent", and the campaign kept asking the Mayor to
      # resume a result he had rightly finished -- while the next eligible
      # candidate never started. Finalization is the Mayor's exact next step.
      CURRENT_STATE="finalizing"
      CURRENT_PHASE="Fermé mais non finalisé · enregistrer les preuves avec bin/deliver-close, puis avancer gc.last_delivered et gc.current"
      CURRENT_AGENT="none"
      return
      ;;
    *) die "Current outcome $current_id has inconsistent status: $current_status" ;;
  esac

  if [[ $work_outcome == shipped || $work_outcome == pass ]]; then
    CURRENT_STATE="finalizing"
    CURRENT_PHASE="Réalisation terminée · revue, fusion ou clôture par le Mayor"
    CURRENT_AGENT="none"
    return
  fi

  # A deliberately direct `gc sling --no-formula` assignment has no workflow
  # root. Prefer its stable Gas City session ID; accept an exact unique session
  # name only when no ID was recorded. Never infer work from an unrelated session.
  # A v2 workflow root (gc.kind=workflow) stamps gc.session_name once from its
  # first step and never updates it as later steps hand off to new sessions, so
  # this branch must not run for one -- it would look up a long-dead session and
  # report materialized/no-agent even while the workflow is genuinely active via
  # its current step's session. Skip straight to the convoy/workflow-matching
  # logic below, which always resolves the live current step.
  if [[ $(metadata_optional "$current_issue" "gc.kind") != workflow ]]; then
    direct_session_id=$(metadata_optional "$current_issue" "gc.session_id")
    direct_session_name=$(metadata_optional "$current_issue" "gc.session_name")
    if [[ -n $direct_session_id || -n $direct_session_name ]]; then
      if [[ -n $direct_session_id ]]; then
        direct_matches=$(jq --arg id "$direct_session_id" \
          '[.agents[]? | select((.id // "") == $id)]' <<<"$CITY_RESPONSE")
        if [[ $(jq 'length' <<<"$direct_matches") -eq 0 && -n $direct_session_name ]]; then
          direct_matches=$(jq --arg name "$direct_session_name" \
            '[.agents[]? | select(((.id // "") == "") and ((.qualified_name // "") == $name or (.name // "") == $name or (.alias // "") == $name))]' \
            <<<"$CITY_RESPONSE")
        fi
      else
        direct_matches=$(jq --arg name "$direct_session_name" \
          '[.agents[]? | select((.qualified_name // "") == $name or (.name // "") == $name or (.alias // "") == $name)]' \
          <<<"$CITY_RESPONSE")
      fi
      [[ $(jq 'length' <<<"$direct_matches") -le 1 ]] \
        || die "Direct assignment session for $current_id is ambiguous in Gas City."
      if [[ $(jq 'length' <<<"$direct_matches") -eq 1 ]] && jq -e \
        '.[0] | ((.running // false) == true or (.state // "") == "active")' \
        >/dev/null <<<"$direct_matches"; then
        direct_agent=$(jq -er '.[0] | .qualified_name // .name // .alias // .id' <<<"$direct_matches") \
          || die "Direct assignment session has no stable display identity."
        CURRENT_STATE="active"
        CURRENT_PHASE="Réalisation"
        CURRENT_AGENT=$direct_agent
      else
        CURRENT_STATE="materialized"
        CURRENT_PHASE="Résultat affecté directement, aucun agent produit actif"
        CURRENT_AGENT="none"
      fi
      return
    fi
  fi

  capture_json_bg workflows_response "Beads workflow inventory" "$workflows_outfile"
  jq -e 'type == "array"' >/dev/null <<<"$workflows_response" \
    || die "Beads workflow inventory is not an array."

  local candidate_workflows
  candidate_workflows=$(jq -c '[.[] | select(
    .status == "in_progress" and
    .metadata["gc.kind"] == "workflow" and
    (.metadata["gc.input_convoy_id"] | type == "string" and length > 0))]' \
    <<<"$workflows_response")

  local -a candidate_convoy_ids=()
  while IFS= read -r convoy_id; do
    candidate_convoy_ids+=("$convoy_id")
  done < <(jq -r '.[].metadata["gc.input_convoy_id"]' <<<"$candidate_workflows")

  # One batched `gc bd show` for every candidate workflow's convoy instead of
  # one `gc bd show` per workflow: profiling on 2026-09-18 (af-rt1t2) found
  # each separate invocation of the external `gc` binary carries several
  # seconds of fixed process/DB-connect overhead that a batched multi-ID call
  # does not repeat, so N concurrent workflows used to cost N x that overhead
  # here instead of one.
  local convoys_response=null
  if [[ ${#candidate_convoy_ids[@]} -gt 0 ]]; then
    capture_json convoys_response "Beads workflow convoys" \
      gc_json bd show "${candidate_convoy_ids[@]}" --json
    jq -e 'type == "array"' >/dev/null <<<"$convoys_response" \
      || die "Beads workflow convoys batch is not an array."
  fi

  while IFS= read -r workflow; do
    convoy_id=$(metadata_string "$workflow" "gc.input_convoy_id" "Workflow input convoy")
    convoy=$(jq -ce --arg id "$convoy_id" \
      '[.[] | select(.id == $id)] | if length >= 1 then .[0] else error("missing") end' \
      <<<"$convoys_response") \
      || die "Workflow convoy $convoy_id missing from batch result."
    if convoy_tracks_issue "$convoy" "$current_id"; then
      matching_workflows+=("$workflow")
    fi
  done < <(jq -c '.[]' <<<"$candidate_workflows")

  # current_id can be a workflow root itself rather than someone else's leaf.
  # Its own convoy tracks its implementation children, never itself, so the
  # tracks-matching loop above never finds it that way -- it always reports
  # materialized/no-agent even while its current step has a genuinely live
  # session. When nothing else claims to track it and it is itself an
  # in-progress workflow, it IS the active result by definition.
  if [[ ${#matching_workflows[@]} -eq 0 ]] \
    && [[ $(metadata_optional "$current_issue" "gc.kind") == workflow ]]; then
    matching_workflows+=("$current_issue")
  fi

  if [[ ${#matching_workflows[@]} -eq 0 ]]; then
    CURRENT_STATE="materialized"
    CURRENT_PHASE="Résultat matérialisé, aucun agent produit actif"
    CURRENT_AGENT="none"
    return
  fi
  [[ ${#matching_workflows[@]} -eq 1 ]] \
    || die "Multiple active workflows track current outcome $current_id."

  workflow=${matching_workflows[0]}
  workflow_id=$(required_string "$workflow" '.id' "Active workflow ID")
  session_name=$(metadata_string "$workflow" "gc.session_name" "Active workflow session")
  workflow_convoy_id=$(metadata_string "$workflow" "gc.input_convoy_id" "Active workflow convoy")

  # active_count must reflect the workflow's own convoy membership, not a
  # gc.session_name comparison: that field is stamped once from the
  # workflow's first step and never updated as later steps hand off to new
  # sessions (see the direct-assignment comment above), so filtering steps
  # by it always finds zero once the workflow has handed off past its first
  # step -- even while the convoy it drives is genuinely still running
  # (af-6k6sn, live case smb-44tt/smb-u0qg 2026-09-18). The convoy may
  # already be in convoys_response from the matching_workflows loop above;
  # fall back to a fresh lookup for the self-tracking case, whose own
  # convoy was never a candidate there.
  workflow_convoy=$(jq -ce --arg id "$workflow_convoy_id" '
    (if type == "array" then . else [] end)
    | [.[] | select(.id == $id)]
    | if length >= 1 then .[0] else null end
  ' <<<"$convoys_response")
  if [[ $workflow_convoy == null ]]; then
    capture_json workflow_convoy_response "Active workflow convoy" \
      gc_json bd show "$workflow_convoy_id" --json
    workflow_convoy=$(single_issue "$workflow_convoy_response" "Active workflow convoy $workflow_convoy_id")
  fi
  active_count=$(jq '
    [.dependencies[]? | select(
      ((.dependency_type // .type // "") == "tracks") and
      ((.status // "") == "open" or (.status // "") == "in_progress"))] | length
  ' <<<"$workflow_convoy")
  if [[ $active_count -eq 0 ]]; then
    # The implementation convoy closing is not the same as the workflow
    # finishing: for a full build-basic v2 graph, starter review, publish,
    # and finalize-workflow all live downstream of the implementation convoy
    # as the workflow root's own "blocks"-type dependency (its completion
    # gate), never as convoy members. Reporting finalizing off active_count
    # alone is systematically premature for any such graph (af-knbxq, live
    # case smb-44tt/smb-3akx 2026-09-18): check the workflow root's own open
    # blocks dependencies before declaring the run finished.
    local open_blockers
    open_blockers=$(jq '
      [.dependencies[]? | select(
        ((.dependency_type // .type // "") == "blocks") and
        ((.status // "") == "open" or (.status // "") == "in_progress"))] | length
    ' <<<"$workflow")
    if [[ $open_blockers -eq 0 ]]; then
      CURRENT_STATE="finalizing"
      CURRENT_PHASE="Réalisation terminée · revue, fusion ou clôture par le Mayor"
      CURRENT_AGENT="none"
      return
    fi
    CURRENT_STATE="active"
    CURRENT_PHASE="Revue, publication ou finalisation du workflow en cours"
    CURRENT_AGENT="none"
    return
  fi

  capture_json steps_response "Beads workflow steps" \
    gc_json bd list --assignee="$session_name" --json
  jq -e 'type == "array"' >/dev/null <<<"$steps_response" \
    || die "Beads workflow step inventory is not an array."
  current_step=$(jq -ce --arg root "$workflow_id" --arg session "$session_name" '
    [.[] | select(
      (.status == "open" or .status == "in_progress") and
      .metadata["gc.root_bead_id"] == $root and
      .metadata["gc.session_name"] == $session)][0] // null
  ' <<<"$steps_response")
  # The convoy already proved the workflow is genuinely active; a stale
  # session_name simply failing to name today's current step is not grounds
  # to die() -- report active with no specific step/agent identified rather
  # than mislabel it finalizing.
  if [[ $current_step == null ]]; then
    CURRENT_STATE="active"
    CURRENT_PHASE="Réalisation"
    CURRENT_AGENT="none"
    return
  fi
  step_ref=$(metadata_string "$current_step" "gc.step_ref" "Active workflow step")

  CURRENT_PHASE=$(phase_for_step "$step_ref")
  if [[ $resume_mode == automatic_dependency ]]; then
    CURRENT_STATE="waiting_dependency"
    CURRENT_AGENT="none"
    return
  fi
  live_count=$(jq --arg session "$session_name" \
    '[.agents[]? | select(.qualified_name == $session and .running == true)] | length' \
    <<<"$CITY_RESPONSE")
  [[ $live_count -le 1 ]] || die "Workflow session $session_name is not unique in Gas City."
  if [[ $live_count -eq 1 ]]; then
    CURRENT_STATE="active"
    CURRENT_AGENT=$session_name
  else
    CURRENT_STATE="materialized"
    CURRENT_AGENT="none"
  fi
}

check_summary() {
  local checks=$1
  local count states

  jq -e 'type == "array"' >/dev/null <<<"$checks" \
    || die "GitHub PR check rollup is missing or invalid."
  count=$(jq 'length' <<<"$checks")
  if [[ $count -eq 0 ]]; then
    printf 'CI not configured\n'
    return
  fi

  states=$(jq -c '[.[] | ((.conclusion // .state // "UNKNOWN") | ascii_upcase)]' <<<"$checks")
  if jq -e 'all(.[]; . == "SUCCESS")' >/dev/null <<<"$states"; then
    printf 'CI green (%s checks)\n' "$count"
  elif jq -e 'any(.[]; . == "FAILURE" or . == "ERROR" or . == "CANCELLED" or . == "TIMED_OUT" or . == "ACTION_REQUIRED")' \
    >/dev/null <<<"$states"; then
    printf 'CI failing (%s)\n' "$(jq -r 'join(", ")' <<<"$states")"
  elif jq -e 'any(.[]; . == "PENDING" or . == "EXPECTED" or . == "QUEUED" or . == "IN_PROGRESS" or . == "UNKNOWN")' \
    >/dev/null <<<"$states"; then
    printf 'CI pending (%s)\n' "$(jq -r 'join(", ")' <<<"$states")"
  else
    printf 'CI not green (%s)\n' "$(jq -r 'join(", ")' <<<"$states")"
  fi
}

# Split from the original single-shot derive_delivery so main() can fire the
# slow GitHub PR fetch (derive_delivery_finish's job) in the background and
# let it run concurrently with the active-context derivation chain, instead
# of paying its ~3s sequentially after everything else. derive_delivery_prepare
# does all the fast, gc-call-free validation and extracts what the PR fetch
# needs; derive_delivery_finish validates the (by-then-ready) PR response and
# computes the evidence line. Each is still individually run inside its own
# `$(...)` subshell by the caller so a die() in either degrades gracefully
# (governance invariant a, af-wisp-c3zmg6) exactly as the single combined
# subshell used to.
derive_delivery_prepare() {
  local delivered_issue=$1
  local delivered_id=$2
  local outcome delivery_status work_outcome github_repo pr_number pr_head merge_commit

  outcome=$(required_string "$delivered_issue" '.title' "Last delivered outcome title")
  [[ $(required_string "$delivered_issue" '.status' "Last delivered outcome status") == closed ]] \
    || die "Last delivered Bead $delivered_id is not closed."
  delivery_status=$(metadata_string "$delivered_issue" "gc.delivery_status" "Delivery status")
  work_outcome=$(metadata_string "$delivered_issue" "gc.work_outcome" "Delivery work outcome")
  [[ $delivery_status == merged && $work_outcome == shipped ]] \
    || die "Last delivered Bead $delivered_id is not recorded as shipped and merged."
  github_repo=$(metadata_string "$delivered_issue" "gc.github_repo" "Delivered GitHub repository")
  [[ $github_repo =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9._-]{1,100}$ ]] \
    || die "Delivered GitHub repository must be a valid owner/repository name."
  pr_number=$(jq -er '.metadata["gc.pr_number"] |
    select((type == "number" and . > 0 and floor == .) or (type == "string" and test("^[1-9][0-9]*$"))) |
    tostring' <<<"$delivered_issue") || die "Last delivered PR number is missing or invalid."
  pr_head=$(metadata_string "$delivered_issue" "gc.pr_head" "Delivered PR head")
  merge_commit=$(metadata_string "$delivered_issue" "gc.merge_commit" "Delivered merge commit")
  [[ $pr_head =~ ^[0-9a-f]{40}$ && $merge_commit =~ ^[0-9a-f]{40}$ ]] \
    || die "Delivered Git commit metadata is invalid."

  jq -cn \
    --arg outcome "$outcome" --arg repo "$github_repo" --arg number "$pr_number" \
    --arg head "$pr_head" --arg merge "$merge_commit" \
    '{outcome:$outcome, github_repo:$repo, pr_number:$number, pr_head:$head, merge_commit:$merge}'
}

derive_delivery_finish() {
  local prepared=$1
  local pr_response=$2
  local pr_number pr_head merge_commit check_rollup ci_evidence short_merge

  pr_number=$(jq -r '.pr_number' <<<"$prepared")
  pr_head=$(jq -r '.pr_head' <<<"$prepared")
  merge_commit=$(jq -r '.merge_commit' <<<"$prepared")

  jq -e --argjson number "$pr_number" --arg head "$pr_head" --arg merge "$merge_commit" '
    .number == $number and
    .state == "MERGED" and
    (.mergedAt | type == "string" and length > 0) and
    .headRefOid == $head and
    .mergeCommit.oid == $merge
  ' >/dev/null <<<"$pr_response" \
    || die "GitHub PR $pr_number does not match the delivered Bead head and merge evidence."

  check_rollup=$(jq -c '.statusCheckRollup' <<<"$pr_response")
  ci_evidence=$(check_summary "$check_rollup")
  short_merge=${merge_commit:0:12}
  jq -cn --arg evidence "PR $pr_number — merged as $short_merge; $ci_evidence" '{evidence:$evidence}'
}

degrade_active_context() {
  local current_id=$1
  log "WARNING: current outcome $current_id has a malformed live-state signal (see the ERROR above); reporting it as materialized with no live agent instead of aborting the projection."
  CURRENT_STATE="materialized"
  CURRENT_PHASE="Projection dégradée : bead malformé pour le résultat courant, voir le journal du contrôleur."
  CURRENT_AGENT="none"
  CURRENT_CAUSE=""
}

# Runs derive_active_context inside a subshell so a die() triggered by a
# malformed current-outcome Bead only aborts that isolated computation. A
# single bad Bead must never take the whole projection down (governance
# invariant a, af-wisp-c3zmg6): on failure we degrade CURRENT_* to a
# still-usable value instead of exiting non-zero.
derive_active_context_or_degrade() {
  local current_issue=$1
  local current_id=$2
  local workflows_outfile=$3
  local context_json

  if context_json=$(
    derive_active_context "$current_issue" "$current_id" "$workflows_outfile"
    jq -cn \
      --arg outcome "$CURRENT_OUTCOME" --arg state "$CURRENT_STATE" \
      --arg phase "$CURRENT_PHASE" --arg agent "$CURRENT_AGENT" \
      --arg cause "${CURRENT_CAUSE:-}" \
      '{outcome:$outcome, state:$state, phase:$phase, agent:$agent, cause:$cause}'
  ); then
    CURRENT_OUTCOME=$(jq -r '.outcome' <<<"$context_json")
    CURRENT_STATE=$(jq -r '.state' <<<"$context_json")
    CURRENT_PHASE=$(jq -r '.phase' <<<"$context_json")
    CURRENT_AGENT=$(jq -r '.agent' <<<"$context_json")
    CURRENT_CAUSE=$(jq -r '.cause' <<<"$context_json")
    return
  fi

  CURRENT_OUTCOME=$(jq -r '.title // empty' <<<"$current_issue")
  [[ -n $CURRENT_OUTCOME ]] || CURRENT_OUTCOME="$current_id (titre indisponible)"
  degrade_active_context "$current_id"
}

main() {
  local parent_response parent current_id current_issue last_id delivered_issue format=text
  local queue_response next_candidate resume_mode resume_condition
  local current_json observed state_json needs_json degraded campaign_metadata release_json

  case "${1:-}" in
    "") ;;
    --json) format=json ;;
    -h|--help|help)
      usage
      return 0
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
  [[ $# -le 1 ]] || return 2

  require_command jq
  require_command "$GC_BIN"
  require_command "$GH_BIN"
  [[ -x $QUEUE_BIN ]] || die "Product queue projection is unavailable: $QUEUE_BIN"
  [[ -x $HUMAN_STATE_BIN ]] || die "Human state projector is unavailable: $HUMAN_STATE_BIN"
  [[ -x $RELEASE_BIN ]] || die "Product release projector is unavailable: $RELEASE_BIN"

  # Not `local`: the EXIT trap below still needs to read this after main()
  # has returned and its local scope is gone (set -u turns that into an
  # "unbound variable" failure at exit instead of a clean run).
  tmp_dir=$(mktemp -d) || die "Could not create a scratch directory for parallel source fetches."
  trap 'rm -rf "$tmp_dir"' EXIT

  # Gas City status, the product queue, and the coordination root don't
  # depend on each other's output -- fire all three at once instead of
  # paying each call's several seconds of fixed overhead in sequence
  # (af-7rd5r; builds on af-rt1t2's convoy-show batching).
  bg_start "$tmp_dir/city.json" gc_json status --json
  bg_start "$tmp_dir/queue.json" "$QUEUE_BIN" list --json
  bg_start "$tmp_dir/parent.json" gc_json bd show "$PRODUCT_ROOT_BEAD" --json

  capture_json_bg CITY_RESPONSE "Gas City status" "$tmp_dir/city.json"
  jq -e '
    (.ok | type == "boolean") and (.running | type == "boolean") and
    (.health.usable | type == "boolean") and
    ((.health.degraded // false) | type == "boolean") and
    (.agents | type == "array")
  ' >/dev/null <<<"$CITY_RESPONSE" \
    || die "Gas City health contract is incomplete."

  capture_json_bg queue_response "SayMyName product queue" "$tmp_dir/queue.json"
  jq -e 'type == "array" and all(.[];
    .contract == "agent-factory-human-state/v1" and
    (.state == "eligible" or .state == "paused") and
    .technical_status == "deferred")' >/dev/null <<<"$queue_response" \
    || die "Product queue did not return the canonical human candidate contract."

  capture_json_bg parent_response "Beads product coordination" "$tmp_dir/parent.json"
  parent=$(single_issue "$parent_response" "Product coordination root $PRODUCT_ROOT_BEAD")
  [[ $(required_string "$parent" '.id' "Product coordination root ID") == "$PRODUCT_ROOT_BEAD" ]] \
    || die "Product coordination root ID is inconsistent."

  current_id=$(jq -er '.metadata["gc.current_jit"] // "none" |
    select(type == "string")' <<<"$parent") || die "Current outcome pointer is invalid."
  CURRENT_CAUSE=""
  last_id=$(metadata_string "$parent" "gc.last_delivered" "Last delivered pointer")

  # gc.current_jit and gc.last_delivered can each name a Bead in a different
  # rig's store (e.g. a rig-scoped smb-* current outcome alongside a root-scoped
  # af-* last delivery). `gc bd show` resolves which store to query from the
  # FIRST id it is given, so batching these two ids into one call silently
  # fails to resolve whichever one belongs to the other store (confirmed live
  # 2026-09-18, af-rt1t2: `gc bd show smb-44tt af-smmwz --json` only returned
  # af-smmwz). They must stay two separate calls -- but nothing stops the two
  # separate calls, and the workflow-inventory lookup derive_active_context
  # will need if current_id resolves to something, from running concurrently
  # with each other and with the delivered-outcome fetch below.
  local workflows_outfile="$tmp_dir/workflows.json"
  local have_current=0
  if [[ -n $current_id && $current_id != none ]]; then
    have_current=1
    bg_start "$tmp_dir/current.json" gc_json bd show "$current_id" --json
    bg_start "$workflows_outfile" gc_json bd list --status=in_progress --json
  fi
  bg_start "$tmp_dir/delivered.json" gc_json bd show "$last_id" --json

  # Collect the delivered outcome and kick off its (slow) GitHub PR fetch in
  # the background immediately, so that fetch's wall time is hidden behind
  # the active-context derivation below instead of adding to the end of the
  # pipeline as it did before.
  show_issue_bg delivered_issue "Last delivered outcome $last_id" "$tmp_dir/delivered.json"
  local delivery_prepared_json="" delivery_ready=0 pr_number="" pr_repo=""
  if delivery_prepared_json=$(derive_delivery_prepare "$delivered_issue" "$last_id"); then
    LAST_OUTCOME=$(jq -r '.outcome' <<<"$delivery_prepared_json")
    pr_number=$(jq -r '.pr_number' <<<"$delivery_prepared_json")
    pr_repo=$(jq -r '.github_repo' <<<"$delivery_prepared_json")
    bg_start "$tmp_dir/pr.json" pr_view_with_rollup "$pr_number" "$pr_repo"
    delivery_ready=1
  else
    log "WARNING: last delivered outcome $last_id has missing or invalid delivery proof (see the ERROR above); reporting it as degraded instead of aborting the projection."
    LAST_OUTCOME=$(jq -r '.title // empty' <<<"$delivered_issue")
    [[ -n $LAST_OUTCOME ]] || LAST_OUTCOME="$last_id (titre indisponible)"
    LAST_DELIVERY="Preuve de livraison manquante ou invalide pour $last_id ; voir le journal du contrôleur."
  fi

  if [[ $have_current -eq 0 ]]; then
    CURRENT_OUTCOME="none"
    CURRENT_STATE="none"
    CURRENT_PHASE="Aucune livraison produit n'est active"
    CURRENT_AGENT="none"
    current_json=null
  else
    show_issue_bg current_issue "Current outcome $current_id" "$tmp_dir/current.json"
    derive_active_context_or_degrade "$current_issue" "$current_id" "$workflows_outfile"
    current_json=$(jq -cn \
      --arg id "$current_id" --arg title "$CURRENT_OUTCOME" \
      --arg state "$CURRENT_STATE" --arg phase "$CURRENT_PHASE" \
      --arg agent "$CURRENT_AGENT" --arg cause "$CURRENT_CAUSE" '{
        id: $id, title: $title, state: $state, phase: $phase,
        agent: (if $agent == "none" then null else $agent end),
        cause: (if $cause == "" then null else $cause end)
      }')
  fi

  if [[ $delivery_ready -eq 1 ]]; then
    local finish_json
    if finish_json=$(
      if ! bg_wait "$tmp_dir/pr.json"; then
        die "GitHub PR $pr_number source command failed. Restore that source, then retry."
      fi
      pr_response=$(cat "$tmp_dir/pr.json")
      jq -e . >/dev/null 2>&1 <<<"$pr_response" \
        || die "GitHub PR $pr_number returned invalid JSON. Restore that source, then retry."
      derive_delivery_finish "$delivery_prepared_json" "$pr_response"
    ); then
      LAST_DELIVERY=$(jq -r '.evidence' <<<"$finish_json")
    else
      log "WARNING: last delivered outcome $last_id has missing or invalid delivery proof (see the ERROR above); reporting it as degraded instead of aborting the projection."
      LAST_DELIVERY="Preuve de livraison manquante ou invalide pour $last_id ; voir le journal du contrôleur."
    fi
  fi

  NEEDS_BENJAMIN=$(metadata_string "$parent" "gc.needs_benjamin" "Human decision")
  needs_json=$(jq -cn --arg value "$NEEDS_BENJAMIN" \
    'if ($value | ascii_downcase) == "none" then null else $value end')

  # ADR-0023: gc.next_outcome is retired. The queue was always authoritative
  # for eligibility -- gc.next_outcome was hand-maintained prose that no
  # queue mutation (add, move, pause, resume, cancel, materialize) kept in
  # step, and nothing but this comparison ever read it. One release
  # (2026-09-17) degraded a mismatch to a WARNING instead of dying; this
  # release stops reading the field at all.
  next_candidate=$(jq -c '[.[] | select(.state == "eligible" and .goal != "none")][0] // null' \
    <<<"$queue_response")

  resume_mode=$(metadata_optional "$parent" "gc.resume_mode")
  resume_condition=$(metadata_optional "$parent" "gc.resume_condition")
  [[ -n $resume_mode ]] || resume_mode=manual
  if [[ $CURRENT_STATE == waiting_dependency ]]; then
    resume_mode=automatic_dependency
    [[ -n $resume_condition ]] || resume_condition=$(metadata_optional "$current_issue" "gc.resume_condition")
    [[ -n $resume_condition ]] || die "Automatic dependency wait has no explicit condition."
  fi
  degraded=$(jq -r '.health.degraded // false' <<<"$CITY_RESPONSE")
  campaign_metadata=$(jq -c '.metadata' <<<"$parent")
  observed=$(jq -cn \
    --argjson running "$(jq '.ok and .running' <<<"$CITY_RESPONSE")" \
    --argjson usable "$(jq '.health.usable' <<<"$CITY_RESPONSE")" \
    --argjson degraded "$degraded" \
    --argjson current "$current_json" \
    --argjson queue "$queue_response" \
    --argjson needs "$needs_json" \
    --arg mode "$resume_mode" --arg condition "$resume_condition" \
    --arg cause "$CURRENT_CAUSE" --argjson campaign_metadata "$campaign_metadata" '{
      infrastructure: {running: $running, usable: $usable, degraded: $degraded},
      sources_consistent: true,
      current: $current,
      queue: $queue,
      needs_benjamin: $needs,
      blockers: (if $cause == "" then [] else [{cause: $cause}] end),
      resume_policy: {mode: $mode, condition: (if $condition == "" then null else $condition end)},
      campaign_metadata: $campaign_metadata
    }')
  if ! state_json=$("$HUMAN_STATE_BIN" state <<<"$observed"); then
    die "Canonical human state projection failed closed."
  fi
  # af-3uefc: project_campaign_work only ever sees a queue candidate that is
  # traceable (own criterion_refs subset of the release's known criteria) and
  # proven independent -- a paused candidate must still never be picked up by
  # the campaign, so this is the one place that state gets filtered before
  # the candidate is handed to project_release; project_campaign_work itself
  # does not know about queue state at all (lib/product_release.py).
  local queue_candidates_file="$tmp_dir/queue-candidates.json"
  jq -c '[.[] | select(.state == "eligible") |
    {id: .id, title: .title, criterion_refs: .criterion_refs, independence: .independence}]' \
    <<<"$queue_response" >"$queue_candidates_file"
  capture_json release_json "SayMyName release contract" \
    "$RELEASE_BIN" project "$RELEASE_FILE" --queue-candidates "$queue_candidates_file"
  state_json=$(jq -c \
    --arg product SAYMYNAME --arg last_title "$LAST_OUTCOME" \
    --arg last_evidence "$LAST_DELIVERY" --argjson release "$release_json" \
    '. as $state | ($release + {
      operational_state: (if $state.campaign.enabled and ($release.truth_state == "approved" or $release.truth_state == "executing") then "executing" else $release.truth_state end),
      operational_state_label: (if $state.campaign.enabled and ($release.truth_state == "approved" or $release.truth_state == "executing") then "En exécution par la campagne" elif $release.truth_state == "approved" then "Approuvée · campagne non activée" elif $release.truth_state == "frozen" then "Figée" else "Brouillon Git" end)
    }) as $operational_release |
    . + {product: $product, release: $operational_release, last_delivery: {title: $last_title, evidence: $last_evidence}, model_calls: 0}' \
    <<<"$state_json")

  if [[ $format == json ]]; then
    printf '%s\n' "$state_json"
    return
  fi
  printf 'SAYMYNAME\n'
  printf 'SANTÉ: %s — %s\n' "$(jq -r '.health.label' <<<"$state_json")" "$(jq -r '.health.detail' <<<"$state_json")"
  printf 'ACTIVITÉ: %s — %s\n' "$(jq -r '.activity.label' <<<"$state_json")" "$(jq -r '.activity.detail' <<<"$state_json")"
  printf 'CURRENT: %s — %s\n' "$CURRENT_OUTCOME" "$(jq -r '.result.state_label' <<<"$state_json")"
  printf 'CURRENT AGENT: %s\n' "$CURRENT_AGENT"
  printf 'LAST DELIVERED: %s — %s\n' "$LAST_OUTCOME" "$LAST_DELIVERY"
  if [[ $next_candidate == null ]]; then
    printf 'NEXT: none — aucun candidat produit éligible\n'
  else
    printf 'NEXT: %s — %s — %s\n' \
      "$(jq -r '.id' <<<"$next_candidate")" "$(jq -r '.title' <<<"$next_candidate")" \
      "$(jq -r '.state_label' <<<"$next_candidate")"
  fi
  printf 'REPRISE AUTOMATIQUE: %s\n' "$(jq -r 'if .resume.automatic then "oui" else "non" end' <<<"$state_json")"
  printf 'CAMPAGNE: %s\n' "$(jq -r '.campaign.state_label' <<<"$state_json")"
  if [[ $(jq -r '.campaign.blocked' <<<"$state_json") == true ]]; then
    printf 'BLOCAGE CAMPAGNE: %s\n' "$(jq -r '.campaign.cause' <<<"$state_json")"
  fi
  printf 'CONDITION: %s\n' "$(jq -r '.resume.condition // "aucune"' <<<"$state_json")"
  printf 'RESPONSABLE: %s\n' "$(jq -r '.resume.owner_label' <<<"$state_json")"
  printf 'ACTION UTILE: %s\n' "$(jq -r '.resume.action' <<<"$state_json")"
  printf 'NEEDS BENJAMIN: %s\n' "$(jq -r '.needs_benjamin // "none — aucune décision bloquante"' <<<"$state_json")"
}

if [[ ${SAYMYNAME_PRODUCT_STATUS_SOURCE_ONLY:-0} != 1 ]]; then
  main "$@"
fi
