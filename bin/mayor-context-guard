#!/usr/bin/env python3
"""mayor-context-guard -- backstop for the Mayor prompt's Handoff rule (af-3ewcxf).

The Mayor is told to hand off at ~40-60k fresh tokens; nothing enforced it and
one conversation reached 365k. This L0, zero-token guard (run by
orders/mayor-context-guard.toml) reads the Mayor's current Claude transcript
and, when the conversation carries more than MAYOR_CONTEXT_GUARD_TOKENS
(default 150000) context tokens or is older than MAYOR_CONTEXT_GUARD_MAX_AGE_HOURS
(default 8), rotates it:

  gc mail -> mayor: "HANDOFF: ..." with OPEN_MAIL/OPEN_DECISIONS/IN_FLIGHT/NEXT
  gc session reset mayor      # fresh provider conversation; bead, alias, mail kept

Why not `gc handoff --target mayor`: it kills the session, and the Mayor's
wake_mode is the default `resume`, so the reconciler would resume the same
oversized conversation. `gc session reset` is the fresh-restart primitive.

Context tokens = last assistant usage: input + cache_read + cache_creation.
Age = first transcript timestamp. The guard waits while the Mayor is mid-turn
(last assistant stop_reason is not end_turn) and acts at most once per
conversation id (state: .gc/runtime/mayor-context-guard-state.json). It never
touches any other session.

Usage: mayor-context-guard [--check]   # prints one JSON decision line
"""
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

ROOT = os.environ.get("FACTORY_ROOT", "/home/benja/agent-factory")
GC = os.environ.get("GC_BIN", "gc")
ALIAS = "mayor"
TOKENS = int(os.environ.get("MAYOR_CONTEXT_GUARD_TOKENS", "150000"))
MAX_AGE = float(os.environ.get("MAYOR_CONTEXT_GUARD_MAX_AGE_HOURS", "8")) * 3600
STATE = os.path.join(ROOT, ".gc/runtime/mayor-context-guard-state.json")
LOG = os.path.join(ROOT, "var/mayor-context-guard.log")

HANDOFF = """Automatic rotation by bin/mayor-context-guard ({reason}: {tokens} context tokens, conversation {age_h}h old; bounds {limit} tokens / {max_h}h).
The previous incarnation did not write its own handoff; rebuild state from the durable sources:
OPEN_MAIL: unknown -- run `gc mail inbox`
OPEN_DECISIONS: unknown -- check open beads with gc.needs_benjamin
IN_FLIGHT: unknown -- check in-progress beads and `gc status`
NEXT: re-read the above, then continue the highest-priority open work. Hand off yourself before ~60k fresh tokens."""


def emit(**decision):
    print(json.dumps(decision, sort_keys=True))
    return 0


def epoch(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()


def read_transcript(path):
    first_ts, usage, stop = None, None, None
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            if first_ts is None and rec.get("timestamp"):
                first_ts = rec["timestamp"]
            if rec.get("type") in ("user", "assistant"):
                msg = rec.get("message") or {}
                stop = msg.get("stop_reason") if rec["type"] == "assistant" else "user"
                if rec["type"] == "assistant" and msg.get("usage"):
                    usage = msg["usage"]
    tokens = sum(int((usage or {}).get(k) or 0) for k in
                 ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    return tokens, (epoch(first_ts) if first_ts else None), stop


def main(argv):
    check = "--check" in argv or "--dry-run" in argv
    now = float(os.environ.get("MAYOR_CONTEXT_GUARD_NOW") or time.time())
    try:
        out = subprocess.run([GC, "session", "list", "--json"], cwd=ROOT,
                             capture_output=True, text=True, timeout=60).stdout
        sessions = json.loads(out or "{}").get("sessions") or []
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        return emit(action="skip", why=f"gc session list failed: {exc}")
    mayor = next((s for s in sessions if s.get("alias") == ALIAS and s.get("state") == "active"), None)
    key = (mayor or {}).get("session_key")
    if not key:
        return emit(action="skip", why="no active mayor session with a conversation id")

    tdir = os.environ.get("MAYOR_CONTEXT_GUARD_TRANSCRIPTS") or os.path.expanduser(
        "~/.claude/projects/" + (mayor.get("work_dir") or ROOT).replace("/", "-").replace(".", "-"))
    path = os.path.join(tdir, key + ".jsonl")
    if not os.path.isfile(path):
        return emit(action="skip", conversation=key, why=f"no transcript at {path}")
    tokens, started, stop = read_transcript(path)
    age = int(now - started) if started else 0
    base = dict(conversation=key, tokens=tokens, age_seconds=age)

    reason = "tokens" if tokens > TOKENS else "age" if age > MAX_AGE else None
    if not reason:
        return emit(action="none", **base)
    try:
        with open(STATE, encoding="utf-8") as fh:
            rotated = json.load(fh).get("rotated", [])
    except (OSError, ValueError):
        rotated = []
    if key in rotated:
        return emit(action="already-rotated", reason=reason, **base)
    if stop != "end_turn":
        return emit(action="deferred-busy", reason=reason, **base)
    if check:
        return emit(action="rotate", reason=reason, **base)

    # Self-identifying sender (tests/mail-agent-identity-test.sh): a script has
    # no gc session of its own, so the body names it.
    body = f"ACTION: mayor-context-guard rotated conversation {key}\n" + HANDOFF.format(
        reason=reason, tokens=tokens, age_h=round(age / 3600, 1),
        limit=TOKENS, max_h=round(MAX_AGE / 3600, 1))
    subject = f"HANDOFF: automatic context rotation ({reason})"
    mail = subprocess.run([GC, "mail", "send", ALIAS, "-s", subject, "-m", body],
                          cwd=ROOT, capture_output=True, text=True)
    reset = subprocess.run([GC, "session", "reset", ALIAS], cwd=ROOT, capture_output=True, text=True)
    status = "rotated" if reset.returncode == 0 else "reset-failed"
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w", encoding="utf-8") as fh:
        json.dump({"rotated": (rotated + [key])[-20:]}, fh)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as fh:
        fh.write(f"{datetime.fromtimestamp(now, timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}\tstatus={status}"
                 f"\treason={reason}\tconversation={key}\ttokens={tokens}\tage_seconds={age}"
                 f"\tmail_rc={mail.returncode}\treset_rc={reset.returncode}\n")
    return emit(action=status, reason=reason, **base)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
