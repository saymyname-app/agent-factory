#!/usr/bin/env python3
"""Guarded lifecycle and zero-token sentinel for the Mayor-owned campaign."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from factory_campaign import (  # noqa: E402
    FAILURE_THRESHOLD, LADDER_GENERATIVE_RUNGS, CampaignDecisionError,
    plan_factory_lane, plan_idle_ladder, plan_transition,
)
from factory_state import _text, StateContractError, project_campaign_metadata  # noqa: E402


PROGRAM = "mayor-campaign"
GC_BIN = os.environ.get("GC_BIN", "gc")
STATUS_BIN = os.environ.get("SAYMYNAME_STATUS_BIN", str(ROOT / "bin" / "saymyname-product-status"))
PRODUCT_QUEUE_BIN = os.environ.get(
    "SAYMYNAME_PRODUCT_QUEUE_BIN", str(ROOT / "bin" / "saymyname-product-queue")
)
AXES_BIN = os.environ.get(
    "FACTORY_IMPROVEMENT_AXES_BIN", str(ROOT / "bin" / "factory-improvement-axes")
)
COORDINATION_BEAD = os.environ.get("CAMPAIGN_COORDINATION_BEAD", "af-1vr4")
# af-ck3xg: `gc bd ready --json` defaults to --limit 100 and only warns about
# truncation on stderr, which json_run never sees -- a store with >100 ready
# wisps (mail, nudges, tracking) ahead of a real Factory bead silently hides
# it from the idle ladder, reporting factory_lane_empty when it is not.
READY_LIST_PAGE_SIZE = 100
LOCK_PATH = Path(os.environ.get(
    "CAMPAIGN_LOCK_FILE",
    f"{os.environ.get('XDG_RUNTIME_DIR') or '/tmp'}/agent-factory-mayor-campaign.lock",
))
DEFAULT_CONDITION = (
    "Dès qu'aucune livraison n'est en cours, le Mayor enchaîne le premier candidat produit "
    "éligible, sauf limite, décision humaine, action ADMIN ou panne durable."
)
# C8: the sentinel order kills the whole tick at 50s (orders/mayor-campaign.toml).
# A single call could previously run up to 45s, so ~2 slow calls in one tick were
# enough to be killed with zero trace -- 31 such kills in 24h, uncounted. Each
# call now gets 10s, and the tick as a whole a 40s budget it can see coming.
TICK_DEADLINE_SECONDS = float(os.environ.get("CAMPAIGN_TICK_DEADLINE_SECONDS", "40"))
# af-tbgs4: saymyname-product-status --json measured at ~10-12s (mostly `gc
# status --json` inside it, ~8s), so the blanket 10s CAMPAIGN_COMMAND_TIMEOUT
# above transiently killed a meaningful fraction of sentinel ticks calling it.
# Give this one slow, known call its own headroom instead of raising the
# timeout for every call.
#
# af-rt1t2 (2026-09-18): the script's own cost grew to ~23-25s, past this 20s
# budget, on every sentinel tick regardless of whether the campaign was
# actually stalled -- a recurring false-positive source (af-416h8, af-03c41
# and predecessors). Profiling found `gc status --json` alone now costs
# ~14s (that binary is external to this repo, its cost scales with live
# agent count, and it is already called exactly once) and every `gc bd
# show`/`gc bd list` invocation carries several more seconds of fixed
# process/DB-connect overhead that batching multiple ids into one call can
# remove -- done here for the N-per-concurrent-workflow convoy lookup inside
# saymyname-product-status's active-context resolution. The other two
# sequential `gc bd show` calls (current outcome, last delivered outcome)
# could NOT be batched together: `gc bd show` resolves which rig's store to
# query from the first id argument, so the two ids -- which can each name a
# Bead in a different rig -- silently lose whichever one isn't in that first
# id's store when combined into one call (confirmed live: `gc bd show
# smb-44tt af-smmwz --json` returned only af-smmwz). With that reduction
# applied, the script still costs ~23-24s end to end because of the
# unbatchable gc status floor, so the budget below is raised to match the
# now-confirmed inherent cost rather than the batching removing it.
STATUS_COMMAND_TIMEOUT = float(os.environ.get("CAMPAIGN_STATUS_COMMAND_TIMEOUT", "30"))

_tick_deadline: float | None = None


class CampaignCommandError(RuntimeError):
    pass


class TickDeadlineExceeded(RuntimeError):
    """C8: the sentinel's tick budget elapsed before a call could even run.

    Deliberately NOT a CampaignCommandError: every per-call try/except in
    sentinel() catches that type to count an ordinary command failure toward
    FAILURE_THRESHOLD. A killed tick is a different signal -- a duration
    problem, not a retryable command failure -- and must reach main()
    uncaught by any of those, to be recorded distinctly instead of silently
    inflating the durable-failure counter.
    """


def run(*args: str, timeout: float | None = None) -> subprocess.CompletedProcess[str]:
    if _tick_deadline is not None and time.monotonic() > _tick_deadline:
        raise TickDeadlineExceeded(f"budget de {TICK_DEADLINE_SECONDS}s dépassé avant {args[0]}")
    if timeout is None:
        timeout = float(os.environ.get("CAMPAIGN_COMMAND_TIMEOUT", "10"))
    try:
        return subprocess.run(
            args, cwd=ROOT, text=True, capture_output=True, check=True,
            timeout=timeout,
            env={**os.environ, "NO_COLOR": "1"},
        )
    except (OSError, subprocess.SubprocessError) as exc:
        if isinstance(exc, subprocess.CalledProcessError):
            detail = (exc.stderr or exc.stdout or str(exc)).strip()
        else:
            detail = str(exc)
        raise CampaignCommandError(detail or f"Commande indisponible: {args[0]}") from exc


def json_run(*args: str, timeout: float | None = None) -> Any:
    result = run(*args, timeout=timeout)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise CampaignCommandError(f"JSON invalide produit par {' '.join(args)}") from exc


def single_issue(value: Any, expected_id: str) -> dict[str, Any]:
    if isinstance(value, list) and len(value) == 1 and isinstance(value[0], dict):
        value = value[0]
    if not isinstance(value, dict) or value.get("id") != expected_id:
        raise CampaignCommandError(f"Le Bead {expected_id} ne se résout pas de façon unique.")
    return value


def show_issue(issue_id: str) -> dict[str, Any]:
    return single_issue(json_run(GC_BIN, "bd", "show", issue_id, "--json"), issue_id)


def coordination_issue() -> dict[str, Any]:
    try:
        return show_issue(COORDINATION_BEAD)
    except CampaignCommandError as exc:
        raise CampaignCommandError(
            "Le magasin de coordination est indisponible; état fail-closed et échec non persistable: "
            f"{failure_detail(exc)}"
        ) from exc


def coordination() -> tuple[dict[str, Any], dict[str, Any]]:
    issue = coordination_issue()
    metadata = issue.get("metadata")
    if not isinstance(metadata, dict):
        raise CampaignCommandError("Les métadonnées de coordination sont indisponibles.")
    try:
        campaign = project_campaign_metadata(metadata)
    except StateContractError as exc:
        raise CampaignCommandError(str(exc)) from exc
    return issue, campaign


def safe_value(value: Any) -> str:
    text = str(value).strip()
    if "\n" in text or "\r" in text or "\x00" in text or len(text) > 1000:
        raise CampaignCommandError("Une valeur de campagne n'est pas une ligne bornée valide.")
    return text


def update_metadata(values: dict[str, Any]) -> None:
    args = [GC_BIN, "bd", "update", COORDINATION_BEAD]
    for key, value in values.items():
        args.extend(("--set-metadata", f"{key}={safe_value(value)}"))
    run(*args)


def require_mayor(authority: bool) -> None:
    if not authority:
        raise CampaignCommandError("Cette transition de campagne exige le garde explicite --mayor.")


def activate(args: argparse.Namespace) -> None:
    require_mayor(args.authority)
    issue, campaign = coordination()
    coordination_metadata = issue.get("metadata", {})
    needs = str(coordination_metadata.get("gc.needs_benjamin", "")).strip()
    if needs and not needs.lower().startswith("none"):
        raise CampaignCommandError("La campagne ne peut pas être activée pendant une décision NEEDS BENJAMIN.")
    resume_mode = str(coordination_metadata.get("gc.resume_mode", "manual")).strip() or "manual"
    candidate = show_issue(args.candidate)
    candidate_metadata = candidate.get("metadata") if isinstance(candidate.get("metadata"), dict) else {}
    if not (
        candidate.get("status") == "closed"
        and candidate_metadata.get("gc.queue_state") == "materialized"
        and candidate_metadata.get("gc.queue_goal") == "none"
        and candidate_metadata.get("gc.materialized_bead") == args.execution
    ):
        raise CampaignCommandError(
            "Le candidat campagne doit d'abord être matérialisé dans son Bead d'exécution par le Mayor."
        )
    execution = show_issue(args.execution)
    if execution.get("status") not in {"open", "in_progress", "closed"}:
        raise CampaignCommandError("Le Bead d'exécution de campagne a un état incompatible.")
    if campaign["enabled"]:
        if campaign["state"] in {"blocked", "completed"}:
            raise CampaignCommandError(
                f"La campagne est déjà {campaign['state']}; utiliser la transition gardée appropriée."
            )
        if (
            campaign["state"] in {"active", "awaiting_mayor", "running"}
            and campaign["candidate_id"] == args.candidate
            and campaign["condition"] == args.condition
            and resume_mode == "automatic_campaign"
        ):
            print(f"ALREADY ACTIVE: {args.candidate} -> {args.execution}")
            return
        raise CampaignCommandError("Une campagne automatique différente est déjà activée.")
    if resume_mode != "manual":
        raise CampaignCommandError(f"La politique de reprise {resume_mode} interdit l'activation de campagne.")
    current_id = str(coordination_metadata.get("gc.current_jit", "")).strip()
    if current_id and not current_id.lower().startswith("none"):
        current = show_issue(current_id)
        current_metadata = current.get("metadata") if isinstance(current.get("metadata"), dict) else {}
        if current.get("status") == "blocked":
            raise CampaignCommandError("Le résultat courant est bloqué; l'activation ne peut pas contourner sa reprise.")
        if current_metadata.get("gc.resume_mode") == "automatic_dependency":
            raise CampaignCommandError("Le résultat courant attend une dépendance; préserver sa politique de reprise.")
    update_metadata({
        "gc.campaign_mode": "automatic",
        "gc.campaign_state": "active",
        "gc.campaign_candidate": args.candidate,
        "gc.campaign_condition": args.condition,
        # ADR-0023 / af-hihkg: the last valid pair, kept so `repair --mayor`
        # can restore gc.campaign_candidate/condition if either is ever found
        # missing on the coordination bead without needing to guess.
        "gc.campaign_candidate_last": args.candidate,
        "gc.campaign_condition_last": args.condition,
        "gc.campaign_owner": "Mayor",
        "gc.campaign_action": "Aucune action de Benjamin; le sentinelle réveille le Mayor quand une transition est due.",
        "gc.campaign_block_kind": "",
        "gc.campaign_cause": "",
        "gc.campaign_wake_key": "",
        "gc.campaign_wake_state": "none",
        "gc.campaign_failure_count": "0",
        "gc.campaign_last_error": "",
        "gc.resume_mode": "automatic_campaign",
        "gc.resume_condition": args.condition,
    })
    print(f"ACTIVATED: {args.candidate} -> {args.execution}")


def block(args: argparse.Namespace) -> None:
    require_mayor(args.authority)
    issue, campaign = coordination()
    if not campaign["enabled"]:
        raise CampaignCommandError("Aucune campagne automatique n'est active.")
    needs = str(issue.get("metadata", {}).get("gc.needs_benjamin", "")).strip()
    if args.kind == "decision" and (not needs or needs.lower().startswith("none")):
        raise CampaignCommandError(
            "Un blocage décisionnel exige une décision effective dans gc.needs_benjamin."
        )
    update_metadata({
        "gc.campaign_state": "blocked",
        "gc.campaign_owner": args.owner,
        "gc.campaign_action": args.action,
        "gc.campaign_block_kind": args.kind,
        "gc.campaign_cause": args.cause,
        "gc.campaign_wake_key": "",
        "gc.campaign_wake_state": "none",
    })
    print(f"BLOCKED: {args.kind} — owner {args.owner} — {args.cause}")


def resume(args: argparse.Namespace) -> None:
    require_mayor(args.authority)
    issue, campaign = coordination()
    if not campaign["enabled"] or campaign["state"] != "blocked":
        raise CampaignCommandError("La campagne n'est pas dans un état bloqué persistant.")
    needs = str(issue.get("metadata", {}).get("gc.needs_benjamin", "")).strip()
    if campaign["blocker_kind"] == "decision" and needs and not needs.lower().startswith("none"):
        raise CampaignCommandError("La décision NEEDS BENJAMIN est encore effective.")
    if not campaign["candidate_id"] or not campaign["condition"]:
        # af-hihkg: repair --mayor may have left the campaign blocked (kind
        # admin) with no candidate/condition because it had no last valid
        # value to restore. Resuming into "active" without one would just
        # move the same StateContractError to the very next read.
        raise CampaignCommandError(
            "Candidat/condition de campagne manquants; fournir des valeurs valides "
            "(voir gc.campaign_cause) avant toute reprise."
        )
    updates = {
        "gc.campaign_state": "active",
        "gc.campaign_owner": "Mayor",
        "gc.campaign_action": "Aucune action de Benjamin; le sentinelle réveille le Mayor quand une transition est due.",
        "gc.campaign_block_kind": "",
        "gc.campaign_cause": "",
        "gc.campaign_wake_key": "",
        "gc.campaign_wake_state": "none",
        "gc.campaign_failure_count": "0",
        # ADR-0023 / af-hihkg: refresh the last-valid pair on every successful
        # resume too, mirroring activate.
        "gc.campaign_candidate_last": campaign["candidate_id"],
        "gc.campaign_condition_last": campaign["condition"],
        "gc.campaign_last_error": "",
    }
    update_metadata(updates)
    print("RESUMED: campaign active")


def complete(args: argparse.Namespace) -> None:
    require_mayor(args.authority)
    _, campaign = coordination()
    if not campaign["enabled"]:
        raise CampaignCommandError("Aucune campagne automatique n'est active.")
    if campaign["state"] == "blocked":
        raise CampaignCommandError("Une campagne bloquée doit être reprise, pas marquée terminée.")
    status = json_run(STATUS_BIN, "--json", timeout=STATUS_COMMAND_TIMEOUT)
    if status.get("result", {}).get("id") is not None or status.get("next_candidate") is not None:
        raise CampaignCommandError("La campagne ne peut être marquée terminée tant qu'un résultat est actif ou éligible.")
    update_metadata({
        "gc.campaign_state": "completed",
        "gc.campaign_owner": "none",
        "gc.campaign_action": "Aucune action immédiate; enregistrer un nouveau candidat lorsqu'il devient utile.",
        "gc.campaign_block_kind": "",
        "gc.campaign_cause": "",
        "gc.campaign_wake_key": "",
        "gc.campaign_wake_state": "none",
        "gc.campaign_failure_count": "0",
        "gc.campaign_last_error": "",
    })
    print("COMPLETED: no active or eligible product result")


# ADR-0023 / af-hihkg: coordination-root pointer fields must hold a Bead id
# or the literal "none" -- never an empty string, which a reader cannot tell
# apart from "still being written". gc.next_outcome is retired (ADR-0023
# bullet 1) and is deliberately not repaired here.
COORDINATION_POINTER_FIELDS = (
    "gc.current", "gc.current_jit", "gc.last_delivered",
    "gc.needs_benjamin", "gc.blocked_reason",
    "gc.campaign_candidate", "gc.campaign_condition", "gc.resume_condition",
)


def _candidate_fully_closed(candidate_id: str) -> bool:
    """True when a campaign candidate and the execution it was materialized
    into are BOTH closed -- af-ho5qi's third stale-pointer shape, distinct
    from the routine state a candidate is in for the rest of its campaign's
    life.

    `activate` requires its candidate to already be closed (materialized)
    before it will authorize a campaign (see `activate` above), so a closed
    candidate alone is normal for as long as the campaign runs -- it is not
    a signal anything needs fixing. What actually went stale in the
    2026-09-19 shape (af-ho5qi) is that the candidate's own linked
    execution Bead (`gc.materialized_bead`) has ALSO closed: the whole
    authorized unit of work finished and nothing advanced the coordination
    Bead past it. Fails safe like `wake_target_resolved`: an unresolvable
    id (deleted, store hiccup) or a candidate with no recorded execution
    link must never be treated as a positive "stale" signal, since that
    would make `repair` act on a guess instead of an observed fact.
    """
    try:
        candidate_issue = node_issue(candidate_id)
    except CampaignCommandError:
        return False
    if candidate_issue.get("status") != "closed":
        return False
    candidate_metadata = candidate_issue.get("metadata")
    if not isinstance(candidate_metadata, dict):
        return False
    execution_id = _text(candidate_metadata.get("gc.materialized_bead"))
    if not execution_id:
        return False
    try:
        execution_issue = node_issue(execution_id)
    except CampaignCommandError:
        return False
    return execution_issue.get("status") == "closed"


def repair(args: argparse.Namespace) -> None:
    """The repair door for the 2026-09-18 08:43Z incident shape (af-hihkg).

    gc.campaign_candidate went missing on the coordination Bead by a hand-write
    while the automatic campaign was still active; the sentinel then dies on
    StateContractError and `activate` refuses to touch an already-active
    campaign, so nothing could repair it short of another hand-write -- exactly
    what ADR-0023 exists to end. This reads raw metadata (never `coordination()`,
    which would itself raise on the corruption being repaired), restores
    gc.campaign_candidate/condition from the last valid pair recorded at every
    successful activate/resume, and normalises any empty-string coordination
    pointer to "none". When automatic mode is on but no last valid pair is on
    record either, it blocks the campaign (kind admin) with a plain cause
    instead of guessing a candidate.

    af-ho5qi: a candidate whose own execution Bead has ALSO closed
    (`gc.materialized_bead`, fully done and nothing advanced past it) is a
    third stale-pointer shape alongside "missing" and "empty string" -- it
    gets the same treatment (restore from the last valid pair, or block when
    there is none) *only* when that last valid pair actually differs from
    what is on the coordination Bead now. A closed candidate alone is not
    that signal: `activate` requires its candidate already closed
    (materialized) before it will authorize a campaign, so every running
    campaign's candidate stays closed for its entire life -- that is the
    routine, healthy shape, not corruption, and must stay a no-op or every
    running campaign would be "repaired" back to its own unchanged value on
    every factory-guard tick.
    """
    require_mayor(args.authority)
    issue = coordination_issue()
    metadata = issue.get("metadata") if isinstance(issue.get("metadata"), dict) else {}
    if _text(metadata.get("gc.campaign_mode")) != "automatic":
        print("NOOP: aucune campagne automatique à réparer")
        return

    changes: dict[str, str] = {}
    for field in COORDINATION_POINTER_FIELDS:
        raw = metadata.get(field)
        if isinstance(raw, str) and raw.strip() == "":
            changes[field] = "none"

    working = {**metadata, **changes}
    candidate = _text(working.get("gc.campaign_candidate"))
    condition = _text(working.get("gc.campaign_condition"))
    candidate_closed = candidate is not None and _candidate_fully_closed(candidate)
    if not candidate or not condition or candidate_closed:
        last_candidate = _text(working.get("gc.campaign_candidate_last"))
        last_condition = _text(working.get("gc.campaign_condition_last"))
        has_recorded_successor = bool(last_candidate) and bool(last_condition)
        differs_from_current = last_candidate != candidate or last_condition != condition
        if has_recorded_successor and differs_from_current:
            changes["gc.campaign_candidate"] = last_candidate
            changes["gc.campaign_condition"] = last_condition
        elif not has_recorded_successor:
            changes.update({
                "gc.campaign_candidate": "none",
                "gc.campaign_condition": "none",
                "gc.campaign_state": "blocked",
                "gc.campaign_owner": "Mayor",
                "gc.campaign_action": (
                    "Diagnostiquer la cause, puis fournir un candidat et une condition "
                    "valides avant toute reprise."
                ),
                "gc.campaign_block_kind": "admin",
                "gc.campaign_cause": (
                    "gc.campaign_candidate/gc.campaign_condition manquants ou déjà clos, "
                    "et aucune dernière valeur valide disponible (gc.campaign_candidate_last / "
                    "gc.campaign_condition_last)."
                ),
                "gc.campaign_wake_key": "",
                "gc.campaign_wake_state": "none",
            })
        # else: candidate_closed is the only trigger and the last valid pair
        # already matches it -- nothing to restore and nothing to block on.

    if not changes:
        print("NOOP: rien à réparer")
        return

    try:
        project_campaign_metadata({**metadata, **changes})
    except StateContractError as exc:
        raise CampaignCommandError(f"La réparation calculée resterait invalide: {exc}") from exc

    update_metadata(changes)
    for key in sorted(changes):
        print(f"FIXED: {key} -> {changes[key]}")


PRIORITY_LANES = ("factory", "product")
# ADR-0023 amendment 2 (2026-09-18): factory-first / product-first is a
# priority order with automatic fallthrough, not an exclusive pause. Factory
# is the default until Benjamin flips it -- matches the standing instruction
# "Factory work comes before product work" (agents/mayor/prompt.template.md).
DEFAULT_PRIORITY_LANE = "factory"


def priority_lane_of(metadata: dict[str, Any]) -> str:
    value = str(metadata.get("gc.campaign_priority_lane") or "").strip().lower()
    return value if value in PRIORITY_LANES else DEFAULT_PRIORITY_LANE


def priority(args: argparse.Namespace) -> None:
    """The one door for the lane-priority switch (ADR-0023 amendment 2).

    No candidate, campaign, or Mayor state depends on --mayor here: this is
    Benjamin's call, reversible at will, made through this command or the
    cockpit button that calls it -- never by hand-editing gc.* metadata.
    """
    issue = coordination_issue()
    metadata = issue.get("metadata") if isinstance(issue.get("metadata"), dict) else {}
    if args.lane is None:
        print(json.dumps({"lane": priority_lane_of(metadata)}, ensure_ascii=False))
        return
    update_metadata({"gc.campaign_priority_lane": args.lane})
    print(json.dumps({"lane": args.lane}, ensure_ascii=False))


def failure_detail(exc: Exception) -> str:
    return re.sub(r"\s+", " ", str(exc)).strip()[:400] or "échec sans détail"


def node_issue(node_id: str) -> dict[str, Any]:
    return single_issue(json_run(GC_BIN, "bd", "show", node_id, "--json"), node_id)


# wake_key prefixes that name a bead/candidate the wake was about, e.g.
# "finalize:af-u8id.4.1". Keys with no such reference (e.g.
# "complete:no-candidate", a rung bucket key) have nothing to check here.
WAKE_KEY_BEAD_PREFIXES = ("finalize:", "resume:", "resume-failed:", "materialize:", "ladder:factory:")


def wake_target_resolved(wake_key: str) -> bool:
    """True when the bead/candidate a wake_key names has itself closed.

    A wake sent for a bead that has since closed is stale regardless of what
    the sentinel's *next* decision reason happens to be -- on 2026-09-17 a
    wake for finalize:af-u8id.4.1 outlived that bead's closure because the
    next tick's reason was 'ladder_active', which the old clear condition did
    not recognize, leaving the cockpit reporting awaiting_mayor forever.
    """
    for prefix in WAKE_KEY_BEAD_PREFIXES:
        if wake_key.startswith(prefix):
            node_id = wake_key[len(prefix):].strip()
            if not node_id:
                return False
            try:
                issue = node_issue(node_id)
            except CampaignCommandError:
                # Unresolvable (deleted, store hiccup): don't clear on a guess.
                return False
            return issue.get("status") == "closed"
    return False


def factory_candidate_id(decision: dict[str, Any]) -> str | None:
    """The specific bead a factory-lane decision points at, if any.

    Rungs 2/2b (plan_factory_lane) pick a candidate from a `ready`/queue
    snapshot that can go stale in the seconds between that read and this
    mail actually being sent. An order-dispatch tracking bead (labels
    order-tracking/order-run:*) observed opening and closing ~30s later was
    picked up as the priority-lane candidate and notified after it had
    already closed (af-mqphq, 2026-09-18).
    """
    if decision.get("rung") == "factory":
        bead_id = str(decision.get("ladder_bead") or "").strip()
        return bead_id or None
    if decision.get("rung") == "factory_queue":
        wake_key = str(decision.get("wake_key") or "")
        if wake_key.startswith("materialize:"):
            return wake_key[len("materialize:"):].strip() or None
    return None


def status_node_id(status: Any) -> str | None:
    """Best-effort extraction of the candidate/result node a decision was about."""
    if not isinstance(status, dict):
        return None
    for key in ("next_candidate", "result"):
        item = status.get(key)
        if isinstance(item, dict):
            node_id = item.get("id")
            if isinstance(node_id, str) and node_id.strip():
                return node_id.strip()
    return None


def quarantine_node(node_id: str, exc: Exception) -> None:
    """Isolate the one failing node so the campaign can keep selecting other work."""
    cause = (
        f"Panne durable de campagne sur {node_id} après {FAILURE_THRESHOLD} échecs "
        f"consécutifs du sentinelle : {failure_detail(exc)}"
    )
    # ADR-0023: product-queue is the door for gc.queue_state; this used to
    # write it directly (a bypass the audit found on 2026-09-18).
    run(PRODUCT_QUEUE_BIN, "quarantine", node_id, safe_value(cause))
    run(
        GC_BIN, "bd", "update", node_id,
        "--set-metadata", "gc.campaign_node_failure_count=0",
        "--set-metadata", "gc.campaign_node_last_error=",
    )
    run(
        GC_BIN, "bd", "create",
        f"Réparer {node_id} — panne durable de campagne",
        "-p", "1", "-t", "bug",
        "-d", (
            f"Le nœud {node_id} a été mis en quarantaine par le sentinelle de campagne "
            f"après {FAILURE_THRESHOLD} échecs consécutifs. Cause : {failure_detail(exc)}. "
            "Diagnostiquer et corriger la source, puis reprendre ce nœud une fois réparé "
            "(le reste de la campagne continue sans lui)."
        ),
        "--set-metadata", f"gc.repair_for={node_id}",
    )


def record_node_failure(node_id: str, exc: Exception) -> int:
    """Count a failure against the one node it is attributable to, not the campaign."""
    node = node_issue(node_id)
    node_metadata = node.get("metadata") if isinstance(node.get("metadata"), dict) else {}
    try:
        count = int(node_metadata.get("gc.campaign_node_failure_count", 0)) + 1
    except (TypeError, ValueError):
        count = 1
    if count >= FAILURE_THRESHOLD:
        quarantine_node(node_id, exc)
    else:
        run(
            GC_BIN, "bd", "update", node_id,
            "--set-metadata", f"gc.campaign_node_failure_count={count}",
            "--set-metadata", f"gc.campaign_node_last_error={safe_value(failure_detail(exc))}",
        )
    return count


# Minimum wall-clock span of a failure streak before it counts as durable.
FAILURE_MIN_SPAN_SECONDS = int(os.environ.get("CAMPAIGN_FAILURE_MIN_SPAN_SECONDS", "600"))
_LAST_FAILURE_DURABLE = False


def failure_mode() -> str:
    return "durable failure" if _LAST_FAILURE_DURABLE else "automatic retry"


def record_failure(metadata: dict[str, Any], exc: Exception) -> int:
    global _LAST_FAILURE_DURABLE
    try:
        count = int(metadata.get("gc.campaign_failure_count", 0)) + 1
    except (TypeError, ValueError):
        count = 1
    # A durable failure is one that LASTS, not three one-minute ticks in a row:
    # on 2026-09-17 a Mayor mid-turn, then a status probe slowed by the
    # Factory's own parallel load, each tripped the breaker in ~3 minutes and
    # paged a false "durable failure". The streak must also span wall-clock time.
    now = current_time()
    since = epoch_of(metadata.get("gc.campaign_failure_since")) if count > 1 else None
    if since is None:
        since = now
    values = {
        "gc.campaign_failure_count": str(count),
        "gc.campaign_failure_since": iso(since),
        "gc.campaign_last_error": failure_detail(exc),
        "gc.campaign_wake_key": "",
        "gc.campaign_wake_state": "none",
    }
    _LAST_FAILURE_DURABLE = count >= FAILURE_THRESHOLD and now - since >= FAILURE_MIN_SPAN_SECONDS
    if _LAST_FAILURE_DURABLE:
        cause = (
            f"Le sentinelle de campagne a échoué {count} fois de suite : {failure_detail(exc)}"
        )
        values.update({
            "gc.campaign_state": "blocked",
            "gc.campaign_owner": "Mayor",
            "gc.campaign_action": (
                "Le Mayor diagnostique la source indiquée, puis exécute "
                "`./bin/mayor-campaign resume --mayor` après correction."
            ),
            "gc.campaign_block_kind": "durable_failure",
            "gc.campaign_cause": cause,
        })
    try:
        update_metadata(values)
    except CampaignCommandError as persist_exc:
        raise CampaignCommandError(
            "État fail-closed: le compteur d'échec ne peut pas être persisté sur la coordination: "
            f"{failure_detail(persist_exc)}"
        ) from persist_exc
    return count


# Liveness (ADR-0016 section 5.3). The sentinel leaves two timestamps on the
# coordination bead, and factory-guard reads them:
#   gc.campaign_sentinel_at -- this loop ran at all (proves the wake loop lives)
#   gc.campaign_progress_at -- something actually advanced
# A guard that only checked health reported "healthy" through six idle hours on
# 2026-09-15. Writes are throttled so a one-minute loop does not churn Dolt.
HEARTBEAT_SECONDS = 300
PROGRESS_REASONS = {"active_delivery", "automatic_dependency", "ladder_active"}
# Product work is genuinely under way: the ladder must not add a second thing.
LADDER_SKIPPED_REASONS = {"active_delivery", "automatic_dependency", "campaign_inactive"}
# "Already notified" used to mean "never again". On 2026-09-16 the Mayor read a
# resume wake, the city was restarted for maintenance, and the new Mayor session
# came up with no memory of it and no unread mail -- while the sentinel, having
# marked the wake sent, stayed silent forever. A wake that produced no progress
# is re-sent after REWAKE_SECONDS, at most MAX_REWAKES times; after that the
# liveness watchdog files a defect instead of mailing into the void.
REWAKE_SECONDS = 30 * 60
MAX_REWAKES = 3
# C4: a product wake stale enough to be reminded must not starve the Factory
# for the same 30 minutes. Only these reasons come from plan_transition
# (never from the ladder itself, which must not be bundled into itself).
PRODUCT_WAKE_REASONS = {
    "finalize_current", "resume_current", "resume_after_failure", "materialize_next",
    "record_complete", "queue_release_mismatch", "queue_candidate_untraceable",
}
# Generative ladder rungs are optional by nature: "nothing worth doing" is a
# valid answer, so they are never chased with reminders.
NO_REWAKE_PREFIXES = ("ladder:tests:", "ladder:docs:")


def epoch_of(value: Any) -> float | None:
    text = str(value or "").strip()
    if not text:
        return None
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def rewake_due(metadata: dict[str, Any], wake_key: str, now: float) -> bool:
    if wake_key.startswith(NO_REWAKE_PREFIXES):
        return False
    try:
        resends = int(metadata.get("gc.campaign_wake_resends") or 0)
    except (TypeError, ValueError):
        resends = 0
    if resends >= MAX_REWAKES:
        return False
    sent_at = epoch_of(metadata.get("gc.campaign_wake_sent_at"))
    progress = epoch_of(metadata.get("gc.campaign_progress_at"))
    if sent_at is not None and progress is not None and progress > sent_at + 1:
        return False  # something moved after the wake went out
    # A wake with no recorded send time predates this rule: treat it as old.
    return sent_at is None or now - sent_at >= REWAKE_SECONDS


def current_time() -> float:
    override = os.environ.get("CAMPAIGN_NOW")
    return float(override) if override else time.time()


def iso(ts: float) -> str:
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp_due(metadata: dict[str, Any], key: str, now: float) -> bool:
    value = str(metadata.get(key) or "").strip()
    if not value:
        return True
    try:
        last = datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return True
    return now - last >= HEARTBEAT_SECONDS


def ready_list() -> list[dict[str, Any]]:
    """Read every ready bead, defending against ``gc bd ready``'s silent
    page-size truncation (af-ck3xg): a page that comes back at exactly the
    default page size is not trustworthy as "the whole list" -- re-read
    unbounded (--limit 0) rather than risk hiding real work behind wisps.
    """
    ready = json_run(GC_BIN, "bd", "ready", "--json")
    if not isinstance(ready, list):
        return []
    if len(ready) >= READY_LIST_PAGE_SIZE:
        full = json_run(GC_BIN, "bd", "ready", "--json", "--limit", "0")
        if isinstance(full, list):
            return full
    return ready


def factory_lane_peek() -> dict[str, Any]:
    """Rungs 2/2b only -- a quick look at the Factory lane on its own.

    Used to give the Factory lane priority over a product materialize
    decision (ADR-0023 amendment 2) without walking the rest of the idle
    ladder (generative rungs, axis): those only fire once BOTH lanes are
    empty, via ladder_decision below.
    """
    try:
        ready = ready_list()
    except CampaignCommandError:
        return {"action": "none", "reason": "factory_lane_empty", "wake_key": None}
    try:
        queue_candidates = json_run(PRODUCT_QUEUE_BIN, "list", "--json")
    except CampaignCommandError:
        queue_candidates = None
    return plan_factory_lane(ready, queue_candidates)


def ladder_decision(metadata: dict[str, Any], now: float) -> dict[str, Any]:
    """Rungs 2-4 of the idle ladder; never raises for an unavailable store."""
    try:
        ready = ready_list()
    except CampaignCommandError as exc:
        return {"action": "none", "reason": f"ladder_unavailable: {failure_detail(exc)}",
                "wake_key": None}
    tracked = None
    tracked_id = str(metadata.get("gc.campaign_ladder_bead") or "").strip()
    if tracked_id:
        try:
            tracked = node_issue(tracked_id)
        except CampaignCommandError:
            tracked = None
    last = {rung: metadata.get(f"gc.campaign_ladder_{rung}_at")
            for rung, _ in LADDER_GENERATIVE_RUNGS}
    try:
        queue_candidates = json_run(PRODUCT_QUEUE_BIN, "list", "--json")
    except CampaignCommandError:
        # The factory-lane queue (rung 2b) is a bonus source of work, not a
        # dependency: an unavailable queue must not stop rungs 2-4 firing.
        queue_candidates = None
    # Rung 5 (docs/FACTORY_CONTINUITY.md sec4): the maintain-alive switch and
    # the improvement axes are likewise a bonus source, never a dependency --
    # an unreadable config must degrade to the ADR-0016 sec7 default
    # (maintain-alive on, no axis this tick), not stop rungs 2-4.
    maintain_alive = True
    axis = None
    try:
        axes_status = json_run(AXES_BIN, "status", "--json")
    except CampaignCommandError:
        axes_status = None
    if isinstance(axes_status, dict):
        if isinstance(axes_status.get("maintain_alive"), bool):
            maintain_alive = axes_status["maintain_alive"]
        if isinstance(axes_status.get("next_selected"), dict):
            axis = axes_status["next_selected"]
    last_axis = metadata.get("gc.campaign_ladder_axis_at")
    plan = plan_idle_ladder(
        ready, now, last, tracked, queue_candidates, maintain_alive, axis, last_axis,
    )
    unstick = plan.pop("unstick_bead", None)
    if unstick:
        # C6: best-effort, mirroring the rest of this function -- a failure
        # here must not stop the decision this tick already computed above.
        try:
            run(GC_BIN, "bd", "update", str(unstick), "--set-metadata", "gc.waiting_on=stalled")
        except CampaignCommandError:
            pass
        try:
            update_metadata({"gc.campaign_ladder_bead": ""})
        except CampaignCommandError:
            pass
    return plan


def sentinel(_: argparse.Namespace) -> None:
    global _tick_deadline
    now = current_time()
    _tick_deadline = time.monotonic() + TICK_DEADLINE_SECONDS
    issue = coordination_issue()
    metadata = issue.get("metadata") if isinstance(issue.get("metadata"), dict) else {}
    heartbeat: dict[str, str] = {}
    if stamp_due(metadata, "gc.campaign_sentinel_at", now):
        heartbeat["gc.campaign_sentinel_at"] = iso(now)
    # Without a reference point, a campaign that never advances after this code
    # ships would never be called stale: "no progress yet" forever. Record, once,
    # when watching began; liveness measures from there until real progress.
    if not str(metadata.get("gc.campaign_progress_at") or "").strip() \
            and not str(metadata.get("gc.campaign_watch_since") or "").strip():
        heartbeat["gc.campaign_watch_since"] = iso(now)
    if heartbeat:
        # Best effort: a failed heartbeat must not stop the loop it describes.
        try:
            update_metadata(heartbeat)
            metadata = {**metadata, **heartbeat}
        except CampaignCommandError:
            pass
    try:
        campaign = project_campaign_metadata(metadata)
    except StateContractError as exc:
        count = record_failure(metadata, exc)
        mode = failure_mode()
        raise CampaignCommandError(f"{mode} {count}/{FAILURE_THRESHOLD}: {failure_detail(exc)}") from exc
    if not campaign["enabled"]:
        print("NOOP: campaign inactive")
        return

    # A product decision waiting on Benjamin parks product work, never the
    # factory (ADR-0016 section 4): the ladder keeps running. Every other block
    # -- an admin window, exhausted providers, a durable failure -- stays quiet.
    ladder_only = False
    if campaign["state"] == "blocked":
        if campaign["blocker_kind"] != "decision":
            print("NOOP: campaign blocked; guarded Mayor resume required")
            return
        ladder_only = True

    if ladder_only:
        decision = ladder_decision(metadata, now)
    else:
        try:
            status = json_run(STATUS_BIN, "--json", timeout=STATUS_COMMAND_TIMEOUT)
        except CampaignCommandError as exc:
            count = record_failure(metadata, exc)
            mode = failure_mode()
            raise CampaignCommandError(f"{mode} {count}/{FAILURE_THRESHOLD}: {failure_detail(exc)}") from exc

        try:
            decision = plan_transition(status)
        except CampaignDecisionError as exc:
            node_id = status_node_id(status)
            if node_id:
                try:
                    count = record_node_failure(node_id, exc)
                except CampaignCommandError:
                    node_id = None
                else:
                    mode = "automatic retry" if count < FAILURE_THRESHOLD else "node quarantined"
                    raise CampaignCommandError(
                        f"{mode} {count}/{FAILURE_THRESHOLD} on {node_id}: {failure_detail(exc)}"
                    ) from exc
            count = record_failure(metadata, exc)
            mode = failure_mode()
            raise CampaignCommandError(f"{mode} {count}/{FAILURE_THRESHOLD}: {failure_detail(exc)}") from exc

        if campaign["failure_count"] or campaign["last_error"]:
            update_metadata({"gc.campaign_failure_count": "0", "gc.campaign_failure_since": "",
                             "gc.campaign_last_error": ""})
            issue, campaign = coordination()
            metadata = issue.get("metadata", {})
            # The status we just read was projected while the failure counter
            # was still set, so it reports a transient-failure retry instead of
            # the real product state. Acting on it is acting blind: on
            # 2026-09-16 it hid a result awaiting finalization and the idle
            # ladder dispatched Factory work over it. Clear the counter and let
            # the next tick, a minute later, see the truth.
            if (status.get("campaign") or {}).get("blocker_kind") == "transient_failure":
                print("NOOP: recovered from a transient failure; re-reading next tick")
                return

        if (
            decision["action"] == "wake_mayor"
            and decision["reason"] == "materialize_next"
            and priority_lane_of(metadata) == "factory"
        ):
            # ADR-0023 amendment 2: while the Factory lane is priority, it is
            # checked before a product materialize decision, not only after
            # one -- WHILE the priority lane has an eligible candidate, THE
            # mayor-campaign SHALL process it before any other lane.
            factory_plan = factory_lane_peek()
            if factory_plan["action"] == "wake_mayor":
                decision = factory_plan

        if decision["action"] != "wake_mayor" and decision["reason"] not in LADDER_SKIPPED_REASONS:
            # No product work to do is not inactivity: walk the ladder.
            decision = ladder_decision(metadata, now)

    if decision["action"] == "wake_mayor":
        candidate_id = factory_candidate_id(decision)
        if candidate_id:
            try:
                fresh = node_issue(candidate_id)
            except CampaignCommandError:
                fresh = None
            if isinstance(fresh, dict) and fresh.get("status") == "closed":
                # Stale by the time we're about to notify: don't page the
                # Mayor about a candidate that no longer exists to claim.
                # The next tick re-derives from a fresh read and picks
                # whatever real candidate remains.
                decision = {"action": "none", "reason": "factory_candidate_closed", "wake_key": None}

    if decision["action"] != "wake_mayor":
        updates: dict[str, str] = {}
        if campaign["wake_state"] == "sent" and (
            decision["reason"] in {"active_delivery", "automatic_dependency"}
            or wake_target_resolved(campaign["wake_key"])
        ):
            updates.update({"gc.campaign_wake_key": "", "gc.campaign_wake_state": "none"})
        if decision["reason"] in PROGRESS_REASONS and stamp_due(metadata, "gc.campaign_progress_at", now):
            updates["gc.campaign_progress_at"] = iso(now)
        if updates:
            update_metadata(updates)
        print(f"NOOP: {decision['reason']}")
        return

    wake_key = str(decision["wake_key"])
    reminder = False
    if campaign["wake_key"] == wake_key and campaign["wake_state"] == "sent":
        if not rewake_due(metadata, wake_key, now):
            # Re-announcing the same thing is not progress. If the Mayor never
            # acts on it, the liveness watchdog is what notices.
            print(f"NOOP: already notified {wake_key}")
            return
        reminder = True
    if campaign["wake_state"] == "pending" and campaign["wake_key"] != wake_key:
        count = record_failure(
            metadata,
            CampaignCommandError(
                f"La transition pending {campaign['wake_key']} diffère de la transition due {wake_key}."
            ),
        )
        raise CampaignCommandError(
            f"automatic retry {count}/{FAILURE_THRESHOLD}: transition pending incohérente"
        )

    subject = str(decision["subject"])
    message = str(decision["message"])
    try:
        resends = int(metadata.get("gc.campaign_wake_resends") or 0)
    except (TypeError, ValueError):
        resends = 0
    if reminder:
        subject = f"RAPPEL {resends + 1}/{MAX_REWAKES} · {subject}"
        message = (
            "Rappel automatique : cette transition t'a déjà été envoyée et rien n'a avancé "
            "depuis. Si ta session a redémarré, tu ne l'as peut-être jamais vue. "
            + message
        )
        if decision["reason"] in PRODUCT_WAKE_REASONS:
            # A product wake stale enough to earn a reminder is not "product
            # work under way" any more: bundle one Factory wake into the same
            # mail rather than redesign the single wake_key/wake_state pair
            # on the coordination bead to track two simultaneous wakes.
            ladder = ladder_decision(metadata, now)
            if ladder["action"] == "wake_mayor":
                message += (
                    "\n\nEN PARALLÈLE (échelle d'inactivité, ADR-0016 §7) : cette relance "
                    "produit est restée sans effet depuis plus de 30 minutes, donc ce n'est "
                    f"pas de l'inactivité factory non plus : {ladder['message']}"
                )
        # C9: persist before send, not after. A kill between a successful send
        # and the counter update (2026-09-16 incident pattern) left the sentinel
        # thinking the reminder never went out, so it re-sent the same reminder
        # every following tick. Persisting first means a kill can at worst waste
        # one already-counted resend, never spin forever. A reminder is an
        # action, not progress: liveness must still see the first wake achieved
        # nothing, so gc.campaign_progress_at is deliberately not touched here.
        update_metadata({
            "gc.campaign_wake_sent_at": iso(now),
            "gc.campaign_wake_resends": str(resends + 1),
        })
    elif campaign["wake_state"] != "pending":
        update_metadata({"gc.campaign_wake_key": wake_key, "gc.campaign_wake_state": "pending"})
    try:
        run(
            GC_BIN, "mail", "send", "mayor", "--from", "mayor",
            "--subject", subject, "--message", message,
            "--notify", "--json",
        )
    except CampaignCommandError as exc:
        latest_issue = coordination_issue()
        latest_metadata = latest_issue.get("metadata") if isinstance(latest_issue.get("metadata"), dict) else {}
        count = record_failure(latest_metadata, exc)
        mode = failure_mode()
        raise CampaignCommandError(f"{mode} {count}/{FAILURE_THRESHOLD}: {failure_detail(exc)}") from exc
    if reminder:
        print(f"REMINDED: mayor — {wake_key} ({resends + 1}/{MAX_REWAKES})")
        return
    sent = {
        "gc.campaign_wake_key": wake_key,
        "gc.campaign_wake_state": "sent",
        "gc.campaign_wake_sent_at": iso(now),
        "gc.campaign_wake_resends": "0",
    }
    # C5: telling the Mayor something new is not the Mayor doing something.
    # Stamping progress here meant that mere wake-key churn -- the product
    # queue's head candidate changing, a fresh Factory bead being picked --
    # reset the 60-minute liveness clock with nothing having actually
    # advanced. Real progress is stamped elsewhere, from real events: the
    # PROGRESS_REASONS NOOP path (delivery in flight, a dependency pending,
    # a claimed Factory bead) and, later, bead-closed/PR-merged events.
    rung = decision.get("rung")
    if rung == "factory":
        sent["gc.campaign_ladder_bead"] = str(decision.get("ladder_bead") or "")
    elif rung:
        sent[f"gc.campaign_ladder_{rung}_at"] = iso(now)
    update_metadata(sent)
    print(f"NOTIFIED: mayor — {wake_key}")


def status(_: argparse.Namespace) -> None:
    value = json_run(STATUS_BIN, "--json", timeout=STATUS_COMMAND_TIMEOUT)
    print(json.dumps(value["campaign"], ensure_ascii=False, separators=(",", ":")))


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(prog=PROGRAM)
    commands = value.add_subparsers(dest="command", required=True)
    commands.add_parser("status", help="print the read-only canonical campaign state").set_defaults(handler=status)
    commands.add_parser("sentinel", help="run the zero-token Mayor notification sentinel").set_defaults(handler=sentinel)

    activate_parser = commands.add_parser("activate", help="activate an already materialized campaign")
    activate_parser.add_argument("candidate")
    activate_parser.add_argument("execution")
    activate_parser.add_argument("--mayor", dest="authority", action="store_true")
    activate_parser.add_argument("--condition", default=DEFAULT_CONDITION)
    activate_parser.set_defaults(handler=activate)

    block_parser = commands.add_parser("block", help="persist an exact campaign blocker")
    block_parser.add_argument("--kind", required=True, choices=("decision", "admin", "durable_failure", "limit", "result_blocker", "all_paused"))
    block_parser.add_argument("--cause", required=True)
    block_parser.add_argument("--owner", required=True, choices=("Mayor", "Benjamin"))
    block_parser.add_argument("--action", required=True)
    block_parser.add_argument("--mayor", dest="authority", action="store_true")
    block_parser.set_defaults(handler=block)

    resume_parser = commands.add_parser("resume", help="resume after the recorded blocker is lifted")
    resume_parser.add_argument("--mayor", dest="authority", action="store_true")
    resume_parser.set_defaults(handler=resume)

    complete_parser = commands.add_parser("complete", help="record an empty eligible queue")
    complete_parser.add_argument("--mayor", dest="authority", action="store_true")
    complete_parser.set_defaults(handler=complete)

    repair_parser = commands.add_parser(
        "repair", help="restore a missing campaign candidate/condition, or block if unrecoverable (ADR-0023)"
    )
    repair_parser.add_argument("--mayor", dest="authority", action="store_true")
    repair_parser.set_defaults(handler=repair)

    priority_parser = commands.add_parser(
        "priority", help="get or set which lane (factory|product) is priority (ADR-0023)"
    )
    priority_parser.add_argument("lane", nargs="?", choices=PRIORITY_LANES)
    priority_parser.set_defaults(handler=priority)
    return value


def main() -> int:
    try:
        args = parser().parse_args()
        if args.command == "status":
            args.handler(args)
        else:
            LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
            with LOCK_PATH.open("a+", encoding="utf-8") as lock:
                fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
                args.handler(args)
        return 0
    except TickDeadlineExceeded as exc:
        # C8: a killed tick used to leave no trace at all (31 in 24h, live).
        # Record it best-effort -- lift the deadline first, or this recovery
        # write would immediately raise the same error it is reporting.
        global _tick_deadline
        _tick_deadline = None
        try:
            run(GC_BIN, "bd", "update", COORDINATION_BEAD,
                "--set-metadata", f"gc.campaign_last_tick_timeout={iso(current_time())}")
        except CampaignCommandError:
            pass
        print(f"{PROGRAM}: TICK_TIMEOUT: {exc}", file=sys.stderr)
        return 1
    except CampaignCommandError as exc:
        print(f"{PROGRAM}: ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
