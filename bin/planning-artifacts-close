#!/usr/bin/env bash
# planning-artifacts-close — closes the Spec bead and the Ticket Graph Draft
# bead a convoy was published from, when that convoy itself closes (W06,
# A6b).
#
# ticket-graph-publish's bead mode (W05) reads the Ticket Graph Draft from a
# planning-plane bead bound to an approved Spec bead, and stamps the convoy
# (and every ticket) with gc.artifact_id (the Draft bead's own id) and
# gc.spec_id (the Spec bead's id) -- real Beads ids `bd show` resolves. The
# older file-draft mode stamps the same two metadata keys with artifact/spec
# identifier STRINGS from a draft YAML file (e.g.
# "ticket-graph-draft-a6b-wayfinder-wiring"), which never resolve to a bead.
#
# Both the Spec bead and the Draft bead stay open and readable for the whole
# delivery -- an in-flight worker or reviewer reads them for Spec fidelity.
# Only a genuinely closed convoy closes them, with a reason naming the
# convoy, and the close is idempotent (an already-closed target is skipped).
#
# A convoy published from a file draft is left untouched, without error:
# `bd show` on its artifact/spec id does not resolve to that id, so this
# script skips it silently.
#
# A convoy that carries the new-flow mark closes only by the acceptance or
# the abandon command (T22, af-kn83no; Spec af-wf4w5r §9). One that
# bin/convoy-state lists as closed outside them is an anomaly the advance
# pass raises to the operator: its Spec and its Draft stay open with it. If
# the state command cannot answer, nothing is closed and the run fails.
#
# The order runs on every bead close under a 60 s timeout, and one tracker
# call costs seconds on a busy host: every artifact/spec id of the run is
# resolved in ONE `bd show`, never one call per id (af-nybppo: two calls per
# closed convoy outran the timeout once five convoys had closed).
#
# Usage: planning-artifacts-close [--check-only]
set -uo pipefail

PROGRAM_NAME="planning-artifacts-close"
ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
GC_BIN="${GC_BIN:-gc}"
CONVOY_STATE_BIN="${CONVOY_STATE_BIN:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/convoy-state}"
CHECK_ONLY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) CHECK_ONLY=1 ;;
    -h|--help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "$PROGRAM_NAME: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

require_command() {
  command -v "$1" >/dev/null 2>&1 || { echo "$PROGRAM_NAME: required command unavailable: $1" >&2; exit 2; }
}
require_command "$GC_BIN"
require_command jq

say() { printf '%s\n' "$*"; }

CLOSED=0
SKIPPED=0
FAILED=0

# id -> status and assignee of every artifact/spec id that resolves to a
# bead, filled by one tracker call (resolve_all).
declare -A BEAD_STATUS=()
declare -A BEAD_ASSIGNEE=()

resolve_all() {  # id...
  [ $# -gt 0 ] || return 0
  local show_json id status assignee
  # Ids that resolve come back as one array; the others are only missing
  # from it (none at all: an error object, exit 1).
  show_json=$(cd "$ROOT" && "$GC_BIN" bd show "$@" --json 2>/dev/null)
  # \x1f, not a tab: a tab is IFS whitespace, so an empty field would be
  # merged into its neighbour.
  while IFS=$'\x1f' read -r id status assignee; do
    [ -n "$id" ] || continue
    BEAD_STATUS[$id]=$status
    BEAD_ASSIGNEE[$id]=$assignee
  done < <(jq -r 'if type == "array" then .[] | select(type == "object" and (.id | type) == "string") | [.id, (.status // ""), (.assignee // "")] | join("\u001f") else empty end' <<<"$show_json" 2>/dev/null)
}

resolve_and_close() {  # id convoy_id convoy_title
  local id=$1 convoy_id=$2 convoy_title=$3
  [ -n "$id" ] || return 0

  if [ -z "${BEAD_STATUS[$id]+set}" ]; then
    say "  · $id does not resolve to a bead (file-draft artifact/spec id) -- left untouched"
    return 0
  fi
  local status=${BEAD_STATUS[$id]}

  if [ "$status" = "closed" ]; then
    SKIPPED=$((SKIPPED + 1))
    return 0
  fi

  if [ "$CHECK_ONLY" = "1" ]; then
    say "  would close $id (status=$status) -- convoy $convoy_id ($convoy_title) closed"
    return 0
  fi

  # A Spec bead stays claimed by an operator session through delivery, and
  # Beads 1.3 refuses `bd close` to any actor but the assignee (af-bm9y90).
  # The closed convoy is the authority to close the bead whoever holds it: a
  # held bead is first released from the holder read above, and from that
  # one only (--if-assignee; another holder by now: nothing is written, the
  # close below is refused, and the next run reads the bead again).
  local holder=${BEAD_ASSIGNEE[$id]} refusal
  if [ -n "$holder" ]; then
    refusal=$(cd "$ROOT" && "$GC_BIN" bd update "$id" --if-assignee "$holder" --assignee "" \
      --append-notes "Released from $holder to be closed: convoy $convoy_id closed" 2>&1 >/dev/null) \
      || say "  · $id was not released from $holder: $(tr '\n' ' ' <<<"$refusal")"
  fi
  if (cd "$ROOT" && "$GC_BIN" bd close "$id" --reason "Convoy $convoy_id ($convoy_title) closed" >/dev/null 2>&1); then
    CLOSED=$((CLOSED + 1))
    BEAD_STATUS[$id]=closed
    say "  closed $id -- convoy $convoy_id ($convoy_title) closed"
  else
    FAILED=$((FAILED + 1))
    say "  ! $id could not be closed"
  fi
}

convoys=$(cd "$ROOT" && "$GC_BIN" bd list --all --type convoy --status closed --has-metadata-key gc.artifact_id --limit 0 --json 2>/dev/null)
jq -e . >/dev/null 2>&1 <<<"$convoys" || convoys='[]'

# The mark is read by the state command only (bin/convoy-state).
closed_outside=$(cd "$ROOT" && GC_BIN="$GC_BIN" "$CONVOY_STATE_BIN" list 2>/dev/null \
  | jq -r 'if .ok == true and (.closed_outside | type) == "array" then .closed_outside[] else error("no answer") end' 2>/dev/null) || {
  echo "$PROGRAM_NAME: $CONVOY_STATE_BIN list could not tell which closed convoys carry the new-flow mark -- nothing closed" >&2
  exit 1
}

rows=$(jq -r '
  .[] | [.id, .title, (.metadata["gc.artifact_id"] // ""), (.metadata["gc.spec_id"] // "")] | @tsv
' <<<"$convoys")

# Only the ids this run may close are looked up. An id that begins with a
# dash would be read as an option of the one call, so it is left out: it
# names no bead.
lookup_ids=()
while IFS=$'\t' read -r convoy_id convoy_title artifact_id spec_id; do
  [ -z "$convoy_id" ] && continue
  grep -qxF -- "$convoy_id" <<<"$closed_outside" && continue
  for id in "$artifact_id" "$spec_id"; do
    case "$id" in ''|-*) ;; *) lookup_ids+=("$id") ;; esac
  done
done <<<"$rows"
resolve_all "${lookup_ids[@]+"${lookup_ids[@]}"}"

while IFS=$'\t' read -r convoy_id convoy_title artifact_id spec_id; do
  [ -z "$convoy_id" ] && continue
  if grep -qxF -- "$convoy_id" <<<"$closed_outside"; then
    say "  · convoy $convoy_id ($convoy_title) carries the new-flow mark and was closed outside acceptance or abandon -- its Spec and Draft stay open"
    continue
  fi
  resolve_and_close "$artifact_id" "$convoy_id" "$convoy_title"
  resolve_and_close "$spec_id" "$convoy_id" "$convoy_title"
done <<<"$rows"

say ""
say "$PROGRAM_NAME: closed=$CLOSED skipped=$SKIPPED failed=$FAILED"
[ "$FAILED" -eq 0 ]
