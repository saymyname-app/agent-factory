#!/usr/bin/env python3
"""Smallest concurrency mechanism for independent Planning Decision claims,
child resolution and shared Planning Map updates (P03).

Same scope discipline as `planning-allocation-prototype` (P02),
`planning-run-resume-oracle` (P04) and `role-qualification-oracle` (P06):
this is a bounded, deterministic scenario over declared evidence, not a live
multi-provider load test or a production concurrency controller. P02
explicitly left "concurrent Planning Map writes" unproven; this prototype
closes that gap at the same evidence-bound level, by replaying a scripted
adversarial interleaving of claim and map-write operations (rather than real
OS threads) so results stay byte-identical across runs.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path
from typing import Any


PROGRAM = "planning-map-concurrency-prototype"
CONTRACT = "agent-factory-planning-map-concurrency-prototype/v1"
RESULT_CONTRACT = "agent-factory-planning-map-concurrency-result/v1"
ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MANIFEST = ROOT / "config" / "planning-map-concurrency-prototype.json"

CLAIM_OPS = ("claim",)
MAP_OPS = ("read", "write", "retry")
COMPUTE_KINDS = ("set_value", "merge_add")


class PrototypeError(RuntimeError):
    pass


def require_dict(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise PrototypeError(f"{label} must be an object")
    return value


def require_list(value: Any, label: str) -> list[Any]:
    if not isinstance(value, list):
        raise PrototypeError(f"{label} must be an array")
    return value


def require_string(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise PrototypeError(f"{label} must be a non-empty string")
    return value


def canonical_digest(value: Any) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def load_manifest(path: Path) -> dict[str, Any]:
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise PrototypeError(f"manifest not found: {path}") from exc
    except json.JSONDecodeError as exc:
        raise PrototypeError(f"manifest is not valid JSON: {exc}") from exc
    return require_dict(raw, "manifest")


# --- Manifest validation -----------------------------------------------


def validate_decision(decision: dict[str, Any]) -> dict[str, Any]:
    require_dict(decision, "decision")
    require_string(decision.get("id"), "decision.id")
    require_string(decision.get("map_key"), "decision.map_key")
    require_string(decision.get("value"), "decision.value")
    return decision


def validate_manifest(manifest: dict[str, Any]) -> dict[str, Any]:
    contract = require_string(manifest.get("contract"), "manifest.contract")
    if contract != CONTRACT:
        raise PrototypeError(f"unsupported manifest contract: {contract}")

    decisions_raw = require_list(manifest.get("decisions"), "manifest.decisions")
    if len(decisions_raw) < 2:
        raise PrototypeError(
            "manifest.decisions must declare at least two decisions to prove "
            "independent progress"
        )
    decisions = {d["id"]: validate_decision(d) for d in (validate_decision(d) for d in decisions_raw)}
    if len(decisions) != len(decisions_raw):
        raise PrototypeError("manifest.decisions must have unique ids")

    map_keys = [d["map_key"] for d in decisions.values()]
    if len(set(map_keys)) != len(map_keys):
        raise PrototypeError("every decision must own a disjoint map_key")

    shared_index_key = require_string(
        manifest.get("shared_index_key"), "manifest.shared_index_key"
    )
    if shared_index_key in map_keys:
        raise PrototypeError(
            "shared_index_key must not collide with a decision's own disjoint map_key"
        )

    claim_race = require_dict(manifest.get("claim_race"), "manifest.claim_race")
    if set(claim_race) != set(decisions):
        raise PrototypeError("manifest.claim_race must declare exactly one entry per decision")
    for decision_id, claimants in claim_race.items():
        require_list(claimants, f"claim_race[{decision_id}]")
        if len(claimants) < 2:
            raise PrototypeError(
                f"claim_race[{decision_id}] must declare at least two racing claimants"
            )
        if len(set(claimants)) != len(claimants):
            raise PrototypeError(f"claim_race[{decision_id}] claimants must be unique")

    interleaving = require_list(manifest.get("interleaving"), "manifest.interleaving")
    if len(interleaving) < 2:
        raise PrototypeError("manifest.interleaving must declare at least two operations")
    all_claimants = {c for claimants in claim_race.values() for c in claimants}
    valid_keys = set(map_keys) | {shared_index_key}
    for index, op in enumerate(interleaving):
        require_dict(op, f"interleaving[{index}]")
        kind = require_string(op.get("op"), f"interleaving[{index}].op")
        if kind not in CLAIM_OPS + MAP_OPS:
            raise PrototypeError(f"interleaving[{index}].op '{kind}' is not a recognised operation")
        if kind == "claim":
            decision_id = require_string(op.get("decision_id"), f"interleaving[{index}].decision_id")
            if decision_id not in decisions:
                raise PrototypeError(f"interleaving[{index}] references undeclared decision '{decision_id}'")
            claimant = require_string(op.get("claimant"), f"interleaving[{index}].claimant")
            if claimant not in claim_race[decision_id]:
                raise PrototypeError(
                    f"interleaving[{index}] claimant '{claimant}' is not a declared racer for '{decision_id}'"
                )
        else:
            actor = require_string(op.get("writer") if kind != "read" else op.get("reader"),
                                    f"interleaving[{index}].{'reader' if kind == 'read' else 'writer'}")
            if actor not in all_claimants:
                raise PrototypeError(f"interleaving[{index}] actor '{actor}' is not a declared claimant")
            key = require_string(op.get("key"), f"interleaving[{index}].key")
            if key not in valid_keys:
                raise PrototypeError(f"interleaving[{index}] references undeclared key '{key}'")
            if kind in ("write", "retry"):
                compute = require_string(op.get("compute"), f"interleaving[{index}].compute")
                if compute not in COMPUTE_KINDS:
                    raise PrototypeError(f"interleaving[{index}].compute '{compute}' is not recognised")
                require_string(op.get("value"), f"interleaving[{index}].value")

    singular_writers = require_list(manifest.get("singular_writers"), "manifest.singular_writers")
    for writer in singular_writers:
        require_string(writer, "singular_writers entry")
    concurrent_map_writers = require_list(
        manifest.get("concurrent_map_writers"), "manifest.concurrent_map_writers"
    )
    for writer in concurrent_map_writers:
        require_string(writer, "concurrent_map_writers entry")
    if set(concurrent_map_writers) != set(decisions):
        raise PrototypeError(
            "manifest.concurrent_map_writers must equal the declared decision ids exactly"
        )
    if set(singular_writers) & set(concurrent_map_writers):
        raise PrototypeError(
            "singular_writers (Spec/Ticket Graph Draft) must never overlap concurrent_map_writers"
        )

    return {
        "decisions": decisions,
        "shared_index_key": shared_index_key,
        "claim_race": claim_race,
        "interleaving": interleaving,
        "singular_writers": singular_writers,
        "concurrent_map_writers": concurrent_map_writers,
    }


# --- Concurrency primitives ----------------------------------------------


class ClaimLedger:
    """First-writer-wins claim store: a decision is claimed at most once."""

    def __init__(self) -> None:
        self._claims: dict[str, str] = {}

    def claim(self, decision_id: str, claimant: str) -> bool:
        if decision_id in self._claims:
            return False
        self._claims[decision_id] = claimant
        return True

    def winner(self, decision_id: str) -> str | None:
        return self._claims.get(decision_id)


class VersionedMap:
    """Optimistic-concurrency (compare-and-swap) shared Planning Map."""

    def __init__(self) -> None:
        self._entries: dict[str, dict[str, Any]] = {}

    def read(self, key: str) -> dict[str, Any]:
        return dict(self._entries.get(key, {"value": None, "version": 0}))

    def apply(self, key: str, value: Any, expected_version: int) -> bool:
        current = self._entries.get(key, {"value": None, "version": 0})
        if current["version"] != expected_version:
            return False
        self._entries[key] = {"value": value, "version": expected_version + 1}
        return True

    def snapshot(self) -> dict[str, Any]:
        return {key: entry["value"] for key, entry in self._entries.items()}


def compute_new_value(compute: str, cached_value: Any, addend: str) -> Any:
    if compute == "set_value":
        return addend
    if compute == "merge_add":
        current = list(cached_value) if isinstance(cached_value, list) else []
        merged = sorted(set(current) | {addend})
        return merged
    raise PrototypeError(f"unknown compute kind '{compute}'")


# --- Stress: adversarial claim-order permutations ------------------------


def rotations(items: list[str]) -> list[list[str]]:
    orders = [list(items), list(reversed(items))]
    for shift in range(1, len(items)):
        orders.append(items[shift:] + items[:shift])
    # de-duplicate while preserving order
    seen: list[list[str]] = []
    for order in orders:
        if order not in seen:
            seen.append(order)
    return seen


def stress_claim_races(claim_race: dict[str, list[str]]) -> dict[str, Any]:
    per_decision: dict[str, Any] = {}
    all_exactly_once = True
    all_first_writer_wins = True
    for decision_id, claimants in claim_race.items():
        orders_tried = rotations(claimants)
        outcomes = []
        for order in orders_tried:
            ledger = ClaimLedger()
            successes = [ledger.claim(decision_id, claimant) for claimant in order]
            success_count = sum(successes)
            winner = ledger.winner(decision_id)
            exactly_once = success_count == 1
            first_writer_wins = winner == order[0]
            all_exactly_once = all_exactly_once and exactly_once
            all_first_writer_wins = all_first_writer_wins and first_writer_wins
            outcomes.append(
                {
                    "order": order,
                    "success_count": success_count,
                    "winner": winner,
                    "exactly_once": exactly_once,
                    "first_writer_wins": first_writer_wins,
                }
            )
        per_decision[decision_id] = {
            "orders_tried": len(orders_tried),
            "outcomes": outcomes,
        }
    return {
        "per_decision": per_decision,
        "every_order_claimed_exactly_once": all_exactly_once,
        "every_order_first_writer_wins": all_first_writer_wins,
    }


# --- Interleaving replay ---------------------------------------------------


def replay_interleaving(validated: dict[str, Any]) -> dict[str, Any]:
    decisions = validated["decisions"]
    map_key_to_decision = {d["map_key"]: d["id"] for d in decisions.values()}
    ledger = ClaimLedger()
    shared_map = VersionedMap()
    cached_reads: dict[tuple[str, str], dict[str, Any]] = {}

    claim_log: list[dict[str, Any]] = []
    write_log: list[dict[str, Any]] = []
    winner_violations: list[str] = []
    op_context: list[str] = []  # decision ids touched, in op order, for interleaving evidence

    for index, op in enumerate(validated["interleaving"]):
        kind = op["op"]
        if kind == "claim":
            decision_id = op["decision_id"]
            claimant = op["claimant"]
            succeeded = ledger.claim(decision_id, claimant)
            claim_log.append(
                {"index": index, "decision_id": decision_id, "claimant": claimant, "succeeded": succeeded}
            )
            op_context.append(decision_id)
            continue

        key = op["key"]
        if kind == "read":
            reader = op["reader"]
            cached_reads[(reader, key)] = shared_map.read(key)
            continue

        writer = op["writer"]
        compute = op["compute"]
        addend = op["value"]

        if kind == "retry":
            # A caller retrying after rejection always re-reads first.
            cached_reads[(writer, key)] = shared_map.read(key)
        cached = cached_reads.get((writer, key)) or shared_map.read(key)

        # AC2 guard: a decision's own map_key may only be written by its claim winner.
        target_decision = map_key_to_decision.get(key)
        if target_decision is not None:
            op_context.append(target_decision)
            winner = ledger.winner(target_decision)
            if winner != writer:
                winner_violations.append(
                    f"op[{index}]: '{writer}' wrote '{key}' without being the claim winner "
                    f"(winner={winner})"
                )

        new_value = compute_new_value(compute, cached["value"], addend)
        applied = shared_map.apply(key, new_value, cached["version"])
        if applied:
            cached_reads[(writer, key)] = shared_map.read(key)
        write_log.append(
            {
                "index": index,
                "op": kind,
                "writer": writer,
                "key": key,
                "compute": compute,
                "applied": applied,
            }
        )

    return {
        "claim_log": claim_log,
        "write_log": write_log,
        "winner_violations": winner_violations,
        "op_context": op_context,
        "final_map": shared_map.snapshot(),
        "ledger_winners": {d: ledger.winner(d) for d in decisions},
    }


def interleaving_is_alternating(op_context: list[str]) -> bool:
    """At least one op for every other decision appears between two ops of
    a given decision -- structural evidence the script did not serialize one
    decision's full lifecycle before starting the other."""
    distinct = set(op_context)
    if len(distinct) < 2:
        return False
    for decision_id in distinct:
        positions = [i for i, d in enumerate(op_context) if d == decision_id]
        others_between = any(
            op_context[i] != decision_id
            for i in range(positions[0], positions[-1] + 1)
        )
        if not others_between:
            return False
    return True


def run_prototype(manifest: dict[str, Any]) -> dict[str, Any]:
    validated = validate_manifest(manifest)
    decisions = validated["decisions"]

    claim_stress = stress_claim_races(validated["claim_race"])
    replay = replay_interleaving(validated)

    each_claimed_exactly_once = all(
        sum(1 for c in replay["claim_log"] if c["decision_id"] == d and c["succeeded"]) == 1
        for d in decisions
    )

    disjoint_ok = all(
        replay["final_map"].get(d["map_key"]) == d["value"] for d in decisions.values()
    )

    rejected_writes = [w for w in replay["write_log"] if w["op"] == "write" and not w["applied"]]
    retried_and_applied = [
        w for w in replay["write_log"] if w["op"] == "retry" and w["applied"]
    ]
    shared_index_final = replay["final_map"].get(validated["shared_index_key"]) or []
    expected_index_members = sorted(
        {
            w["writer"]
            for w in replay["write_log"]
            if w["key"] == validated["shared_index_key"] and w["compute"] == "merge_add"
        }
    )
    # writers are claimants; the merge target is the decision id, so compare
    # via the claim ledger's winners rather than raw claimant names.
    winner_to_decision = {winner: d for d, winner in replay["ledger_winners"].items() if winner}
    expected_decision_ids = sorted(
        {winner_to_decision.get(w, w) for w in expected_index_members}
    )
    no_lost_updates = (
        set(shared_index_final) == set(expected_decision_ids)
        and len(rejected_writes) > 0
        and len(retried_and_applied) > 0
        and all(w["applied"] for w in retried_and_applied)
    )

    singular_isolated = (
        not (set(validated["singular_writers"]) & set(validated["concurrent_map_writers"]))
        and not (set(validated["singular_writers"]) & set(decisions))
    )

    concurrent_progress = interleaving_is_alternating(replay["op_context"]) and all(
        replay["final_map"].get(d["map_key"]) == d["value"] for d in decisions.values()
    )

    acceptance = {
        "two_independent_decisions_progress_concurrently": {
            "value": concurrent_progress,
            "reason": (
                "the interleaving script alternates operations between decisions "
                "and both fully claim and resolve within the single pass, with no "
                "shared lock scoping one decision's critical section over another's."
            ),
        },
        "each_child_claimed_and_resolved_exactly_once": {
            "value": each_claimed_exactly_once and not replay["winner_violations"],
            "reason": (
                f"claim successes per decision are each 1; violations={replay['winner_violations']}"
            ),
        },
        "conflicting_shared_map_updates_preserve_or_retry": {
            "value": disjoint_ok and no_lost_updates,
            "reason": (
                f"disjoint per-decision keys preserved={disjoint_ok}; shared index "
                f"reflects {sorted(shared_index_final)} after "
                f"{len(rejected_writes)} CAS rejection(s) and "
                f"{len(retried_and_applied)} successful retry/retries -- no update lost."
            ),
        },
        "spec_and_ticket_graph_draft_writers_remain_singular": {
            "value": singular_isolated,
            "reason": (
                f"singular_writers={sorted(validated['singular_writers'])} never overlaps "
                f"concurrent_map_writers={sorted(validated['concurrent_map_writers'])}."
            ),
        },
        "claim_race_exactly_once_under_every_arrival_order": {
            "value": claim_stress["every_order_claimed_exactly_once"]
            and claim_stress["every_order_first_writer_wins"],
            "reason": (
                "every declared arrival-order rotation of racing claimants produced "
                "exactly one success, always the first arrival in that order."
            ),
        },
    }

    result = {
        "contract": RESULT_CONTRACT,
        "decisions": sorted(decisions),
        "claim_stress": claim_stress,
        "interleaving_replay": {
            "claim_log": replay["claim_log"],
            "write_log": replay["write_log"],
            "final_map": replay["final_map"],
        },
        "singular_writers": sorted(validated["singular_writers"]),
        "concurrent_map_writers": sorted(validated["concurrent_map_writers"]),
        "reversal": bounded_reversal(validated, replay),
        "proof_scope": {
            "target": (
                "live concurrent Planning Decision sessions writing a shared Planning "
                "Map through the real Beads/Dolt-backed work graph."
            ),
            "configured": (
                "two disjoint-key decisions, a shared merge-accumulator index key, a "
                "racing-claimant list per decision, and one adversarial interleaving "
                "script in "
                "config/planning-map-concurrency-prototype.json."
            ),
            "observed": (
                "the deterministic claim-race stress across every arrival-order "
                "rotation, and the single scripted interleaving replay, reproduced "
                "identically on every run."
            ),
            "proven": (
                "within this synthetic scenario: exactly-once first-writer-wins "
                "claim semantics under any arrival order, disjoint-key writes never "
                "collide, and a genuinely conflicting shared-key write is rejected "
                "for safe retry and recovered without loss on retry."
            ),
            "not_proven": [
                "real OS-thread or multi-process concurrency and its scheduling",
                "live Beads/Dolt backend transaction and lock behavior",
                "network partition or crash-during-claim recovery",
                "production-scale claimant counts or map key cardinality",
            ],
        },
        "acceptance": acceptance,
        "acceptance_met": all(item["value"] for item in acceptance.values()),
    }
    result["result_digest"] = canonical_digest(result)
    return result


def bounded_reversal(validated: dict[str, Any], replay: dict[str, Any]) -> dict[str, Any]:
    decisions = sorted(validated["decisions"])
    return {
        "checkpoint": "PLANNING_MAP_CONCURRENCY_INTRODUCED",
        "from": "single-global-lock-serializes-all-decision-children",
        "to": "per-decision-claim-plus-per-key-CAS",
        "unchanged": [
            "Planning Run identity",
            "Planning Map identity",
            "resolved Planning Decisions",
            "Spec and Ticket Graph Draft singular writers",
        ],
        "changed": [
            "claim path: from one mutex guarding every decision to a first-writer-wins "
            "claim entry per decision id",
            "map-update path: from unconditional last-write-wins to compare-and-swap "
            "with disjoint per-decision keys and merge-on-retry for the shared index",
        ],
        "reverse_procedure": (
            "wrap ClaimLedger.claim and VersionedMap.apply in one process-wide mutex, "
            "serializing every decision child's claim and map write; this loses "
            "concurrent progress across decisions but keeps exactly-once claim and "
            "zero-lost-update guarantees, since a single serialization point trivially "
            "satisfies both."
        ),
        "rule": (
            "keep the per-decision/per-key mechanism only while the claim-race stress "
            "shows exactly-once claims under every arrival order and the interleaving "
            "replay shows zero lost shared-map updates; revert to the single global "
            "lock the moment either invariant fails on any declared scenario."
        ),
        "final_map_at_reversal_boundary": replay["final_map"],
    }


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog=PROGRAM)
    parser.add_argument(
        "--manifest",
        type=Path,
        default=DEFAULT_MANIFEST,
        help="path to the planning-map-concurrency-prototype manifest",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("validate", help="validate the manifest and exit")
    subparsers.add_parser("run", help="run the prototype and print the deterministic result")

    args = parser.parse_args(argv)

    try:
        manifest = load_manifest(args.manifest)
        if args.command == "validate":
            validate_manifest(manifest)
            print("OK")
            return 0
        if args.command == "run":
            result = run_prototype(manifest)
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0 if result["acceptance_met"] else 1
    except PrototypeError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return 1

    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
