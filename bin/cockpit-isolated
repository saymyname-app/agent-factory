#!/usr/bin/env python3
"""cockpit-isolated — the launch recipe of the cockpit (T01R4, af-u2fa7b, from T01R3 af-7hk9e7,
T01R2 af-6a98ip and T01R af-m2tr6o; Spec af-2zseit, user story 126).

    cockpit-isolated --port PORT --dataset FILE

`bin/project-launch` runs it, from a clean copy of the commit asked for, as
the recipe the Factory's profile declares
(`config/project-descriptors/agent-factory.json`, `launch.recipe`). It
becomes the real `bin/cockpit run` of that copy, on 127.0.0.1:PORT, reading
synthetic sources only:

- a synthetic supervisor that answers as the installed one does
  (`tests/fixtures/cockpit/core/fake_gc.py`, held to the real contract by
  `tests/cockpit-fake-gc-contract-test.py`), and that keeps what the
  installed one keeps of each session the dataset says -- the session, what
  its provider recorded, when it woke and stopped
  (`GET /v0/city/<city>/session/<id>`, `…/transcript?format=raw`,
  `GET /v0/city/<city>/events?type=session.woke`, as gc 1.5.0 answers
  them) -- and sends the sessions the dataset dispatches once the cockpit
  is up;
- a synthetic tracker (`tests/fixtures/cockpit/requests/fake-bd`) and the
  projects declared for this launch alone;
- the knowledge repositories of those projects (their roadmap and release
  plan), Git repositories in the temporary HOME -- or links to ones on this
  host a dataset names --, read in clones of the cockpit's own;
- an empty environment: a temporary HOME, no local settings file, so no
  secret, no notification, no heartbeat and no project clone -- but the
  heartbeat a dataset declares (`heartbeat`: where it goes, at what pace;
  I, af-cp4fzd), its address written as the secret it is in service, in a
  private file of the temporary HOME. Only the mark of the launch
  (`FACTORY_LAUNCH_ID`) is kept from the launcher's;
- the doors that change the Factory (`bin/proposal-door`,
  `bin/escalation-door`, `bin/factory-session-loop-guard`, `gc order run`,
  `bin/order-pause`, and for the settings and the upkeep `bin/provider-failover`,
  `bin/factory-maintain`, `bin/operator-config`) are the real ones, run on the tracker of the launch through a synthetic
  `gc` (`tests/fixtures/cockpit/synthetic-city/`): a gesture is recorded
  there as in service, and read back from there (B, af-4uzgzm). A dataset
  may say a door expires, or expires once its record is written
  (`doors`), and the cockpit gives up on a door after a few seconds.

What those sources answer is what the named dataset says, and nothing else:
`lib/synthetic_city.py` translates its content (`docs/COCKPIT.md`, « State
from the dataset »). A dataset it refuses is never served.

It starts no controller and no tracker, and reaches nothing of the city in
service. The process `bin/project-launch` holds is the cockpit itself, so
stopping it stops the cockpit. The synthetic supervisor runs
beside it and ends when the cockpit does, however it ended; it removes the
temporary directory.
"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FIXTURES = ROOT / "tests" / "fixtures" / "cockpit"
sys.path.insert(0, str(ROOT / "lib"))

import synthetic_city  # noqa: E402

# The tracker, the `gc` and the doors of the launch.
SYNTHETIC = FIXTURES / "synthetic-city"
# The doors of the Factory the cockpit calls, by their name in a dataset:
# what each one is, and the variable that tells the cockpit where it is.
DOORS = {
    "proposal-door": (ROOT / "bin" / "proposal-door", "COCKPIT_PROPOSAL_DOOR_BIN"),
    "escalation-door": (ROOT / "bin" / "escalation-door", "COCKPIT_ESCALATION_DOOR_BIN"),
    "loop-guard": (ROOT / "bin" / "factory-session-loop-guard", "COCKPIT_LOOP_GUARD_BIN"),
    # Pause and resume of an order (af-npz9v1.15), for B's « relancer un order ».
    "order-pause": (ROOT / "bin" / "order-pause", "COCKPIT_ORDER_PAUSE_BIN"),
    # The settings and the upkeep of the Factory (G2, af-f8nlhr; af-npz9v1.20),
    # each on what the launch holds (`door_environment`).
    "provider-failover": (ROOT / "bin" / "provider-failover", "COCKPIT_PROVIDER_FAILOVER_BIN"),
    "factory-maintain": (ROOT / "bin" / "factory-maintain", "COCKPIT_FACTORY_MAINTAIN_BIN"),
    "operator-config": (ROOT / "bin" / "operator-config", "COCKPIT_OPERATOR_CONFIG_BIN"),
    "gc": (SYNTHETIC / "gc", "COCKPIT_GC_BIN"),
}
# How a dataset may say a door answers (`doors`): it never does, or it
# writes its record, then never does. A door it does not name acts.
DOOR_ANSWERS = ("expires", "records-then-expires")
# How long the cockpit waits for a door before it says its command expired:
# a door of the launch answers within a second.
ACTION_TIMEOUT_SECONDS = "5"
# How long the main sources stay silent before the cockpit says the Factory
# muette: long enough that a state that falls silent (home-stale,
# home-offline) is first seen as it is drawn, short enough to be waited for.
SILENCE_ALERT_SECONDS = "20"
# The synthetic sources never change by themselves: read them every second,
# so the cockpit shows its state soon after it is asked. At 0.2 s each launch
# cost about 1.6 core in tracker reads alone (one Python process per read):
# eight criterion classes side by side asked 13 cores of the 8 of the VM,
# whose timed tests then went red on merged results (21/10/2026, af-strhoy).
POLL_SECONDS = "1"
# A supervisor that answers no more is shown as such after this long, not
# after the two minutes a reading stays current in service.
SILENT_VALIDITY_SECONDS = "2"
# A read of a tracker that never answers is not given up while the cockpit
# lives (a day is longer than any launch): the page says it is being read.
UNANSWERED_READ_TIMEOUT_SECONDS = "86400"
# The first page waits for the first reading of the sources, at most this
# long: a source that never answers (a state under reading) is served as
# such once it is over.
FIRST_READ_SECONDS = "8"
# The mark bin/project-launch gives what it launches: the launcher stops
# the processes that carry it, and the controller of an evaluation attests
# that the process listening on the port carries it. The cockpit keeps it.
LAUNCH_MARK = "FACTORY_LAUNCH_ID"


def read_city(path: Path) -> synthetic_city.SyntheticCity:
    """The synthetic city of the dataset at `path`; exits when it is not a
    dataset the isolated cockpit serves."""
    try:
        return synthetic_city.from_dataset(json.loads(path.read_text(encoding="utf-8")))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        sys.exit(f"cockpit-isolated: dataset unreadable ({path}): {exc}")
    except synthetic_city.DatasetRefused as exc:
        sys.exit(f"cockpit-isolated: {path}: {exc}")


def read_doors(path: Path) -> dict[str, str]:
    """How the doors the dataset at `path` names answer; exits when they are
    not each a door of `DOORS` and one of `DOOR_ANSWERS`."""
    doors = json.loads(path.read_text(encoding="utf-8")).get("doors") or {}
    if not isinstance(doors, dict) or not all(door in DOORS and how in DOOR_ANSWERS for door, how in doors.items()):
        sys.exit(f"cockpit-isolated: {path}: its doors (doors) are not each a door of {', '.join(DOORS)} "
                 f"and how it answers: {', '.join(DOOR_ANSWERS)}")
    return doors


def fall_silent_once_read(supervisor, cockpit_url: str) -> None:
    """Take `supervisor` down as soon as the cockpit shows a reading of it
    -- its state and its sessions: the last values are kept, and are no
    longer current."""
    while True:
        try:
            with urllib.request.urlopen(cockpit_url + "/api/status", timeout=2) as response:
                status = json.load(response)
                if (status.get("gc") or {}).get("value") and (status.get("sessions") or {}).get("value"):
                    break
        except (urllib.error.URLError, ConnectionError, OSError, ValueError):
            pass
        time.sleep(float(POLL_SECONDS))
    supervisor.go_down()


def serve_sessions(supervisor, city: synthetic_city.SyntheticCity) -> None:
    """Make `supervisor` answer what the installed one keeps of each session
    of `city` (gc 1.5.0): ``GET /v0/city/<city>/session/<id>``, the session
    as it lists it; ``…/session/<id>/transcript?format=raw``, what its
    provider recorded (``{"id", "format": "raw", "messages"}``); ``GET
    /v0/city/<city>/events?type=session.woke|session.stopped``, when it
    woke and stopped, and ``…?type=execution.step_started``, the bead it
    took (the subject), the latest first -- a 404 for a session it knows
    nothing of. Then send the sessions `city` dispatches once the cockpit is
    up: each wakes, is listed at work for a while with only its first
    records and the bead it works (``active_bead``), then stops and is
    listed no more, as the installed supervisor lists only the sessions it
    runs; a session it keeps once stopped says no bead (gc 1.5.0 on the
    live host, 2026-10-28: no ``active_bead``)."""
    handler = supervisor._server.RequestHandlerClass
    answer_other = handler.do_GET
    prefix = "/v0/city/%s/" % city.name
    sessions = {session["id"]: dict(session) for session in city.sessions}
    lock = threading.Lock()
    # What the supervisor knows now: the sessions it sent, how many records
    # of each it serves (None: all), its events.
    known = {name: None for name in sessions if name not in city.dispatched}
    events = []

    def record(kind: str, name: str, at: str) -> None:
        events.append({"seq": len(events) + 1, "type": kind, "ts": at, "actor": "gc",
                       "subject": sessions[name].get("template") or "", "session_id": name,
                       "payload": {"session_id": name, "template": sessions[name].get("template") or ""}})

    def took(name: str, started: dict | None) -> None:
        # As the installed supervisor logs a session taking a step: the
        # bead it took is the subject, the session acts.
        if started:
            events.append({"seq": len(events) + 1, "type": "execution.step_started", "ts": started["at"],
                           "actor": name, "subject": started["bead"], "payload": {}, "run_id": started["run"],
                           "session_id": name, "step_id": started["step"], "depends_on_step_ids": []})

    for name, logged in sorted(city.session_log.items(), key=lambda pair: pair[1]["woke"] or ""):
        if name in known and name in sessions:
            if logged["woke"]:
                record("session.woke", name, logged["woke"])
            took(name, logged.get("started"))
            if logged["stopped"]:
                record("session.stopped", name, logged["stopped"])

    def listed() -> list:
        return [dict(sessions[name]) for name in known if name not in city.dispatched or sessions[name]["running"]]

    def do_GET(self):  # noqa: N802
        path, _, query = self.path.partition("?")
        rest = path[len(prefix):] if path.startswith(prefix) else None
        if supervisor._down or rest is None or not (rest == "events" or rest.startswith("session/")):
            answer_other(self)
            return
        with lock:
            if rest == "events":
                wanted = urllib.parse.parse_qs(query).get("type", [""])[0]
                items = [dict(event) for event in reversed(events) if not wanted or event["type"] == wanted]
                self._send_json({"items": items, "total": len(items)})
                return
            name, _, part = urllib.parse.unquote(rest[len("session/"):]).partition("/")
            if name not in known or part not in ("", "transcript") or (part and name not in city.transcripts):
                self._send(404, "text/plain; charset=utf-8", b"404 page not found\n")
                return
            if not part:
                self._send_json(dict(sessions[name]))
                return
            served = city.transcripts[name][:known[name]] if known[name] is not None else city.transcripts[name]
            self._send_json({"id": name, "format": "raw", "messages": served})

    handler.do_GET = do_GET

    def dispatch(name: str, said: dict) -> None:
        time.sleep(float(said.get("after_seconds") or 0))
        running = float(said.get("running_seconds") or 0)
        logged = city.session_log.get(name) or {}
        with lock:
            if logged.get("woke") or sessions[name].get("created_at"):
                record("session.woke", name, logged.get("woke") or sessions[name]["created_at"])
            took(name, logged.get("started"))
            sessions[name]["running"] = running > 0
            if running > 0 and logged.get("started"):
                sessions[name]["active_bead"] = logged["started"]["bead"]
            known[name] = said.get("recorded_while_running") if running > 0 else None
            supervisor.set_sessions(listed())
        if running > 0:
            time.sleep(running)
        with lock:
            sessions[name]["running"] = False
            sessions[name].pop("active_bead", None)
            known[name] = None
            if logged.get("stopped"):
                record("session.stopped", name, logged["stopped"])
            supervisor.set_sessions(listed())

    supervisor.set_sessions(listed())
    for name, said in city.dispatched.items():
        if name in sessions:
            threading.Thread(target=dispatch, args=(name, said), daemon=True).start()


def serve_synthetic_supervisor(
    city: synthetic_city.SyntheticCity, cockpit_url: str, home: str, announce: int, cockpit_alive: int
) -> None:
    """The process beside the cockpit: the supervisor of `city`. It writes
    its address on `announce`, then lives until `cockpit_alive` closes --
    the cockpit ended -- and removes `home`."""
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    sys.path.insert(0, str(FIXTURES / "core"))
    import fake_gc

    supervisor = fake_gc.FakeGc(city=city.name)
    supervisor.set_status(
        suspended=city.suspended, agents_running=sum(1 for session in city.sessions if session["running"])
    )
    supervisor.start()
    serve_sessions(supervisor, city)
    if city.reading in (synthetic_city.UNANSWERED, synthetic_city.FAILING):
        supervisor.go_down()
    os.write(announce, supervisor.base_url.encode("ascii"))
    os.close(announce)
    if city.reading == synthetic_city.READ_ONCE:
        threading.Thread(target=fall_silent_once_read, args=(supervisor, cockpit_url), daemon=True).start()
    while os.read(cockpit_alive, 1):
        pass
    supervisor.stop()
    shutil.rmtree(home, ignore_errors=True)


# A host restarted during a stop (af-npz9v1.21, for H af-69qhlk): the
# stop was asked this long before the launch, which is the restart.
STOP_ASKED_BEFORE_RESTART_SECONDS = 10 * 60


def read_https(path: Path) -> bool:
    """Whether the dataset at `path` puts the cockpit behind the synthetic
    identity proxy (`https_identity_proxy`); exits when it is not true or
    false."""
    https = json.loads(path.read_text(encoding="utf-8")).get("https_identity_proxy", False)
    if not isinstance(https, bool):
        sys.exit(f"cockpit-isolated: {path}: https_identity_proxy is true or false")
    return https


def start_identity_proxy(cockpit_port: int, home: str, held: list[int]) -> dict[str, str]:
    """The synthetic identity proxy in front of the cockpit (af-npz9v1.22,
    for I af-cp4fzd; `tests/fixtures/cockpit/synthetic-city/identity_proxy.py`):
    HTTPS on 127.0.0.1 with a certificate of the launch, as Tailscale Serve
    is in service. It lives until the cockpit ends; `held` are the ends of
    the other pipes it must not keep open. The environment says its address
    and the authority to trust (COCKPIT_TRIAL_HTTPS_URL, _CA), and makes its
    origin the cockpit's own and the address it gives (COCKPIT_PUBLIC_URL),
    as behind Serve."""
    announce_read, announce_write = os.pipe()
    alive_read, alive_write = os.pipe()
    if os.fork() == 0:
        os.close(announce_read)
        os.close(alive_write)
        for fd in held:
            os.close(fd)
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            sys.path.insert(0, str(SYNTHETIC))
            import identity_proxy

            identity_proxy.serve(cockpit_port, home, announce_write, alive_read)
        finally:
            os._exit(0)
    os.close(announce_write)
    os.close(alive_read)
    with os.fdopen(announce_read, "rb") as announced:
        url = announced.read().decode("ascii")
    if not url:
        sys.exit("cockpit-isolated: the synthetic identity proxy did not start")
    # Kept open by the cockpit for as long as it lives, and by nothing else.
    os.set_inheritable(alive_write, True)
    return {"COCKPIT_ALLOWED_ORIGIN": url, "COCKPIT_PUBLIC_URL": url, "COCKPIT_TRIAL_HTTPS_URL": url,
            "COCKPIT_TRIAL_HTTPS_CA": os.path.join(home, "https", "cert.pem")}


def read_heartbeat(path: Path) -> dict | None:
    """The heartbeat the dataset at `path` declares (`heartbeat`: its
    `ping_url`, an http(s) address, and its `interval_seconds`, the pace
    that stands for the five minutes of service), or None; exits when it is
    not one."""
    heartbeat = json.loads(path.read_text(encoding="utf-8")).get("heartbeat")
    if heartbeat is None:
        return None
    url = heartbeat.get("ping_url") if isinstance(heartbeat, dict) else None
    interval = heartbeat.get("interval_seconds") if isinstance(heartbeat, dict) else None
    if (not isinstance(url, str) or not url.startswith(("http://", "https://"))
            or isinstance(interval, bool) or not isinstance(interval, (int, float)) or interval <= 0):
        sys.exit(f"cockpit-isolated: {path}: heartbeat is a ping_url (http or https) and an interval_seconds above 0")
    return {"ping_url": url, "interval_seconds": float(interval)}


def write_heartbeat(heartbeat: dict | None, home: str) -> dict[str, str]:
    """The environment of the heartbeat the dataset declares: its address in
    a file of the temporary HOME that only this account reads, as the secret
    file of the VM (the cockpit reads it and shows it nowhere), its pace,
    and a tick four times as frequent. Nothing when it declares none."""
    if heartbeat is None:
        return {}
    folder = Path(home, "secrets")
    folder.mkdir(mode=0o700)
    secret = folder / "heartbeat-url"
    descriptor = os.open(secret, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as written:
        written.write(heartbeat["ping_url"] + "\n")
    interval = heartbeat["interval_seconds"]
    return {"COCKPIT_HEARTBEAT_URL_FILE": str(secret), "COCKPIT_HEARTBEAT_INTERVAL_SECONDS": str(interval),
            "COCKPIT_HEARTBEAT_TICK_SECONDS": str(interval / 4)}


def read_restart(path: Path) -> bool:
    """Whether the dataset at `path` says the host restarted during a stop
    (`host_restarted_during_stop`); exits when it is not true or false."""
    restarted = json.loads(path.read_text(encoding="utf-8")).get("host_restarted_during_stop", False)
    if not isinstance(restarted, bool):
        sys.exit(f"cockpit-isolated: {path}: host_restarted_during_stop is true or false")
    return restarted


def write_stop(restarted: bool, city: synthetic_city.SyntheticCity, home: str) -> dict[str, str]:
    """The state of the clean stop the cockpit starts from, in `home`, and
    the environment that makes it read it every second. A host restarted
    during a stop (`read_restart`) leaves it as it was: a stop asked ten
    minutes before, the tickets in flight then (the photo: the tracker of
    the launch), the cockpit restarted since. The stop driver then reads the
    supervisor: unsuspended, as after a reboot, it is « Arrêt interrompu »
    with the tickets whose assignment changed; still suspended, the stop
    goes on."""
    state = Path(home, "cockpit-stop-state.json")
    if restarted:
        asked = time.time() - STOP_ASKED_BEFORE_RESTART_SECONDS
        photo = {bead["id"]: {"status": bead.get("status"),
                              "assignee": (bead.get("metadata") or {}).get("gc.session_name") or bead.get("assignee")}
                 for bead in city.beads if isinstance(bead, dict) and bead.get("id")}
        state.write_text(json.dumps({"state": "arret_en_cours", "started_at": asked, "last_progress_at": asked,
                                     "snapshot": {"beads": photo}}), encoding="utf-8")
    return {"COCKPIT_STOP_STATE_FILE": str(state), "COCKPIT_STOP_TICK_SECONDS": POLL_SECONDS}


def write_doors(answers: dict[str, str], home: str) -> dict[str, str]:
    """The doors of the launch, in `home`: each the real door, or the way
    the dataset says it answers; the environment that makes the cockpit
    and the doors use them, and the tracker of the launch."""
    doors = Path(home, "doors")
    doors.mkdir()
    env = {
        "GC_BIN": str(SYNTHETIC / "gc"),
        "FACTORY_SESSION_LOOP_GUARD_LOG": os.path.join(home, "factory-session-loop-guard.log"),
        "COCKPIT_ACTION_TIMEOUT_SECONDS": ACTION_TIMEOUT_SECONDS,
        "COCKPIT_FACTORY_ROOT": factory_tree(home),
    }
    own = door_environment(home, doors)
    for name, (real, variable) in DOORS.items():
        how = answers.get(name, "acts")
        door = doors / name
        door.write_text("#!/bin/sh\nexec env %s%s %s %s %s \"$@\"\n" % (
            "".join(f"{key}={shlex.quote(value)} " for key, value in own.get(name, {}).items()),
            shlex.quote(sys.executable), shlex.quote(str(SYNTHETIC / "door")), how, shlex.quote(str(real))),
            encoding="utf-8")
        door.chmod(0o755)
        env[variable] = str(door)
    return env


def door_environment(home: str, doors: Path) -> dict[str, dict[str, str]]:
    """What each settings or upkeep door of the launch reads and writes, in
    `home` and never in the Factory in service (af-npz9v1.20):

    - provider-failover: the Factory tree of the launch (`factory_tree`):
      its state and overlay there, the policy, the catalogue and city.toml
      of the commit, no tmux session read, `gc` the synthetic one;
    - factory-maintain: the throwaway repositories `throwaway_repositories`
      makes (the copy of the commit shares the refs of the repository it
      comes from: pruning its branches would prune those), `gc` the
      synthetic one, no GitHub proof (a branch GitHub would prove merged is
      kept, as when GitHub does not answer), its escalations through the
      escalation door of the launch;
    - operator-config reads config/operator.toml of the commit and writes
      nothing."""
    tools = Path(home, "maintain-bin")
    tools.mkdir()
    # A script, not a link: the synthetic gc finds its tracker beside its own path.
    (tools / "gc").write_text(f"#!/bin/sh\nexec {shlex.quote(str(SYNTHETIC / 'gc'))} \"$@\"\n",
                              encoding="utf-8")
    (tools / "gc").chmod(0o755)
    (tools / "gh").write_text("#!/bin/sh\necho 'trial cockpit: no GitHub' >&2\nexit 1\n", encoding="utf-8")
    (tools / "gh").chmod(0o755)
    path = f"{tools}{os.pathsep}{os.environ.get('PATH', os.defpath)}"
    return {
        "provider-failover": {
            "FACTORY_ROOT": os.path.join(home, "factory"),
            "PROVIDER_TMUX_BIN": shutil.which("false") or "false",
            "PATH": path,
        },
        "factory-maintain": {
            "FACTORY_ROOT": throwaway_repositories(home),
            "FACTORY_MAINTAIN_LOG": os.path.join(home, "factory-maintain.log"),
            "ESCALATION_DOOR_BIN": str(doors / "escalation-door"),
            "PATH": path,
        },
    }


# What bin/provider-failover writes in the Factory tree.
WRITTEN = ("city.provider.toml", ".gc/provider-state.json")


def factory_tree(home: str) -> str:
    """The Factory tree of the launch, in `home`: every file of the commit,
    by a link, but what the provider failover writes (WRITTEN), copied when
    the commit holds it: a test may commit the state it observed. The page
    Usine reads it (COCKPIT_FACTORY_ROOT) and provider-failover writes in it:
    a setting is read back where it was written, never in the Factory in
    service nor in the copy of the commit (af-npz9v1.20)."""
    tree = Path(home, "factory")
    tree.mkdir()
    for entry in ROOT.iterdir():
        if entry.name not in (".gc", ".git", *WRITTEN):
            (tree / entry.name).symlink_to(entry)
    for name in WRITTEN:
        if (ROOT / name).is_file():
            (tree / name).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(ROOT / name, tree / name)
    return str(tree)


def throwaway_repositories(home: str) -> str:
    """Throwaway Git repositories of the launch, as factory-maintain finds the
    Factory's: a clone of a bare origin (FACTORY_ROOT) whose branch `merged`
    is merged and pushed, and `unpushed` holds a commit origin lacks; and,
    where clean-worktrees looks ($HOME/.local/share/agent-factory-runtime-
    worktrees), a worktree merged and pushed (`af-merged`, a candidate) and
    three it must keep: a local change (`af-modified`), a commit not pushed
    (`af-unpushed`), work under way (`af-active`). Returns the clone."""
    env = {**os.environ, "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_SYSTEM": os.devnull,
           "GIT_AUTHOR_NAME": "essai", "GIT_AUTHOR_EMAIL": "essai@example.invalid",
           "GIT_COMMITTER_NAME": "essai", "GIT_COMMITTER_EMAIL": "essai@example.invalid"}
    base = Path(home, "maintain")
    origin, clone = base / "origin.git", base / "factory"
    worktrees = Path(home, ".local", "share", "agent-factory-runtime-worktrees")
    worktrees.mkdir(parents=True)
    base.mkdir()

    def git(where: Path, *args: str) -> None:
        subprocess.run(["git", "-C", str(where), *args], env=env, check=True, capture_output=True)

    def commit(where: Path, name: str) -> None:
        Path(where, name).write_text(name + "\n", encoding="utf-8")
        git(where, "add", name)
        git(where, "commit", "-q", "-m", name)

    git(base, "init", "-q", "--bare", "-b", "main", str(origin))
    git(base, "clone", "-q", str(origin), str(clone))
    git(clone, "checkout", "-q", "-B", "main")
    commit(clone, "README")
    git(clone, "push", "-q", "-u", "origin", "main")
    git(clone, "remote", "set-head", "origin", "main")
    for branch in ("merged", "wt-merged", "wt-modified"):
        git(clone, "branch", branch)
        git(clone, "push", "-q", "-u", "origin", branch)
    git(clone, "checkout", "-q", "-b", "unpushed")
    commit(clone, "unpushed")
    git(clone, "checkout", "-q", "-b", "wt-active", "main")
    commit(clone, "active")
    git(clone, "push", "-q", "-u", "origin", "wt-active")
    git(clone, "checkout", "-q", "-b", "wt-unpushed", "main")
    commit(clone, "wt-unpushed")
    git(clone, "checkout", "-q", "main")
    for name, branch in (("af-merged", "wt-merged"), ("af-modified", "wt-modified"),
                         ("af-unpushed", "wt-unpushed"), ("af-active", "wt-active")):
        git(clone, "worktree", "add", "-q", str(worktrees / name), branch)
    Path(worktrees, "af-modified", "README").write_text("local change\n", encoding="utf-8")
    return str(clone)


def write_tracker_and_projects(city: synthetic_city.SyntheticCity, home: str) -> dict[str, str]:
    """Put what the tracker holds and the projects declared in `home`; the
    environment that makes the cockpit read them."""
    # The files the sources point at, in the home of the launch: a value
    # that names one says where it is.
    for path, content in city.files.items():
        Path(home, path).parent.mkdir(parents=True, exist_ok=True)
        Path(home, path).write_text(content, encoding="utf-8")
    beads = Path(home, "tracker.json")
    beads.write_text(json.dumps(city.beads, ensure_ascii=False).replace(synthetic_city.HOME_MARK, home + "/"),
                     encoding="utf-8")
    projects = Path(home, "projects")
    projects.mkdir()
    for descriptor in city.projects:
        Path(projects, descriptor["project_id"] + ".json").write_text(
            json.dumps(descriptor, ensure_ascii=False), encoding="utf-8"
        )
    env = {
        "COCKPIT_BD_BIN": str(SYNTHETIC / "bd"),
        "FAKE_BD_STATE_FILE": str(beads),
        "COCKPIT_DESCRIPTORS_DIR": str(projects),
    }
    if city.reading == synthetic_city.FAILING:
        # The tracker fails for as long as this file exists: always.
        env["FAKE_BD_FAIL_FLAG_FILE"] = str(beads)
    if city.reading == synthetic_city.UNANSWERED:
        # A tracker that answers no read, and a cockpit that waits for it.
        env["COCKPIT_BD_BIN"] = str(FIXTURES / "requests" / "silent-bd")
        env["COCKPIT_BEADS_READ_TIMEOUT_SECONDS"] = UNANSWERED_READ_TIMEOUT_SECONDS
        env["COCKPIT_JOURNAL_READ_TIMEOUT_SECONDS"] = UNANSWERED_READ_TIMEOUT_SECONDS
    return env


def write_knowledge_repos(city: synthetic_city.SyntheticCity, home: str) -> dict[str, str]:
    """Put the knowledge repositories of the projects under `home`: a Git
    repository for each one the city writes, its files committed at the
    date it says, or a link to one already on this host. The environment
    that makes the cockpit read them, in clones of its own, as it reads the
    repositories of the projects in service (cockpit.projects.depots)."""
    if not city.repos:
        return {}
    for name, repo in city.repos.items():
        path = Path(home, "repos", name)
        path.parent.mkdir(parents=True, exist_ok=True)
        if "path" in repo:
            path.symlink_to(repo["path"], target_is_directory=True)
            continue
        for file, text in repo["files"].items():
            Path(path, file).parent.mkdir(parents=True, exist_ok=True)
            Path(path, file).write_text(text, encoding="utf-8")
        env = {"PATH": os.environ.get("PATH", os.defpath), "HOME": home, "GIT_AUTHOR_NAME": "synthetic",
               "GIT_AUTHOR_EMAIL": "synthetic@example.invalid", "GIT_COMMITTER_NAME": "synthetic",
               "GIT_COMMITTER_EMAIL": "synthetic@example.invalid", "GIT_AUTHOR_DATE": repo["at"],
               "GIT_COMMITTER_DATE": repo["at"]}
        for args in (["init", "--quiet", "--initial-branch", "main"], ["add", "--all"],
                     ["-c", "commit.gpgsign=false", "commit", "--quiet", "--message", "the knowledge of the project"]):
            subprocess.run(["git", "-C", str(path), *args], check=True, capture_output=True, env=env)
    Path(home, "rigs").mkdir()
    return {
        "COCKPIT_CLONES_DIR": os.path.join(home, "clones"),
        "COCKPIT_REPO_URL_TEMPLATE": "file://" + os.path.join(home, "repos", "%s"),
        # No rig of this launch has a repository: no promotion is read.
        "COCKPIT_RIG_FILES_DIR": os.path.join(home, "rigs"),
        "COCKPIT_DEPOTS_POLL_SECONDS": POLL_SECONDS,
    }


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="cockpit-isolated", description=__doc__)
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--dataset", required=True)
    args = parser.parse_args(argv)
    city = read_city(Path(args.dataset))
    doors = read_doors(Path(args.dataset))
    restarted = read_restart(Path(args.dataset))
    https = read_https(Path(args.dataset))
    heartbeat = read_heartbeat(Path(args.dataset))
    cockpit_url = f"http://127.0.0.1:{args.port}"

    home = tempfile.mkdtemp(prefix="cockpit-isolated-")
    announce_read, announce_write = os.pipe()
    alive_read, alive_write = os.pipe()
    if os.fork() == 0:
        os.close(announce_read)
        os.close(alive_write)
        try:
            serve_synthetic_supervisor(city, cockpit_url, home, announce_write, alive_read)
        finally:
            os._exit(0)
    os.close(announce_write)
    os.close(alive_read)
    with os.fdopen(announce_read, "rb") as announced:
        supervisor_url = announced.read().decode("ascii")
    if not supervisor_url:
        shutil.rmtree(home, ignore_errors=True)
        sys.exit("cockpit-isolated: the synthetic supervisor did not start")
    # Kept open by the cockpit for as long as it lives, and by nothing else.
    os.set_inheritable(alive_write, True)

    env = {
        "PATH": os.environ.get("PATH", os.defpath),
        "HOME": home,
        "COCKPIT_HOST": "127.0.0.1",
        "COCKPIT_PORT": str(args.port),
        "COCKPIT_ALLOWED_ORIGIN": cockpit_url,
        "COCKPIT_BENJAMIN_LOGIN": "synthetic@example.ts.net",
        "COCKPIT_PID_FILE": os.path.join(home, "cockpit.pid"),
        "COCKPIT_LOCAL_CONFIG": os.path.join(home, "absent.json"),
        "COCKPIT_GC_BASE_URL": supervisor_url,
        "COCKPIT_SILENCE_ALERT_SECONDS": SILENCE_ALERT_SECONDS,
        "COCKPIT_GC_STATUS_POLL_SECONDS": POLL_SECONDS,
        "COCKPIT_BEADS_POLL_SECONDS": POLL_SECONDS,
        "COCKPIT_PROJECTS_POLL_SECONDS": POLL_SECONDS,
        "COCKPIT_JOURNAL_POLL_SECONDS": POLL_SECONDS,
        "COCKPIT_SESSIONS_POLL_SECONDS": POLL_SECONDS,
        "COCKPIT_FIRST_READ_SECONDS": FIRST_READ_SECONDS,
        **write_doors(doors, home),
        **write_tracker_and_projects(city, home),
        **write_knowledge_repos(city, home),
    }
    if LAUNCH_MARK in os.environ:
        env[LAUNCH_MARK] = os.environ[LAUNCH_MARK]
    env.update(write_stop(restarted, city, home))
    env.update(write_heartbeat(heartbeat, home))
    if https:
        env.update(start_identity_proxy(args.port, home, [alive_write]))
    if city.reading == synthetic_city.READ_ONCE:
        # Its state and its sessions alike: both are read from it.
        env["COCKPIT_VALIDITY_GC_SECONDS"] = SILENT_VALIDITY_SECONDS
        env["COCKPIT_VALIDITY_SESSIONS_SECONDS"] = SILENT_VALIDITY_SECONDS
    # A Runs state: the clock starts at the moment the state shows, and its
    # selection is what a page opens when its address names none.
    if city.clock_start:
        env["COCKPIT_CLOCK_START"] = city.clock_start
    if city.view:
        env["COCKPIT_RUNS_VIEW"] = json.dumps(city.view)
    if city.session_trace:
        env["COCKPIT_TRACE_FILE"] = city.session_trace
    os.execve(sys.executable, [sys.executable, str(ROOT / "bin" / "cockpit"), "run"], env)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
