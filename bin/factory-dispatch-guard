#!/usr/bin/env bash
# factory-dispatch-guard — detects a bead `gc sling`d to a target while its
# assignee still holds a stale, different value, which makes the bead
# invisible to the target's own claim query even though dispatch reported
# success (af-33a4e).
#
# Root cause (2026-09-18, root-caused live by the PO): the Mayor ran
# `gc sling bd.dog af-c6tdz`. The command reported success and set
# `gc.routed_to=bd.dog`, but af-c6tdz's assignee stayed `mayor` (its
# pre-existing value) — `gc sling` does not clear/change an existing
# assignee unless `--reassign` is passed. bd.dog's own claim query keys off
# assignee (or at least does not treat `gc.routed_to` alone as "mine to
# claim"), so bd.dog kept reporting "no assigned work" while af-c6tdz sat
# IN_PROGRESS with assignee=mayor, no heartbeat, for about 2 hours — until a
# human noticed.
#
# `gc sling` itself lives outside this repo (a separately built, statically
# linked binary from the gascity pack chain — see packs.lock); it cannot be
# patched here. This guard is the repo-side mitigation the bug asked for:
# make the mismatch impossible to miss, and self-heal it deterministically
# instead of waiting for a human to notice a stalled dispatch. The other half
# of the fix — the Mayor always passing `--reassign` when it dispatches to a
# pool/infrastructure target — lives in agents/mayor/prompt.template.md.
#
# Detection: a bead carrying `gc.routed_to` (dispatch happened), still open
# or in_progress, whose assignee is non-empty AND differs from routed_to AND
# has shown no progress (no Beads update, no heartbeat) for at least
# FACTORY_DISPATCH_STALE_MINUTES (default 15 — a few ticks of the idle
# ladder's cadence, so a formula that legitimately self-claims within
# seconds of dispatch, per af-pl39t, is never a false positive).
#
# Last progress = the newest *known* of updated_at / heartbeat_at /
# gc.last_heartbeat_at. heartbeat_at is the bead's own field, the one
# `gc bd heartbeat` stamps when the holder refreshes its lease; until
# 2026-10-12 only the metadata key was read, which that command never writes,
# so a session heartbeating through a long trial lost its step after 15
# minutes (af-r654ku). An empty or unparseable timestamp is unknown and
# contributes nothing (a missing heartbeat falls back to updated_at). If neither is known there is
# no evidence of progress at all, so the bead is treated as stale and its age
# reported as unknown -- never invented. (Until 2026-09-29 an empty heartbeat
# went through `date -d ""`, which silently answers midnight UTC today: a
# drift was invisible 00:00-00:15 UTC every day and the displayed age was
# wrong for every bead without a heartbeat.)
#
# Repair: clear the stale assignee (`gc bd update <id> --if-assignee <the
# assignee this run read> --assignee ""`) so the bead becomes visible to the
# target's own claim query again — the same effect `--reassign` would have
# had at sling time — leave a note, and page the Mayor once. The
# compare-and-set is what Beads 1.3 accepts from an actor that is not the
# holder of an in_progress bead (a bare `--assignee ""` is refused, exit 1),
# and it releases the claim this run read and no other: exit 13 means the
# holder changed since the read, the bead is left alone and the run says so
# (af-33wuoh). This is self-converging: on the next run the bead either
# has a real assignee again (something claimed it) or an empty one, and
# either way no longer matches this guard's condition, so it is never
# re-flagged for the same drift.
#
# Session-affinity exception (2026-09-18, af-7qxzh): a bead carrying
# `gc.session_affinity=require` is a later step of a multi-step formula that
# belongs to whichever session is working its earlier steps, not to whichever
# pool worker claims it next -- its assignee is that session's name, and
# `gc.routed_to` stays the generic pool/template it will eventually be
# claimed through (e.g. assignee=claude-af-c9a25, routed_to=claude). That
# looks identical to sling drift, but clearing it is wrong while the named
# session is still running: a live incident cleared two such steps out from
# under a session 17m50s into the same workflow's earlier step, risking a
# different pool worker claiming a mid-workflow step out of order. Before
# treating one of these as drift, this guard checks whether a session named
# `assignee` is still alive (present in `gc session list --state all --json`
# and not closed) and leaves it alone if so -- staleness here is expected
# (the session hasn't reached this step yet), not evidence of a stuck
# dispatch. Once that session is gone (closed, or never existed), the bead
# reverts to ordinary drift handling below.
#
# Claimed-step exception (2026-10-12, af-cdwo4z): a formula step claimed
# through `gc hook --claim` has its assignee set to the claiming session's id
# and carries that same id in `gc.session_id`, while `gc.routed_to` stays the
# pool template (assignee=af-wisp-frrf2y3, routed_to=delivery-author). The
# heartbeat signal above only helps a formula that asks for one, and a session
# cannot heartbeat inside one long turn anyway: a live author session, 18
# minutes into a single turn of mol-ticket-resume, lost its step this way
# (af-tvnx85). So a bead whose assignee is its own `gc.session_id` is left
# alone as long as that session is still alive, whatever its age. A sling
# drift never matches: its assignee is a pre-existing value the claim did not
# stamp. Once the session is gone the bead reverts to ordinary drift handling.
#
# --check-only reports without writing or paging anything.
#
# Usage: factory-dispatch-guard [--check-only]
set -uo pipefail

PROGRAM_NAME="factory-dispatch-guard"
ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
GC_BIN="${GC_BIN:-gc}"
BD_BIN="${BD_BIN:-bd}"
STALE_MINUTES="${FACTORY_DISPATCH_STALE_MINUTES:-15}"
CHECK_ONLY=0

while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) CHECK_ONLY=1 ;;
    -h|--help)
      sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "$PROGRAM_NAME: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

require_command() {
  command -v "$1" >/dev/null 2>&1 || { echo "$PROGRAM_NAME: required command unavailable: $1" >&2; exit 2; }
}
require_command "$GC_BIN"
require_command "$BD_BIN"
require_command jq

PROBLEMS=(); ACTIONS=(); STATUS=0
CHECKED=0; DRIFTED=0
say()  { printf '%s\n' "$*"; }
bad()  { PROBLEMS+=("$1"); STATUS=1; }
did()  { ACTIONS+=("$1"); say "  REPAIRED: $1"; }
# epoch_of <timestamp>: epoch seconds, or NOTHING when the timestamp is empty
# or unparseable. Never call `date -d` on an empty string: it does not fail,
# it answers midnight UTC of the current day.
epoch_of() {
  local ts=$1 e
  [ -n "${ts//[[:space:]]/}" ] || return 0
  e=$(date -u -d "$ts" +%s 2>/dev/null) || return 0
  [[ $e =~ ^-?[0-9]+$ ]] && printf '%s\n' "$e"
  return 0
}
# FACTORY_DISPATCH_NOW_EPOCH pins the clock -- a test seam only, so the test
# is independent of the time of day it runs at.
now_epoch() {
  if [[ ${FACTORY_DISPATCH_NOW_EPOCH:-} =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$FACTORY_DISPATCH_NOW_EPOCH"
  else
    date -u +%s
  fi
}

page_mayor_once() {  # id summary
  local id=$1 summary=$2
  (cd "$ROOT" && "$GC_BIN" --city "$ROOT" mail send mayor --notify \
    -s "Dispatch drift repaired: $id" \
    -m "ACTION: factory-dispatch-guard cleared a stale assignee that was blocking dispatch visibility
STATE: $summary
EVIDENCE: gc bd show $id
NEXT: confirm $id's routed target ($id's gc.routed_to) picks the work up; if it does not within a few minutes, dispatch by hand" \
    >/dev/null 2>&1)
}

# --city "$ROOT" is not cosmetic: without it, an unscopeable/scratch root
# (no rig config bd can resolve from) has been observed to fall back to the
# live production store instead of erroring -- the exact class of gap
# section 7b above pins `--city` against for `gc events`. Pinning it here
# makes a throwaway test city fail closed instead of silently reading real
# beads.
rows_json=$(cd "$ROOT" && "$GC_BIN" --city "$ROOT" bd list --all --has-metadata-key gc.routed_to \
  --status open,in_progress --limit 0 --json 2>/dev/null)
jq -e . >/dev/null 2>&1 <<<"$rows_json" || rows_json='[]'

# Sessions still alive (active or suspended, not closed) by session_name --
# looked up once per run so the session-affinity exception below never
# treats "not yet visible to claim query" as drift for a step whose owning
# session simply hasn't gotten there yet (af-7qxzh).
sessions_json=$(cd "$ROOT" && "$GC_BIN" --city "$ROOT" session list --state all --json 2>/dev/null)
jq -e . >/dev/null 2>&1 <<<"$sessions_json" || sessions_json='{"sessions":[]}'
ALIVE_SESSION_NAMES=$(jq -r '.sessions[]? | select(.closed != true) | .session_name // empty' <<<"$sessions_json")
ALIVE_SESSION_IDS=$(jq -r '.sessions[]? | select(.closed != true) | .id // empty' <<<"$sessions_json")

is_session_alive() {  # session_name
  local name=$1
  [ -n "$name" ] || return 1
  grep -qxF "$name" <<<"$ALIVE_SESSION_NAMES"
}

is_session_id_alive() {  # session_id
  local sid=$1
  [ -n "$sid" ] || return 1
  grep -qxF "$sid" <<<"$ALIVE_SESSION_IDS"
}

# A field can legitimately be empty (assignee, heartbeat) and sit ahead of a
# non-empty one -- @tsv's tab delimiter is bash IFS *whitespace*, so
# `IFS=$'\t' read` silently collapses that empty field into its neighbour
# instead of preserving it. \x1f (unit separator) is not IFS whitespace, so
# empty fields round-trip correctly.
rows=$(jq -r '
  .[] | [
    .id, .status,
    (.assignee // ""),
    (.metadata["gc.routed_to"] // ""),
    (.updated_at // ""),
    (.heartbeat_at // ""),
    (.metadata["gc.last_heartbeat_at"] // ""),
    (.metadata["gc.session_affinity"] // ""),
    (.metadata["gc.session_id"] // "")
  ] | join("")
' <<<"$rows_json")

NOW=$(now_epoch)
STALE_SECONDS=$((STALE_MINUTES * 60))

while IFS=$'\x1f' read -r id status assignee routed_to updated_at lease_heartbeat_at heartbeat_at session_affinity claim_session_id; do
  [ -z "$id" ] && continue
  CHECKED=$((CHECKED + 1))
  [ -n "$assignee" ] || continue
  [ "$assignee" != "$routed_to" ] || continue

  # session_affinity=require: assignee names the session owning this
  # formula step, not stale dispatch drift -- leave it alone as long as
  # that session is still alive, however stale it looks (af-7qxzh).
  [ "$session_affinity" = "require" ] && is_session_alive "$assignee" && continue

  # assignee is the session that claimed this step through the hook
  # (gc.session_id): the step is held, not drifted, as long as that session
  # is still alive -- one long turn sends no heartbeat (af-cdwo4z).
  [ "$assignee" = "$claim_session_id" ] && is_session_id_alive "$assignee" && continue

  # Newest KNOWN progress signal; an unknown one contributes nothing.
  last_progress=""
  for e in "$(epoch_of "$updated_at")" "$(epoch_of "$lease_heartbeat_at")" "$(epoch_of "$heartbeat_at")"; do
    [ -n "$e" ] || continue
    if [ -z "$last_progress" ] || [ "$e" -gt "$last_progress" ]; then last_progress=$e; fi
  done
  if [ -n "$last_progress" ]; then
    age=$((NOW - last_progress))
    [ "$age" -ge "$STALE_SECONDS" ] || continue
    age_label="$((age / 60))m"
  else
    # No parseable updated_at nor heartbeat: no evidence anyone is working
    # it -- stale by definition, with an honest "unknown" age.
    age_label="unknown age (no parseable updated_at or heartbeat)"
  fi

  DRIFTED=$((DRIFTED + 1))
  bad "$id routed to '$routed_to' but assignee is still '$assignee' (stale ${age_label}, threshold ${STALE_MINUTES}m) — invisible to '$routed_to''s own claim query"
  if [ "$CHECK_ONLY" != "1" ]; then
    (cd "$ROOT" && "$GC_BIN" --city "$ROOT" bd update "$id" --if-assignee "$assignee" --assignee "" \
          --append-notes "factory-dispatch-guard: cleared stale assignee '$assignee' (routed to '$routed_to' but not visible to its claim query for ${age_label}; see af-33a4e). Dispatching to a pool/infrastructure target must pass --reassign to clear a pre-existing human assignee." \
          >/dev/null 2>&1)
    rc=$?
    if [ "$rc" = 0 ]; then
      page_mayor_once "$id" "assignee was '$assignee' (routed to '$routed_to', stale ${age_label}); cleared so '$routed_to' can claim it"
      did "$id: cleared stale assignee '$assignee' (routed to '$routed_to', stale ${age_label}) and paged the Mayor"
    elif [ "$rc" = 13 ]; then
      say "  LEFT ALONE: $id: its assignee is no longer '$assignee' (changed since this run read it) — nothing written"
    else
      bad "$id could not be repaired — the Beads write failed"
    fi
  fi
done <<<"$rows"

say ""
if [ "${#ACTIONS[@]}" -gt 0 ]; then say "repaired ${#ACTIONS[@]}:"; printf '  - %s\n' "${ACTIONS[@]}"; fi
if [ "${#PROBLEMS[@]}" -gt 0 ]; then
  say "UNRESOLVED ${#PROBLEMS[@]}:"; printf '  ! %s\n' "${PROBLEMS[@]}"
elif [ "$DRIFTED" -gt 0 ]; then
  say "healthy — $DRIFTED dispatch drift(s) seen this run, all repaired"
else
  say "healthy — $CHECKED routed bead(s) checked, no stale dispatch drift"
fi
exit 0
