#!/usr/bin/env bash

set -Eeuo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
PYTHON_BIN=${PYTHON_BIN:-python3}
HOST=127.0.0.1
PORT=${FACTORY_COCKPIT_PORT:-8383}
RUNTIME_ROOT=${XDG_RUNTIME_DIR:-/tmp}
STATE_DIR="$RUNTIME_ROOT/agent-factory-cockpit-${UID}-${PORT}"
PID_FILE="$STATE_DIR/server.pid"
LOG_FILE="$STATE_DIR/server.log"
URL="http://$HOST:$PORT"

die() { printf 'factory-cockpit: ERROR: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: factory-cockpit start|stop|restart|status|open|snapshot

Runs a loopback-only human decision view of Gas City and Beads signals.
Monitoring performs zero model calls. Only an explicit typed message can contact
the Mayor; the cockpit cannot interrupt, dispatch, retry, merge, or recover work.
USAGE
}

valid_pid() {
  [[ -s $PID_FILE ]] || return 1
  local pid command_line
  pid=$(<"$PID_FILE")
  [[ $pid =~ ^[1-9][0-9]*$ && -r /proc/$pid/cmdline ]] || return 1
  command_line=$(tr '\0' ' ' <"/proc/$pid/cmdline")
  [[ $command_line == *"$ROOT/lib/factory_cockpit.py serve"* ]]
}

start() {
  command -v "$PYTHON_BIN" >/dev/null || die "python3 is unavailable."
  command -v curl >/dev/null || die "curl is unavailable."
  if valid_pid; then
    printf 'RUNNING: %s (PID %s)\n' "$URL" "$(<"$PID_FILE")"
    return
  fi
  mkdir -p -- "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  nohup "$PYTHON_BIN" -u "$ROOT/lib/factory_cockpit.py" serve \
    --host "$HOST" --port "$PORT" >>"$LOG_FILE" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"
  local attempt
  for attempt in $(seq 1 50); do
    if curl --fail --silent "$URL/health" >/dev/null 2>&1; then
      printf 'STARTED: %s (PID %s)\n' "$URL" "$pid"
      return
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      tail -n 20 "$LOG_FILE" >&2 || true
      rm -f -- "$PID_FILE"
      die "server exited during startup."
    fi
    sleep 0.1
  done
  kill "$pid" 2>/dev/null || true
  rm -f -- "$PID_FILE"
  die "server did not become healthy."
}

stop() {
  if ! valid_pid; then
    rm -f -- "$PID_FILE"
    printf 'STOPPED: no owned cockpit process\n'
    return
  fi
  local pid
  pid=$(<"$PID_FILE")
  kill "$pid"
  local attempt
  for attempt in $(seq 1 50); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f -- "$PID_FILE"
      printf 'STOPPED: PID %s\n' "$pid"
      return
    fi
    sleep 0.1
  done
  die "owned cockpit process $pid did not stop; inspect $LOG_FILE"
}

status() {
  if valid_pid && curl --fail --silent "$URL/health" >/dev/null 2>&1; then
    printf 'RUNNING: %s (PID %s) — monitoring: zero model calls\n' "$URL" "$(<"$PID_FILE")"
    return
  fi
  printf 'STOPPED\n'
  return 1
}

open_cockpit() {
  start
  local powershell=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
  if [[ -x $powershell ]]; then
    "$powershell" -NoProfile -WindowStyle Hidden -Command \
      "Start-Process '$URL'" >/dev/null 2>&1 || true
  fi
  printf 'OPEN: %s\n' "$URL"
}

case ${1:-} in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  open) open_cockpit ;;
  snapshot) exec "$PYTHON_BIN" "$ROOT/lib/factory_cockpit.py" snapshot ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
