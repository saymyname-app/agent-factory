def r6_r7_withdrawal_authorization() -> dict[str, Any]:
    """The fixed R6/R7 occurrences; synthetic trackers may replace ids."""
    raw = os.environ.get(R6_R7_WITHDRAWAL_TEST_ENV) if os.environ.get("CONVOY_STATE_FAKE_TRACKER") else None
    if raw is None:
        return R6_R7_WITHDRAWAL
    try:
        candidate = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    fields = {"ticket", "tip", "exit_at", "parked_at", "response_at", "response_actor", "response_option"}
    tickets = candidate.get("tickets") if isinstance(candidate, dict) else None
    valid = isinstance(candidate, dict) and set(candidate) == {"convoy", "repair_bead", "tickets"} \
        and all(isinstance(candidate.get(name), str) and candidate[name] for name in ("convoy", "repair_bead")) \
        and isinstance(tickets, list) and len(tickets) == 2 \
        and all(isinstance(ticket, dict) and set(ticket) == fields
                and all(isinstance(value, str) and value for value in ticket.values()) for ticket in tickets) \
        and all(ticket["response_option"] == "b" for ticket in tickets) \
        and len({ticket["ticket"] for ticket in tickets}) == 2
    return candidate if valid else {}


def metadata_record(bead: dict[str, Any], key: str) -> dict[str, Any]:
    raw = (bead.get("metadata") or {}).get(key)
    try:
        record = json.loads(raw) if isinstance(raw, str) else None
    except json.JSONDecodeError:
        return {}
    return record if isinstance(record, dict) else {}


def integration_branch_tip(convoy: Convoy) -> str:
    if not convoy.integration or not convoy.repo:
        return ""
    branch = convoy.integration["branch"]
    for ref in (f"refs/remotes/origin/{branch}", f"refs/heads/{branch}"):
        tip = run(["git", "-C", str(convoy.repo), "rev-parse", "--verify", "--quiet",
                   f"{ref}^{{commit}}"]).stdout.strip()
        if tip:
            return tip
    return ""


def exact_returned_release_state(convoy: Convoy, ticket: dict[str, Any], *, parked: bool) -> bool:
    """Whether only D's authorized 6 November parking is still present."""
    authorization = returned_release_authorization()
    if ticket.get("id") != authorization.get("ticket") or ticket.get("status") != "in_progress":
        return False
    park, merge = ticket.get("park"), ticket.get("merge") or {}
    if parked:
        if not isinstance(park, dict) or (park.get("cause"), park.get("origin"), park.get("at")) != (
                PARK_EXHAUSTED, ticket["id"], authorization["parked_at"]):
            return False
    elif park is not None:
        return False
    entries = (ticket.get("resume") or {}).get("entries") or []
    last = entries[-1] if entries and isinstance(entries[-1], dict) else {}
    launches = last.get("launches") or []
    exit_record = last.get("exit") or {}
    expected_ref = f"merge:{merge.get('at')}/exit:{exit_record.get('at')}"
    if ticket.get("resumes_left") != 0 or (last.get("cause"), last.get("ref")) != ("returned", expected_ref) \
            or exit_record.get("exit") != "finished" or len(launches) > (0 if parked else 1):
        return False
    if not parked and launches and read_bead(launches[-1]["bead"]).get("status") == "closed" \
            and last.get("session") == (ticket.get("session") or {}).get("name") and not ticket.get("exit"):
        return False
    if (merge.get("outcome"), merge.get("commit"), merge.get("integration"), merge.get("ticket_commit")) != (
            "red", authorization["merge_commit"], authorization["integration_tip"], ticket.get("tip")):
        return False
    raw_ticket = read_bead(ticket["id"])
    evidence = metadata_record(raw_ticket, "gc.flow.evidence.merged_tests")
    if (evidence.get("commit"), evidence.get("digest")) != (authorization["merge_commit"],
                                                               RETURNED_RELEASE_EVIDENCE):
        return False
    tip = integration_branch_tip(convoy)
    if tip != authorization["integration_tip"]:
        return False
    first_parent = run(["git", "-C", str(convoy.repo), "rev-parse", "--verify", "--quiet",
                        f"{authorization['merge_commit']}^1"]).stdout.strip()
    if first_parent != tip:
        return False
    repair_merge = metadata_record(read_bead(authorization["repair_bead"]), "gc.flow.merge")
    if (repair_merge.get("outcome"), repair_merge.get("ticket_commit")) != (
            "merged", authorization["repair_commit"]):
        return False
    if run(["git", "-C", str(convoy.repo), "merge-base", "--is-ancestor",
            authorization["repair_commit"], tip]).returncode != 0:
        return False
    readiness = delivery_readiness(read_bead(authorization["maintenance_bead"]))
    return bool(readiness["ready"] and readiness["pr_backed"])


def release_exact_returned_parking(convoy: Convoy, ticket: dict[str, Any]) -> list[str]:
    """Remove that one parking by code, descendants first; touch no history."""
    affected = [other["id"] for other in convoy.tickets
                if (other.get("park") or {}).get("origin") == ticket["id"]]
    for ticket_id in [name for name in affected if name != ticket["id"]] + [ticket["id"]]:
        passed(run([GC_BIN, "--city", str(ROOT), "bd", "update", ticket_id,
                    "--unset-metadata", "gc.flow.park"]), f"gc bd update {ticket_id}")
    return sorted(affected)


def exact_returned_result_release_state(ticket: dict[str, Any], *, parked: bool) -> bool:
    """Whether only D's repaired result still waits behind its bound."""
    authorization = returned_result_release_authorization()
    if ticket.get("id") != authorization.get("ticket") or ticket.get("status") != "in_progress" \
            or ticket.get("stop") is not None or ticket.get("technical_repairs") is not None:
        return False
    park, exit_record = ticket.get("park"), ticket.get("exit")
    if parked:
        if not isinstance(park, dict) or (park.get("cause"), park.get("origin"), park.get("at")) != (
                PARK_EXHAUSTED, ticket["id"], authorization["parked_at"]):
            return False
    elif park is not None:
        return False
    if not isinstance(exit_record, dict) or (exit_record.get("exit"), exit_record.get("at"), ticket.get("tip")) != (
            "finished", authorization["exit_at"], authorization["tip"]):
        return False
    entries = (ticket.get("resume") or {}).get("entries") or []
    last = entries[-1] if entries and isinstance(entries[-1], dict) else {}
    launches = last.get("launches") or []
    if (last.get("at"), last.get("cause"), len(launches)) != (
            authorization["resume_at"], "returned", 1) \
            or launches[0].get("bead") != authorization["resume_bead"]:
        return False
    left = ticket.get("resumes_left_by_cause") or {}
    if (ticket.get("counters") or {}).get("resumes") != 13 or ticket.get("resumes_left") != 0 \
            or left.get("returned") != (0 if parked else 3):
        return False
    lifts = ticket.get("park_lifts")
    if not isinstance(lifts, list) or len(lifts) != (4 if parked else 5):
        return False
    expected = (
        ("2026-10-21T02:15:51Z", "operator_request", "2026-10-21T00:35:02Z", ticket["id"], "a", 1, 0),
        ("2026-10-21T16:26:26Z", "planning_exception", "2026-10-21T04:16:56Z", ticket["id"], "a", 2, 0),
        ("2026-10-27T14:10:16Z", PARK_EXHAUSTED, "2026-10-23T16:36:17Z", "af-89ctnv", "a", 8, 0),
        ("2026-10-31T23:42:04Z", "operator_request", "2026-10-31T04:58:15Z", ticket["id"], "a", 10, 2),
    )
    actual = tuple((lift.get("at"), lift.get("cause"), lift.get("parked_at"), lift.get("request"),
                    lift.get("option"), lift.get("resumes"), (lift.get("taken") or {}).get("returned"))
                   for lift in lifts[:4] if isinstance(lift, dict))
    if actual != expected or (not parked and (
            lifts[-1].get("cause"), lifts[-1].get("parked_at"), lifts[-1].get("request"),
            lifts[-1].get("option"), lifts[-1].get("reset_cause")) != (
                PARK_EXHAUSTED, authorization["parked_at"], authorization["repair_bead"], None, "returned")) \
            or any((ticket.get(kind) or {}).get("request")
                                 for kind in ("code_review", "evaluation")):
        return False
    repair = read_bead(authorization["repair_bead"])
    readiness = delivery_readiness(repair)
    return bool(readiness["ready"] and readiness["pr_backed"]
                and (repair.get("metadata") or {}).get("merged_target") == "main")


def release_exact_returned_result(convoy: Convoy, ticket: dict[str, Any]) -> list[str]:
    """Lift D's repaired result while giving back only `returned`."""
    authorization = returned_result_release_authorization()
    answer = state_write("lift-park", convoy.id, ticket["id"], "--request", authorization["repair_bead"],
                         "--reset-cause", "returned")
    return answer["lifted"]


def exact_c2b_release_state(ticket: dict[str, Any]) -> bool:
    """Whether only C2b's authorized exhausted evaluation resume remains."""
    authorization = c2b_release_authorization()
    if ticket.get("id") != authorization.get("ticket") or ticket.get("status") != "in_progress" \
            or ticket.get("exit") is not None or ticket.get("stop") is not None \
            or ticket.get("technical_repairs") is not None:
        return False
    park = ticket.get("park")
    if not isinstance(park, dict) or (park.get("cause"), park.get("origin"), park.get("at")) != (
            PARK_EXHAUSTED, ticket["id"], authorization["parked_at"]):
        return False
    entries = (ticket.get("resume") or {}).get("entries") or []
    last = entries[-1] if entries and isinstance(entries[-1], dict) else {}
    stop = last.get("stop") or {}
    expected_ref = f"integration:{authorization['integration_tip']}/stop:{authorization['stop_at']}"
    if (last.get("at"), last.get("cause"), last.get("ref"), last.get("session"), last.get("launches"),
            stop.get("reason"), stop.get("at")) != (
                authorization["resume_at"], NO_RESULT, expected_ref, authorization["session"], [],
                NO_RESULT, authorization["stop_at"]):
        return False
    if any(entry.get("cause") == REPAIR_DELIVERED for entry in entries if isinstance(entry, dict)) \
            or (ticket.get("session") or {}).get("name") != authorization["session"] \
            or (ticket.get("counters") or {}).get("resumes") != 5 \
            or ticket.get("resumes_left") != 0:
        return False
    left = ticket.get("resumes_left_by_cause") or {}
    if (left.get(NO_RESULT), left.get(REPAIR_DELIVERED)) != (0, 3):
        return False
    for prefix in ("repair", "migration"):
        bead = read_bead(authorization[f"{prefix}_bead"])
        metadata = bead.get("metadata") or {}
        readiness = delivery_readiness(bead)
        if not readiness["ready"] or not readiness["pr_backed"] \
                or metadata.get("gc.merge_commit") != authorization[f"{prefix}_commit"] \
                or metadata.get("gc.github_repo") != authorization[f"{prefix}_repo"] \
                or metadata.get("merged_target") != "main":
            return False
    return True


def release_exact_c2b_parking(convoy: Convoy, ticket: dict[str, Any]) -> list[str]:
    """Relabel C2b's counted resume and remove only its inherited parking."""
    affected = [other["id"] for other in convoy.tickets
                if (other.get("park") or {}).get("origin") == ticket["id"]]
    for ticket_id in [name for name in affected if name != ticket["id"]]:
        passed(run([GC_BIN, "--city", str(ROOT), "bd", "update", ticket_id,
                    "--unset-metadata", "gc.flow.park"]), f"gc bd update {ticket_id}")
    raw_ticket = read_bead(ticket["id"])
    resume = metadata_record(raw_ticket, "gc.flow.resume")
    resume["entries"][-1]["cause"] = REPAIR_DELIVERED
    passed(run([GC_BIN, "--city", str(ROOT), "bd", "update", ticket["id"],
                "--set-metadata", f"gc.flow.resume={json.dumps(resume, ensure_ascii=False)}",
                "--unset-metadata", "gc.flow.park"]), f"gc bd update {ticket['id']}")
    return sorted(affected)


def exact_c2b_result_release_state(ticket: dict[str, Any]) -> bool:
    """Whether only C2b's repaired result still waits behind its bound."""
    authorization = c2b_result_release_authorization()
    if ticket.get("id") != authorization.get("ticket") or ticket.get("status") != "in_progress" \
            or ticket.get("stop") is not None or ticket.get("technical_repairs") is not None:
        return False
    park, exit_record = ticket.get("park"), ticket.get("exit")
    if not isinstance(park, dict) or (park.get("cause"), park.get("origin"), park.get("at")) != (
            PARK_EXHAUSTED, ticket["id"], authorization["parked_at"]):
        return False
    if not isinstance(exit_record, dict) or (exit_record.get("exit"), exit_record.get("at"), ticket.get("tip")) != (
            "finished", authorization["exit_at"], authorization["tip"]):
        return False
    entries = (ticket.get("resume") or {}).get("entries") or []
    last = entries[-1] if entries and isinstance(entries[-1], dict) else {}
    launches = last.get("launches") or []
    if (last.get("at"), last.get("cause"), len(launches)) != (
            authorization["resume_at"], REPAIR_DELIVERED, 1) \
            or launches[0].get("bead") != authorization["resume_bead"]:
        return False
    left = ticket.get("resumes_left_by_cause") or {}
    if (ticket.get("counters") or {}).get("resumes") != 6 or ticket.get("resumes_left") != 0 \
            or left.get(COMMIT_AFTER_VERDICT) != 0:
        return False
    lifts = ticket.get("park_lifts")
    expected_taken = {"behind": 0, "code_review_no_result": 0, "commit_after_verdict": 0,
                      "evaluation_no_result": 0, "inherited_change": 0, "interrupted": 0,
                      "returned": 0, "stage_removed": 0, "unblocked": 0}
    if not isinstance(lifts, list) or len(lifts) != 1:
        return False
    lift = lifts[0]
    if not isinstance(lift, dict) or (
            lift.get("at"), lift.get("cause"), lift.get("parked_at"), lift.get("request"),
            lift.get("option"), lift.get("resumes"), lift.get("taken")) != (
                "2026-11-02T00:51:08Z", "planning_exception", "2026-10-29T09:59:31Z", ticket["id"],
                "c", 0, expected_taken):
        return False
    verdict = ((ticket.get("verdicts") or {}).get("code_review") or {}).get("invalidated") or {}
    if (verdict.get("at"), verdict.get("tip")) != (
            authorization["invalidated_at"], authorization["tip"]):
        return False
    if any((ticket.get(kind) or {}).get("request") for kind in ("code_review", "evaluation")):
        return False
    repair = read_bead(authorization["repair_bead"])
    readiness = delivery_readiness(repair)
    return bool(readiness["ready"] and readiness["pr_backed"]
                and (repair.get("metadata") or {}).get("merged_target") == "main")


def release_exact_c2b_result(convoy: Convoy, ticket: dict[str, Any]) -> list[str]:
    """Lift that result through the native record, resetting only its cause."""
    authorization = c2b_result_release_authorization()
    answer = state_write("lift-park", convoy.id, ticket["id"], "--request", authorization["repair_bead"],
                         "--reset-cause", COMMIT_AFTER_VERDICT)
    return answer["lifted"]


def exact_c2b_evaluation_recovery_state(ticket: dict[str, Any], *, parked: bool) -> bool:
    """Whether C2b is the one request erased before unclaimed routes survived."""
    authorization = c2b_evaluation_recovery_authorization()
    if ticket.get("id") != authorization.get("ticket") or ticket.get("status") != "in_progress" \
            or ticket.get("tip") != authorization.get("tip") or ticket.get("stop") is not None \
            or ticket.get("technical_repairs") is not None:
        return False
    park = ticket.get("park")
    if parked:
        if not isinstance(park, dict) or (park.get("cause"), park.get("origin"), park.get("at")) != (
                PARK_EXHAUSTED, ticket["id"], authorization["parked_at"]):
            return False
    elif park is not None:
        return False
    entries = (ticket.get("resume") or {}).get("entries") or []
    last = entries[-1] if entries and isinstance(entries[-1], dict) else {}
    exit_record = last.get("exit")
    if not isinstance(exit_record, dict) or (exit_record.get("exit"), exit_record.get("at")) != (
            "finished", authorization["exit_at"]):
        return False
    if ticket.get("exit") is not None and ticket.get("exit") != exit_record:
        return False
    old_stop = last.get("stop") or {}
    expected_ref = f"integration:{authorization['integration_tip']}/stop:{authorization['stop_at']}"
    if (last.get("at"), last.get("cause"), last.get("ref"), last.get("session"), last.get("launches"),
            old_stop.get("reason"), old_stop.get("at")) != (
                authorization["resume_at"], NO_RESULT, expected_ref, authorization["session"], [],
                NO_RESULT, authorization["stop_at"]):
        return False
    if (ticket.get("session") or {}).get("name") != authorization["session"] \
            or (ticket.get("counters") or {}).get("resumes") != 7 \
            or ticket.get("resumes_left") != 0 \
            or (ticket.get("resumes_left_by_cause") or {}).get(NO_RESULT) != 0:
        return False
    evaluation = ticket.get("evaluation") or {}
    request = evaluation.get("request")
    if parked and (request is not None or evaluation.get("live")):
        return False
    if not parked and request is not None and (
            request.get("commit") != authorization["tip"] or len(request.get("launches") or []) != 1):
        return False
    lifts = ticket.get("park_lifts") or []
    if len(lifts) != 2 or (lifts[-1].get("cause"), lifts[-1].get("request"),
                           lifts[-1].get("reset_cause")) != (
            PARK_EXHAUSTED, authorization["previous_repair"], COMMIT_AFTER_VERDICT):
        return False
    raw_ticket = read_bead(ticket["id"])
    review = metadata_record(raw_ticket, "gc.flow.code_review")
    rounds = review.get("rounds") or []
    latest = rounds[-1] if rounds and isinstance(rounds[-1], dict) else {}
    blocking = [finding.get("id") for finding in latest.get("findings") or []
                if isinstance(finding, dict) and finding.get("blocking") is True]
    if latest.get("commit") != authorization["tip"] or latest.get("verdict") != "unfavorable" \
            or ",".join(blocking) != authorization["blocking_findings"]:
        return False
    for name in ("first_launch", "cleaned_launch"):
        route = read_bead(authorization[name])
        metadata = route.get("metadata") or {}
        if route.get("status") != "closed" or metadata.get("gc.dispatch_formula") != "mol-ticket-evaluation":
            return False
    repair = read_bead(authorization["repair_bead"])
    readiness = delivery_readiness(repair)
    return bool(readiness["ready"] and readiness["pr_backed"]
                and (repair.get("metadata") or {}).get("merged_target") == "main")


def release_exact_c2b_evaluation(convoy: Convoy, ticket: dict[str, Any]) -> list[str]:
    """Restore the cleaned exit and remove the obsolete parking."""
    affected = [other["id"] for other in convoy.tickets
                if (other.get("park") or {}).get("origin") == ticket["id"]]
    for ticket_id in [name for name in affected if name != ticket["id"]] + [ticket["id"]]:
        argv = [GC_BIN, "--city", str(ROOT), "bd", "update", ticket_id,
                "--unset-metadata", "gc.flow.park"]
        if ticket_id == ticket["id"]:
            exit_record = ticket["resume"]["entries"][-1]["exit"]
            argv += ["--set-metadata", f"gc.flow.exit={json.dumps(exit_record, separators=(',', ':'))}"]
        passed(run(argv), f"gc bd update {ticket_id}")
    return sorted(affected)


def exact_r8_close_release_phase(convoy: Convoy, ticket: dict[str, Any]) -> str | None:
    """The retry phase of the one answered R8 close-without-merge occurrence."""
    authorization = r8_close_release_authorization()
    if authorization.get("response_option") != "a" or ticket.get("id") != authorization.get("ticket") \
            or ticket.get("status") != "in_progress" or ticket.get("tip") != authorization.get("tip") \
            or ticket.get("merge") is not None or any(gate in (ticket.get("gates") or {}) for gate in CLOSING_GATES):
        return None
    park, exit_record = ticket.get("park") or {}, ticket.get("exit") or {}
    if (exit_record.get("exit"), exit_record.get("at")) != (
            "operator_request", authorization.get("exit_at")):
        return None
    entries = (ticket.get("resume") or {}).get("entries") or []
    last = entries[-1] if entries and isinstance(entries[-1], dict) else {}
    launches = last.get("launches") or []
    if (last.get("at"), last.get("cause"), last.get("session"), len(launches),
            launches[0].get("bead") if launches else None,
            (ticket.get("session") or {}).get("name")) != (
                authorization.get("resume_at"), authorization.get("resume_cause"),
                authorization.get("resume_session"), 1,
                authorization.get("resume_bead"), authorization.get("session")):
        return None
    repairs = ticket.get("technical_repairs") or {}
    linked = repairs.get("entries") if isinstance(repairs, dict) else None
    if repairs.get("parked_at") != authorization.get("parked_at") \
            or repairs.get("exit_at") != exit_record.get("at") \
            or not isinstance(linked, list) or [entry.get("id") for entry in linked] != [authorization.get("repair_bead")]:
        return None
    raw = read_bead(ticket["id"])
    metadata = raw.get("metadata") or {}
    if (metadata.get("gc.escalation_response_at"), metadata.get("gc.escalation_response_actor"),
            metadata.get("gc.escalation_response_option")) != (
                authorization.get("response_at"), authorization.get("response_actor"),
                authorization.get("response_option")):
        return None
    repair = read_bead(authorization["repair_bead"])
    readiness = delivery_readiness(repair)
    if not readiness["ready"] or not readiness["pr_backed"] \
            or (repair.get("metadata") or {}).get("merged_target") != "main":
        return None
    if (park.get("cause"), park.get("origin"), park.get("at")) == (
            "operator_request", ticket["id"], authorization.get("parked_at")):
        return "parked" if metadata.get("gc.needs_benjamin") == authorization.get("needs") else None
    if ticket.get("park") is not None:
        return None
    lifts = ticket.get("park_lifts") or []
    lift = lifts[-1] if lifts and isinstance(lifts[-1], dict) else {}
    if (lift.get("cause"), lift.get("parked_at"), lift.get("request"), lift.get("option")) != (
            "operator_request", authorization.get("parked_at"), ticket["id"], authorization.get("response_option")):
        return None
    return "lifted" if metadata.get("gc.needs_benjamin") in (authorization.get("needs"), "none") else None


def repairs_missing_from_integration(convoy: Convoy) -> dict[str, str]:
    """Delivered repairs from this project's protected branch, or merged
    into this integration branch itself (af-41i8d0), that the integration
    tip read here does not contain yet: the take-up fetches and checks again."""
    if not convoy.rig or not convoy.integration:
        return {}
    try:
        project = tomllib.loads((PROJECTS / f"{convoy.rig}.toml").read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise Refusal(f"config/projects/{convoy.rig}.toml illisible : {exc}") from exc
    targets = (convoy.integration.get("protected"), convoy.integration.get("branch"))
    commits: dict[str, str] = {}
    for ticket in convoy.tickets:
        for repair_id in delivered_technical_repairs(ticket, convoy):
            metadata = read_bead(repair_id).get("metadata")
            if isinstance(metadata, dict) and metadata.get("gc.github_repo") == project.get("repo") \
                    and metadata.get("merged_target") in targets:
                commits[repair_id] = metadata["gc.merge_commit"]
    if not commits:
        return {}
    tip = integration_tip(convoy)
    return {repair_id: commit for repair_id, commit in commits.items()
            if not tip or run(["git", "-C", str(convoy.repo), "merge-base", "--is-ancestor", commit, tip]).returncode}


def integration_tip(convoy: Convoy) -> str:
    """The tip of the convoy's integration branch, the remote one first."""
    branch = (convoy.integration or {})["branch"]
    for ref in (f"refs/remotes/origin/{branch}", f"refs/heads/{branch}"):
        tip = run(["git", "-C", str(convoy.repo), "rev-parse", "--verify", "--quiet",
                   f"{ref}^{{commit}}"]).stdout.strip()
        if tip:
            return tip
    return ""


def integration_take_up(convoy: Convoy, *extra: str) -> tuple[dict[str, Any], int]:
    """Run the integration branch's declared control through its native gate."""
    if not convoy.rig:
        raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de "
                      "config/projects : le profil de régression est inconnu")
    proc = run([str(INTEGRATION_BIN), "take-up", convoy.id, "--repo", str(convoy.repo),
                "--profile", str(rig_profile(convoy.rig)), *extra])
    answer = parsed(proc, f"spec-integration take-up {convoy.id}")
    if not isinstance(answer, dict):
        raise Refusal(f"spec-integration take-up {convoy.id} a rendu une réponse illisible")
    kept = ("branch", "integration", "protected_tip", "takeover", "tests", "red", "error", "message", "unruled")
    return {name: answer[name] for name in kept if name in answer}, proc.returncode


def take_up_delivered_repairs(convoy: Convoy) -> dict[str, Any] | None:
    """Use the integration gate before releasing a same-repository repair."""
    missing = repairs_missing_from_integration(convoy)
    if not missing:
        return None
    try:
        result, returncode = integration_take_up(convoy)
    except Refusal as exc:
        return {"repairs": sorted(missing), "error": f"refus : {exc}"}
    result["repairs"] = sorted(missing)
    if returncode != 0 and "error" not in result:
        result["error"] = f"refus : spec-integration take-up {convoy.id} a échoué (exit {returncode})"
    elif returncode == 0:
        still_missing = repairs_missing_from_integration(convoy)
        if still_missing:
            result["error"] = "refus : réparation(s) livrée(s) absente(s) de la branche d'intégration après reprise : " \
                + ", ".join(sorted(still_missing))
    return result


def red_repair_left(convoy: Convoy, ticket_id: str, green: str) -> dict[str, Any] | None:
    """The open repair `ticket_id` of an integration red whose author left
    by an operator request with nothing to merge: its branch is in
    `green`, the integration commit its control is (or is to be) run on."""
    ticket = next((entry for entry in convoy.tickets if entry["id"] == ticket_id), None)
    if ticket is None or ticket.get("status") == "closed" or ticket.get("kind") != "repair" \
            or ticket.get("merge") is not None or any(gate in (ticket.get("gates") or {}) for gate in CLOSING_GATES):
        return None
    exit_record, park = ticket.get("exit") or {}, ticket.get("park") or {}
    if exit_record.get("exit") != "operator_request" or not exit_record.get("at"):
        return None
    # Parked by its own request, or lifted by a pass that stopped before
    # the close: never parked behind another ticket.
    if park and (park.get("origin"), park.get("cause")) != (ticket["id"], "operator_request"):
        return None
    tip = ticket.get("tip")
    if not green or (tip and run(["git", "-C", str(convoy.repo), "merge-base", "--is-ancestor",
                                  tip, green]).returncode != 0):
        return None
    return ticket


def close_red_repair(convoy: Convoy, ticket: dict[str, Any], reason: str) -> list[str]:
    """Close a red's repair without merge, its green control as the proof:
    its own parking lifted, a live request cleared. Returns the lifted."""
    lifted: list[str] = []
    if ticket.get("park"):
        repairs = [part for repair in delivered_technical_repairs(ticket, convoy) for part in ("--repair", repair)]
        lifted = state_write("lift-park", convoy.id, ticket["id"], "--request", ticket["id"], *repairs,
                             "--withdrawing")["lifted"]
    if (read_bead(ticket["id"]).get("metadata") or {}).get("gc.needs_benjamin") not in (None, "none"):
        passed(run([str(ESCALATION_BIN), "clear", ticket["id"]]), "escalation-door clear")
    state_write("withdraw-ticket", convoy.id, ticket["id"], "--reason", reason)
    return lifted


def green_red_repair(convoy: Convoy) -> dict[str, Any] | None:
    """The open repair of the integration red whose author left by an
    operator request with nothing to merge (its branch is in the
    integration tip), not replayed yet for that exit: the red did not
    reproduce for its author, and code alone says whether it still holds."""
    red = convoy.red or {}
    if not convoy.integration or "repair" not in red:
        return None
    ticket = red_repair_left(convoy, red["repair"], integration_tip(convoy))
    if ticket is None or red.get("replay") == ticket["exit"]["at"]:
        return None
    return ticket


def close_green_red_repair(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §8, a red that does not reproduce (af-3p6iz7): code runs the
    red control again on the current integration tip, the protected branch
    taken up. Green: the repair is closed without merge, the replay as its
    proof, and the red withdrawn. Red: the red is recorded again with that
    exit as replayed, and the repair stays open on it, as any repair."""
    ticket = green_red_repair(convoy)
    if ticket is None:
        return None
    exit_at = ticket["exit"]["at"]
    try:
        replay, returncode = integration_take_up(convoy, "--red-repair", ticket["id"], "--replay", exit_at)
        if returncode != 0:
            if "red" not in replay:
                detail = replay.get("error") or replay.get("message") or f"exit {returncode}"
                raise Refusal(f"spec-integration take-up {convoy.id} a échoué : {detail}")
            replay.pop("error", None)
            convoy.load()
            return {"ticket": ticket["id"], "closed": False, **replay}
        tests = replay.get("tests") or {}
        lifted = close_red_repair(convoy, ticket, (
            f"rouge non reproduit, clos sans fusion par le code : {tests.get('command')} "
            f"code {tests.get('exit_code')} sur {replay.get('branch')} au commit {tests.get('commit')} "
            f"({convoy.integration.get('protected')} reprise au {replay.get('protected_tip')}), "
            f"sortie rejouée {exit_at}, rien à fusionner"))
        state_write("clear-integration-red", convoy.id)
        convoy.load()
    except Refusal as exc:
        return {"ticket": ticket["id"], "error": f"refus : {exc}"}
    return {"ticket": ticket["id"], "closed": True, "lifted": lifted, **replay}


def close_cleared_red_repair(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §8, a red a control already found green again (af-6vhm6r): a
    tip moved, `spec-integration merge` ran the red control, green, and
    withdrew the red while its repair was open. That repair, its author
    gone by an operator request with nothing to merge (its branch in that
    green commit), is closed without merge, that control as its proof;
    nothing is replayed. A repair of the red recorded now is not touched."""
    cleared = convoy.red_cleared
    if not convoy.integration or cleared is None or (convoy.red or {}).get("repair") == cleared["repair"]:
        return None
    ticket = red_repair_left(convoy, cleared["repair"], cleared["commit"])
    if ticket is None:
        return None
    try:
        lifted = close_red_repair(convoy, ticket, (
            f"rouge déjà retiré, clos sans fusion par le code : {cleared['command']} code 0 sur "
            f"{convoy.integration.get('branch')} au commit {cleared['commit']} "
            f"({convoy.integration.get('protected')} reprise au {cleared['protected']}), "
            f"sortie {ticket['exit']['at']}, rien à fusionner"))
        convoy.load()
    except Refusal as exc:
        return {"ticket": ticket["id"], "error": f"refus : {exc}"}
    return {"ticket": ticket["id"], "closed": True, "lifted": lifted,
            "tests": {"command": cleared["command"], "exit_code": 0, "commit": cleared["commit"]},
            "protected_tip": cleared["protected"]}


def close_exact_answered_r8(convoy: Convoy) -> dict[str, Any] | None:
    """Execute Benjamin's recorded R8 close-without-merge choice once."""
    found = next(((entry, phase) for entry in convoy.tickets
                  if (phase := exact_r8_close_release_phase(convoy, entry)) is not None), None)
    if found is None:
        return None
    ticket, phase = found
    authorization = r8_close_release_authorization()
    try:
        replay: dict[str, Any] = {}
        lifted: list[str] = []
        if phase == "parked":
            replay, returncode = integration_take_up(convoy)
            if returncode != 0 and "red" not in replay:
                detail = replay.get("error") or replay.get("message") or f"exit {returncode}"
                raise Refusal(f"spec-integration take-up {convoy.id} a échoué : {detail}")
            # A red control is a definitive replay result, not a failure of this
            # transition. The existing integration-stop path publishes its one repair.
            if "red" in replay:
                replay.pop("error", None)
            lifted = state_write("lift-park", convoy.id, ticket["id"], "--request", ticket["id"],
                                 "--option", authorization["response_option"], "--withdrawing")["lifted"]
            convoy.load()
            ticket = convoy.ticket(ticket["id"])
        metadata = read_bead(ticket["id"]).get("metadata") or {}
        if metadata.get("gc.needs_benjamin") != "none":
            passed(run([str(ESCALATION_BIN), "clear", ticket["id"]]), "escalation-door clear")
        state_write("withdraw-ticket", convoy.id, ticket["id"], "--reason",
                    "choix a de Benjamin : clore R8 sans fusion après le contrôle d'intégration")
        convoy.load()
    except Refusal as exc:
        return {"ticket": ticket["id"], "repair": authorization["repair_bead"], "error": f"refus : {exc}"}
    return {"ticket": ticket["id"], "repair": authorization["repair_bead"], "lifted": lifted, **replay}


def withdraw_exact_answered_r6_r7(convoy: Convoy) -> dict[str, Any] | None:
    """Consume the two recorded option-b withdrawals, and nothing nearby."""
    authorization = r6_r7_withdrawal_authorization()
    if convoy.id != authorization.get("convoy"):
        return None
    repair_id = authorization["repair_bead"]
    repair = read_bead(repair_id)
    readiness = delivery_readiness(repair)
    if not readiness["ready"] or not readiness["pr_backed"] \
            or (repair.get("metadata") or {}).get("merged_target") != "main":
        return None

    by_id = {ticket["id"]: ticket for ticket in convoy.tickets}
    pending: list[tuple[dict[str, Any], dict[str, str], dict[str, Any]]] = []
    problems: list[str] = []
    for expected in authorization["tickets"]:
        ticket_id = expected["ticket"]
        ticket = by_id.get(ticket_id)
        if ticket is None:
            problems.append(f"{ticket_id}: absent du convoi")
            continue
        raw = read_bead(ticket_id)
        metadata = raw.get("metadata") or {}
        withdrawn = ticket.get("status") == "closed" and "withdrawn" in (ticket.get("gates") or {})
        checks = {
            "statut": withdrawn or ticket.get("status") == "in_progress",
            "pointe": ticket.get("tip") == expected["tip"],
            "sortie": (ticket.get("exit") or {}).get("exit") == "planning_exception"
                      and (ticket.get("exit") or {}).get("at") == expected["exit_at"],
            "parcage": (ticket.get("park") or {}).get("cause") == "planning_exception"
                        and (ticket.get("park") or {}).get("origin") == ticket_id
                        and (ticket.get("park") or {}).get("at") == expected["parked_at"],
            "réponse": (
                metadata.get("gc.escalation_response_at"),
                metadata.get("gc.escalation_response_actor"),
                metadata.get("gc.escalation_response_option"),
            ) == (expected["response_at"], expected["response_actor"], expected["response_option"]),
            "absence de fusion": ticket.get("merge") is None,
            "absence d'autre fermeture": withdrawn or not any(
                gate in (ticket.get("gates") or {}) for gate in CLOSING_GATES
            ),
            "demande": metadata.get("gc.needs_benjamin") in ("none", (ticket.get("park") or {}).get("detail")),
        }
        failed = [name for name, holds in checks.items() if not holds]
        if failed:
            problems.append(f"{ticket_id}: précondition divergente ({', '.join(failed)})")
        elif not withdrawn:
            pending.append((ticket, expected, raw))
    if problems:
        return {"repair": repair_id, "withdrawn": [], "error": "refus : retrait R6/R7 : " + "; ".join(problems)}
    if not pending:
        return None

    withdrawn_ids: list[str] = []
    cleared: list[str] = []
    try:
        for ticket, expected, raw in pending:
            if (raw.get("metadata") or {}).get("gc.needs_benjamin") != "none":
                passed(run([str(ESCALATION_BIN), "clear", ticket["id"]]), "escalation-door clear")
                cleared.append(ticket["id"])
            state_write(
                "withdraw-ticket", convoy.id, ticket["id"], "--reason",
                f"choix b de Benjamin du {expected['response_at']} : retirer {ticket['id']} du graphe "
                f"après livraison prouvée de {repair_id}",
            )
            withdrawn_ids.append(ticket["id"])
        convoy.load()
    except Refusal as exc:
        return {"repair": repair_id, "withdrawn": withdrawn_ids, "cleared": cleared, "error": f"refus : {exc}"}
    return {"repair": repair_id, "withdrawn": withdrawn_ids, "cleared": cleared}


def evaluation_repair_due(convoy: Convoy, ticket: dict[str, Any]) -> tuple[str, str, str] | None:
    """One resume for an evaluation stop once every explicitly
    linked Factory repair has structural delivery proof."""
    repairs = delivered_technical_repairs(ticket, convoy)
    if not repairs or ticket.get("resumes_left") == 0:
        return None
    ref = hashlib.sha256(",".join(repairs).encode("utf-8")).hexdigest()[:16]
    return "new", REPAIR_DELIVERED, f"repairs:{ref}/stop:{ticket['stop']['at']}"


def green_at(ticket: dict[str, Any], tip: str) -> bool:
    """The green proof of bin/tdd-step (the regression of a prefactoring)
    is at `tip`, as bin/code-review and bin/ticket-evaluation read it."""
    step = "prefactoring" if ticket.get("kind") == "prefactoring" else "green"
    return ((ticket.get("tdd") or {}).get(step) or {}).get("commit") == tip


def untaken_resume(ticket: dict[str, Any]) -> dict[str, Any] | None:
    """The last resume of the ticket when nobody took the ticket since it
    was counted: no Ticket Exit, the same session as when it was counted."""
    entries = (ticket.get("resume") or {}).get("entries") or []
    last = entries[-1] if entries else None
    if last and not (ticket.get("exit") or {}).get("exit") \
            and last.get("session") == (ticket.get("session") or {}).get("name"):
        return last
    return None


def waiting_since(ticket: dict[str, Any]) -> str | None:
    """When the resume counted on a ticket at work, and sent to no session
    yet, was counted (a `behind` one is counted under a full ceiling): it
    takes the next free author place before any other start or resume
    (af-u21377). None for any other ticket."""
    last = untaken_resume(ticket) if at_work(ticket) else None
    return last.get("at") if last and not last["launches"] else None


def resume_due(ticket: dict[str, Any], alive: set[str]) -> tuple[str, str, str] | None:
    """What the pass owes a ticket at work, read on the tracker alone:
    ("new", cause, ref) a fact that asks for a resume not counted yet;
    ("launch", cause, ref) a counted resume no session was sent for; None
    nothing, or a session on its way."""
    exit_record = ticket.get("exit") or {}
    exit_name, exit_at = exit_record.get("exit"), exit_record.get("at")
    session = (ticket.get("session") or {}).get("name")
    last = untaken_resume(ticket)
    if last:
        # Nobody took the ticket since its last resume was counted.
        if not last["launches"]:
            return "launch", last["cause"], last["ref"]
        sent = last["launches"][-1]["bead"]
        if read_bead(sent).get("status") == "closed":
            return "new", "interrupted", f"launch:{sent}"
        return None
    if exit_name == "interrupted":
        return "new", "interrupted", f"session:{session}" if session else f"exit:{exit_at}"
    if exit_name == "technically_blocked":
        return None if open_blockers(ticket["id"]) else ("new", "unblocked", f"exit:{exit_at}")
    released_repairs = released_technical_repairs(ticket)
    if exit_name == "operator_request" and released_repairs:
        repairs = ",".join(released_repairs)
        ref = hashlib.sha256(repairs.encode("utf-8")).hexdigest()[:16]
        return "new", REPAIR_DELIVERED, f"repairs:{ref}/exit:{exit_at}"
    if exit_name in PARKING_EXITS:
        # Its parking was lifted: the answer goes to a fresh session.
        return "new", "answered", f"exit:{exit_at}"
    if exit_name == "finished":
        merge = ticket.get("merge") or {}
        if merge.get("outcome") in RETURNED_MERGES and merge.get("ticket_commit") == ticket.get("tip"):
            return "new", "returned", f"merge:{merge.get('at')}/exit:{exit_at}"
        tip, handoff = ticket.get("tip"), ticket.get("handoff") or {}
        merged = merge.get("outcome") == "merged" and merge.get("ticket_commit") == tip
        if tip and not merged and handoff.get("partial") is False and handoff.get("commit") == tip \
                and not green_at(ticket, tip):
            # Finished without its green at the tip: neither the review nor the
            # Ticket Evaluation ever takes it, its author replays it (af-1row55).
            return "new", "returned", f"unproven:{tip}/exit:{exit_at}"
        return None
    if exit_name is None and ticket.get("status") == "in_progress" and session and session not in alive:
        # Spec §5: a session that died without an exit is read as interrupted.
        return "new", "interrupted", f"session:{session}"
    return None


def launch_resume(convoy: Convoy, ticket_id: str, cause: str, rig: str, settings: dict[str, Any]) -> str:
    """Send the resume to one fresh author session: a bead of its own,
    routed through the dispatch door."""
    created = gc_json(
        "bd", "create", f"Reprise — {ticket_id}", "-p", "1", "-t", "task", "-d",
        f"Resume of ticket {ticket_id} by a fresh author session, on the same branch ({cause}).\n\n"
        f"convoy: {convoy.id}\nticket: {ticket_id}\ncause: {cause}\n", "--json")
    if isinstance(created, list):
        created = created[0] if created else None
    bead_id = created.get("id") if isinstance(created, dict) else None
    if not isinstance(bead_id, str) or not bead_id:
        raise Refusal("gc bd create n'a pas rendu l'identifiant du bead de la reprise")
    argv = [str(DOOR_BIN), bead_id, "--rig", rig, "--formula", settings["resume"]["formula"]]
    if settings["resume"]["role"]:
        argv += ["--role", settings["resume"]["role"]]
    routed = run(argv)
    if routed.returncode != 0:
        run([GC_BIN, "--city", str(ROOT), "bd", "close", bead_id, "--reason",
             "Reprise non routée par la porte de dispatch."])
        reason = (routed.stderr.strip() or routed.stdout.strip() or f"exit {routed.returncode}").splitlines()[-1]
        raise Deferred(reason) if routed.returncode == DOOR_DEFERRED else Refusal(reason)
    state_write("launch-resume", convoy.id, ticket_id, "--bead", bead_id)
    return bead_id


def failed_merged_tests(convoy: Convoy, ticket: dict[str, Any], commit: Any) -> list[str]:
    """The tests the piece `merged_tests` captured red on the merged result
    `commit`, as bin/ci-run-tests names them (`FAILED: <file>`). Empty when
    the piece is not readable or names none: never in the way of the park."""
    try:
        proc = run([str(CAPTURE_BIN), "verify", convoy.id, ticket["id"], "--piece", MERGED_TESTS_PIECE])
        piece = json.loads(proc.stdout)["pieces"][0]
        output = json.loads(Path(piece["path"]).read_text(encoding="utf-8"))["output"]
    except (Refusal, OSError, KeyError, IndexError, TypeError, UnicodeDecodeError, json.JSONDecodeError):
        return []
    if proc.returncode != 0 or piece.get("commit") != commit or not isinstance(output, str):
        return []
    return [line[len("FAILED: "):].strip() for line in output.splitlines() if line.startswith("FAILED: ")]


def park_exhausted(convoy: Convoy, ticket: dict[str, Any]) -> dict[str, Any]:
    """Spec §8: park the ticket that took the last resume of a same cause
    (ADR-0030 L2). The detail names that cause, the cause of the last resume
    recorded and, for a merge whose tests were red, the first tests that
    failed: the grouped request carries it (af-w6xtw0)."""
    resumes = (ticket.get("counters") or {}).get("resumes")
    left = ticket.get("resumes_left_by_cause") or {}
    exhausted = ", ".join(cause for cause, count in left.items() if count == 0)
    named = f" pour la cause {exhausted}" if exhausted else ""
    detail = f"reprises épuisées{named} ({resumes} reprises en tout) : le ticket ne redémarre plus"
    if left.get(BEHIND) == 0:
        # Only a branch that did not take a tip it was already resumed for
        # counts for `behind` (af-npz9v1.36).
        detail += " ; behind : une même pointe d'intégration reprise sans être prise"
    # A commit after a verdict (T18) counts a resume without an entry: the
    # detail names the last one recorded.
    entries = (ticket.get("resume") or {}).get("entries") or []
    if entries:
        detail += f" ; dernière reprise enregistrée : {entries[-1]['cause']}"
        merge = ticket.get("merge") or {}
        if entries[-1]["cause"] == "returned" and merge.get("outcome") == "red":
            failed = failed_merged_tests(convoy, ticket, merge.get("commit"))
            named = ", ".join(failed[:3]) + (", …" if len(failed) > 3 else "")
            suffix = f" : {named}" if named else ""
            detail += f" (tests rouges sur le résultat fusionné {str(merge.get('commit'))[:12]}{suffix})"
    answer = state_write("park", convoy.id, ticket["id"], "--cause", PARK_EXHAUSTED, "--detail", one_line(detail, 400))
    return {"id": ticket["id"], "cause": PARK_EXHAUSTED, "parked": answer["parked"]}


def behind_due(convoy: Convoy, ticket: dict[str, Any]) -> tuple[str, str, str] | None:
    """Spec §6: the code review is not sent on a branch that does not hold
    the tip of the integration branch. bin/code-review says so (`behind` of
    its `show`, read only); the ticket goes back to its author, once per
    exit, to take that tip."""
    exit_record = ticket.get("exit") or {}
    if exit_record.get("exit") != "finished" or (ticket.get("merge") or {}).get("outcome") == "merged":
        return None
    if not convoy.repo or not convoy.integration:
        return None
    answer = parsed(run([str(CODE_REVIEW_BIN), "show", convoy.id, ticket["id"], "--repo", str(convoy.repo)]),
                    f"code-review show {convoy.id} {ticket['id']}")
    behind = answer.get("behind") if isinstance(answer, dict) else None
    if not isinstance(behind, dict):
        return None
    return "new", BEHIND, f"integration:{behind.get('integration')}/exit:{exit_record.get('at')}"


def stopped_without_result(ticket: dict[str, Any]) -> bool:
    """Started, not closed nor parked, and stopped because its Ticket
    Evaluation or its code review gave no result, by a stage the flow
    removed, at its second amendment, for an evaluation outage carrying
    an explicit technical-repair link, or all green on a repair that moves a
    proof (af-oa2ci4) or on one run of each test (af-batj8g): the stops a
    resume may lift."""
    reason = (ticket.get("stop") or {}).get("reason")
    return started(ticket) and ticket.get("status") != "closed" and not ticket.get("park") \
        and (reason in (NO_RESULT, CODE_REVIEW_STOP, AMENDMENT_STOP, *REMOVED_STAGE_STOPS)
             or (reason == EVALUATION_OUTAGE and technical_repairs(ticket))
             or (reason == ALREADY_GREEN and (moves_a_proof(ticket) or green_seen_once(ticket["stop"]))))


def amendment_granted_due(ticket: dict[str, Any]) -> tuple[str, str, str] | None:
    """The resume a stop at the second amendment asks for once the operator
    answered its request with the option that has the ticket resumed
    (af-25o7vr): once per stop, none on any other answer, none before the
    request was raised and answered, none when the ticket has no resume
    left. The fact is `stop:<reason>/<time>`."""
    stop = ticket["stop"]
    if "raised" not in stop or ticket.get("resumes_left") == 0:
        return None
    if stop_answer(read_bead(ticket["id"]), stop) != AMENDMENT_RESUME_OPTION:
        return None
    return "new", AMENDMENT_GRANTED, f"stop:{stop['reason']}/{stop['at']}"


def preauthorized_amendment_due(convoy: Convoy, ticket: dict[str, Any]) -> tuple[str, str, str] | None:
    """The one A2 answer recorded before its amendment stop existed.

    It is valid only at the already-produced commit and only when
    ``tdd-step changes`` names the two authorized files. The authorization
    marker on the native resume makes the response single-use and lets
    ``tdd-step amend`` keep the same boundary after the author resumes.
    """
    stop = ticket["stop"]
    authorization = PREAUTHORIZED_AMENDMENT
    if ticket["id"] != authorization["ticket"] or ticket.get("resumes_left") == 0 or not ticket.get("tip"):
        return None
    metadata = read_bead(ticket["id"]).get("metadata") or {}
    if (metadata.get("gc.escalation_response_actor"), metadata.get("gc.escalation_response_option"),
            metadata.get("gc.escalation_response_at")) != (
                authorization["actor"], authorization["option"], authorization["answered_at"]):
        return None
    entries = (ticket.get("resume") or {}).get("entries") or []
    if any(str(entry.get("ref", "")).endswith(f"/{authorization['ref']}") for entry in entries):
        return None
    try:
        proc = run([str(TDD_STEP_BIN), "changes", convoy.id, ticket["id"], "--repo", str(convoy.repo),
                    "--profile", str(rig_profile(convoy.rig)), "--at", ticket["tip"]])
        answer = json.loads(proc.stdout)
    except (Refusal, json.JSONDecodeError):
        return None
    if proc.returncode != 0 or not isinstance(answer, dict) or answer.get("commit") != authorization["commit"] \
            or sorted(answer.get("own") or []) != sorted(authorization["files"]):
        return None
    return ("new", AMENDMENT_GRANTED,
            f"stop:{stop['reason']}/{stop['at']}/{authorization['ref']}")


def inherited_change_due(convoy: Convoy, ticket: dict[str, Any]) -> tuple[str, str, str] | None:
    """The resume a stop at the second amendment asks for when, at the
    tip, no frozen file and no file of the test perimeter changed since the
    freeze but as the base the branch merged holds it (af-npz9v1.39): once
    per stop, none once the operator answered it, none when the ticket has
    no resume left, none when bin/tdd-step cannot say. The fact is
    `stop:<reason>/<time>`."""
    stop = ticket["stop"]
    if ticket.get("resumes_left") == 0 or not ticket.get("tip"):
        return None
    if stop_answer(read_bead(ticket["id"]), stop) is not None:
        return None
    try:
        proc = run([str(TDD_STEP_BIN), "changes", convoy.id, ticket["id"], "--repo", str(convoy.repo),
                    "--profile", str(rig_profile(convoy.rig)), "--at", ticket["tip"]])
        answer = json.loads(proc.stdout)
    except (Refusal, json.JSONDecodeError):
        return None
    if proc.returncode != 0 or not isinstance(answer, dict) or answer.get("own") != [] or not answer.get("inherited"):
        return None
    return "new", INHERITED_CHANGE, f"stop:{stop['reason']}/{stop['at']}"


def once_per_stop_due(ticket: dict[str, Any], cause: str) -> tuple[str, str, str] | None:
    """The resume a stop of a removed stage, or of a code review without
    result, asks for: once per stop, none once the operator answered it,
    none when the ticket has no resume left (its stop stays with the
    operator). The fact is `stop:<reason>/<time>`."""
    stop = ticket["stop"]
    if ticket.get("resumes_left") == 0 or stop_answer(read_bead(ticket["id"]), stop) is not None:
        return None
    return "new", cause, f"stop:{stop['reason']}/{stop['at']}"


def no_result_due(convoy: Convoy, ticket: dict[str, Any]) -> tuple[str, str, str] | None:
    """The resume a stop without evaluation result asks for: none once the
    operator answered that stop, none when the ticket has no resume left
    (its stop stays with the operator), and one per tip of the integration
    branch, what a repair of the factory merged since may have changed. The
    fact is `integration:<tip>/stop:<stop time>`."""
    stop = ticket["stop"]
    if ticket.get("resumes_left") == 0 or not convoy.integration:
        return None
    if stop_answer(read_bead(ticket["id"]), stop) is not None:
        return None
    branch = convoy.integration["branch"]
    # Where bin/code-review reads it: on origin when it is there, else local.
    for ref in (f"refs/remotes/origin/{branch}", f"refs/heads/{branch}"):
        tip = run(["git", "-C", str(convoy.repo), "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"]).stdout.strip()
        if tip:
            break
    else:
        return None
    entries = (ticket.get("resume") or {}).get("entries") or []
    if any(entry["cause"] == NO_RESULT and entry["ref"].startswith(f"integration:{tip}/") for entry in entries):
        return None
    return "new", NO_RESULT, f"integration:{tip}/stop:{stop['at']}"


def settle_resumes(convoy: Convoy, settings: dict[str, Any], free: int, alive: set[str], out: dict[str, Any],
                   only: set[str] | None = None) -> None:
    """Spec §8: park the ticket that took its last resume; send the ticket
    that needs its author again to one fresh session, and count it. `only`:
    the tickets a red integration branch still lets go on."""
    candidates = [t for t in convoy.tickets if at_work(t) or stopped_without_result(t) or overridden_at_work(t)]
    # A resume already counted and waiting for its session is served first,
    # the longest waiting first; the others keep the convoy's order
    # (af-u21377: R11, listed last, waited five hours behind the others).
    candidates.sort(key=lambda t: (waiting_since(t) is None, waiting_since(t) or ""))
    for ticket_id in [t["id"] for t in candidates]:
        if only is not None and ticket_id not in only:
            continue
        try:
            ticket = convoy.ticket(ticket_id)
            stopped = bool(ticket.get("stop"))
            released_once = exact_returned_release_state(convoy, ticket, parked=False) \
                or exact_returned_result_release_state(ticket, parked=False) \
                or exact_c2b_evaluation_recovery_state(ticket, parked=False)
            if ticket.get("resumes_left") == 0 and not stopped and not released_once:
                out["parked"].append(park_exhausted(convoy, ticket))
                convoy.load()
                continue
            if not stopped:
                due = resume_due(ticket, alive) or behind_due(convoy, ticket)
            elif ticket["stop"]["reason"] in REMOVED_STAGE_STOPS:
                due = once_per_stop_due(ticket, STAGE_REMOVED)
            elif ticket["stop"]["reason"] == CODE_REVIEW_STOP:
                due = once_per_stop_due(ticket, CODE_REVIEW_STOP)
            elif ticket["stop"]["reason"] == ALREADY_GREEN:
                due = once_per_stop_due(ticket, PROOF_MOVED if moves_a_proof(ticket) else RED_REPLAYED)
            elif ticket["stop"]["reason"] == AMENDMENT_STOP:
                due = preauthorized_amendment_due(convoy, ticket) or amendment_granted_due(ticket) \
                    or inherited_change_due(convoy, ticket)
            elif ticket["stop"]["reason"] in EVALUATION_STOPS and technical_repairs(ticket):
                due = evaluation_repair_due(convoy, ticket)
            elif ticket["stop"]["reason"] == EVALUATION_OUTAGE:
                due = None
            elif overridden_at_work(ticket):
                # Only the merge that returned it lifts its stop; no resume left, it stays with the operator.
                due = resume_due(ticket, alive) if ticket.get("resumes_left") != 0 else None
                due = due if due and due[1] == "returned" else None
            else:
                due = no_result_due(convoy, ticket)
            if due is None:
                continue
            what, cause, ref = due
            rig = convoy.rigs.get(ticket_id)
            if not settings["resume"]:
                raise Refusal("aucune formule de reprise (resume.formula) dans config/delivery-flow.json : "
                              f"le ticket attend une reprise ({cause}) que rien ne peut lancer")
            if not rig:
                raise Refusal("le ticket ne nomme pas un seul projet connu de config/projects sous « Target rigs »")
            full = len(out["started"]) + len(out["resumed"]) >= free
            # A branch behind is recorded at once, session or not: its exit
            # is taken back, so neither the review nor the Ticket Evaluation
            # is sent on the old tip while the ticket waits for a session.
            if full and (what, cause) != ("new", BEHIND):
                out["waiting"].append({"id": ticket_id, "reason": f"reprise ({cause}) : plafond N={settings['ceiling']} atteint"})
                continue
            if what == "new":
                if stopped and "raised" in ticket["stop"]:
                    # The resume lifts the stop: its request leaves the operator's list.
                    passed(run([str(ESCALATION_BIN), "clear", ticket_id]), "escalation-door clear")
                    # The answer and clear share the door lock. An answer may
                    # have landed after the due check but before clear won it.
                    if cause in (NO_RESULT, STAGE_REMOVED, CODE_REVIEW_STOP, PROOF_MOVED, RED_REPLAYED) \
                            and stop_answer(read_bead(ticket_id), ticket["stop"]) is not None:
                        continue
                elif cause == REPAIR_DELIVERED and released_technical_repairs(ticket):
                    # The parking was removed first. If clearing refuses or
                    # this pass is interrupted, the request remains and the
                    # next pass retries before opening the resume.
                    passed(run([str(ESCALATION_BIN), "clear", ticket_id]), "escalation-door clear")
                state_write("open-resume", convoy.id, ticket_id, "--cause", cause, "--ref", ref)
                convoy.load()
                ticket = convoy.ticket(ticket_id)
                if ticket.get("resumes_left") == 0:
                    # The last of its cause: parked with its descendants, not restarted.
                    out["parked"].append(park_exhausted(convoy, ticket))
                    convoy.load()
                    continue
            if full:
                out["waiting"].append({"id": ticket_id, "reason": f"reprise ({cause}) : plafond N={settings['ceiling']} atteint"})
                continue
            bead_id = launch_resume(convoy, ticket_id, cause, rig, settings)
            out["resumed"].append({"id": ticket_id, "cause": cause, "bead": bead_id})
            convoy.load()
        except Deferred as exc:
            out["deferred"].append({"id": ticket_id, "reason": str(exc)})
        except Refusal as exc:
            out["refused"].append({"id": ticket_id, "reason": str(exc)})


def count_request_open(ticket: dict[str, Any]) -> bool:
    """A ticket stopped at the bound whose request, raised before ADR-0035
    for the count alone, is still open and unanswered: bin/correction-round
    settle wakes the Mayor and withdraws it, once (af-npz9v1.40)."""
    if not ticket.get("correction") or ticket.get("correction_rounds_left"):
        return False
    metadata = read_bead(ticket["id"]).get("metadata") or {}
    return metadata.get("gc.needs_benjamin") not in (None, "none") \
        and metadata.get("gc.escalation_pourquoi") == STOP_COUNT_WHY


def request_answer(bead: dict[str, Any], since: str) -> str | None:
    """The letter the operator answered a request with
    (bin/escalation-door repondre), once it is no longer open."""
    metadata = bead.get("metadata") or {}
    option, at = metadata.get("gc.escalation_response_option"), metadata.get("gc.escalation_response_at")
    if metadata.get("gc.needs_benjamin") not in (None, "none") or not isinstance(option, str) or not isinstance(at, str):
        return None
    return option if at >= since else None


def stop_answer(bead: dict[str, Any], stop: dict[str, Any]) -> str | None:
    """The letter the operator answered the request of a ticket's stop
    with: the request the escalation door put on the operator's list for
    that stop -- stamped after the stop, before the stop recorded it was
    raised -- and an answer given since that request. Never the answer to an
    earlier request of the same bead, a Planning Exception or another stop,
    even one given after the stop (af-vm0vua, R12: its answer to the
    Planning Exception held its proof_moved resume forever)."""
    metadata = bead.get("metadata") or {}
    asked = metadata.get("gc.escalation_horodatage")
    if "raised" not in stop or not isinstance(asked, str) or not stop["at"] <= asked <= stop["raised"]:
        return None
    return request_answer(bead, asked)


def legacy_repair_resume_due(ticket: dict[str, Any]) -> bool:
    """The af-o5ritb state already written before `repair_delivered` existed:
    the delivered-repair resume exhausted `unblocked` but was never launched."""
    park = ticket.get("park") or {}
    resume = ticket.get("resume") or {}
    entries = resume.get("entries") or []
    if not entries and isinstance(resume.get("raw"), str):
        try:
            entries = json.loads(resume["raw"]).get("entries") or []
        except (json.JSONDecodeError, AttributeError):
            return False
    if not isinstance(entries, list) or not entries or not isinstance(entries[-1], dict):
        return False
    last = entries[-1]
    return ticket.get("status") != "closed" and park.get("cause") == PARK_EXHAUSTED \
        and park.get("origin") == ticket["id"] and ticket.get("resumes_left") in (0, None) \
        and last.get("cause") == "unblocked" and str(last.get("ref", "")).startswith("repairs:") \
        and last.get("launches") == []


def settle_lifts(convoy: Convoy, out: dict[str, Any]) -> None:
    """An answer of the operator that lifts a parking is applied by the
    pass: any answer to the request an operator request left on its ticket,
    except « Corriger par maintenance sur main », which waits for the
    delivery of the repair linked to it (af-fv8ca4);
    the option that accepts the deviation a Planning Exception asked about;
    the option that judges proven by its test what an evaluation's Planning
    Exception could not observe, or the one that has it evaluated again on
    the products launched again (af-npz9v1.38); the lifting option of the convoy's grouped
    request, for the tickets it names. Any other answer leaves the ticket
    parked. A ticket parked for exhausted resumes that has resumes left
    under the bounds of now is lifted without an answer: an answered resume
    takes no bound since af-npz9v1.41, and nothing is left to ask."""
    for ticket in convoy.tickets:
        if not exact_returned_release_state(convoy, ticket, parked=True):
            continue
        try:
            authorization = returned_release_authorization()
            lifted = release_exact_returned_parking(convoy, ticket)
            out["lifted"].append({"id": ticket["id"], "option": None,
                                  "request": authorization["maintenance_bead"], "lifted": lifted,
                                  "release": "returned_once"})
            convoy.load()
        except Refusal as exc:
            out["refused"].append({"id": ticket["id"], "reason": str(exc)})
        break
    for ticket in convoy.tickets:
        if not exact_c2b_release_state(ticket):
            continue
        try:
            authorization = c2b_release_authorization()
            lifted = release_exact_c2b_parking(convoy, ticket)
            out["lifted"].append({"id": ticket["id"], "option": None,
                                  "request": authorization["repair_bead"], "lifted": lifted,
                                  "release": "repair_delivered_once"})
            convoy.load()
        except Refusal as exc:
            out["refused"].append({"id": ticket["id"], "reason": str(exc)})
        break
    for ticket in convoy.tickets:
        if not exact_returned_result_release_state(ticket, parked=True):
            continue
        try:
            authorization = returned_result_release_authorization()
            lifted = release_exact_returned_result(convoy, ticket)
            out["lifted"].append({"id": ticket["id"], "option": None,
                                  "request": authorization["repair_bead"], "lifted": lifted,
                                  "release": "returned_result_once"})
            convoy.load()
        except Refusal as exc:
            out["refused"].append({"id": ticket["id"], "reason": str(exc)})
        break
    for ticket in convoy.tickets:
        if not exact_c2b_result_release_state(ticket):
            continue
        try:
            authorization = c2b_result_release_authorization()
            lifted = release_exact_c2b_result(convoy, ticket)
            out["lifted"].append({"id": ticket["id"], "option": None,
                                  "request": authorization["repair_bead"], "lifted": lifted,
                                  "release": "c2b_result_once"})
            convoy.load()
        except Refusal as exc:
            out["refused"].append({"id": ticket["id"], "reason": str(exc)})
        break
    for ticket in convoy.tickets:
        if not exact_c2b_evaluation_recovery_state(ticket, parked=True):
            continue
        try:
            authorization = c2b_evaluation_recovery_authorization()
            lifted = release_exact_c2b_evaluation(convoy, ticket)
            out["lifted"].append({"id": ticket["id"], "option": None,
                                  "request": authorization["repair_bead"], "lifted": lifted,
                                  "release": "c2b_evaluation_once"})
            convoy.load()
        except Refusal as exc:
            out["refused"].append({"id": ticket["id"], "reason": str(exc)})
        break
    lifts: list[tuple[str, str, str | None, list[str]]] = []
    for ticket in convoy.tickets:
        park = ticket.get("park") or {}
        if ticket.get("status") != "closed" and park.get("origin") == ticket["id"] \
                and park.get("cause") == PARK_EXHAUSTED and ticket.get("resumes_left"):
            lifts.append((ticket["id"], ticket["id"], None, []))
            continue
        if ticket.get("status") != "closed" and park.get("origin") == ticket["id"] \
                and park.get("cause") == "operator_request" and technical_repairs(ticket):
            repairs = delivered_technical_repairs(ticket, convoy)
            if repairs:
                lifts.append((ticket["id"], ticket["id"], None, repairs))
            # Once explicitly linked, this is a code-owned technical wait:
            # an old or new human answer never releases it before delivery.
            continue
        answer = park.get("answer")
        if ticket.get("status") == "closed" or park.get("origin") != ticket["id"] or not answer:
            continue
        if park.get("cause") == "operator_request" and answer.get("awaits_repair") \
                and not returned_for_parking(ticket):
            # Answered « Corriger par maintenance sur main »: the ticket
            # resumes once its linked repair is delivered, above, never on
            # the answer (af-fv8ca4) -- unless that repair was given back
            # to its author (settle_returned_repairs, af-t8hycw).
            continue
        if park.get("cause") == "operator_request" \
                or (park.get("cause") == "planning_exception" and answer_lifts_planning_exception(ticket)):
            lifts.append((ticket["id"], ticket["id"], answer["option"], []))
    try:
        grouped = convoy.grouped or {}
        if grouped.get("lifts"):
            letter = request_answer(read_bead(grouped["bead"]), grouped["at"])
            if letter == grouped["lift_option"]:
                for ticket_id in grouped["lifts"]:
                    park = convoy.ticket(ticket_id).get("park") or {}
                    if park.get("origin") == ticket_id and park.get("cause") == PARK_EXHAUSTED:
                        lifts.append((ticket_id, grouped["bead"], letter, []))
    except Refusal as exc:
        out["refused"].append({"id": convoy.id, "reason": str(exc)})
    for ticket_id, request, letter, repairs in lifts:
        try:
            option = ["--option", letter] if letter else []
            repair_args = [part for repair in repairs for part in ("--repair", repair)]
            answer = state_write("lift-park", convoy.id, ticket_id, "--request", request, *option, *repair_args)
            lifted = {"id": ticket_id, "option": letter, "request": request, "lifted": answer["lifted"]}
            if repairs:
                lifted["repairs"] = repairs
            out["lifted"].append(lifted)
        except Refusal as exc:
            out["refused"].append({"id": ticket_id, "reason": str(exc)})
    if lifts:
        convoy.load()


def parked_origins(convoy: Convoy) -> dict[str, list[str]] | None:
    """Each ticket that parks, with those parked behind it, when nothing
    but parked tickets is left in the convoy; None otherwise."""
    left = [t for t in convoy.tickets if t.get("status") != "closed"]
    if not left or not all(isinstance(t.get("park"), dict) and "origin" in t["park"] for t in left):
        return None
    # A technical wait, linked or answered to be repaired, is not the
    # operator's to answer again.
    technical = {t["id"] for t in left if technical_repairs(t) or awaits_repair(t)}
    origins: dict[str, list[str]] = {}
    for ticket in left:
        origin = ticket["park"]["origin"]
        if origin in technical:
            continue
        origins.setdefault(origin, [])
        if ticket["park"]["origin"] != ticket["id"]:
            origins[origin].append(ticket["id"])
    return origins or None


def grouped_request(convoy: Convoy, origins: dict[str, list[str]]) -> tuple[dict[str, Any], str, list[str]]:
    """What the operator reads, once, for the whole convoy: each parked
    ticket and its cause. Returns the request, the full text and the
    tickets its first option lifts."""
    cause_of = {t["id"]: t["park"]["cause"] for t in convoy.tickets if isinstance(t.get("park"), dict)}
    detail_of = {t["id"]: t["park"].get("detail", "") for t in convoy.tickets if isinstance(t.get("park"), dict)}
    named, lines = [], []
    for origin, behind in origins.items():
        cause = PARK_CAUSES.get(cause_of.get(origin, ""), str(cause_of.get(origin)))
        named.append(f"{origin} ({cause})" + (f" + {', '.join(behind)}" if behind else ""))
        lines.append(f"- {origin} : {cause} — {detail_of.get(origin, '')}")
        lines += [f"- {ticket_id} : parqué derrière {origin} ({cause})" for ticket_id in behind]
    exhausted = [origin for origin in origins if cause_of.get(origin) == PARK_EXHAUSTED]
    lift = ({"option": "Relancer les tickets aux reprises épuisées",
             "consequence": "Chacun repart avec ses reprises ; les tickets qui l'attendent redeviennent démarrables."}
            if exhausted else
            {"option": "Répondre à la demande de chaque ticket parqué, sur sa propre ligne",
             "consequence": "Un ticket repart dès que sa propre demande a la réponse qui lève son parcage."})
    request = {
        "quoi": one_line(f"Convoi {convoy.id} : il ne reste que des tickets parqués — {' ; '.join(named)}"),
        "pourquoi": one_line(f"Plus aucun ticket du convoi {convoy.id} ne démarre ni ne fusionne sans ta réponse"),
        "que_faire": [lift, {"option": "Laisser ces tickets parqués",
                             "consequence": "Rien ne démarre ; le convoi reste ouvert, cette demande ne revient pas."}],
        "langue": operator_language(),
        "bloquant": True,
    }
    text = "\n".join([
        f"Il ne reste dans le convoi {convoy.id} que des tickets parqués : le script d'avancement "
        "(bin/convoy-advance) ne peut plus rien y démarrer.", "", "Tickets parqués et cause :", *lines, "",
        "Un ticket aux reprises épuisées repart quand tu réponds à cette demande par l'option qui le relance. "
        "Un ticket parqué par sa propre sortie (demande opérateur, Planning Exception) repart quand sa propre "
        "demande a sa réponse. Aucun ticket ne se reprend à la main."])
    return request, text, exhausted


def parkings_signature(convoy: Convoy, origins: dict[str, list[str]]) -> str:
    named = set(origins) | {ticket_id for behind in origins.values() for ticket_id in behind}
    rows = sorted([t["id"], str(t["park"].get("cause")), str(t["park"].get("origin")), str(t["park"].get("at"))]
                  for t in convoy.tickets if t["id"] in named and isinstance(t.get("park"), dict))
    return "sha256:" + hashlib.sha256(json.dumps(rows, ensure_ascii=False).encode("utf-8")).hexdigest()


def record_grouped(convoy: Convoy, bead_id: str, signature: str | None = None, lifts: list[str] | None = None) -> None:
    argv = ["record-grouped-request", convoy.id, "--bead", bead_id]
    if signature:
        argv += ["--signature", signature]
    if lifts:
        # The door letters the options in order: the first one lifts.
        argv += ["--lift-option", "a", *(part for ticket_id in lifts for part in ("--lifts", ticket_id))]
    state_write(*argv)


def settle_grouped_lift(convoy: Convoy, out: dict[str, Any]) -> bool:
    """Apply the grouped answer while its record still names the tickets."""
    grouped = convoy.grouped or {}
    if not grouped.get("lifts") \
            or request_answer(read_bead(grouped["bead"]), grouped["at"]) != grouped["lift_option"]:
        return False
    settle_lifts(convoy, out)
    remaining = [ticket_id for ticket_id in grouped["lifts"]
                 if (convoy.ticket(ticket_id).get("park") or {}).get("cause") == PARK_EXHAUSTED]
    if remaining:
        raise Refusal("la réponse de la demande groupée n'a pas levé " + ", ".join(remaining))
    return True


def settle_grouped_request(convoy: Convoy, out: dict[str, Any]) -> dict[str, Any] | None:
    """Spec §8, user story 54: one request per convoy, on a bead of its own,
    when nothing but parked tickets is left -- never one per ticket; raised
    once per set of parkings, withdrawn once a ticket may advance again."""
    try:
        origins = parked_origins(convoy)
        if origins is None:
            if not convoy.grouped:
                return None
            bead_id = convoy.grouped["bead"]
            passed(run([str(ESCALATION_BIN), "clear", bead_id]), "escalation-door clear")
            # The answer may have landed after settle_lifts read the request,
            # while this pass resumed another ticket. Clear holds the same
            # door lock as the answer: read and apply it now, before dropping
            # the only record that names the exhausted tickets (af-g2ukoq).
            settle_grouped_lift(convoy, out)
            if read_bead(bead_id).get("status") != "closed":
                passed(run([GC_BIN, "--city", str(ROOT), "bd", "close", bead_id, "--reason",
                            f"Le convoi {convoy.id} n'est plus fait que de tickets parqués."]), "gc bd close")
            state_write("clear-grouped-request", convoy.id)
            return {"bead": bead_id, "withdrawn": True}
        signature = parkings_signature(convoy, origins)
        if convoy.grouped and convoy.grouped.get("signature") == signature:
            return {"bead": convoy.grouped["bead"], "raised": False}
        request, text, lifts = grouped_request(convoy, origins)
        if convoy.grouped:
            bead_id = convoy.grouped["bead"]
            passed(run([GC_BIN, "--city", str(ROOT), "bd", "update", bead_id, "--append-notes", text]), "gc bd update")
            # The old record is still the only one that names the tickets.
            # Apply an answer that landed during this pass before replacing it.
            if settle_grouped_lift(convoy, out):
                return settle_grouped_request(convoy, out)
        else:
            created = gc_json("bd", "create", f"Demande groupée : convoi {convoy.id}, il ne reste que des tickets parqués",
                              "-p", "1", "-t", "task", "-d", text, "--json")
            if isinstance(created, list):
                created = created[0] if created else None
            bead_id = created.get("id") if isinstance(created, dict) else None
            if not isinstance(bead_id, str) or not bead_id:
                raise Refusal("gc bd create n'a pas rendu l'identifiant du bead de la demande groupée")
            # Recorded before the escalation: a pass that fails after this
            # point is retried on the same bead, never on a second one.
            record_grouped(convoy, bead_id)
        passed(run([str(ESCALATION_BIN), "benjamin", bead_id, json.dumps(request, ensure_ascii=False)]),
               "escalation-door benjamin")
        record_grouped(convoy, bead_id, signature, lifts)
        return {"bead": bead_id, "raised": True}
    except Refusal as exc:
        return {"error": f"refus : {exc}"}


# --- the stops of a convoy: red integration branch, open Planning Exceptions (T21) ---


def red_reason(red: dict[str, Any]) -> str:
    repair = red.get("repair")
    return (f"{RED} ({red['control']}) : aucun ticket ne démarre avant "
            + (f"son repair {repair}" if repair else "son repair, pas encore publié"))


def open_exceptions(convoy: Convoy) -> list[str]:
    """The tickets of the convoy on which a Planning Exception is open: the
    last one a Ticket Exit raised has no answer of the operator yet, or the
    ticket is parked by one an evaluation raised, not answered either."""
    opened = []
    for ticket in convoy.tickets:
        if ticket.get("status") == "closed":
            continue
        raised, park = ticket.get("planning_exceptions"), ticket.get("park") or {}
        if isinstance(raised, list) and raised and raised[-1].get("state") == "open":
            opened.append(ticket["id"])
        elif park.get("origin") == ticket["id"] and park.get("cause") == "planning_exception" and not park.get("answer") \
                and not (isinstance(raised, list) and raised):
            opened.append(ticket["id"])
    return opened


def red_repair(convoy: Convoy, red: dict[str, Any]) -> dict[str, Any]:
    """What code writes of the `repair` of a red integration branch (Spec
    §2): it names the control that is red, and its demonstration line is
    that control restored."""
    branch, protected = convoy.integration["branch"], convoy.integration["protected"]
    said = f" Ce que le contrôle a dit : {red['detail']}" if red.get("detail") else ""
    if red.get("check") == RED_FIDELITY:
        # The end-of-Spec gate measured a deviation from the Validated
        # Prototype (T23): the repair is an interface ticket, whose own
        # fidelity is measured before its merge.
        return {
            "title": f"Rétablir la fidélité au Validated Prototype sur la branche d'intégration ({red['commit'][:12]})",
            "what_it_delivers": (
                f"La branche d'intégration {branch} repasse le contrôle de fidélité mécanique de fin de Spec qui y est "
                f"rouge : {red['control']}.{said} Le correctif part de la pointe de {branch}, reprend {protected}, "
                "et supprime ces écarts sans changer un comportement que la Spec fixe."),
            # The control the convoy records as red: the patch door reads it
            # there, and takes its repair for an interface ticket (T40).
            "restores": {"kind": "red_check", "ref": red["control"]},
            "demonstration_line": (
                f"Sur le produit lancé au résultat de la fusion de ce ticket dans {branch}, {protected} reprise, chaque "
                "écran sert chaque état prototypé avec les ancres, la structure, les styles calculés et les tokens du "
                "Validated Prototype."),
            "acceptance_criteria": [{
                "entry_point": ("chaque écran du profil du projet, servi par le produit lancé sur le jeu de données de "
                                "chaque état prototypé"),
                "observable": "ses ancres, leur structure, leurs styles calculés et les tokens sont ceux du Validated Prototype",
                "false_if": "une ancre du prototype y manque, ou une structure, un style calculé ou un token y diffère",
            }],
        }
    return {
        "title": f"Rétablir le contrôle rouge de la branche d'intégration ({red['commit'][:12]})",
        "what_it_delivers": (
            f"La branche d'intégration {branch} repasse le contrôle qui y est rouge : {red['control']}.{said} "
            f"Le correctif part de la pointe de {branch}, reprend {protected}, et rend ce contrôle vert sans "
            "changer un comportement que la Spec fixe."),
        "restores": {"kind": "red_check", "ref": red["control"]},
        "demonstration_line": (
            f"Sur le résultat de la fusion de ce ticket dans {branch}, {protected} reprise, la commande de "
            "régression du projet se termine avec le code de sortie 0."),
        "acceptance_criteria": [{
            "entry_point": (f"la commande de régression du projet, lancée à la racine du dépôt sur la branche "
                            f"{branch} après reprise de {protected}"),
            "observable": "elle se termine avec le code de sortie 0",
            "false_if": "elle se termine avec un code de sortie non nul",
        }],
    }


def publish_red_repair(convoy: Convoy, red: dict[str, Any]) -> dict[str, Any]:
    """Draft the revision that adds the `repair` of the red to the graph as
    it is published, and send it through the patch door: the entry contract
    applies to it as to any added ticket. A repair of this red already
    tracked by the convoy (a pass that failed after the door) is taken as it is."""
    return publish_repair(convoy, red_repair(convoy, red), RED, f"{RED} : {red['control']}",
                          "de la branche d'intégration", "sa branche d'intégration")


def publish_repair(convoy: Convoy, repair: dict[str, Any], label: str, reason: str, whose: str,
                   of_what: str) -> dict[str, Any]:
    """One `repair` written by code, added to the graph as it is published
    through the patch door (no approval: Spec §2, a repair inside the
    approved intent needs none). One already tracked by the convoy under
    the same title is taken as it is."""
    bead = read_bead(convoy.id)
    metadata = bead.get("metadata") or {}
    tracked = [dep for dep in bead.get("dependencies") or []
               if isinstance(dep, dict) and dep.get("dependency_type") == "tracks"]
    for dep in tracked:
        if (dep.get("status") != "closed" and dep.get("title") == repair["title"]
                and (dep.get("metadata") or {}).get("gc.ticket_kind") == "repair"):
            return {"id": dep["id"], "published": False}
    keys = {str((dep.get("metadata") or {}).get("gc.ticket_id") or "") for dep in tracked}
    revises, spec_id = metadata.get("gc.graph_digest"), metadata.get("gc.spec_id")
    project = metadata.get("gc.project_id") or (
        (read_bead(str(spec_id)).get("metadata") or {}).get("gc.project_id") if spec_id else None)
    if not revises or not spec_id or not project or "" in keys:
        raise Refusal(
            f"le convoi {convoy.id} ne porte pas ce que la porte de patch révise (gc.graph_digest, gc.spec_id, "
            "gc.project_id, gc.ticket_id de chaque ticket) : il n'a pas été publié par la porte de publication")
    if not convoy.rig:
        raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de config/projects : "
                      f"le repair de {of_what} n'a pas de projet")
    number = 1
    while f"R{number}" in keys:
        number += 1
    key = f"R{number}"
    description = yaml.safe_dump(
        {"flow_contract": NEW_FLOW, "operator_needs": [],
         "tickets": [{"id": key, "kind": "repair", "blocked_by": [], "target_rigs": [convoy.rig], **repair}]},
        allow_unicode=True, sort_keys=False)
    created = gc_json("bd", "create", f"Révision : repair {key} ({label}, convoi {convoy.id})",
                      "-t", "task", "-d", description, "--json")
    if isinstance(created, list):
        created = created[0] if created else None
    draft_id = created.get("id") if isinstance(created, dict) else None
    if not isinstance(draft_id, str) or not draft_id:
        raise Refusal("gc bd create n'a pas rendu l'identifiant du brouillon de révision")

    def abandon(reason: str) -> None:
        run([GC_BIN, "--city", str(ROOT), "bd", "close", draft_id, "--reason",
             f"révision refusée par la porte de patch : {one_line(reason, 200)}"])

    prepared = run([GC_BIN, "--city", str(ROOT), "bd", "update", draft_id,
                    "--set-metadata", f"spec_id={spec_id}", "--set-metadata", f"revises_digest={revises}",
                    "--set-metadata", "gc.plane=planning"])
    if prepared.returncode != 0:
        reason = prepared.stderr.strip() or prepared.stdout.strip() or f"exit {prepared.returncode}"
        abandon(reason)
        raise Refusal(f"le brouillon de révision {draft_id} n'a pas pu être préparé : {reason[-300:]}")
    proc = run([str(PUBLISH_BIN), "bd-patch", draft_id, "--project", str(project), "--repo-root", str(ROOT),
                "--author", PROGRAM, "--reason", one_line(reason, 200)])
    try:
        result = json.loads(proc.stdout)
    except json.JSONDecodeError:
        result = None
    ticket_id = (result.get("ids") or {}).get(key) if isinstance(result, dict) and result.get("ok") else None
    if proc.returncode != 0 or not isinstance(ticket_id, str) or not ticket_id:
        reason = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        abandon(reason)
        raise DoorRefusal(f"la porte de patch a refusé le ticket repair {whose} : {reason[-600:]}")
    return {"id": ticket_id, "key": key, "draft": draft_id, "published": True}


def settle_red(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §8: one `repair` per red, created by code. None when the red
    already has its repair -- open, or closed and waiting for the merge
    command to run the control again -- and when the rounds of the end are
    stopped (T26): that red has no round left to be repaired in."""
    if "repair" in convoy.red or convoy.end_stop:
        return None
    try:
        repair = publish_red_repair(convoy, convoy.red)
        state_write("set-integration-repair", convoy.id, "--ticket", repair["id"])
        convoy.load()
        return repair
    except Refusal as exc:
        return {"error": f"refus : {exc}"}


# --- the acceptance of a Delivered Outcome (T28) ------------------------------------


def acceptance_request(convoy: Convoy, page: str) -> dict[str, Any]:
    """What the operator reads on the escalation door's list (Spec §11):
    the convoy whose Outcome is Delivered and the link of its Evidence
    Pack. It recommends nothing: the judgment is his, on the launched
    product, and no delay answers in his place."""
    commit = convoy.delivered["commit"][:12]
    return {
        "quoi": one_line(f"Acceptance Request — convoi {convoy.id} : un Delivered Outcome attend votre jugement"),
        "pourquoi": one_line(f"Chaque condition de fin de Spec est verte au commit {commit} ; le dossier est en lien."),
        "que_faire": [
            {"option": "Ouvrir l'Acceptance Session",
             "consequence": "Le produit est lancé au commit du dossier ; rien n'est accepté ni fusionné sans votre réponse."},
        ],
        "langue": operator_language(),
        "bloquant": True,
        "lien": page,
    }


def outage_repair(convoy: Convoy, outage: dict[str, Any], commit: str) -> dict[str, Any]:
    """What code writes of the `repair` of an Acceptance Session whose
    product did not start (Spec §11): it restores the launch by the recipe
    of the profile, and its demonstration line is the product answering."""
    branch = convoy.integration["branch"]
    control = convoy.red_check("acceptance_session") \
        or f"lancement du produit par la recette du profil au commit {commit[:12]} (Acceptance Session)"
    return {
        "title": f"Rétablir le démarrage du produit pour l'Acceptance Session ({commit[:12]})",
        "what_it_delivers": one_line(
            f"À l'ouverture de l'Acceptance Session, le produit n'a pas démarré depuis une copie propre du commit "
            f"{commit[:12]} de {branch} : {outage['detail']} Ce ticket rétablit ce démarrage par la recette du profil "
            "du projet, sur ses données synthétiques, sans changer un comportement que la Spec fixe.", 900),
        "restores": {"kind": "red_check", "ref": control},
        "demonstration_line": (
            f"Depuis une copie propre de la pointe de {branch} après fusion de ce ticket, la recette du profil lance le "
            "produit sur chaque jeu de données synthétiques et sa sonde de santé répond."),
        "acceptance_criteria": [{
            "entry_point": "la recette de lancement du profil du projet, sur chaque jeu de données synthétiques déclaré",
            "observable": "le produit démarre et sa sonde de santé répond le statut attendu",
            "false_if": "le produit ne démarre pas, ou sa sonde ne répond pas dans le délai de lancement",
        }],
    }


def settle_acceptance(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §11: once the Outcome is Delivered, code, and no agent, sends
    the Acceptance Request that carries the link of its Evidence Pack
    through bin/escalation-door, on the convoy's own bead -- once per
    Delivered Outcome. The outage of an Acceptance Session (the product did
    not start at the commit of the dossier) gets one `repair`, unless the
    rounds of the end are stopped. None when neither is due. Nothing here
    reads a clock: a Delivered Outcome stays Delivered until Benjamin
    answers."""
    try:
        convoy.load()
        answer: dict[str, Any] = {}
        known = convoy.acceptance
        delivered = convoy.delivered
        if delivered and not (known and known["commit"] == delivered["commit"] and "request" in known):
            pack = convoy.pack
            if not pack or pack.get("commit") != delivered["commit"] or pack.get("digest") != delivered["pack"]:
                raise Refusal(f"l'Evidence Pack enregistré sur le convoi {convoy.id} n'est pas celui de son Delivered "
                              "Outcome : l'Acceptance Request n'est pas envoyée")
            page = f"{pack['path'].rstrip('/')}/index.html"
            request = json.dumps(acceptance_request(convoy, page), ensure_ascii=False)
            passed(run([str(ESCALATION_BIN), "benjamin", convoy.id, request]), "escalation-door benjamin")
            state_write("acceptance-requested", convoy.id, "--bead", convoy.id)
            convoy.load()
            answer.update({"action": "requested", "commit": delivered["commit"], "page": page, "bead": convoy.id})
        known = convoy.acceptance
        outage = (known or {}).get("panne")
        if outage and "ticket" not in outage and not convoy.end_stop:
            label = "produit qui ne démarre pas à l'Acceptance Session"
            repair = publish_repair(convoy, outage_repair(convoy, outage, known["commit"]), label,
                                    f"{label} : {outage['detail']}", "de l'Acceptance Session", "son produit lancé")
            state_write("set-acceptance-repair", convoy.id, "--ticket", repair["id"])
            convoy.load()
            answer["repair"] = repair
        # Benjamin returned findings: each one that cites the story or the
        # anchor gets the `repair` drafted with it, published by code (T29).
        tracked = {t["id"] for t in convoy.tickets}
        for number, finding in enumerate(convoy.owner_findings(), start=1):
            if finding["route"] != "repair" or finding.get("ticket") in tracked:
                continue
            label = f"constat n° {number} rendu par Benjamin"
            repair = publish_repair(convoy, finding["draft"], label, f"{label} : {finding['text']}",
                                    "de l'approbateur", "son constat")
            state_write("set-owner-repair", convoy.id, "--finding", str(number), "--ticket", repair["id"])
            answer.setdefault("owner_repairs", []).append({"finding": number, **repair})
        if "owner_repairs" in answer:
            convoy.load()
        # A « plus tard » of his whose proposition the door did not create
        # when he answered gets it now; a door that still fails holds nothing.
        if convoy.later_without_proposal():
            said = parsed(run([str(OWNER_BIN), "proposals", convoy.id, "--repo", str(convoy.repo)]),
                          "owner-answer proposals")
            for key in ("created", "proposals_pending"):
                if said.get(key):
                    answer["owner_proposals" if key == "created" else key] = said[key]
            if said.get("error"):
                answer["proposals_pending"] = said["error"]
        held = convoy.owner_hold()
        if held and not convoy.delivered:
            answer["owner_hold"] = held
    except (Refusal, NotNewFlow) as exc:
        return {"error": f"refus : {exc}"}
    return answer or None


# --- after Benjamin's answer: the merge and the closing (T30) -------------------------


def settle_promotion(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §9 and §11: once Benjamin answered « accepté » or « abandonné »,
    code, and no agent, follows the answer through bin/outcome-promote run:
    the one merge into the protected branch and the closing of the convoy,
    or the closing alone. None while neither answer stands. A red replay of
    the mechanical controls, or a conflict, is an outcome of the pass: the
    acceptance is voided and the red gets its `repair` here; a command that
    could not run is a failure of it."""
    try:
        convoy.load()
        if not convoy.closed and convoy.final_answer() is None:
            return None
        if not convoy.rig:
            raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de config/projects : "
                          "le dépôt de sa branche protégée est inconnu")
        answer = parsed(run([str(PROMOTE_BIN), "run", convoy.id, "--repo", str(convoy.repo)]),
                        f"outcome-promote run {convoy.id}")
    except (Refusal, NotNewFlow) as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : outcome-promote run {convoy.id} a rendu une réponse illisible"}
    kept = ("promoted", "merged", "judged", "closed", "how", "said", "outcome", "done", "resumed", "purged", "pending",
            "cause", "red", "error", "message", "unruled")
    result = {name: answer[name] for name in kept if name in answer}
    if isinstance(result.get("red"), dict) and "error" in result:
        # The replay ran and a control is red: named, not a failure.
        result["reason"] = result.pop("error")
        try:
            convoy.load()
            repair = settle_red(convoy) if convoy.red else None
        except (Refusal, NotNewFlow) as exc:
            repair = {"error": f"refus : {exc}"}
        if repair:
            result["repair"] = repair
    return result


# --- the end of the Spec: tracked elements to repair, and the gate (T23) ---------


def item_repair(ticket: dict[str, Any], items: list[dict[str, Any]], control: str | None = None) -> dict[str, Any]:
    """What code writes of the `repair` the operator asked for the tracked
    elements of a ticket (Spec §9, « éléments suivis »): it restores the
    registry of the end-of-Spec gate, red on them, and its demonstration
    line is each of them delivered."""
    ticket_id = ticket["id"]
    # The name the convoy records this red under (bin/convoy-state show).
    control = control or (f"registre de la porte de fin de Spec : éléments du ticket {ticket_id} sans état final "
                          f"({', '.join(item['id'] for item in items)})")
    named = " ; ".join(f"{ITEM_LABELS.get(item['section'], item['section'])} {item['number']} : « {item['text']} »"
                       for item in items)
    ids = ", ".join(item["id"] for item in items)
    line = ticket.get("demonstration_line")
    where = (f"le produit lancé, par le point d'entrée de la ligne de démonstration du ticket {ticket_id} "
             f"(« {line} »)" if isinstance(line, str) and line else "le produit lancé par la recette du profil du projet")
    return {
        "title": f"Rétablir les éléments du ticket {ticket_id} laissés sans état final ({ids})",
        "what_it_delivers": (
            f"Le Ticket Handoff du ticket {ticket_id} déclare, sans état final : {named}. Benjamin a demandé leur "
            f"réparation. Ce ticket livre ce qui manque et ce qui a été livré autrement que le ticket {ticket_id} et "
            "la Spec ne le demandent, sans changer un comportement que la Spec fixe."),
        "restores": {"kind": "red_check", "ref": control},
        "demonstration_line": one_line(
            f"Sur le produit lancé, ce que le ticket {ticket_id} a déclaré manquant ou livré autrement est livré comme "
            f"le ticket et la Spec le demandent : {named}", 600),
        "acceptance_criteria": [{
            "entry_point": where,
            "observable": one_line(f"ce que le ticket {ticket_id} a déclaré manquant ou livré autrement y est livré "
                                   f"comme le ticket et la Spec le demandent ({named})", 600),
            "false_if": "l'un de ces éléments y manque encore, ou y est encore livré autrement",
        }],
    }


def settle_item_repairs(convoy: Convoy) -> list[dict[str, Any]]:
    """Spec §9: a deviation or a « non fait » ends repaired or accepted by
    Benjamin. When the operator answered the Planning Exception that names
    the elements of a ticket by « faire réparer », code publishes one
    `repair` for them and names it on the elements; they read « réparé »
    once the ticket-end gate has closed it."""
    done = []
    for ticket, items in convoy.item_repairs_due():
        ids = [item["id"] for item in items]
        try:
            repair = publish_repair(
                convoy, item_repair(ticket, items, convoy.red_check("tracked_items", ticket["id"])),
                f"éléments suivis de {ticket['id']}",
                f"éléments du ticket {ticket['id']} sans état final ({', '.join(ids)}) : réparation demandée par l'opérateur",
                f"des éléments suivis de {ticket['id']}", f"ses éléments suivis ({ticket['id']})")
            state_write("set-item-repair", convoy.id, ticket["id"], "--repair", repair["id"])
            done.append({**repair, "ticket": ticket["id"], "items": ids})
        except Refusal as exc:
            done.append({"ticket": ticket["id"], "items": ids, "error": f"refus : {exc}"})
    if any("error" not in entry for entry in done):
        convoy.load()
    return done


def settle_outcome_repairs(convoy: Convoy) -> list[dict[str, Any]]:
    """Spec §7, §9: the Evaluator of the end drafts a `repair` and does not
    publish it. Code publishes each one through the patch door, as the
    Evaluator wrote it, and names it where it was drafted: on the user story
    of the last Outcome Evaluation, or on the finding « hors ticket ». A
    draft the door refuses is recorded there with the reason, and stops the
    Outcome Evaluation at the commit of its last round: bin/outcome-evaluation
    raises it once to the operator. A refusal is never published again."""
    done = []
    for due in convoy.outcome_repairs_due():
        if "story" in due:
            named = {"story": due["story"]}
            what, where = f"user story {due['story']}", ["--story", str(due["story"])]
            reason = f"user story {due['story']} non observée sur le produit assemblé par l'Outcome Evaluation"
        else:
            named = {"finding": due["finding"]}
            what, where = f"constat hors ticket {due['finding']}", ["--ticket", due["ticket"], "--item", due["item"]]
            reason = f"constat hors ticket {due['finding']} classé « réparé » par l'Evaluator de fin"
        try:
            repair = publish_repair(convoy, due["draft"], what, reason, f"de la {what}" if "story" in due else f"du {what}",
                                    f"la {what}" if "story" in due else f"le {what}")
        except DoorRefusal as exc:
            try:
                state_write("set-outcome-repair", convoy.id, "--refused", one_line(str(exc), 500), *where)
                done.append({**named, "refused": f"refus : {exc}"})
            except Refusal as second:
                done.append({**named, "error": f"refus : {exc} ; {second}"})
            continue
        except Refusal as exc:
            done.append({**named, "error": f"refus : {exc}"})
            continue
        try:
            state_write("set-outcome-repair", convoy.id, "--repair", repair["id"], *where)
            done.append({**repair, **named})
        except Refusal as exc:
            done.append({**repair, **named, "error": f"refus : {exc}"})
    if any("error" not in entry for entry in done):
        convoy.load()
    stopped = stop_refused_outcome_repairs(convoy)
    if stopped:
        done.append(stopped)
    return done


def stop_refused_outcome_repairs(convoy: Convoy) -> dict[str, Any] | None:
    """The stop of the Outcome Evaluation a refused draft calls for, written
    once at the commit of its last round; None when none is due. Not while
    an evaluation is open (its classifications may still change) nor once
    the rounds of the end are stopped (T26)."""
    outcome = convoy.outcome
    if outcome is None or outcome.get("request") or convoy.end_stop or not outcome["rounds"]:
        return None
    refused = convoy.outcome_repairs_refused()
    commit = outcome["rounds"][-1]["commit"]
    if not refused or (outcome.get("stop") or {}).get("commit") == commit:
        return None
    try:
        state_write("stop-outcome-evaluation", convoy.id, "--commit", commit, "--reason", STOP_OUTCOME_REPAIR_REFUSED,
                    "--detail", one_line("repair rédigé refusé par la porte de patch — " + " ; ".join(refused), 240))
        convoy.load()
    except Refusal as exc:
        return {"stop": STOP_OUTCOME_REPAIR_REFUSED, "error": f"refus : {exc}"}
    return {"stop": STOP_OUTCOME_REPAIR_REFUSED, "commit": commit, "refused": refused}


def settle_outcome_evaluation(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §7, §9, point 4: code, and no agent, has the assembled product
    evaluated once the mechanical verdicts of the end of the Spec are green,
    through bin/outcome-evaluation settle. None while the gate is not due
    and nothing of an evaluation is left to settle, or when the settlement
    had nothing to do. An evaluation that waits, is pending or is stopped is
    an outcome of the pass; one that could not be settled is a failure of it."""
    try:
        if not convoy.outcome_due():
            return None
        if not convoy.rig:
            raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de config/projects : "
                          "le produit assemblé à évaluer est inconnu")
        answer = parsed(run([str(OUTCOME_BIN), "settle", convoy.id, "--repo", str(convoy.repo),
                             "--profile", str(rig_profile(convoy.rig))]), f"outcome-evaluation settle {convoy.id}")
    except (Refusal, NotNewFlow) as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : outcome-evaluation settle {convoy.id} a rendu une réponse illisible"}
    if answer.get("action") == "none":
        return None
    kept = ("action", "commit", "bead", "launches", "deadline", "reason", "stop", "error")
    return {name: answer[name] for name in kept if name in answer}


def settle_spec_end(convoy: Convoy, closing: dict[str, Any] | None) -> dict[str, Any] | None:
    """Spec §9, points 1 to 3: code, and no agent, renders the mechanical
    verdicts of the end of a Spec, through bin/spec-end run, once every
    ticket of the convoy is closed. None while a ticket is open or the
    integration branch is red. A condition that is not met is an outcome of
    the pass; a gate that could not run is a failure of it."""
    try:
        if (closing or {}).get("closed"):
            convoy.load()  # what this pass closed
        if not convoy.end_due():
            return None
        if not convoy.rig:
            raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de config/projects : "
                          "le dépôt de sa branche d'intégration est inconnu")
        answer = parsed(run([str(SPEC_END_BIN), "run", convoy.id, "--repo", str(convoy.repo),
                             "--profile", str(rig_profile(convoy.rig))]), f"spec-end run {convoy.id}")
    except (Refusal, NotNewFlow) as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : spec-end run {convoy.id} a rendu une réponse illisible"}
    kept = ("version", "commit", "protected", "replayed", "missing", "refused", "requests", "red", "end_rounds",
            "end_stop", "delivered", "error", "message", "unruled")
    result = {name: answer[name] for name in kept if name in answer}
    if isinstance(answer.get("conditions"), list):
        result["verdicts"] = {str(entry.get("name")): entry.get("verdict") for entry in answer["conditions"]
                              if isinstance(entry, dict)}
        if "error" in result:
            # The gate ran and a condition is not met: named, not a failure.
            result["reason"] = result.pop("error")
    return result


def publish_end_review_repairs(convoy: Convoy, due: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Spec §6, « Fin de Spec »: a Blocking Finding of the end review
    becomes a `repair` its reviewer drafted. Code publishes each draft
    through the patch door, as any added ticket, and names the ticket on
    its finding; a draft the door refuses is recorded on the finding with
    the reason, and bin/spec-end-review raises it to the operator."""
    done = []
    for entry in due:
        finding, repair = entry["finding"], entry["repair"]
        try:
            published = publish_repair(
                convoy, repair, f"revue de fin, {finding}",
                f"Blocking Finding {finding} de la revue de code de fin au commit {str(entry['commit'])[:12]}",
                f"du constat {finding} de la revue de fin", f"sa revue de fin ({finding})")
        except Refusal as exc:
            try:
                state_write("set-end-review-repair", convoy.id, "--finding", finding, "--refused", one_line(str(exc), 500))
                done.append({"finding": finding, "refused": f"refus : {exc}"})
            except Refusal as second:
                done.append({"finding": finding, "error": f"refus : {exc} ; {second}"})
            continue
        try:
            state_write("set-end-review-repair", convoy.id, "--finding", finding, "--ticket", published["id"])
            done.append({**published, "finding": finding})
        except Refusal as exc:
            done.append({**published, "finding": finding, "error": f"refus : {exc}"})
    return done


def settle_end_review(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §6, §9 point 4: code, and no agent, has the assembled diff of
    the Spec reviewed once the three mechanical verdicts of the end are
    green, through bin/spec-end-review settle -- in the pass that recorded
    them, on their commit -- and publishes the repairs drafted for its
    Blocking Findings. None while a ticket is open or the integration
    branch is red."""
    try:
        if not convoy.end_due():
            return None
        if not convoy.rig:
            raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de config/projects : "
                          "le dépôt de sa branche d'intégration est inconnu")
        answer = parsed(run([str(END_REVIEW_BIN), "settle", convoy.id, "--repo", str(convoy.repo)]),
                        f"spec-end-review settle {convoy.id}")
    except (Refusal, NotNewFlow) as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : spec-end-review settle {convoy.id} a rendu une réponse illisible"}
    kept = ("action", "commit", "base", "outcome", "blocking", "bead", "launches", "deadline", "extent", "stop",
            "raised", "reason", "error")
    result = {name: answer[name] for name in kept if name in answer}
    if answer.get("action") == "deferred":
        # A launch the dispatch door defers is retried by the next pass.
        return result
    if result.get("action") == "waiting" and "error" not in result:
        # Not due yet (the gate has not rendered its verdicts on the tip): nothing to say.
        return None
    due = answer.get("repairs_due")
    if isinstance(due, list) and due:
        # What the review just recorded may have stopped the rounds of the
        # end (T26): no repair then. None either while the Outcome Evaluation
        # of the same tip is open: what it hands in may stop them.
        convoy.load()
        if convoy.end_stop or (convoy.outcome or {}).get("request"):
            return result
        result["repairs"] = publish_end_review_repairs(convoy, due)
        if any("error" not in entry and "refused" not in entry for entry in result["repairs"]):
            convoy.load()
    return result


def settle_evidence_pack(convoy: Convoy, ending: dict[str, Any] | None) -> dict[str, Any] | None:
    """Spec §10, §9 point 6: code, and no agent, generates the Evidence
    Pack, through bin/evidence-pack generate, once the gate refuses on that
    one condition: every condition before it is met on the tip. None
    otherwise. A pack that could not be generated is a failure of the pass."""
    verdicts = (ending or {}).get("verdicts") or {}
    if verdicts.get(PACK_CONDITION) != "fail" or any(
            verdict != "pass" for name, verdict in verdicts.items() if name != PACK_CONDITION):
        return None
    try:
        answer = parsed(run([str(PACK_BIN), "generate", convoy.id, "--repo", str(convoy.repo)]),
                        f"evidence-pack generate {convoy.id}")
    except (Refusal, NotNewFlow) as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : evidence-pack generate {convoy.id} a rendu une réponse illisible"}
    if not answer.get("ok"):
        return {"error": str(answer.get("error") or answer.get("message") or answer)}
    return {"action": "generated", **{name: answer[name] for name in ("commit", "digest", "page", "conforming") if name in answer},
            "inadmissible": len(answer.get("inadmissible") or [])}


# --- the rounds of the end are stopped: the « non conforme » request (T26) -------

END_STOP_CAUSES = {
    "end_rounds_exhausted": "tours de réparation de fin de Spec épuisés",
    "stories_not_reduced": "un tour de réparation n'a pas réduit les user stories non observées",
    "story_refused_twice": "la même user story est refusée deux fois",
}


# The option of non_conforme_request that lifts the stop: its first one.
END_STOP_LIFT_ANSWER = "a"


def non_conforme_request(convoy: Convoy, stop: dict[str, Any], page: str) -> dict[str, Any]:
    """What the operator reads on the escalation door's list (Spec §11):
    the convoy, why its rounds are stopped, and the link of its Evidence
    Pack. Three issues; « accepté » is not one of them."""
    cause = END_STOP_CAUSES.get(stop["reason"], stop["reason"])
    return {
        "quoi": one_line(f"Demande « non conforme » — convoi {convoy.id} : {cause}"),
        "pourquoi": one_line(str(stop["detail"])),
        "que_faire": [
            {"option": "Relancer un tour de réparation",
             "consequence": "Les réparations en attente sont publiées, puis toute la porte de fin de Spec est rejouée."},
            {"option": "Retourner à la planification",
             "consequence": "Le convoi reste arrêté ; la Spec ou son graphe sont repris par une Planning Exception."},
            {"option": "Abandonner",
             "consequence": "Rien n'est fusionné dans la branche protégée ; la branche d'intégration reste comme source."},
        ],
        "langue": operator_language(),
        "bloquant": True,
        "lien": page,
    }


def settle_non_conforme(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §8, §11: once the rounds of the end are stopped, code, and no
    agent, generates the Evidence Pack of the refused tip -- its header says
    « non conforme » -- and sends the « non conforme » request that carries
    its link through bin/escalation-door, on the convoy's own bead. Once per
    stop: None when there is no stop or its request already reached the
    operator. It waits for an Outcome Evaluation or an end review still open
    on the tip, so that the dossier holds what they hand in. A request that
    could not be raised is a failure of the pass.

    Once raised, the operator's answer is read on that bead: « a »
    (« Relancer un tour de réparation »), given after the request, lifts the
    stop by code (convoy-state lift-end-stop, one round more) and the next
    pass replays the end of the Spec. « b » and « c » lift nothing: the
    convoy stays stopped with the operator (af-strhoy)."""
    try:
        convoy.load()
        stop = convoy.end_stop
        if stop is None:
            return None
        if "request" in stop:
            return lift_answered_end_stop(convoy, stop)
        if (convoy.outcome or {}).get("request") or convoy.end_review_open:
            return {"action": "pending", "reason": stop["reason"]}
        pack = parsed(run([str(PACK_BIN), "generate", convoy.id, "--repo", str(convoy.repo)]),
                      f"evidence-pack generate {convoy.id}")
        if not isinstance(pack, dict) or not pack.get("ok"):
            error = (pack.get("error") or pack.get("message") or pack) if isinstance(pack, dict) else pack
            raise Refusal(f"evidence-pack generate {convoy.id} a échoué : {error}")
        if pack.get("conforming"):
            raise Refusal(f"l'Evidence Pack du convoi {convoy.id} est conforme alors que ses tours de fin sont arrêtés "
                          f"({stop['reason']}) : la demande « non conforme » n'est pas envoyée")
        request = json.dumps(non_conforme_request(convoy, stop, pack["page"]), ensure_ascii=False)
        passed(run([str(ESCALATION_BIN), "benjamin", convoy.id, request]), "escalation-door benjamin")
        state_write("end-stop-raised", convoy.id, "--bead", convoy.id)
        convoy.load()
    except (Refusal, NotNewFlow) as exc:
        return {"error": f"refus : {exc}"}
    return {"action": "raised", "reason": stop["reason"], "commit": pack["commit"], "page": pack["page"],
            "digest": pack["digest"], "bead": convoy.id}


def lift_answered_end_stop(convoy: Convoy, stop: dict[str, Any]) -> dict[str, Any] | None:
    """The answer « a » to the « non conforme » request of a stopped convoy,
    given after that request: the stop is lifted by code. None for no
    answer yet, an answer to an earlier request of the same bead, « b » or
    « c »."""
    request = stop["request"]
    bead = read_bead(request["bead"])
    answered_at = (bead.get("metadata") or {}).get("gc.escalation_response_at")
    if request_answer(bead, request["at"]) != END_STOP_LIFT_ANSWER or answered_at <= request["at"]:
        return None
    state_write("lift-end-stop", convoy.id, "--answer", END_STOP_LIFT_ANSWER, "--answered-at", answered_at)
    convoy.load()
    return {"action": "lifted", "reason": stop["reason"], "commit": stop["commit"], "answered_at": answered_at}


# --- the pass ----------------------------------------------------------------


@contextmanager
def advance_lock() -> Iterator[bool]:
    """One whole pass at a time, Factory-wide: N is shared between convoys.

    False when another pass holds it: the order starts a pass while the last
    one still runs. A pass that waited for the lock spent the order's 300 s
    there and was killed (af-wz4dd8); a pass that overlapped settlement
    amplified tracker load until both exceeded that deadline (af-ebqm1y).
    The pass that holds it does the work; a later pass reads what it left."""
    lock_dir = advance_pass.lock_dir()
    lock_dir.mkdir(parents=True, exist_ok=True)
    with (lock_dir / advance_pass.LOCK_NAME).open("w") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        try:
            # bin/factory-watchdog holds back a ticket this pass may be moving (af-xgd1rd).
            advance_pass.mark_started()
            yield True
        finally:
            advance_pass.mark_ended()
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def dispatch(convoy: Convoy, ticket_id: str, rig: str, settings: dict[str, Any]) -> subprocess.CompletedProcess[str]:
    argv = [str(DOOR_BIN), ticket_id, "--rig", rig, "--formula", settings["formula"], "--convoy", convoy.id]
    if settings["role"]:
        argv += ["--role", settings["role"]]
    return run(argv)


def advance_convoy(convoy: Convoy, settings: dict[str, Any], free: int, alive: set[str],
                   reserved: int = 0) -> dict[str, Any]:
    """`reserved`: the places the counted correction rounds wait for; the
    resumes go before them, the starts after them."""
    out: dict[str, Any] = {"id": convoy.id, "started": [], "waiting": [], "deferred": [], "refused": [],
                           "resumed": [], "parked": [], "lifted": []}
    migrated = False
    for ticket in convoy.tickets:
        if not legacy_repair_resume_due(ticket):
            continue
        try:
            state_write("migrate-repair-resume", convoy.id, ticket["id"])
            migrated = True
        except Refusal as exc:
            out["refused"].append({"id": ticket["id"], "reason": str(exc)})
    if migrated:
        convoy.load()
    incident = settle_incident(convoy)
    if incident:
        out["incident"] = incident
    if convoy.unruled:
        out["signal"] = UNRULED
        out["unruled"] = convoy.unruled
        return out
    if convoy.closed:
        # Closed by command: an Accepted or abandoned Outcome is not reopened.
        out["closed"] = convoy.closed
        return out
    withdrawn_by_decision = withdraw_exact_answered_r6_r7(convoy)
    if withdrawn_by_decision:
        out["withdrawn_by_decision"] = withdrawn_by_decision
        return out
    closed_without_merge = close_exact_answered_r8(convoy)
    if closed_without_merge:
        out["closed_without_merge"] = closed_without_merge
        if "error" in closed_without_merge:
            return out
    # The repair of a red that did not reproduce for its author, nothing to
    # merge: code replays the red control before anyone is asked again.
    replayed = close_green_red_repair(convoy)
    if replayed:
        out["red_repair_replay"] = replayed
        if "error" in replayed:
            return out
    # The repair of a red a control already withdrew green: its proof is
    # recorded, nothing is replayed.
    cleared = close_cleared_red_repair(convoy)
    if cleared:
        out["red_repair_cleared"] = cleared
        if "error" in cleared:
            return out
    # A red integration branch (T21): its one repair is published, and
    # nothing but that repair starts or is resumed.
    only: set[str] | None = None
    if convoy.red:
        repair = settle_red(convoy)
        if repair:
            out["repair"] = repair
        only = {convoy.red["repair"]} if convoy.red and "repair" in convoy.red else set()
    # The tracked elements the operator asked to have repaired (T23): their
    # repair is published, and starts like any ticket.
    item_repairs = settle_item_repairs(convoy)
    if item_repairs:
        out["item_repairs"] = item_repairs
    # What the Evaluator of the end drafted (T24): published the same way.
    outcome_repairs = settle_outcome_repairs(convoy)
    if outcome_repairs:
        out["outcome_repairs"] = outcome_repairs
    # A same-repository maintenance repair first enters the integration tree
    # through its existing tested take-up gate. Only that green result can
    # release the parking and consume the one repair_delivered resume.
    if not convoy.red:
        take_up = take_up_delivered_repairs(convoy)
        if take_up:
            out["repair_take_up"] = take_up
            if "error" in take_up or "message" in take_up or "unruled" in take_up:
                return out
    # A linked repair that can only be made in the convoy goes back to the
    # ticket's author before the lifts read the links.
    settle_returned_repairs(convoy, out)
    # The answers first: a ticket whose parking is lifted is resumed, and
    # those behind it started, by the same pass.
    settle_lifts(convoy, out)
    red, opened = convoy.red, open_exceptions(convoy)
    held = None
    if red:
        out["stop"] = {"reason": STOP_RED, "control": red["control"], "repair": red.get("repair")}
    elif len(opened) >= settings["open_exceptions"]:
        # As many Planning Exceptions open on the Spec as the bound allows:
        # no new ticket starts; the tickets at work go on.
        out["stop"] = {"reason": STOP_EXCEPTIONS, "open": opened, "bound": settings["open_exceptions"]}
        held = (f"{len(opened)} Planning Exceptions ouvertes sur la Spec ({', '.join(opened)}) : aucun nouveau "
                f"ticket ne démarre (borne : {settings['open_exceptions']})")
    settle_resumes(convoy, settings, free, alive, out, only)
    for ticket in convoy.not_started():
        ticket_id = ticket["id"]
        park = ticket.get("park")
        if park:
            # Parked by a Ticket Exit (bin/ticket-exit), itself or behind the
            # ticket it waits for: not started until the parking is lifted.
            out["waiting"].append({"id": ticket_id, "reason": f"parqué ({park.get('cause')}, par {park.get('origin')})"})
            continue
        if only is not None and ticket_id not in only:
            out["waiting"].append({"id": ticket_id, "reason": red_reason(red)})
            continue
        if held:
            out["waiting"].append({"id": ticket_id, "reason": held})
            continue
        if len(out["started"]) + len(out["resumed"]) >= free - reserved:
            out["waiting"].append({"id": ticket_id, "reason": f"plafond N={settings['ceiling']} atteint"})
            continue
        blockers = open_blockers(ticket_id)
        if blockers:
            out["waiting"].append({"id": ticket_id, "reason": "bloqué par " + ", ".join(blockers)})
            continue
        rig = convoy.rigs.get(ticket_id)
        if not rig:
            out["refused"].append({"id": ticket_id, "reason": "le ticket ne nomme pas un seul projet connu de "
                                                              "config/projects sous « Target rigs »"})
            continue
        proc = dispatch(convoy, ticket_id, rig, settings)
        if proc.returncode == 0:
            out["started"].append(ticket_id)
        else:
            reason = (proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}").splitlines()[-1]
            out["deferred" if proc.returncode == DOOR_DEFERRED else "refused"].append({"id": ticket_id, "reason": reason})
    # Once the starts are made: is anything but parked tickets left?
    if out["started"] or out["resumed"] or out["parked"] or out["lifted"]:
        convoy.load()
    lifted_before_grouped = len(out["lifted"])
    grouped = settle_grouped_request(convoy, out)
    if grouped:
        out["grouped_request"] = grouped
    if len(out["lifted"]) > lifted_before_grouped:
        # A grouped answer recorded during the pass was applied just before
        # withdrawal; give its already-counted resume the same-pass launch it
        # would have received had the answer arrived before settle_lifts.
        settle_resumes(convoy, settings, free, alive, out, only)
    return out


def rig_profile(rig: str) -> Path:
    """The profile of the project that spans this rig: it declares the tests
    run on a merged result."""
    for path in sorted(DESCRIPTORS.glob("*.json")):
        try:
            rigs = json.loads(path.read_text(encoding="utf-8")).get("rigs")
        except (OSError, json.JSONDecodeError, AttributeError):
            continue
        if isinstance(rigs, list) and rig in rigs:
            return path
    raise Refusal(f"aucun profil de projet de config/project-descriptors ne couvre le rig {rig} : "
                  "les tests à exécuter sur un résultat fusionné ne sont déclarés nulle part")


def merge_finished(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §4: code merges the finished tickets of the convoy into the
    integration branch of its Spec, one at a time, through
    bin/spec-integration. None when the convoy has nothing to merge. A
    convoy whose integration branch is red is always handed over: the merge
    command alone merges its repair, or sees that the control is green again."""
    if not convoy.integration or not (convoy.finished_unmerged() or convoy.red):
        return None
    try:
        if not convoy.rig:
            raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de config/projects : "
                          "le dépôt de sa branche d'intégration est inconnu")
        proc = run([str(INTEGRATION_BIN), "merge", convoy.id, "--repo", str(convoy.repo),
                    "--profile", str(rig_profile(convoy.rig)), "--limit", str(MERGES_PER_PASS)])
        answer = parsed(proc, f"spec-integration merge {convoy.id}")
    except Refusal as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : spec-integration merge {convoy.id} a rendu une réponse illisible"}
    kept = ("branch", "integration", "takeover", "merged", "returned", "refused", "waiting", "error", "message",
            "unruled", "red")
    result = {name: answer[name] for name in kept if name in answer}
    if "red" in result and "error" in result:
        # The merge command refuses on a red integration branch: the convoy
        # is stopped for a cause that is recorded and has its repair, which
        # is an outcome of the pass, not a failure of it.
        del result["error"]
        result["stopped"] = RED
    return result


def already_green_due(ticket: dict[str, Any], alive: set[str]) -> bool:
    """An all-green stop is the operator's once its author settled it: the
    Planning Exception raised since the stop is answered and parks the
    ticket no more, or the author's session is over without raising one.
    Never while a parking holds its own request (af-npz9v1.9)."""
    if ticket.get("park"):
        return False
    since = [e for e in ticket.get("planning_exceptions") or [] if e.get("at", "") >= ticket["stop"].get("at", "")]
    if since:
        return since[-1].get("state") != "open"
    return (ticket.get("session") or {}).get("name") not in alive


def tdd_stop_request(ticket: dict[str, Any]) -> str:
    """What the operator reads on the escalation door's list: the ticket and
    the cause of its stop."""
    stop = ticket["stop"]
    return json.dumps({
        "quoi": one_line(f"Ticket {ticket['id']} arrêté : {TDD_STOPS[stop['reason']]} — {stop.get('detail', '')}"),
        "pourquoi": ("Un test gelé ne s'amende qu'une fois par ticket" if stop["reason"] == "amendment_exhausted"
                     else "Le code existant satisfait déjà ce ticket" if stop["reason"] == ALREADY_GREEN
                     else "La relecture des tests a arrêté ce ticket avant ADR-0030 L3")
                    + " : le travail de ce ticket ne reprend pas sans ta réponse.",
        "que_faire": [
            # af-npz9v1.9: no door closes an unmerged ticket; the Planning Run does.
            {"option": "Clore ce ticket comme satisfait par le code existant",
             "consequence": "La clôture se fait dans le Planning Run ; cette réponse seule ne ferme pas le ticket."}
            if stop["reason"] == ALREADY_GREEN else
            {"option": "Accepter un amendement de plus de ses tests et faire reprendre le ticket",
             "consequence": "Une nouvelle session de l'auteur reprend le ticket ; ses tests amendés sont gelés à nouveau."},
            {"option": "Laisser le ticket arrêté",
             "consequence": "Rien de ce ticket ne fusionne ; les tickets qui l'attendent ne démarrent pas."},
        ],
        "langue": operator_language(),
        "bloquant": True,
    }, ensure_ascii=False)


def settle_tdd_stops(convoy: Convoy, alive: set[str]) -> dict[str, Any] | None:
    """Spec §8: a ticket bin/tdd-step stopped at its second amendment reaches
    the operator through bin/escalation-door, once per stop: bin/convoy-state
    records that it did. None when the convoy has no such stop to raise."""
    due = convoy.tdd_stops_due(alive)
    if not due:
        return None
    result: dict[str, Any] = {"escalated": []}
    for ticket in due:
        try:
            passed(run([str(ESCALATION_BIN), "benjamin", ticket["id"], tdd_stop_request(ticket)]), "escalation-door benjamin")
            state_write("stop-raised", convoy.id, ticket["id"])
        except Refusal as exc:
            result["error"] = f"refus : {exc}"
            break
        result["escalated"].append({"ticket": ticket["id"], "reason": ticket["stop"]["reason"]})
    return result


def settle_code_reviews(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §6, §8: code, not a session, has each finished ticket reviewed
    before its merge, through bin/code-review. None when the convoy has no
    finished ticket to review."""
    if not convoy.code_reviews_due():
        return None
    try:
        answer = parsed(run([str(CODE_REVIEW_BIN), "settle", convoy.id, "--repo", str(convoy.repo)]),
                        f"code-review settle {convoy.id}")
    except Refusal as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : code-review settle {convoy.id} a rendu une réponse illisible"}
    # A branch behind the integration tip is refused by the review and handed
    # back by the next pass (behind_due): a wait here, not a failed pass.
    refused = answer.get("refused") if isinstance(answer.get("refused"), list) else []
    behind = [entry for entry in refused if isinstance(entry, dict) and entry.get("cause") == BEHIND]
    if behind:
        answer = {**answer, "refused": [entry for entry in refused if entry not in behind], "behind": behind}
    kept = ("launched", "relaunched", "pending", "waiting", "stopped", "escalated", "deferred", "refused", "behind",
            "error")
    return {name: answer[name] for name in kept if answer.get(name)}


def settle_standard_recurrences(convoy: Convoy) -> dict[str, Any] | None:
    """Reconcile already recorded Blocking Findings with written project rules."""
    if (not convoy.rig
            or not any((convoy.repo / name).is_file() for name in ("STANDARDS.md", "DESIGN.md"))
            or not any((ticket.get(control) or {}).get("rounds")
                       for ticket in convoy.tickets for control in ("code_review", "evaluation"))):
        return None
    proc = run([str(PROJECT_STANDARDS_BIN), "--repo-root", str(ROOT), "recurrence", "--rig", convoy.rig])
    try:
        answer = parsed(proc, f"project-standards recurrence {convoy.rig}")
    except Refusal as exc:
        return {"error": f"refus : {exc}"}
    if proc.returncode or not isinstance(answer, dict) or not answer.get("ok"):
        detail = answer.get("error") if isinstance(answer, dict) else "réponse illisible"
        return {"error": f"refus : project-standards recurrence {convoy.rig} : {detail}"}
    return {"created": answer["created"]} if answer.get("created") else None


def settle_evaluations(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §7, §8: code, not a session, has each finished ticket evaluated
    on the launched product before its merge, through bin/ticket-evaluation.
    None when the convoy has nothing to evaluate and no product to stop."""
    if not convoy.evaluations_due():
        return None
    try:
        answer = parsed(run([str(EVALUATION_BIN), "settle", convoy.id, "--repo", str(convoy.repo)]),
                        f"ticket-evaluation settle {convoy.id}")
    except Refusal as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : ticket-evaluation settle {convoy.id} a rendu une réponse illisible"}
    kept = ("launched", "relaunched", "pending", "waiting", "started", "refused_startup", "planning_exception",
            "stopped", "escalated", "deferred", "refused", "error")
    return {name: answer[name] for name in kept if answer.get(name)}


def settle_corrections(convoy: Convoy, free: int | None = None) -> dict[str, Any] | None:
    """Spec §8: code, not a session, opens the correction rounds of a
    ticket its code review or its evaluation refused, sends each to one fresh
    author session, and stops the ticket still refused after the last, through
    bin/correction-round, at most `free` rounds sent (af-sdd8gr). None when
    the convoy has no finished ticket, or when nothing was refused: the
    settlement then had nothing to say."""
    if not convoy.corrections_due():
        return None
    places = [] if free is None else ["--free", str(max(0, free))]
    try:
        answer = parsed(run([str(CORRECTION_BIN), "settle", convoy.id, *places, "--repo", str(convoy.repo)]),
                        f"correction-round settle {convoy.id}")
    except Refusal as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : correction-round settle {convoy.id} a rendu une réponse illisible"}
    kept = ("launched", "pending", "waiting", "stopped", "escalated", "deferred", "refused", "error")
    return {name: answer[name] for name in kept if answer.get(name)} or None


def fidelity_files(convoy: Convoy) -> tuple[Path, Path, Path]:
    """The lock a running fidelity check of the convoy holds, and where it
    writes its answer and its errors."""
    run_dir = Path(os.environ.get("CONVOY_ADVANCE_LOCK_DIR") or os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
    run_dir.mkdir(parents=True, exist_ok=True)
    stem = f"agent-factory-convoy-fidelity-{convoy.id}"
    return run_dir / f"{stem}.lock", run_dir / f"{stem}.json", run_dir / f"{stem}.err"


def collected_fidelity(convoy: Convoy, out: Path, err: Path) -> Any:
    """The answer of a fidelity check that ended; its files are removed."""
    try:
        proc = subprocess.CompletedProcess([], 0, out.read_text(encoding="utf-8"),
                                           err.read_text(encoding="utf-8") if err.exists() else "")
    finally:
        out.unlink(missing_ok=True)
        err.unlink(missing_ok=True)
    return parsed(proc, f"ticket-end fidelity {convoy.id}")


def check_fidelity(convoy: Convoy) -> dict[str, Any] | None:
    """Spec §9, condition 4: code, before the merge, runs the mechanical
    fidelity check of each finished interface ticket at the tip of its
    branch, through bin/ticket-end fidelity, which records the result on the
    ticket. None when the convoy has no such ticket to measure.

    The check runs in its own session, holding the lock of the convoy's
    check (af-pxijl6): a pass killed at the order's timeout does not kill
    it, a pass that finds it running leaves it, and the pass that finds it
    ended reads its answer."""
    lock, out, err = fidelity_files(convoy)
    with lock.open("a") as handle:
        try:
            fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            due = convoy.fidelity_due()
            return {"waiting": [{"id": ticket, "reason": "contrôle de fidélité en cours, lancé par une passe précédente"}
                                for ticket in due]} if due else None
        try:
            if out.exists():
                answer = collected_fidelity(convoy, out, err)
            elif not convoy.fidelity_due():
                return None
            else:
                if not convoy.rig:
                    raise Refusal(f"les tickets du convoi {convoy.id} ne nomment pas un seul projet connu de "
                                  "config/projects : le profil qui déclare ses écrans est inconnu")
                argv = [str(TICKET_END_BIN), "fidelity", convoy.id, "--repo", str(convoy.repo),
                        "--profile", str(rig_profile(convoy.rig)), "--limit", str(FIDELITY_CHECKS_PER_PASS)]
                try:
                    with out.open("w") as stdout, err.open("w") as stderr:
                        check = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=stdout, stderr=stderr,
                                                 cwd=ROOT, start_new_session=True, pass_fds=(handle.fileno(),))
                except OSError as exc:
                    out.unlink(missing_ok=True)
                    err.unlink(missing_ok=True)
                    raise Refusal(f"impossible de lancer {argv[0]} : {exc}") from exc
                wait = float(os.environ.get("CONVOY_ADVANCE_FIDELITY_WAIT") or FIDELITY_WAIT_SECONDS)
                try:
                    check.wait(timeout=wait)
                except subprocess.TimeoutExpired:
                    return {"waiting": [{"id": ticket, "reason": "contrôle de fidélité en cours au-delà de la passe : "
                                         "une passe suivante en lit le résultat"} for ticket in convoy.fidelity_due()]}
                answer = collected_fidelity(convoy, out, err)
        except Refusal as exc:
            return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : ticket-end fidelity {convoy.id} a rendu une réponse illisible"}
    kept = ("checked", "waiting", "refused", "error", "message", "unruled")
    return {name: answer[name] for name in kept if answer.get(name)} or None


def settle_ticket_end(convoy: Convoy, merge: dict[str, Any] | None) -> dict[str, Any] | None:
    """Spec §9: code, and no agent, closes a ticket, through the ticket-end
    gate (bin/ticket-end settle): each merged ticket whose nine conditions
    are met is closed with the record of the gate; the others stay open,
    what they miss named. None when the convoy has no merged ticket left
    open and this pass merged none."""
    if not convoy.merged_open() and not (merge or {}).get("merged"):
        return None
    try:
        answer = parsed(run([str(TICKET_END_BIN), "settle", convoy.id, "--repo", str(convoy.repo)]),
                        f"ticket-end settle {convoy.id}")
    except Refusal as exc:
        return {"error": f"refus : {exc}"}
    if not isinstance(answer, dict):
        return {"error": f"refus : ticket-end settle {convoy.id} a rendu une réponse illisible"}
    kept = ("version", "closed", "open", "error", "message", "unruled")
    return {name: answer[name] for name in kept if answer.get(name)}


# What fails a pass, step by step: the keys of a step's answer that make it
# a failure, not an outcome. A step whose answer is a list fails on an entry
# carrying one of them.
FAILING_KEYS: tuple[tuple[str, tuple[str, ...]], ...] = (
    ("incident", ("error",)), ("grouped_request", ("error",)), ("repair", ("error",)),
    ("withdrawn_by_decision", ("error",)),
    ("closed_without_merge", ("error", "message", "unruled")),
    ("repair_take_up", ("error", "message", "unruled")),
    ("item_repairs", ("error",)), ("outcome_repairs", ("error",)), ("outcome_evaluation", ("error",)),
    ("spec_end", ("error", "message")), ("end_review", ("error",)), ("evidence_pack", ("error",)),
    ("non_conforme", ("error",)), ("acceptance", ("error",)), ("promotion", ("error", "message", "pending")),
    ("integration", ("error", "message")), ("tdd_stops", ("error",)), ("code_review", ("error", "refused")),
    ("standard_recurrence", ("error",)), ("evaluation", ("error", "refused")),
    ("correction", ("error", "refused")), ("fidelity", ("error", "message")),
    ("ticket_end", ("error", "message")),
)
FAILURE_DETAIL_CHARS = 300


def pass_failures(result: dict[str, Any]) -> list[str]:
    """Each step of one convoy's pass that failed it, as `convoy step.key: detail`."""
    found: list[tuple[str, Any]] = []
    if result.get("refused"):
        found.append(("start.refused", result["refused"]))
    for step, keys in FAILING_KEYS:
        answer = result.get(step)
        entries = answer if isinstance(answer, list) else [answer] if isinstance(answer, dict) else []
        found += [(f"{step}.{key}", entry[key]) for entry in entries for key in keys if key in entry]
    promotion_repair = (result.get("promotion") or {}).get("repair") or {}
    if "error" in promotion_repair:
        found.append(("promotion.repair.error", promotion_repair["error"]))
    found += [("end_review.repairs.error", entry["error"])
              for entry in (result.get("end_review") or {}).get("repairs", []) if "error" in entry]
    return [f"{result['id']} {where}: {detail if isinstance(detail, str) else json.dumps(detail, ensure_ascii=False)}"
            [:FAILURE_DETAIL_CHARS] for where, detail in found]


def failure_line(message: str | None, failed: list[str]) -> str:
    """The one line, last of the output, that names why the pass failed."""
    return f"{PROGRAM}: échec de la passe -- " + " ; ".join(([message] if message else []) + failed)


def one_pass(targets: list[str] | None, stopped_ok: bool = False) -> int:
    """`targets` None: every marked convoy that is open or was closed outside its commands."""
    # Sessions are listed before the state is read: a session that ends
    # between the two reads is then still seen alive, and nothing it wrote
    # before ending is missed (a stop raised before its exception).
    live = live_sessions()
    convoys = {convoy_id: Convoy(convoy_id) for convoy_id in targets or []}
    settings = load_settings()
    for convoy_id in marked_convoys():
        if convoy_id not in convoys:
            convoy = Convoy(convoy_id)
            if not convoy.closed:
                convoys[convoy_id] = convoy
    sessions = role_sessions(live)
    awaiting = sorted(ticket for convoy in convoys.values() for ticket in convoy.awaiting_a_session())
    # N counts authors only: a reviewer or Evaluator session, even idle
    # until its idle_timeout, does not hold an author's place (af-4xxlo7).
    occupied = sessions.get("author", 0) + len(awaiting)
    free = max(0, settings["ceiling"] - occupied)

    # A correction round counted and waiting for its place is sent after the
    # resumes and before any start (af-sdd8gr): its places are held here.
    waiting_rounds = {convoy_id: convoy.rounds_waiting() for convoy_id, convoy in convoys.items()}
    results, alive = [], session_names(live)
    # The convoy whose counted resume waits the longest for a place is walked
    # first, so that a convoy sorted before it does not take that place
    # (af-u21377); the others keep their order.
    waits = {convoy_id: min((since for t in convoy.tickets if (since := waiting_since(t))), default=None)
             for convoy_id, convoy in convoys.items()}
    walked = targets if targets is not None else sorted(convoys, key=lambda c: (waits[c] is None, waits[c] or "", c))
    for convoy_id in walked:
        result = advance_convoy(convoys[convoy_id], settings, free, alive, sum(waiting_rounds.values()))
        free -= len(result["started"]) + len(result["resumed"])
        results.append(result)

    # Settlement stays under the pass lock. Individual long-running checks
    # still use their own per-convoy locks and outlive this pass where noted.
    for result in results:
        if "unruled" in result:
            continue
        # Benjamin answered « accepté » or « abandonné »: his answer is
        # followed, and nothing else is rendered on that Outcome -- the end
        # of the Spec is not run again on a commit he judged.
        promotion = settle_promotion(convoys[result["id"]])
        if promotion is not None:
            result["promotion"] = promotion
            continue
        # A ticket a step of its TDD stopped reaches the operator.
        tdd_stops = settle_tdd_stops(convoys[result["id"]], alive)
        if tdd_stops is not None:
            result["tdd_stops"] = tdd_stops
        # The reviews first: a ticket whose verdict is already there is
        # merged by the same pass.
        code_reviews = settle_code_reviews(convoys[result["id"]])
        if code_reviews is not None:
            result["code_review"] = code_reviews
        recurrences = settle_standard_recurrences(convoys[result["id"]])
        if recurrences is not None:
            result["standard_recurrence"] = recurrences
        evaluations = settle_evaluations(convoys[result["id"]])
        if evaluations is not None:
            result["evaluation"] = evaluations
        # Once both have answered: what they refused goes to one author
        # session, and a ticket still refused after its round is stopped.
        # A round takes a place left under the ceiling, those the counted
        # rounds of the convoys settled after this one wait for held.
        waiting_rounds[result["id"]] = 0
        corrections = settle_corrections(convoys[result["id"]], max(0, free - sum(waiting_rounds.values())))
        if corrections is not None:
            result["correction"] = corrections
            free -= len(corrections.get("launched") or [])
        # Before the merge: the fidelity of an interface ticket is measured
        # on the commit that merges (condition 4 of the ticket-end gate).
        fidelity = check_fidelity(convoys[result["id"]])
        if fidelity is not None:
            result["fidelity"] = fidelity
        merge = merge_finished(convoys[result["id"]])
        if merge is not None:
            result["integration"] = merge
        # After the merge: the gate closes what its nine conditions allow.
        closing = settle_ticket_end(convoys[result["id"]], merge)
        if closing is not None:
            result["ticket_end"] = closing
        # Once every ticket is closed: the mechanical verdicts of the end of
        # the Spec, on one tip of the integration branch.
        ending = settle_spec_end(convoys[result["id"]], closing)
        if ending is not None:
            result["spec_end"] = ending
        # Once its mechanical verdicts are green: the assembled product is
        # launched and sent to the Evaluator of the end.
        outcome = settle_outcome_evaluation(convoys[result["id"]])
        if outcome is not None:
            result["outcome_evaluation"] = outcome
        # On the commit of those verdicts, in the same pass: the end code
        # review of the whole assembled diff, and the repairs it drafted. A
        # capacity deferral must defer both launches so a later pass can still
        # start them together on that commit.
        if (outcome or {}).get("action") != "deferred":
            end_review = settle_end_review(convoys[result["id"]])
            if end_review is not None:
                result["end_review"] = end_review
        # Every condition before it met on that commit: the Evidence Pack is
        # generated by code, and the gate reads it in this same pass.
        pack = settle_evidence_pack(convoys[result["id"]], ending)
        if pack is not None:
            result["evidence_pack"] = pack
            if "error" not in pack:
                result["spec_end"] = settle_spec_end(convoys[result["id"]], None) or ending
        # The rounds of the end are stopped, whatever stopped them and even
        # under a red: the « non conforme » request reaches the operator.
        non_conforme = settle_non_conforme(convoys[result["id"]])
        if non_conforme is not None:
            result["non_conforme"] = non_conforme

        # A Delivered Outcome waits for Benjamin, and for nothing else: its
        # Acceptance Request reaches him once, and the product of an
        # Acceptance Session that did not start gets its `repair`.
        acceptance = settle_acceptance(convoys[result["id"]])
        if acceptance is not None:
            result["acceptance"] = acceptance

    unruled = any("unruled" in result for result in results)
    # A ticket returned or refused by the merge is an outcome of the pass; a
    # merge pass that could not run is a failure of it.
    failed = [failure for result in results for failure in pass_failures(result)]
    refused = bool(failed)
    capacity_deferred = refused and all("NOT RUN, exit 75" in failure for failure in failed)
    answer: dict[str, Any] = {
        "ok": not (unruled or refused), "ceiling": settings["ceiling"], "sessions": sessions,
        "awaiting_a_session": awaiting, "occupied": occupied, "convoys": results,
    }
    if unruled:
        answer["message"] = f"{UNRULED} : rien n'est démarré dans le convoi concerné"
    print(json.dumps(answer, indent=2, sort_keys=True, ensure_ascii=False))
    if unruled or refused:
        # The order keeps only the tail of a failed pass's output (af-ypj2g0):
        # what made it fail is named last, where that tail still reads it.
        sys.stdout.flush()
        print(failure_line(answer.get("message"), failed), file=sys.stderr)
    return (EXIT_UNRULED if unruled and not stopped_ok else
            EXIT_DEFERRED if capacity_deferred else EXIT_REFUSED if refused else 0)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("convoy", nargs="?")
    parser.add_argument("--all", action="store_true", help="one pass on every open marked convoy, and on those closed outside acceptance or abandon")
    parser.add_argument("--check-only", action="store_true", help="exit 0 if a marked convoy is open or was closed outside acceptance or abandon, else 1")
    parser.add_argument("--stopped-ok", action="store_true",
                        help="exit 0, not 3, for a stopped convoy whose incident is raised (what the order runs)")
    args = parser.parse_args(argv)
    if sum((bool(args.convoy), args.all, args.check_only)) != 1:
        parser.error("exactly one of CONVOY, --all or --check-only is required")
    try:
        if args.check_only:
            return 0 if marked_convoys() else 1
        with advance_lock() as held:
            if not held:
                print(json.dumps({"ok": True, "skipped": PASS_RUNNING}, indent=2,
                                 sort_keys=True, ensure_ascii=False))
                return 0
            prior_lock_marker = os.environ.get("CONVOY_ADVANCE_LOCK_HELD_BY_PASS")
            os.environ["CONVOY_ADVANCE_LOCK_HELD_BY_PASS"] = "1"
            try:
                return one_pass(None if args.all else [args.convoy], args.stopped_ok)
            finally:
                if prior_lock_marker is None:
                    os.environ.pop("CONVOY_ADVANCE_LOCK_HELD_BY_PASS", None)
                else:
                    os.environ["CONVOY_ADVANCE_LOCK_HELD_BY_PASS"] = prior_lock_marker
    except NotNewFlow as exc:
        print(json.dumps(json.loads(str(exc)), indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_NOT_NEW_FLOW
    except Refusal as exc:
        print(json.dumps({"ok": False, "error": f"refus : {exc}"}, indent=2, sort_keys=True, ensure_ascii=False))
        return EXIT_REFUSED


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
