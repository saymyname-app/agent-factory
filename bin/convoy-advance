FIDELITY_CHECKS_PER_PASS = 1
# How long a pass waits for the fidelity check it started (af-pxijl6). The
# check runs in its own session and outlives the pass, which the order kills
# at 300 s: it is left running and its answer read by a later pass, instead
# of being killed and started again from zero by every pass. Not waited for
# (af-wz4dd8, ADR-0032): 120 s of it, on a pass slowed by the load of the
# host, made the pass of 20/10 01:27 Paris outlast the 300 s.
FIDELITY_WAIT_SECONDS = 0
# What a pass answers when another one holds the lock (af-wz4dd8).
