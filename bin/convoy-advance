R6_R7_WITHDRAWAL_TEST_ENV = "CONVOY_ADVANCE_TEST_R6_R7_WITHDRAWAL"
# The resume that lifts that stop when every change since the freeze is the
# base's the branch merged, not the ticket's (af-npz9v1.39): no amendment
# was the ticket's to take, so no answer of the operator is asked.
INHERITED_CHANGE = "inherited_change"
# ADR-0030 L3 removed the test review: a ticket it stopped before is resumed
# on itself, once per stop, its request withdrawn (af-pjvsgo). A code review
# without result is resumed the same way (af-wu6xj7): most often a defect of
# the factory (a reviewer seat held, a launch), its round dropped.
STAGE_REMOVED = "stage_removed"
REMOVED_STAGE_STOPS = ("test_review_refused", "test_review_no_result")
# Spec §8, K: a ticket out of resumes is parked for this cause (bin/convoy-state).
PARK_EXHAUSTED = "resumes_exhausted"
COMMIT_AFTER_VERDICT = "commit_after_verdict"
# The words of the operator for each cause of parking.
PARK_CAUSES = {PARK_EXHAUSTED: "reprises épuisées", "operator_request": "demande opérateur",
               "planning_exception": "Planning Exception"}

# Spec §8: the two stops of a convoy (T21), and the contract a revision
# that adds a ticket to a marked convoy declares.
RED = "branche d'intégration rouge"
# What is red on the integration branch when it is not its regression
# command: the mechanical fidelity the end-of-Spec gate measured (T23).
RED_FIDELITY = "fidelity"
ITEM_LABELS = {"deviations": "écart", "not_done": "« non fait »"}
# A finding « hors ticket » classified « repaired » whose repair is not
# closed by the ticket-end gate yet (bin/convoy-state).
FINDING_TO_REPAIR = "à réparer"
STOP_RED, STOP_EXCEPTIONS = "integration_red", "planning_exceptions"
# The Outcome Evaluation stopped by a drafted repair the patch door refused (lib/convoy_state.py OUTCOME_STOPS).
STOP_OUTCOME_REPAIR_REFUSED = "outcome_repair_refused"
BOUND_EXCEPTIONS = "open_planning_exceptions"
NEW_FLOW = "new-flow/v1"

UNRULED = "état sans règle"
# bin/escalation-door refuses a field longer than this, or on several lines.
REQUEST_LINE_MAX = 140
CLOSING_GATES = ("ticket_end", "withdrawn")
RIG_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
# The publication door renders a ticket's rigs under this heading.
RIGS_SECTION_RE = re.compile(r"^## Target rigs[ \t]*\n+([^\n#]*)$", re.MULTILINE)


class Refusal(RuntimeError):
    """The pass cannot be made: nothing is started."""


class DoorRefusal(Refusal):
    """The patch door ran and refused the draft: publishing it again
    refuses again, so it is recorded where it was drafted, not retried."""


class NotNewFlow(RuntimeError):
    """The convoy does not carry the new-flow mark; carries convoy-state's answer."""


class Deferred(RuntimeError):
    """The dispatch door deferred a launch: the next pass retries it."""


# --- reads -------------------------------------------------------------------


def run(argv: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(argv, capture_output=True, text=True, cwd=ROOT)
    except OSError as exc:
        raise Refusal(f"impossible de lancer {argv[0]} : {exc}") from exc


def parsed(proc: subprocess.CompletedProcess[str], what: str) -> Any:
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise Refusal(f"{what} a rendu une réponse illisible : {detail[-300:]}") from exc


def gc_json(*args: str) -> Any:
    proc = run([GC_BIN, "--city", str(ROOT), *args])
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise Refusal(f"gc {' '.join(args[:3])} a échoué : {detail[-300:]}")
    return parsed(proc, f"gc {' '.join(args[:3])}")


def read_bead(bead_id: str) -> dict[str, Any]:
    data = gc_json("bd", "show", bead_id, "--json")
    if isinstance(data, list):
        data = data[0] if data else None
    if not isinstance(data, dict):
        raise Refusal(f"bead introuvable : {bead_id}")
    return data


def marked_convoys() -> list[str]:
    """The open marked convoys, and those closed outside the acceptance and
    abandon commands (T22): a pass starts nothing in these, it raises them."""
    proc = run([str(STATE_BIN), "list"])
    answer = parsed(proc, "convoy-state list")
    listed = [answer.get("convoys"), answer.get("closed_outside")]
    if proc.returncode != 0 or not all(isinstance(ids, list) for ids in listed):
        raise Refusal(f"convoy-state list a échoué : {answer.get('error', proc.returncode)}")
    return [*listed[0], *listed[1]]


def ticket_rig(description: Any) -> str | None:
    """The single project a ticket targets, or None when it names none or several."""
    match = RIGS_SECTION_RE.search(description if isinstance(description, str) else "")
    rigs = [rig.strip() for rig in match.group(1).split(",") if rig.strip()] if match else []
    if len(rigs) != 1 or not RIG_RE.match(rigs[0]) or not (PROJECTS / f"{rigs[0]}.toml").is_file():
        return None
    return rigs[0]


def rig_repository(rig: str) -> Path:
    try:
        rig_dir = tomllib.loads((PROJECTS / f"{rig}.toml").read_text(encoding="utf-8")).get("rig_dir")
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise Refusal(f"config/projects/{rig}.toml illisible : {exc}") from exc
    if not isinstance(rig_dir, str) or not rig_dir:
        raise Refusal(f"config/projects/{rig}.toml ne déclare pas rig_dir")
    return ROOT / rig_dir


class Convoy:
    """A marked convoy as bin/convoy-state renders it, plus each ticket's rig."""

    def __init__(self, convoy_id: str) -> None:
        self.id = convoy_id
        self.load()

    def load(self) -> None:
        """Read the convoy again: a pass that parked, lifted or resumed
        decides the rest from what it wrote."""
        convoy_id = self.id
        tracked = [
            dep for dep in read_bead(convoy_id).get("dependencies") or []
            if isinstance(dep, dict) and dep.get("dependency_type") == "tracks"
        ]
        self.rigs = {dep.get("id"): ticket_rig(dep.get("description")) for dep in tracked}
        # Ticket branches live in the repository of the convoy's project;
        # convoy-state ties each verdict to its branch tip there.
        known = {rig for rig in self.rigs.values() if rig}
        self.rig: str | None = next(iter(known)) if len(known) == 1 else None
        repo = self.repo = rig_repository(self.rig) if self.rig else ROOT
        proc = run([str(STATE_BIN), "show", convoy_id, "--repo", str(repo)])
        answer = parsed(proc, f"convoy-state show {convoy_id}")
        if proc.returncode == EXIT_NOT_NEW_FLOW:
            raise NotNewFlow(json.dumps(answer))
        if proc.returncode not in (0, EXIT_UNRULED) or not isinstance(answer.get("tickets"), list):
            raise Refusal(f"convoy-state show {convoy_id} a échoué : {answer.get('error', proc.returncode)}")
        self.tickets: list[dict[str, Any]] = answer["tickets"]
        self.integration: dict[str, Any] | None = answer["convoy"].get("integration")
        incident = answer["convoy"].get("incident")
        # An unreadable record is one of the anomalies below, not a known incident.
        self.incident: dict[str, Any] | None = incident if isinstance(incident, dict) and "bead" in incident else None
        # An unreadable record is an anomaly too: the convoy is stopped by it.
        red = answer["convoy"].get("integration_red")
        self.red: dict[str, Any] | None = red if isinstance(red, dict) and "control" in red else None
        # A red a control found green again while its repair was open (af-6vhm6r).
        cleared = answer["convoy"].get("integration_red_cleared")
        self.red_cleared: dict[str, Any] | None = cleared if isinstance(cleared, dict) and "repair" in cleared else None
        # The red controls the convoy carries a record of, under the name a
        # repair cites: the patch door refuses any other (T40).
        recorded = answer["convoy"].get("red_checks")
        self.red_checks: list[dict[str, Any]] = [c for c in recorded if isinstance(c, dict)] \
            if isinstance(recorded, list) else []
        # An unreadable record is an anomaly as well.
        outcome = answer["convoy"].get("outcome_evaluation")
        self.outcome: dict[str, Any] | None = outcome if isinstance(outcome, dict) and "rounds" in outcome else None
        # The rounds of the end are stopped (T26): no repair of the end is
        # published any more. An unreadable record is an anomaly below.
        stop = answer["convoy"].get("end_stop")
        self.end_stop: dict[str, Any] | None = stop if isinstance(stop, dict) and "reason" in stop else None
        review = answer["convoy"].get("end_review")
        self.end_review_open = bool(isinstance(review, dict) and review.get("request"))
        # The Delivered Outcome and what its acceptance holds so far (T28).
        delivered = answer["convoy"].get("delivered")
        self.delivered: dict[str, Any] | None = delivered if isinstance(delivered, dict) and "commit" in delivered else None
        acceptance = answer["convoy"].get("acceptance")
        self.acceptance: dict[str, Any] | None = (
            acceptance if isinstance(acceptance, dict) and "commit" in acceptance else None)
        # Benjamin's verdicts and answers, with the route of each Owner Finding (T29).
        judgement = answer["convoy"].get("judgement")
        self.judgement: dict[str, Any] | None = (
            judgement if isinstance(judgement, dict) and "answers" in judgement else None)
        pack = answer["convoy"].get("evidence_pack")
        self.pack: dict[str, Any] | None = pack if isinstance(pack, dict) and "path" in pack else None
        # The convoy closed by command, on Benjamin's words (T30): nothing
        # of it is advanced any more.
        closed = answer["convoy"].get("closed")
        self.closed: dict[str, Any] | None = closed if isinstance(closed, dict) and "how" in closed else None
        grouped = answer["convoy"].get("grouped_request")
        self.grouped: dict[str, Any] | None = grouped if isinstance(grouped, dict) and "bead" in grouped else None
        self.unruled: list[dict[str, Any]] = [
            *answer["convoy"].get("unruled", []),
            *({"ticket": ticket["id"], **anomaly} for ticket in self.tickets for anomaly in ticket.get("unruled", [])),
        ]

    def ticket(self, ticket_id: str) -> dict[str, Any]:
        for ticket in self.tickets:
            if ticket["id"] == ticket_id:
                return ticket
        raise Refusal(f"le ticket {ticket_id} n'appartient pas au convoi {self.id}")

    def awaiting_a_session(self) -> list[str]:
        """Tickets started through the door, or sent to a resume or to a
        correction round, that no session has picked yet."""
        return [t["id"] for t in self.tickets
                if (started(t) and t.get("status") == "open" and not t.get("exit")) or resume_on_its_way(t)
                or round_on_its_way(t)]

    def rounds_waiting(self) -> int:
        """Correction rounds counted and sent to no session yet: each waits
        for a free author place, after the counted resumes and before any
        start (af-sdd8gr)."""
        return sum(1 for t in self.tickets if not t.get("park") and round_waiting(t))

    def not_started(self) -> list[dict[str, Any]]:
        return [t for t in self.tickets if t.get("status") == "open" and not t.get("gates") and not t.get("exit")]

    def code_reviews_due(self) -> list[str]:
        """Tickets whose author has finished and that are not merged yet,
        or that their code review stopped without the stop having reached
        the operator: what makes a settlement of the code reviews worth
        running."""
        due = []
        for t in self.tickets:
            stop = t.get("stop") or {}
            if stop:
                if stop.get("reason") == CODE_REVIEW_STOP and "raised" not in stop:
                    due.append(t["id"])
            elif not t.get("park") and t["id"] in self.finished_unmerged():
                due.append(t["id"])
        return due

    def evaluations_due(self) -> list[str]:
        """Tickets whose author has finished and that are not merged yet,
        that still have a launched product to stop, or that their
        evaluation stopped without the stop having reached the operator:
        what makes a settlement of the evaluations worth running."""
        due = []
        for t in self.tickets:
            stop = t.get("stop") or {}
            if (t.get("evaluation") or {}).get("live") or (t.get("evaluation") or {}).get("request"):
                due.append(t["id"])
            elif stop and not overridden_ticket(t):
                if stop.get("reason") in EVALUATION_STOPS and "raised" not in stop:
                    due.append(t["id"])
            # A stop whose every Blocking Finding is overridden is still
            # evaluated at its tip (af-ppdbza).
            elif not t.get("park") and t["id"] in self.finished_unmerged():
                due.append(t["id"])
        return due

    def tdd_stops_due(self, alive: set[str]) -> list[dict[str, Any]]:
        """Tickets a step of their TDD stopped without the stop having
        reached the operator."""
        return [t for t in self.tickets
                if (t.get("stop") or {}).get("reason") in TDD_STOPS and "raised" not in t["stop"]
                and (t["stop"]["reason"] != ALREADY_GREEN
                     or (already_green_due(t, alive) and not moves_a_proof(t)
                         # Resumed once instead (red_replayed), unless no resume is left.
                         and not (green_seen_once(t["stop"]) and t.get("resumes_left") != 0)))]

    def corrections_due(self) -> list[str]:
        """Tickets whose author has finished and that are not merged yet --
        their review or their evaluation may have refused them -- or that
        were stopped still refused without the stop having reached the
        operator, or that were stopped at the bound under the old rule and
        still hold the request it raised for the count alone (ADR-0035): what
        makes a settlement of the correction rounds worth running."""
        due = []
        for t in self.tickets:
            stop = t.get("stop") or {}
            if stop:
                if stop.get("reason") == CORRECTION_STOP and ("raised" not in stop or count_request_open(t)):
                    due.append(t["id"])
            elif not t.get("park") and t["id"] in self.finished_unmerged():
                due.append(t["id"])
        return due

    def fidelity_due(self) -> list[str]:
        """Finished interface tickets, not merged yet, whose fidelity to the
        Validated Prototype was not measured at the tip of their branch:
        what makes a fidelity check worth running."""
        return [
            t["id"] for t in self.tickets
            if t["id"] in self.finished_unmerged() and t.get("interface") and not t.get("park") and t.get("tip")
            and (t.get("fidelity") or {}).get("commit") != t.get("tip")
        ]

    def merged_open(self) -> list[str]:
        """Tickets merged into the integration branch and not closed yet:
        what the ticket-end gate has to settle."""
        return [
            t["id"] for t in self.tickets
            if t.get("status") != "closed" and (t.get("merge") or {}).get("outcome") == "merged"
        ]

    def end_due(self) -> bool:
        """Every ticket of the convoy is closed and its integration branch
        is not red: what makes the end-of-Spec gate worth running (T23)."""
        return bool(self.integration and self.tickets and not self.red and not self.owner_hold()
                    and all(t.get("status") == "closed" for t in self.tickets))

    def final_answer(self) -> dict[str, Any] | None:
        """Benjamin's « accepté » or « abandonné », when it is his last
        answer and no red replay voided it (T30, Spec §9 and §11)."""
        answers = (self.judgement or {}).get("answers") or []
        last = answers[-1] if answers else None
        if isinstance(last, dict) and last.get("response") in ("accepted", "abandoned") and "voided" not in last:
            return last
        return None

    def owner_findings(self) -> list[dict[str, Any]]:
        """The Owner Findings of Benjamin's last answer, when it is
        « constats rendus » (T29, Spec §11)."""
        answers = (self.judgement or {}).get("answers") or []
        return answers[-1]["findings"] if answers and answers[-1].get("response") == "findings" else []

    def later_without_proposal(self) -> bool:
        """A « plus tard » Benjamin gave -- a verdict on a proposition, an
        Owner Finding of his last answer -- has no proposition yet."""
        answers = (self.judgement or {}).get("answers") or []
        return any(v.get("verdict") == "plus_tard" and "proposal" not in v
                   for v in (self.judgement or {}).get("verdicts") or []) \
            or any(f.get("route") == "later" and "proposal" not in f
                   for f in (answers[-1].get("findings") or [] if answers else []))

    def owner_hold(self) -> str | None:
        """What Benjamin's last « constats rendus » holds the end of the
        Spec for: a returned finding whose `repair` is not published yet,
        or the Planning Exception of the batch while it is open."""
        answers = (self.judgement or {}).get("answers") or []
        tracked = {t["id"] for t in self.tickets}
        if any(f["route"] == "repair" and f.get("ticket") not in tracked for f in self.owner_findings()):
            return "un constat rendu par Benjamin attend son repair"
        if answers and "exception" in answers[-1] and "resolved" not in answers[-1]["exception"]:
            return ("la Planning Exception du lot de constats rendus par Benjamin est ouverte : la Spec et son graphe "
                    "sont à reprendre par un Planning Run, puis bin/owner-answer resolve-exception")
        return None

    def outcome_due(self) -> bool:
        """The end-of-Spec gate is due, or the Outcome Evaluation has
        something left to settle whatever the tickets: an open request, a
        launched product to stop, a stop that did not reach the operator
        (T24), a stop a Factory maintenance is linked to (af-ip0nrq)."""
        outcome = self.outcome or {}
        stop = outcome.get("stop") or {}
        return bool(self.end_due() or outcome.get("request") or outcome.get("live")
                    or (stop and ("raised" not in stop or stop.get("repairs"))))

    def red_check(self, source: str, ticket: str | None = None) -> str | None:
        """The name of the red control the convoy records from `source`."""
        return next((check["name"] for check in self.red_checks
                     if check.get("source") == source and check.get("ticket") == ticket), None)

    def outcome_repairs_due(self) -> list[dict[str, Any]]:
        """What the Evaluator of the end drafted and code has not published
        yet (T24): the repair of each user story the last Outcome Evaluation
        did not observe, and the one of each finding « hors ticket » it
        classified « repaired ». Nothing while an evaluation is open: a
        classification may still change, and a ticket more would outdate it.
        Nothing once the rounds of the end are stopped (T26). A draft the
        patch door refused is never due again."""
        outcome = self.outcome
        if outcome is None or outcome.get("request") or self.end_stop:
            return []
        last = outcome["rounds"][-1] if outcome["rounds"] else {"repairs": []}
        due = [{"story": entry["story"], "draft": entry["draft"]} for entry in last["repairs"]
               if not entry.get("repair") and "repair_refused" not in entry]
        due += [{"finding": finding["id"], "ticket": finding["ticket"], "item": finding["item"], "draft": finding["draft"]}
                for t in self.tickets for finding in t.get("findings") or []
                if finding.get("state") == FINDING_TO_REPAIR and not finding.get("repair")
                and "repair_refused" not in finding]
        return due

    def outcome_repairs_refused(self) -> list[str]:
        """What the Evaluator of the end drafted and the patch door refused,
        each with the reason, while it still stands: on a user story of the
        last round, or on a finding « hors ticket » still to repair."""
        outcome = self.outcome
        if outcome is None or not outcome["rounds"]:
            return []
        refused = [f"user story {entry['story']} : {entry['repair_refused']}"
                   for entry in outcome["rounds"][-1]["repairs"] if "repair_refused" in entry]
        refused += [f"constat hors ticket {finding['id']} : {finding['repair_refused']}"
                    for t in self.tickets for finding in t.get("findings") or []
                    if finding.get("state") == FINDING_TO_REPAIR and "repair_refused" in finding]
        return refused

    def item_repairs_due(self) -> list[tuple[dict[str, Any], list[dict[str, Any]]]]:
        """The tickets whose tracked elements the operator asked to have
        repaired, and for which code has published no repair yet (T23)."""
        due = []
        for t in self.tickets:
            items = [item for item in t.get("tracked_items") or []
                     if (item.get("request") or {}).get("state") == "resolved"
                     and not item["request"].get("accepted") and not item.get("repair")]
            if items:
                due.append((t, items))
        return due

    def finished_unmerged(self) -> list[str]:
        """Tickets whose author has finished and that are not merged yet:
        what makes a merge pass worth running."""
        return [
            t["id"] for t in self.tickets
            if t.get("status") != "closed" and (t.get("exit") or {}).get("exit") == "finished"
            and (t.get("merge") or {}).get("outcome") != "merged"
        ]


def started(ticket: dict[str, Any]) -> bool:
    gates = ticket.get("gates") or {}
    return "dispatch" in gates and not any(gate in gates for gate in CLOSING_GATES)


def open_blockers(ticket_id: str) -> list[str]:
    return [
        dep.get("id") for dep in read_bead(ticket_id).get("dependencies") or []
        if isinstance(dep, dict) and dep.get("dependency_type") == "blocks" and dep.get("status") != "closed"
    ]


def live_sessions() -> list[dict[str, Any]]:
    """The sessions that are not over, every convoy and Spec together."""
    answer = gc_json("session", "list", "--json")
    sessions = answer.get("sessions") if isinstance(answer, dict) else None
    if not isinstance(sessions, list):
        raise Refusal("gc session list n'a pas rendu de liste de sessions : le plafond ne peut pas être compté")
    return [entry for entry in sessions
            if isinstance(entry, dict) and not entry.get("closed") and entry.get("state") != "closed"]


def session_names(sessions: list[dict[str, Any]]) -> set[str]:
    """Every name a live session answers to (as bin/ticket-exit reads them)."""
    return {str(entry[key]) for entry in sessions for key in ("id", "name", "session_name", "alias") if entry.get(key)}


def role_sessions(sessions: list[dict[str, Any]]) -> dict[str, int]:
    """Live sessions per delivery role, every convoy and Spec together."""
    try:
        roles = json.loads(ROLES.read_text(encoding="utf-8"))["roles"]
        agents = {role: entry["agent"] for role, entry in roles.items()}
    except (OSError, json.JSONDecodeError, KeyError, TypeError, AttributeError) as exc:
        raise Refusal(f"config/delivery-roles.json illisible : {exc!r}") from exc
    counts = dict.fromkeys(agents, 0)
    for entry in sessions:
        template = str(entry.get("template", "")).rsplit("/", 1)[-1]
        for role, agent in agents.items():
            if template == agent:
                counts[role] += 1
    return counts


# --- settings ----------------------------------------------------------------


def load_settings() -> dict[str, Any]:
    try:
        data = json.loads(SETTINGS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise Refusal(f"config/delivery-flow.json illisible : {exc}") from exc
    ceiling = data.get("max_sessions") if isinstance(data, dict) else None
    if isinstance(ceiling, bool) or not isinstance(ceiling, int) or ceiling < 1:
        raise Refusal(f"max_sessions (plafond N) absent ou invalide dans config/delivery-flow.json : {ceiling!r} "
                      "(attendu : un entier d'au moins 1)")
    start = data.get("start") if isinstance(data.get("start"), dict) else {}
    formula, role = start.get("formula"), start.get("role")
    if not isinstance(formula, str) or not formula:
        raise Refusal("aucune formule de démarrage (start.formula) dans config/delivery-flow.json : "
                      "aucun ticket d'un convoi marqué n'est démarré tant qu'elle n'est pas réglée")
    if role is not None and (not isinstance(role, str) or not role):
        raise Refusal(f"start.role invalide dans config/delivery-flow.json : {role!r}")
    # What the door receives to send a resumed ticket to a fresh author
    # session (T20). Absent: nothing is resumed, and a ticket to resume is
    # refused by the pass, by name.
    resume = data.get("resume")
    if resume is not None:
        if not isinstance(resume, dict) or not isinstance(resume.get("formula"), str) or not resume["formula"] \
                or not (resume.get("role") is None or (isinstance(resume["role"], str) and resume["role"])):
            raise Refusal(f"resume invalide dans config/delivery-flow.json : {resume!r} (attendu : formula, role)")
        resume = {"formula": resume["formula"], "role": resume.get("role")}
    return {"ceiling": ceiling, "formula": formula, "role": role, "resume": resume,
            "open_exceptions": flow_bound(data, BOUND_EXCEPTIONS)}


def flow_bound(settings: dict[str, Any], name: str) -> int:
    """One bound of the flow (Spec §8), read where they are all set:
    `bounds` of config/delivery-flow.json, and in the Factory's own file when
    the settings of FACTORY_ROOT set none."""
    bounds = settings.get("bounds")
    if "bounds" not in settings:
        try:
            bounds = json.loads(OWN_SETTINGS.read_text(encoding="utf-8")).get("bounds")
        except (OSError, json.JSONDecodeError, AttributeError) as exc:
            raise Refusal(f"config/delivery-flow.json illisible : {exc}") from exc
    value = bounds.get(name) if isinstance(bounds, dict) else None
    if isinstance(value, bool) or not isinstance(value, int) or value < 1:
        raise Refusal(f"bounds.{name} absent ou invalide dans config/delivery-flow.json : {value!r} "
                      "(attendu : un entier d'au moins 1)")
    return value


# --- the factory incident of a stopped convoy ---------------------------------


def passed(proc: subprocess.CompletedProcess[str], what: str) -> None:
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise Refusal(f"{what} a échoué : {detail[-300:]}")


def one_line(text: str, limit: int = REQUEST_LINE_MAX) -> str:
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def anomalies_signature(anomalies: list[dict[str, Any]]) -> str:
    rows = sorted([str(a.get("ticket", "")), str(a.get("field", "")), str(a.get("reason", ""))] for a in anomalies)
    return "sha256:" + hashlib.sha256(json.dumps(rows, ensure_ascii=False).encode("utf-8")).hexdigest()


def operator_language() -> str:
    proc = run([str(OPERATOR_CONFIG_BIN), "language"])
    passed(proc, "operator-config language")
    return proc.stdout.strip()


def incident_request(convoy: Convoy) -> dict[str, Any]:
    """What the operator reads on the escalation door's list: the ticket and the reason."""
    first, others = convoy.unruled[0], len(convoy.unruled) - 1
    where = first.get("ticket") or f"convoi {convoy.id}"
    more = f" (+{others} autre{'s' if others > 1 else ''})" if others else ""
    return {
        "quoi": one_line(f"Incident d'usine : {where} — {first.get('reason', UNRULED)}", REQUEST_LINE_MAX - len(more)) + more,
        "pourquoi": one_line(f"Le convoi {convoy.id} ne démarre plus aucun ticket tant que cet état sans règle n'est pas réparé"),
        "que_faire": [
            {"option": "Faire réparer l'état par la maintenance de l'usine",
             "consequence": "Le convoi reprend seul dès que l'état est valide ; aucun ticket n'est avancé ni fermé à la main.",
             "recommande": True, "raison": "Le convoi reste arrêté tant que l'état n'est pas réparé."},
            {"option": "Laisser le convoi arrêté",
             "consequence": "Aucun ticket de ce convoi ne démarre ; l'incident reste dans cette liste."},
        ],
        "langue": operator_language(),
        "bloquant": True,
    }


def incident_description(convoy: Convoy) -> str:
    lines = [f"- {a.get('ticket') or 'convoi ' + convoy.id} : {a.get('reason', UNRULED)}" for a in convoy.unruled]
    return "\n".join([
        f"Le script d'avancement (bin/convoy-advance) a rencontré un {UNRULED} dans le convoi {convoy.id} : "
        "il ne démarre plus aucun ticket de ce convoi.",
        "", "Anomalies relevées :", *lines, "",
        f"Réparation : maintenance de l'usine, jusqu'à ce que l'état soit de nouveau valide (bin/convoy-state show {convoy.id}). "
        "Elle ne consiste jamais à avancer ou fermer à la main les tickets du convoi (Spec af-wf4w5r §0 règle 5).",
        "Dès que l'état est valide, bin/convoy-advance reprend seul le convoi, retire cet incident de la liste "
        "de la porte d'escalade et ferme ce bead.",
    ])


def record_incident(convoy: Convoy, bead_id: str, signature: str | None = None) -> None:
    argv = [str(STATE_BIN), "record-incident", convoy.id, "--bead", bead_id]
    passed(run(argv + (["--signature", signature] if signature else [])), "convoy-state record-incident")


def raise_incident(convoy: Convoy) -> dict[str, Any]:
    """One incident per set of anomalies, whatever the number of passes."""
    signature = anomalies_signature(convoy.unruled)
    if convoy.incident and convoy.incident.get("signature") == signature:
        return {"bead": convoy.incident["bead"], "raised": False}
    if convoy.incident:
        bead_id = convoy.incident["bead"]
    else:
        created = gc_json("bd", "create", f"Incident d'usine : convoi {convoy.id} arrêté ({UNRULED})",
                          "-p", "1", "-t", "task", "-d", incident_description(convoy), "--json")
        if isinstance(created, list):
            created = created[0] if created else None
        bead_id = created.get("id") if isinstance(created, dict) else None
        if not isinstance(bead_id, str) or not bead_id:
            raise Refusal("gc bd create n'a pas rendu l'identifiant du bead d'incident")
        # Recorded before the escalation: a pass that fails after this point
        # is retried on the same bead, never on a second one.
        record_incident(convoy, bead_id)
    request = json.dumps(incident_request(convoy), ensure_ascii=False)
    passed(run([str(ESCALATION_BIN), "benjamin", bead_id, request]), "escalation-door benjamin")
    record_incident(convoy, bead_id, signature)
    return {"bead": bead_id, "raised": True}


def withdraw_incident(convoy: Convoy) -> dict[str, Any]:
    """The state is valid again: the incident leaves the operator's list."""
    assert convoy.incident is not None
    bead_id = convoy.incident["bead"]
    passed(run([str(ESCALATION_BIN), "clear", bead_id]), "escalation-door clear")
    if read_bead(bead_id).get("status") != "closed":
        passed(run([GC_BIN, "--city", str(ROOT), "bd", "close", bead_id, "--reason",
                    f"État redevenu valide : bin/convoy-advance a repris le convoi {convoy.id}."]), "gc bd close")
    passed(run([str(STATE_BIN), "clear-incident", convoy.id]), "convoy-state clear-incident")
    return {"bead": bead_id, "withdrawn": True}


def settle_incident(convoy: Convoy) -> dict[str, Any] | None:
    if not convoy.unruled and not convoy.incident:
        return None
    try:
        return raise_incident(convoy) if convoy.unruled else withdraw_incident(convoy)
    except Refusal as exc:
        return {"error": f"refus : {exc}"}


# --- resumes counted and bounded, parked tickets, one grouped request (T20) -----


def state_write(*args: str) -> dict[str, Any]:
    proc = run([str(STATE_BIN), *args])
    answer = parsed(proc, f"convoy-state {args[0]}")
    if proc.returncode != 0 or not isinstance(answer, dict):
        error = answer.get("error", proc.returncode) if isinstance(answer, dict) else proc.returncode
        raise Refusal(f"convoy-state {args[0]} a échoué : {error}")
    return answer


def at_work(ticket: dict[str, Any]) -> bool:
    """Started through the door, not closed, neither parked nor stopped:
    what a resume or the bound of the resumes may bear on. A stopped ticket
    is not at work: its sequence failed, it is with the operator, and only
    its stop `evaluation_no_result` or `code_review_no_result`, or one a
    removed stage wrote, is lifted by a resume (stopped_without_result)."""
    return started(ticket) and ticket.get("status") != "closed" and not ticket.get("park") and not ticket.get("stop")


def overridden_at_work(ticket: dict[str, Any]) -> bool:
    """Started, not closed nor parked, stopped still refused and every
    Blocking Finding its review left overridden by the operator: merged like
    a ticket at work (bin/spec-integration), so resumed like one when the
    merge returns it (af-n4bn62: F and G1 of af-strhoy, red on 21/10/2026,
    were neither merged again nor resumed)."""
    return started(ticket) and ticket.get("status") != "closed" and not ticket.get("park") \
        and overridden_ticket(ticket)


def resume_on_its_way(ticket: dict[str, Any]) -> bool:
    """A resume was sent and nobody took the ticket since: its session
    holds a place under the ceiling. A resume bead closed without the ticket
    taken is a session that ended: one more interruption, no place."""
    entries = (ticket.get("resume") or {}).get("entries") or []
    if not entries or not at_work(ticket) or ticket.get("status") == "open" or ticket.get("exit"):
        return False
    last = entries[-1]
    if not last.get("launches") or last.get("session") != (ticket.get("session") or {}).get("name"):
        return False
    return read_bead(last["launches"][-1]["bead"]).get("status") != "closed"


def round_waiting(ticket: dict[str, Any]) -> bool:
    """A correction round counted on the ticket (bin/correction-round) and
    sent to no session yet."""
    correction = ticket.get("correction")
    return isinstance(correction, dict) and "unruled" not in correction and not correction.get("launches") \
        and not ticket.get("stop") and ticket.get("status") != "closed"


def round_on_its_way(ticket: dict[str, Any]) -> bool:
    """A correction round was sent and no session took the ticket since:
    its session holds a place under the ceiling, like a resume on its way
    (af-sdd8gr). A round bead closed without the ticket taken holds none."""
    correction = ticket.get("correction")
    launches = correction.get("launches") if isinstance(correction, dict) else None
    if not launches or ticket.get("status") == "closed":
        return False
    session_at = str((ticket.get("session") or {}).get("at") or "")
    if session_at >= str(launches[-1].get("at") or ""):
        return False
    return read_bead(launches[-1]["bead"]).get("status") != "closed"


def released_technical_repairs(ticket: dict[str, Any]) -> list[str]:
    """The latest lift released the ticket's current operator-request exit."""
    record = ticket.get("technical_repairs")
    exit_record = ticket.get("exit") or {}
    lifts = ticket.get("park_lifts") or []
    entries = record.get("entries") if isinstance(record, dict) else None
    if exit_record.get("exit") != "operator_request" or not isinstance(entries, list) \
            or not isinstance(lifts, list) or not lifts:
        return []
    lift = lifts[-1]
    repairs = lift.get("repairs") if isinstance(lift, dict) else None
    linked = [entry["id"] for entry in entries]
    return repairs if repairs == linked \
        and lift.get("exit_at") == record.get("exit_at") == exit_record.get("at") else []


def linked_to_current_request(ticket: dict[str, Any]) -> list[dict[str, str]]:
    """The repair links bound to the ticket's current request, parked or
    already lifted: its operator-request exit, or its evaluation stop."""
    record = ticket.get("technical_repairs")
    if not isinstance(record, dict) or not isinstance(record.get("entries"), list):
        return []
    exit_record, stop = ticket.get("exit") or {}, ticket.get("stop") or {}
    current = (exit_record.get("exit") == "operator_request" and record.get("exit_at") == exit_record.get("at")) \
        or (stop.get("reason") in EVALUATION_STOPS and record.get("stop_at") == stop.get("at"))
    return record["entries"] if current else []


def returned_for_parking(ticket: dict[str, Any]) -> bool:
    """A repair linked to the request that parks the ticket now was given
    back to its author (bin/convoy-state return-technical-repair)."""
    park, exit_record = ticket.get("park") or {}, ticket.get("exit") or {}
    return any(entry.get("parked_at") == park.get("at") and entry.get("exit_at") == exit_record.get("at")
               for entry in ticket.get("returned_repairs") or [])


def settle_returned_repairs(convoy: Convoy, out: dict[str, Any]) -> None:
    """A linked Factory repair answered « Corriger dans le convoi »
    (IN_CONVOY_OPTION) never reaches main: its code lives on the
    integration branch alone. Its link is removed and kept under
    `returned_repairs`, and the ticket's author makes that fix on its
    branch (af-t8hycw, R20 and af-8fk8nz)."""
    returned = False
    for ticket in convoy.tickets:
        if ticket.get("status") == "closed":
            continue
        repairs = [entry["id"] for entry in linked_to_current_request(ticket)
                   if repair_answered_in_convoy(read_bead(entry["id"]), entry["at"])]
        if not repairs:
            continue
        try:
            state_write("return-technical-repair", convoy.id, ticket["id"])
            out.setdefault("returned_repairs", []).append({"id": ticket["id"], "repairs": repairs})
            returned = True
        except Refusal as exc:
            out["refused"].append({"id": ticket["id"], "reason": str(exc)})
    if returned:
        convoy.load()


def awaits_repair(ticket: dict[str, Any]) -> bool:
    """A ticket whose own operator request was answered with
    « Corriger par maintenance sur main » (lib/convoy_state.py
    MAINTENANCE_OPTION): it waits for the repair the Mayor links to it."""
    park = ticket.get("park") or {}
    return park.get("origin") == ticket["id"] and park.get("cause") == "operator_request" \
        and bool((park.get("answer") or {}).get("awaits_repair"))


def delivered_technical_repairs(ticket: dict[str, Any], convoy: Convoy) -> list[str]:
    """Every linked repair, only after structural PR merge and exact-head
    CI proof. Open, failed and merely closed work keeps waiting. A repair
    merged into an integration branch (af-41i8d0, docs/DELIVERY.md) is
    delivered for the convoy of that branch only; whether its commit is in
    the tip is the take-up's question (repairs_missing_from_integration)."""
    repairs = technical_repairs(ticket)
    own = (convoy.integration or {}).get("branch")
    for repair_id in repairs:
        bead = read_bead(repair_id)
        readiness = delivery_readiness(bead)
        if not readiness["ready"] or not readiness["pr_backed"]:
            return []
        target = str((bead.get("metadata") or {}).get("merged_target") or "")
        if target.startswith("integration/") and target != own:
            return []
    return repairs


def returned_release_authorization() -> dict[str, str]:
    """The fixed live authorization; synthetic trackers may replace its SHAs."""
    raw = os.environ.get(RETURNED_RELEASE_TEST_ENV) if os.environ.get("CONVOY_STATE_FAKE_TRACKER") else None
    if raw is None:
        return RETURNED_RELEASE
    try:
        candidate = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return candidate if isinstance(candidate, dict) and set(candidate) == set(RETURNED_RELEASE) \
        and all(isinstance(value, str) and value for value in candidate.values()) else {}


