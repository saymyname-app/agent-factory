#!/usr/bin/env python3
"""Deterministic synthetic qualification prototype for provider-independent
planning roles, an initial concurrency ceiling, and decision-session
retention (P06).

Same scope discipline as `planning-allocation-prototype` (P02) and
`planning-run-resume-oracle` (P04): this is a bounded, deterministic
comparison over declared evidence, not a live multi-provider load test or a
production concurrency controller.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path
from typing import Any


PROGRAM = "role-qualification-oracle"
CONTRACT = "agent-factory-role-qualification-prototype/v1"
RESULT_CONTRACT = "agent-factory-role-qualification-result/v1"
ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MANIFEST = ROOT / "config" / "role-qualification-prototype.json"

FORBIDDEN_MODEL_TOKENS = ("astra", "fable")
ALLOWED_EFFORTS = (None, "none", "low", "medium")
LOAD_METRIC_KEYS = (
    "quality",
    "lost_decisions",
    "rework_count",
    "elapsed_seconds",
    "tokens",
    "machine_pressure",
)
MACHINE_PRESSURE_LEVELS = ("low", "medium", "high")


class PrototypeError(RuntimeError):
    pass


def require_dict(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise PrototypeError(f"{label} must be an object")
    return value


def require_list(value: Any, label: str) -> list[Any]:
    if not isinstance(value, list):
        raise PrototypeError(f"{label} must be an array")
    return value


def require_string(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise PrototypeError(f"{label} must be a non-empty string")
    return value


def require_bool(value: Any, label: str) -> bool:
    if not isinstance(value, bool):
        raise PrototypeError(f"{label} must be a boolean")
    return value


def canonical_digest(value: Any) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def load_manifest(path: Path) -> dict[str, Any]:
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise PrototypeError(f"manifest not found: {path}") from exc
    except json.JSONDecodeError as exc:
        raise PrototypeError(f"manifest is not valid JSON: {exc}") from exc
    return require_dict(raw, "manifest")


def validate_role(role: dict[str, Any]) -> dict[str, Any]:
    require_dict(role, "role")
    require_string(role.get("id"), "role.id")
    require_string(role.get("provider"), "role.provider")
    model = role.get("model")
    if model is not None and not isinstance(model, str):
        raise PrototypeError(f"role {role.get('id')}: model must be a string or null")
    if model:
        lowered = model.lower()
        for token in FORBIDDEN_MODEL_TOKENS:
            if token in lowered:
                raise PrototypeError(
                    f"role {role['id']}: model '{model}' violates the no-{token} contract"
                )
    effort = role.get("effort")
    if effort not in ALLOWED_EFFORTS:
        raise PrototypeError(
            f"role {role['id']}: effort '{effort}' exceeds the medium-or-lower ceiling"
        )
    return role


def validate_load_evidence(entry: dict[str, Any], role_ids: set[str]) -> dict[str, Any]:
    require_dict(entry, "load_evidence entry")
    role_id = require_string(entry.get("role_id"), "load_evidence.role_id")
    if role_id not in role_ids:
        raise PrototypeError(f"load_evidence references undeclared role '{role_id}'")
    for key in LOAD_METRIC_KEYS:
        if key not in entry:
            raise PrototypeError(
                f"load_evidence for '{role_id}' is missing required metric '{key}'"
            )
    quality = entry["quality"]
    if not isinstance(quality, (int, float)) or not (0.0 <= quality <= 1.0):
        raise PrototypeError(f"load_evidence for '{role_id}': quality must be in [0, 1]")
    for key in ("lost_decisions", "rework_count", "tokens"):
        val = entry[key]
        if not isinstance(val, int) or isinstance(val, bool) or val < 0:
            raise PrototypeError(f"load_evidence for '{role_id}': {key} must be a non-negative int")
    elapsed = entry["elapsed_seconds"]
    if not isinstance(elapsed, (int, float)) or isinstance(elapsed, bool) or elapsed <= 0:
        raise PrototypeError(f"load_evidence for '{role_id}': elapsed_seconds must be > 0")
    if entry["machine_pressure"] not in MACHINE_PRESSURE_LEVELS:
        raise PrototypeError(
            f"load_evidence for '{role_id}': machine_pressure must be one of {MACHINE_PRESSURE_LEVELS}"
        )
    return entry


def validate_work_class(work_class: dict[str, Any]) -> dict[str, Any]:
    require_dict(work_class, "work_class")
    class_id = require_string(work_class.get("id"), "work_class.id")

    roles_raw = require_list(work_class.get("roles"), f"work_class[{class_id}].roles")
    if not roles_raw:
        raise PrototypeError(f"work_class[{class_id}].roles must not be empty")
    roles = {r["id"]: validate_role(r) for r in (validate_role(r) for r in roles_raw)}
    if len(roles) != len(roles_raw):
        raise PrototypeError(f"work_class[{class_id}].roles must have unique ids")

    providers = {role["provider"] for role in roles.values()}
    if len(providers) != len(roles):
        raise PrototypeError(
            f"work_class[{class_id}]: each declared role must exercise a distinct provider"
        )

    evidence_raw = require_list(
        work_class.get("load_evidence"), f"work_class[{class_id}].load_evidence"
    )
    evidence = {
        e["role_id"]: validate_load_evidence(e, set(roles))
        for e in (validate_load_evidence(e, set(roles)) for e in evidence_raw)
    }
    if set(evidence) != set(roles):
        raise PrototypeError(
            f"work_class[{class_id}]: load_evidence must report exactly one entry per declared role"
        )

    return {"id": class_id, "roles": roles, "providers": providers, "evidence": evidence}


def validate_concurrency(concurrency: dict[str, Any]) -> dict[str, Any]:
    require_dict(concurrency, "manifest.concurrency")
    initial = concurrency.get("initial_ceiling")
    minimum = concurrency.get("minimum_ceiling")
    if not isinstance(initial, int) or isinstance(initial, bool) or initial < 1:
        raise PrototypeError("concurrency.initial_ceiling must be a positive int")
    if not isinstance(minimum, int) or isinstance(minimum, bool) or minimum < 1:
        raise PrototypeError("concurrency.minimum_ceiling must be a positive int")
    if initial < 2 * minimum:
        raise PrototypeError(
            "concurrency.initial_ceiling must be deliberately high: "
            "at least twice minimum_ceiling"
        )
    require_bool(concurrency.get("observed_host_pressure"), "concurrency.observed_host_pressure")
    require_bool(
        concurrency.get("observed_completion_quality_ok"),
        "concurrency.observed_completion_quality_ok",
    )
    return concurrency


def validate_retention_candidates(candidates_raw: list[Any]) -> dict[str, dict[str, Any]]:
    require_list(candidates_raw, "manifest.retention_candidates")
    if not candidates_raw:
        raise PrototypeError("manifest.retention_candidates must not be empty")
    candidates: dict[str, dict[str, Any]] = {}
    for c in candidates_raw:
        require_dict(c, "retention candidate")
        cid = require_string(c.get("id"), "retention_candidate.id")
        turns = c.get("retained_turns")
        if not isinstance(turns, int) or isinstance(turns, bool) or turns < 0:
            raise PrototypeError(f"retention_candidate[{cid}].retained_turns must be a non-negative int")
        require_bool(
            c.get("planning_graph_evidence_sufficient"),
            f"retention_candidate[{cid}].planning_graph_evidence_sufficient",
        )
        require_bool(
            c.get("diagnostic_need_evidenced"),
            f"retention_candidate[{cid}].diagnostic_need_evidenced",
        )
        candidates[cid] = c
    if "zero" not in candidates or candidates["zero"]["retained_turns"] != 0:
        raise PrototypeError("manifest.retention_candidates must include a 'zero' candidate with retained_turns=0")
    return candidates


def validate_manifest(manifest: dict[str, Any]) -> dict[str, Any]:
    contract = require_string(manifest.get("contract"), "manifest.contract")
    if contract != CONTRACT:
        raise PrototypeError(f"unsupported manifest contract: {contract}")

    acceptance_standard = require_dict(manifest.get("acceptance_standard"), "manifest.acceptance_standard")
    min_quality = acceptance_standard.get("min_quality")
    if not isinstance(min_quality, (int, float)) or not (0.0 <= min_quality <= 1.0):
        raise PrototypeError("acceptance_standard.min_quality must be in [0, 1]")
    max_lost_decisions = acceptance_standard.get("max_lost_decisions")
    if not isinstance(max_lost_decisions, int) or isinstance(max_lost_decisions, bool) or max_lost_decisions < 0:
        raise PrototypeError("acceptance_standard.max_lost_decisions must be a non-negative int")

    work_classes_raw = require_list(manifest.get("work_classes"), "manifest.work_classes")
    if not work_classes_raw:
        raise PrototypeError("manifest.work_classes must not be empty")
    work_classes: dict[str, Any] = {}
    for wc_raw in work_classes_raw:
        validated_wc = validate_work_class(wc_raw)
        work_classes[validated_wc["id"]] = validated_wc
    if len(work_classes) != len(work_classes_raw):
        raise PrototypeError("manifest.work_classes must have unique ids")

    provider_sets = {wc["id"]: wc["providers"] for wc in work_classes.values()}
    reference_providers = next(iter(provider_sets.values()))
    for class_id, providers in provider_sets.items():
        if providers != reference_providers:
            raise PrototypeError(
                "every work_class must exercise the same provider set; "
                f"'{class_id}' declares {sorted(providers)} against {sorted(reference_providers)}"
            )

    concurrency = validate_concurrency(manifest.get("concurrency"))
    retention_candidates = validate_retention_candidates(manifest.get("retention_candidates", []))

    return {
        "acceptance_standard": {"min_quality": min_quality, "max_lost_decisions": max_lost_decisions},
        "work_classes": work_classes,
        "providers": reference_providers,
        "concurrency": concurrency,
        "retention_candidates": retention_candidates,
    }


def select_retention(candidates: dict[str, dict[str, Any]]) -> dict[str, Any]:
    zero = candidates["zero"]
    if zero["planning_graph_evidence_sufficient"]:
        return {
            "chosen_id": "zero",
            "chosen_retained_turns": 0,
            "reason": "Planning Graph evidence is sufficient; zero decision-session retention is preferred.",
        }
    evidenced = [
        c for cid, c in candidates.items()
        if cid != "zero" and c["diagnostic_need_evidenced"] and c["retained_turns"] > 0
    ]
    if not evidenced:
        raise PrototypeError(
            "Planning Graph evidence is insufficient and no retention candidate has an "
            "evidenced diagnostic need; retention must not be assumed"
        )
    shortest = min(evidenced, key=lambda c: c["retained_turns"])
    return {
        "chosen_id": shortest["id"],
        "chosen_retained_turns": shortest["retained_turns"],
        "reason": (
            "Planning Graph evidence was insufficient; the shortest evidenced diagnostic "
            f"retention ({shortest['retained_turns']} turns) was selected."
        ),
    }


def run_prototype(manifest: dict[str, Any]) -> dict[str, Any]:
    validated = validate_manifest(manifest)
    min_quality = validated["acceptance_standard"]["min_quality"]
    max_lost_decisions = validated["acceptance_standard"]["max_lost_decisions"]

    work_class_report: dict[str, Any] = {}
    provider_pass: dict[str, list[bool]] = {p: [] for p in validated["providers"]}
    role_model_ceiling_ok = True

    for class_id, wc in validated["work_classes"].items():
        by_provider: dict[str, Any] = {}
        for role_id, role in wc["roles"].items():
            evidence = wc["evidence"][role_id]
            meets_standard = (
                evidence["quality"] >= min_quality
                and evidence["lost_decisions"] <= max_lost_decisions
            )
            provider_pass[role["provider"]].append(meets_standard)
            model = role.get("model")
            if role.get("effort") not in ALLOWED_EFFORTS or (
                model and any(t in model.lower() for t in FORBIDDEN_MODEL_TOKENS)
            ):
                role_model_ceiling_ok = False
            by_provider[role["provider"]] = {
                "role_id": role_id,
                "quality": evidence["quality"],
                "lost_decisions": evidence["lost_decisions"],
                "rework_count": evidence["rework_count"],
                "elapsed_seconds": evidence["elapsed_seconds"],
                "tokens": evidence["tokens"],
                "machine_pressure": evidence["machine_pressure"],
                "meets_standard": meets_standard,
            }
        work_class_report[class_id] = by_provider

    providers_meeting_standard = {
        provider: all(results) and len(results) > 0
        for provider, results in provider_pass.items()
    }

    concurrency = validated["concurrency"]
    reduction_justified = (
        concurrency["observed_host_pressure"] or not concurrency["observed_completion_quality_ok"]
    )
    chosen_ceiling = concurrency["minimum_ceiling"] if reduction_justified else concurrency["initial_ceiling"]

    retention = select_retention(validated["retention_candidates"])

    acceptance = {
        "load_evidence_reported_separately_by_work_class": {
            "value": all(
                set(entry) == {
                    "role_id", "quality", "lost_decisions", "rework_count",
                    "elapsed_seconds", "tokens", "machine_pressure", "meets_standard",
                }
                for by_provider in work_class_report.values()
                for entry in by_provider.values()
            ),
            "reason": "quality, lost decisions, rework, elapsed time, tokens and machine "
                      "pressure are recorded per provider within each work class.",
        },
        "role_mapping_meets_standard_across_providers": {
            "value": all(providers_meeting_standard.values()) and len(providers_meeting_standard) > 1,
            "reason": f"providers_meeting_standard={providers_meeting_standard}",
        },
        "concurrency_ceiling_reduced_only_when_justified": {
            "value": (chosen_ceiling == concurrency["initial_ceiling"]) != reduction_justified,
            "reason": (
                f"reduction_justified={reduction_justified}, chosen_ceiling={chosen_ceiling}, "
                f"initial_ceiling={concurrency['initial_ceiling']}"
            ),
        },
        "retention_prefers_zero_or_shortest_evidenced": {
            "value": retention["chosen_id"] is not None,
            "reason": retention["reason"],
        },
        "role_model_ceiling_respected": {
            "value": role_model_ceiling_ok,
            "reason": "every exercised role avoids Astra/Fable and stays at medium-or-lower effort.",
        },
    }

    result = {
        "contract": RESULT_CONTRACT,
        "providers": sorted(validated["providers"]),
        "work_classes": work_class_report,
        "providers_meeting_standard": providers_meeting_standard,
        "concurrency": {
            "initial_ceiling": concurrency["initial_ceiling"],
            "minimum_ceiling": concurrency["minimum_ceiling"],
            "observed_host_pressure": concurrency["observed_host_pressure"],
            "observed_completion_quality_ok": concurrency["observed_completion_quality_ok"],
            "reduction_justified": reduction_justified,
            "chosen_ceiling": chosen_ceiling,
        },
        "retention": retention,
        "role_model_ceiling_ok": role_model_ceiling_ok,
        "acceptance": acceptance,
        "acceptance_met": all(item["value"] for item in acceptance.values()),
    }
    result["result_digest"] = canonical_digest(result)
    return result


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog=PROGRAM)
    parser.add_argument(
        "--manifest",
        type=Path,
        default=DEFAULT_MANIFEST,
        help="path to the role-qualification-prototype manifest",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("validate", help="validate the manifest and exit")
    subparsers.add_parser("run", help="run the prototype and print the deterministic result")

    args = parser.parse_args(argv)

    try:
        manifest = load_manifest(args.manifest)
        if args.command == "validate":
            validate_manifest(manifest)
            print("OK")
            return 0
        if args.command == "run":
            result = run_prototype(manifest)
            print(json.dumps(result, indent=2, sort_keys=True))
            return 0 if result["acceptance_met"] else 1
    except PrototypeError as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return 1

    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
