#!/usr/bin/env bash
# factory-maintain — safe named scripts for the Mayor's routine upkeep
# gestures (the standing ADMIN allowlist, ADR-0016 §7 / AGENTS.md "Standing
# ADMIN allowlist"): restarting a dispatcher/preview service, pruning merged
# branches, cleaning worktrees, rotating logs, reloading city config.
#
# Before this script, the Mayor did each gesture by hand from a free-text
# permission in AGENTS.md/its prompt, with no shared refusal criteria and no
# record of what it changed. Each gesture below (O12):
#   - checks its own safety criteria and refuses instead of guessing when
#     they aren't met (never deletes a branch/worktree with unmerged or
#     unpushed work, never restarts/reloads a target it can't verify)
#   - is undoable (branches/worktrees are only ever removed once fully
#     merged and pushed upstream, so the same content is recoverable from
#     the remote; log rotation archives instead of deleting)
#   - appends one line per action to var/factory-maintain.log, readable by
#     the operator, naming what it did and how to undo it
#
# Usage: factory-maintain <gesture> [args...]
set -uo pipefail

ROOT="${FACTORY_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)}"
LOG_FILE="${FACTORY_MAINTAIN_LOG:-$ROOT/var/factory-maintain.log}"
# Overridable so a test city (which has no bin/ of its own) can point this
# at the real repo's escalation-door instead of $FACTORY_ROOT's.
ESCALATION_DOOR_BIN="${ESCALATION_DOOR_BIN:-$ROOT/bin/escalation-door}"

usage() {
  cat >&2 <<'EOF'
usage: factory-maintain <gesture> [args...]

gestures:
  prune-merged-branches [--repo <path>] [--dry-run]
      Delete local branches that are merged into origin's default branch
      and have no unpushed commits. Refuses anything unmerged, unpushed,
      the current branch, or a rig's protected branch.

  clean-worktrees [--worktree-root <path>] [--idle-days N] [--dry-run]
      Remove do-work worktrees that are clean (no uncommitted changes) and
      fully pushed, and whose branch is either merged into the default
      branch or has gone untouched for more than --idle-days (default 7).
      An exact merged-PR head match also proves recoverability after GitHub
      deletes a squash-merged branch; absent or mismatched proof fails closed.
      Refuses anything with uncommitted changes. A worktree with commits
      that were never pushed, or ahead of its pushed upstream, is reported
      through the escalation door instead of removed (unrecoverable).

  rotate-logs [--dir <path>] [--max-bytes N] [--keep N]
      Gzip-archive and truncate *.log files over --max-bytes (default 10MiB)
      in --dir (default var/), keeping the --keep (default 5) newest
      archives per file. Never deletes a log outright.

  reload-city-config [--city <path>]
      Wrap `gc reload` so a config reload is logged like every other gesture.

  restart-service <name> [--city <path>]
      Wrap `gc service restart <name>`. Refuses a name `gc service list`
      does not know about.
EOF
  exit 2
}

log() {
  # log <gesture> <status> <detail>
  local gesture="$1" status="$2" detail="$3"
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s\tgesture=%s\tstatus=%s\t%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$gesture" "$status" "$detail" >> "$LOG_FILE"
}

# protected_branches_for <repo> — space-separated list of branches
# lib/protected_rigs.sh marks protected for any rig, so a prune/clean never
# touches one of them regardless of merge status.
protected_branches_for() {
  local repo="$1"
  [ -f "$repo/lib/protected_rigs.sh" ] || return 0
  # shellcheck source=/dev/null
  ( . "$repo/lib/protected_rigs.sh"
    local entry rig_dir _repo branch _ci
    for entry in "${PROTECTED_RIGS[@]:-}"; do
      [ -n "$entry" ] || continue
      IFS='|' read -r rig_dir _repo branch _ci <<<"$entry"
      [ -n "$branch" ] && printf '%s\n' "$branch"
    done
  )
}

# default_base_branch <repo> — origin's default branch, falling back to main.
default_base_branch() {
  local repo="$1" ref
  ref=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo "")
  if [ -n "$ref" ]; then
    printf '%s\n' "${ref#origin/}"
  else
    printf '%s\n' "main"
  fi
}

# merged_pr_for_exact_head <repo> <branch> <sha> — print one merged PR number
# only when GitHub retains exact proof for the local head. This recovers the
# safe cleanup case where GitHub deleted a squash-merged PR branch: neither an
# upstream ref nor Git ancestry can prove that the local commit was published.
merged_pr_for_exact_head() {
  local repo="$1" branch="$2" sha="$3" pulls
  command -v gh >/dev/null 2>&1 || return 1
  pulls=$(
    cd "$repo" || exit 1
    timeout 20 gh pr list --state merged --head "$branch" \
      --json number,headRefName,headRefOid,mergedAt --limit 100 2>/dev/null
  ) || return 1
  printf '%s' "$pulls" | python3 -c '
import json
import sys

branch, sha = sys.argv[1:]
try:
    pulls = json.load(sys.stdin)
except Exception:
    raise SystemExit(1)
if not isinstance(pulls, list):
    raise SystemExit(1)
for pull in pulls:
    if not isinstance(pull, dict):
        continue
    if (pull.get("headRefName") == branch
            and pull.get("headRefOid") == sha
            and pull.get("mergedAt")
            and isinstance(pull.get("number"), int)):
        print(pull["number"])
        raise SystemExit(0)
raise SystemExit(1)
' "$branch" "$sha"
}

cmd_prune_merged_branches() {
  local repo="$ROOT" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      *) echo "factory-maintain prune-merged-branches: unknown arg $1" >&2; return 2 ;;
    esac
  done
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "factory-maintain: $repo is not a git repo" >&2; return 1;
  }

  local current base protected
  current=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  git -C "$repo" fetch --prune origin >/dev/null 2>&1 || true
  base=$(default_base_branch "$repo")
  protected=$'\n'"$(protected_branches_for "$repo")"$'\n'

  local branch deleted=0 skipped=0
  while IFS= read -r branch; do
    [ -n "$branch" ] || continue
    if [ "$branch" = "$current" ]; then skipped=$((skipped+1)); continue; fi
    case "$protected" in *$'\n'"$branch"$'\n'*) skipped=$((skipped+1)); continue ;; esac

    local upstream ahead
    upstream=$(git -C "$repo" for-each-ref --format='%(upstream)' "refs/heads/$branch")
    if [ -z "$upstream" ]; then
      # no configured tracking branch -- fall back to a same-named remote
      # branch so a plain `git push origin <branch>` (no `-u`) still counts
      if git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        upstream="refs/remotes/origin/$branch"
      else
        skipped=$((skipped+1)); continue   # never pushed
      fi
    fi
    ahead=$(git -C "$repo" rev-list --count "$upstream..refs/heads/$branch" 2>/dev/null || echo 1)
    if [ "$ahead" != "0" ]; then skipped=$((skipped+1)); continue; fi  # unpushed commits

    if ! git -C "$repo" merge-base --is-ancestor "refs/heads/$branch" "refs/remotes/origin/$base" 2>/dev/null; then
      skipped=$((skipped+1)); continue                                 # not merged
    fi

    local sha
    sha=$(git -C "$repo" rev-parse "refs/heads/$branch")
    if [ "$dry_run" = "1" ]; then
      echo "would delete: $branch ($sha)"
    else
      if git -C "$repo" branch -D "$branch" >/dev/null 2>&1; then
        deleted=$((deleted+1))
        log prune-merged-branches deleted \
          "branch=$branch sha=$sha undo='git -C $repo branch $branch $sha'"
      fi
    fi
  done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads/)

  log prune-merged-branches summary "deleted=$deleted skipped=$skipped dry_run=$dry_run"
  echo "prune-merged-branches: deleted=$deleted skipped=$skipped"
}

# escalate_unpushed_worktree <path> <branch> — file (or reuse) a bead for a
# worktree that clean-worktrees refuses to remove because it holds commits
# that are not recoverable from the remote, and page the Mayor through the
# one escalation door (never a silent skip -- the whole point of routing
# this through a schedule is that nobody is watching for it by hand).
escalate_unpushed_worktree() {
  local path="$1" branch="$2"
  local title="[clean-worktrees] unpushed commits in $path (branch $branch)"

  local existing
  existing=$(gc bd list --status open --title-contains "$title" --json 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    data = []
print(len(data) if isinstance(data, list) else 0)
' 2>/dev/null)
  if [ "${existing:-0}" != "0" ]; then
    log clean-worktrees escalation-skipped "path=$path branch=$branch reason=already-filed"
    return 0
  fi

  local created
  created=$(gc bd create "$title" -p 2 -t task \
    -d "factory-maintain clean-worktrees found worktree $path on branch $branch with commits that are not pushed to its upstream. It was left in place rather than removed, because removing it would lose work with no remote copy to recover from. Push the branch (or confirm it is abandoned and hand-remove it), then close this bead." \
    --metadata '{"gc.source":"clean-worktrees"}' \
    --json 2>/dev/null | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("")
    raise SystemExit(0)
if isinstance(data, list):
    data = data[0] if data else {}
print(data.get("id", "") if isinstance(data, dict) else "")
' 2>/dev/null)
  if [ -z "$created" ]; then
    log clean-worktrees escalation-failed "path=$path branch=$branch reason=bd-create-failed"
    return 1
  fi

  if "$ESCALATION_DOOR_BIN" mayor "$created" \
    "worktree $path (branch $branch) has commits not pushed to its upstream; clean-worktrees left it in place"; then
    log clean-worktrees escalated "path=$path branch=$branch bead=$created"
  else
    log clean-worktrees escalation-failed "path=$path branch=$branch bead=$created reason=escalation-door-failed"
    return 1
  fi
}

cmd_clean_worktrees() {
  local wt_root="${HOME}/.local/share/agent-factory-runtime-worktrees" dry_run=0
  local idle_days=7
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktree-root) wt_root="$2"; shift 2 ;;
      --idle-days) idle_days="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      *) echo "factory-maintain clean-worktrees: unknown arg $1" >&2; return 2 ;;
    esac
  done
  [ -d "$wt_root" ] || { echo "clean-worktrees: $wt_root does not exist, nothing to clean"; return 0; }

  local idle_seconds=$((idle_days * 86400))
  local removed=0 skipped=0 escalated=0 d
  for d in "$wt_root"/*/; do
    [ -d "$d" ] || continue
    d="${d%/}"
    git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || continue

    local branch
    branch=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then skipped=$((skipped+1)); continue; fi

    if [ -n "$(git -C "$d" status --porcelain 2>/dev/null)" ]; then
      skipped=$((skipped+1)); continue   # uncommitted work
    fi

    local sha upstream ahead=1 merged_pr=""
    sha=$(git -C "$d" rev-parse HEAD)
    upstream=$(git -C "$d" for-each-ref --format='%(upstream)' "refs/heads/$branch")
    if [ -z "$upstream" ]; then
      if git -C "$d" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        upstream="refs/remotes/origin/$branch"
      fi
    fi
    if [ -n "$upstream" ]; then
      ahead=$(git -C "$d" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 1)
    fi
    if [ -z "$upstream" ] || [ "$ahead" != "0" ]; then
      merged_pr=$(merged_pr_for_exact_head "$d" "$branch" "$sha" || true)
    fi
    if [ -z "$merged_pr" ] && { [ -z "$upstream" ] || [ "$ahead" != "0" ]; }; then
      # never pushed, or pushed but ahead of its upstream -- either way some
      # commits may exist only on this machine; never remove without exact
      # merged-PR proof, always escalate
      if [ "$dry_run" = "1" ]; then
        echo "would escalate: $d (branch=$branch sha=$sha, unpushed commits)"
      else
        escalate_unpushed_worktree "$d" "$branch" || true
      fi
      escalated=$((escalated+1))
      continue
    fi

    local base_ref merged=0
    base_ref=$(git -C "$d" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo "")
    if [ -n "$base_ref" ] && git -C "$d" merge-base --is-ancestor HEAD "refs/remotes/$base_ref" 2>/dev/null; then
      merged=1
    fi
    if [ "$merged" != "1" ] && [ -z "$merged_pr" ]; then
      merged_pr=$(merged_pr_for_exact_head "$d" "$branch" "$sha" || true)
    fi
    if [ -n "$merged_pr" ]; then
      merged=1
    fi

    if [ "$merged" != "1" ]; then
      # not merged: only eligible once clean, pushed, and untouched for
      # more than --idle-days (a stale-but-not-abandoned worktree stays)
      local last_commit_epoch now age
      last_commit_epoch=$(git -C "$d" log -1 --format=%ct HEAD 2>/dev/null || echo 0)
      now=$(date +%s)
      age=$((now - last_commit_epoch))
      if [ "$age" -lt "$idle_seconds" ]; then
        skipped=$((skipped+1)); continue
      fi
    fi

    local main_repo proof_detail=""
    if [ -n "$merged_pr" ]; then
      proof_detail=" proof=github-pr-merged pr=$merged_pr"
    fi
    main_repo=$(git -C "$d" rev-parse --git-common-dir 2>/dev/null)
    case "$main_repo" in /*) ;; *) main_repo="$d/$main_repo" ;; esac
    main_repo=$(cd -- "$(dirname -- "$main_repo")" && pwd -P)

    if [ "$dry_run" = "1" ]; then
      echo "would remove: $d (branch=$branch sha=$sha)"
    else
      if git -C "$main_repo" worktree remove "$d" --force >/dev/null 2>&1; then
        removed=$((removed+1))
        log clean-worktrees removed \
          "path=$d branch=$branch sha=$sha${proof_detail} undo='factory-do-work-workspace enter recreates it from branch $branch while that branch exists'"
      fi
    fi
  done

  log clean-worktrees summary "removed=$removed skipped=$skipped escalated=$escalated dry_run=$dry_run"
  echo "clean-worktrees: removed=$removed skipped=$skipped escalated=$escalated"
}

cmd_rotate_logs() {
  local dir="$ROOT/var" max_bytes=$((10*1024*1024)) keep=5
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --max-bytes) max_bytes="$2"; shift 2 ;;
      --keep) keep="$2"; shift 2 ;;
      *) echo "factory-maintain rotate-logs: unknown arg $1" >&2; return 2 ;;
    esac
  done
  [ -d "$dir" ] || { echo "rotate-logs: $dir does not exist, nothing to rotate"; return 0; }

  local rotated=0 f size ts archive
  for f in "$dir"/*.log; do
    [ -f "$f" ] || continue
    size=$(wc -c < "$f" 2>/dev/null || echo 0)
    [ "$size" -gt "$max_bytes" ] || continue

    ts=$(date -u +%Y%m%dT%H%M%SZ)
    archive="${f}.rotated.${ts}.gz"
    if ! gzip -c "$f" > "$archive" 2>/dev/null; then
      echo "rotate-logs: could not archive $f" >&2
      rm -f "$archive"
      continue
    fi
    : > "$f"    # truncate in place -- never delete; the archive is the undo
    rotated=$((rotated+1))
    log rotate-logs rotated "file=$f archive=$archive undo='gunzip -c $archive >> $f'"

    local old
    while IFS= read -r old; do
      [ -n "$old" ] || continue
      rm -f "$old"
      log rotate-logs pruned-archive "archive=$old"
    done < <(ls -1t "${f}".rotated.*.gz 2>/dev/null | tail -n "+$((keep+1))")
  done

  log rotate-logs summary "rotated=$rotated dir=$dir keep=$keep"
  echo "rotate-logs: rotated=$rotated"
}

cmd_reload_city_config() {
  local city=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --city) city="$2"; shift 2 ;;
      *) echo "factory-maintain reload-city-config: unknown arg $1" >&2; return 2 ;;
    esac
  done
  local args=()
  [ -n "$city" ] && args+=(--city "$city")
  args+=(reload --json)

  local out rc
  out=$(gc "${args[@]}" 2>&1); rc=$?
  if [ "$rc" -eq 0 ]; then
    log reload-city-config reloaded "city=${city:-default} undo='revert the config change and run reload-city-config again'"
  else
    log reload-city-config failed "city=${city:-default} output=$(printf '%s' "$out" | tr '\n' ' ')"
  fi
  printf '%s\n' "$out"
  return "$rc"
}

cmd_restart_service() {
  local name="${1:-}" city=""
  [ -n "$name" ] || { echo "usage: factory-maintain restart-service <name> [--city <path>]" >&2; return 2; }
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --city) city="$2"; shift 2 ;;
      *) echo "factory-maintain restart-service: unknown arg $1" >&2; return 2 ;;
    esac
  done

  local list_args=()
  [ -n "$city" ] && list_args+=(--city "$city")
  list_args+=(service list --json)

  local known
  known=$(gc "${list_args[@]}" 2>/dev/null || echo "")
  if [ -n "$known" ] && command -v python3 >/dev/null 2>&1; then
    if ! printf '%s' "$known" | python3 -c '
import json, sys
name = sys.argv[1]
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)  # cannot verify -- do not block on output we cannot parse
items = data if isinstance(data, list) else data.get("services", data.get("items", []))
names = [it.get("name") for it in items if isinstance(it, dict)]
sys.exit(0 if name in names else 1)
' "$name"; then
      echo "factory-maintain restart-service: refusing unknown service '$name' (not in gc service list)" >&2
      log restart-service refused "name=$name reason=unknown-service"
      return 1
    fi
  fi

  local restart_args=()
  [ -n "$city" ] && restart_args+=(--city "$city")
  restart_args+=(service restart "$name")

  local out rc
  out=$(gc "${restart_args[@]}" 2>&1); rc=$?
  if [ "$rc" -eq 0 ]; then
    log restart-service restarted "name=$name undo='gc service restart $name again if the new instance misbehaves'"
  else
    log restart-service failed "name=$name output=$(printf '%s' "$out" | tr '\n' ' ')"
  fi
  printf '%s\n' "$out"
  return "$rc"
}

GESTURE="${1:-}"
[ -n "$GESTURE" ] || usage
shift

case "$GESTURE" in
  prune-merged-branches) cmd_prune_merged_branches "$@" ;;
  clean-worktrees)       cmd_clean_worktrees "$@" ;;
  rotate-logs)           cmd_rotate_logs "$@" ;;
  reload-city-config)    cmd_reload_city_config "$@" ;;
  restart-service)       cmd_restart_service "$@" ;;
  -h|--help)             usage ;;
  *) echo "factory-maintain: unknown gesture '$GESTURE'" >&2; usage ;;
esac
