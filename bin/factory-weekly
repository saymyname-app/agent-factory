#!/usr/bin/env python3
"""factory-weekly -- the weekly table of FACTORY_OBJECTIVE.md (af-q55qqx.2, J2).

Computes, for one ISO week (Monday 00:00 to Monday 00:00, Paris), the
thresholds of FACTORY_OBJECTIVE.md that have a live source, from records that
already exist on this host. Read-only on everything but its own output; L0,
zero token.

  slices_per_working_day   product pull requests merged into the product
                           branch (`promotion_branch.from`, i.e. `dev`) of
                           every rig of a non-Factory project descriptor,
                           divided by the Monday-Friday days of the week
  lead_time_median_hours   bead creation -> merge of those pull requests; the
  lead_time_p85_hours      bead is the first known bead id of the head branch,
                           then of the title (nearest-rank percentile)
  maintenance_share        Factory pull requests merged into main / all merged
                           pull requests (Factory + product)
  human_requests_max_per_day  escalation-door requests mailed to the human
                           ("NEEDS BENJAMIN:" mail.sent in .gc/events.jsonl),
                           worst Paris day; re-asks count, as they reach him
  product_cost_share       token cost of the week attributed to product work,
                           over all of it. Tokens come from the transcripts
                           (Claude ~/.claude/projects, assistant messages
                           deduplicated by id; Codex ~/.codex/sessions,
                           token_count events), weighted by the versioned
                           config/token-cost-weights.json. A transcript is
                           product work when it names product paths more
                           and bead ids (prefix of a product rig in
                           .beads/routes.jsonl) more often than Factory ones;
                           neither -> unattributed, counted as not product.

Not .gc/usage.jsonl: Gas City writes it at least once per fact and its own
reader (`gc costs`) deduplicates by idempotency_key; it misses the sessions gc
does not ingest (the Mayor on Codex since 15/09/2026, interactive sessions)
and cannot tell product from Factory (its run ids are purged wisps).

Récidives par règle (af-56yoam.1): the slips of the week's month (Paris) per
concrete rule of docs/DEFECT_CLASSES.md, from `lib/defect_classes.py`
(baseline docs/defect-rules-baseline.tsv, then the `Règle :` line of later
pull requests), against decision D1 (af-56yoam.5): the share of the month's
defect pull requests that are slips, at most 30 % (November 2026: 61 %), and
zero slip on a rule the register marks closed; review on 21/12/2026 with its
stop criterion, and the pull requests the gate « Maintenance form » refused
during the period (af-56yoam.9). Observed under "rule_recurrence"; a pull
request with neither is counted unclassified.

A measure without a source is null, status "unmeasured", with its reason.
Contract of the JSON: agent-factory-weekly-measure/v1 (read by the Cockpit).

Usage: factory-weekly [--week YYYY-Www] [--json] [--write]
  default week: the last complete one. --write: var/weekly/<week>.{json,md}.
"""
import argparse
import glob
import gzip
from pathlib import Path
import json
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import date, datetime, timedelta
from zoneinfo import ZoneInfo

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from bounded_process import run as bounded_run  # noqa: E402
from account_home import account_home  # noqa: E402
import defect_classes  # noqa: E402

ROOT = os.environ.get("FACTORY_ROOT", "/home/benja/agent-factory")
GC = os.environ.get("GC_BIN", "gc")
GH = os.environ.get("GH_BIN", "gh")
CLAUDE = os.environ.get("FACTORY_WEEKLY_CLAUDE") or os.path.join(account_home(), ".claude/projects")
CODEX = os.environ.get("FACTORY_WEEKLY_CODEX") or os.path.join(account_home(), ".codex/sessions")
PARIS = ZoneInfo("Europe/Paris")
CONTRACT = "agent-factory-weekly-measure/v1"
FACTORY_PROJECT = "agent-factory"
FACTORY_PATHS = [b"agent-factory/bin/", b"agent-factory/lib/", b"agent-factory/docs/", b"agent-factory/tests/",
                 b"agent-factory/.gc/", b"agent-factory-maint/", b"agent-factory-po/", b"saymyname-app/agent-factory"]


def bead_ids(prefixes):
    return re.compile(rb"\b(?:%s)-[a-z0-9]{3,}" % b"|".join(re.escape(p.encode()) for p in prefixes))


def ts(value):
    value = re.sub(r"(\.\d{1,6})\d*", r"\1", value.replace("Z", "+00:00"))
    return datetime.fromisoformat(value).timestamp()


def run(cmd):
    out = bounded_run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=180)
    if out.returncode:
        raise RuntimeError(f"{' '.join(cmd[:3])} failed (rc {out.returncode}): {out.stderr.strip()[:200]}")
    return out.stdout


def projects():
    """Factory repo, product (repo, base branch) pairs, every bead prefix, and
    what names product or Factory work in a transcript: paths, repositories
    and bead ids of each side (a rig's prefix comes from .beads/routes.jsonl)."""
    factory, products, paths = None, [], []
    routes = [json.loads(line) for line in Path(ROOT, ".beads/routes.jsonl").read_text(encoding="utf-8").splitlines() if line.strip()]
    product_rigs = set()
    for path in sorted(glob.glob(os.path.join(ROOT, "config/project-descriptors/*.json"))):
        desc = json.loads(Path(path).read_text(encoding="utf-8"))
        if desc.get("project_id") == FACTORY_PROJECT:
            factory = desc["knowledge_repo"]
            continue
        for rig in desc.get("rigs", []):
            url = run(["git", "-C", os.path.join(ROOT, "rigs", rig), "remote", "get-url", "origin"]).strip()
            repo = re.sub(r"\.git$", "", url.split("github.com")[-1].lstrip(":/"))
            products.append((repo, (desc.get("promotion_branch") or {}).get(rig, {}).get("from", "dev")))
            paths += [f"rigs/{rig}".encode(), repo.split("/")[-1].encode()]
            product_rigs.add(f"rigs/{rig}")
    product_prefixes = [r["prefix"] for r in routes if r["path"] in product_rigs]
    factory_prefixes = [r["prefix"] for r in routes if r["path"] not in product_rigs]
    return {"factory": factory, "products": products, "prefixes": [r["prefix"] for r in routes],
            "product": (paths, bead_ids(product_prefixes)), "factory_work": (FACTORY_PATHS, bead_ids(factory_prefixes))}


def merged(repo, base, start, end):
    since = datetime.fromtimestamp(start - 86400, PARIS).date().isoformat()
    prs = json.loads(run([GH, "pr", "list", "-R", repo, "--state", "merged", "--base", base, "--limit", "1000",
                          "--search", f"merged:>={since}", "--json", "number,title,headRefName,mergedAt"]) or "[]")
    return [pr for pr in prs if start <= ts(pr["mergedAt"]) < end]


def lead_hours(pr, prefixes):
    pattern = re.compile(r"\b((?:%s)-[a-z0-9]{3,}(?:\.\d+)*)\b" % "|".join(map(re.escape, prefixes)))
    for text in (pr["headRefName"], pr["title"]):
        for bead in pattern.findall(text or ""):
            try:
                found = json.loads(run([GC, "bd", "show", bead, "--json"]))
            except (RuntimeError, ValueError):
                continue
            found = found[0] if isinstance(found, list) else found
            return (ts(pr["mergedAt"]) - ts(found["created_at"])) / 3600, bead
    return None, None


def percentile(values, p):
    values = sorted(values)
    return values[max(0, -(-len(values) * p // 100) - 1)]


def human_requests(start, end):
    days = Counter()
    # gc rotates the log into events.jsonl.archive-<UTC time of rotation>-...gz:
    # an archive rotated after the week began may hold some of it. Their seq
    # ranges overlap, hence the dedup by seq.
    files, seen = [os.path.join(ROOT, ".gc/events.jsonl")], set()
    for archive in glob.glob(os.path.join(ROOT, ".gc/events.jsonl.archive-*.gz")):
        rotated = re.search(r"archive-(\d{8}T\d{6}Z)", archive)
        if rotated and datetime.strptime(rotated[1], "%Y%m%dT%H%M%S%z").timestamp() >= start:
            files.append(archive)
    for path in files:
        with (gzip.open if path.endswith(".gz") else open)(path, "rb") as fh:
            for line in fh:
                if b'"mail.sent"' not in line or b"NEEDS BENJAMIN" not in line:
                    continue
                try:
                    ev = json.loads(line)
                    msg = ev["payload"]["message"]
                    at = ts(ev["ts"])
                except (ValueError, KeyError, TypeError):
                    continue
                if ev.get("seq") in seen and ev.get("seq") is not None:
                    continue
                seen.add(ev.get("seq"))
                if msg.get("to") == "human" and str(msg.get("subject", "")).startswith("NEEDS BENJAMIN") and start <= at < end:
                    days[datetime.fromtimestamp(at, PARIS).date().isoformat()] += 1
    return days


def attribute(raw, sides):
    product, factory = (sum(raw.count(m) for m in paths) + len(ids.findall(raw))
                        for paths, ids in (sides["product"], sides["factory_work"]))
    return "product" if product > factory else "factory" if factory else "unattributed"


def is_mayor(path):
    """A live-root session whose transcript opens on « # Mayor » (its own
    file, or its parent's for a subagent): the Mayor (af-yzo8fo)."""
    folder = os.path.join(CLAUDE, re.sub(r"[^A-Za-z0-9]", "-", ROOT))
    parts = os.path.relpath(path, folder).split(os.sep)
    if parts[0] == os.pardir:
        return False
    main = os.path.join(folder, parts[0] + ".jsonl") if len(parts) > 1 else path
    try:
        with open(main, "rb") as fh:
            return b"# Mayor" in fh.read(20000)
    except OSError:
        return False


def token_costs(start, end, sides, weights, mayor=None):
    cost = Counter()
    for path in glob.glob(os.path.join(CLAUDE, "**", "*.jsonl"), recursive=True):
        if os.path.getmtime(path) < start:
            continue
        raw, seen, days = Path(path).read_bytes(), {}, {}
        for line in raw.splitlines():
            if b'"usage"' not in line:
                continue
            try:
                rec = json.loads(line)
                msg, at = rec["message"], ts(rec["timestamp"])
                u = msg["usage"]
            except (ValueError, KeyError, TypeError):
                continue
            if rec.get("type") == "assistant" and start <= at < end:
                seen[msg.get("id") or len(seen)] = (
                    weights["input"] * (u.get("input_tokens") or 0) + weights["output"] * (u.get("output_tokens") or 0)
                    + weights["cache_read"] * (u.get("cache_read_input_tokens") or 0)
                    + weights["cache_write"] * (u.get("cache_creation_input_tokens") or 0))
                days[msg.get("id") or len(days)] = datetime.fromtimestamp(at, PARIS).date().isoformat()
        cost[attribute(raw, sides)] += sum(seen.values())
        if mayor is not None and seen and is_mayor(path):
            for key, value in seen.items():
                mayor[days[key]] += value
    for path in glob.glob(os.path.join(CODEX, "**", "*.jsonl"), recursive=True):
        if os.path.getmtime(path) < start:
            continue
        raw, total = Path(path).read_bytes(), 0
        for line in raw.splitlines():
            if b'"token_count"' not in line:
                continue
            try:
                rec = json.loads(line)
                u, at = rec["payload"]["info"]["last_token_usage"], ts(rec["timestamp"])
            except (ValueError, KeyError, TypeError):
                continue
            if start <= at < end:
                cached = u.get("cached_input_tokens") or 0
                total += (weights["input"] * ((u.get("input_tokens") or 0) - cached) + weights["cache_read"] * cached
                          + weights["output"] * (u.get("output_tokens") or 0))
        cost[attribute(raw, sides)] += total
    return cost


def rule_recurrence(repo, end):
    """Slips, planned repeats and first fixes of the week's month per rule,
    against D1 (af-56yoam.1). Unmeasured, with its reason, when the register,
    the baseline or gh cannot be read."""
    month = datetime.fromtimestamp(end - 1, PARIS).strftime("%Y-%m")
    try:
        known = defect_classes.rules(defect_classes.load())
        baseline = defect_classes.load_baseline(known=known)
        since = min(row["date"] for row in baseline.values())
        counted = defect_classes.by_rule(defect_classes.merged_since(since, Path(ROOT), repo), baseline, known, since)
    except (defect_classes.RegistryError, OSError, ValueError, KeyError, subprocess.TimeoutExpired) as exc:
        return {"month": month, "status": "unmeasured", "reason": str(exc)[:200]}
    decision = defect_classes.d1(baseline, known)
    until = datetime.fromtimestamp(end - 1, PARIS).strftime("%Y-%m-%d")
    decision["gate_refusals"] = gate_refusals(repo, decision["period"][0], min(decision["period"][1], until))
    natures = counted["months"].get(month, dict.fromkeys(defect_classes.NATURES, 0))
    by_rule = {rule: cells[month]["glissement"] for rule, cells in counted["rules"].items()
               if cells.get(month, {}).get("glissement")}
    share = defect_classes.slip_share(natures)
    closed = [slip for slip in counted["closed_slips"] if slip["date"][:7] == month]
    ok = not closed and (share is None or share <= decision["max_slip_share"])
    return {"month": month, "status": "ok" if ok else "ko", "slips": natures["glissement"],
            "planned": natures["prevue"], "first": natures["premiere"], "slip_share": share,
            "slips_by_rule": dict(sorted(by_rule.items(), key=lambda kv: (-kv[1], kv[0]))),
            "closed_slips": closed, "unclassified": len(counted["unclassified"]), "d1": decision}


def gate_refusals(repo, start, end):
    """The pull requests whose required check « Maintenance form » failed at
    least once from `start` to `end` (run creation dates, GitHub's UTC): the
    refusals of the gate (af-56yoam.9). Whether each was justified is judged at
    D1's review."""
    if end < start:
        return {"prs": 0, "branches": []}
    try:
        runs = json.loads(run([GH, "run", "list", "-R", repo, "--workflow", "maintenance-form.yml", "--status", "failure",
                               "--created", f"{start}..{end}", "--limit", "1000", "--json", "headBranch,event"]) or "[]")
    except (RuntimeError, ValueError, subprocess.TimeoutExpired) as exc:
        return {"prs": None, "reason": str(exc)[:200]}
    branches = sorted({r["headBranch"] for r in runs if r.get("event") == "pull_request"})
    return {"prs": len(branches), "branches": branches}


def week_bounds(week):
    if week:
        monday = date.fromisocalendar(int(week[:4]), int(week[-2:]), 1)
    else:
        today = datetime.now(PARIS).date()
        monday = today - timedelta(days=today.weekday() + 7)
    start = datetime.combine(monday, datetime.min.time(), PARIS)
    end = datetime.combine(monday + timedelta(days=7), datetime.min.time(), PARIS)
    iso = monday.isocalendar()
    return f"{iso[0]}-W{iso[1]:02d}", start.timestamp(), end.timestamp()


def measure(week):
    name, start, end = week_bounds(week)
    out = {"contract": CONTRACT, "week": name, "generated_at": datetime.now(PARIS).isoformat(timespec="seconds"),
           "start": datetime.fromtimestamp(start, PARIS).isoformat(), "end": datetime.fromtimestamp(end, PARIS).isoformat(),
           "measures": {}}
    m = out["measures"]

    def put(key, value, target, cmp, why=None, **detail):
        ok = None if value is None else (value >= target if cmp == ">=" else value <= target)
        m[key] = {"value": None if value is None else round(value, 2), "target": target, "comparison": cmp,
                  "status": "unmeasured" if value is None else "ok" if ok else "ko", "detail": detail}
        if value is None:
            m[key]["reason"] = why

    sides = projects()
    prefixes = sides["prefixes"]
    product_prs = [dict(pr, repo=repo) for repo, base in sides["products"] for pr in merged(repo, base, start, end)]
    factory_prs = merged(sides["factory"], "main", start, end)
    workdays = sum(datetime.fromtimestamp(start + d * 86400 + 43200, PARIS).weekday() < 5 for d in range(7))
    put("slices_per_working_day", len(product_prs) / workdays, 1, ">=", product_prs=len(product_prs), working_days=workdays)
    leads = [h for h, _ in (lead_hours(pr, prefixes) for pr in product_prs) if h is not None]
    why = "no product pull request merged this week" if not product_prs else "no bead found for the merged product pull requests"
    put("lead_time_median_hours", percentile(leads, 50) if leads else None, 24, "<=", why, samples=len(leads))
    put("lead_time_p85_hours", percentile(leads, 85) if leads else None, 72, "<=", why, samples=len(leads))
    total = len(product_prs) + len(factory_prs)
    put("maintenance_share", len(factory_prs) / total if total else None, 0.30, "<=", "no pull request merged",
        factory_prs=len(factory_prs), product_prs=len(product_prs))
    days = human_requests(start, end)
    put("human_requests_max_per_day", max(days.values(), default=0), 1, "<=", requests=sum(days.values()), per_day=dict(sorted(days.items())))
    weights = json.loads(Path(ROOT, "config/token-cost-weights.json").read_text(encoding="utf-8"))["weights"]
    mayor = Counter()
    cost = token_costs(start, end, sides, weights, mayor)
    spent = sum(cost.values())
    put("product_cost_share", cost["product"] / spent if spent else None, 0.50, ">=", "no transcript usage this week",
        **{k: round(cost[k]) for k in ("product", "factory", "unattributed")})
    # Observed, no threshold: the Mayor's model trial (af-yzo8fo, Sonnet from
    # 21/11/2026) is compared per day with the Opus weeks.
    out["observed"] = {"mayor_cost": {"total": round(sum(mayor.values())),
                                      "share": round(sum(mayor.values()) / spent, 3) if spent else None,
                                      "per_day": {d: round(v) for d, v in sorted(mayor.items())}},
                       "rule_recurrence": rule_recurrence(sides["factory"], end)}
    out["not_measured"] = {
        "integration_branch_age": "not computed here (FACTORY_OBJECTIVE.md principle 2)",
        "requests_in_closed_list": "escalations carry no ADR-0016 effect field yet (J3)",
        "escaped_defects": "no record links a defect to the slice that let it through",
        "windows_sessions": "sessions run on the Windows PC leave no transcript on this host",
    }
    return out


LABELS = [("slices_per_working_day", "Tranches produit fusionnées sur dev par jour ouvré", "{:g}"),
          ("lead_time_median_hours", "Délai bead → dev, médiane (h)", "{:g}"),
          ("lead_time_p85_hours", "Délai bead → dev, p85 (h)", "{:g}"),
          ("maintenance_share", "Part maintenance des PR", "{:.0%}"),
          ("human_requests_max_per_day", "Sollicitations de Benjamin, pire jour", "{:g}"),
          ("product_cost_share", "Part du coût sur le produit", "{:.0%}")]


def markdown(out):
    lines = [f"Semaine {out['week']} (Paris, {out['start'][:10]} → {out['end'][:10]})", "",
             "| Seuil | Cible | Mesure | État |", "|---|---|---|---|"]
    for key, label, fmt in LABELS:
        m = out["measures"][key]
        value = "—" if m["value"] is None else fmt.format(m["value"])
        target = f"{m['comparison']} {fmt.format(m['target'])}"
        state = {"ok": "OK", "ko": "KO", "unmeasured": f"non mesuré : {m.get('reason')}"}[m["status"]]
        lines.append(f"| {label} | {target} | {value} | {state} |")
    mc = out["observed"]["mayor_cost"]
    share = "—" if mc["share"] is None else f"{mc['share']:.0%}"
    lines += ["", f"Coût du Mayor (observé, sans seuil, af-yzo8fo) : {mc['total'] / 1e6:.1f} M pondérés, {share} du total ; par jour : "
              + (", ".join(f"{d[8:10]}/{d[5:7]} {v / 1e6:.1f} M" for d, v in mc["per_day"].items()) or "aucun")]
    lines += ["", *recurrence_lines(out["observed"]["rule_recurrence"])]
    lines += ["", "Non mesuré : " + " ; ".join(f"{k} ({v})" for k, v in out["not_measured"].items())]
    return "\n".join(lines) + "\n"


def recurrence_lines(r):
    month = f"{r['month'][5:7]}/{r['month'][:4]}"
    if r["status"] == "unmeasured":
        return [f"Récidives par règle ({month}) : non mesuré : {r['reason']}"]
    d1 = r["d1"]
    rules = ", ".join(f"{rule} {n}" for rule, n in r["slips_by_rule"].items()) or "aucune"
    closed = ", ".join(f"{slip['rule']} #{slip['pr']}" for slip in r["closed_slips"]) or "aucun"
    review = datetime.strptime(d1["review"], "%Y-%m-%d").strftime("%d/%m/%Y")
    share = "sans PR de défaut" if r["slip_share"] is None else f"{round(r['slip_share'] * 100)} %"
    start, end = (datetime.strptime(day, "%Y-%m-%d").strftime("%d/%m") for day in d1["period"])
    gate, stop = d1["gate_refusals"], d1["stop"]
    refusals = (f"non mesuré : {gate['reason']}" if gate["prs"] is None
                else f"{gate['prs']} PR" + (f" ({', '.join(gate['branches'])})" if gate["branches"] else ""))
    return [f"Récidives par règle ({month}, Paris, af-56yoam) : {r['slips']} glissements, {r['planned']} répétitions "
            f"prévues, {r['first']} premières corrections ; {r['unclassified']} PR fusionnées sans ligne « Règle : » "
            f"ni place dans la base de référence.",
            f"Glissements du mois par règle : {rules}.",
            f"Objectif D1 (Benjamin, 23/11/2026) : part des glissements dans les PR de défaut {share}, au plus "
            f"{round(d1['max_slip_share'] * 100)} % du {start} au {end} (novembre 2026 : "
            f"{d1['reference_slips']}/{d1['reference_defects']}, {round(d1['reference_share'] * 100)} %) ; "
            f"0 glissement sur les {len(d1['closed'])} règles fermées (ce mois : {closed}) : "
            f"{'OK' if r['status'] == 'ok' else 'KO'}. Revue le {review} ({d1['bead']}).",
            f"Refus de la porte « Maintenance form » du {start} au {end} (contrôle en échec au moins une fois) : "
            f"{refusals}.",
            f"Critère d'arrêt (Benjamin, 24/11/2026) : à la revue, si la part des glissements dépasse encore "
            f"{round(stop['share_above'] * 100)} %, ou si plus d'un refus sur "
            f"{stop['unjustified_refusals_above'].split('/')[1]} est injustifié, on retire la porte obligatoire ; "
            f"la mesure reste."]


def main(argv):
    parser = argparse.ArgumentParser(prog="factory-weekly", description="Weekly table of FACTORY_OBJECTIVE.md thresholds.")
    parser.add_argument("--week", metavar="YYYY-Www", help="ISO week (default: the last complete one)")
    parser.add_argument("--json", action="store_true", help="print the JSON contract instead of the Markdown table")
    parser.add_argument("--write", action="store_true", help="also write var/weekly/<week>.json and .md")
    args = parser.parse_args(argv)
    if args.week and not re.fullmatch(r"\d{4}-W\d{2}", args.week):
        parser.error("--week must read YYYY-Www")
    out = measure(args.week)
    text = markdown(out)
    print(json.dumps(out, ensure_ascii=False, indent=1) if args.json else text, end="" if not args.json else "\n")
    if args.write:
        folder = os.path.join(ROOT, "var/weekly")
        os.makedirs(folder, exist_ok=True)
        with open(os.path.join(folder, out["week"] + ".json"), "w", encoding="utf-8") as fh:
            json.dump(out, fh, ensure_ascii=False, indent=1)
        with open(os.path.join(folder, out["week"] + ".md"), "w", encoding="utf-8") as fh:
            fh.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
