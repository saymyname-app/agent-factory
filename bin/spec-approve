#!/usr/bin/env python3
"""Approve, freeze and revise Planning Artifacts by exact digest (B05).

This is a deterministic synthetic prototype, not a live Gas City write door:
given a Spec artifact produced by `planning-run-to-spec-oracle` (state
`DRAFT_SPEC`), `approve` names its artifact identity and exact content
digest and flips the same file to `APPROVED_SPEC` -- it never writes a
second document. When a Planning Map path is also given, `approve` closes
that map in the same call, so a Planning Map never outlives the Spec it
produced.

Once `APPROVED_SPEC`, the artifact is frozen: `freeze-check` detects any
drift between its recorded digest and its actual content and reports which
section changed, and `revise` is the only sanctioned way to change it --
it requires the caller to name the exact digest it is revising, refuses to
mint a revision that does not actually change the content, and records
provenance back to the digest it replaces. `expire-check` reports that the
artifact stays recoverable while its convoy is open and is eligible to
expire only after the convoy closes; it is never the artifact of durable
truth, which belongs in code, tests, the domain glossary and qualifying
ADRs.

`bd-approve` and `bd-status` are the live Beads-backed mode (A6b, W04): a
Spec is a planning-plane Beads bead published by `/to-spec`, not a JSON
file, and its Planning Map (if any) is a Beads bead too. `bd-approve` reads
the Spec bead by id, refuses unless the Spec's `planning_run_target` equals
the active Planning Run Reservation (`bin/planning-run-reservation`), its
named map is finished (`bin/planning-map check`) or it names no map and
carries non-empty No-fog exit evidence, and `--approved-by` is the project's
declared human approver (`bin/project-planning-profile human-approver`).
On success it records the approval, approver, evidence and digest of the
Spec's current content as bead metadata, then closes the map. `bd-status`
reports whether a later edit to the Spec's description has voided the
approval -- its content digest no longer matches the one recorded at
approval. The file-Spec mode above stays only for the router until W10
retires both.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Iterator


PROGRAM = "spec-approve"
SPEC_CONTRACT = "agent-factory-planning-run-spec/v1"
MAP_CONTRACT = "agent-factory-wayfinding-run/v1"

DRAFT_SPEC = "DRAFT_SPEC"
APPROVED_SPEC = "APPROVED_SPEC"

MAP_TO_SPEC_READY = "to_spec_ready"
MAP_CLOSED = "closed"

BD_BIN = os.environ.get("BD_BIN", "bd")
NO_MAP_VALUES = (None, "", "none")

REQUIRED_SECTIONS = (
    "behavior",
    "boundaries",
    "decisions",
    "acceptance_evidence",
    "provenance",
    "experiments",
    "non_objectives",
)


class SpecApproveError(RuntimeError):
    """An actionable diagnostic about a Planning Artifact approval."""


def as_dict(value: Any, name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise SpecApproveError(f"{name} must be an object")
    return value


def required_string(value: Any, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise SpecApproveError(f"{name} must be a non-empty string")
    return value


def canonical_digest(value: Any) -> str:
    """Identical digest formula to `planning-run-to-spec-oracle`, so a Spec's
    digest never changes just because it passed through this tool."""
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def load_spec(path: Path) -> dict[str, Any]:
    try:
        spec = as_dict(json.loads(path.read_text(encoding="utf-8")), "spec")
    except (OSError, json.JSONDecodeError) as exc:
        raise SpecApproveError(f"cannot read spec {path}: {exc}") from exc
    contract = spec.get("contract")
    if contract != SPEC_CONTRACT:
        raise SpecApproveError(f"spec.contract must be {SPEC_CONTRACT!r}, got {contract!r}")
    return spec


def spec_sections(spec: dict[str, Any]) -> dict[str, Any]:
    sections = as_dict(spec.get("sections"), "spec.sections")
    missing = [key for key in REQUIRED_SECTIONS if key not in sections]
    if missing:
        raise SpecApproveError(f"spec.sections is missing required section(s): {missing}")
    return sections


def write_spec(path: Path, spec: dict[str, Any]) -> None:
    path.write_text(json.dumps(spec, indent=2, sort_keys=True) + "\n", encoding="utf-8")


@contextmanager
def locked_map(path: Path) -> Iterator[dict[str, Any]]:
    """Exclusive-lock a Planning Map file for one atomic read-modify-write --
    the same discipline `wayfinding-run` uses, so closing a map here can
    never race a concurrent map mutation."""
    if not path.exists():
        raise SpecApproveError(f"map not found: {path}")
    with path.open("r+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            raw = handle.read().strip()
            state = as_dict(json.loads(raw) if raw else {}, "map")
            if state.get("contract") != MAP_CONTRACT:
                raise SpecApproveError(f"map.contract must be {MAP_CONTRACT!r}, got {state.get('contract')!r}")
            yield state
            handle.seek(0)
            handle.truncate()
            handle.write(json.dumps(state, indent=2, sort_keys=True))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def append_history(spec: dict[str, Any], event: str, **fields: Any) -> None:
    spec.setdefault("history", []).append({"event": event, "at": time.time(), **fields})


# --- approve -----------------------------------------------------------------


def cmd_approve(args: argparse.Namespace) -> int:
    spec_path = Path(args.spec)
    try:
        spec = load_spec(spec_path)
        if spec.get("state") != DRAFT_SPEC:
            raise SpecApproveError(
                f"cannot approve state={spec.get('state')!r}: only a DRAFT_SPEC can be "
                "approved -- an APPROVED_SPEC is already approved once and approval never "
                "creates a duplicate approved document"
            )
        sections = spec_sections(spec)
        actual_digest = canonical_digest(sections)
        declared_digest = spec.get("content_digest")
        if declared_digest != actual_digest:
            raise SpecApproveError(
                f"spec.content_digest {declared_digest!r} does not match the actual content "
                f"digest {actual_digest!r} -- refusing to approve a mismatched identity"
            )

        spec_id = required_string(spec.get("spec_id"), "spec.spec_id")

        # Validate every map precondition before mutating the spec file, so
        # a map that cannot close leaves the spec exactly as it was --
        # approval and map-closure either both happen or neither does.
        map_path = Path(args.map) if args.map else None
        if map_path is not None:
            if not map_path.exists():
                raise SpecApproveError(f"map not found: {map_path}")
            precheck = as_dict(json.loads(map_path.read_text(encoding="utf-8")), "map")
            if precheck.get("status") == MAP_CLOSED:
                raise SpecApproveError("map is already closed -- approval closes a map exactly once")
            if precheck.get("status") != MAP_TO_SPEC_READY:
                raise SpecApproveError(
                    f"cannot close map with status={precheck.get('status')!r}: a map only closes "
                    f"from {MAP_TO_SPEC_READY!r}"
                )

        spec["state"] = APPROVED_SPEC
        spec["approved_by"] = required_string(args.approved_by, "--approved-by")
        spec["approved_evidence"] = required_string(args.evidence, "--evidence")
        spec["approved_digest"] = actual_digest
        # Recorded per-section digests, so a later freeze-check can name
        # exactly which section drifted instead of only reporting a boolean.
        spec["section_digests"] = {key: canonical_digest(sections[key]) for key in REQUIRED_SECTIONS}
        append_history(
            spec, "approve", approved_by=spec["approved_by"], evidence=spec["approved_evidence"], digest=actual_digest
        )
        write_spec(spec_path, spec)

        map_closed = False
        if map_path is not None:
            with locked_map(map_path) as state:
                if state.get("status") != MAP_TO_SPEC_READY:
                    raise SpecApproveError(
                        f"map status changed to {state.get('status')!r} concurrently with this approval"
                    )
                state["status"] = MAP_CLOSED
                state.setdefault("history", []).append(
                    {"event": "closed_by_spec_approval", "at": time.time(), "spec_id": spec_id, "digest": actual_digest}
                )
            map_closed = True
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(
        json.dumps(
            {
                "ok": True,
                "spec_id": spec_id,
                "state": APPROVED_SPEC,
                "digest": actual_digest,
                "map_closed": map_closed,
            },
            indent=2,
        )
    )
    return 0


# --- freeze-check --------------------------------------------------------------


def cmd_freeze_check(args: argparse.Namespace) -> int:
    """Optional integrity check: reports which section drifted, not just a
    boolean, so it earns its keep instead of becoming another fog audit.
    Nothing in `approve` or `revise` requires this to run first."""
    spec_path = Path(args.spec)
    try:
        spec = load_spec(spec_path)
        if spec.get("state") != APPROVED_SPEC:
            raise SpecApproveError(
                f"cannot freeze-check state={spec.get('state')!r}: only an {APPROVED_SPEC} artifact is frozen"
            )
        sections = spec_sections(spec)
        recorded_section_digests = as_dict(spec.get("section_digests"), "spec.section_digests")
        drifted_sections = [
            key for key in REQUIRED_SECTIONS if canonical_digest(sections[key]) != recorded_section_digests.get(key)
        ]
        actual_digest = canonical_digest(sections)
        declared_digest = spec.get("content_digest")
        identity_mismatch = args.expected_digest is not None and declared_digest != args.expected_digest

        if drifted_sections:
            raise SpecApproveError(
                f"frozen artifact was mutated: section(s) {drifted_sections} no longer match their "
                f"recorded digest (overall digest now {actual_digest!r}, recorded {declared_digest!r})"
            )
        if identity_mismatch:
            raise SpecApproveError(
                f"declared identity drifted: expected {args.expected_digest!r}, artifact carries {declared_digest!r}"
            )
    except SpecApproveError as exc:
        print(
            json.dumps(
                {"ok": False, "error": str(exc), "drifted_sections": drifted_sections if "drifted_sections" in locals() else []},
                indent=2,
            )
        )
        return 1
    print(
        json.dumps(
            {
                "ok": True,
                "digest": declared_digest,
                "approved_by": spec.get("approved_by"),
                "evidence": spec.get("approved_evidence"),
                "sections_checked": list(REQUIRED_SECTIONS),
            },
            indent=2,
        )
    )
    return 0


# --- revise --------------------------------------------------------------------


def cmd_revise(args: argparse.Namespace) -> int:
    spec_path = Path(args.spec)
    try:
        spec = load_spec(spec_path)
        if spec.get("state") != APPROVED_SPEC:
            raise SpecApproveError(
                f"cannot revise state={spec.get('state')!r}: only an {APPROVED_SPEC} (frozen) artifact "
                "can be revised -- a DRAFT_SPEC is edited by re-running the Planning Run, not revise"
            )
        current_sections = spec_sections(spec)
        current_digest = canonical_digest(current_sections)
        if spec.get("content_digest") != current_digest:
            raise SpecApproveError(
                "frozen artifact was mutated outside this tool -- refusing to revise an artifact "
                "whose recorded digest does not match its actual content"
            )
        expected = required_string(args.expected_current_digest, "--expected-current-digest")
        if expected != current_digest:
            raise SpecApproveError(
                f"mutation of a frozen artifact is rejected: --expected-current-digest {expected!r} does "
                f"not match the artifact's current digest {current_digest!r}"
            )

        new_sections = spec_sections({"sections": as_dict(json.loads(Path(args.new_sections).read_text()), "new_sections")})
        new_digest = canonical_digest(new_sections)
        if new_digest == current_digest:
            raise SpecApproveError(
                "revise refuses to mint a revision with no semantic change -- the new sections "
                "produce the same content digest as the current approved artifact"
            )

        revision_entry = {
            "prior_digest": current_digest,
            "prior_approved_by": spec.get("approved_by"),
            "prior_evidence": spec.get("approved_evidence"),
            "provenance": required_string(args.provenance, "--provenance"),
            "revised_by": required_string(args.revised_by, "--revised-by"),
            "revised_at": time.time(),
        }
        spec.setdefault("revisions", []).append(revision_entry)
        spec["sections"] = new_sections
        spec["content_digest"] = new_digest
        spec["state"] = DRAFT_SPEC
        spec["revision"] = int(spec.get("revision", 0)) + 1
        for stale_field in ("approved_by", "approved_evidence", "approved_digest"):
            spec.pop(stale_field, None)
        append_history(spec, "revise", new_digest=new_digest, provenance=revision_entry["provenance"])
        write_spec(spec_path, spec)
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(
        json.dumps(
            {
                "ok": True,
                "spec_id": spec.get("spec_id"),
                "state": DRAFT_SPEC,
                "prior_digest": revision_entry["prior_digest"],
                "digest": new_digest,
                "revision": spec["revision"],
            },
            indent=2,
        )
    )
    return 0


# --- expire-check ----------------------------------------------------------------


def cmd_expire_check(args: argparse.Namespace) -> int:
    """Simulates convoy lifecycle without wiring a real convoy: while the
    convoy is open the artifact must stay recoverable regardless of its
    state; only after closure may it become expire-eligible. Durable truth
    never lives here -- it belongs in code, tests, the glossary and
    qualifying ADRs."""
    spec_path = Path(args.spec)
    try:
        spec = load_spec(spec_path)
        convoy_status = required_string(args.convoy_status, "--convoy-status")
        if convoy_status not in ("open", "closed"):
            raise SpecApproveError(f"--convoy-status must be 'open' or 'closed', got {convoy_status!r}")
        convoy_closed = convoy_status == "closed"
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(
        json.dumps(
            {
                "ok": True,
                "spec_id": spec.get("spec_id"),
                "state": spec.get("state"),
                "recoverable": not convoy_closed,
                "expire_eligible": convoy_closed,
                "durable_truth_lives_here": False,
            },
            indent=2,
        )
    )
    return 0


# --- bd-approve / bd-status (A6b, W04: live Beads-backed Spec mode) ------


def repo_root_default() -> Path:
    return Path(__file__).resolve().parents[1]


def tool_path(env_var: str, name: str) -> str:
    override = os.environ.get(env_var)
    if override:
        return override
    return str(Path(__file__).resolve().parent / name)


def run_bd(args: list[str]) -> str:
    try:
        proc = subprocess.run([BD_BIN, *args], capture_output=True, text=True)
    except OSError as exc:
        raise SpecApproveError(f"could not run {BD_BIN}: {exc}") from exc
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise SpecApproveError(f"bd {' '.join(args)} failed: {detail}")
    return proc.stdout


def bd_show(issue_id: str) -> dict[str, Any]:
    out = run_bd(["show", issue_id, "--json"])
    try:
        data = json.loads(out)
    except json.JSONDecodeError as exc:
        raise SpecApproveError(f"bd show {issue_id} returned invalid JSON: {exc}") from exc
    if isinstance(data, list):
        if not data:
            raise SpecApproveError(f"issue not found: {issue_id}")
        data = data[0]
    if not isinstance(data, dict):
        raise SpecApproveError(f"bd show {issue_id} returned an unexpected shape")
    return data


def canonical_bead_digest(description: str) -> str:
    """Identical digest formula to the one live approvals were recorded
    with before this tool existed (af-3s8prq): sha256 of the raw
    description text, so approving through this tool never changes a
    digest that already lives on an approved Spec bead."""
    return "sha256:" + hashlib.sha256(description.encode("utf-8")).hexdigest()


def run_subtool(argv: list[str]) -> dict[str, Any]:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, env=os.environ.copy())
    except OSError as exc:
        raise SpecApproveError(f"could not run {argv[0]}: {exc}") from exc
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        detail = proc.stderr.strip() or proc.stdout.strip()
        raise SpecApproveError(f"{' '.join(argv)} returned invalid JSON: {detail or exc}") from exc
    if proc.returncode != 0 or not payload.get("ok", False):
        raise SpecApproveError(payload.get("error", f"{' '.join(argv)} failed"))
    return payload


def reservation_check(target: str | None, repo_root: Path, reservation_bin: str) -> dict[str, Any]:
    argv = [reservation_bin, "--repo-root", str(repo_root), "check"]
    if target:
        argv += ["--target", target]
    return run_subtool(argv)


def map_check(map_id: str, map_bin: str) -> dict[str, Any]:
    return run_subtool([map_bin, "check", "--map", map_id])


def map_close(map_id: str, reason: str, map_bin: str) -> dict[str, Any]:
    return run_subtool([map_bin, "close", "--map", map_id, "--reason", reason])


def declared_human_approver(project: str, config_dir: Path, profile_bin: str) -> str:
    return run_subtool(
        [profile_bin, "human-approver", "--project", project, "--config-dir", str(config_dir)]
    )["human_approver"]


def cmd_bd_approve(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo_root)
    config_dir = Path(args.config_dir) if args.config_dir else repo_root / "config" / "projects"
    map_bin = tool_path("PLANNING_MAP_BIN", "planning-map")
    reservation_bin = tool_path("PLANNING_RUN_RESERVATION_BIN", "planning-run-reservation")
    profile_bin = tool_path("PROJECT_PLANNING_PROFILE_BIN", "project-planning-profile")

    try:
        spec_bead = bd_show(args.spec)
        metadata = spec_bead.get("metadata") or {}
        if metadata.get("spec_state") == APPROVED_SPEC:
            raise SpecApproveError(
                f"cannot approve state={APPROVED_SPEC!r}: only a DRAFT_SPEC can be approved -- an "
                "APPROVED_SPEC is already approved once and approval never creates a duplicate approved document"
            )

        target = metadata.get("planning_run_target")
        reservation = reservation_check(target, repo_root, reservation_bin)
        if not reservation.get("allowed", False):
            raise SpecApproveError(
                "refused: " + reservation.get(
                    "reason",
                    f"the Spec's planning_run_target {target!r} is not the active Planning Run Reservation",
                )
            )

        planning_map = metadata.get("planning_map")
        if planning_map not in NO_MAP_VALUES:
            check = map_check(planning_map, map_bin)
            if not check.get("finished", False):
                raise SpecApproveError(
                    f"refused: map {planning_map} is not finished (open_children={check.get('open_children')}, "
                    f"malformed={check.get('malformed')}, labelled_map={check.get('labelled_map')})"
                )
        else:
            planning_map = None
            no_fog_evidence = metadata.get("no_fog_evidence")
            if not (isinstance(no_fog_evidence, str) and no_fog_evidence.strip()):
                raise SpecApproveError(
                    "refused: the Spec names no map and carries no No-fog exit evidence"
                )

        human_approver = declared_human_approver(args.project, config_dir, profile_bin)
        approved_by = required_string(args.approved_by, "--approved-by")
        if approved_by != human_approver:
            raise SpecApproveError(
                f"refused: --approved-by {approved_by!r} is not the project's declared human "
                f"approver {human_approver!r}"
            )
        evidence = required_string(args.evidence, "--evidence")

        digest = canonical_bead_digest(spec_bead.get("description") or "")

        run_bd([
            "update", args.spec,
            "--set-metadata", "spec_state=" + APPROVED_SPEC,
            "--set-metadata", f"approved_by={approved_by}",
            "--set-metadata", f"approved_evidence={evidence}",
            "--set-metadata", f"approved_digest={digest}",
        ])

        map_closed = False
        if planning_map is not None:
            map_close(planning_map, f"Spec approved by {approved_by}: {args.spec}", map_bin)
            map_closed = True
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(
        json.dumps(
            {
                "ok": True,
                "spec": args.spec,
                "state": APPROVED_SPEC,
                "digest": digest,
                "approved_by": approved_by,
                "map": planning_map,
                "map_closed": map_closed,
            },
            indent=2, sort_keys=True,
        )
    )
    return 0


def cmd_bd_status(args: argparse.Namespace) -> int:
    try:
        spec_bead = bd_show(args.spec)
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1

    metadata = spec_bead.get("metadata") or {}
    state = metadata.get("spec_state", DRAFT_SPEC)
    actual_digest = canonical_bead_digest(spec_bead.get("description") or "")
    approved_digest = metadata.get("approved_digest")
    void = state == APPROVED_SPEC and approved_digest is not None and approved_digest != actual_digest

    print(
        json.dumps(
            {
                "ok": True,
                "spec": args.spec,
                "state": state,
                "content_digest": actual_digest,
                "approved_by": metadata.get("approved_by"),
                "approved_evidence": metadata.get("approved_evidence"),
                "approved_digest": approved_digest,
                "planning_map": metadata.get("planning_map"),
                "planning_run_target": metadata.get("planning_run_target"),
                "void": void,
            },
            indent=2, sort_keys=True,
        )
    )
    return 0


# --- status ----------------------------------------------------------------------


def cmd_status(args: argparse.Namespace) -> int:
    try:
        spec = load_spec(Path(args.spec))
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(
        json.dumps(
            {
                "ok": True,
                "spec_id": spec.get("spec_id"),
                "state": spec.get("state"),
                "content_digest": spec.get("content_digest"),
                "approved_by": spec.get("approved_by"),
                "revision": spec.get("revision", 0),
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0


# --- CLI ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    approve = subparsers.add_parser("approve", help="approve a DRAFT_SPEC by exact digest and close its map")
    approve.add_argument("spec", help="path to the Spec JSON file")
    approve.add_argument("--approved-by", required=True)
    approve.add_argument("--evidence", required=True)
    approve.add_argument("--map", help="path to the Planning Map JSON file to close on approval")
    approve.set_defaults(func=cmd_approve)

    freeze_check = subparsers.add_parser(
        "freeze-check", help="optional integrity check: detect and localize drift on a frozen artifact"
    )
    freeze_check.add_argument("spec", help="path to the Spec JSON file")
    freeze_check.add_argument("--expected-digest", help="the digest the caller expects this artifact to carry")
    freeze_check.set_defaults(func=cmd_freeze_check)

    revise = subparsers.add_parser(
        "revise", help="create an explicit new revision of a frozen artifact with provenance"
    )
    revise.add_argument("spec", help="path to the Spec JSON file")
    revise.add_argument("--expected-current-digest", required=True)
    revise.add_argument("--new-sections", required=True, help="path to a JSON file with the new sections object")
    revise.add_argument("--revised-by", required=True)
    revise.add_argument("--provenance", required=True)
    revise.set_defaults(func=cmd_revise)

    expire_check = subparsers.add_parser(
        "expire-check", help="report recoverability and expiry eligibility against a convoy status"
    )
    expire_check.add_argument("spec", help="path to the Spec JSON file")
    expire_check.add_argument("--convoy-status", required=True, choices=("open", "closed"))
    expire_check.set_defaults(func=cmd_expire_check)

    status = subparsers.add_parser("status", help="report the Spec's state, digest and approval")
    status.add_argument("spec", help="path to the Spec JSON file")
    status.set_defaults(func=cmd_status)

    bd_approve = subparsers.add_parser(
        "bd-approve", help="approve a planning-plane Spec bead by id, with or without a map"
    )
    bd_approve.add_argument("--spec", required=True, help="Spec bead id")
    bd_approve.add_argument("--approved-by", required=True)
    bd_approve.add_argument("--evidence", required=True)
    bd_approve.add_argument(
        "--project", required=True, help="project id whose config/projects/<id>.toml declares the human approver"
    )
    bd_approve.add_argument(
        "--repo-root", default=str(repo_root_default()), help="repository root config/projects and the reservation live under"
    )
    bd_approve.add_argument(
        "--config-dir", default=None, help="directory holding config/projects/*.toml files (default: <repo-root>/config/projects)"
    )
    bd_approve.set_defaults(func=cmd_bd_approve)

    bd_status = subparsers.add_parser(
        "bd-status", help="report a Spec bead's state, digest, approval and whether it is void"
    )
    bd_status.add_argument("--spec", required=True, help="Spec bead id")
    bd_status.set_defaults(func=cmd_bd_status)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
