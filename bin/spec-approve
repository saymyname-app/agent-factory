#!/usr/bin/env python3
"""Approve a planning-plane Spec bead by exact digest (B05; A6b, W04/W10).

`bd-approve` and `bd-status` are the live Beads-backed mode (A6b, W04): a
Spec is a planning-plane Beads bead published by `/to-spec`, not a JSON
file, and its Planning Map (if any) is a Beads bead too. `bd-approve` reads
the Spec bead by id, refuses unless the Spec's `planning_run_target` equals
the active Planning Run Reservation (`bin/planning-run-reservation`), its
named map is finished (`bin/planning-map check`) or it names no map and
carries non-empty No-fog exit evidence, and `--approved-by` is the project's
declared human approver (`bin/project-planning-profile human-approver`).
On success it records the approval, approver, evidence and digest of the
Spec's current content as bead metadata, then closes the map. `bd-status`
reports whether a later edit to the Spec's description has voided the
approval -- its content digest no longer matches the one recorded at
approval.

`bd-approve` also holds the Spec's side of the delivery entry contract
(T07, af-tvda3w; spec af-wf4w5r sections 2 and 3): last, before any write,
it refuses a Spec without numbered user stories, a Spec with an interface
story but no complete Validated Prototype reference (branch, commit, path,
states) or no state inventory, a reference whose commit is not on the
remote repository, and a Validated Prototype that
`bin/prototype-conformance` reports as not conformant -- its reference
included (T46, af-lb9zkz): a branch that is not a `prototype/` branch, or a
commit reachable from the project's protected branch on the remote. A Spec with no
interface story is approved without a reference; an already approved Spec
is never re-examined, unless its text changed since: an amended Spec is
approved again by `bd-approve`, held to the same checks (T52, af-ezqgma).

`outline` reads a Spec text on stdin and prints, with that same reader, what
the publication door poses in each ticket (T06, af-cgauf8): the numbered
user stories and the Testing Decisions; and (T36, af-2nmcxw) which stories
describe an interface and the reference of the Validated Prototype, as
written -- the remote repository is not read; and (T27, af-r43we4) the
inventory of the states of each screen (`screens`), as written, for the
Evidence Pack. It reads no bead and writes nothing.

The file-Spec mode (`approve`/`freeze-check`/`revise`/`expire-check`/
`status` over a JSON Spec artifact carrying the
`agent-factory-planning-run-spec/v1` contract) served only the now-retired
Planning Run router and was retired with it (A6b, W10): this tool is
bead-mode only.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import io
import os
import re
import subprocess
import sys
import tarfile
import tempfile
import tomllib
import unicodedata
from pathlib import Path
from typing import Any


PROGRAM = "spec-approve"

DRAFT_SPEC = "DRAFT_SPEC"
APPROVED_SPEC = "APPROVED_SPEC"

# Gas City 1.5 gives an order BD_BIN set and empty: an empty value is no
# override (af-d130xt).
BD_BIN = os.environ.get("BD_BIN") or "bd"
NO_MAP_VALUES = (None, "", "none")
PROJECT_METADATA_KEY = "gc.project_id"


class SpecApproveError(RuntimeError):
    """An actionable diagnostic about a Planning Artifact approval."""


def as_dict(value: Any, name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise SpecApproveError(f"{name} must be an object")
    return value


def required_string(value: Any, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise SpecApproveError(f"{name} must be a non-empty string")
    return value


# --- bd-approve / bd-status (A6b, W04: live Beads-backed Spec mode) ------


def repo_root_default() -> Path:
    return Path(__file__).resolve().parents[1]


def tool_path(env_var: str, name: str) -> str:
    override = os.environ.get(env_var)
    if override:
        return override
    return str(Path(__file__).resolve().parent / name)


def run_bd(args: list[str]) -> str:
    try:
        proc = subprocess.run([BD_BIN, *args], capture_output=True, text=True)
    except OSError as exc:
        raise SpecApproveError(f"could not run {BD_BIN}: {exc}") from exc
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise SpecApproveError(f"bd {' '.join(args)} failed: {detail}")
    return proc.stdout


def bd_show(issue_id: str) -> dict[str, Any]:
    out = run_bd(["show", issue_id, "--json"])
    try:
        data = json.loads(out)
    except json.JSONDecodeError as exc:
        raise SpecApproveError(f"bd show {issue_id} returned invalid JSON: {exc}") from exc
    if isinstance(data, list):
        if not data:
            raise SpecApproveError(f"issue not found: {issue_id}")
        data = data[0]
    if not isinstance(data, dict):
        raise SpecApproveError(f"bd show {issue_id} returned an unexpected shape")
    return data


def canonical_bead_digest(description: str) -> str:
    """Identical digest formula to the one live approvals were recorded
    with before this tool existed (af-3s8prq): sha256 of the raw
    description text, so approving through this tool never changes a
    digest that already lives on an approved Spec bead."""
    return "sha256:" + hashlib.sha256(description.encode("utf-8")).hexdigest()


def run_subtool(argv: list[str]) -> dict[str, Any]:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, env=os.environ.copy())
    except OSError as exc:
        raise SpecApproveError(f"could not run {argv[0]}: {exc}") from exc
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        detail = proc.stderr.strip() or proc.stdout.strip()
        raise SpecApproveError(f"{' '.join(argv)} returned invalid JSON: {detail or exc}") from exc
    if proc.returncode != 0 or not payload.get("ok", False):
        raise SpecApproveError(payload.get("error", f"{' '.join(argv)} failed"))
    return payload


def reservation_check(target: str | None, repo_root: Path, reservation_bin: str) -> dict[str, Any]:
    argv = [reservation_bin, "--repo-root", str(repo_root), "check"]
    if target:
        argv += ["--target", target]
    return run_subtool(argv)


def map_check(map_id: str, map_bin: str) -> dict[str, Any]:
    return run_subtool([map_bin, "check", "--map", map_id])


def map_close(map_id: str, reason: str, map_bin: str) -> dict[str, Any]:
    return run_subtool([map_bin, "close", "--map", map_id, "--reason", reason])


def declared_human_approver(project: str, config_dir: Path, profile_bin: str) -> str:
    return run_subtool(
        [profile_bin, "human-approver", "--project", project, "--config-dir", str(config_dir)]
    )["human_approver"]


# --- entry contract: numbered user stories and Validated Prototype (T07) ----------

HEADING = re.compile(r"^(#{1,6})\s+(.*?)\s*#*\s*$")
NUMBERED_STORY = re.compile(r"^\s*(\d+)[.)]\s+(\S.*)$")
INTERFACE_TAG = "[interface]"
REFERENCE_LINE = re.compile(r"^\s*[-*]\s*([^:|]+?)\s*:\s*(.*?)\s*$")
SCREEN_HEADING = re.compile(r"^(?:ecran|screen)\s*:\s*(\S.*)$")
COMMIT_ID = re.compile(r"^[0-9a-f]{40}$")
REFERENCE_FIELDS = {
    "branche": "branche", "branch": "branche",
    "commit": "commit",
    "chemin": "chemin", "path": "chemin",
    "etats": "états", "states": "états",
}
CONTROL_STATES = ("vide", "chargement", "erreur", "contenu long", "écran étroit", "thème sombre")
PROTOTYPED, NOT_PROTOTYPED, NOT_APPLICABLE = "prototype", "non prototype", "sans objet"


def fold(text: str) -> str:
    """Case-, accent- and spacing-insensitive form of a Spec label."""
    plain = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode("ascii")
    return " ".join(plain.lower().replace("`", " ").replace("*", " ").split())


def bare(value: str) -> str:
    return value.strip().strip("`").strip()


def sections(description: str) -> list[tuple[int, str, list[str]]]:
    """The Spec's headings in order, each with the lines up to the next
    heading of any level."""
    found: list[tuple[int, str, list[str]]] = []
    fenced = False
    for line in description.splitlines():
        if line.lstrip().startswith("```"):
            fenced = not fenced
        heading = None if fenced else HEADING.match(line)
        if heading:
            found.append((len(heading.group(1)), heading.group(2), []))
        elif found:
            found[-1][2].append(line)
    return found


def subtree(found: list[tuple[int, str, list[str]]], title: str) -> list[tuple[int, str, list[str]]] | None:
    """The section titled `title` with every deeper section under it."""
    for index, (level, heading, _) in enumerate(found):
        if fold(heading) == title:
            end = index + 1
            while end < len(found) and found[end][0] > level:
                end += 1
            return found[index:end]
    return None


PROTOTYPE_TITLE = "validated prototype"


def prototype_sections(found: list[tuple[int, str, list[str]]]) -> list[list[tuple[int, str, list[str]]]]:
    """One subtree per Validated Prototype the Spec names (T46, af-lb9zkz):
    the section titled « Validated Prototype », and each one titled
    « Validated Prototype : <name> » when the Spec names several."""
    found_sections, index = [], 0
    while index < len(found):
        level, heading, _ = found[index]
        title = fold(heading)
        end = index + 1
        if title == PROTOTYPE_TITLE or title.startswith((PROTOTYPE_TITLE + " :", PROTOTYPE_TITLE + ":")):
            while end < len(found) and found[end][0] > level:
                end += 1
            found_sections.append(found[index:end])
        index = end
    return found_sections


def prototype_references(sections_found: list[list[tuple[int, str, list[str]]]]) -> list[dict[str, Any]]:
    """The reference of each section; a path names one Validated Prototype."""
    references = [prototype_reference(section) for section in sections_found]
    paths = [reference["path"] for reference in references]
    repeated = sorted({path for path in paths if paths.count(path) > 1})
    if repeated:
        raise SpecApproveError(
            "refus : plusieurs références de Validated Prototype nomment le même chemin ("
            + ", ".join(repeated) + ") ; chaque Validated Prototype a son chemin"
        )
    return references


def numbered_user_stories(found: list[tuple[int, str, list[str]]]) -> list[tuple[str, str]]:
    stories_section = subtree(found, "user stories")
    stories = [
        (match.group(1), match.group(2))
        for _, _, lines in (stories_section or [])
        for match in map(NUMBERED_STORY.match, lines) if match
    ]
    if not stories:
        raise SpecApproveError(
            "refus : la Spec n'a pas de user stories numérotées (une section « User Stories » dont chaque "
            "story commence par son numéro, « 1. As a … ») ; sans elles le graphe ne peut pas prouver sa couverture"
        )
    numbers = [number for number, _ in stories]
    repeated = sorted({number for number in numbers if numbers.count(number) > 1}, key=int)
    if repeated:
        raise SpecApproveError(
            "refus : la Spec n'a pas de user stories numérotées sans ambiguïté : le numéro "
            + ", ".join(repeated) + " est porté par plusieurs stories"
        )
    return stories


def prototype_reference(section: list[tuple[int, str, list[str]]]) -> dict[str, Any]:
    fields: dict[str, str] = {}
    for line in section[0][2]:
        match = REFERENCE_LINE.match(line)
        if match and fold(match.group(1)) in REFERENCE_FIELDS and bare(match.group(2)):
            fields.setdefault(REFERENCE_FIELDS[fold(match.group(1))], match.group(2))
    missing = [name for name in ("branche", "commit", "chemin", "états") if name not in fields]
    if missing:
        raise SpecApproveError(
            "refus : la référence du Validated Prototype est incomplète, il manque : " + ", ".join(missing)
            + " (attendu sous « Validated Prototype » : branche, commit, chemin, états)"
        )
    commit = bare(fields["commit"])
    if not COMMIT_ID.fullmatch(commit):
        raise SpecApproveError(
            f"refus : la référence du Validated Prototype nomme le commit {commit!r}, "
            "qui n'est pas un identifiant complet de 40 caractères hexadécimaux"
        )
    states = [bare(state) for state in fields["états"].split(",") if bare(state)]
    return {"branch": bare(fields["branche"]), "commit": commit, "path": bare(fields["chemin"]).strip("/"), "states": states}


def check_state_inventory(section: list[tuple[int, str, list[str]]], reference_states: list[str]) -> None:
    """Every screen lists its states, each `prototypé` (naming a state of
    the reference) or `non prototypé`; the six control states are each
    present, or `sans objet` with a reason."""
    problems: list[str] = []
    screens = [
        (match.group(1), lines)
        for _, heading, lines in section[1:]
        for match in [SCREEN_HEADING.match(fold(heading))] if match
    ]
    if not screens:
        raise SpecApproveError(
            "refus : l'inventaire des états manque : sous « Validated Prototype », chaque écran "
            "(« Écran : <nom> ») liste ses états dans un tableau « État | Statut | Détail »"
        )
    prototyped: set[str] = set()
    for screen, lines in screens:
        listed: set[str] = set()
        for line in lines:
            cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
            if not line.strip().startswith("|") or len(cells) < 2:
                continue
            state, status = fold(cells[0]), fold(cells[1])
            detail = bare(cells[2]) if len(cells) > 2 else ""
            if not state or set(cells[0]) <= set("-: ") or state in ("etat", "state"):
                continue
            listed.add(state)
            name = cells[0].strip()
            if status == PROTOTYPED:
                if not detail:
                    problems.append(f"écran {screen} : l'état « {name} » est prototypé sans nommer l'état du prototype")
                elif detail not in reference_states:
                    problems.append(
                        f"écran {screen} : l'état « {name} » renvoie à « {detail} », absent des états de la référence"
                    )
                else:
                    prototyped.add(detail)
            elif status == NOT_APPLICABLE:
                if state not in map(fold, CONTROL_STATES):
                    problems.append(f"écran {screen} : « sans objet » ne vaut que pour un état de contrôle, pas « {name} »")
                elif not detail:
                    problems.append(f"écran {screen} : l'état « {name} » est « sans objet » sans raison")
            elif status != NOT_PROTOTYPED:
                problems.append(
                    f"écran {screen} : l'état « {name} » n'est ni « prototypé » ni « non prototypé » ({cells[1] or 'vide'})"
                )
        for control in CONTROL_STATES:
            if fold(control) not in listed:
                problems.append(f"écran {screen} : l'état de contrôle « {control} » manque (présent, ou « sans objet » avec raison)")
    for state in reference_states:
        if state not in prototyped:
            problems.append(f"l'état « {state} » de la référence n'est prototypé dans aucun écran")
    if problems:
        raise SpecApproveError("refus : l'inventaire des états est incomplet : " + " ; ".join(problems))


STATUS_LABELS = {PROTOTYPED: "prototypé", NOT_PROTOTYPED: "non prototypé", NOT_APPLICABLE: "sans objet"}


def screen_states(section: list[tuple[int, str, list[str]]]) -> list[dict[str, Any]]:
    """The inventory as the Spec writes it, for a reader that lists it (the
    Evidence Pack, Spec §10): per screen, each state with its status and its
    detail. A status outside the three is given as written."""
    screens = []
    for _, heading, lines in section[1:]:
        match = SCREEN_HEADING.match(fold(heading))
        if not match:
            continue
        states = []
        for line in lines:
            cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
            if not line.strip().startswith("|") or len(cells) < 2:
                continue
            if not fold(cells[0]) or set(cells[0]) <= set("-: ") or fold(cells[0]) in ("etat", "state"):
                continue
            states.append({"name": cells[0], "status": STATUS_LABELS.get(fold(cells[1]), cells[1]),
                           "detail": bare(cells[2]) if len(cells) > 2 else ""})
        screens.append({"name": match.group(1), "states": states})
    return screens


def run_git(args: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess[bytes]:
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    try:
        return subprocess.run(["git", *args], cwd=cwd, env=env, capture_output=True)
    except OSError as exc:
        raise SpecApproveError(f"could not run git: {exc}") from exc


def prototype_remote(explicit: str | None, repo_root: Path) -> str:
    if explicit:
        return explicit
    proc = run_git(["-C", str(repo_root), "remote", "get-url", "origin"])
    remote = proc.stdout.decode("utf-8", "replace").strip()
    if proc.returncode != 0 or not remote:
        raise SpecApproveError(
            f"refus : aucun dépôt distant où lire le Validated Prototype : {repo_root} n'a pas de remote "
            "« origin » ; nommer le dépôt du projet avec --prototype-remote"
        )
    return remote


DEFAULT_PROTECTED_BRANCH = "main"
REMOTE_HEAD = re.compile(r"^ref: refs/heads/(\S+)\s+HEAD$", re.MULTILINE)


def protected_branch(project: str, config_dir: Path, remote: str) -> str:
    """The branch a Validated Prototype must never have been merged into:
    the one the project declares, else the remote's default branch."""
    try:
        declared = tomllib.loads((config_dir / f"{project}.toml").read_text(encoding="utf-8")).get("protected_branch")
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        declared = None
    if isinstance(declared, str) and declared.strip():
        return declared.strip()
    head = REMOTE_HEAD.search(run_git(["ls-remote", "--symref", remote, "HEAD"]).stdout.decode("utf-8", "replace"))
    return head.group(1) if head else DEFAULT_PROTECTED_BRANCH


def check_validated_prototype(
    reference: dict[str, Any], remote: str, repo_root: Path, conformance_bin: str, protected: str,
) -> None:
    """Read the referenced commit from the remote repository only (a commit
    that exists just locally does not count) and check the prototype there,
    its branch included: a prototype branch, never merged into `protected`."""
    branch, commit, path = reference["branch"], reference["commit"], reference["path"]
    with tempfile.TemporaryDirectory(prefix="spec-approve-prototype-") as tmp:
        clone = Path(tmp) / "remote.git"
        clone_args = ["clone", "--quiet", "--bare", "--single-branch", "--branch", branch]
        if (repo_root / ".git").is_dir():
            clone_args += ["--reference-if-able", str(repo_root)]
        if run_git([*clone_args, remote, str(clone)]).returncode != 0:
            raise SpecApproveError(
                f"refus : la branche {branch} de la référence du Validated Prototype est introuvable "
                f"sur le dépôt distant {remote}"
            )
        if run_git(["merge-base", "--is-ancestor", commit, f"refs/heads/{branch}"], cwd=clone).returncode != 0:
            raise SpecApproveError(
                f"refus : le commit {commit} de la référence du Validated Prototype n'existe pas sur la "
                f"branche {branch} du dépôt distant {remote}"
            )
        archive = run_git(["archive", "--format=tar", commit, "--", path], cwd=clone)
        if archive.returncode != 0:
            raise SpecApproveError(
                f"refus : le chemin {path} de la référence du Validated Prototype n'existe pas au commit {commit}"
            )
        # The protected branch as the remote holds it; one it does not hold has merged nothing.
        run_git(["fetch", "--quiet", remote, f"+refs/heads/{protected}:refs/heads/{protected}"], cwd=clone)
        tree = Path(tmp) / "tree"
        with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as tar:
            tar.extractall(tree, filter="data")
        proc = subprocess.run(
            [
                conformance_bin, "check", "--prototype", str(tree / path), "--states", ",".join(reference["states"]),
                "--branch", branch, "--commit", commit, "--remote", str(clone), "--protected", protected,
            ],
            capture_output=True, text=True,
        )
        try:
            report = json.loads(proc.stdout)
        except json.JSONDecodeError as exc:
            raise SpecApproveError(f"{conformance_bin} returned invalid JSON: {proc.stderr.strip() or exc}") from exc
        if proc.returncode == 0 and report.get("ok"):
            return
        failures = [
            f"{record['property']} : {failure}"
            for record in report.get("properties", []) if not record.get("ok")
            for failure in record.get("failures", [])
        ] or [report.get("error", "contrôle de conformité en échec")]
        raise SpecApproveError(
            f"refus : le Validated Prototype ({branch} @ {commit}, {path}) est non conforme : " + " ; ".join(failures)
        )


def check_entry_contract(
    description: str, explicit_remote: str | None, repo_root: Path, conformance_bin: str, project: str, config_dir: Path,
) -> None:
    found = sections(description)
    stories = numbered_user_stories(found)
    interface_stories = [number for number, text in stories if INTERFACE_TAG in text.lower()]
    prototypes = prototype_sections(found)
    if not prototypes:
        if interface_stories:
            raise SpecApproveError(
                "refus : la référence du Validated Prototype manque (branche, commit, chemin, états) alors que "
                "la Spec décrit une interface : user stories " + ", ".join(interface_stories)
            )
        return
    references = prototype_references(prototypes)
    for section, reference in zip(prototypes, references):
        check_state_inventory(section, reference["states"])
    remote = prototype_remote(explicit_remote, repo_root)
    protected = protected_branch(project, config_dir, remote)
    for reference in references:
        check_validated_prototype(reference, remote, repo_root, conformance_bin, protected)


def cmd_bd_approve(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo_root)
    config_dir = Path(args.config_dir) if args.config_dir else repo_root / "config" / "projects"
    map_bin = tool_path("PLANNING_MAP_BIN", "planning-map")
    reservation_bin = tool_path("PLANNING_RUN_RESERVATION_BIN", "planning-run-reservation")
    profile_bin = tool_path("PROJECT_PLANNING_PROFILE_BIN", "project-planning-profile")
    conformance_bin = tool_path("PROTOTYPE_CONFORMANCE_BIN", "prototype-conformance")

    try:
        spec_bead = bd_show(args.spec)
        metadata = spec_bead.get("metadata") or {}
        # An amended Spec -- approved, its text changed since (`void` in
        # bd-status) -- is approved again, on fresh evidence and held to
        # every check below (T52, af-ezqgma; Spec af-wf4w5r section 11).
        amended = metadata.get("spec_state") == APPROVED_SPEC and metadata.get("approved_digest") \
            != canonical_bead_digest(spec_bead.get("description") or "")
        if metadata.get("spec_state") == APPROVED_SPEC and not amended:
            raise SpecApproveError(
                f"cannot approve state={APPROVED_SPEC!r}: only a DRAFT_SPEC, or an APPROVED_SPEC amended since "
                "its approval, can be approved -- this APPROVED_SPEC is already approved, its text unchanged, and "
                "approval never creates a duplicate approved document"
            )

        target = metadata.get("planning_run_target")
        reservation = reservation_check(target, repo_root, reservation_bin)
        if not reservation.get("allowed", False):
            raise SpecApproveError(
                "refused: " + reservation.get(
                    "reason",
                    f"the Spec's planning_run_target {target!r} is not the active Planning Run Reservation",
                )
            )

        planning_map = metadata.get("planning_map")
        project_id = None
        if planning_map not in NO_MAP_VALUES:
            check = map_check(planning_map, map_bin)
            if not check.get("finished", False):
                raise SpecApproveError(
                    f"refused: map {planning_map} is not finished (open_children={check.get('open_children')}, "
                    f"malformed={check.get('malformed')}, labelled_map={check.get('labelled_map')})"
                )
            map_bead = bd_show(planning_map)
            project_id = (map_bead.get("metadata") or {}).get(PROJECT_METADATA_KEY)
            spec_project_id = metadata.get(PROJECT_METADATA_KEY)
            if project_id and spec_project_id and spec_project_id != project_id:
                raise SpecApproveError(
                    f"refused: Spec's project key {spec_project_id!r} contradicts its map "
                    f"{planning_map}'s project key {project_id!r}"
                )
        else:
            planning_map = None
            no_fog_evidence = metadata.get("no_fog_evidence")
            if not (isinstance(no_fog_evidence, str) and no_fog_evidence.strip()):
                raise SpecApproveError(
                    "refused: the Spec names no map and carries no No-fog exit evidence"
                )

        human_approver = declared_human_approver(args.project, config_dir, profile_bin)
        approved_by = required_string(args.approved_by, "--approved-by")
        if approved_by != human_approver:
            raise SpecApproveError(
                f"refused: --approved-by {approved_by!r} is not the project's declared human "
                f"approver {human_approver!r}"
            )
        evidence = required_string(args.evidence, "--evidence")

        check_entry_contract(
            spec_bead.get("description") or "", args.prototype_remote, repo_root, conformance_bin,
            args.project, config_dir,
        )

        digest = canonical_bead_digest(spec_bead.get("description") or "")

        update_args = [
            "update", args.spec,
            "--set-metadata", "spec_state=" + APPROVED_SPEC,
            "--set-metadata", f"approved_by={approved_by}",
            "--set-metadata", f"approved_evidence={evidence}",
            "--set-metadata", f"approved_digest={digest}",
        ]
        if project_id and metadata.get(PROJECT_METADATA_KEY) != project_id:
            update_args += ["--set-metadata", f"{PROJECT_METADATA_KEY}={project_id}"]
        run_bd(update_args)

        map_closed = False
        # The map of an amended Spec was closed by its first approval.
        if planning_map is not None and not amended:
            map_close(planning_map, f"Spec approved by {approved_by}: {args.spec}", map_bin)
            map_closed = True
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2, ensure_ascii=False))
        return 1
    print(
        json.dumps(
            {
                "ok": True,
                "spec": args.spec,
                "state": APPROVED_SPEC,
                "digest": digest,
                "approved_by": approved_by,
                "map": planning_map,
                "map_closed": map_closed,
                "amended": amended,
            },
            indent=2, sort_keys=True,
        )
    )
    return 0


def cmd_bd_status(args: argparse.Namespace) -> int:
    try:
        spec_bead = bd_show(args.spec)
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1

    metadata = spec_bead.get("metadata") or {}
    state = metadata.get("spec_state", DRAFT_SPEC)
    actual_digest = canonical_bead_digest(spec_bead.get("description") or "")
    approved_digest = metadata.get("approved_digest")
    void = state == APPROVED_SPEC and approved_digest is not None and approved_digest != actual_digest

    print(
        json.dumps(
            {
                "ok": True,
                "spec": args.spec,
                "state": state,
                "content_digest": actual_digest,
                "approved_by": metadata.get("approved_by"),
                "approved_evidence": metadata.get("approved_evidence"),
                "approved_digest": approved_digest,
                "planning_map": metadata.get("planning_map"),
                "planning_run_target": metadata.get("planning_run_target"),
                "void": void,
            },
            indent=2, sort_keys=True,
        )
    )
    return 0


def testing_decisions(found: list[tuple[int, str, list[str]]]) -> list[str]:
    """The seams the Spec agreed on: the numbered items of its « Testing
    Decisions » section, or its lines when none is numbered."""
    lines = [line.strip() for _, _, body in (subtree(found, "testing decisions") or []) for line in body]
    numbered = [line for line in lines if NUMBERED_STORY.match(line)]
    return numbered or [line for line in lines if line]


def cmd_outline(args: argparse.Namespace) -> int:
    found = sections(sys.stdin.read())
    try:
        stories = numbered_user_stories(found)
    except SpecApproveError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2, ensure_ascii=False))
        return 1
    # The reference as the Spec writes it; what an incomplete one misses is
    # said, not raised: only a graph with interface tickets needs it.
    references, problem = [], None
    prototypes = prototype_sections(found)
    try:
        references = prototype_references(prototypes)
    except SpecApproveError as exc:
        problem = str(exc)
    screens = [screen for section in prototypes for screen in screen_states(section)]
    print(json.dumps({
        "ok": True,
        "user_stories": [
            {"number": number, "text": text.strip(), "interface": INTERFACE_TAG in text.lower()}
            for number, text in stories
        ],
        "testing_decisions": testing_decisions(found),
        # The first one, for a reader that knows one; every one, in the Spec's order.
        "validated_prototype": references[0] if references else None,
        "validated_prototypes": references,
        "validated_prototype_problem": problem,
        "screens": screens,
    }, indent=2, ensure_ascii=False))
    return 0


# --- CLI ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    bd_approve = subparsers.add_parser(
        "bd-approve", help="approve a planning-plane Spec bead by id, with or without a map"
    )
    bd_approve.add_argument("--spec", required=True, help="Spec bead id")
    bd_approve.add_argument("--approved-by", required=True)
    bd_approve.add_argument("--evidence", required=True)
    bd_approve.add_argument(
        "--project", required=True, help="project id whose config/projects/<id>.toml declares the human approver"
    )
    bd_approve.add_argument(
        "--repo-root", default=str(repo_root_default()), help="repository root config/projects and the reservation live under"
    )
    bd_approve.add_argument(
        "--config-dir", default=None, help="directory holding config/projects/*.toml files (default: <repo-root>/config/projects)"
    )
    bd_approve.add_argument(
        "--prototype-remote", default=None,
        help="repository the Spec's Validated Prototype branch lives on (default: <repo-root>'s origin remote)",
    )
    bd_approve.set_defaults(func=cmd_bd_approve)

    bd_status = subparsers.add_parser(
        "bd-status", help="report a Spec bead's state, digest, approval and whether it is void"
    )
    bd_status.add_argument("--spec", required=True, help="Spec bead id")
    bd_status.set_defaults(func=cmd_bd_status)

    outline = subparsers.add_parser(
        "outline",
        help="print the numbered user stories, Testing Decisions and Validated Prototype reference of a Spec text read on stdin",
    )
    outline.set_defaults(func=cmd_outline)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
