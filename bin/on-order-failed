#!/usr/bin/env bash
# on-order-failed — event-triggered order: page when the SAME order fails
# repeatedly, instead of leaving actionable order.failed events unread forever.
#
# Gas City ships no retry, no backoff, and no failure notification on its own
# (upstream contract): failed orders are "not retried, not backed off, never
# disabled, and have no notification hook" (Factory audit 2026-09-17,
# finding O1). Live evidence: 371 order.failed events in the last 24h (2026-09-17),
# read by nobody -- most of them one order (dolt-remotes-patrol) failing every
# ~15 minutes for hours. A single failure is often transient and self-heals;
# FAILURE_STREAK failures of the SAME order inside LOOKBACK is not, and gets
# one bead and one page, not a rediscovery each time someone happens to look.
#
# One bead per cause (af-yzo8fo.2). Closing a bead answers the failures seen
# until then: a new one is filed only for FAILURE_STREAK failures after the
# last closing, not for the same failures still inside LOOKBACK (af-2shgd8,
# af-lidzgq then af-od7wiy, 2026-10-12). And a tracker read that fails files
# nothing: read as "no open bead", it filed a duplicate on the saturated
# host (af-yqci4n beside af-giox6p, 2026-10-12).
#
# Observe-and-page only (ADR-0016 section 7): this never retries, disables,
# or fixes the failing order itself. Runs as an exec order (no LLM).
#
# Usage: on-order-failed [--check-only] [--quiet]
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
ESCALATION_DOOR="$(dirname "${BASH_SOURCE[0]}")/escalation-door"
CHECK_ONLY=0
QUIET=0
LOOKBACK="${ON_ORDER_FAILED_LOOKBACK:-3h}"
FAILURE_STREAK="${ON_ORDER_FAILED_STREAK:-5}"

while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) CHECK_ONLY=1 ;;
    --quiet) QUIET=1 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

cd "$ROOT" || { echo "on-order-failed: $ROOT unreachable"; exit 2; }
if ! command -v gc >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  [ "$QUIET" = "1" ] || echo "on-order-failed: gc/jq unavailable, skipping"
  exit 0
fi

say() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }

# failures_after <subject> <iso time>: the order.failed events of that order
# later than that time. Event times carry a local offset and nanoseconds.
failures_after() {
  printf '%s\n' "$EVENTS" | SUBJECT="$1" AFTER="$2" python3 -c '
import json, os, sys
from datetime import datetime
after = datetime.fromisoformat(os.environ["AFTER"])
count = 0
for line in sys.stdin:
    try:
        event = json.loads(line)
        if event.get("subject") == os.environ["SUBJECT"] and datetime.fromisoformat(event["ts"]) > after:
            count += 1
    except (ValueError, KeyError, TypeError):
        continue
print(count)'
}

EVENTS=$(gc events --type order.failed --since "$LOOKBACK" 2>/dev/null) || exit 0
# Exit 75 is the Factory-wide explicit deferral: the command ran, could not
# take host capacity, and must stay non-zero so the order tries again. Gas City
# records every non-zero order result as order.failed; those retries are not an
# incident and must not contribute to the chronic-failure threshold.
EVENTS=$(printf '%s\n' "$EVENTS" | jq -c \
  'select(((.message // "") | startswith("exit status 75:")) | not)') || exit 0
[ -n "$EVENTS" ] || { say "on-order-failed: no actionable order.failed events in $LOOKBACK"; exit 0; }

SUBJECTS=$(printf '%s\n' "$EVENTS" | jq -r 'select(.subject) | .subject' | sort -u)
[ -n "$SUBJECTS" ] || exit 0

PAGED=0
while IFS= read -r subject; do
  [ -n "$subject" ] || continue
  # Total failures inside LOOKBACK, not a consecutive run: successes in between
  # are not visible in this event stream.
  count=$(printf '%s\n' "$EVENTS" | jq --arg s "$subject" -s '[.[] | select(.subject == $s)] | length')
  [ "${count:-0}" -ge "$FAILURE_STREAK" ] || continue
  last_message=$(printf '%s\n' "$EVENTS" | jq -r --arg s "$subject" 'select(.subject == $s) | .message' | tail -1)

  title="[on-order-failed] $subject failing repeatedly"
  existing=$(gc bd list --status open --title-contains "$title" --json 2>/dev/null | jq 'length' 2>/dev/null)
  if [ -z "$existing" ]; then
    say "on-order-failed: could not read the open beads for $subject, nothing filed this run"
    continue
  fi
  if [ "$existing" != "0" ]; then
    say "on-order-failed: $subject already flagged ($count/$LOOKBACK)"
    continue
  fi
  last_closed=$(gc bd list --status closed --limit 0 --title-contains "$title" --json 2>/dev/null \
    | jq -r '[.[].closed_at // empty] | max // "none"' 2>/dev/null)
  if [ -z "$last_closed" ]; then
    say "on-order-failed: could not read the closed beads for $subject, nothing filed this run"
    continue
  fi
  if [ "$last_closed" != "none" ]; then
    count=$(failures_after "$subject" "$last_closed")
    if [ "${count:-0}" -lt "$FAILURE_STREAK" ]; then
      say "on-order-failed: $subject has $count failure(s) since its last bead closed ($last_closed), under $FAILURE_STREAK"
      continue
    fi
  fi
  [ "$CHECK_ONLY" = "1" ] && { say "on-order-failed: would flag $subject ($count/$LOOKBACK)"; continue; }

  created=$(gc bd create "$title" -p 1 -t bug \
    -d "Order '$subject' failed $count times in the last $LOOKBACK (latest: $last_message).

Gas City does not retry, back off, or notify on order failure by itself (upstream contract, engdocs/architecture/orders.md) -- a chronic failure is otherwise silent forever. Diagnose the order's command or config, fix it, then close this bead with the cause." \
    --metadata "$(jq -n --arg subject "$subject" '{"gc.source":"on-order-failed","gc.order_subject":$subject}')" \
    --json 2>/dev/null | jq -r '(.[0]?.id // .id // empty)')
  if [ -z "$created" ]; then
    say "on-order-failed: could not file a bead for $subject"
    continue
  fi
  "$ESCALATION_DOOR" mayor "$created" "on-order-failed: '$subject' failed $count times in the last $LOOKBACK -- $(tr '\n' ' ' <<<"$last_message")" \
    >/dev/null 2>&1
  say "on-order-failed: filed $created and paged mayor for $subject ($count/$LOOKBACK)"
  PAGED=$((PAGED + 1))
done <<<"$SUBJECTS"

[ "$PAGED" -gt 0 ] && say "on-order-failed: flagged $PAGED order(s)"
exit 0
