#!/usr/bin/env bash
# factory-pii-guard — Layer A of the zero-token real-PII leak guard (af-6eqc).
#
# Local-only, by design: only this machine has dev-DB access, so only this
# machine can build the real-identifier list, and only this machine can run
# this check meaningfully. It compares the outgoing diff -- the range from
# origin/main to HEAD, plus anything still uncommitted -- against a list of
# exact real identifiers pulled from the dev DB, and refuses to let a match
# leave the machine.
#
# The identifier list itself never leaves this machine: it lives under
# .gc/ (already excluded by the root .gitignore), is populated by hand or by
# a separate local-only script with DB access, and is never versioned. This
# guard never echoes the list's contents, or which identifier matched, into
# its own output -- the value being protected must never appear in a bead,
# in mail, or in any log downstream of this script, so it does not appear
# even here.
#
# Usage:
#   factory-pii-guard [--repo-root DIR] [--range REV..REV]
#
# Exit 0: list present and non-empty, checked, no match found -- ACTIVE, clean.
# Exit 1: a real identifier from the list was found in the outgoing diff.
# Exit 2: usage/environment error.
# Exit 3: INACTIVE -- list absent or empty, so nothing was actually checked.
#         This is expected on any machine other than the one with dev-DB
#         access (af-ox44d): do not mistake it for exit 0 -- a caller that
#         collapses 3 into "pass" is exactly the silent-inactive bug this
#         guard used to have.
set -uo pipefail

REPO_ROOT="${FACTORY_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)}"
RANGE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --repo-root)
      [ $# -ge 2 ] || { echo "factory-pii-guard: --repo-root requires a value" >&2; exit 2; }
      REPO_ROOT=$2; shift 2 ;;
    --range)
      [ $# -ge 2 ] || { echo "factory-pii-guard: --range requires a value" >&2; exit 2; }
      RANGE=$2; shift 2 ;;
    -h|--help)
      sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "factory-pii-guard: unknown argument: $1" >&2; exit 2 ;;
  esac
done

cd "$REPO_ROOT" || { echo "factory-pii-guard: $REPO_ROOT unreachable" >&2; exit 2; }

LIST="$REPO_ROOT/.gc/pii-guard/real-identifiers.local"

if [ ! -f "$LIST" ]; then
  echo "factory-pii-guard: INACTIVE -- no local identifier list at .gc/pii-guard/real-identifiers.local, nothing was checked (only a machine with dev-DB access populates this)"
  exit 3
fi

# One exact identifier per line; blank lines and #-comments ignored.
mapfile -t IDENTIFIERS < <(grep -vE '^[[:space:]]*(#|$)' "$LIST" 2>/dev/null || true)
if [ "${#IDENTIFIERS[@]}" -eq 0 ]; then
  echo "factory-pii-guard: INACTIVE -- identifier list is empty, nothing was checked"
  exit 3
fi

[ -n "$RANGE" ] || RANGE="origin/main...HEAD"

if ! OUTGOING_DIFF=$(git diff "$RANGE" -- . 2>&1); then
  echo "factory-pii-guard: 'git diff $RANGE' failed -- cannot verify the outgoing diff is clean (missing/stale ref?). Refusing to report clean." >&2
  echo "$OUTGOING_DIFF" >&2
  exit 2
fi
WORKTREE_DIFF=$(git diff HEAD -- . 2>/dev/null; git diff --cached -- . 2>/dev/null)

HIT=0
for id in "${IDENTIFIERS[@]}"; do
  if printf '%s' "$OUTGOING_DIFF" | grep -qF -- "$id"; then HIT=1; break; fi
  if printf '%s' "$WORKTREE_DIFF" | grep -qF -- "$id"; then HIT=1; break; fi
done

if [ "$HIT" = "1" ]; then
  cat >&2 <<'MSG'
factory-pii-guard: BLOCKED -- a real identifier from the local dev-DB list
(.gc/pii-guard/real-identifiers.local) appears in the outgoing diff. This
guard deliberately never prints which one or where: the value itself is the
thing being protected. Inspect the diff yourself, on this machine only:

  git diff origin/main...HEAD -- .
  git diff HEAD -- .

Replace the real value with synthetic data (see af-hq2j) before pushing.
Never paste the matched value into a bead, mail, or any shared log.

Emergency bypass (only if you are certain this is a false positive):
  git push --no-verify
MSG
  exit 1
fi

echo "factory-pii-guard: ACTIVE, clean -- no listed real identifier found in the outgoing diff"
exit 0
