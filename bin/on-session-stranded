#!/usr/bin/env bash
# on-session-stranded — event-triggered order: when a pool session terminates
# without a clean drain, its in-progress work beads are silently orphaned
# forever (audit finding O4; 13 session.stranded events in 24h, live, none
# acted on). The event payload already names them (work_bead_ids), so this
# reopens each one still in_progress, flags it, and pages the Mayor once per
# stranding event. Dedup by session_id: an event already handled is never
# reprocessed, even across restarts (state survives on disk).
#
# Observe-reopen-and-page only (ADR-0016 section 7): reopening a bead that a
# dead session can no longer finish is repair-in-the-mechanism, not a global
# stop or a human decision -- it makes the bead eligible for normal dispatch
# again instead of leaving it stuck in_progress with nobody watching it.
#
# Usage: on-session-stranded [--check-only] [--quiet]
set -uo pipefail

ROOT="${FACTORY_ROOT:-/home/benja/agent-factory}"
CHECK_ONLY=0
QUIET=0
LOOKBACK="${ON_SESSION_STRANDED_LOOKBACK:-30m}"
RETENTION_SECONDS="${ON_SESSION_STRANDED_RETENTION_SECONDS:-86400}"
STATE_FILE="${ON_SESSION_STRANDED_STATE_FILE:-$ROOT/.gc/runtime/on-session-stranded-state.json}"

while [ $# -gt 0 ]; do
  case "$1" in
    --check-only) CHECK_ONLY=1 ;;
    --quiet) QUIET=1 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

cd "$ROOT" || { echo "on-session-stranded: $ROOT unreachable"; exit 2; }
if ! command -v gc >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  [ "$QUIET" = "1" ] || echo "on-session-stranded: gc/jq unavailable, skipping"
  exit 0
fi

say() { [ "$QUIET" = "1" ] || printf '%s\n' "$*"; }
mkdir -p "$(dirname "$STATE_FILE")"

EVENTS=$(gc events --type session.stranded --since "$LOOKBACK" 2>/dev/null) || exit 0
[ -n "$EVENTS" ] || { say "on-session-stranded: no session.stranded events in $LOOKBACK"; exit 0; }

STATE=$(cat "$STATE_FILE" 2>/dev/null || true)
printf '%s' "$STATE" | jq -e 'type == "object"' >/dev/null 2>&1 || STATE='{}'

REOPENED=0
while IFS= read -r event; do
  [ -n "$event" ] || continue
  session_id=$(jq -r '.payload.session_id // .session_id // empty' <<<"$event")
  [ -n "$session_id" ] || continue
  if printf '%s' "$STATE" | jq -e --arg k "$session_id" 'has($k)' >/dev/null 2>&1; then
    continue
  fi
  [ "$CHECK_ONLY" = "1" ] && { say "on-session-stranded: would process $session_id"; continue; }

  session_name=$(jq -r '.payload.session_name // .session_id // "?"' <<<"$event")
  bead_ids=$(jq -r '(.payload.work_bead_ids // [])[]' <<<"$event" 2>/dev/null)

  reopened_here=""
  while IFS= read -r bead_id; do
    [ -n "$bead_id" ] || continue
    bead_status=$(gc bd show "$bead_id" --json 2>/dev/null | jq -r '(.[0].status // empty)')
    [ "$bead_status" = "in_progress" ] || continue
    if gc bd update "$bead_id" --status open \
        --set-metadata "gc.session_stranded=$session_id" \
        --append-notes "Reopened by on-session-stranded: session $session_name terminated without a clean drain while this bead was in progress." \
        >/dev/null 2>&1; then
      reopened_here="$reopened_here $bead_id"
    fi
  done <<<"$bead_ids"
  reopened_here="${reopened_here# }"

  STATE=$(printf '%s' "$STATE" | jq --arg k "$session_id" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.[$k] = $now')

  if [ -n "$reopened_here" ]; then
    count=$(wc -w <<<"$reopened_here")
    gc mail send mayor --notify \
      -s "Session $session_name stranded — $count bead(s) reopened" \
      -m "ACTION: on-session-stranded reopened bead(s) left in_progress by a session that terminated without a clean drain
STATE: $reopened_here
EVIDENCE: gc events --type session.stranded --since $LOOKBACK
NEXT: pick each one back up through the normal flow; if one is not actually resumable, mark it gc.waiting_on and say why" \
      >/dev/null 2>&1
    say "on-session-stranded: reopened $count bead(s) from $session_id ($reopened_here)"
    REOPENED=$((REOPENED + count))
  else
    say "on-session-stranded: $session_id had no in_progress bead left to reopen"
  fi
done < <(printf '%s\n' "$EVENTS" | jq -c '.')

if [ "$CHECK_ONLY" != "1" ]; then
  # Prune dedup entries older than RETENTION_SECONDS so the state file stays bounded.
  STATE=$(printf '%s' "$STATE" | jq --argjson keep "$RETENTION_SECONDS" \
    'with_entries(select((now - (.value | fromdateiso8601)) <= $keep))' 2>/dev/null) || true
  [ -n "$STATE" ] || STATE='{}'

  TMP=$(mktemp "$(dirname "$STATE_FILE")/.on-session-stranded-state.XXXXXX")
  printf '%s\n' "$STATE" > "$TMP"
  mv -f "$TMP" "$STATE_FILE"
fi

[ "$REOPENED" -gt 0 ] && say "on-session-stranded: reopened $REOPENED bead(s) total"
exit 0
