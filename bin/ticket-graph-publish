#!/usr/bin/env python3
"""Atomically publish one approved Ticket Graph Draft bead to Beads (A6b,
W05/W10).

`bd-publish` and `bd-patch` are the live Beads-backed mode (A6b, W05): a
Ticket Graph Draft is a planning-plane Beads bead linked to a Spec bead, not
a YAML file -- its structured tickets live in the description as YAML
(`global_execution_contract`, `tickets`), and its approval and digest live in
metadata (`approved_by`, `approved_evidence`, `approved_digest`, `spec_id`).
One approval fact (the project's declared human approver plus his exact
evidence) is the sole authorization; the digest simply covers the whole
description, the same formula `spec-approve`'s bead mode uses for a Spec
bead. `bd-publish` opens the Spec bead the draft names and refuses unless it
is approved and its current digest still equals its approved digest, then
uses `graph_plan`/`publish` to create delivery beads and a convoy atomically,
advancing the Planning Run Reservation when the Spec's target is the one
currently active. `bd-patch` reads its revised draft from a bead the same
way and reuses `patch`'s merge/supersede/reslice rules.

A draft that declares the new-flow contract (`flow_contract: new-flow/v1`,
T05, Spec af-wf4w5r §2) is held to the entry contract before anything is
written -- a declared kind with no default, a demonstration line in its own
field, criteria that name their entry point, their observable and what
would make them false -- and its convoy is published with the new-flow mark
through `bin/convoy-state`. The same contract holds the graph to the Spec
it slices (T06): every numbered user story is cited by a vertical_slice,
every declared operator need is lifted (`lift-need`), the project has a
launch recipe or its first slice establishes it, and the door itself poses
the pointers in each ticket (Spec and digest, user stories, sibling tickets
with their demonstration line, seams). In each interface ticket it also
poses the reference of the ticket's Validated Prototype (branch, commit, path,
states), and it refuses an interface graph without the one vertical_slice
that is the Prototype Fold (`prototype_fold: true`), or with an interface
ticket that does not wait for it (T36, Spec §3). A Spec that names several
Validated Prototypes has one Prototype Fold per prototype: each interface
ticket names its own by path (`prototype: <chemin>`) and waits for the Fold
of that one (T46, af-lb9zkz). `bd-patch` applies all of it to the
graph that results from the patch, tickets added or withdrawn included, and
publishes without a new approval a patch that only adds `repair` tickets.
A first publication is also refused without a graph review that holds for
the draft's current digest (T08, `bin/graph-review check`,
docs/GRAPH_REVIEW.md). A draft that does not declare the contract is
published exactly as before.
docs/ENTRY_CONTRACT.md has the fields and the refusals.

The file-draft mode (`validate`/`publish`/`patch` over a YAML Ticket Graph
Draft file carrying the `APPROVED_TICKET_GRAPH_DRAFT` state and a
`legacy_boundary` digest marker) served only the now-retired Planning Run
router and was retired with it (A6b, W10): this tool is bead-mode only.
Historical draft files under `docs/planning/**` stay as archives; they are
simply no longer fed to this tool.
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path
from typing import Any

import yaml

PROGRAM = "ticket-graph-publish"
ROOT = Path(__file__).resolve().parents[1]

BD_BIN = os.environ.get("BD_BIN", "bd")
BD_WORKSPACE = Path(os.environ.get("TICKET_GRAPH_BD_WORKSPACE", str(ROOT)))
GC_BIN = os.environ.get("GC_BIN", "gc")
SKIP_MAYOR_NOTIFY_ENV = "TICKET_GRAPH_PUBLISH_SKIP_MAYOR_NOTIFY"
MAYOR_NOTIFY_TIMEOUT_SECONDS = 60


class PublishError(RuntimeError):
    pass


def run(*args: str) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            [BD_BIN, "-C", str(BD_WORKSPACE), *args],
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or str(exc)).strip()
        raise PublishError(detail) from exc


def as_dict(value: Any, where: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise PublishError(f"{where} must be an object")
    return value


def as_list(value: Any, where: str) -> list[Any]:
    if not isinstance(value, list):
        raise PublishError(f"{where} must be a list")
    return value


def ticket_scope_paths(ticket: dict[str, Any], ticket_id: str) -> list[str]:
    """The glob patterns a ticket declares under `scope.paths` (P11), or []
    for a ticket (or a whole draft) that declares no scope -- publishing
    such a draft must behave exactly as it did before this field existed.
    """
    scope = ticket.get("scope")
    if scope is None:
        return []
    scope_dict = as_dict(scope, f"{ticket_id}.scope")
    paths = as_list(scope_dict.get("paths", []), f"{ticket_id}.scope.paths")
    return [str(item) for item in paths]


def validate_tickets(raw_tickets: list[Any]) -> list[dict[str, Any]]:
    """Ticket-level validation for the bead-mode draft (W05): the
    `tickets:` shape lives in the bead description as YAML."""
    tickets = [as_dict(item, f"tickets[{index}]") for index, item in enumerate(raw_tickets)]
    if not tickets:
        raise PublishError("draft has no publishable tickets")
    ids = [str(ticket.get("id") or "").strip() for ticket in tickets]
    if any(not ticket_id for ticket_id in ids) or len(set(ids)) != len(ids):
        raise PublishError("ticket IDs must be non-empty and unique")
    known = set(ids)
    for ticket in tickets:
        ticket_id = str(ticket["id"])
        blockers = as_list(ticket.get("blocked_by"), f"{ticket_id}.blocked_by")
        unknown = sorted(str(item) for item in blockers if str(item) not in known)
        if unknown:
            raise PublishError(f"{ticket_id} has unknown blockers: {', '.join(unknown)}")
        if ticket_id in {str(item) for item in blockers}:
            raise PublishError(f"{ticket_id} blocks itself")
        if not str(ticket.get("title") or "").strip():
            raise PublishError(f"{ticket_id} has no title")
        if not str(ticket.get("what_it_delivers") or "").strip():
            raise PublishError(f"{ticket_id} has no autonomous outcome")
        if not as_list(ticket.get("acceptance_criteria"), f"{ticket_id}.acceptance_criteria"):
            raise PublishError(f"{ticket_id} has no acceptance criteria")
        if not as_list(ticket.get("target_rigs"), f"{ticket_id}.target_rigs"):
            raise PublishError(f"{ticket_id} has no target rigs")
        ticket_scope_paths(ticket, ticket_id)  # validated eagerly; fails closed on malformed scope

    visiting: set[str] = set()
    visited: set[str] = set()
    by_id = {str(ticket["id"]): ticket for ticket in tickets}

    def visit(ticket_id: str) -> None:
        if ticket_id in visiting:
            raise PublishError(f"dependency cycle at {ticket_id}")
        if ticket_id in visited:
            return
        visiting.add(ticket_id)
        for blocker in by_id[ticket_id]["blocked_by"]:
            visit(str(blocker))
        visiting.remove(ticket_id)
        visited.add(ticket_id)

    for ticket_id in ids:
        visit(ticket_id)
    return tickets


def refuse_prototype_tickets(
    tickets: list[dict[str, Any]], already_published: frozenset[str] = frozenset(),
) -> None:
    """A prototype answers a planning question, so it is built while the map
    is charted -- a `wayfinder:prototype` map ticket, before `/to-spec` --
    never handed to a delivery worker (Benjamin, 2026-09-30: "la prochaine
    fois c'est la planning run qui le fait"). Checked before any write. A
    ticket already published under the graph a patch revises is left as it
    is: a patch never rewrites what an earlier approval published (C01's
    T21, convoy af-f71cgu).
    """
    offending = [
        str(ticket["id"]) for ticket in tickets
        if str(ticket.get("kind") or "").strip().lower() == "prototype"
        and str(ticket["id"]) not in already_published
    ]
    if offending:
        raise PublishError(
            f"refused: {', '.join(offending)} declare kind: prototype -- a prototype is planning "
            "work: build it while charting the map (a wayfinder:prototype map ticket, before "
            "/to-spec), then slice only its outcome into delivery tickets"
        )


def scopes_overlap(a_paths: list[str], b_paths: list[str]) -> bool:
    """Two glob lists overlap if any pattern from one could match a path the
    other pattern could also match. Cross-matching each pattern against the
    other as a literal string (both directions) is the standard cheap
    approximation for glob/glob overlap and is exact for the plain file
    paths these tickets actually declare.
    """
    for pattern_a in a_paths:
        for pattern_b in b_paths:
            if pattern_a == pattern_b:
                return True
            if fnmatch.fnmatch(pattern_a, pattern_b) or fnmatch.fnmatch(pattern_b, pattern_a):
                return True
    return False


def add_scope_overlap_edges(tickets: list[dict[str, Any]]) -> list[dict[str, str]]:
    """Serialise any two tickets with overlapping declared `scope.paths` that
    are not already ordered (directly or transitively) by `blocked_by`, so
    two workers never land branches that touch the same files at once (P11).
    Ticket declaration order is the sole tie-break -- a later ticket becomes
    `blocked_by` an earlier one it overlaps with -- so an added edge is
    deterministic, never reversed, and (via the reachability check) never
    duplicated even across several overlapping pairs in one draft.
    """
    ids = [str(ticket["id"]) for ticket in tickets]
    by_id = {str(ticket["id"]): ticket for ticket in tickets}
    scopes = {ticket_id: ticket_scope_paths(by_id[ticket_id], ticket_id) for ticket_id in ids}
    blocked_by: dict[str, set[str]] = {
        ticket_id: {str(b) for b in (by_id[ticket_id].get("blocked_by") or [])} for ticket_id in ids
    }

    def reachable(start: str, goal: str) -> bool:
        stack, seen = [start], set()
        while stack:
            current = stack.pop()
            if current == goal:
                return True
            if current in seen:
                continue
            seen.add(current)
            stack.extend(blocked_by.get(current, ()))
        return False

    added: list[dict[str, str]] = []
    for index, ticket_id in enumerate(ids):
        if not scopes[ticket_id]:
            continue
        for earlier_id in ids[:index]:
            if not scopes[earlier_id]:
                continue
            if reachable(ticket_id, earlier_id) or reachable(earlier_id, ticket_id):
                continue
            if not scopes_overlap(scopes[ticket_id], scopes[earlier_id]):
                continue
            blocked_by[ticket_id].add(earlier_id)
            by_id[ticket_id]["blocked_by"] = sorted(blocked_by[ticket_id])
            added.append({"blocked": ticket_id, "by": earlier_id})
    return added


def record_scope_overlaps(
    scope_edges: list[dict[str, str]], tickets: list[dict[str, Any]], digest: str,
) -> None:
    """P16 (af-45knz): every scope-overlap edge add_scope_overlap_edges just
    added is measurement input -- record it in the append-only overlap/conflict
    log via bin/overlap-conflict-log (best-effort: a logging failure must never
    fail a publish/patch that otherwise succeeded)."""
    if not scope_edges:
        return
    by_id = {str(ticket["id"]): ticket for ticket in tickets}
    script = str(ROOT / "bin" / "overlap-conflict-log")
    for edge in scope_edges:
        ticket_a, ticket_b = edge["blocked"], edge["by"]
        rigs = as_list(by_id[ticket_a].get("target_rigs") or [], f"{ticket_a}.target_rigs")
        rig = ",".join(str(item) for item in rigs) or "unknown"
        subprocess.run(
            [sys.executable, script, "record-overlap",
             "--ticket-a", ticket_a,
             "--scope-a", ",".join(ticket_scope_paths(by_id[ticket_a], ticket_a)),
             "--ticket-b", ticket_b,
             "--scope-b", ",".join(ticket_scope_paths(by_id[ticket_b], ticket_b)),
             "--digest", digest, "--rig", rig],
            check=False, capture_output=True, text=True,
        )


# --- entry contract of the new flow (T05, Spec af-wf4w5r §2) ----------------

FLOW_CONTRACT_KEY = "flow_contract"
NEW_FLOW = "new-flow/v1"
# The mark bin/convoy-state poses on a convoy of the new flow. The patch door
# only looks for its presence, on a convoy it has already read, to refuse a
# draft of the old flow before anything of `gc` is called for it.
NEW_FLOW_MARK_KEY = "gc.flow.mark"
TICKET_KINDS = ("vertical_slice", "prefactoring", "repair")
KINDS_WITH_DEMONSTRATION = ("vertical_slice", "repair")
RESTORES_KINDS = ("user_story", "anchor", "spec_line", "repo_rule", "red_check")
CRITERION_FIELDS = ("entry_point", "observable", "false_if")
CRITERION_FIELD_NAMES = {
    "entry_point": "son point d'entrée (entry_point)",
    "observable": "son observable (observable)",
    "false_if": "ce qui le rendrait faux (false_if)",
}
# "Un ticket ne porte que des champs que la porte connaît" (Spec §2, prose de
# procédé): a field outside this list is refused, never carried as free text.
TICKET_FIELDS = (
    "id", "kind", "title", "blocked_by", "target_rigs", "scope", "split_from", "what_it_delivers",
    "demonstration_line", "unblocks", "restores", "acceptance_criteria",
    "user_stories", "establishes_launch_recipe", "prototype_fold", "prototype",
)
KIND_COVERING_STORIES = "vertical_slice"
OPERATOR_NEED_FIELDS = ("id", "kind", "what")
OPERATOR_NEED_KINDS = ("secret", "access", "project_declaration", "spend")
# A need id ends a tracker metadata key (`operator_need.<id>` on the draft bead).
OPERATOR_NEED_ID = re.compile(r"^[a-z][a-z0-9_]*$")
OPERATOR_NEED_KEY = "operator_need."
WITHDRAWN_FIELDS = ("ticket", "planning_exception")
PROJECT_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
# The pointers the door poses follow what the approved draft says of a
# ticket; they start at this heading.
POINTERS_START = "\n\n## Spec\n\n"
# The pointer posed in an interface ticket: the reference of the Spec's
# Validated Prototype (T36, Spec §3).
PROTOTYPE_POINTER = "Validated Prototype"
WHERE_DRAFT, WHERE_GRAPH = "brouillon", "graphe"
MAX_QUOTED_CRITERION = 200

TEST_MENTION = re.compile(r"\b(?:tests?|pytest|unittest|jest|vitest|rspec)\b", re.IGNORECASE)
SOURCE_FILE_MENTION = re.compile(
    r"(?<![\w/.-])[\w./-]*\w\.(?:py|pyi|js|jsx|mjs|cjs|ts|tsx|sh|bash|go|rs|rb|java|kt|swift|c|h|cc|cpp|hpp|cs"
    r"|php|sql|toml|ya?ml|json|md|html?|css|scss|vue|svelte|lock|cfg|ini)\b(?![\w/-])"
)
# `name(`: a call. French "ticket(s)" / "livré(e)" is a plural, not a call.
CALL_MENTION = re.compile(r"\b[A-Za-z_][A-Za-z0-9_.]*\((?!(?:s|e|es)\))")
INTERNAL_FUNCTION_WORDING = re.compile(
    r"\b(?:fonction|méthode|function|method)\s+(?:interne|privée|internal|private)\b"
    r"|\b(?:internal|private)\s+(?:function|method)\b",
    re.IGNORECASE,
)


def flow_contract(parsed: dict[str, Any], draft_id: str) -> str | None:
    """The contract a draft declares in its approved text, or None for a
    draft of the flow before T05. An unknown value is refused: the contract
    is never guessed, in either direction."""
    if FLOW_CONTRACT_KEY not in parsed:
        return None
    declared = parsed[FLOW_CONTRACT_KEY]
    if declared != NEW_FLOW:
        raise PublishError(
            f"refus : le brouillon {draft_id} déclare un contrat inconnu ({FLOW_CONTRACT_KEY}: {declared!r}) ; "
            f"le seul contrat connu de la porte est {NEW_FLOW!r}, et un brouillon de l'ancien flux ne "
            "déclare rien ; rien n'est écrit"
        )
    return NEW_FLOW


def one_line(value: Any) -> str:
    return " ".join(str(value).split())


def text_field(holder: dict[str, Any], key: str) -> str:
    value = holder.get(key)
    return one_line(value) if isinstance(value, str) else ""


def forbidden_mentions(text: str, entry_point: bool = False) -> list[str]:
    """What a criterion names that is not a public interface (Spec §2:
    "refus mécanique d'un critère qui nomme un test, un fichier ou une
    fonction interne"). An entry point may be a path -- a command, a route
    -- so only a test is refused there."""
    found: list[str] = []
    match = TEST_MENTION.search(text)
    if match:
        found.append(f"nomme un test (« {match.group(0)} »)")
    if entry_point:
        return found
    match = SOURCE_FILE_MENTION.search(text)
    if match:
        found.append(f"nomme un fichier (« {match.group(0)} »)")
    match = CALL_MENTION.search(text) or INTERNAL_FUNCTION_WORDING.search(text)
    if match:
        call = text[match.start():].split(")")[0] + ")" if match.re is CALL_MENTION else match.group(0)
        found.append(f"nomme une fonction interne (« {call} »)")
    return found


def criterion_reasons(criterion: Any) -> tuple[str, list[str]]:
    """The text a refusal quotes for one criterion, and why it is refused."""
    if isinstance(criterion, str):
        quoted = one_line(criterion)
        return quoted, [
            "ne nomme pas son point d'entrée et son observable "
            f"(attendu : les champs {', '.join(CRITERION_FIELDS)})",
            *forbidden_mentions(quoted),
        ]
    if not isinstance(criterion, dict):
        return one_line(criterion), [f"n'est pas un critère (attendu : les champs {', '.join(CRITERION_FIELDS)})"]
    values = {field: text_field(criterion, field) for field in CRITERION_FIELDS}
    quoted = " — ".join(value for value in values.values() if value)
    reasons = [f"ne nomme pas {CRITERION_FIELD_NAMES[field]}" for field in CRITERION_FIELDS if not values[field]]
    unknown = sorted(str(key) for key in criterion if key not in CRITERION_FIELDS)
    if unknown:
        reasons.append(f"porte un champ inconnu de la porte ({', '.join(unknown)})")
    for field in CRITERION_FIELDS:
        for mention in forbidden_mentions(values[field], entry_point=field == "entry_point"):
            if mention not in reasons:
                reasons.append(mention)
    return quoted, reasons


def cited_user_stories(ticket: dict[str, Any]) -> list[str] | None:
    """The numbers a ticket cites in `user_stories`, or None when the field
    is absent or is not a list of story numbers, each given once."""
    value = ticket.get("user_stories")
    if not isinstance(value, list) or not value:
        return None
    numbers: list[str] = []
    for item in value:
        if isinstance(item, bool) or not isinstance(item, (int, str)) or not re.fullmatch(r"[1-9][0-9]*", str(item)):
            return None
        numbers.append(str(item))
    return numbers if len(set(numbers)) == len(numbers) else None


class CitationSources:
    """What a `repair` cites besides the text of the Spec, read where it
    lives (T40, af-o6tu3z; Spec §2, §11), and only when a ticket cites it:
    the anchors of the Validated Prototypes the Spec names, in the
    repository of the project at the commit of each reference; the files of
    that repository at the tip of the integration branch (of the protected
    branch, before the first publication opens it); the red controls the
    convoy carries a record of, as bin/convoy-state shows them. A source
    that cannot be read verifies nothing: the citation is refused."""

    def __init__(self, spec: dict[str, Any], target: Any, state: dict[str, Any] | None):
        self.spec = spec
        self._target = target  # () -> {"repo", "protected"} of the one rig the graph targets
        self.state = state
        self._anchors: tuple[set[str], str | None] | None = None

    def repo(self) -> tuple[Path | None, str | None, str | None]:
        """The repository of the project and its protected branch, or why
        there is none."""
        try:
            target = self._target()
        except PublishError as exc:
            return None, None, one_line(str(exc))
        return target["repo"], target["protected"], None

    def anchors(self) -> tuple[set[str], str | None]:
        """The named anchors of every prototyped state of the Spec's
        Validated Prototypes, or why they cannot be read."""
        if self._anchors is None:
            self._anchors = self._read_anchors()
        return self._anchors

    def _read_anchors(self) -> tuple[set[str], str | None]:
        prototypes = self.spec["prototypes"]
        if not prototypes:
            return set(), None
        repo, _, problem = self.repo()
        if repo is None:
            return set(), problem
        names: set[str] = set()
        reader = tool_path("PROTOTYPE_CONFORMANCE_BIN", "prototype-conformance")
        for prototype in prototypes:
            argv = [reader, "anchors", "--repo", str(repo), "--commit", str(prototype["commit"]),
                    "--path", str(prototype["path"]), "--branch", str(prototype["branch"]),
                    "--states", ",".join(str(state) for state in prototype["states"])]
            try:
                proc = subprocess.run(argv, capture_output=True, text=True, stdin=subprocess.DEVNULL)
                answer = json.loads(proc.stdout)
            except (OSError, json.JSONDecodeError) as exc:
                return set(), f"{Path(reader).name} anchors : {exc}"
            if proc.returncode != 0 or not isinstance(answer.get("anchors"), dict):
                return set(), one_line(str(answer.get("error") or proc.stderr.strip() or f"exit {proc.returncode}"))
            names.update(name for state in answer["anchors"].values() for name in state)
        return names, None

    def rule_problem(self, path: str, quote: str) -> str | None:
        """Why the repository does not hold `quote` in the file `path`, at
        the tip of the integration branch; None when it does."""
        repo, protected, problem = self.repo()
        if repo is None:
            return f"le dépôt du projet est illisible ({problem})"
        integration = ((self.state or {}).get("convoy") or {}).get("integration")
        branch = integration["branch"] if isinstance(integration, dict) and "branch" in integration else protected
        where = "la branche d'intégration" if branch != protected else "la branche protégée"

        def git(*argv: str) -> subprocess.CompletedProcess[str]:
            return subprocess.run(["git", "-C", str(repo), *argv], capture_output=True, text=True, errors="replace")

        tip = next((ref for ref in (f"refs/heads/{branch}", f"refs/remotes/origin/{branch}")
                    if git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}").returncode == 0), None)
        if tip is None:
            return f"{where} {branch} est introuvable dans le dépôt {repo}"
        if path.startswith(("/", "-")) or ".." in Path(path).parts or git("cat-file", "-e", f"{tip}:{path}").returncode != 0 \
                or git("cat-file", "-t", f"{tip}:{path}").stdout.strip() != "blob":
            return f"le fichier {path} n'existe pas au commit de {where} {branch}"
        if one_line(quote) not in one_line(git("show", f"{tip}:{path}").stdout):
            return f"le fichier {path} ne contient pas la citation au commit de {where} {branch}"
        return None

    def red_checks(self) -> list[str]:
        recorded = ((self.state or {}).get("convoy") or {}).get("red_checks")
        return [str(check.get("name")) for check in recorded if isinstance(check, dict)] if isinstance(recorded, list) else []

    def fidelity_red(self, ticket: dict[str, Any]) -> bool:
        """Whether a repair restores the mechanical fidelity the convoy
        carries a red of: an interface ticket, as the repair of an anchor."""
        restores = ticket.get("restores")
        if not isinstance(restores, dict) or restores.get("kind") != "red_check":
            return False
        recorded = ((self.state or {}).get("convoy") or {}).get("red_checks")
        return any(isinstance(check, dict) and check.get("check") == "fidelity" and check.get("name") == restores.get("ref")
                   for check in (recorded if isinstance(recorded, list) else []))


REPO_RULE_REF = re.compile(r"^(?P<path>\S+) : (?P<quote>.+)$", re.DOTALL)


def citation_refusal(restores: dict[str, Any], sources: CitationSources) -> str | None:
    """Why what a repair cites outside the text of the Spec is not held by
    its source (T40); None when it is, or when the Spec itself is cited."""
    spec_id = sources.spec["id"]
    ref = text_field(restores, "ref")
    quoted = truncate_line(ref, MAX_QUOTED_CRITERION)
    if restores["kind"] == "anchor":
        name = ref.strip("`")
        anchors, problem = sources.anchors()
        if problem:
            return (f"cite l'ancre « {quoted} » et les ancres du Validated Prototype de la Spec {spec_id} sont "
                    f"illisibles ({problem}) : une citation qui ne se vérifie pas n'est pas publiée")
        if name not in anchors:
            return (
                f"cite l'ancre « {quoted} », qui n'est dans aucun état du Validated Prototype nommé par la Spec {spec_id} "
                f"(restores.ref ; attendu : le nom d'une ancre, parmi {', '.join(sorted(anchors)) or 'aucune : la Spec ne nomme aucun Validated Prototype'}) : "
                "un comportement que la Spec n'exige pas n'est pas un repair, c'est une Planning Exception")
    if restores["kind"] == "repo_rule":
        match = REPO_RULE_REF.match(ref)
        if not match:
            return (f"cite une règle du dépôt sans nommer son fichier (restores.ref : « {quoted} » ; attendu : "
                    "« <chemin du fichier> : <la règle, citée mot pour mot> »)")
        problem = sources.rule_problem(match.group("path"), match.group("quote"))
        if problem:
            return f"cite une règle absente du dépôt (restores.ref : « {quoted} ») : {problem}"
    if restores["kind"] == "red_check" and ref not in sources.red_checks():
        return (f"cite un contrôle rouge que le convoi ne porte pas (restores.ref : « {quoted} » ; contrôles rouges "
                f"enregistrés : {' ; '.join(f'« {truncate_line(name, MAX_QUOTED_CRITERION)} »' for name in sources.red_checks()) or 'aucun'}) : "
                "un repair rétablit un contrôle rouge enregistré sur son convoi (bin/convoy-state show)")
    return None


def entry_contract_refusals(
    parsed: dict[str, Any], tickets: list[dict[str, Any]], spec: dict[str, Any], sources: CitationSources,
) -> list[tuple[str, str]]:
    """Every reason a draft that declares the new-flow contract does not meet
    it, as (ticket id or "brouillon", reason), in the order of the draft: the
    whole list is given at once, so a graph is corrected in one pass. `spec`
    is the approved Spec the draft slices (`spec_view`)."""
    refusals: list[tuple[str, str]] = []
    stories: dict[str, str] = spec["stories"]
    if parsed.get("global_execution_contract"):
        refusals.append((
            "brouillon",
            "global_execution_contract : le contrat d'exécution recopié dans chaque ticket n'existe plus "
            "au contrat du nouveau flux ; une exigence a un mécanisme qui la vérifie, ou elle n'est pas écrite",
        ))
    by_id = {str(ticket["id"]): ticket for ticket in tickets}

    def waits_for(ticket_id: str, blocker: str) -> bool:
        stack, seen = [ticket_id], set()
        while stack:
            current = stack.pop()
            if current in seen:
                continue
            seen.add(current)
            blockers = [str(item) for item in by_id[current]["blocked_by"]]
            if blocker in blockers:
                return True
            stack.extend(blockers)
        return False

    for ticket in tickets:
        ticket_id = str(ticket["id"])

        def refuse(reason: str) -> None:
            refusals.append((ticket_id, reason))

        unknown = sorted(str(key) for key in ticket if key not in TICKET_FIELDS)
        if unknown:
            refuse(
                f"champ inconnu de la porte : {', '.join(unknown)} "
                "(un ticket ne porte que des champs que la porte connaît)"
            )

        kind = ticket.get("kind")
        expected = "attendu : vertical_slice, prefactoring ou repair ; aucun genre par défaut"
        if kind is None or (isinstance(kind, str) and not kind.strip()):
            refuse(f"genre absent ({expected})")
        elif kind not in TICKET_KINDS:
            refuse(f"genre inconnu « {one_line(kind)} » ({expected})")
        else:
            line = text_field(ticket, "demonstration_line")
            if kind in KINDS_WITH_DEMONSTRATION and not line:
                refuse(
                    f"pas de ligne de démonstration : un {kind} dit, dans le champ demonstration_line, "
                    "ce qu'on observe sur le produit lancé"
                )
            if kind == "prefactoring":
                if "demonstration_line" in ticket:
                    refuse(
                        "ligne de démonstration sur un prefactoring : il ne change aucun comportement, "
                        "il n'a donc rien à démontrer ; un comportement nouveau est une vertical_slice"
                    )
                unblocks = text_field(ticket, "unblocks")
                if not unblocks:
                    refuse("ne nomme pas la tranche qu'il débloque (champ unblocks : l'identifiant d'une vertical_slice)")
                elif unblocks == ticket_id:
                    refuse("la tranche qu'il débloque (unblocks) est lui-même")
                elif unblocks not in by_id:
                    refuse(f"la tranche qu'il débloque (unblocks: {unblocks}) est un ticket inconnu du graphe")
                elif by_id[unblocks].get("kind") != "vertical_slice":
                    refuse(f"le ticket qu'il débloque (unblocks: {unblocks}) n'est pas une vertical_slice")
                elif not waits_for(unblocks, ticket_id):
                    refuse(
                        f"il ne débloque pas {unblocks} : {unblocks} ne l'attend pas "
                        "(blocked_by, directement ou par un autre ticket)"
                    )
            elif "unblocks" in ticket:
                refuse(f"champ unblocks sur un {kind} : seul un prefactoring nomme la tranche qu'il débloque")
            if kind == "repair":
                restores = ticket.get("restores")
                restored = isinstance(restores, dict) and sorted(restores) == ["kind", "ref"]
                if not restored or restores["kind"] not in RESTORES_KINDS or not text_field(restores, "ref"):
                    refuse(
                        "ne nomme pas ce qu'il rétablit (champ restores : kind parmi "
                        f"{', '.join(RESTORES_KINDS)}, et ref qui le cite)"
                    )
                else:
                    # A repair restores something the Spec already holds:
                    # the door checks each citation against its source.
                    ref = text_field(restores, "ref")
                    quoted = truncate_line(ref, MAX_QUOTED_CRITERION)
                    if restores["kind"] == "user_story" and restored_user_story(ticket, stories) is None:
                        refuse(
                            f"rétablit une user story absente de la Spec {spec['id']} (restores.ref : « {quoted} » ; "
                            f"attendu : le numéro d'une seule user story, parmi {', '.join(stories)})"
                        )
                    if restores["kind"] == "spec_line" and ref not in one_line(spec["text"]):
                        refuse(
                            f"cite une ligne absente de la Spec {spec['id']} (restores.ref : « {quoted} ») : "
                            "une ligne citée s'y retrouve mot pour mot"
                        )
                    # What it cites elsewhere is read at its source (T40).
                    unheld = citation_refusal(restores, sources)
                    if unheld:
                        refuse(unheld)
            elif "restores" in ticket:
                refuse(f"champ restores sur un {kind} : seul un repair nomme ce qu'il rétablit")

            if kind == KIND_COVERING_STORIES:
                cited = cited_user_stories(ticket)
                if ticket.get("user_stories") in (None, []):
                    refuse(
                        "ne couvre aucune user story : une vertical_slice cite, dans le champ user_stories, "
                        "au moins un numéro de user story de la Spec"
                    )
                elif cited is None:
                    refuse(
                        "user_stories mal formé (attendu : une liste de numéros de user stories de la Spec, "
                        "chacun une seule fois)"
                    )
                else:
                    absent = [number for number in cited if number not in stories]
                    if absent:
                        refuse(
                            f"cite la user story {', '.join(absent)}, absente de la Spec {spec['id']} "
                            f"(user stories numérotées : {', '.join(stories)})"
                        )
            elif "user_stories" in ticket:
                refuse(f"champ user_stories sur un {kind} : seule une vertical_slice couvre des user stories")

            if "establishes_launch_recipe" in ticket:
                if kind != KIND_COVERING_STORIES:
                    refuse(
                        f"champ establishes_launch_recipe sur un {kind} : seule une vertical_slice établit "
                        "la recette de lancement"
                    )
                elif ticket["establishes_launch_recipe"] is not True:
                    refuse(
                        "establishes_launch_recipe mal formé (attendu : true, sur la seule tranche qui établit "
                        "la recette de lancement)"
                    )

            if "prototype_fold" in ticket:
                if kind != KIND_COVERING_STORIES:
                    refuse(
                        f"champ prototype_fold sur un {kind} : le Prototype Fold est une vertical_slice ordinaire"
                    )
                elif ticket["prototype_fold"] is not True:
                    refuse(
                        "prototype_fold mal formé (attendu : true, sur la seule tranche qui replie le Validated "
                        "Prototype dans le vrai code)"
                    )
            if "prototype" in ticket and not (isinstance(ticket["prototype"], str) and ticket["prototype"].strip()):
                refuse(
                    "prototype mal formé (attendu : le chemin du Validated Prototype de ce ticket, tel que la "
                    "Spec l'écrit)"
                )

        for index, criterion in enumerate(ticket["acceptance_criteria"], start=1):
            quoted, reasons = criterion_reasons(criterion)
            if reasons:
                refuse(f"critère {index} « {truncate_line(quoted, MAX_QUOTED_CRITERION)} » : {' ; '.join(reasons)}")
    return refusals


def restored_user_story(ticket: dict[str, Any], stories: dict[str, str]) -> str | None:
    """The number of the Spec's user story a repair restores, when its
    `restores` cites exactly one."""
    restores = ticket.get("restores")
    if not isinstance(restores, dict) or restores.get("kind") != "user_story":
        return None
    numbers = [str(int(number)) for number in re.findall(r"[0-9]+", text_field(restores, "ref"))]
    return numbers[0] if len(numbers) == 1 and numbers[0] in stories else None


def refuse_unless_contract_met(draft_id: str, refusals: list[tuple[str, str]]) -> None:
    if not refusals:
        return
    count = len({where for where, _ in refusals if where not in (WHERE_DRAFT, WHERE_GRAPH)})
    lines = "\n".join(f"- {where} : {reason}" for where, reason in refusals)
    raise PublishError(
        f"refus : le brouillon {draft_id} déclare le contrat du nouveau flux ({NEW_FLOW}) et ne le "
        f"respecte pas ({len(refusals)} raison(s), {count} ticket(s)) ; rien n'est écrit.\n{lines}"
    )


# --- the graph against its Spec and its project (T06, Spec af-wf4w5r §2) -----


def spec_view(spec_id: str, spec_bead: dict[str, Any]) -> dict[str, Any]:
    """What the door reads in the approved Spec: its numbered user stories,
    which of them describe an interface, its Testing Decisions and the
    reference of its Validated Prototype, through the reader `spec-approve`
    holds the Spec to (`outline`), so each has one definition."""
    text = str(spec_bead.get("description") or "")
    argv = [tool_path("SPEC_APPROVE_BIN", "spec-approve"), "outline"]
    try:
        outline = run_subtool(argv, stdin=text)
    except PublishError as exc:
        raise PublishError(
            f"refus : la Spec {spec_id} ne se prête pas au contrôle de couverture : {exc} ; rien n'est écrit"
        ) from exc
    return {
        "id": spec_id,
        "digest": canonical_bead_digest(text),
        "text": text,
        "stories": {str(story["number"]): one_line(story["text"]) for story in outline["user_stories"]},
        "testing_decisions": [one_line(line) for line in outline["testing_decisions"]],
        "interface_stories": {str(story["number"]) for story in outline["user_stories"] if story.get("interface")},
        "prototype": outline.get("validated_prototype"),
        "prototypes": outline.get("validated_prototypes") or [
            reference for reference in [outline.get("validated_prototype")] if reference
        ],
        "prototype_problem": outline.get("validated_prototype_problem"),
    }


def project_launch(project_id: str, descriptors_dir: Path, profile_bin: str) -> tuple[dict[str, Any] | None, Path]:
    """The launch block of the project's profile (recipe, entry points), or
    None when the profile declares none or the project has no profile."""
    if not PROJECT_ID.match(project_id):
        raise PublishError(f"refused: project key {project_id!r} is not a safe identifier")
    path = descriptors_dir / f"{project_id}.json"
    if not path.is_file():
        return None, path
    try:
        proc = subprocess.run([profile_bin, "describe", str(path)], capture_output=True, text=True)
        described = json.loads(proc.stdout)
    except (OSError, json.JSONDecodeError) as exc:
        raise PublishError(f"could not read the project profile {path}: {exc}") from exc
    if proc.returncode != 0 or not isinstance(described, dict) or described.get("valid") is False:
        detail = described.get("error") if isinstance(described, dict) else None
        raise PublishError(f"refus : le profil du projet {project_id} ({path}) est invalide : {detail or proc.stderr.strip()}")
    launch = described.get("launch")
    return (launch if isinstance(launch, dict) else None), path


def operator_need_refusals(
    parsed: dict[str, Any], metadata: dict[str, Any], human_approver: str, draft_id: str,
) -> list[tuple[str, str]]:
    """Spec §2, « besoins opérateur »: every need known at planning is
    declared in the graph, and nothing is published while one is not lifted."""
    if "operator_needs" not in parsed:
        return []
    expected = (
        f"attendu : une liste de besoins, chacun {{id, kind, what}} ; id en minuscules, chiffres et _ ; "
        f"kind parmi {', '.join(OPERATOR_NEED_KINDS)} ; what qui dit ce qu'il faut ; aucun autre champ"
    )
    needs = parsed["operator_needs"]
    if not isinstance(needs, list):
        return [(WHERE_DRAFT, f"besoin opérateur mal formé : operator_needs n'est pas une liste ({expected})")]
    refusals: list[tuple[str, str]] = []
    seen: set[str] = set()
    for need in needs:
        well_formed = (
            isinstance(need, dict) and sorted(need) == sorted(OPERATOR_NEED_FIELDS)
            and isinstance(need["id"], str) and OPERATOR_NEED_ID.match(need["id"])
            and need["kind"] in OPERATOR_NEED_KINDS and text_field(need, "what")
        )
        if not well_formed:
            refusals.append((WHERE_DRAFT, f"besoin opérateur mal formé : « {truncate_line(str(need))} » ({expected})"))
            continue
        need_id = need["id"]
        if need_id in seen:
            refusals.append((WHERE_DRAFT, f"besoin opérateur déclaré deux fois : {need_id}"))
            continue
        seen.add(need_id)
        if not need_is_lifted(metadata, need_id, human_approver):
            refusals.append((
                WHERE_DRAFT,
                f"besoin opérateur non levé : {need_id} ({need['kind']}) — {text_field(need, 'what')} ; une fois "
                f"levé par {human_approver}, l'enregistrer avec ses mots : bin/{PROGRAM} lift-need {draft_id} "
                f"--need {need_id} --by {human_approver} --evidence « … » --project <projet>",
            ))
    return refusals


def need_is_lifted(metadata: dict[str, Any], need_id: str, human_approver: str) -> bool:
    try:
        record = json.loads(metadata.get(OPERATOR_NEED_KEY + need_id) or "null")
    except (TypeError, json.JSONDecodeError):
        return False
    return (
        isinstance(record, dict) and record.get("lifted_by") == human_approver
        and isinstance(record.get("evidence"), str) and bool(record["evidence"].strip())
    )


def graph_ticket(ticket: dict[str, Any], stories: dict[str, str]) -> dict[str, Any]:
    """A ticket of the draft, as the graph checks and the pointers read it."""
    kind = ticket.get("kind")
    return {
        "key": str(ticket["id"]),
        "kind": kind if kind in TICKET_KINDS else None,
        "title": one_line(ticket.get("title") or ""),
        "demonstration_line": text_field(ticket, "demonstration_line") or None,
        "user_stories": cited_user_stories(ticket),
        "restored_story": restored_user_story(ticket, stories),
        "establishes": ticket.get("establishes_launch_recipe") is True,
        "fold": ticket.get("prototype_fold") is True,
        "prototype": named_prototype(ticket.get("prototype")),
        "restores_anchor": isinstance(ticket.get("restores"), dict) and ticket["restores"].get("kind") == "anchor",
        "posed_prototype": False,
        "closed": False,
        "blocked_by": [str(blocker) for blocker in ticket["blocked_by"]],
    }


def named_prototype(raw: Any) -> str | None:
    """The Validated Prototype a ticket names as its own: its path."""
    return raw.strip().strip("`").strip("/") if isinstance(raw, str) and raw.strip() else None


def posed_prototype(description: str) -> str | None:
    """The path of the reference the door posed in a published ticket."""
    _, found, section = description.partition(f"\n\n## {PROTOTYPE_POINTER}\n\n")
    match = re.search(r"^- chemin : (.+)$", section.split("\n## ")[0], re.MULTILINE) if found else None
    return named_prototype(match.group(1)) if match else None


def prototype_of(ticket: dict[str, Any], spec: dict[str, Any]) -> tuple[dict[str, Any] | None, str | None]:
    """The Validated Prototype of an interface ticket, or why it has none:
    the one it names, else the only one the Spec names."""
    prototypes = spec["prototypes"]
    paths = ", ".join(prototype["path"] for prototype in prototypes)
    if ticket["prototype"] is not None:
        for prototype in prototypes:
            if prototype["path"] == ticket["prototype"]:
                return prototype, None
        return None, (
            f"prototype : {ticket['prototype']} n'est le chemin d'aucun Validated Prototype de la Spec "
            f"{spec['id']} (attendu : {paths or 'la Spec n\'en nomme aucun'})"
        )
    if len(prototypes) == 1:
        return prototypes[0], None
    if not prototypes:
        return None, None
    return None, (
        f"ticket d'interface qui ne dit pas quel Validated Prototype est le sien : la Spec {spec['id']} en nomme "
        f"plusieurs ({paths}) ; champ prototype: <chemin>"
    )


def waits_for(by_key: dict[str, dict[str, Any]], key: str, blocker: str) -> bool:
    """Whether the graph ticket `key` waits for `blocker`, directly or
    through another ticket."""
    stack, seen = [key], set()
    while stack:
        current = stack.pop()
        if current in seen or current not in by_key:
            continue
        seen.add(current)
        if blocker in by_key[current]["blocked_by"]:
            return True
        stack.extend(by_key[current]["blocked_by"])
    return False


def is_interface_ticket(ticket: dict[str, Any], spec: dict[str, Any]) -> bool:
    """An interface ticket: the Prototype Fold, a ticket that covers or
    restores a user story the Spec marks as describing an interface, a
    repair of an anchor, or a published ticket the door already gave the
    prototype reference to."""
    stories = ticket["user_stories"] or ([ticket["restored_story"]] if ticket["restored_story"] else [])
    return (
        ticket["fold"] or ticket["restores_anchor"] or ticket["posed_prototype"]
        or any(number in spec["interface_stories"] for number in stories)
    )


def prototype_fold_of(graph: list[dict[str, Any]]) -> list[dict[str, Any]]:
    return [ticket for ticket in graph if ticket["fold"] and ticket["kind"] == KIND_COVERING_STORIES]


def prototype_fold_refusals(graph: list[dict[str, Any]], spec: dict[str, Any]) -> list[tuple[str, str]]:
    """Spec §3, « Prototype Fold »: one vertical_slice per Validated
    Prototype folds it into the real code, and every other interface ticket
    of that prototype waits for it."""
    prototypes = spec["prototypes"]
    folds = prototype_fold_of(graph)
    interface = [ticket for ticket in graph if is_interface_ticket(ticket, spec)]
    if not prototypes:
        problem = spec["prototype_problem"]
        if problem and interface:
            return [(
                WHERE_GRAPH,
                f"la Spec {spec['id']} porte un Validated Prototype dont la référence ne se lit pas "
                f"({problem.removeprefix('refus : ')}) ; les tickets d'interface "
                f"({', '.join(ticket['key'] for ticket in interface)}) n'ont pas de cible",
            )]
        return [(
            ticket["key"],
            f"prototype_fold : la Spec {spec['id']} ne nomme aucun Validated Prototype à replier",
        ) for ticket in folds]
    refusals: list[tuple[str, str]] = []
    own: dict[str, list[dict[str, Any]]] = {prototype["path"]: [] for prototype in prototypes}
    for ticket in graph:
        if not (ticket["prototype"] is not None or ticket in interface):
            continue
        prototype, problem = prototype_of(ticket, spec)
        if problem:
            refusals.append((ticket["key"], problem))
        elif prototype is not None and ticket in interface:
            own[prototype["path"]].append(ticket)
    by_key = {ticket["key"]: ticket for ticket in graph}
    for prototype in prototypes:
        refusals += one_prototype_fold_refusals(prototype, own[prototype["path"]], by_key, interface, len(prototypes))
    return refusals


def one_prototype_fold_refusals(
    prototype: dict[str, Any], interface: list[dict[str, Any]], by_key: dict[str, dict[str, Any]],
    every_interface: list[dict[str, Any]], named_by_spec: int,
) -> list[tuple[str, str]]:
    """The Fold rules for one Validated Prototype and its interface tickets."""
    named = (
        f"le Validated Prototype {prototype['path']} (branche {prototype['branch']}, commit {prototype['commit']})"
    )
    folds = [ticket for ticket in interface if ticket["fold"] and ticket["kind"] == KIND_COVERING_STORIES]
    if len(folds) > 1:
        names = ", ".join(ticket["key"] for ticket in folds)
        return [(
            ticket["key"],
            f"prototype_fold : plusieurs tickets replient {named} ({names}) ; un seul Prototype Fold par "
            "Validated Prototype",
        ) for ticket in folds]
    if not folds:
        if interface:
            return [(
                WHERE_GRAPH,
                f"{named} n'a pas de Prototype Fold : le graphe porte des tickets d'interface "
                f"({', '.join(ticket['key'] for ticket in interface)}) et aucune vertical_slice ne déclare "
                "prototype_fold: true (la tranche qui sert tous les états prototypés à la vraie adresse sur les "
                "données d'exemple, et que tout autre ticket d'interface attend)",
            )]
        if named_by_spec > 1 and every_interface:
            return [(
                WHERE_GRAPH,
                f"{named} n'a pas de Prototype Fold : la Spec nomme {named_by_spec} Validated Prototypes et "
                f"chacun a le sien ; aucune vertical_slice ne déclare prototype_fold: true avec prototype: "
                f"{prototype['path']}",
            )]
        return []
    fold = folds[0]
    if fold["closed"]:
        return []  # delivered: nothing is left to wait for
    refusals: list[tuple[str, str]] = []
    for ticket in interface:
        key = ticket["key"]
        if key == fold["key"] or ticket["closed"] or waits_for(by_key, key, fold["key"]):
            continue
        # A repair the Fold itself waits for comes before it by construction.
        if ticket["kind"] == "repair" and waits_for(by_key, fold["key"], key):
            continue
        refusals.append((
            key,
            f"ticket d'interface qui n'attend pas le Prototype Fold {fold['key']} (blocked_by, directement ou "
            f"par un autre ticket) : le Prototype Fold est le premier ticket d'interface, il replie {named}",
        ))
    return refusals


def graph_refusals(
    graph: list[dict[str, Any]], spec: dict[str, Any], launch: dict[str, Any] | None,
    project_id: str, descriptor: Path,
) -> list[tuple[str, str]]:
    """What is refused of the graph as a whole -- the draft for a first
    publication, the graph that results from the patch otherwise."""
    refusals: list[tuple[str, str]] = []
    covered = {
        number for ticket in graph if ticket["kind"] not in ("prefactoring", "repair")
        for number in ticket["user_stories"] or []
    }
    orphans = [number for number in spec["stories"] if number not in covered]
    if orphans:
        refusals.append((
            WHERE_GRAPH,
            f"user stories couvertes par aucun ticket : {', '.join(orphans)} (chaque user story numérotée de "
            f"la Spec {spec['id']} est citée par au moins une vertical_slice)",
        ))

    establishing = [ticket for ticket in graph if ticket["establishes"] and ticket["kind"] == KIND_COVERING_STORIES]
    if len(establishing) > 1:
        names = ", ".join(ticket["key"] for ticket in establishing)
        refusals += [(
            ticket["key"],
            f"establishes_launch_recipe : plusieurs tranches établissent la recette de lancement ({names}) ; "
            "une seule l'établit, la première du graphe",
        ) for ticket in establishing]
    elif launch is None and not establishing:
        missing = "" if descriptor.is_file() else ", fichier absent"
        refusals.append((
            WHERE_GRAPH,
            f"le profil du projet {project_id} ne déclare pas de recette de lancement ({descriptor}{missing}) "
            "et aucune tranche du graphe ne l'établit (champ establishes_launch_recipe: true sur la première "
            "vertical_slice, celle que les autres tranches attendent)",
        ))
    elif launch is None:
        by_key = {ticket["key"]: ticket for ticket in graph}
        first = establishing[0]["key"]
        ahead = [
            ticket["key"] for ticket in graph
            if ticket["key"] != first and ticket["kind"] in KINDS_WITH_DEMONSTRATION
            and not waits_for(by_key, ticket["key"], first)
        ]
        if ahead:
            refusals.append((
                first,
                "establishes_launch_recipe : ce n'est pas la première tranche du graphe ; ne l'attendent pas "
                f"(blocked_by, directement ou par un autre ticket) : {', '.join(ahead)}",
            ))
    return refusals + prototype_fold_refusals(graph, spec)


def pointer_sections(
    ticket: dict[str, Any], graph: list[dict[str, Any]], spec: dict[str, Any], launch: dict[str, Any] | None,
) -> dict[str, str]:
    """The pointers the door poses in a ticket, never written by hand (Spec
    §2): the Spec and its digest, the user stories the ticket covers, its
    sibling tickets with their demonstration line, the reference of the
    Validated Prototype in an interface ticket, and the seams (entry points
    of the project profile, Testing Decisions of the Spec)."""
    numbers = ticket["user_stories"] or ([ticket["restored_story"]] if ticket["restored_story"] else [])
    stories = [f"- {number}. {spec['stories'][number]}" for number in numbers if number in spec["stories"]]
    siblings = [
        f"- {other['key']} ({other['kind']}) — {other['title']} : "
        + (other["demonstration_line"] or "pas de ligne de démonstration")
        for other in graph if other["key"] != ticket["key"]
    ]
    if launch is None:
        seams = ["- Points d'entrée du profil : aucun déclaré, la première tranche établit la recette de lancement"]
    else:
        seams = [
            f"- Point d'entrée du profil : {entry.get('method')} {entry.get('path')} ({entry.get('kind')})"
            for entry in launch.get("entry_points") or []
        ]
    seams += [f"- Testing Decisions de la Spec : {line}" for line in spec["testing_decisions"]] or [
        "- Testing Decisions de la Spec : aucune"
    ]
    sections = {
        "Spec": f"{spec['id']} — {spec['digest']}",
        "User stories": "\n".join(stories) or "aucune",
        "Sibling tickets": "\n".join(siblings) or "aucun",
    }
    prototype = prototype_of(ticket, spec)[0] if is_interface_ticket(ticket, spec) else None
    if prototype is not None:
        reference = [
            f"- branche : {prototype['branch']}",
            f"- commit : {prototype['commit']}",
            f"- chemin : {prototype['path']}",
            f"- états : {', '.join(prototype['states'])}",
        ]
        own_folds = [
            fold for fold in prototype_fold_of(graph) if prototype_of(fold, spec)[0] is prototype
        ]
        for fold in own_folds[:1]:
            reference.append(
                "- Prototype Fold : ce ticket ; il sert tous ces états à la vraie adresse sur les données "
                "d'exemple, et le fichier du prototype n'est pas promu tel quel"
                if fold["key"] == ticket["key"] else f"- Prototype Fold : {fold['key']} — {fold['title']}"
            )
        sections[PROTOTYPE_POINTER] = "\n".join(reference)
    return {**sections, "Seams": "\n".join(seams)}


def render_sections(sections: dict[str, str]) -> str:
    return "\n\n".join(f"## {title}\n\n{body}" for title, body in sections.items())


def repointed(description: str, sections: dict[str, str]) -> str:
    """A published ticket text with these pointer sections replaced; what
    the approved draft says of the ticket, before the pointers, is kept."""
    own, start, pointers = description.partition(POINTERS_START)
    if not start:
        return description
    current: dict[str, str] = {}
    for block in (start.strip("\n") + "\n\n" + pointers).split("\n\n## "):
        title, _, body = block.removeprefix("## ").partition("\n\n")
        current[title] = body
    current.update(sections)
    return own + "\n\n" + render_sections(current)


def graph_review_of(draft_id: str) -> dict[str, Any]:
    """The graph review that holds for the draft's current digest (T08, Spec
    §2 « Relecteur de graphe »), asked of the command that owns that state.
    No review for this digest, a refusal left without Benjamin's decision:
    the door refuses, in the words of that command."""
    argv = [tool_path("GRAPH_REVIEW_BIN", "graph-review"), "check", draft_id]
    env = {**os.environ, "BD_BIN": BD_BIN, "GRAPH_REVIEW_BD_WORKSPACE": str(BD_WORKSPACE)}
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, env=env)
        payload = json.loads(proc.stdout)
    except (OSError, json.JSONDecodeError) as exc:
        raise PublishError(
            f"refus : la relecture de graphe du brouillon {draft_id} n'a pas pu être lue ({exc}) ; rien n'est écrit"
        ) from exc
    if proc.returncode != 0 or not payload.get("ok", False):
        raise PublishError(str(payload.get("error") or f"{' '.join(argv)} failed"))
    return {key: payload[key] for key in ("pass", "digest", "same_model", "model_independence", "decisions")}


def new_flow_ticket_description(ticket: dict[str, Any]) -> str:
    """The text of a ticket of the new flow: what the approved draft says,
    and no copied execution contract (Spec §2, prose de procédé)."""
    sections = [("What to build", str(ticket["what_it_delivers"]).strip())]
    kind = ticket["kind"]
    if kind in KINDS_WITH_DEMONSTRATION:
        sections.append(("Demonstration line", text_field(ticket, "demonstration_line")))
    if ticket.get("establishes_launch_recipe") is True:
        sections.append((
            "Launch recipe",
            "Cette tranche établit la recette de lancement du projet : son profil n'en déclare pas encore.",
        ))
    if kind == "prefactoring":
        sections.append(("Unblocks", text_field(ticket, "unblocks")))
    if kind == "repair":
        restores = ticket["restores"]
        sections.append(("Restores", f"{restores['kind']} : {text_field(restores, 'ref')}"))
    sections.append(("Acceptance criteria", "\n".join(
        f"- [ ] Point d'entrée : {text_field(criterion, 'entry_point')} — "
        f"Observable : {text_field(criterion, 'observable')} — "
        f"Faux si : {text_field(criterion, 'false_if')}"
        for criterion in ticket["acceptance_criteria"]
    )))
    sections.append(("Target rigs", ", ".join(str(item) for item in ticket["target_rigs"])))
    return "\n\n".join(f"## {title}\n\n{body}" for title, body in sections)


def mark_new_flow_convoy(draft_id: str, tickets: list[dict[str, Any]], mapping: dict[str, str]) -> list[str]:
    """Pose the new-flow mark on the convoy just published, each ticket with
    its demonstration line, through the state command: the only writer of
    the durable state of a marked convoy (T33). The beads it returns are the
    ones it marked on this run."""
    convoy_id = mapping["_convoy"]
    argv = [tool_path("CONVOY_STATE_BIN", "convoy-state"), "mark", convoy_id]
    for ticket in tickets:
        bead_id = mapping[str(ticket["id"])]
        if ticket["kind"] in KINDS_WITH_DEMONSTRATION:
            argv += ["--demonstration-line", f"{bead_id}={text_field(ticket, 'demonstration_line')}"]
        if ticket["kind"] == KIND_COVERING_STORIES:
            argv += ["--user-stories", f"{bead_id}={','.join(cited_user_stories(ticket) or [])}"]
        if ticket.get("establishes_launch_recipe") is True:
            argv += ["--establishes-launch-recipe", bead_id]
        if ticket.get("prototype_fold") is True:
            argv += ["--prototype-fold", bead_id]
    try:
        # From the tracker's own directory: the state command reaches it
        # through `gc`, which resolves its city from the working directory.
        return [str(item) for item in run_subtool(argv, cwd=BD_WORKSPACE)["marked"]]
    except PublishError as exc:
        raise PublishError(
            f"le brouillon {draft_id} est publié (convoi {convoy_id}) mais la marque du nouveau flux "
            f"n'a pas pu être posée : {exc}. Tant qu'il n'est pas marqué, ce convoi est lu comme un "
            "convoi de l'ancien flux. Rien d'autre n'a été fait (réservation et Mayor intouchés) : "
            "relancer la même commande, elle reprend au marquage."
        ) from exc


# --- integration branch of the Spec (T18, Spec af-wf4w5r §4) -----------------

RIG_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def integration_target(draft_id: str, tickets: list[dict[str, Any]], config_dir: Path, repo_root: Path) -> dict[str, Any]:
    """Where the integration branch of the Spec is opened: the repository of
    the one rig the graph targets, and its protected branch, both read in
    that rig's project file. Checked before any write: a marked convoy is
    never published without the branch its tickets are merged into."""
    def refuse(reason: str) -> PublishError:
        return PublishError(
            f"refus : le brouillon {draft_id} déclare le contrat du nouveau flux ({NEW_FLOW}) et la branche "
            f"d'intégration de sa Spec ne peut pas être ouverte : {reason} ; rien n'est écrit")

    rigs = sorted({str(rig) for ticket in tickets for rig in ticket.get("target_rigs") or []})
    if len(rigs) != 1:
        raise refuse(
            f"le graphe cible {len(rigs)} rigs ({', '.join(rigs) or 'aucun'}), or une Spec se livre sur une "
            "seule branche d'intégration, dans le dépôt d'un seul rig")
    rig = rigs[0]
    path = config_dir / f"{rig}.toml"
    if not RIG_NAME.match(rig) or not path.is_file():
        raise refuse(f"le rig {rig} n'a pas de fichier de projet ({path})")
    try:
        project = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise refuse(f"le fichier de projet du rig {rig} ({path}) est illisible : {exc}") from exc
    rig_dir, protected = project.get("rig_dir"), project.get("protected_branch")
    if not isinstance(rig_dir, str) or not rig_dir or not isinstance(protected, str) or not protected:
        raise refuse(f"le fichier de projet du rig {rig} ({path}) ne déclare pas rig_dir et protected_branch")
    repo = repo_root / rig_dir
    try:
        proc = subprocess.run(
            ["git", "-C", str(repo), "rev-parse", "--git-dir"], capture_output=True, text=True)
    except OSError as exc:
        raise refuse(f"impossible de lancer git : {exc}") from exc
    if proc.returncode != 0:
        raise refuse(f"le dépôt du rig {rig} ({repo}) n'est pas un dépôt Git")
    return {"rig": rig, "repo": repo, "protected": protected}


def open_integration_branch(draft_id: str, convoy_id: str, target: dict[str, Any]) -> dict[str, Any]:
    """Open the integration branch of the Spec the convoy delivers, at the
    tip of the protected branch, through bin/spec-integration, which records
    it on the convoy. Opening it again changes nothing."""
    argv = [
        tool_path("SPEC_INTEGRATION_BIN", "spec-integration"), "open", convoy_id,
        "--repo", str(target["repo"]), "--protected", target["protected"],
    ]
    try:
        opened = run_subtool(argv, cwd=BD_WORKSPACE)
    except PublishError as exc:
        raise PublishError(
            f"le brouillon {draft_id} est publié et marqué (convoi {convoy_id}) mais la branche d'intégration "
            f"de sa Spec n'a pas pu être ouverte : {exc}. Rien d'autre n'a été fait (réservation et Mayor "
            "intouchés) : relancer la même commande, elle reprend à l'ouverture de la branche."
        ) from exc
    return {name: opened[name] for name in ("branch", "protected", "base", "created")}


def ticket_description(ticket: dict[str, Any], execution: dict[str, Any]) -> str:
    criteria = "\n".join(f"- [ ] {item}" for item in ticket["acceptance_criteria"])
    rigs = ", ".join(str(item) for item in ticket["target_rigs"])
    contract = "\n".join(f"- {key}: {value}" for key, value in execution.items())
    return (
        f"## What to build\n\n{ticket['what_it_delivers']}\n\n"
        f"## Acceptance criteria\n\n{criteria}\n\n"
        f"## Target rigs\n\n{rigs}\n\n"
        f"## Autonomous execution contract\n\n{contract}"
    )


def acceptance_criteria_from_description(description: str) -> list[str]:
    """Extract the checklist rendered by `ticket_description` under
    `## Acceptance criteria`, so a reslice patch can prove it is unchanged
    against the live Bead text without a second source of truth.
    """
    items: list[str] = []
    in_section = False
    for line in description.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            in_section = stripped[3:].strip().lower() == "acceptance criteria"
            continue
        if in_section and stripped.startswith("- [ ]"):
            items.append(stripped[len("- [ ]"):].strip())
    return items


MAX_ESCALATION_LINE = 140


def truncate_line(text: str, limit: int = MAX_ESCALATION_LINE) -> str:
    text = " ".join(text.split())
    if len(text) <= limit:
        return text
    return text[: limit - 1] + "…"


def escalate_reslice_refusal(
    convoy_id: str, ticket_key: str, ticket_bead_id: str, author: str, reason: str,
) -> None:
    """Best-effort NEEDS BENJAMIN entry for a reslice `patch` refused because
    it would have changed acceptance criteria without a Planning Run (O09):
    a failed escalation must never look like a quietly-dropped refusal, but
    it also must not turn an already-failing patch into a crash.

    T05: `escalation-door benjamin` refuses anything but a JSON object
    carrying quoi/pourquoi/que_faire (options, each with its consequence)
    and langue -- a bare reason string (this call's shape before T05) no
    longer satisfies that contract.
    """
    escalation_door = os.environ.get("ESCALATION_DOOR_BIN", str(ROOT / "bin" / "escalation-door"))
    operator_config_bin = tool_path("OPERATOR_CONFIG_BIN", "operator-config")
    try:
        language = operator_language(operator_config_bin)
    except PublishError:
        return
    quoi = truncate_line(
        f"Reslice refusé : {ticket_key} ({ticket_bead_id}) changerait ses critères d'acceptation"
    )
    pourquoi = truncate_line(
        f"Un reslice Mayor-first (patch de {author}) ne peut pas changer des critères déjà "
        "publiés sans un nouveau Planning Run."
    )
    payload = json.dumps({
        "quoi": quoi,
        "pourquoi": pourquoi,
        "que_faire": [
            {
                "option": truncate_line("Lancer un Planning Run pour re-approuver le graphe"),
                "consequence": truncate_line(
                    "Les nouveaux critères sont republiés après approbation ; le patch reprend ensuite."
                ),
                "recommande": True,
                "raison": truncate_line(reason),
            },
            {
                "option": truncate_line("Republier le patch sans ce changement de critères"),
                "consequence": truncate_line(f"{ticket_key} garde ses critères déjà publiés."),
            },
        ],
        "langue": language,
    }, ensure_ascii=False)
    try:
        subprocess.run(
            [escalation_door, "benjamin", convoy_id, payload],
            check=False, capture_output=True, text=True,
        )
    except OSError:
        pass


def graph_plan(draft: dict[str, Any], tickets: list[dict[str, Any]], describe: Any = None) -> dict[str, Any]:
    """`describe` renders the text of a ticket of the new flow; without it
    the ticket carries the text of the flow before T05."""
    artifact = draft["artifact"]
    spec = artifact["source_spec"]
    digest = artifact["content_digest"]
    execution = as_dict(draft.get("global_execution_contract"), "global_execution_contract")
    # Convoy title and labels come from the draft; the fallbacks keep the
    # first published graph (the project-agnostic refactor) byte-identical.
    graph_title = str(artifact.get("title") or "Project-agnostic Agent Factory refactor")
    graph_labels = [str(item) for item in as_list(
        artifact.get("labels") or ["approved-ticket-graph", "factory-refactor"], "artifact.labels"
    )]
    ticket_labels = [label for label in graph_labels if label != "approved-ticket-graph"]
    convoy_metadata = {
        "gc.graph_digest": digest,
        "gc.plane": "delivery",
        "gc.artifact_id": artifact["id"],
        "gc.spec_id": spec["id"],
        "gc.spec_digest": spec["digest"],
        "gc.publication_validated": "true",
    }
    project_id = artifact.get("project_id")
    if project_id:
        convoy_metadata["gc.project_id"] = str(project_id)
    nodes: list[dict[str, Any]] = [
        {
            "key": "_convoy",
            "type": "convoy",
            "title": graph_title,
            "description": (
                f"Approved delivery graph: {graph_title}. "
                "The Mayor advances only positively eligible delivery-plane children."
            ),
            "labels": graph_labels,
            "metadata": convoy_metadata,
        }
    ]
    edges: list[dict[str, str]] = []
    for ticket in tickets:
        ticket_id = str(ticket["id"])
        metadata = {
            "gc.graph_digest": digest,
            "gc.plane": "delivery",
            "gc.delivery_contract": "pr-ci-merged-v1",
            "gc.ticket_id": ticket_id,
            "gc.ticket_kind": str(ticket.get("kind") or "vertical_slice"),
            "gc.artifact_id": artifact["id"],
            "gc.spec_id": spec["id"],
            "gc.spec_digest": spec["digest"],
            "gc.publication_validated": "true",
            "gc.blocked_by": ",".join(sorted(str(b) for b in ticket["blocked_by"])),
        }
        split_from = str(ticket.get("split_from") or "").strip()
        if split_from:
            metadata["gc.split_from"] = split_from
        scope_paths = ticket_scope_paths(ticket, ticket_id)
        if scope_paths:
            metadata["gc.scope_paths"] = ",".join(scope_paths)
        nodes.append({
            "key": ticket_id,
            "type": "task",
            "priority": 1,
            "title": f"{ticket_id} — {ticket['title']}",
            "description": describe(ticket) if describe else ticket_description(ticket, execution),
            "labels": ["approved-ticket-graph", "delivery-plane", *ticket_labels],
            "metadata": metadata,
        })
        edges.append({"from_key": "_convoy", "to_key": ticket_id, "type": "tracks"})
        for blocker in ticket["blocked_by"]:
            edges.append({"from_key": ticket_id, "to_key": str(blocker), "type": "blocks"})
    return {"nodes": nodes, "edges": edges}


def graph_members(digest: str) -> dict[str, dict[str, str]]:
    """All Beads already published under `digest`, keyed by ticket id (or
    `_convoy`), each with its bead id and current status -- unlike
    `existing_graph` this does not assert a node count, so a patch can look
    up a prior graph whose ticket count differs from the revision being
    applied.
    """
    return members_among(all_issues(), digest)


def all_issues() -> list[dict[str, Any]]:
    payload = json.loads(run("list", "--all", "--limit", "0", "--json").stdout or "[]")
    return [issue for issue in payload if isinstance(issue, dict)] if isinstance(payload, list) else []


def member_entry(issue: dict[str, Any]) -> dict[str, Any]:
    metadata = issue.get("metadata") if isinstance(issue.get("metadata"), dict) else {}
    return {
        "id": str(issue["id"]),
        "status": str(issue.get("status") or ""),
        "title": str(issue.get("title") or ""),
        "description": str(issue.get("description") or ""),
        "blocked_by": str(metadata.get("gc.blocked_by") or ""),
        "metadata": metadata,
    }


def members_among(issues: list[dict[str, Any]], digest: str) -> dict[str, dict[str, Any]]:
    members: dict[str, dict[str, Any]] = {}
    for issue in issues:
        entry = member_entry(issue)
        if entry["metadata"].get("gc.graph_digest") != digest:
            continue
        key = str(entry["metadata"].get("gc.ticket_id") or "_convoy")
        if key in members:
            raise PublishError(f"graph {digest} has duplicate key {key}")
        members[key] = entry
    return members


def existing_graph(digest: str, ticket_count: int) -> dict[str, str] | None:
    members = graph_members(digest)
    if not members:
        return None
    expected = ticket_count + 1
    if len(members) != expected:
        raise PublishError(
            f"existing graph {digest} is partial: expected {expected} nodes, found {len(members)}"
        )
    return {key: entry["id"] for key, entry in members.items()}


def publish(plan: dict[str, Any], digest: str, ticket_count: int) -> dict[str, str]:
    already = existing_graph(digest, ticket_count)
    if already is not None:
        return already
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json") as handle:
        json.dump(plan, handle, ensure_ascii=False)
        handle.flush()
        result = json.loads(run("create", "--graph", handle.name, "--json").stdout)
    mapping = result.get("ids") if isinstance(result, dict) else None
    if not isinstance(mapping, dict) or len(mapping) != ticket_count + 1:
        raise PublishError("Beads graph transaction returned an incomplete ID mapping")
    return {str(key): str(value) for key, value in mapping.items()}


def blockers_first(keys: list[str], ticket_by_key: dict[str, dict[str, Any]]) -> list[str]:
    """The tickets of a revision, each after the ones it waits for, and
    otherwise in the order of the draft: a published ticket may wait for a
    ticket the same patch adds (a repair that blocks it), which must then
    exist first. The graph is acyclic (`validate_tickets`)."""
    ordered: list[str] = []
    remaining = list(keys)
    while remaining:
        ready = next(
            key for key in remaining
            if all(str(blocker) in ordered for blocker in ticket_by_key[key]["blocked_by"])
        )
        ordered.append(ready)
        remaining.remove(ready)
    return ordered


def patch(
    draft: dict[str, Any], plan: dict[str, Any], tickets: list[dict[str, Any]],
    author: str, reason: str, reslice: bool,
    old_members: dict[str, dict[str, Any]] | None = None, new_flow: bool = False,
) -> dict[str, Any]:
    """Apply an immutable revised draft to the unfinished tickets of the
    graph it revises -- the same deterministic door as `publish`, extended
    for B08's "validated patch to unfinished work through the sole
    to-tickets authority" instead of a second decomposition mechanism, and
    for decision 8's reorder/merge/supersede without a second Planning Run
    (ADR-0028 amended).

    A revised ticket already published and closed (delivered) can never be
    touched: the revision must route new/changed scope through new ticket
    ids instead. `merges`/`supersedes` targets follow the same rule -- a
    patch never rewrites delivered history, only unfinished work.

    `--reslice` marks a Mayor reslice applied without a fresh Planning Run:
    every unfinished ticket the patch touches must keep the acceptance
    criteria already published on its Bead, checked against the live
    description text (the sole source of truth), or the whole patch is
    refused and escalated to NEEDS BENJAMIN before anything is written.
    Without `--reslice` (a draft revised and re-approved by a Planning Run)
    acceptance criteria may change freely, as before.

    `old_members` is the graph being revised when the caller has already
    read it; for a convoy of the new flow it is every ticket the convoy
    tracks, whatever digest it was last published under, and the convoy
    tracks each ticket the patch adds (`new_flow`).
    """
    old_digest = str(draft["artifact"].get("revises") or "").strip()
    if not old_digest:
        raise PublishError("artifact.revises must be a non-empty string")
    new_digest = draft["artifact"]["content_digest"]
    if old_members is None:
        old_members = graph_members(old_digest)
    if not old_members:
        raise PublishError(f"no published graph found for revised digest {old_digest}")

    convoy_id = old_members.get("_convoy", {}).get("id")
    if convoy_id is None:
        raise PublishError(f"revised graph {old_digest} has no convoy node")

    by_key = {node["key"]: node for node in plan["nodes"]}
    ticket_by_key = {str(ticket["id"]): ticket for ticket in tickets}
    ordered_ticket_keys = [str(ticket["id"]) for ticket in tickets]

    def closed_targets(key: str, target_keys: list[str]) -> None:
        for target_key in target_keys:
            if target_key not in old_members:
                raise PublishError(f"{key} references unknown {target_key} to merge/supersede")
            member = old_members[target_key]
            if member["status"] == "closed":
                raise PublishError(
                    f"{target_key} ({member['id']}) is already delivered; patch cannot modify a closed ticket"
                )

    # Pass 1: validate everything before writing anything -- a partially
    # applied patch (ADR-0028 §6) is worse than a refused one.
    for key in ordered_ticket_keys:
        ticket = ticket_by_key[key]
        merge_targets = [str(m) for m in as_list(ticket.get("merges", []), f"{key}.merges")]
        supersedes = str(ticket.get("supersedes") or "").strip()
        closed_targets(key, merge_targets + ([supersedes] if supersedes else []))
        if key in old_members:
            member = old_members[key]
            if member["status"] == "closed":
                raise PublishError(f"{key} ({member['id']}) is already delivered; patch cannot modify a closed ticket")
            if reslice:
                existing_ac = acceptance_criteria_from_description(member["description"])
                new_ac = [str(item) for item in ticket["acceptance_criteria"]]
                if existing_ac != new_ac:
                    escalate_reslice_refusal(convoy_id, key, member["id"], author, reason)
                    raise PublishError(
                        f"{key} ({member['id']}) acceptance criteria changed in a reslice patch; "
                        "refused and escalated to NEEDS BENJAMIN"
                    )

    created: dict[str, str] = {}
    updated: list[str] = []
    merged: dict[str, str] = {}
    superseded: dict[str, str] = {}

    def resolve_id(key: str) -> str:
        if key in old_members:
            return old_members[key]["id"]
        if key in created:
            return created[key]
        raise PublishError(f"{key} is neither already published nor created earlier in this patch")

    # Pass 2: apply. Validation above guarantees every closed-target and
    # acceptance-criteria check has already passed.
    if new_flow:
        ordered_ticket_keys = blockers_first(ordered_ticket_keys, ticket_by_key)
    for key in ordered_ticket_keys:
        node = by_key[key]
        ticket = ticket_by_key[key]
        if key in old_members:
            member = old_members[key]
            wanted_blocked_by = {str(b) for b in ticket["blocked_by"]}
            previous_blocked_by = {b for b in member["blocked_by"].split(",") if b}
            if new_flow:
                # A revision never carries a delivered ticket, so it cannot
                # name one among the blockers: the ticket keeps the delivered
                # blockers it had (its author receives their Handoff, T11).
                wanted_blocked_by |= {
                    b for b in previous_blocked_by
                    if b not in ticket_by_key and old_members.get(b, {}).get("status") == "closed"
                }
            scope_metadata_args = (
                ["--set-metadata", f"gc.scope_paths={node['metadata']['gc.scope_paths']}"]
                if "gc.scope_paths" in node["metadata"] else []
            )
            run(
                "update", member["id"],
                "--title", node["title"],
                "--description", node["description"],
                "--set-metadata", f"gc.graph_digest={new_digest}",
                "--set-metadata", "gc.publication_validated=true",
                "--set-metadata", f"gc.blocked_by={','.join(sorted(wanted_blocked_by))}",
                *scope_metadata_args,
                *(["--set-metadata", f"gc.spec_digest={node['metadata']['gc.spec_digest']}"] if new_flow else []),
            )
            for added in sorted(wanted_blocked_by - previous_blocked_by):
                run("dep", "add", member["id"], resolve_id(added))
            for removed in sorted(previous_blocked_by - wanted_blocked_by):
                try:
                    removed_id = resolve_id(removed)
                except PublishError:
                    continue
                run("dep", "remove", member["id"], removed_id)
            updated.append(key)
            resulting_id = member["id"]
        else:
            edge_ids = as_list(node.get("_blocked_by_keys", []), f"{key}._blocked_by_keys")
            # The added ticket waits for its blockers. `--deps blocks:<id>`
            # is the reverse edge: on bd 1.2.2 it makes <id> wait for the new
            # ticket (T48, af-1zxao6; tests/fake-tool-contract-test.py).
            deps = ",".join(f"depends-on:{resolve_id(str(edge_key))}" for edge_key in edge_ids)
            if not new_flow:
                deps = f"tracks:{convoy_id}" + (f",{deps}" if deps else "")
            metadata_json = json.dumps(node["metadata"], ensure_ascii=False)
            result = run(
                "create", "--title", node["title"], "--description", node["description"],
                "--type", "task", "--priority", str(node.get("priority", 1)),
                "--labels", ",".join(node["labels"]), "--metadata", metadata_json,
                *(["--deps", deps] if deps else []), "--silent",
            )
            created[key] = result.stdout.strip()
            resulting_id = created[key]
            if new_flow:
                # The convoy tracks the ticket, as the `tracks` edges of the
                # graph transaction do: `--deps tracks:<convoy>` on the new
                # ticket is the reverse edge, which bin/convoy-state does
                # not read (observed on bd 1.2.2).
                run("dep", "add", convoy_id, resulting_id, "--type", "tracks")

        merge_targets = [str(m) for m in as_list(ticket.get("merges", []), f"{key}.merges")]
        for target_key in merge_targets:
            target_id = old_members[target_key]["id"]
            run(
                "update", target_id, "--status", "closed",
                "--set-metadata", f"gc.merged_into={resulting_id}",
                "--append-notes", f"MERGED by {author}: {reason}",
            )
            merged[target_key] = resulting_id
        supersedes = str(ticket.get("supersedes") or "").strip()
        if supersedes:
            target = old_members[supersedes]
            target_id = target["id"]
            run(
                "update", target_id, "--status", "closed",
                "--set-metadata", f"gc.superseded_by={resulting_id}",
                "--append-notes", f"SUPERSEDED by {author}: {reason}",
            )
            superseded[supersedes] = resulting_id
            # O04: a re-planned ticket inherits the superseded ticket's
            # in-flight work (branch, base branch, open PR) instead of the
            # next worker starting over -- otherwise every reslice throws
            # away a branch/PR that is still perfectly good to resume.
            inherited = {
                inherit_key: value
                for inherit_key in ("gc.work_branch", "gc.work_base_branch", "gc.pr_url")
                if (value := target.get("metadata", {}).get(inherit_key))
            }
            if inherited:
                set_metadata_args = [
                    arg for k, v in inherited.items() for arg in ("--set-metadata", f"{k}={v}")
                ]
                run(
                    "update", resulting_id, *set_metadata_args,
                    "--append-notes",
                    f"Inherited work from superseded {supersedes} ({target_id}): "
                    + ", ".join(f"{k}={v}" for k, v in inherited.items()),
                )

    if old_members["_convoy"]["status"] != "closed":
        run(
            "update", convoy_id,
            "--set-metadata", f"gc.graph_digest={new_digest}",
            "--set-metadata", "gc.publication_validated=true",
            "--set-metadata", f"gc.patch_author={author}",
            "--set-metadata", f"gc.patch_reason={reason}",
            *(["--set-metadata", f"gc.spec_digest={draft['artifact']['source_spec']['digest']}"] if new_flow else []),
            "--append-notes", f"PATCH by {author}: {reason}",
        )

    mapping = {"_convoy": convoy_id, **{key: old_members[key]["id"] for key in old_members if key != "_convoy"}}
    mapping.update(created)
    return {
        "ids": mapping,
        "patched": sorted(updated),
        "created": sorted(created),
        "merged": merged,
        "superseded": superseded,
    }


def mayor_city() -> Path:
    """The city whose Mayor is woken: FACTORY_ROOT if set, else this tool's
    own repository root -- the same resolution every other Factory tool uses
    (bin/provider-failover, bin/factory-observe, the bash guards). Never the
    caller's cwd: the now-retired Planning Run router ran on a `po/*`
    worktree by design (F18), where `gc` walking up from cwd finds no
    running city, and the Mayor silently stayed asleep after the A6 publish
    (2026-09-29)."""
    return Path(os.environ.get("FACTORY_ROOT") or ROOT)


def notify_mayor(command: str, graph_digest: str, convoy_id: str | None) -> dict[str, Any]:
    """Wake the Mayor at the end of a successful publish or patch (O02):
    this is the only door approved work enters by, so a silent Mayor after
    publication is the single point of failure for the whole delivery plane
    (the idle-ready-work order is only the safety net for when this call is
    itself missed). A mail delivery failure must not turn a successful
    publish into a reported failure -- but it must be LOUD: the returned
    fields go into the result JSON (`mayor_notified` false +
    `mayor_notify_error`) and a warning goes to stderr.

    The mail targets the live city explicitly (`gc --city <mayor_city()>`,
    run from that directory), whatever the caller's cwd.

    Runs by default (O02, W02): approved work must never wait for a manual
    nudge, so a successful publish or patch wakes the Mayor unless the caller
    switches it off explicitly with SKIP_MAYOR_NOTIFY_ENV. Only tests set that
    flag; a default invocation notifies. When skipped, `mayor_notified` is
    null: not attempted.
    """
    if os.environ.get(SKIP_MAYOR_NOTIFY_ENV):
        return {"mayor_notified": None}
    city = mayor_city()
    subject = f"ticket-graph-{command}: {graph_digest}"
    body = (
        f"ACTION: ticket-graph-publish {command} completed\n"
        f"STATE: published\n"
        f"EVIDENCE: graph_digest={graph_digest}"
        + (f" convoy={convoy_id}" if convoy_id else "")
        + "\n"
        "NEXT: dispatch newly ready delivery-plane tickets"
    )
    try:
        proc = subprocess.run(
            [GC_BIN, "--city", str(city), "mail", "send", "mayor", "--notify", "-s", subject, "-m", body],
            cwd=str(city), check=False, capture_output=True, text=True,
            timeout=MAYOR_NOTIFY_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        error = f"could not run gc mail send: {exc}"
    else:
        if proc.returncode == 0:
            return {"mayor_notified": True, "mayor_city": str(city)}
        detail = (proc.stderr or proc.stdout or "").strip() or "no output"
        error = f"gc mail send exited {proc.returncode}: {detail}"
    print(
        f"{PROGRAM}: WARNING: {command} succeeded but the Mayor was NOT woken "
        f"(city {city}): {error}",
        file=sys.stderr,
    )
    return {"mayor_notified": False, "mayor_notify_error": error, "mayor_city": str(city)}


# --- bd-publish / bd-patch (A6b, W05: live Beads-backed Ticket Graph Draft) -


def canonical_bead_digest(description: str) -> str:
    """Identical digest formula to spec-approve's bead-mode Spec digest
    (W04): sha256 of the raw description text. The file mode's
    `legacy_boundary` scoping marker has no bead-mode equivalent -- the
    Spec text says the marker itself goes for this mode."""
    return "sha256:" + hashlib.sha256(description.encode("utf-8")).hexdigest()


def bd_show(issue_id: str) -> dict[str, Any]:
    out = run("show", issue_id, "--json").stdout
    try:
        data = json.loads(out)
    except json.JSONDecodeError as exc:
        raise PublishError(f"bd show {issue_id} returned invalid JSON: {exc}") from exc
    if isinstance(data, list):
        if not data:
            raise PublishError(f"issue not found: {issue_id}")
        data = data[0]
    return as_dict(data, f"bd show {issue_id}")


def tool_path(env_var: str, name: str) -> str:
    override = os.environ.get(env_var)
    if override:
        return override
    return str(Path(__file__).resolve().parent / name)


def run_subtool(argv: list[str], cwd: Path | None = None, stdin: str | None = None) -> dict[str, Any]:
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, env=os.environ.copy(), cwd=cwd, input=stdin)
    except OSError as exc:
        raise PublishError(f"could not run {argv[0]}: {exc}") from exc
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        detail = proc.stderr.strip() or proc.stdout.strip()
        raise PublishError(f"{' '.join(argv)} returned invalid JSON: {detail or exc}") from exc
    if proc.returncode != 0 or not payload.get("ok", False):
        raise PublishError(payload.get("error", f"{' '.join(argv)} failed"))
    return payload


def declared_human_approver(project: str, config_dir: Path, profile_bin: str) -> str:
    return run_subtool(
        [profile_bin, "human-approver", "--project", project, "--config-dir", str(config_dir)]
    )["human_approver"]


def operator_language(operator_config_bin: str) -> str:
    """The Operator Language (`bin/operator-config language`), so a graph's
    declared `language` metadata can be checked against it (T05, .6/.8)."""
    try:
        proc = subprocess.run([operator_config_bin, "language"], capture_output=True, text=True)
    except OSError as exc:
        raise PublishError(f"could not run {operator_config_bin}: {exc}") from exc
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise PublishError(f"{operator_config_bin} language failed: {detail}")
    return proc.stdout.strip()


def reservation_check(target: str | None, repo_root: Path, reservation_bin: str) -> dict[str, Any]:
    argv = [reservation_bin, "--repo-root", str(repo_root), "check"]
    if target:
        argv += ["--target", target]
    return run_subtool(argv)


def reservation_advance(repo_root: Path, reservation_bin: str) -> dict[str, Any]:
    return run_subtool([reservation_bin, "--repo-root", str(repo_root), "advance"])


def load_approved_spec_bead(spec_id: str) -> dict[str, Any]:
    spec_bead = bd_show(spec_id)
    metadata = spec_bead.get("metadata") or {}
    if metadata.get("spec_state") != "APPROVED_SPEC":
        raise PublishError(
            f"refused: source Spec {spec_id} is not approved (spec_state={metadata.get('spec_state')!r})"
        )
    actual_digest = canonical_bead_digest(spec_bead.get("description") or "")
    approved_digest = metadata.get("approved_digest")
    if approved_digest != actual_digest:
        raise PublishError(
            f"refused: source Spec {spec_id} digest differs from its approved digest "
            f"(approved {approved_digest!r}, current {actual_digest!r})"
        )
    return spec_bead


def load_approved_bead_draft(
    draft_id: str, human_approver: str, bead: dict[str, Any] | None = None, require_approval: bool = True,
) -> tuple[dict[str, Any], list[dict[str, Any]], dict[str, Any], str]:
    """`require_approval` is False only for a patch of the new flow that
    carries no approval at all: it is then held to what a patch may do
    without one (`unapproved_patch_refusals`)."""
    if bead is None:
        bead = bd_show(draft_id)
    metadata = bead.get("metadata") or {}
    description = str(bead.get("description") or "")
    digest = canonical_bead_digest(description)

    if require_approval:
        approved_by = str(metadata.get("approved_by") or "").strip()
        if approved_by != human_approver:
            raise PublishError(
                f"refused: draft approver {approved_by!r} is not the project's declared "
                f"human approver {human_approver!r}"
            )
        if not str(metadata.get("approved_evidence") or "").strip():
            raise PublishError("refused: draft has no approval evidence")
        approved_digest = metadata.get("approved_digest")
        if approved_digest != digest:
            raise PublishError(
                f"refused: draft tickets changed after approval (approved digest {approved_digest!r}, "
                f"current digest {digest!r})"
            )

    try:
        parsed = yaml.safe_load(description) or {}
    except yaml.YAMLError as exc:
        raise PublishError(f"draft bead {draft_id} description is not valid YAML: {exc}") from exc
    parsed = as_dict(parsed, f"draft bead {draft_id} description")
    tickets = validate_tickets(as_list(parsed.get("tickets"), "tickets"))
    return bead, tickets, parsed, digest


def bead_compat_draft(
    draft_id: str, parsed: dict[str, Any], digest: str, spec_id: str, spec_digest: str,
    revises: str | None, bead: dict[str, Any],
    display_title: str | None = None, project_id: str | None = None,
) -> dict[str, Any]:
    """A `graph_plan`-shaped `draft` dict built from bead data, so bead mode
    reuses `graph_plan`/`publish`/`patch` unchanged instead of a second
    decomposition mechanism."""
    artifact: dict[str, Any] = {
        "id": draft_id,
        "content_digest": digest,
        "source_spec": {"id": spec_id, "state": "APPROVED_SPEC", "digest": spec_digest},
    }
    if bead.get("title"):
        artifact["title"] = bead["title"]
    # T05: bd-publish's display title takes precedence over the bd bead's
    # own (often technical) title -- it is what the convoy shows Benjamin.
    if display_title:
        artifact["title"] = display_title
    if project_id:
        artifact["project_id"] = project_id
    if bead.get("labels"):
        artifact["labels"] = bead["labels"]
    if revises:
        artifact["revises"] = revises
    return {"artifact": artifact, "global_execution_contract": parsed.get("global_execution_contract") or {}}


def cmd_bd_publish(args: argparse.Namespace) -> int:
    repo_root = Path(args.repo_root)
    config_dir = Path(args.config_dir) if args.config_dir else repo_root / "config" / "projects"
    profile_bin = tool_path("PROJECT_PLANNING_PROFILE_BIN", "project-planning-profile")
    reservation_bin = tool_path("PLANNING_RUN_RESERVATION_BIN", "planning-run-reservation")
    operator_config_bin = tool_path("OPERATOR_CONFIG_BIN", "operator-config")

    draft_id = str(args.draft)
    human_approver = declared_human_approver(args.project, config_dir, profile_bin)
    bead, tickets, parsed, digest = load_approved_bead_draft(draft_id, human_approver)
    metadata = bead.get("metadata") or {}
    spec_id = str(metadata.get("spec_id") or "").strip()
    if not spec_id:
        raise PublishError("refused: draft bead has no spec_id")
    new_flow = flow_contract(parsed, draft_id) == NEW_FLOW
    spec_bead = load_approved_spec_bead(spec_id)
    spec_digest = canonical_bead_digest(spec_bead.get("description") or "")
    graph_review: dict[str, Any] = {}
    if not new_flow:
        refuse_prototype_tickets(tickets)

    # T05 (.6, .8): a graph's display title and project key are obligatory,
    # and its declared language must be the Operator Language -- publishing
    # never falls back to a silent English default or an unclaimed project.
    display_title = str(metadata.get("display_title") or "").strip()
    if not display_title:
        raise PublishError(f"refused: draft bead {draft_id} has no display_title")
    language = str(metadata.get("language") or "").strip()
    expected_language = operator_language(operator_config_bin)
    if language != expected_language:
        raise PublishError(
            f"refused: draft bead {draft_id} declares language {language!r}, "
            f"the Operator Language is {expected_language!r}"
        )
    project_id = str((spec_bead.get("metadata") or {}).get("gc.project_id") or "").strip()
    if not project_id:
        raise PublishError(f"refused: source Spec {spec_id} has no project key (gc.project_id)")

    describe = None
    if new_flow:
        # The whole entry contract, before any write: the tickets (T05), then
        # the graph against its Spec and its project (T06).
        spec = spec_view(spec_id, spec_bead)
        launch, descriptor = project_launch(project_id, descriptors_dir(args, repo_root), profile_bin)
        sources = CitationSources(spec, lambda: integration_target(draft_id, tickets, config_dir, repo_root), None)
        refusals = entry_contract_refusals(parsed, tickets, spec, sources)
        refusals += operator_need_refusals(parsed, metadata, human_approver, draft_id)
        if "withdrawn" in parsed:
            refusals.append((WHERE_DRAFT, "withdrawn : une première publication ne retire aucun ticket (porte de patch)"))
        graph = [graph_ticket(ticket, spec["stories"]) for ticket in tickets]
        refusals += graph_refusals(graph, spec, launch, project_id, descriptor)
        refuse_unless_contract_met(draft_id, refusals)
        integration = integration_target(draft_id, tickets, config_dir, repo_root)
        graph_review = {"graph_review": graph_review_of(draft_id)}
        describe = new_flow_describe(graph, spec, launch)

    scope_edges = add_scope_overlap_edges(tickets)
    record_scope_overlaps(scope_edges, tickets, digest)
    compat_draft = bead_compat_draft(
        draft_id, parsed, digest, spec_id, spec_digest, None, bead,
        display_title=display_title, project_id=project_id,
    )
    plan = graph_plan(compat_draft, tickets, describe=describe)
    for node, ticket in zip((n for n in plan["nodes"] if n["key"] != "_convoy"), tickets):
        node["_blocked_by_keys"] = [str(b) for b in ticket["blocked_by"]]

    mapping = publish(plan, digest, len(tickets))
    new_flow_result: dict[str, Any] = {}
    if new_flow:
        new_flow_result = {FLOW_CONTRACT_KEY: NEW_FLOW, "marked": mark_new_flow_convoy(draft_id, tickets, mapping)}
        # Spec §4: one integration branch per Spec, opened when its convoy is
        # published; a convoy without the mark gets none.
        new_flow_result["integration"] = open_integration_branch(draft_id, mapping["_convoy"], integration)

    target = str((spec_bead.get("metadata") or {}).get("planning_run_target") or "").strip() or None
    reservation_advanced = None
    try:
        check = reservation_check(target, repo_root, reservation_bin)
        if check.get("active") and check.get("allowed"):
            reservation_advanced = reservation_advance(repo_root, reservation_bin)
    except PublishError as exc:
        reservation_advanced = {"ok": False, "error": str(exc)}

    # Spec §0 rule 3: code starts the tickets of a marked convoy, not the
    # Mayor -- so the Mayor is not handed a marked convoy to dispatch.
    notice = {"mayor_notified": None} if new_flow else notify_mayor("publish", digest, mapping.get("_convoy"))
    print(json.dumps({
        "ok": True,
        "graph_digest": digest,
        "ids": mapping,
        "scope_edges": scope_edges,
        "reservation_advanced": reservation_advanced,
        **new_flow_result,
        **graph_review,
        **notice,
    }, ensure_ascii=False, sort_keys=True))
    return 0


def descriptors_dir(args: argparse.Namespace, repo_root: Path) -> Path:
    return Path(args.descriptors_dir) if args.descriptors_dir else repo_root / "config" / "project-descriptors"


def new_flow_describe(graph: list[dict[str, Any]], spec: dict[str, Any], launch: dict[str, Any] | None) -> Any:
    """The text of a published ticket of the new flow: what the approved
    draft says of it, then the pointers the door poses."""
    by_key = {ticket["key"]: ticket for ticket in graph}

    def describe(ticket: dict[str, Any]) -> str:
        pointers = pointer_sections(by_key[str(ticket["id"])], graph, spec, launch)
        return new_flow_ticket_description(ticket) + "\n\n" + render_sections(pointers)

    return describe


def declared_contract(bead: dict[str, Any], draft_id: str) -> str | None:
    """The contract the draft bead declares, read before anything else is
    checked; a text that cannot be read declares none, and is refused by the
    checks that follow."""
    try:
        parsed = yaml.safe_load(str(bead.get("description") or ""))
    except yaml.YAMLError:
        return None
    return flow_contract(parsed, draft_id) if isinstance(parsed, dict) else None


def convoy_state(convoy_id: str) -> dict[str, Any] | None:
    """The durable state of a convoy as bin/convoy-state renders it, or None
    for a convoy that does not carry the new-flow mark. An « état sans règle »
    is still a state: what the door needs of it is read as it is."""
    argv = [tool_path("CONVOY_STATE_BIN", "convoy-state"), "show", convoy_id]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, env=os.environ.copy(), cwd=BD_WORKSPACE)
        payload = json.loads(proc.stdout)
    except (OSError, json.JSONDecodeError) as exc:
        raise PublishError(f"could not read the state of convoy {convoy_id} ({' '.join(argv)}): {exc}") from exc
    if proc.returncode == 4:
        return None
    if proc.returncode not in (0, 3) or not isinstance(payload.get("tickets"), list):
        raise PublishError(payload.get("error") or f"{' '.join(argv)} failed")
    return payload


def published_ticket(member: dict[str, Any], state: dict[str, Any]) -> dict[str, Any]:
    """A ticket the convoy already tracks, as the graph checks and the
    pointers read it: its entry fields come from bin/convoy-state."""
    key = str(member["metadata"].get("gc.ticket_id") or "")
    kind = state.get("kind") if state.get("kind") in TICKET_KINDS else None
    line = state.get("demonstration_line")
    covered = state.get("user_stories")
    return {
        "key": key,
        "kind": kind,
        "title": member["title"].removeprefix(f"{key} — "),
        "demonstration_line": line if isinstance(line, str) else None,
        "user_stories": covered if isinstance(covered, list) else None,
        "restored_story": None,
        "establishes": state.get("establishes_launch_recipe") is True,
        "fold": state.get("prototype_fold") is True,
        "prototype": posed_prototype(member["description"]),
        "restores_anchor": False,
        "posed_prototype": f"\n\n## {PROTOTYPE_POINTER}\n\n" in member["description"],
        "closed": member["status"] == "closed",
        "blocked_by": [blocker for blocker in member["blocked_by"].split(",") if blocker],
    }


def frozen_field_refusals(ticket: dict[str, Any], state: dict[str, Any]) -> list[str]:
    """What a revision may not change of a ticket already published: the
    fields frozen with the approved graph and kept by bin/convoy-state."""
    drafted = graph_ticket(ticket, {})
    if ticket.get("kind") != state.get("kind"):
        return [
            f"genre changé ({state.get('kind')} → {one_line(ticket.get('kind'))}) : le genre d'un ticket publié est "
            "gelé avec le graphe approuvé ; un autre genre est un autre ticket"
        ]
    reasons: list[str] = []
    if drafted["demonstration_line"] != state.get("demonstration_line"):
        reasons.append(
            "ligne de démonstration changée : elle est gelée avec le graphe approuvé "
            f"(publiée : « {truncate_line(str(state.get('demonstration_line')), MAX_QUOTED_CRITERION)} ») ; "
            "une autre observation est un autre ticket"
        )
    if drafted["user_stories"] != state.get("user_stories") and drafted["user_stories"] is not None:
        reasons.append(
            f"user stories changées ({', '.join(state.get('user_stories') or [])} → "
            f"{', '.join(drafted['user_stories'])}) : elles sont gelées avec le graphe approuvé"
        )
    if drafted["establishes"] != (state.get("establishes_launch_recipe") is True):
        reasons.append("establishes_launch_recipe changé : ce champ est gelé avec le graphe approuvé")
    if drafted["fold"] != (state.get("prototype_fold") is True):
        reasons.append("prototype_fold changé : ce champ est gelé avec le graphe approuvé")
    return reasons


def unapproved_patch_refusals(
    parsed: dict[str, Any], tickets: list[dict[str, Any]], members: dict[str, dict[str, Any]], human_approver: str,
) -> list[tuple[str, str]]:
    """Spec §2, genre `repair`: while it stays inside the approved intent, a
    repair needs no new approval. Mechanically: the patch only adds repair
    tickets -- each naming what it restores, as any repair -- to a graph it
    otherwise leaves as published; a published ticket may only gain an added
    repair among its blockers. A blocker already delivered cannot be carried
    by a revision: leaving it out is not a reordering, the ticket keeps it
    (a ticket blocked technically has every blocker closed, T11)."""
    refusals: list[tuple[str, str]] = []
    added = {str(ticket["id"]) for ticket in tickets if str(ticket["id"]) not in members}
    if parsed.get("withdrawn"):
        refusals.append((WHERE_DRAFT, "retire un ticket (withdrawn) : un retrait demande l'approbation du graphe révisé"))
    for ticket in tickets:
        key = str(ticket["id"])
        if key in added:
            if ticket.get("kind") != "repair":
                refusals.append((
                    key, f"ajouté avec le genre {one_line(ticket.get('kind'))} : seul un repair s'ajoute sans approbation"))
            continue
        member = members[key]
        try:
            unchanged = member["description"].startswith(new_flow_ticket_description(ticket) + POINTERS_START)
        except (KeyError, TypeError):  # a ticket the entry contract already refuses
            unchanged = False
        if not unchanged:
            refusals.append((key, "modifié : son texte publié diffère de celui du brouillon"))
        published = {
            blocker for blocker in member["blocked_by"].split(",")
            if blocker and members.get(blocker, {}).get("status") != "closed"
        }
        drafted = {str(blocker) for blocker in ticket["blocked_by"]}
        if not published <= drafted or not drafted - published <= added:
            refusals.append((
                key,
                "réordonné : un ticket publié ne peut que gagner un repair ajouté parmi ses bloqueurs "
                f"(publié : {', '.join(sorted(published)) or 'aucun'} ; brouillon : {', '.join(sorted(drafted)) or 'aucun'})",
            ))
    if refusals:
        refusals.insert(0, (
            WHERE_DRAFT,
            f"ce patch n'a pas l'approbation de {human_approver} (approved_by, approved_evidence, approved_digest "
            "absents) : sans approbation, la porte ne publie que des tickets repair ajoutés à un graphe laissé "
            "tel que publié",
        ))
    return refusals


def withdrawal_refusals(
    parsed: dict[str, Any], tickets: list[dict[str, Any]], members: dict[str, dict[str, Any]],
    register: str | None,
) -> tuple[dict[str, str], list[tuple[str, str]]]:
    """Spec §9: a ticket leaves the graph only by a resolved Planning
    Exception. Returns the withdrawn tickets (key -> Planning Exception) and
    why the withdrawal is refused."""
    if "withdrawn" not in parsed:
        return {}, []
    entries = parsed["withdrawn"]
    expected = "attendu : une liste de {ticket, planning_exception}"
    if not isinstance(entries, list) or not entries:
        return {}, [(WHERE_DRAFT, f"withdrawn mal formé ({expected})")]
    decisions: dict[str, Any] | None = None
    refusals: list[tuple[str, str]] = []
    if not register:
        refusals.append((
            WHERE_DRAFT,
            "le brouillon retire un ticket et le registre des Planning Exceptions n'est pas donné "
            "(--planning-exception-register) : un retrait suit une Planning Exception résolue",
        ))
    else:
        status = run_subtool([tool_path("PLANNING_EXCEPTION_BIN", "planning-exception"), "status", register])
        decisions = status.get("decisions") if isinstance(status.get("decisions"), dict) else {}
    drafted = {str(ticket["id"]) for ticket in tickets}
    withdrawn: dict[str, str] = {}
    for entry in entries:
        if not isinstance(entry, dict) or not isinstance(entry.get("ticket"), str) or set(entry) - set(WITHDRAWN_FIELDS):
            refusals.append((WHERE_DRAFT, f"withdrawn mal formé : « {truncate_line(str(entry))} » ({expected})"))
            continue
        key = entry["ticket"]
        decision = entry.get("planning_exception")
        if key not in members:
            refusals.append((key, "retiré, mais le convoi ne suit aucun ticket de ce nom"))
            continue
        if key in withdrawn:
            refusals.append((key, "retiré deux fois"))
            continue
        withdrawn[key] = str(decision or "")
        if key in drafted:
            refusals.append((key, "retiré et repris par le même brouillon : un ticket retiré n'y figure plus"))
        if members[key]["status"] == "closed":
            refusals.append((key, f"retiré, mais {members[key]['id']} est fermé : un ticket livré ou déjà retiré ne se retire pas"))
        if not isinstance(decision, str) or not decision.strip():
            refusals.append((key, "retiré sans Planning Exception (champ planning_exception : l'identifiant de la décision résolue)"))
        elif decisions is not None and decisions.get(decision) != "resolved":
            state = decisions.get(decision)
            refusals.append((
                key,
                f"retiré, mais la Planning Exception {decision} n'est pas résolue "
                f"({'inconnue du registre' if state is None else f'état : {state}'})",
            ))
    # A ticket left out of the revision that waits for a withdrawn one would
    # become ready with nothing delivered behind it.
    for key, member in members.items():
        waited = sorted({blocker for blocker in member["blocked_by"].split(",") if blocker} & set(withdrawn))
        if waited and key not in drafted and key not in withdrawn and member["status"] != "closed":
            refusals.append((
                key,
                f"attend {', '.join(waited)}, retiré par ce patch, et le brouillon révisé ne dit pas ce qu'il devient "
                "(le reprendre sans ce bloqueur, ou le retirer aussi)",
            ))
    return withdrawn, refusals


def withdraw_tickets(
    convoy_id: str, withdrawn: dict[str, str], members: dict[str, dict[str, Any]], author: str, reason: str,
) -> dict[str, str]:
    """Close each withdrawn ticket behind its gate record (`withdrawn`,
    written by bin/convoy-state): a ticket closed without one is an « état
    sans règle ». A ticket already closed is left as it is."""
    done: dict[str, str] = {}
    for key, decision in withdrawn.items():
        member = members[key]
        done[key] = member["id"]
        if member["status"] == "closed":
            continue
        run_subtool(
            [tool_path("CONVOY_STATE_BIN", "convoy-state"), "record-gate", convoy_id, member["id"], "--gate", "withdrawn"],
            cwd=BD_WORKSPACE,
        )
        run(
            "update", member["id"], "--status", "closed",
            "--append-notes", f"WITHDRAWN by {author} (Planning Exception {decision}): {reason}",
        )
    return done


def cmd_bd_patch_new_flow(args: argparse.Namespace, bead: dict[str, Any], human_approver: str) -> int:
    """`bd-patch` on a draft that declares the new-flow contract: the entry
    contract applies as it is to what the patch adds, and the graph checks
    to the graph that results from it. Everything is checked before any
    write."""
    repo_root = Path(args.repo_root)
    profile_bin = tool_path("PROJECT_PLANNING_PROFILE_BIN", "project-planning-profile")
    draft_id = str(args.draft)
    metadata = bead.get("metadata") or {}
    if args.reslice:
        raise PublishError(
            f"refus : --reslice sur le brouillon {draft_id}, qui déclare le contrat du nouveau flux ({NEW_FLOW}) : "
            "le reslice est le geste du Mayor, qui ne modifie pas les tickets d'un convoi marqué ; rien n'est écrit"
        )
    approved = any(str(metadata.get(key) or "").strip() for key in ("approved_by", "approved_evidence", "approved_digest"))
    bead, tickets, parsed, digest = load_approved_bead_draft(draft_id, human_approver, bead, require_approval=approved)
    spec_id = str(metadata.get("spec_id") or "").strip()
    if not spec_id:
        raise PublishError("refused: draft bead has no spec_id")
    spec_bead = load_approved_spec_bead(spec_id)
    revises = str(metadata.get("revises_digest") or "").strip()
    if not revises:
        raise PublishError("refused: draft bead metadata.revises_digest must be a non-empty string")
    project_id = str((spec_bead.get("metadata") or {}).get("gc.project_id") or "").strip()
    if not project_id:
        raise PublishError(f"refused: source Spec {spec_id} has no project key (gc.project_id)")

    issues = all_issues()
    # A patch already applied (its convoy carries this draft's digest) is
    # only completed: withdrawals and marking, both idempotent.
    resumed = "_convoy" in members_among(issues, digest)
    convoy = (members_among(issues, digest) if resumed else members_among(issues, revises)).get("_convoy")
    if convoy is None:
        raise PublishError(
            f"refus : aucun convoi publié ne porte le digest que le brouillon {draft_id} révise ({revises}) ; "
            "un brouillon révise le graphe tel qu'il est publié aujourd'hui ; rien n'est écrit"
        )
    convoy_id = convoy["id"]
    state = convoy_state(convoy_id)
    if state is None:
        raise PublishError(
            f"refus : le brouillon {draft_id} déclare le contrat du nouveau flux ({NEW_FLOW}) et le convoi qu'il "
            f"révise ({convoy_id}) ne porte pas la marque du nouveau flux : un convoi est révisé au contrat sous "
            "lequel il a été publié ; rien n'est écrit"
        )
    published_spec = str(convoy["metadata"].get("gc.spec_id") or "")
    if published_spec != spec_id:
        raise PublishError(
            f"refus : le brouillon {draft_id} est lié à la Spec {spec_id} et le convoi qu'il révise ({convoy_id}) "
            f"a été publié depuis la Spec {published_spec or '(aucune)'} : un graphe est révisé contre la Spec "
            "dont il vient ; rien n'est écrit"
        )
    states = {str(ticket.get("id")): ticket for ticket in state["tickets"] if isinstance(ticket, dict)}
    members: dict[str, dict[str, Any]] = {}
    for issue in issues:
        if str(issue.get("id")) not in states:
            continue
        entry = member_entry(issue)
        key = str(entry["metadata"].get("gc.ticket_id") or "")
        if not key or key in members:
            raise PublishError(f"convoy {convoy_id} tracks a ticket without a ticket id, or two with the same: {entry['id']}")
        members[key] = entry
    spec = spec_view(spec_id, spec_bead)
    spec_digest = spec["digest"]
    launch, descriptor = project_launch(project_id, descriptors_dir(args, repo_root), profile_bin)
    withdrawn = {
        str(entry["ticket"]): str(entry.get("planning_exception") or "")
        for entry in (parsed.get("withdrawn") or []) if isinstance(entry, dict) and entry.get("ticket") in members
    } if resumed and isinstance(parsed.get("withdrawn"), list) else {}
    result: dict[str, Any]
    scope_edges: list[dict[str, str]] = []

    if resumed:
        result = {
            "ids": {"_convoy": convoy_id, **{key: member["id"] for key, member in members.items()}},
            "patched": [], "created": [], "merged": {}, "superseded": {}, "resumed": True,
        }
    else:
        config_dir = Path(args.config_dir) if args.config_dir else repo_root / "config" / "projects"
        sources = CitationSources(spec, lambda: integration_target(draft_id, tickets, config_dir, repo_root), state)
        refusals = entry_contract_refusals(parsed, tickets, spec, sources)
        for ticket in tickets:
            key = str(ticket["id"])
            if key not in members:
                continue
            if members[key]["status"] == "closed":
                refusals.append((
                    key,
                    f"repris alors que {members[key]['id']} est fermé : un patch ne modifie pas un ticket livré ; "
                    "le brouillon révisé ne le reprend pas",
                ))
            elif ticket.get("kind") in TICKET_KINDS:
                refusals += [(key, reason) for reason in frozen_field_refusals(ticket, states[members[key]["id"]])]
        withdrawn, withdrawal = withdrawal_refusals(parsed, tickets, members, args.planning_exception_register)
        refusals += withdrawal
        if not approved:
            refusals += unapproved_patch_refusals(parsed, tickets, members, human_approver)
        refusals += operator_need_refusals(parsed, metadata, human_approver, draft_id)

        # The graph that results from the patch: what the convoy tracks,
        # less what is withdrawn (now or before), with the revision on top.
        drafted = {str(ticket["id"]) for ticket in tickets}
        graph = [
            published_ticket(member, states[member["id"]])
            for key, member in members.items()
            if key not in drafted and key not in withdrawn
            and "withdrawn" not in (states[member["id"]].get("gates") or {})
        ] + [
            # The repair of a red of the mechanical fidelity is an interface
            # ticket, as the repair of an anchor (T40).
            {**graph_ticket(ticket, spec["stories"]),
             **({"restores_anchor": True} if sources.fidelity_red(ticket) else {})}
            for ticket in tickets
        ]
        refusals += graph_refusals(graph, spec, launch, project_id, descriptor)
        refuse_unless_contract_met(draft_id, refusals)

        scope_edges = add_scope_overlap_edges(tickets)
        record_scope_overlaps(scope_edges, tickets, digest)
        compat_draft = bead_compat_draft(draft_id, parsed, digest, spec_id, spec_digest, revises, bead)
        plan = graph_plan(compat_draft, tickets, describe=new_flow_describe(graph, spec, launch))
        for node, ticket in zip((n for n in plan["nodes"] if n["key"] != "_convoy"), tickets):
            node["_blocked_by_keys"] = [str(b) for b in ticket["blocked_by"]]
        result = patch(
            compat_draft, plan, tickets, args.author, args.reason, False,
            old_members={"_convoy": convoy, **members}, new_flow=True,
        )
        # The tickets the revision does not carry keep their text; their
        # pointers follow the graph (new sibling, amended Spec).
        by_key = {ticket["key"]: ticket for ticket in graph}
        for key, member in members.items():
            if key in drafted or key not in by_key or member["status"] == "closed":
                continue
            pointers = pointer_sections(by_key[key], graph, spec, launch)
            if by_key[key]["kind"] != KIND_COVERING_STORIES:
                del pointers["User stories"]
            description = repointed(member["description"], pointers)
            if description != member["description"]:
                run("update", member["id"], "--description", description)

    result["withdrawn"] = withdraw_tickets(convoy_id, withdrawn, members, args.author, args.reason)
    marked = mark_new_flow_convoy(draft_id, tickets, result["ids"])
    # Spec §0 rule 3: code starts the tickets of a marked convoy, not the Mayor.
    print(json.dumps({
        "ok": True,
        "graph_digest": digest,
        "revises": revises,
        "scope_edges": scope_edges,
        FLOW_CONTRACT_KEY: NEW_FLOW,
        "marked": marked,
        "approved": approved,
        "mayor_notified": None,
        **result,
    }, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_bd_patch(args: argparse.Namespace) -> int:
    if not (args.author or "").strip() or not (args.reason or "").strip():
        raise PublishError("--author and --reason are required for patch")
    repo_root = Path(args.repo_root)
    config_dir = Path(args.config_dir) if args.config_dir else repo_root / "config" / "projects"
    profile_bin = tool_path("PROJECT_PLANNING_PROFILE_BIN", "project-planning-profile")

    draft_id = str(args.draft)
    human_approver = declared_human_approver(args.project, config_dir, profile_bin)
    bead = bd_show(draft_id)
    if declared_contract(bead, draft_id) == NEW_FLOW:
        return cmd_bd_patch_new_flow(args, bead, human_approver)
    bead, tickets, parsed, digest = load_approved_bead_draft(draft_id, human_approver, bead)
    metadata = bead.get("metadata") or {}
    spec_id = str(metadata.get("spec_id") or "").strip()
    if not spec_id:
        raise PublishError("refused: draft bead has no spec_id")
    spec_bead = load_approved_spec_bead(spec_id)
    spec_digest = canonical_bead_digest(spec_bead.get("description") or "")
    revises = str(metadata.get("revises_digest") or "").strip()
    if not revises:
        raise PublishError("refused: draft bead metadata.revises_digest must be a non-empty string")
    revised = graph_members(revises)
    # A ticket added to a marked convoy is never weaker than an original one
    # (Spec §2, user story 12): a draft that does not declare the contract
    # does not revise a convoy published under it.
    if NEW_FLOW_MARK_KEY in (revised.get("_convoy") or {}).get("metadata", {}):
        raise PublishError(
            f"refus : le brouillon {draft_id} ne déclare pas le contrat du nouveau flux ({NEW_FLOW}) et le convoi "
            f"qu'il révise ({revised['_convoy']['id']}) en porte la marque : un ticket ajouté n'est jamais plus "
            "faible qu'un ticket d'origine ; rien n'est écrit"
        )
    refuse_prototype_tickets(tickets, frozenset(revised))

    scope_edges = add_scope_overlap_edges(tickets)
    record_scope_overlaps(scope_edges, tickets, digest)
    compat_draft = bead_compat_draft(draft_id, parsed, digest, spec_id, spec_digest, revises, bead)
    plan = graph_plan(compat_draft, tickets)
    for node, ticket in zip((n for n in plan["nodes"] if n["key"] != "_convoy"), tickets):
        node["_blocked_by_keys"] = [str(b) for b in ticket["blocked_by"]]

    result = patch(compat_draft, plan, tickets, args.author, args.reason, args.reslice)
    notice = notify_mayor("patch", digest, result["ids"].get("_convoy"))
    print(json.dumps({
        "ok": True,
        "graph_digest": digest,
        "revises": revises,
        "scope_edges": scope_edges,
        **result,
        **notice,
    }, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_lift_need(args: argparse.Namespace) -> int:
    """Record that a declared operator need is lifted, with the words of the
    project's human approver, on the draft bead that declares it."""
    config_dir = Path(args.config_dir) if args.config_dir else Path(args.repo_root) / "config" / "projects"
    profile_bin = tool_path("PROJECT_PLANNING_PROFILE_BIN", "project-planning-profile")
    draft_id, need_id = str(args.draft), str(args.need or "")
    human_approver = declared_human_approver(args.project, config_dir, profile_bin)
    bead = bd_show(draft_id)
    try:
        parsed = yaml.safe_load(str(bead.get("description") or "")) or {}
    except yaml.YAMLError as exc:
        raise PublishError(f"draft bead {draft_id} description is not valid YAML: {exc}") from exc
    needs = parsed.get("operator_needs") if isinstance(parsed, dict) else None
    declared = [need.get("id") for need in needs if isinstance(need, dict)] if isinstance(needs, list) else []
    if not OPERATOR_NEED_ID.match(need_id) or need_id not in declared:
        raise PublishError(
            f"refus : le brouillon {draft_id} ne déclare pas le besoin opérateur {need_id!r} "
            f"(déclarés : {', '.join(str(item) for item in declared) or 'aucun'}) ; rien n'est écrit"
        )
    if (args.by or "").strip() != human_approver:
        raise PublishError(
            f"refus : un besoin opérateur est levé par l'approbateur humain déclaré du projet ({human_approver!r}), "
            f"pas par {args.by!r} ; rien n'est écrit"
        )
    if not (args.evidence or "").strip():
        raise PublishError("refus : --evidence est vide : un besoin est levé avec les mots de l'approbateur ; rien n'est écrit")
    metadata = bead.get("metadata") or {}
    already = need_is_lifted(metadata, need_id, human_approver)
    if not already:
        record = json.dumps({
            "lifted_by": human_approver, "evidence": args.evidence.strip(),
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        }, ensure_ascii=False, sort_keys=True)
        run("update", draft_id, "--set-metadata", f"{OPERATOR_NEED_KEY}{need_id}={record}")
    print(json.dumps({"ok": True, "draft": draft_id, "need": need_id, "lifted_by": human_approver, "already": already},
                     ensure_ascii=False, sort_keys=True))
    return 0


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(prog=PROGRAM)
    value.add_argument("command", choices=("bd-publish", "bd-patch", "lift-need"))
    value.add_argument("draft", help="Ticket Graph Draft bead id")
    value.add_argument("--author", help="who authored this patch (required for bd-patch)")
    value.add_argument("--reason", help="why this patch was applied (required for bd-patch)")
    value.add_argument(
        "--reslice", action="store_true",
        help="Mayor reslice without a fresh Planning Run: refuse and escalate any acceptance-criteria change",
    )
    value.add_argument(
        "--project",
        help="project id whose config/projects/<id>.toml declares the human approver",
    )
    value.add_argument(
        "--repo-root", default=str(ROOT),
        help="repository root config/projects and the reservation live under",
    )
    value.add_argument(
        "--config-dir", default=None,
        help="directory holding config/projects/*.toml files (default: <repo-root>/config/projects)",
    )
    value.add_argument(
        "--descriptors-dir", default=None,
        help="directory holding the project profiles <project>.json, with their launch recipe "
             "(default: <repo-root>/config/project-descriptors)",
    )
    value.add_argument(
        "--planning-exception-register", default=None,
        help="bd-patch: the Planning Exception register a withdrawn ticket's decision is resolved in",
    )
    value.add_argument("--need", help="lift-need: id of the operator need the draft declares")
    value.add_argument("--by", help="lift-need: who lifts it (the project's declared human approver)")
    value.add_argument("--evidence", help="lift-need: the approver's exact words")
    return value


def main() -> int:
    try:
        args = parser().parse_args()
        if args.command == "bd-publish":
            return cmd_bd_publish(args)
        if args.command == "lift-need":
            return cmd_lift_need(args)
        return cmd_bd_patch(args)
    except (OSError, PublishError, json.JSONDecodeError) as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
