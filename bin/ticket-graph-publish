#!/usr/bin/env python3
"""Validate and atomically publish one approved Ticket Graph Draft to Beads."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

import yaml


PROGRAM = "ticket-graph-publish"
ROOT = Path(__file__).resolve().parents[1]
BD_BIN = os.environ.get("BD_BIN", "bd")
BD_WORKSPACE = Path(os.environ.get("TICKET_GRAPH_BD_WORKSPACE", str(ROOT)))
GC_BIN = os.environ.get("GC_BIN", "gc")
CONTENT_BOUNDARY = b"legacy_boundary:"


class PublishError(RuntimeError):
    pass


def run(*args: str) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            [BD_BIN, "-C", str(BD_WORKSPACE), *args],
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or str(exc)).strip()
        raise PublishError(detail) from exc


def scoped_digest(raw: bytes) -> str:
    raw = raw.replace(b"\r\n", b"\n")
    marker = b"\n" + CONTENT_BOUNDARY
    try:
        start = raw.index(marker) + 1
    except ValueError as exc:
        raise PublishError("draft has no legacy_boundary digest marker") from exc
    return "sha256:" + hashlib.sha256(raw[start:]).hexdigest()


def as_dict(value: Any, where: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise PublishError(f"{where} must be an object")
    return value


def as_list(value: Any, where: str) -> list[Any]:
    if not isinstance(value, list):
        raise PublishError(f"{where} must be a list")
    return value


def validate_draft(path: Path) -> tuple[dict[str, Any], list[dict[str, Any]]]:
    raw = path.read_bytes()
    try:
        value = yaml.safe_load(raw.decode("utf-8"))
    except (UnicodeDecodeError, yaml.YAMLError) as exc:
        raise PublishError(f"invalid UTF-8 YAML: {exc}") from exc
    draft = as_dict(value, "draft")
    artifact = as_dict(draft.get("artifact"), "artifact")
    if artifact.get("state") != "APPROVED_TICKET_GRAPH_DRAFT":
        raise PublishError("draft is not APPROVED_TICKET_GRAPH_DRAFT")
    if artifact.get("publication_authorized") is not True:
        raise PublishError("draft publication_authorized is not true")
    actual_digest = scoped_digest(raw)
    if artifact.get("content_digest") != actual_digest:
        raise PublishError(
            f"draft digest mismatch: declared {artifact.get('content_digest')!r}, actual {actual_digest}"
        )
    source_spec = as_dict(artifact.get("source_spec"), "artifact.source_spec")
    if source_spec.get("state") != "APPROVED_SPEC":
        raise PublishError("source Spec is not APPROVED_SPEC")
    spec_digest = str(source_spec.get("digest") or "")
    if not spec_digest.startswith("sha256:") or len(spec_digest) != 71:
        raise PublishError("source Spec digest is invalid")

    raw_tickets = as_list(draft.get("tickets"), "tickets")
    tickets = [as_dict(item, f"tickets[{index}]") for index, item in enumerate(raw_tickets)]
    if not tickets:
        raise PublishError("draft has no publishable tickets")
    ids = [str(ticket.get("id") or "").strip() for ticket in tickets]
    if any(not ticket_id for ticket_id in ids) or len(set(ids)) != len(ids):
        raise PublishError("ticket IDs must be non-empty and unique")
    known = set(ids)
    for ticket in tickets:
        ticket_id = str(ticket["id"])
        blockers = as_list(ticket.get("blocked_by"), f"{ticket_id}.blocked_by")
        unknown = sorted(str(item) for item in blockers if str(item) not in known)
        if unknown:
            raise PublishError(f"{ticket_id} has unknown blockers: {', '.join(unknown)}")
        if ticket_id in {str(item) for item in blockers}:
            raise PublishError(f"{ticket_id} blocks itself")
        if not str(ticket.get("title") or "").strip():
            raise PublishError(f"{ticket_id} has no title")
        if not str(ticket.get("what_it_delivers") or "").strip():
            raise PublishError(f"{ticket_id} has no autonomous outcome")
        if not as_list(ticket.get("acceptance_criteria"), f"{ticket_id}.acceptance_criteria"):
            raise PublishError(f"{ticket_id} has no acceptance criteria")
        if not as_list(ticket.get("target_rigs"), f"{ticket_id}.target_rigs"):
            raise PublishError(f"{ticket_id} has no target rigs")

    visiting: set[str] = set()
    visited: set[str] = set()
    by_id = {str(ticket["id"]): ticket for ticket in tickets}

    def visit(ticket_id: str) -> None:
        if ticket_id in visiting:
            raise PublishError(f"dependency cycle at {ticket_id}")
        if ticket_id in visited:
            return
        visiting.add(ticket_id)
        for blocker in by_id[ticket_id]["blocked_by"]:
            visit(str(blocker))
        visiting.remove(ticket_id)
        visited.add(ticket_id)

    for ticket_id in ids:
        visit(ticket_id)
    return draft, tickets


def ticket_description(ticket: dict[str, Any], execution: dict[str, Any]) -> str:
    criteria = "\n".join(f"- [ ] {item}" for item in ticket["acceptance_criteria"])
    rigs = ", ".join(str(item) for item in ticket["target_rigs"])
    contract = "\n".join(f"- {key}: {value}" for key, value in execution.items())
    return (
        f"## What to build\n\n{ticket['what_it_delivers']}\n\n"
        f"## Acceptance criteria\n\n{criteria}\n\n"
        f"## Target rigs\n\n{rigs}\n\n"
        f"## Autonomous execution contract\n\n{contract}"
    )


def acceptance_criteria_from_description(description: str) -> list[str]:
    """Extract the checklist rendered by `ticket_description` under
    `## Acceptance criteria`, so a reslice patch can prove it is unchanged
    against the live Bead text without a second source of truth.
    """
    items: list[str] = []
    in_section = False
    for line in description.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            in_section = stripped[3:].strip().lower() == "acceptance criteria"
            continue
        if in_section and stripped.startswith("- [ ]"):
            items.append(stripped[len("- [ ]"):].strip())
    return items


def escalate_reslice_refusal(convoy_id: str, reason: str) -> None:
    """Best-effort NEEDS BENJAMIN entry for a reslice `patch` refused because
    it would have changed acceptance criteria without a Planning Run (O09):
    a failed escalation must never look like a quietly-dropped refusal, but
    it also must not turn an already-failing patch into a crash.
    """
    escalation_door = os.environ.get("ESCALATION_DOOR_BIN", str(ROOT / "bin" / "escalation-door"))
    try:
        subprocess.run(
            [escalation_door, "benjamin", convoy_id, reason],
            check=False, capture_output=True, text=True,
        )
    except OSError:
        pass


def graph_plan(draft: dict[str, Any], tickets: list[dict[str, Any]]) -> dict[str, Any]:
    artifact = draft["artifact"]
    spec = artifact["source_spec"]
    digest = artifact["content_digest"]
    execution = as_dict(draft.get("global_execution_contract"), "global_execution_contract")
    # Convoy title and labels come from the draft; the fallbacks keep the
    # first published graph (the project-agnostic refactor) byte-identical.
    graph_title = str(artifact.get("title") or "Project-agnostic Agent Factory refactor")
    graph_labels = [str(item) for item in as_list(
        artifact.get("labels") or ["approved-ticket-graph", "factory-refactor"], "artifact.labels"
    )]
    ticket_labels = [label for label in graph_labels if label != "approved-ticket-graph"]
    nodes: list[dict[str, Any]] = [
        {
            "key": "_convoy",
            "type": "convoy",
            "title": graph_title,
            "description": (
                f"Approved delivery graph: {graph_title}. "
                "The Mayor advances only positively eligible delivery-plane children."
            ),
            "labels": graph_labels,
            "metadata": {
                "gc.graph_digest": digest,
                "gc.plane": "delivery",
                "gc.artifact_id": artifact["id"],
                "gc.spec_id": spec["id"],
                "gc.spec_digest": spec["digest"],
                "gc.publication_validated": "true",
            },
        }
    ]
    edges: list[dict[str, str]] = []
    for ticket in tickets:
        ticket_id = str(ticket["id"])
        metadata = {
            "gc.graph_digest": digest,
            "gc.plane": "delivery",
            "gc.delivery_contract": "pr-ci-merged-v1",
            "gc.ticket_id": ticket_id,
            "gc.ticket_kind": str(ticket.get("kind") or "vertical_slice"),
            "gc.artifact_id": artifact["id"],
            "gc.spec_id": spec["id"],
            "gc.spec_digest": spec["digest"],
            "gc.publication_validated": "true",
            "gc.blocked_by": ",".join(sorted(str(b) for b in ticket["blocked_by"])),
        }
        split_from = str(ticket.get("split_from") or "").strip()
        if split_from:
            metadata["gc.split_from"] = split_from
        nodes.append({
            "key": ticket_id,
            "type": "task",
            "priority": 1,
            "title": f"{ticket_id} — {ticket['title']}",
            "description": ticket_description(ticket, execution),
            "labels": ["approved-ticket-graph", "delivery-plane", *ticket_labels],
            "metadata": metadata,
        })
        edges.append({"from_key": "_convoy", "to_key": ticket_id, "type": "tracks"})
        for blocker in ticket["blocked_by"]:
            edges.append({"from_key": ticket_id, "to_key": str(blocker), "type": "blocks"})
    return {"nodes": nodes, "edges": edges}


def graph_members(digest: str) -> dict[str, dict[str, str]]:
    """All Beads already published under `digest`, keyed by ticket id (or
    `_convoy`), each with its bead id and current status -- unlike
    `existing_graph` this does not assert a node count, so a patch can look
    up a prior graph whose ticket count differs from the revision being
    applied.
    """
    payload = json.loads(run("list", "--all", "--limit", "0", "--json").stdout or "[]")
    members: dict[str, dict[str, str]] = {}
    for issue in payload if isinstance(payload, list) else []:
        metadata = issue.get("metadata") if isinstance(issue.get("metadata"), dict) else {}
        if metadata.get("gc.graph_digest") != digest:
            continue
        key = str(metadata.get("gc.ticket_id") or "_convoy")
        if key in members:
            raise PublishError(f"graph {digest} has duplicate key {key}")
        members[key] = {
            "id": str(issue["id"]),
            "status": str(issue.get("status") or ""),
            "description": str(issue.get("description") or ""),
            "blocked_by": str(metadata.get("gc.blocked_by") or ""),
        }
    return members


def existing_graph(digest: str, ticket_count: int) -> dict[str, str] | None:
    members = graph_members(digest)
    if not members:
        return None
    expected = ticket_count + 1
    if len(members) != expected:
        raise PublishError(
            f"existing graph {digest} is partial: expected {expected} nodes, found {len(members)}"
        )
    return {key: entry["id"] for key, entry in members.items()}


def publish(plan: dict[str, Any], digest: str, ticket_count: int) -> dict[str, str]:
    already = existing_graph(digest, ticket_count)
    if already is not None:
        return already
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json") as handle:
        json.dump(plan, handle, ensure_ascii=False)
        handle.flush()
        result = json.loads(run("create", "--graph", handle.name, "--json").stdout)
    mapping = result.get("ids") if isinstance(result, dict) else None
    if not isinstance(mapping, dict) or len(mapping) != ticket_count + 1:
        raise PublishError("Beads graph transaction returned an incomplete ID mapping")
    return {str(key): str(value) for key, value in mapping.items()}


def patch(
    draft: dict[str, Any], plan: dict[str, Any], tickets: list[dict[str, Any]],
    author: str, reason: str, reslice: bool,
) -> dict[str, Any]:
    """Apply an immutable revised draft to the unfinished tickets of the
    graph it revises -- the same deterministic door as `publish`, extended
    for B08's "validated patch to unfinished work through the sole
    to-tickets authority" instead of a second decomposition mechanism, and
    for decision 8's reorder/merge/supersede without a second Planning Run
    (ADR-0028 amended).

    A revised ticket already published and closed (delivered) can never be
    touched: the revision must route new/changed scope through new ticket
    ids instead. `merges`/`supersedes` targets follow the same rule -- a
    patch never rewrites delivered history, only unfinished work.

    `--reslice` marks a Mayor reslice applied without a fresh Planning Run:
    every unfinished ticket the patch touches must keep the acceptance
    criteria already published on its Bead, checked against the live
    description text (the sole source of truth), or the whole patch is
    refused and escalated to NEEDS BENJAMIN before anything is written.
    Without `--reslice` (a draft revised and re-approved by a Planning Run)
    acceptance criteria may change freely, as before.
    """
    old_digest = str(draft["artifact"].get("revises") or "").strip()
    if not old_digest:
        raise PublishError("artifact.revises must be a non-empty string")
    new_digest = draft["artifact"]["content_digest"]
    old_members = graph_members(old_digest)
    if not old_members:
        raise PublishError(f"no published graph found for revised digest {old_digest}")

    convoy_id = old_members.get("_convoy", {}).get("id")
    if convoy_id is None:
        raise PublishError(f"revised graph {old_digest} has no convoy node")

    by_key = {node["key"]: node for node in plan["nodes"]}
    ticket_by_key = {str(ticket["id"]): ticket for ticket in tickets}
    ordered_ticket_keys = [str(ticket["id"]) for ticket in tickets]

    def closed_targets(key: str, target_keys: list[str]) -> None:
        for target_key in target_keys:
            if target_key not in old_members:
                raise PublishError(f"{key} references unknown {target_key} to merge/supersede")
            member = old_members[target_key]
            if member["status"] == "closed":
                raise PublishError(
                    f"{target_key} ({member['id']}) is already delivered; patch cannot modify a closed ticket"
                )

    # Pass 1: validate everything before writing anything -- a partially
    # applied patch (ADR-0028 §6) is worse than a refused one.
    for key in ordered_ticket_keys:
        ticket = ticket_by_key[key]
        merge_targets = [str(m) for m in as_list(ticket.get("merges", []), f"{key}.merges")]
        supersedes = str(ticket.get("supersedes") or "").strip()
        closed_targets(key, merge_targets + ([supersedes] if supersedes else []))
        if key in old_members:
            member = old_members[key]
            if member["status"] == "closed":
                raise PublishError(f"{key} ({member['id']}) is already delivered; patch cannot modify a closed ticket")
            if reslice:
                existing_ac = acceptance_criteria_from_description(member["description"])
                new_ac = [str(item) for item in ticket["acceptance_criteria"]]
                if existing_ac != new_ac:
                    escalation_reason = (
                        f"reslice patch for {key} ({member['id']}) would change acceptance criteria "
                        f"without a Planning Run -- author={author}, reason={reason}"
                    )
                    escalate_reslice_refusal(convoy_id, escalation_reason)
                    raise PublishError(
                        f"{key} ({member['id']}) acceptance criteria changed in a reslice patch; "
                        "refused and escalated to NEEDS BENJAMIN"
                    )

    created: dict[str, str] = {}
    updated: list[str] = []
    merged: dict[str, str] = {}
    superseded: dict[str, str] = {}

    def resolve_id(key: str) -> str:
        if key in old_members:
            return old_members[key]["id"]
        if key in created:
            return created[key]
        raise PublishError(f"{key} is neither already published nor created earlier in this patch")

    # Pass 2: apply. Validation above guarantees every closed-target and
    # acceptance-criteria check has already passed.
    for key in ordered_ticket_keys:
        node = by_key[key]
        ticket = ticket_by_key[key]
        if key in old_members:
            member = old_members[key]
            wanted_blocked_by = {str(b) for b in ticket["blocked_by"]}
            previous_blocked_by = {b for b in member["blocked_by"].split(",") if b}
            run(
                "update", member["id"],
                "--title", node["title"],
                "--description", node["description"],
                "--set-metadata", f"gc.graph_digest={new_digest}",
                "--set-metadata", "gc.publication_validated=true",
                "--set-metadata", f"gc.blocked_by={','.join(sorted(wanted_blocked_by))}",
            )
            for added in sorted(wanted_blocked_by - previous_blocked_by):
                run("dep", "add", member["id"], resolve_id(added))
            for removed in sorted(previous_blocked_by - wanted_blocked_by):
                try:
                    removed_id = resolve_id(removed)
                except PublishError:
                    continue
                run("dep", "remove", member["id"], removed_id)
            updated.append(key)
            resulting_id = member["id"]
        else:
            edge_ids = as_list(node.get("_blocked_by_keys", []), f"{key}._blocked_by_keys")
            deps = ",".join(f"blocks:{resolve_id(str(edge_key))}" for edge_key in edge_ids)
            deps = f"tracks:{convoy_id}" + (f",{deps}" if deps else "")
            metadata_json = json.dumps(node["metadata"], ensure_ascii=False)
            result = run(
                "create", "--title", node["title"], "--description", node["description"],
                "--type", "task", "--priority", str(node.get("priority", 1)),
                "--labels", ",".join(node["labels"]), "--metadata", metadata_json,
                "--deps", deps, "--silent",
            )
            created[key] = result.stdout.strip()
            resulting_id = created[key]

        merge_targets = [str(m) for m in as_list(ticket.get("merges", []), f"{key}.merges")]
        for target_key in merge_targets:
            target_id = old_members[target_key]["id"]
            run(
                "update", target_id, "--status", "closed",
                "--set-metadata", f"gc.merged_into={resulting_id}",
                "--append-notes", f"MERGED by {author}: {reason}",
            )
            merged[target_key] = resulting_id
        supersedes = str(ticket.get("supersedes") or "").strip()
        if supersedes:
            target_id = old_members[supersedes]["id"]
            run(
                "update", target_id, "--status", "closed",
                "--set-metadata", f"gc.superseded_by={resulting_id}",
                "--append-notes", f"SUPERSEDED by {author}: {reason}",
            )
            superseded[supersedes] = resulting_id

    if old_members["_convoy"]["status"] != "closed":
        run(
            "update", convoy_id,
            "--set-metadata", f"gc.graph_digest={new_digest}",
            "--set-metadata", "gc.publication_validated=true",
            "--set-metadata", f"gc.patch_author={author}",
            "--set-metadata", f"gc.patch_reason={reason}",
            "--append-notes", f"PATCH by {author}: {reason}",
        )

    mapping = {"_convoy": convoy_id, **{key: old_members[key]["id"] for key in old_members if key != "_convoy"}}
    mapping.update(created)
    return {
        "ids": mapping,
        "patched": sorted(updated),
        "created": sorted(created),
        "merged": merged,
        "superseded": superseded,
    }


def notify_mayor(command: str, graph_digest: str, convoy_id: str | None) -> None:
    """Wake the Mayor at the end of a successful publish or patch (O02):
    this is the only door approved work enters by, so a silent Mayor after
    publication is the single point of failure for the whole delivery plane
    (the idle-ready-work order is only the safety net for when this call is
    itself missed). Best-effort: a mail delivery failure must not turn a
    successful publish into a reported failure.
    """
    subject = f"ticket-graph-{command}: {graph_digest}"
    body = (
        f"ACTION: ticket-graph-publish {command} completed\n"
        f"STATE: published\n"
        f"EVIDENCE: graph_digest={graph_digest}"
        + (f" convoy={convoy_id}" if convoy_id else "")
        + "\n"
        "NEXT: dispatch newly ready delivery-plane tickets"
    )
    try:
        subprocess.run(
            [GC_BIN, "mail", "send", "mayor", "--notify", "-s", subject, "-m", body],
            check=False, capture_output=True, text=True,
        )
    except OSError:
        pass


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(prog=PROGRAM)
    value.add_argument("command", choices=("validate", "publish", "patch"))
    value.add_argument("draft", type=Path)
    value.add_argument("--author", help="who authored this patch (required for patch)")
    value.add_argument("--reason", help="why this patch was applied (required for patch)")
    value.add_argument(
        "--reslice", action="store_true",
        help="Mayor reslice without a fresh Planning Run: refuse and escalate any acceptance-criteria change",
    )
    return value


def main() -> int:
    try:
        args = parser().parse_args()
        draft, tickets = validate_draft(args.draft)
        plan = graph_plan(draft, tickets)
        for node, ticket in zip((n for n in plan["nodes"] if n["key"] != "_convoy"), tickets):
            node["_blocked_by_keys"] = [str(b) for b in ticket["blocked_by"]]
        if args.command == "validate":
            print(json.dumps({
                "ok": True,
                "graph_digest": draft["artifact"]["content_digest"],
                "ticket_count": len(tickets),
                "node_count": len(plan["nodes"]),
                "edge_count": len(plan["edges"]),
            }, ensure_ascii=False, sort_keys=True))
            return 0
        if args.command == "patch":
            if not (args.author or "").strip() or not (args.reason or "").strip():
                raise PublishError("--author and --reason are required for patch")
            result = patch(draft, plan, tickets, args.author, args.reason, args.reslice)
            graph_digest = draft["artifact"]["content_digest"]
            notify_mayor("patch", graph_digest, result["ids"].get("_convoy"))
            print(json.dumps({
                "ok": True,
                "graph_digest": graph_digest,
                "revises": draft["artifact"]["revises"],
                **result,
            }, ensure_ascii=False, sort_keys=True))
            return 0
        graph_digest = draft["artifact"]["content_digest"]
        mapping = publish(plan, graph_digest, len(tickets))
        notify_mayor("publish", graph_digest, mapping.get("_convoy"))
        print(json.dumps({
            "ok": True,
            "graph_digest": graph_digest,
            "ids": mapping,
        }, ensure_ascii=False, sort_keys=True))
        return 0
    except (OSError, PublishError, json.JSONDecodeError) as exc:
        print(f"{PROGRAM}: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
