#!/usr/bin/env python3
"""Promote and resume a durable Wayfinding Run (B04).

A Wayfinding Run is one Planning Map Bead plus non-executable Planning
Decision Beads. This tool implements its lifecycle directly against a JSON
map file: `promote` creates the map before material decision loss on work
that exceeds one healthy session; `claim`/`resolve` let one disposable
session claim and resolve one decision, recording evidence in the map;
`pause`/`resume`/`abandon` move the whole run without depending on any
session transcript. Every object this tool writes carries positive
`plane: planning` / `delivery_routable: false` metadata, and `route-check`
proves a delivery router (which requires positive `plane: delivery`) would
reject it.

Concurrent `claim`/`resolve` calls against the same map file are safe: every
mutation takes an OS-level exclusive lock (`fcntl.flock`) around a read-
modify-write, so two sessions claiming different decisions at the same time
never lose an update, and two sessions racing the same decision produce
exactly one winner -- the real mechanism P03's
`planning-map-concurrency-prototype` proved synthetically.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import sys
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Iterator


PROGRAM = "wayfinding-run"
MAP_CONTRACT = "agent-factory-wayfinding-run/v1"
REQUEST_CONTRACT = "agent-factory-wayfinding-run-request/v1"

OPEN = "open"
CLAIMED = "claimed"
RESOLVED = "resolved"

ACTIVE = "active"
PAUSED = "paused"
ABANDONED = "abandoned"
TO_SPEC_READY = "to_spec_ready"


class WayfindingError(RuntimeError):
    """An actionable diagnostic about a Wayfinding Run."""


def as_dict(value: Any, name: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise WayfindingError(f"{name} must be an object")
    return value


def as_list(value: Any, name: str) -> list[Any]:
    if not isinstance(value, list):
        raise WayfindingError(f"{name} must be an array")
    return value


def required_string(value: Any, name: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise WayfindingError(f"{name} must be a non-empty string")
    return value


@contextmanager
def locked_map(path: Path, create: bool = False) -> Iterator[dict[str, Any]]:
    """Exclusive-lock a map file for one atomic read-modify-write.

    The lock is held for the whole `with` body, so a concurrent `claim` or
    `resolve` against the same file blocks until this one finishes and
    writes back -- no interleaved read can observe a half-applied mutation,
    and no writer can silently overwrite another writer's update.
    """
    if create:
        if path.exists():
            raise WayfindingError(f"refusing to overwrite an existing map: {path}")
        path.write_text("{}")
    if not path.exists():
        raise WayfindingError(f"map not found: {path}")

    with path.open("r+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            raw = handle.read().strip()
            state = json.loads(raw) if raw else {}
            yield state
            handle.seek(0)
            handle.truncate()
            handle.write(json.dumps(state, indent=2, sort_keys=True))
            handle.write("\n")
            # Flush and fsync before unlocking: releasing the flock only
            # allows another process to acquire it, it does not guarantee
            # this write has left Python's buffer. Without this, a waiting
            # reader can win the lock and read stale pre-write content.
            handle.flush()
            os.fsync(handle.fileno())
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def append_history(state: dict[str, Any], event: str, **fields: Any) -> None:
    state.setdefault("history", []).append({"event": event, "at": time.time(), **fields})


# --- promote --------------------------------------------------------------


def validate_request(request: dict[str, Any]) -> dict[str, Any]:
    contract = required_string(request.get("contract"), "request.contract")
    if contract != REQUEST_CONTRACT:
        raise WayfindingError(f"unsupported request contract: {contract}")

    if request.get("exceeds_one_session") is not True:
        raise WayfindingError(
            "exceeds_one_session must be true -- work that fits one healthy "
            "session does not promote to a Wayfinding Run"
        )

    trigger_reason = required_string(request.get("trigger_reason"), "request.trigger_reason")
    run_id = required_string(request.get("run_id"), "request.run_id")

    decisions_raw = as_list(request.get("decisions"), "request.decisions")
    if not decisions_raw:
        raise WayfindingError(
            "request.decisions must declare at least one Planning Decision -- "
            "promoting before material decision loss requires a decision frontier"
        )

    decisions: dict[str, Any] = {}
    map_keys: set[str] = set()
    for index, raw in enumerate(decisions_raw):
        entry = as_dict(raw, f"request.decisions[{index}]")
        decision_id = required_string(entry.get("id"), f"request.decisions[{index}].id")
        map_key = required_string(entry.get("map_key"), f"request.decisions[{index}].map_key")
        summary = required_string(entry.get("summary"), f"request.decisions[{index}].summary")
        if decision_id in decisions:
            raise WayfindingError(f"duplicate decision id: {decision_id}")
        if map_key in map_keys:
            raise WayfindingError(f"duplicate decision map_key: {map_key}")
        map_keys.add(map_key)
        # A decision is always non-executable and never delivery-routable,
        # regardless of what the request tried to set -- promotion is the
        # one place plane/delivery_routable are decided.
        decisions[decision_id] = {
            "plane": "planning",
            "delivery_routable": False,
            "map_key": map_key,
            "summary": summary,
            "status": OPEN,
            "claimed_by": None,
            "session_id": None,
            "resolution": None,
            "evidence": None,
        }

    time_sensitive_fields = [
        required_string(f, "request.time_sensitive_fields[]")
        for f in as_list(request.get("time_sensitive_fields", []), "request.time_sensitive_fields")
    ]

    return {
        "run_id": run_id,
        "trigger_reason": trigger_reason,
        "decisions": decisions,
        "time_sensitive_fields": time_sensitive_fields,
    }


def cmd_promote(args: argparse.Namespace) -> int:
    try:
        request = as_dict(
            json.loads(Path(args.request).read_text(encoding="utf-8")), "request"
        )
        validated = validate_request(request)
        out_path = Path(args.out)
        if out_path.exists():
            raise WayfindingError(f"refusing to overwrite an existing map: {out_path}")
        state = {
            "contract": MAP_CONTRACT,
            "run_id": validated["run_id"],
            "plane": "planning",
            "delivery_routable": False,
            "status": ACTIVE,
            "trigger_reason": validated["trigger_reason"],
            "time_sensitive_fields": validated["time_sensitive_fields"],
            "time_sensitive_facts": {},
            "decisions": validated["decisions"],
            "history": [{"event": "promote", "at": time.time(), "reason": validated["trigger_reason"]}],
        }
        out_path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    except (WayfindingError, OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(json.dumps({"ok": True, "run_id": state["run_id"], "map": str(out_path)}, indent=2))
    return 0


# --- claim / resolve --------------------------------------------------------


def cmd_claim(args: argparse.Namespace) -> int:
    map_path = Path(args.map)
    try:
        with locked_map(map_path) as state:
            if state.get("status") != ACTIVE:
                raise WayfindingError(
                    f"run is not active (status={state.get('status')!r}); a decision can "
                    "only be claimed while the run is active"
                )
            decisions = state.get("decisions", {})
            decision = decisions.get(args.decision)
            if decision is None:
                raise WayfindingError(f"unknown decision: {args.decision}")
            if decision["status"] != OPEN:
                raise WayfindingError(
                    f"decision {args.decision!r} is already {decision['status']} -- "
                    "first claim wins, this claim loses"
                )
            decision["status"] = CLAIMED
            decision["claimed_by"] = args.claimant
            decision["session_id"] = args.session
            append_history(
                state, "claim", decision=args.decision, claimant=args.claimant, session_id=args.session
            )
    except WayfindingError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(json.dumps({"ok": True, "decision": args.decision, "claimed_by": args.claimant}, indent=2))
    return 0


def route_clear(state: dict[str, Any]) -> bool:
    return all(d["status"] == RESOLVED for d in state.get("decisions", {}).values())


def cmd_resolve(args: argparse.Namespace) -> int:
    map_path = Path(args.map)
    try:
        with locked_map(map_path) as state:
            decisions = state.get("decisions", {})
            decision = decisions.get(args.decision)
            if decision is None:
                raise WayfindingError(f"unknown decision: {args.decision}")
            if decision["status"] != CLAIMED:
                raise WayfindingError(
                    f"decision {args.decision!r} is {decision['status']}, not claimed -- "
                    "only a claimed decision can be resolved"
                )
            if decision["session_id"] != args.session:
                raise WayfindingError(
                    f"session {args.session!r} did not claim decision {args.decision!r} "
                    f"(claimed by session {decision['session_id']!r})"
                )
            decision["status"] = RESOLVED
            decision["resolution"] = required_string(args.resolution, "--resolution")
            decision["evidence"] = required_string(args.evidence, "--evidence")
            append_history(
                state, "resolve", decision=args.decision, session_id=args.session, evidence=args.evidence
            )

            # Normal map rules: when every child is resolved the route is
            # clear. This is the one and only fog check -- flipping the run
            # to to_spec_ready here, inside the resolve that closes the last
            # child, is what lets to-spec start without a second fog audit.
            to_spec_ready = state["status"] == ACTIVE and route_clear(state)
            if to_spec_ready:
                state["status"] = TO_SPEC_READY
                append_history(state, "route_clear")
    except WayfindingError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(
        json.dumps(
            {"ok": True, "decision": args.decision, "status": "resolved", "to_spec_ready": to_spec_ready},
            indent=2,
        )
    )
    return 0


# --- pause / resume / abandon ----------------------------------------------


def cmd_pause(args: argparse.Namespace) -> int:
    map_path = Path(args.map)
    try:
        with locked_map(map_path) as state:
            if state.get("status") not in (ACTIVE, TO_SPEC_READY):
                raise WayfindingError(f"cannot pause a run with status={state.get('status')!r}")
            released = []
            for decision_id, decision in state.get("decisions", {}).items():
                if decision["status"] == CLAIMED:
                    decision["status"] = OPEN
                    decision["claimed_by"] = None
                    decision["session_id"] = None
                    released.append(decision_id)
            state["status"] = PAUSED
            append_history(state, "pause", reason=args.reason, released_decisions=sorted(released))
    except WayfindingError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(json.dumps({"ok": True, "status": PAUSED, "released_decisions": sorted(released)}, indent=2))
    return 0


def cmd_resume(args: argparse.Namespace) -> int:
    map_path = Path(args.map)
    try:
        refresh = as_dict(json.loads(Path(args.refresh).read_text(encoding="utf-8")), "refresh")
        facts = as_dict(refresh.get("time_sensitive_facts", {}), "refresh.time_sensitive_facts")
        with locked_map(map_path) as state:
            if state.get("status") != PAUSED:
                raise WayfindingError(f"cannot resume a run with status={state.get('status')!r}")
            allowed = set(state.get("time_sensitive_fields", []))
            unknown = set(facts) - allowed
            if unknown:
                raise WayfindingError(
                    "refresh names field(s) not declared time-sensitive: "
                    f"{sorted(unknown)} -- resume must only refresh time-sensitive facts, "
                    "never resolutions or evidence"
                )
            state.setdefault("time_sensitive_facts", {}).update(facts)
            state["status"] = TO_SPEC_READY if route_clear(state) else ACTIVE
            append_history(state, "resume", refreshed_fields=sorted(facts))
    except (WayfindingError, OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    print(json.dumps({"ok": True, "status": state["status"], "refreshed_fields": sorted(facts)}, indent=2))
    return 0


def cmd_abandon(args: argparse.Namespace) -> int:
    map_path = Path(args.map)
    try:
        with locked_map(map_path) as state:
            if state.get("status") == ABANDONED:
                raise WayfindingError("run is already abandoned")
            state["status"] = ABANDONED
            append_history(state, "abandon", reason=required_string(args.reason, "--reason"))
    except WayfindingError as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    # Abandon writes only this map file and returns -- no to-spec call, no
    # other artifact touched, nothing published.
    print(json.dumps({"ok": True, "status": ABANDONED}, indent=2))
    return 0


# --- status / route-check ---------------------------------------------------


def cmd_status(args: argparse.Namespace) -> int:
    try:
        state = as_dict(json.loads(Path(args.map).read_text(encoding="utf-8")), "map")
    except (OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1
    decisions = {
        decision_id: decision["status"] for decision_id, decision in state.get("decisions", {}).items()
    }
    print(
        json.dumps(
            {
                "ok": True,
                "run_id": state.get("run_id"),
                "status": state.get("status"),
                "plane": state.get("plane"),
                "delivery_routable": state.get("delivery_routable"),
                "route_clear": route_clear(state),
                "to_spec_eligible": state.get("status") == TO_SPEC_READY,
                "decisions": decisions,
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0


def cmd_route_check(args: argparse.Namespace) -> int:
    """Simulate a delivery router's eligibility test: a Bead is only
    delivery-routable if it carries positive plane=delivery metadata (spec
    line: "Delivery Beads carry positive plane=delivery metadata and are
    ineligible until validation and convoy attachment succeed"). Every
    object this tool writes carries plane=planning, so this always reports
    ineligible for them -- proving AC1 without a real delivery router.
    """
    try:
        state = as_dict(json.loads(Path(args.map).read_text(encoding="utf-8")), "map")
    except (OSError, json.JSONDecodeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)}, indent=2))
        return 1

    def eligible(obj: dict[str, Any]) -> bool:
        return obj.get("plane") == "delivery"

    report = {"map": eligible(state)}
    for decision_id, decision in state.get("decisions", {}).items():
        report[f"decision:{decision_id}"] = eligible(decision)

    print(
        json.dumps(
            {"ok": True, "delivery_routable": report, "any_delivery_routable": any(report.values())},
            indent=2,
            sort_keys=True,
        )
    )
    return 0


# --- CLI --------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=PROGRAM, description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    promote = subparsers.add_parser("promote", help="promote a request into a new Planning Map")
    promote.add_argument("request", help="path to the Wayfinding Run request JSON file")
    promote.add_argument("--out", required=True, help="path to write the new Planning Map JSON file")
    promote.set_defaults(func=cmd_promote)

    claim = subparsers.add_parser("claim", help="claim one open Planning Decision")
    claim.add_argument("map", help="path to the Planning Map JSON file")
    claim.add_argument("--decision", required=True)
    claim.add_argument("--claimant", required=True)
    claim.add_argument("--session", required=True)
    claim.set_defaults(func=cmd_claim)

    resolve = subparsers.add_parser("resolve", help="resolve one claimed Planning Decision")
    resolve.add_argument("map", help="path to the Planning Map JSON file")
    resolve.add_argument("--decision", required=True)
    resolve.add_argument("--session", required=True)
    resolve.add_argument("--resolution", required=True)
    resolve.add_argument("--evidence", required=True)
    resolve.set_defaults(func=cmd_resolve)

    pause = subparsers.add_parser("pause", help="pause an active run: release sessions, retain the map")
    pause.add_argument("map", help="path to the Planning Map JSON file")
    pause.add_argument("--reason", required=True)
    pause.set_defaults(func=cmd_pause)

    resume = subparsers.add_parser("resume", help="resume a paused run, refreshing only time-sensitive facts")
    resume.add_argument("map", help="path to the Planning Map JSON file")
    resume.add_argument("--refresh", required=True, help="path to a JSON file with time_sensitive_facts")
    resume.set_defaults(func=cmd_resume)

    abandon = subparsers.add_parser("abandon", help="abandon a run: publishes nothing")
    abandon.add_argument("map", help="path to the Planning Map JSON file")
    abandon.add_argument("--reason", required=True)
    abandon.set_defaults(func=cmd_abandon)

    status = subparsers.add_parser("status", help="report run status, route-clear and to-spec eligibility")
    status.add_argument("map", help="path to the Planning Map JSON file")
    status.set_defaults(func=cmd_status)

    route_check = subparsers.add_parser(
        "route-check", help="prove the map and its decisions are never delivery-routable"
    )
    route_check.add_argument("map", help="path to the Planning Map JSON file")
    route_check.set_defaults(func=cmd_route_check)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
